if game.Workspace:FindFirstChild("SeekMovingNewClone") then return end

local Core = loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/J63633S/Gradish-mode/main/GradishCore"
))()

Core:Spawn({
	Name  = "Rose Hell",
	Asset = "https://raw.githubusercontent.com/J63633S/Gradish-mode/main/roseHell.rbxm",

	Speed        = 100,
	Delay        = 2,
	Damage       = 125,
	DamageRange  = 30,
	Rebounds     = { 1, 1 },
	ReboundType  = "Ambush",

	-- A little random pace on every spawn so she is never metronomic.
	Variance = 0.05,

	CameraShake = {
		Enabled = true,
		Range   = 100,
		Values  = { 70, 100, 0.1, 1 },
	},

	DeathCause = "Rose hell",
	DeathHints = {
		"You died to...",
		"Rose Hell. It is an easy one",
		"To beat it, hide each rebound",
		"It acts like ambush, Goodluck.",
	},

	---====== MECHANICS ======---

	-- The pink that was already here, except now it fades back out when she
	-- leaves instead of staying on the map for the rest of the run.
