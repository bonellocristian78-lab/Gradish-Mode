---====== SUMMONING ======---

local function summon(entry)
	--[[ Loading the entity script directly runs its own Core:Spawn, which
	     means it arrives exactly as the schedule would have delivered it --
	     same profile, same mechanics, same achievements. Nothing here is a
	     special "test" path that could behave differently from the real one. ]]
	say("summoning %s", entry.key)

	task.spawn(function()
		local ok, err = pcall(function()
			loadstring(game:HttpGet(BASE .. entry.file))()
		end)

		if not ok then
			say("%s failed to load: %s", entry.file, tostring(err))
		end
	end)
end

---====== CRUCIFIXES ======---

local function giveCrucifix(variant)
	say("fetching %s crucifix", variant or "plain")

	task.spawn(function()
		local tool = Core.Crucifix:Give("dev console", true)
		if not tool then
			say("the loader produced no tool")
			return
		end

		if variant then
			Core.MakeVariant(tool, variant)
		end

		local character = LocalPlayer.Character
		say("in hand: %s", tostring(tool.Parent == character))
	end)
end

---====== BADGES ======---

--[[ The Core answers this, not us.

     An earlier version of this file walked AchievementConfig itself and
     derived identifiers by hand. That is the same logic buildAchievements
     already contains, written twice -- and the copy would have been wrong the
     moment short form, the Enabled switches or a default changed. Core
     exports the real thing now. ]]
local function allConfiguredBadges()
	return Core.AllAchievements()
end

local function library()
	--[[ The Core's copy, not a second one.

	     Loading the library again here would give this console its own
	     instance with its own view of what you own, and the two would drift
	     apart the first time one of them wrote the file. Core.Achievements
	     already owns the fetch, the retry backoff and the granted set. ]]
	local achievements = Core.Achievements
	local lib = achievements and achievements:Load()

	if not lib then
		say("the achievements library is not loaded yet -- try again in a moment")
	end

	return lib, achievements
end

local function ownedList()
	local owned = {}
	pcall(function()
		owned = game:GetService("HttpService"):JSONDecode(readfile("DOORS_Custom_Achievements.json"))
	end)
	return owned
end

local function badgeAction(index)
	local lib, achievements = library()
	if not lib then return end

	if index == 1 then
		local owned = ownedList()
		local configured = allConfiguredBadges()

		say("you own %d of %d configured badge(s):", #owned, #configured)
		for _, id in ipairs(owned) do
			say("   [x] %s", id)
		end

		for _, badge in ipairs(configured) do
			if not table.find(owned, badge.id) then
				say("   [ ] %s   (%s)", badge.id, badge.from)
			end
		end

	elseif index == 2 then
		--[[ Wiping is the one that makes testing possible at all: a badge you
		     already own is remembered, so its popup is suppressed on every run
		     afterwards. Without this you get exactly one look at each. ]]
		local owned = ownedList()

		for _, id in ipairs(owned) do
			pcall(function() lib:Revoke(id) end)
			Core.Granted[id] = nil
		end

		say("wiped %d badge(s) -- their popups will show again", #owned)

	elseif index == 3 then
		local badges = allConfiguredBadges()
		local queued = 0

		for _, badge in ipairs(badges) do
			-- Through the Core's queue, so the popups are spaced out and the
			-- image manager resolves each picture exactly as it would during a
			-- real run. Granting them any other way would test a path the game
			-- never takes.
			Core.Granted[badge.id] = nil
			achievements:Award(badge.entry)
			queued += 1
		end

		say("queued %d badge(s); the Core shows them one at a time", queued)

	elseif index == 4 then
		local badges = allConfiguredBadges()
		for _, badge in ipairs(badges) do
			pcall(function() lib:Revoke(badge.id) end)
			Core.Granted[badge.id] = nil
		end
		say("revoked %d configured badge(s)", #badges)
	end
end

---====== STATE DUMP ======---

local function dump()
	say("================ STATE ================")

	local data = ReplicatedStorage:FindFirstChild("GameData")
	local room = data and data:FindFirstChild("LatestRoom")
	local seed = data and data:FindFirstChild("GameSeed")

	say("room %s | seed %s", room and tostring(room.Value) or "?", seed and tostring(seed.Value) or "?")

	local live = Core:ActiveNames()
	say("entities out: %s", #live > 0 and table.concat(live, ", ") or "none")

	-- The game's own, which block our spawns.
	for _, name in ipairs({ "RushMoving", "AmbushMoving", "SeekMovingNewClone" }) do
		if Workspace:FindFirstChild(name) then
			say("BLOCKED BY: %s is in the workspace", name)
		end
	end

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		say("health %d/%d | walkspeed %.1f | hiding %s",
			math.floor(humanoid.Health), math.floor(humanoid.MaxHealth),
			humanoid.WalkSpeed, tostring(character:GetAttribute("Hiding")))
	end

	local held = character and character:FindFirstChildOfClass("Tool")
	if held then
		say("holding: %s (variant %s)", held.Name,
			tostring(held:GetAttribute("CrucifixVariant") or "none"))
	else
		say("holding: nothing")
	end

	say("death types: %s", table.concat(Core.DeathTypes or {}, ", "))

	local cached = 0
	for _ in pairs(Core.Images and Core.Images.cache or {}) do cached += 1 end
	say("images cached: %d", cached)

	-- Every item the loot table has produced, not just crucifixes: the old
	-- line said "crucifix x3" whether it was three crucifixes or three
	-- vitamins.
	local loot = {}
	for key, count in pairs(Core.Loot and Core.Loot.found or {}) do
		table.insert(loot, ("%s x%d"):format(key, count))
	end

	say("found in furniture: %s", #loot > 0 and table.concat(loot, ", ") or "nothing yet")
	say("crucifixes: %d given, %d spent, %d from drawers",
		(Core.Crucifix and Core.Crucifix.given) or 0,
		(Core.Crucifix and Core.Crucifix.spent) or 0,
		(Core.Crucifix and Core.Crucifix.foundInDrawers) or 0)
	say("=======================================")
end

---====== INPUT ======---

--[[ An opened menu expires.

     It used to stay armed forever, so pressing F1, deciding against it, and
     pressing 3 twenty minutes later for something else summoned Yeller. Ten
     seconds is long enough to read nine lines and short enough that a stale
     menu cannot surprise you. ]]
local menu = nil
local menuUntil = 0
local MENU_SECONDS = 10

local function openMenu(name)
	menu = name
	menuUntil = os.clock() + MENU_SECONDS
end

local MENUS = {
	entity = function(index)
		local entry = ENTITIES[index]
		if entry then summon(entry) end
	end,
	crucifix = function(index)
		local entry = CRUCIFIXES[index]
		if entry then giveCrucifix(entry.key) end
	end,
	badge = function(index)
		if BADGE_ACTIONS[index] then badgeAction(index) end
	end,
}

local NUMBER_KEYS = {
	[Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4, [Enum.KeyCode.Five] = 5, [Enum.KeyCode.Six] = 6,
	[Enum.KeyCode.Seven] = 7, [Enum.KeyCode.Eight] = 8, [Enum.KeyCode.Nine] = 9,
	[Enum.KeyCode.Zero] = 10,   -- ten entities, and 0 is the one after 9
}

local connections = {}

table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end

	local code = input.KeyCode

	if code == Enum.KeyCode.F1 then
		openMenu("entity")
		say("SUMMON -- press a number:")
		for index, entry in ipairs(ENTITIES) do
			say("   %d  %s", index, entry.key)
		end

	elseif code == Enum.KeyCode.F2 then
		openMenu("crucifix")
		say("CRUCIFIX -- press a number:")
		for index, entry in ipairs(CRUCIFIXES) do
			say("   %d  %s", index, entry.label)
		end

	elseif code == Enum.KeyCode.F3 then
		openMenu("badge")
		say("BADGES -- press a number:")
		for index, entry in ipairs(BADGE_ACTIONS) do
			say("   %d  %s", index, entry.label)
		end

	elseif code == Enum.KeyCode.F4 then
		dump()

	elseif code == Enum.KeyCode.F5 then
		--[[ Core.Dismiss, NOT entity:Despawn().

		     Despawn runs the ordinary end-of-visit path, which awards Survive
		     and -- if nothing had hit you -- Untouched, and writes both into
		     DOORS_Custom_Achievements.json with Remember = true. So the key
		     for clearing the field was quietly spending the two badges that
		     are hardest to earn, and their popups would never appear again.

		     It was worse than that for two entities. Rebound has three passes
		     and Rose Hell has a 25% encore, and both of those branches return
		     BEFORE the award path, so despawning them did not even clear the
		     field: they came back two rooms later as a fresh session that
		     awarded its badges on the way out anyway. ]]
		local names = Core:ActiveNames()
		local sent = 0

		for _, name in ipairs(names) do
			if Core.Dismiss(name) then sent += 1 end
		end

		say("dismissed %d entity/entities -- no badges awarded", sent)

		-- Rude is not in the registry: he is standalone and runs his own
		-- placement, so the shared despawn cannot reach him.
		if getgenv and type(getgenv().__GradishRudeLeave) == "function" then
			pcall(getgenv().__GradishRudeLeave, "dev console")
			say("and told Rude to leave")
		end

	elseif code == Enum.KeyCode.F6 then
		Core.Debug = not Core.Debug
		say("debug logging %s", Core.Debug and "ON" or "OFF")

	elseif NUMBER_KEYS[code] and menu then
		if os.clock() > menuUntil then
			menu = nil
			say("that menu expired -- press F1, F2 or F3 again")
			return
		end

		local chosen = menu
		menu = nil
		MENUS[chosen](NUMBER_KEYS[code])
	end
end))

if getgenv then
	local previous = getgenv().__GradishDevCleanup
	if type(previous) == "function" then pcall(previous) end

	getgenv().__GradishDevCleanup = function()
		for _, connection in ipairs(connections) do
			pcall(function() connection:Disconnect() end)
		end
		table.clear(connections)
	end
end

print("")
say("ready.")
say("  F1 summon    F2 crucifix    F3 badges")
say("  F4 dump      F5 despawn all F6 toggle logging")
say("Everything printed here is also in gradish_log.txt.")
