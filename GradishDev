--[[
================================================================================

        G R A D I S H   D E V

        A console for building the mod, driven entirely by keys. No UI, because
        you have said no UI eight times, and none is needed: everything it has
        to say goes to the Roblox console AND to gradish_log.txt, which is a
        file on disk that can be read from outside the game.

        WHY THIS EXISTS
        ---------------
        Every bug in this mod so far has cost the same loop: run the mod, walk
        until the schedule happens to spawn the right entity, hope the 4% loot
        roll lands, die, screenshot, describe it. That loop is the reason
        things like the acid never outliving Corrode survived several rounds of
        "it is fixed now" -- nobody could reach them on demand.

        This removes the walking and the hoping. Summon any entity where you
        stand. Hand yourself any crucifix. Grant, revoke or wipe any badge.
        Dump the state of everything to the log.

            F1   summon menu: prints the list, then press 1-9 or 0
            F2   crucifix menu: prints the list, then press 1-5
            F3   badge menu: list / wipe all / grant all / revoke all
            F4   dump everything to the log right now
            F5   despawn every Gradish entity currently out
            F6   toggle the mod's own debug logging

        Keys are read as a two step: the menu key prints the options, the
        number key chooses. That is deliberate -- a single key per entity would
        need twenty bindings and would fight DOORS' own controls.

================================================================================
]]

local Core = loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/main/GradishCore"
))()

local BASE = "https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/main/"

local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace        = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

local function say(format, ...)
	local line = "[GradishDev] " .. format:format(...)
	print(line)
	-- Core.Log mirrors to gradish_log.txt, which is readable from outside.
	if Core.Log then pcall(Core.Log, "Dev", format, ...) end
end

