local FX = {}
local flashFrame = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1 }, screen)
local captionLabel = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.82), Size = UDim2.fromScale(0.7, 0.05),
	BackgroundTransparency = 1, Text = "", TextScaled = true, Font = Enum.Font.Oswald, TextColor3 = Color3.fromRGB(255, 222, 189), TextStrokeTransparency = 0.3,
	TextTransparency = 1, ZIndex = 6 }, screen)
local captionId = 0
-- DOORS' own caption, or one like it
function FX.caption(text)
	local ok = mainGame and type(mainGame.caption) == "function" and pcall(mainGame.caption, text, true)
	if ok then return end
	captionId += 1
	local id = captionId
	captionLabel.Text, captionLabel.TextTransparency = text, 0
	task.delay(3.5, function()
		if captionId == id and captionLabel.Parent then TweenService:Create(captionLabel, TweenInfo.new(0.6), { TextTransparency = 1 }):Play() end
	end)
end
function FX.shake(power)
	pcall(function() mainGame.camShaker:ShakeOnce(power, 12, 0, 0.6) end)
end
function FX.flash(color, strength)
	flashFrame.BackgroundColor3 = color
	flashFrame.BackgroundTransparency = 1 - (strength or 0.6)
	TweenService:Create(flashFrame, TweenInfo.new(0.7), { BackgroundTransparency = 1 }):Play()
end
function FX.sound(id, parent, props)
	if not id then return nil end
	local s = make("Sound", { SoundId = id, Volume = VOLUME }, parent or SoundService)
	for k, v in pairs(props or {}) do s[k] = v end
	return s
end
function FX.once(id, parent, props)
	local s = FX.sound(id, parent or SoundService, props)
	if not s then return nil end
	s:Play()
	s.Ended:Connect(function() s:Destroy() end)
	task.delay(15, function() if s.Parent then s:Destroy() end end)
	return s
end
function FX.loop(id, parent, props)
	local s = FX.sound(id, parent, props)
	if s then
		s.Looped = true
		s:Play()
	end
	return s
end
-- One of the sounds of a copy of DOORS' (its own: Open, Unlock, Error...)
local function playOwn(model, name)
	local s = model and model:FindFirstChild(name, true)
	if s and s:IsA("Sound") then pcall(function() s:Play() end) end
end

local dead = false
local function kill(name, hints)
	local _, humanoid = body()
	if not humanoid or dead then return end
	dead = true
	pcall(function() ReplicatedStorage.GameStats["Player_" .. LocalPlayer.Name].Total.DeathCause.Value = name end)
	if firesignal then
		task.spawn(function()
			pcall(function()
				local death = LocalPlayer.PlayerGui.MainUI:FindFirstChild("Death")
				if death and not death.Visible then death:GetPropertyChangedSignal("Visible"):Wait() end
				firesignal(ReplicatedStorage.Bricks.DeathHint.OnClientEvent, hints)
			end)
		end)
	end
	humanoid.Health = 0
end
local function damage(amount, name, hints)
	local _, humanoid = body()
	if not humanoid then return end
	if humanoid.Health - amount <= 0 then
		kill(name, hints)
		return
	end
	humanoid.Health -= amount
	FX.flash(Color3.fromRGB(150, 0, 0), 0.5)
	FX.shake(6)
end

---====== WHERE: ROOM 0, BESIDE ITS DOOR ======---

local up = Vector3.new(0, 1, 0)
local probe = RaycastParams.new()
probe.FilterType = Enum.RaycastFilterType.Exclude
probe.RespectCanCollide = true
local function cast(from, direction, also)
	probe.FilterDescendantsInstances = { folder, LocalPlayer.Character, also or folder }
	return workspace:Raycast(from, direction, probe)
end
local rooms = workspace:FindFirstChild("CurrentRooms")
local function roomYouAreIn()
	if not rooms then return nil end
	local named = rooms:FindFirstChild(tostring(LocalPlayer:GetAttribute("CurrentRoom") or ""))
	if named then return named end
	local best, bestDistance = nil, math.huge
	for _, room in ipairs(rooms:GetChildren()) do
		local mark = room:FindFirstChild("RoomEnd")
		if mark and mark:IsA("BasePart") then
			local d = (mark.Position - root0.Position).Magnitude
			if d < bestDistance then best, bestDistance = room, d end
		end
	end
	return best
end
-- Room 0 (else the room you are in): its door's place on its floor, the way out through it
local hotelRoom = rooms and rooms:FindFirstChild("0")
if not (hotelRoom and hotelRoom:FindFirstChild("RoomEnd")) then hotelRoom = roomYouAreIn() end
local roomEnd = hotelRoom and hotelRoom:FindFirstChild("RoomEnd")
local out, doorFloor, endLift
if roomEnd then
	out = flat(roomEnd.CFrame.LookVector)
	out = if out.Magnitude > 0.1 then out.Unit else Vector3.new(0, 0, -1)
	local start = hotelRoom:FindFirstChild("RoomStart")
	if start and (start.Position - roomEnd.Position):Dot(out) > 0 then out = -out end -- (out: away from the room)
	endLift = roomEnd.Size.Y / 2
	doorFloor = roomEnd.Position - up * endLift -- (DOORS' RoomEnd is its doorway: its bottom is the floor)
else -- (outside the Hotel-: a door's place ahead of you)
	out = flat(workspace.CurrentCamera.CFrame.LookVector)
	out = if out.Magnitude > 0.1 then out.Unit else Vector3.new(0, 0, -1)
	local hit = cast(root0.Position + out * 16 + up * 2, Vector3.new(0, -30, 0))
	doorFloor = if hit then hit.Position else root0.Position + out * 16 - up * 3
	endLift = 4
end
local side = out:Cross(up).Unit
-- In front of the door, inside the room, facing it: where the way back leaves you
local function backInTheHotel()
	local p = doorFloor - out * 5 + up * 3.2
	return CFrame.lookAt(p, p + out)
end

local DEPTH, W, LEN, H = 40, 44, 84, 26 -- the room: 40 under the Hotel's floor; x -22..22, z -42..42, y 0..26
local STAIR = { w = 6, z0 = 44, z1 = 104 } -- from z 44 (y 0) up to z 104 (y 40): 40 steps of 1.5
local HOLE = { z0 = 92, z1 = 104 } -- the opening in the Hotel's floor, over the top of the stairs
local holeSize = Vector3.new(STAIR.w, 0, HOLE.z1 - HOLE.z0)

-- Where beside the door (one side or the other, nearer or further): where the least is in the way (the room's own walls
-- and desks count much more than its furniture, which is only taken away) and the room's floor under all of it
local furniture = hotelRoom and hotelRoom:FindFirstChild("Assets")
local function holeAt(offset)
	local c = doorFloor - out * (3 + holeSize.Z / 2) + side * offset
	return CFrame.lookAt(c, c + out)
end
local function overlap(cf, size)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { folder, LocalPlayer.Character }
	local ok, found = pcall(function() return workspace:GetPartBoundsInBox(cf, size, params) end)
	return if ok and found then found else {}
end
local function obstacles(hole)
	local n, seen = 0, {}
	for _, p in ipairs(overlap(hole * CFrame.new(0, 3.5, 2.5), Vector3.new(STAIR.w + 1, 6, holeSize.Z + 5))) do
		if p.CanCollide and p.Transparency < 0.99 then
			local thing = p:FindFirstAncestorWhichIsA("Model")
			if furniture and thing and thing:IsDescendantOf(furniture) then
				if not seen[thing] then n += 1 end
				seen[thing] = true
			else
				n += 10
			end
		end
	end
	for _, c in ipairs({ { -1, -1 }, { -1, 1 }, { 1, -1 }, { 1, 1 } }) do
		local at = hole * Vector3.new(c[1] * STAIR.w / 2, 0, c[2] * holeSize.Z / 2)
		local hit = cast(at + up * 2, Vector3.new(0, -4, 0), furniture)
		if not hit or math.abs(hit.Position.Y - doorFloor.Y) > 0.6 then n += 100 end
	end
	return n
end
local holeCF, fewest = nil, math.huge
for _, offset in ipairs({ 7.5, -7.5, 9.5, -9.5 }) do
	local hole = holeAt(offset)
	local n = obstacles(hole)
	if n < fewest then holeCF, fewest = hole, n end
end
-- The Washroom's frame: its floor's middle, 40 below; -Z the way on (the far door), +Z the stairs up to the opening
local middle = holeCF.Position - up * DEPTH + out * ((HOLE.z0 + HOLE.z1) / 2)
local F = CFrame.lookAt(middle, middle + out)
local function L(x, y, z) return F * CFrame.new(x, y, z) end

---====== BUILDING ======---

local HOTEL = { -- the Hotel-'s rooms, from its dump: their floor, walls, trim, ceiling, wallpaper
	floor = Color3.fromRGB(95, 83, 81), wall = Color3.fromRGB(89, 116, 117), strip = Color3.fromRGB(117, 98, 94), ceiling = Color3.fromRGB(107, 90, 86),
	wallpaper = "rbxassetid://9754267662" }
local TILE = Color3.fromRGB(214, 208, 186)
local ENAMEL = Color3.fromRGB(222, 222, 214)
local STEEL = Color3.fromRGB(165, 170, 174)
local M = Enum.Material

local function box(name, size, cf, color, material, extra, parent)
	local p = make("Part", { Name = name, Size = size, CFrame = cf, Color = color or Color3.new(0.5, 0.5, 0.5), Material = material or M.SmoothPlastic,
		Anchored = true, TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth, CastShadow = false }, parent or folder)
	for k, v in pairs(extra or {}) do p[k] = v end
	return p
end
local function cylinder(name, length, diameter, cf, color, material, extra, parent) -- (its axis along cf's X)
	local p = box(name, Vector3.new(length, diameter, diameter), cf, color, material, extra, parent)
	p.Shape = Enum.PartType.Cylinder
	return p
end
local function texture(p, id, faces, studs, extra)
	if not id then return end
	for _, face in ipairs(faces) do
		local t = make("Texture", { Texture = id, Face = Enum.NormalId[face], StudsPerTileU = studs, StudsPerTileV = studs }, p)
		for k, v in pairs(extra or {}) do t[k] = v end
	end
end
local function decal(p, id, face, extra)
	if not id or not p then return nil end
	local d = make("Decal", { Texture = id, Face = Enum.NormalId[face] }, p)
	for k, v in pairs(extra or {}) do d[k] = v end
	return d
end
-- A sloped slab from (y0, z0) to (y1, z1), its top through both (what you walk on; the steps are only seen)
local function ramp(name, width, y0, z0, y1, z1, material)
	local a, b = L(0, y0, z0).Position, L(0, y1, z1).Position
	local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.new(0, -0.5, 0)
	return box(name, Vector3.new(width, 1, (b - a).Magnitude + 0.6), cf, Color3.new(0.5, 0.5, 0.5), material, { Transparency = 1, CanQuery = false })
end
local function hotelWall(name, size, cf)
	local w = box(name, size, cf, HOTEL.wall, M.Wood)
	texture(w, HOTEL.wallpaper, { "Left", "Right", "Front", "Back" }, 3, { StudsPerTileV = 2, Transparency = 0.85 })
	return w
end
local function tileWall(name, size, cf)
	local w = box(name, size, cf, TILE, M.Slate, { Reflectance = 0.05 })
	texture(w, IMG.Tiles, { "Left", "Right", "Front", "Back", "Top", "Bottom" }, 8)
	return w
end
local function clean(model) -- a copy of DOORS': none of its code, remotes, physics, tags
	pcall(function() model:SetAttribute("LoadModule", nil) end)
	local all = model:GetDescendants()
	table.insert(all, model)
	for _, d in ipairs(all) do
		untag(d)
		if d:IsA("LuaSourceContainer") or d:IsA("RemoteEvent") or d:IsA("BindableEvent") or d:IsA("BodyMover") or d:IsA("Constraint")
			or d:IsA("TouchTransmitter") or d:IsA("ProximityPrompt") or d:IsA("AnimationController") or d:IsA("JointInstance") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored, d.CanTouch, d.CastShadow = true, false, false
		end
	end
	return model
end

---- The opening in room 0's floor (only for you: its floor there hidden, the rest of it copies of it) ----
local moved = {} -- the Hotel's parts out of your way: part -> { transparency, collide }
local function hideLocally(p)
	if moved[p] then return end
	moved[p] = { p.LocalTransparencyModifier, p.CanCollide }
	p.LocalTransparencyModifier, p.CanCollide = 1, false
	for _, d in ipairs(p:GetChildren()) do
		if d:IsA("Decal") then
			moved[d] = { d.LocalTransparencyModifier }
			d.LocalTransparencyModifier = 1
		end
	end
end
later(function()
	for p, was in pairs(moved) do
		pcall(function()
			p.LocalTransparencyModifier = was[1]
			if was[2] ~= nil then p.CanCollide = was[2] end
		end)
	end
end)
local pieces = {}
later(function()
	for _, piece in ipairs(pieces) do piece:Destroy() end
end)
local function split(p) -- a floor round the opening: up to four copies of it
	local lo, hi = Vector3.new(math.huge, 0, math.huge), Vector3.new(-math.huge, 0, -math.huge)
	for _, c in ipairs({ { -1, -1 }, { -1, 1 }, { 1, -1 }, { 1, 1 } }) do
		local l = p.CFrame:PointToObjectSpace(holeCF * Vector3.new(c[1] * holeSize.X / 2, 0, c[2] * holeSize.Z / 2))
		lo = Vector3.new(math.min(lo.X, l.X), 0, math.min(lo.Z, l.Z))
		hi = Vector3.new(math.max(hi.X, l.X), 0, math.max(hi.Z, l.Z))
	end
	local hx, hz = p.Size.X / 2, p.Size.Z / 2
	local x0, x1, z0, z1 = math.clamp(lo.X, -hx, hx), math.clamp(hi.X, -hx, hx), math.clamp(lo.Z, -hz, hz), math.clamp(hi.Z, -hz, hz)
	for _, r in ipairs({ { -hx, x0, -hz, hz }, { x1, hx, -hz, hz }, { x0, x1, -hz, z0 }, { x0, x1, z1, hz } }) do
		if r[2] - r[1] > 0.02 and r[4] - r[3] > 0.02 then
			local ok, piece = pcall(function() return p:Clone() end)
			if not (ok and piece) then
				piece = make("Part", { Color = p.Color, Material = p.Material, Transparency = p.Transparency, Reflectance = p.Reflectance }, nil)
			end
			for _, d in ipairs(piece:GetChildren()) do
				if not (d:IsA("Texture") or d:IsA("Decal")) then d:Destroy() end
			end
			untag(piece)
			piece.Anchored = true
			piece.Size = Vector3.new(r[2] - r[1], p.Size.Y, r[4] - r[3])
			piece.CFrame = p.CFrame * CFrame.new((r[1] + r[2]) / 2, 0, (r[3] + r[4]) / 2)
			piece.Parent = p.Parent -- (beside it, in its room: for DOORS, still its floor)
			table.insert(pieces, piece)
		end
	end
	hideLocally(p)
end
for _, p in ipairs(overlap(holeCF * CFrame.new(0, -1.2, 0), Vector3.new(holeSize.X - 0.05, 2.8, holeSize.Z - 0.05))) do
	if p:IsA("BasePart") and not p:IsDescendantOf(folder) then
		local flatPart = p:IsA("Part") and p.Shape == Enum.PartType.Block and math.abs(p.CFrame.UpVector.Y) > 0.99
		if flatPart and p.Size.X * p.Size.Z > holeSize.X * holeSize.Z * 2 then split(p) else hideLocally(p) end
