local function lightning() -- DOORS' own storm on its windows (ours too), else like it
	local ok = pcall(function() require(LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game.RemoteListener.Lightning)() end)
	if ok then return end
	for _, w in ipairs(windows) do
		pcall(function()
			local panel = w:FindFirstChild("LightPanel")
			TweenService:Create(panel.Lightning, TweenInfo.new(0.03, Enum.EasingStyle.Back, Enum.EasingDirection.InOut, 3, true), { Brightness = 2 }):Play()
			panel.Attachment.Thunder:Play()
		end)
	end
end
local function flicker(area) -- DOORS' own flicker on DOORS' lamps there (their BulbZap), else like it
	local ok = pcall(function()
		local events = ReplicatedStorage:FindFirstChild("ClientModules") or ReplicatedStorage:FindFirstChild("ModulesClient")
		require(events.Module_Events).flickerLights(area, 1 + math.random())
	end)
	if ok then return end
	for _, d in ipairs(area:GetDescendants()) do
		if d:IsA("Light") and d.Enabled then
			d.Enabled = false
			task.delay(0.1 + math.random() * 0.3, function() d.Enabled = true end)
		end
	end
	FX.once(DOORS.zap, SoundService)
end
do -- (its clocks, its timers, its light; all of it every frame)
	local function tubeOn(t, lit)
		for _, tube in ipairs(t.tubes) do
			tube.Material = if lit then M.Neon else M.SmoothPlastic
			tube.Color = if lit then Color3.fromRGB(205, 240, 245) else Color3.fromRGB(90, 100, 102)
		end
		t.light.Enabled = lit
	end
	-- The clocks: the laundry's shows the time; the attic's pendulum swings, ticking
	local wallClock = laundryModel:FindFirstChild("Wall_Clock")
	local function setClock()
		if not wallClock then return end
		pcall(function()
			local border = wallClock.PrimaryPart
			local now = os.date("*t")
			for _, spec in ipairs({ { "Minute_Hand", now.min / 60 }, { "Hour_Hand", (now.hour % 12 + now.min / 60) / 12 } }) do
				local hand = wallClock:FindFirstChild(spec[1])
				hand.CFrame = border.CFrame * CFrame.new(0, 0, -0.06) * CFrame.Angles(0, 0, spec[2] * math.pi * 2) * CFrame.new(0, hand.Size.Y / 2 - 0.05, 0)
			end
		end)
	end
	setClock()
	local pendulum = nil
	pcall(function()
		local swing = attic.clock:FindFirstChild("Swing")
		pendulum = { part = swing, top = swing.CFrame * CFrame.new(0, swing.Size.Y / 2, 0), half = swing.Size.Y / 2, side = 1 }
	end)

	local was = nil
	local area, seen = nil, {}
	local AMBIENT = { laundry = Color3.fromRGB(56, 64, 68), attic = Color3.fromRGB(70, 52, 40), under = Color3.fromRGB(58, 52, 50) }
	local bangAt, dripAt, flickerAt, puffAt, tickAt, stormAt, dimAt, clockAt =
		os.clock() + 8 + math.random() * 8, os.clock() + 2, os.clock() + 3, os.clock() + 2, os.clock() + 1, os.clock() + 20, os.clock() + 25, os.clock() + 30
	on(RunService.Heartbeat, function(dt)
		local now = os.clock()
		for _, m in ipairs(machines) do
			if m.spin > 0 then
				m.angle += m.spin * dt
				poseDrum(m)
				m.shake = math.min(m.spin / 30, 1) * 0.06
			elseif m.wash then -- a wash: slow turns one way and the other
				m.wash.flip -= dt
				if m.wash.flip <= 0 then m.wash.dir, m.wash.flip = -m.wash.dir, 2 + math.random() * 2 end
				m.angle += m.wash.dir * 2.2 * dt
				poseDrum(m)
				m.water.CFrame = m.drumFrame * CFrame.new(-0.05, -0.15 + math.sin(now * 3) * 0.05, 0) * CFrame.Angles(math.sin(now * 2) * 0.15, 0, 0)
				m.shake = 0.01
			else
				m.shake = 0
			end
			if m.shake > 0 then -- the whole machine shaking on its feet
				local jolt = CFrame.new(rnd(m.shake), rnd(m.shake * 0.5), rnd(m.shake))
				for _, e in ipairs(m.parts) do e[1].CFrame = m.cf * jolt * e[2] end
			end
		end
		if pendulum then
			local a = math.sin(now * math.pi) * 0.13
			pendulum.part.CFrame = pendulum.top * CFrame.Angles(0, 0, a) * CFrame.new(0, -pendulum.half, 0)
			local side = if a > 0 then 1 else -1
			if side ~= pendulum.side then
				pendulum.side = side
				FX.once(DOORS.tick, pendulum.part, { RollOffMaxDistance = 40 })
			end
		end
		if now >= tickAt then -- the timers counting down; a finished wash stops
			tickAt = now + 1
			for _, m in ipairs(running) do
				if m.wash then
					m.wash.left -= 1
					m.timer.Text = ("%d:%02d"):format(math.floor(m.wash.left / 60), m.wash.left % 60)
					if m.wash.left <= 0 then
						m.wash = nil
						m.timer.Text = "END"
						m.led.Color = Color3.fromRGB(255, 200, 40)
						if m.spinSound then m.spinSound:Stop() end
						m.water.Transparency = 1
					end
				end
			end
		end
		if now >= bangAt then -- a dryer (or a washer) starting with a bang, spinning hard a while
			bangAt = now + 10 + math.random() * 12
			local m = pick(machines)
			if not m.open and not m.wash and m.door == 0 then
				FX.once(SND.Bang, m.drum, { Volume = 2.2 * VOLUME, RollOffMinDistance = 20, RollOffMaxDistance = 200 })
				if area == "laundry" then FX.shake(2.5) end
				m.spin = 22
				if m.spinSound then
					m.spinSound.Volume, m.spinSound.PlaybackSpeed = 0.5 * VOLUME, 1
					m.spinSound:Play()
				end
				m.led.Color = Color3.fromRGB(60, 255, 80)
				if m.steam then m.steam.Rate = 6 end
				task.delay(3 + math.random() * 2, function()
					m.spin = 0
					if m.spinSound then m.spinSound:Stop() end
					m.led.Color = Color3.fromRGB(255, 60, 40)
					if m.steam then m.steam.Rate = 0 end
					for _, e in ipairs(m.parts) do e[1].CFrame = m.cf * e[2] end
				end)
			end
		end
		if now >= puffAt then -- the dryers' vents puffing
			puffAt = now + 1.5 + math.random() * 3
			local m = pick(machines)
			if m.steam then pcall(function() m.steam:Emit(4) end) end
		end
		if now >= dripAt then
			dripAt = now + 1 + math.random() * 2.5
			FX.once(SND.Drip, pick(laundry.drips), { Volume = 0.7 * VOLUME, RollOffMaxDistance = 50, PlaybackSpeed = 0.85 + math.random() * 0.3 })
		end
		if now >= flickerAt then -- a neon tube blinking
			flickerAt = now + 1.5 + math.random() * 4
			local t = pick(laundry.tubes)
			tubeOn(t, false)
			FX.once(DOORS.zap, t.tubes[1], { RollOffMaxDistance = 40 })
			task.delay(0.06 + math.random() * 0.25, function() tubeOn(t, true) end)
		end
		if now >= clockAt then
			clockAt = now + 20
			setClock()
		end
		local _, _, me = body()
		if not me then return end
		local here = areaOf(me.Position)
		if (here == "laundry" or here == "attic") and now >= stormAt then -- the storm on DOORS' windows
			stormAt = now + 25 + math.random() * 30
			task.spawn(lightning)
		end
		if (here == "laundry" or here == "attic") and now >= dimAt then -- DOORS' lamps flickering, as DOORS flickers them
			dimAt = now + 22 + math.random() * 25
			task.spawn(flicker, if here == "attic" then atticModel else laundryModel)
		end
		-- DOORS' doors open as you come (unless locked)
		for _, d in ipairs(doors) do
			if not d.opened and not d.locked and flat(me.Position - d.leaf.Position).Magnitude < 7 and math.abs(me.Position.Y - d.leaf.Position.Y) < 6 then d.open() end
		end
		-- Where you are: its light; DOORS' title the first time
		if here ~= area then
			area = here
			if here then
				if not was then was = { Lighting.Ambient, Lighting.OutdoorAmbient } end
				Lighting.Ambient, Lighting.OutdoorAmbient = AMBIENT[here], AMBIENT[here]
			elseif was then
				Lighting.Ambient, Lighting.OutdoorAmbient = was[1], was[2]
				was = nil
			end
			if (here == "laundry" or here == "attic") and not seen[here] then
				seen[here] = true
				if here == "laundry" then
					FX.title("The Washroom", DOORS.courtyard)
					if stage.name == "start" then setStage("laundry") end
				else
					FX.title("The Attic", DOORS.hotel)
					setStage("attic")
				end
			end
		end
		-- DOORS' Guiding Light, when you are stuck
		local stuck = now - stage.since
		if not stage.guided then
			if stage.name == "laundry" and stuck > 35 then
				stage.guided = true
				guideAt(valve.center.Position, "The water is hiding something. There is a valve on the pipes.")
			elseif stage.name == "key" and key.model and stuck > 3 then
				stage.guided = true
				guideAt(key.model:GetPivot().Position + up * 0.5, "Something shines in the big drain.")
			elseif stage.name == "door" and stuck > 6 then
				stage.guided = true
				doorB02.guide(true)
				FX.remind("The key opens B-02.", true)
			elseif stage.name == "attic" and not doorB03.opened and stuck > 40 then
				stage.guided = true
				doorB03.guide(true)
				FX.remind("The way out is through B-03.", true)
			end
		end
		-- Through the door at the top of the way back: in room 0, in front of its door; it all closes
		if topDoor.opened and F:PointToObjectSpace(me.Position).Z < TOPZ - 0.5 then
			me.CFrame = backInTheHotel()
			FX.caption("Back in the Hotel")
			stop()
		end
	end)
	later(function()
		if was then Lighting.Ambient, Lighting.OutdoorAmbient = was[1], was[2] end
	end)
end

-- Dead, or taken away while you are down there: out of it first (else you would fall), all as it was
on(humanoid0.Died, function() task.delay(4, stop) end)
later(function()
	local character, _, root = body()
	if hidden then
		RunService:UnbindFromRenderStep(camName)
		if character then character:SetAttribute("Hiding", false) end
		hidden = nil
	end
	if root then
		root.Anchored = false
		if areaOf(root.Position) and not dead then root.CFrame = backInTheHotel() end
	end
end)

---====== THE ENTITIES: ROOMS: LOW DETAILED'S (fan-made, after its wiki; none of them rebounds) ======---

do
	local AREAS = {
		laundry = { x = LW / 2, z0 = LL / 2, z1 = -LL / 2, y = 0, model = laundryModel, middle = Vector3.new(0, 9, 0) },
		attic = { x = AW / 2, z0 = AZ0, z1 = AZ1, y = AY, model = atticModel, middle = Vector3.new(0, AY + 5.5, -66) },
	}
	local function hiddenSafe() return hidden ~= nil and not moving end
	-- A point in an area (F-space x, z), kept inside its walls
	local function inArea(a, x, y, z)
		return P(math.clamp(x, -a.x + 2, a.x - 2), y, math.clamp(z, math.min(a.z0, a.z1) + 2, math.max(a.z0, a.z1) - 2))
	end
	-- A low detailed face (flat dark shapes, as theirs) on a billboard: shapes { x, y, w, h } in 0..1
	local function lowFace(part, size, shapes, color, behind)
		local gui = make("BillboardGui", { Name = "Face", Size = UDim2.fromScale(size, size), LightInfluence = 0, MaxDistance = 400, AlwaysOnTop = false }, part)
		if behind then make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = behind, BorderSizePixel = 0, BackgroundTransparency = 0.15 }, gui) end
		for _, s in ipairs(shapes) do
			make("Frame", { Position = UDim2.fromScale(s[1], s[2]), Size = UDim2.fromScale(s[3], s[4]), BackgroundColor3 = color or Color3.new(0, 0, 0), BorderSizePixel = 0 }, gui)
		end
		return gui
	end
	-- A glowing ball (their bodies), its light, its particles in its colour
	local function orb(name, size, color, at)
		local m = make("Model", { Name = name }, folder)
		local p = box(name, Vector3.new(size, size, size), CFrame.new(at), color, M.Neon, { Shape = Enum.PartType.Ball, CanCollide = false, CanQuery = false, CastShadow = false }, m)
		m.PrimaryPart = p
		make("PointLight", { Color = color, Range = size * 5, Brightness = 2.2 }, p)
		make("ParticleEmitter", { Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = ColorSequence.new(color), LightEmission = 1, Rate = 35,
			Lifetime = NumberRange.new(0.6, 1.4), Speed = NumberRange.new(1, 3), Size = NumberSequence.new(size * 0.18, 0), SpreadAngle = Vector2.new(180, 180) }, p)
		return m, p
	end
	local function vanish(m, seconds)
		local p = m.PrimaryPart
		if p then
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("ParticleEmitter") then d.Enabled = false end
				if d:IsA("Sound") then d:Stop() end
			end
			TweenService:Create(p, TweenInfo.new(seconds or 0.6), { Size = p.Size * 0.05, Transparency = 1 }):Play()
		end
		task.delay((seconds or 0.6) + 1.5, function() m:Destroy() end)
	end
	-- Its face over your screen, its colour, DOORS' scare
	local scareFrame = make("Frame", { Name = "Scare", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ZIndex = 8 }, screen)
	local function jumpscare(color, shapes)
		scareFrame:ClearAllChildren()
		scareFrame.BackgroundColor3, scareFrame.BackgroundTransparency, scareFrame.Visible = color, 0, true
		for _, s in ipairs(shapes) do
			make("Frame", { Position = UDim2.fromScale(0.2 + s[1] * 0.6, 0.1 + s[2] * 0.8), Size = UDim2.fromScale(s[3] * 0.6, s[4] * 0.8), BackgroundColor3 = Color3.new(0, 0, 0),
				BorderSizePixel = 0, ZIndex = 9 }, scareFrame)
		end
		FX.once(id(10301924927), SoundService, { Volume = VOLUME * 0.9 }) -- (DOORS' HideMonster scare)
		FX.shake(10)
		task.delay(0.7, function() scareFrame.Visible = false end)
	end
	local function speak(part, text, color) -- (a bubble over it)
		local gui = part:FindFirstChild("Speech") or make("BillboardGui", { Name = "Speech", Size = UDim2.fromOffset(260, 46), StudsOffset = Vector3.new(0, part.Size.Y / 2 + 1.6, 0),
			LightInfluence = 0, MaxDistance = 120, AlwaysOnTop = true }, part)
		gui:ClearAllChildren()
		make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = text, Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = color,
			TextStrokeTransparency = 0.2 }, gui)
	end

	local FACES = {
		a45 = { { 0.18, 0.22, 0.2, 0.3 }, { 0.62, 0.22, 0.2, 0.3 }, { 0.15, 0.66, 0.7, 0.1 }, { 0.2, 0.6, 0.1, 0.08 }, { 0.45, 0.6, 0.1, 0.08 }, { 0.7, 0.6, 0.1, 0.08 } },
		a25 = { { 0.22, 0.3, 0.16, 0.16 }, { 0.62, 0.3, 0.16, 0.16 }, { 0.4, 0.62, 0.2, 0.22 } },
		a105 = { { 0.3, 0.25, 0.4, 0.4 }, { 0.3, 0.75, 0.4, 0.06 } },
		big = { { 0.3, 0.2, 0.1, 0.1 }, { 0.6, 0.2, 0.1, 0.1 }, { 0.2, 0.45, 0.6, 0.4 } },
		cb1 = { { 0.15, 0.25, 0.25, 0.12 }, { 0.6, 0.25, 0.25, 0.12 }, { 0.25, 0.6, 0.5, 0.06 }, { 0.3, 0.7, 0.4, 0.06 } },
		glee = { { 0.25, 0.25, 0.14, 0.2 }, { 0.61, 0.25, 0.14, 0.2 }, { 0.22, 0.6, 0.56, 0.12 }, { 0.16, 0.52, 0.1, 0.1 }, { 0.74, 0.52, 0.1, 0.1 } },
		nerd = { { 0.22, 0.32, 0.14, 0.14 }, { 0.64, 0.32, 0.14, 0.14 }, { 0.36, 0.38, 0.28, 0.04 }, { 0.38, 0.66, 0.24, 0.06 } },
	}
	local ENTITY = {} -- name -> function(areaName): it comes, does what it does, goes

	-- Glee: the helpful one. Loud and funny: it pops up by you when something is about to come
	local function glee()
		local _, _, me = body()
		if not me then return end
		local look = flat(workspace.CurrentCamera.CFrame.LookVector)
		look = if look.Magnitude > 0.1 then look.Unit else AHEAD
		local m, p = orb("Glee", 1.5, Color3.fromRGB(255, 168, 40), me.Position + look * 3.5 + up * 1.2)
		lowFace(p, 2.4, FACES.glee)
		speak(p, "SOMETHING'S COMING! HIDE!!", Color3.fromRGB(255, 196, 80))
		FX.once(LDR.Honk, p, { Volume = 1.8 * VOLUME, RollOffMinDistance = 30 })
		local t0, home = os.clock(), p.Position
		while alive and os.clock() - t0 < 2.6 do
			p.CFrame = CFrame.new(home + up * math.abs(math.sin((os.clock() - t0) * 9)) * 0.8)
			RunService.Heartbeat:Wait()
		end
		vanish(m, 0.3)
	end
	-- A-45: it starts with a bang and rushes through the room, slow and loud, the room shaking harder the nearer it is.
	-- Hide (a dryer, a wardrobe, under a table) or it gets you
	ENTITY["A-45"] = function(areaName)
		local a = AREAS[areaName]
		FX.once(SND.Bang, SoundService, { Volume = 2.4 * VOLUME })
		FX.once({ id(4988580646), 0.5, 0.8 }, SoundService) -- (a door's Break)
		task.spawn(flicker, a.model)
		FX.shake(4)
		if not wait(2.2) then return end
		local y = a.y + 6.5
		local from, to = inArea(a, 0, y, a.z0), inArea(a, 0, y, a.z1)
		local m, p = orb("A-45", 5, Color3.fromRGB(255, 214, 40), from)
		lowFace(p, 6, FACES.a45)
		make("ParticleEmitter", { Texture = "rbxasset://textures/particles/smoke_main.dds", Color = ColorSequence.new(Color3.fromRGB(255, 220, 90)), LightEmission = 0.6, Rate = 40,
			Lifetime = NumberRange.new(0.8, 1.6), Speed = NumberRange.new(0.5, 2), Size = NumberSequence.new(2, 5), Transparency = NumberSequence.new(0.5, 1) }, p)
		FX.loop(LDR.A45, p, { Volume = 2.6 * VOLUME, RollOffMinDistance = 30, RollOffMaxDistance = 500 })
		local speed, dist = 24, (to - from).Magnitude
		local t0, shakeAt = os.clock(), 0
		while alive do
			local u = (os.clock() - t0) * speed / dist
			if u >= 1 then break end
			local pos = from:Lerp(to, u) + RIGHT * math.sin(u * 9) * 3 + up * math.sin(u * 23) * 0.5
			p.CFrame = CFrame.new(pos)
			local _, _, me = body()
			if me then
				local d = (me.Position - pos).Magnitude
				if os.clock() > shakeAt then
					shakeAt = os.clock() + 0.2
					FX.shake(math.clamp(9 * (1 - d / 80), 0.4, 9))
				end
				if flat(me.Position - pos).Magnitude < 9 and math.abs(me.Position.Y - pos.Y) < 10 and not hiddenSafe() then
					jumpscare(Color3.fromRGB(255, 214, 40), FACES.a45)
					kill("A-45", { "You died to A-45.", "It starts with a bang, and the room shakes as it comes.", "It is slow: hide before it reaches you." })
					break
				end
			end
			RunService.Heartbeat:Wait()
		end
		vanish(m)
	end
	-- A-25: it comes from behind you, with the wind; a slight shake. Hide at once
	ENTITY["A-25"] = function(areaName)
		local a = AREAS[areaName]
		local _, _, me = body()
		if not me then return end
		local back = -flat(workspace.CurrentCamera.CFrame.LookVector)
		back = if back.Magnitude > 0.1 then back.Unit else -AHEAD
		local l = F:PointToObjectSpace(me.Position + back * 30)
		local m, p = orb("A-25", 3.6, Color3.fromRGB(80, 255, 120), inArea(a, l.X, a.y + 4, l.Z))
		p.Transparency = 0.25
		lowFace(p, 4.2, FACES.a25)
		FX.loop(LDR.Wind, p, { Volume = 2 * VOLUME, RollOffMinDistance = 12, RollOffMaxDistance = 200 })
		local t0, shakeAt, hiddenSince = os.clock(), 0, nil
		while alive and os.clock() - t0 < 14 do
			local dt = RunService.Heartbeat:Wait()
			local _, _, you = body()
			if not you then break end
			if hiddenSafe() then
				hiddenSince = hiddenSince or os.clock()
				if os.clock() - hiddenSince > 3 then break end
			else
