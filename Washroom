	local WOOD_DARK = Color3.fromRGB(70, 48, 36)
	-- A sturdy wooden table: `cf` its middle on the floor, `len` along its X, `wid` along its Z, `h` high
	local function woodTable(cf, len, wid, h, parent, color)
		local t = { model = make("Model", { Name = "Table" }, parent), cf = cf, len = len, wid = wid, h = h }
		color = color or WOOD_DARK
		t.top = box("Top", Vector3.new(len, 0.3, wid), cf * CFrame.new(0, h - 0.15, 0), color, M.Wood, nil, t.model)
		box("Apron", Vector3.new(len - 0.6, 0.45, wid - 0.6), cf * CFrame.new(0, h - 0.52, 0), color, M.Wood, { CanCollide = false }, t.model)
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				local leg = cf * CFrame.new(sx * (len / 2 - 0.45), 0, sz * (wid / 2 - 0.45))
				box("Leg", Vector3.new(0.34, h - 0.3, 0.34), leg * CFrame.new(0, (h - 0.3) / 2, 0), color, M.Wood, nil, t.model)
				ball("Leg", Vector3.new(0.5, 0.5, 0.5), leg * CFrame.new(0, (h - 0.3) * 0.55, 0), color, M.Wood, { CanCollide = false }, t.model)
			end
		end
		t.inside = cf * CFrame.new(0, 1.2, 0) -- (where you are under it: low)
		t.front = cf * CFrame.new(0, 0, wid / 2 + 2.2)
		table.insert(tables, t)
		return t
	end
	-- A wooden chair (seat, legs, a back of slats), `cf` its middle on the floor, looking out of its front
	local function chair(cf, parent)
		local m = make("Model", { Name = "Chair" }, parent)
		box("Seat", Vector3.new(1.9, 0.22, 1.9), cf * CFrame.new(0, 1.9, 0), WOOD_DARK, M.Wood, nil, m)
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				local tall = sz > 0
				local h = if tall then 4.6 else 1.8
				box("Leg", Vector3.new(0.22, h, 0.22), cf * CFrame.new(sx * 0.8, h / 2, sz * 0.8), WOOD_DARK, M.Wood, nil, m)
			end
		end
		for i = 1, 3 do box("Slat", Vector3.new(1.6, 0.25, 0.12), cf * CFrame.new(0, 2.6 + i * 0.6, 0.8), WOOD_DARK, M.Wood, nil, m) end
		return m
	end
	-- A barrel: `cf` its middle, its axis along cf's X; staves, three iron hoops, its ends
	local function barrel(cf, parent)
		local m = make("Model", { Name = "Barrel" }, parent)
		local len, d = 3.4, 2.5
		cylinder("Staves", len, d, cf, Color3.fromRGB(122, 82, 52), M.WoodPlanks, nil, m)
		cylinder("Staves", len * 0.55, d + 0.18, cf, Color3.fromRGB(128, 86, 55), M.WoodPlanks, nil, m)
