		ring("Loop", cf * CFrame.new(-1.08, 0, 0) * CFrame.Angles(math.pi / 2, 0, 0), 0.09, 0.03, 8, Color3.fromRGB(150, 150, 150), M.Metal, extra, m)
		local tag = box("Tag", Vector3.new(0.36, 0.03, 0.5), cf * CFrame.new(-1.3, -0.02, 0.12) * CFrame.Angles(0, 0.3, 0), Color3.fromRGB(196, 174, 128), M.SmoothPlastic, extra, m)
		for _, face in ipairs({ "Top", "Bottom" }) do
			make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = number, Font = Enum.Font.Antique, TextScaled = true,
				TextColor3 = Color3.fromRGB(70, 40, 30), Rotation = 90 }, make("SurfaceGui", { Face = Enum.NormalId[face], PixelsPerStud = 120, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud }, tag))
		end
		return m
	end
	-- A tool of DOORS' kind: into your Backpack, so DOORS' hotbar shows it (its icon) and you hold it as DOORS' items are held
	-- (its Animations folder: DOORS' inventory loads an item's animations from it). Its parts welded to its Handle; `forward` how
	-- far ahead of your grip its Handle is (its X pointing ahead)
	local function tool(name, icon, model, forward)
		local t = make("Tool", { Name = name, TextureId = icon, RequiresHandle = true, CanBeDropped = false, ToolTip = name }, nil)
		make("Folder", { Name = "Animations" }, t)
		local handle = model.PrimaryPart
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then
				p.Anchored, p.CanCollide, p.Massless, p.CanTouch = false, false, true, false
				if p ~= handle then make("WeldConstraint", { Part0 = handle, Part1 = p }, p) end
			end
		end
		handle.Name = "Handle"
		for _, c in ipairs(model:GetChildren()) do c.Parent = t end
		model:Destroy()
		t.Grip = (CFrame.new(0, 0, -forward) * CFrame.fromMatrix(Vector3.new(0, 0, 0), Vector3.new(0, 0, -1), Vector3.new(0, 1, 0))):Inverse()
		t.Parent = LocalPlayer:FindFirstChildOfClass("Backpack")
		table.insert(items, t)
		return t
	end
	later(function()
		for _, t in ipairs(items) do pcall(function() t:Destroy() end) end
	end)
	local function giveKey(number)
		local t = tool("Key", DOORS.keyIcon, keyModel(CFrame.new(), nil, number), 0.75)
		t:SetAttribute("Door", number)
		t.ToolTip = "Key " .. number
		FX.once(DOORS.tick, SoundService, { PlaybackSpeed = 1.6 })
		FX.caption("Key " .. number)
		return t
	end
	local function giveFlashlight()
		local m = make("Model", { Name = "Flashlight" }, nil)
		local bodyPart = cylinder("Body", 1.0, 0.26, CFrame.new(), Color3.fromRGB(40, 42, 46), M.Metal, { CanCollide = false }, m)
		m.PrimaryPart = bodyPart
		cylinder("Head", 0.32, 0.42, CFrame.new(0.6, 0, 0), Color3.fromRGB(60, 62, 66), M.Metal, { CanCollide = false }, m)
		cylinder("Lens", 0.04, 0.34, CFrame.new(0.78, 0, 0), Color3.fromRGB(255, 244, 210), M.Neon, { CanCollide = false }, m)
		box("Switch", Vector3.new(0.18, 0.08, 0.12), CFrame.new(0, 0.14, 0), Color3.fromRGB(170, 40, 30), M.SmoothPlastic, { CanCollide = false }, m)
		local beam = make("SpotLight", { Name = "Beam", Range = 45, Angle = 50, Brightness = 2.2, Color = Color3.fromRGB(255, 240, 210), Enabled = false, Shadows = true,
			Face = Enum.NormalId.Right }, bodyPart)
		local t = tool("Flashlight", DOORS.flashlightIcon, m, 0.1)
		local lit = true
		on(t.Equipped, function() beam.Enabled = lit end)
		on(t.Unequipped, function() beam.Enabled = false end)
		on(t.Activated, function() -- (a click: on, off)
			lit = not lit
			beam.Enabled = lit
			FX.once(SND.Clank, SoundService, { Volume = 0.25 * VOLUME, PlaybackSpeed = 2.5 })
		end)
		FX.caption("Flashlight")
	end
	local function addGold(amount)
		FX.caption(("+%d Gold"):format(amount))
		pcall(function() -- (on your screen only)
			for _, label in ipairs(LocalPlayer.PlayerGui.PermUI:GetDescendants()) do
				if label:IsA("TextLabel") and label.Name == "Gold" and tonumber(label.Text) then label.Text = tostring(tonumber(label.Text) + amount) end
			end
		end)
	end
	-- Something lying there to take (DOORS' Interact animation as you take it)
	local function takeable(model, part, action, objectText, distance, onTake)
		local prompt = make("ProximityPrompt", { ActionText = action, ObjectText = objectText, HoldDuration = 0, MaxActivationDistance = distance, RequiresLineOfSight = false,
			Style = Enum.ProximityPromptStyle.Custom }, part)
		on(prompt.Triggered, function()
			prompt:Destroy()
			animate(DOORS.interact)
			onTake()
			model:Destroy()
		end)
		return prompt
	end
	-- A pile of gold coins, sparkling as DOORS' do, its sounds (DOORS' prompt: Collect, Gold ( n ))
	local function goldPile(cf, parent)
		local m = make("Model", { Name = "GoldPile" }, parent or folder)
		local base = nil
		for i = 1, 9 do
			local a, r = math.random() * math.pi * 2, math.random() * 0.45
			local coin = cylinder("Coin", 0.07, 0.42, cf * CFrame.new(math.cos(a) * r, 0.065 + (i % 3) * 0.07, math.sin(a) * r) * CFrame.Angles(rnd(0.15), 0, math.pi / 2 + rnd(0.15)),
				Color3.fromRGB(255, 196, 58), M.Metal, { Reflectance = 0.35, CanCollide = false }, m)
			base = base or coin
		end
		m.PrimaryPart = base
		make("ParticleEmitter", { Texture = DOORS.goldSparkle, Rate = 6, Lifetime = NumberRange.new(0.5, 1), Speed = NumberRange.new(0.2), Size = NumberSequence.new(0.35),
			LightEmission = 1, SpreadAngle = Vector2.new(180, 180) }, base)
		FX.once(DOORS.goldShine, base)
		local amount = math.random(5, 25)
		takeable(m, base, "Collect", ("Gold ( %d )"):format(amount), 8, function()
			FX.once(DOORS.gold, SoundService)
			addGold(amount)
		end)
		return m
	end
	local function flashlightItem(cf, parent)
		local m = make("Model", { Name = "FlashlightItem" }, parent or folder)
		local bodyPart = cylinder("Body", 1.0, 0.26, cf * CFrame.new(0, 0.14, 0), Color3.fromRGB(40, 42, 46), M.Metal, { CanCollide = false }, m)
		m.PrimaryPart = bodyPart
		cylinder("Head", 0.32, 0.42, cf * CFrame.new(0.6, 0.2, 0), Color3.fromRGB(60, 62, 66), M.Metal, { CanCollide = false }, m)
		cylinder("Lens", 0.04, 0.34, cf * CFrame.new(0.78, 0.2, 0), Color3.fromRGB(255, 244, 210), M.Neon, { CanCollide = false }, m)
		box("Switch", Vector3.new(0.18, 0.08, 0.12), cf * CFrame.new(0, 0.28, 0), Color3.fromRGB(170, 40, 30), M.SmoothPlastic, { CanCollide = false }, m)
		takeable(m, bodyPart, "Take", "Flashlight", 7, giveFlashlight)
		return m
	end
	-- A key lying there, shining (`onTaken` when it is in your inventory)
	function keyItem(cf, parent, number, onTaken)
		local m = keyModel(cf, parent, number)
		make("ParticleEmitter", { Texture = DOORS.goldSparkle, Rate = 4, Lifetime = NumberRange.new(0.6, 1.2), Speed = NumberRange.new(0.1), Size = NumberSequence.new(0.4),
			LightEmission = 1, Color = ColorSequence.new(Color3.fromRGB(255, 230, 160)), SpreadAngle = Vector2.new(180, 180) }, m.PrimaryPart)
		keys[number] = m
		takeable(m, m.PrimaryPart, "Take", "Key", 7, function()
			keys[number] = nil
			giveKey(number)
			if onTaken then onTaken() end
		end)
		return m
	end
	-- What a place holds, made where it opens (its loot: "gold", "flashlight", "key" (B-03's), "nothing")
	function stash(cf, parent, o)
		if o.loot == "gold" then return goldPile(cf, parent) end
		if o.loot == "flashlight" then return flashlightItem(cf, parent) end
		if o.loot == "key" then return keyItem(cf * CFrame.Angles(0, 0.6, 0) * CFrame.new(0.5, 0.09, 0), parent, "B-03", function() o.keyTaken = true end) end
		FX.caption("Nothing.")
		return nil
	end
	-- What is put in a drawer goes with the drawer (out, in)
	local followers = {}
	local function follow(m, part)
		if m then table.insert(followers, { m = m, part = part, rel = part.CFrame:ToObjectSpace(m:GetPivot()) }) end
	end
	on(RunService.Heartbeat, function()
		for i = #followers, 1, -1 do
			local f = followers[i]
			if f.m.Parent and f.part.Parent then f.m:PivotTo(f.part.CFrame * f.rel) else table.remove(followers, i) end
		end
	end)
	local function opener(area, part, action, object, open, distance)
		local o = { part = part, loot = "nothing" }
		o.prompt = make("ProximityPrompt", { ActionText = action, ObjectText = object, HoldDuration = 0, MaxActivationDistance = distance or 7, RequiresLineOfSight = false,
			Style = Enum.ProximityPromptStyle.Custom }, part)
		on(o.prompt.Triggered, function() open(o) end)
		table.insert(openers[area], o)
		return o
	end
	-- DOORS' drawers (a dresser's, a table's): each slides out on its own rail (its PrismaticConstraint's servo, as DOORS'), its
	-- own Open and Close sounds, and in again; DOORS' prompt (Open / Close, Drawer)
	local function drawers(furniture, area, parent)
		if not furniture then return end
		local out = if furniture.PrimaryPart then furniture.PrimaryPart.CFrame.LookVector else RIGHT
		for _, container in ipairs(furniture:GetChildren()) do
			local main, holder = container:FindFirstChild("Main"), container:FindFirstChild("Holder")
			local knobs = container:FindFirstChild("Knobs") or main
			if container:IsA("Model") and container.Name == "DrawerContainer" and main and main:IsA("BasePart") then
				for _, d in ipairs(container:GetChildren()) do -- (DOORS' own loot out of it: ours goes in)
					if d:IsA("Model") or d:IsA("Tool") then d:Destroy() end
				end
				local parts = {}
				for _, p in ipairs(container:GetDescendants()) do
					if p:IsA("BasePart") and p ~= holder then table.insert(parts, p) end
				end
				local slide = container:FindFirstChildOfClass("PrismaticConstraint")
				local a0, a1 = main:FindFirstChildOfClass("Attachment"), holder and holder:FindFirstChildOfClass("Attachment")
				if a0 and a1 then -- (shut, on its rail: the lobby's may be open)
					local delta = (a1.WorldCFrame * a0.CFrame:Inverse()) * main.CFrame:Inverse()
					local to = {}
					for i, p in ipairs(parts) do to[i] = delta * p.CFrame end
					for i, p in ipairs(parts) do p.CFrame = to[i] end
				end
				if slide then slide.TargetPosition = 0 end
				local shut = {}
				for i, p in ipairs(parts) do shut[i] = p.CFrame end
				local mainShut = main.Position
				local travel = if slide then slide.UpperLimit else 1.4
				local isOpen = false
				local function glide(to) -- (where nothing moves it here: as its rail would have)
					for _, p in ipairs(parts) do p.Anchored = true end
					local from = {}
					for i, p in ipairs(parts) do from[i] = p.CFrame end
					task.spawn(function()
						local t0 = os.clock()
						while alive and os.clock() - t0 < 0.3 do
							local u = 1 - (1 - (os.clock() - t0) / 0.3) ^ 2
							for i, p in ipairs(parts) do p.CFrame = from[i]:Lerp(shut[i] + out * travel * to, u) end
							RunService.Heartbeat:Wait()
						end
						for i, p in ipairs(parts) do p.CFrame = shut[i] + out * travel * to end
					end)
				end
				opener(area, knobs, "Open", "Drawer", function(o)
					animate(DOORS.interact)
					isOpen = not isOpen
					o.prompt.ActionText = if isOpen then "Close" else "Open"
					local sound = main:FindFirstChild(if isOpen then "Open" else "Close")
					if not (sound and sound:IsA("Sound") and pcall(function() sound:Play() end)) then FX.once(if isOpen then DOORS.drawerOpen else DOORS.drawerClose, main) end
					local to = if isOpen then 1 else 0
					if slide then
						for _, p in ipairs(parts) do p.Anchored = false end
						slide.TargetPosition = if isOpen then 5 else 0
						task.delay(0.6, function()
							if alive and main.Parent and math.abs((main.Position - mainShut):Dot(out) - travel * to) > 0.3 then glide(to) end
						end)
					else
						glide(to)
					end
					if isOpen and not o.looked then
						o.looked = true
						task.delay(0.35, function()
							if alive then follow(stash(main.CFrame * CFrame.new(0, -0.04, 0), parent, o), main) end -- (on its floor, where DOORS puts it)
						end)
					end
				end, 6)
			end
		end
	end
	for _, d in ipairs(laundry.dressers) do drawers(d, "laundry", laundryModel) end
	for _, d in ipairs(attic.dressers) do drawers(d, "attic", atticModel) end
	drawers(attic.drawerTable, "attic", atticModel)
	-- Four washers (shut, not running): their door swings open, something in the drum or nothing
	do
		local shut = {}
		for _, m in ipairs(machines) do
			if m.water and not m.wash then table.insert(shut, m) end
		end
		for _ = 1, math.min(4, #shut) do
			local m = table.remove(shut, math.random(#shut))
			m.searchable = true
			opener("laundry", m.glass, "Search", "Washer", function(o)
				o.prompt:Destroy()
				animate(DOORS.interact)
				swingDoor(m, 0.9, 0.5)
				task.delay(0.5, function() stash(m.drumFrame * CFrame.new(-0.6, -0.5, 0) * CFrame.Angles(0, -math.pi / 2, 0), laundryModel, o) end)
			end)
		end
	end
	-- The carts: under the linen on their platform
	for _, cart in ipairs(laundry.carts) do
		local part = cart.PrimaryPart
		if part then
			opener("laundry", part, "Search", "Cart", function(o)
				o.prompt:Destroy()
				animate(DOORS.interact)
				stash(part.CFrame * CFrame.new(0, part.Size.Y / 2 + 1.5, 0), laundryModel, o) -- (on the linen in the middle)
			end)
		end
	end
	-- The crates: their lid swung up on its far edge (from you), standing; in the straw something or nothing
	for _, c in ipairs(attic.crates) do
		opener("attic", c.lid, "Open", "Crate", function(o)
			o.prompt:Destroy()
			animate(DOORS.interact)
			FX.once(DOORS.drawerOpen, c.lid, { PlaybackSpeed = 0.7 })
			local cf = c.lid.CFrame
			local _, _, me = body()
			local k = if me and cf:PointToObjectSpace(me.Position).Z < 0 then -1 else 1 -- (the side you are on)
			local hinge = cf * CFrame.new(0, 0.125, -k * c.size.Z / 2)
			local rel = hinge:ToObjectSpace(cf)
			task.spawn(function()
				local t0 = os.clock()
				while alive and os.clock() - t0 < 0.4 do
					c.lid.CFrame = hinge * CFrame.Angles(-k * 1.62 * (1 - (1 - (os.clock() - t0) / 0.4) ^ 2), 0, 0) * rel
					RunService.Heartbeat:Wait()
				end
				c.lid.CFrame = hinge * CFrame.Angles(-k * 1.62, 0, 0) * rel
			end)
			stash(c.inside, atticModel, o)
		end)
	end
	-- DOORS' chests: their lid and band swing up on their hinge
	for _, chest in ipairs(attic.chests) do
		opener("attic", chest.base, "Open", "Chest", function(o)
			o.prompt:Destroy()
			animate(DOORS.interact)
			FX.once(DOORS.drawerOpen, chest.base, { PlaybackSpeed = 0.55 })
			task.spawn(function()
				local t0 = os.clock()
				while alive and os.clock() - t0 < 0.5 do
					local a = -1.9 * (1 - (1 - (os.clock() - t0) / 0.5) ^ 2)
					for i, p in ipairs(chest.lid) do p.CFrame = chest.hinge * CFrame.Angles(0, 0, a) * chest.rel[i] end
					RunService.Heartbeat:Wait()
				end
				for i, p in ipairs(chest.lid) do p.CFrame = chest.hinge * CFrame.Angles(0, 0, -1.9) * chest.rel[i] end
			end)
			stash(chest.base.CFrame * CFrame.new(0, chest.size.Y / 2 - 0.1, 0), atticModel, o)
		end)
	end
	-- What they hold: one flashlight (down in the laundry), B-03's key (up in the attic), gold in about half, nothing in the rest
	for area, special in pairs({ laundry = "flashlight", attic = "key" }) do
		local list = openers[area]
		for _, o in ipairs(list) do o.loot = if math.random() < 0.45 then "gold" else "nothing" end
		if #list > 0 then
			local o = list[math.random(#list)]
			o.loot = special
			if special == "key" then openers.key = o end
		end
	end
end

