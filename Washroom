---====== DOORS' DOORS: copies of your room's own (its leaf, knob, number, light, frame, sounds, its lock, its Guiding Light) ======---

local doors = {}
-- A door where a room's end would be: at (x, y, z), the way through it `dir`; with `locked`, DOORS' lock on it
local doorAt
do
	local doorTemplate = hotelRoom and hotelRoom:FindFirstChild("Door")
	local frameTemplate = hotelRoom and hotelRoom:FindFirstChild("Parts") and hotelRoom.Parts:FindFirstChild("End_DoorFrame")
	function doorAt(x, y, z, dir, number, locked, parent)
		local base = P(x, y, z)
		local frame = CFrame.lookAt(base + up * endLift, base + up * endLift + dir)
		local door = { model = nil, parts = {}, locked = false, dir = dir, number = number }
		if doorTemplate and roomEnd then
			local ok = pcall(function()
				local copy = doorTemplate:Clone()
				for _, name in ipairs(if locked then { "Hidden" } else { "Lock", "Hidden" }) do
					local d = copy:FindFirstChild(name)
					if d then d:Destroy() end
				end
				clean(copy)
				local leaf = copy:FindFirstChild("Door")
				-- Shut (where the Hotel- keeps it stood shut)
				local original = leaf:FindFirstChild("OriginalCFrameValue")
				local group = { leaf }
				for _, d in ipairs(leaf:GetDescendants()) do
					if d:IsA("BasePart") then table.insert(group, d) end
				end
				local rel = {}
				for i, p in ipairs(group) do rel[i] = leaf.CFrame:ToObjectSpace(p.CFrame) end
				if original then
					for i, p in ipairs(group) do p.CFrame = original.Value * rel[i] end
				end
				copy:PivotTo(frame * roomEnd.CFrame:ToObjectSpace(copy:GetPivot())) -- (its pivot is its leaf: the copy's own, now shut)
				door.model, door.leaf, door.hinge = copy, leaf, copy:FindFirstChild("Hinge")
				door.closed = leaf.CFrame
				for i, p in ipairs(group) do door.parts[i] = { p, leaf.CFrame:ToObjectSpace(p.CFrame) } end
				for _, d in ipairs(copy:GetDescendants()) do
					if d:IsA("BasePart") then d.CanCollide = d == leaf end
					if d:IsA("TextLabel") and number then d.Text = number end
				end
				door.light = copy:FindFirstChild("Light")
				-- Its lock hung on it, shut, under the knob on your side (the Hotel- has it fallen: its shackle back in it)
				local lock = locked and copy:FindFirstChild("Lock")
				if lock and lock:IsA("BasePart") then
					local lockParts = { lock }
					for _, d in ipairs(lock:GetDescendants()) do
						if d:IsA("BasePart") then table.insert(lockParts, d) end
					end
					local relLock = {}
					for i, p in ipairs(lockParts) do relLock[i] = lock.CFrame:ToObjectSpace(p.CFrame) end
					local shackle = lock:FindFirstChild("Thing")
					local where = door.closed * CFrame.new(-1.55, -1.25, 0.52) * CFrame.Angles(0, math.pi, 0)
					for i, p in ipairs(lockParts) do p.CFrame = if p == shackle then where * CFrame.new(0, 1.03, 0) else where * relLock[i] end
					door.lock = { body = lock, parts = lockParts, shackle = shackle, at = where, hole = lock:FindFirstChild("Hole") or lock }
				end
				copy.Parent = parent or folder
			end)
			if not ok then door.model = nil end
			if frameTemplate then
				pcall(function()
					local f = clean(frameTemplate:Clone())
					f:PivotTo(frame * roomEnd.CFrame:ToObjectSpace(f:GetPivot()))
					f.Parent = parent or folder
				end)
			end
		end
		if not door.model then -- (outside the Hotel-: one like them)
			door.model = make("Model", { Name = "Door" }, parent or folder)
			door.leaf = box("Door", Vector3.new(5, 7.75, 0.4), frame * CFrame.new(0, 0, 0.5), Color3.fromRGB(129, 111, 100), M.Wood, nil, door.model)
			door.hinge = box("Hinge", Vector3.new(0.2, 1.4, 0.4), frame * CFrame.new(2.4, 0, 0.5), Color3.fromRGB(120, 120, 130), M.Metal, { CanCollide = false }, door.model)
			door.closed = door.leaf.CFrame
			door.parts = { { door.leaf, CFrame.new() } }
			make("Sound", { Name = "Open", SoundId = "rbxassetid://320946744", Volume = VOLUME }, door.leaf)
			make("Sound", { Name = "Unlock", SoundId = "rbxassetid://404411038", Volume = VOLUME * 0.5 }, door.leaf)
			make("Sound", { Name = "Error", SoundId = "rbxassetid://169112309", Volume = VOLUME * 0.4 }, door.leaf)
			if locked then
				local where = door.closed * CFrame.new(-1.55, -1.25, 0.5)
				local lock = box("Lock", Vector3.new(1.0, 0.9, 0.4), where, Color3.fromRGB(111, 104, 101), M.Metal, { CanCollide = false }, door.model)
				local shackle = ring("Thing", where * CFrame.new(0, 0.55, 0), 0.32, 0.12, 8, Color3.fromRGB(170, 170, 175), M.Metal, { CanCollide = false }, door.model)[1]
				door.lock = { body = lock, parts = { lock, shackle }, shackle = shackle, at = where, hole = lock }
			end
			local attach = make("Attachment", { Name = "LightAttach", CFrame = CFrame.new(0, 0, 9) * CFrame.Angles(0, math.pi, 0) }, door.leaf)
			make("SpotLight", { Name = "HelpLight", Color = Color3.fromRGB(39, 190, 255), Range = 32, Brightness = 8, Angle = 40, Face = Enum.NormalId.Back, Enabled = false }, attach)
		end
		door.locked = locked == true
		-- Open: as DOORS' swing, a quarter turn on its hinge, away from you
		local h = if door.hinge then door.hinge.Position else door.closed.Position
		local function at(angle) return CFrame.new(h) * CFrame.Angles(0, angle, 0) * CFrame.new(-h) * door.closed end
		local turn = -math.pi / 2
		if (at(turn).Position - door.closed.Position):Dot(dir) < 0 then turn = -turn end
		function door.pose(angle)
			local cf = at(angle)
			for _, e in ipairs(door.parts) do e[1].CFrame = cf * e[2] end
		end
		function door.open()
			if door.opened then return end
			door.opened = true
			door.guide(false)
			playOwn(door.model, "Open")
			door.leaf.CanCollide = false
			task.spawn(function()
				local t0 = os.clock()
				while alive and os.clock() - t0 < 0.6 do
					local u = (os.clock() - t0) / 0.6
					door.pose(turn * (1 - (1 - u) ^ 3))
					RunService.Heartbeat:Wait()
				end
				door.pose(turn)
			end)
		end
		function door.color(c)
			pcall(function()
				for _, d in ipairs(door.light:GetDescendants()) do
					if d:IsA("Light") then d.Color, d.Enabled = c, true end
				end
				door.light.Color, door.light.Material = c, M.Neon
			end)
		end
		-- DOORS' Guiding Light on it: its own blue light and sparkles (its LightAttach's HelpLight, HelpParticle)
		function door.guide(lit)
			for _, d in ipairs(door.leaf:GetDescendants()) do
				if d.Name == "HelpLight" or d.Name == "HelpParticle" then pcall(function() d.Enabled = lit end) end
			end
		end
		table.insert(doors, door)
		return door
	end
end

