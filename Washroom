---====== YOU ======---

local function body()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then return character, humanoid, root end
	return nil, nil, nil
end
local _, humanoid0, root0 = body()
if not root0 then
	stop()
	return
end
-- DOORS' animations on your character (LSPLASH's, as the Hotel- is: they play here, and everyone sees them)
local tracks = {}
local function animate(id, speed)
	local _, humanoid = body()
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then return nil end
	local track = tracks[id]
	if not track then
		local a = Instance.new("Animation")
		a.AnimationId = id
		local ok, t = pcall(function() return animator:LoadAnimation(a) end)
		if not ok then return nil end
		track = t
		tracks[id] = track
	end
	pcall(function()
		track.Priority = Enum.AnimationPriority.Action
		track:Play(0.1, 1, speed or 1)
	end)
	return track
end
later(function()
	for _, t in pairs(tracks) do pcall(function() t:Stop(0.2) end) end
end)

