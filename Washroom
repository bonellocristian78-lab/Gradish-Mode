	TileSize = UDim2.fromOffset(46, 46), ImageTransparency = 1, Visible = false, ZIndex = 2 }, screen)
local camName = "WashroomHide" .. math.random(1, 1e6)
local hideMonster, hideStart, moving = nil, 0, false
local function doorsCamera(look) -- DOORS' camera lock (its CamLock), else one like it
	local ok = firesignal and pcall(function() firesignal(ReplicatedStorage.Bricks.CamLock.OnClientEvent, look) end)
	if ok then return end
	local camera = workspace.CurrentCamera
	RunService:BindToRenderStep(camName, Enum.RenderPriority.Last.Value, function()
		local m = hiddenIn
		if not m then return end
		local eye = m.inside.Position + Vector3.new(0, 1.2 + math.sin(os.clock() * 1.4) * 0.04, 0)
		camera.CFrame = CFrame.lookAt(eye, eye + look + Vector3.new(0, -0.1, 0))
	end)
end
local function tweenRoot(root, to, seconds)
	local from = root.CFrame
	local t0 = os.clock()
	while alive and os.clock() - t0 < seconds do
		local u = (os.clock() - t0) / seconds
		root.CFrame = from:Lerp(to, u * u * (3 - 2 * u))
		RunService.Heartbeat:Wait()
	end
	root.CFrame = to
end
local function hide(m)
	local character, _, root = body()
	if not root or hiddenIn or moving then return end
	moving, hiddenIn, hideStart = true, m, os.clock()
	m.prompt.Enabled = false
	FX.once(DOORS.hideIn, m.drum, { Volume = VOLUME })
	FX.once(SND.Clank, m.drum, { Volume = 1.2 * VOLUME })
	animate(DOORS.enter)
	root.Anchored = true
	local front = m.face * CFrame.new(0, 0, -2.5)
	local y = root.Position.Y
	tweenRoot(root, CFrame.lookAt(Vector3.new(front.X, y, front.Z), Vector3.new(m.inside.X, y, m.inside.Z)), 0.25)
	tweenRoot(root, CFrame.lookAt(m.inside.Position, m.inside.Position + m.face.LookVector), 0.55)
	swingDoor(m, 0, 0.35) -- (it shuts behind you)
	character:SetAttribute("Hiding", true)
	doorsCamera(m.face.LookVector)
	grille.Visible = true
	TweenService:Create(grille, TweenInfo.new(0.4), { ImageTransparency = 0.05 }):Play()
	m.prompt.ActionText = "Get out"
	m.prompt.Enabled = true
	moving = false
end
local function getOut(forced)
	local m = hiddenIn
	local character, _, root = body()
	if not m or moving then return end
	moving = true
	m.prompt.Enabled = false
	if hideMonster then hideMonster.camlock = nil end -- (DOORS' Hide effect ends with it)
	hideMonster = nil
	RunService:UnbindFromRenderStep(camName)
	grille.Visible, grille.ImageTransparency = false, 1
	if character then character:SetAttribute("Hiding", false) end -- (DOORS lets the camera go itself)
	animate(if forced then DOORS.forceOut else DOORS.exit)
	FX.once(DOORS.hideOut, m.drum, { Volume = VOLUME })
	swingDoor(m, 1, 0.3)
	if root then
		local front = m.face * CFrame.new(0, 0, -3)
		local p = Vector3.new(front.X, F.Y + 3.2, front.Z)
		tweenRoot(root, CFrame.lookAt(p, p + flat(m.face.LookVector)), if forced then 0.35 else 0.6)
		root.Anchored = false
		if forced then root.AssemblyLinearVelocity = flat(m.face.LookVector) * 30 + up * 12 end
	end
	hiddenIn = nil
	m.prompt.ActionText = "Hide"
	m.prompt.Enabled = true
	moving = false
	if forced then
		FX.caption("Get out.")
		damage(40, "Hide", { "You died to Hide.", "Don't stay hidden for too long." })
	end
end
