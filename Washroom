local alive = true
local connections, cleanups = {}, {}
local function on(signal, fn)
	local c = signal:Connect(fn)
	table.insert(connections, c)
	return c
end
local function later(fn) table.insert(cleanups, fn) end
local function stop()
	if not alive then return end
	alive = false
	for _, c in ipairs(connections) do c:Disconnect() end
	for i = #cleanups, 1, -1 do pcall(cleanups[i]) end
	folder:Destroy()
	screen:Destroy()
	if GENV.__Washroom == stop then GENV.__Washroom = nil end
end
GENV.__Washroom = stop
local function wait(seconds)
	local t0 = os.clock()
	repeat RunService.Heartbeat:Wait() until not alive or os.clock() - t0 >= seconds
	return alive
end
local function untag(d)
	pcall(function()
		for _, tag in ipairs(CollectionService:GetTags(d)) do CollectionService:RemoveTag(d, tag) end
	end)
end

