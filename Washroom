-- One of DOORS' chandeliers (room 0's) hanging from the ceiling `ceiling` (its height), its light `drop` under it
local function chandelier(x, z, ceiling, drop, parent)
	local copy = copyOf(T.chandelier)
	if not copy then -- (one like it: a dark iron ring of candles)
		copy = make("Model", { Name = "Chandelier" }, parent or folder)
		local c = L(x, ceiling - drop, z)
		local stand = box("Stand", Vector3.new(0.5, 1.2, 0.5), c * CFrame.new(0, 0.6, 0), Color3.fromRGB(60, 46, 38), M.Metal, { CanCollide = false }, copy)
		copy.PrimaryPart = stand
		ring("LightFixture", c * CFrame.Angles(math.pi / 2, 0, 0), 1.4, 0.15, 12, Color3.fromRGB(60, 46, 38), M.Metal, { CanCollide = false }, copy)
		for i = 1, 6 do
			local a = i / 6 * math.pi * 2
			box("Neon", Vector3.new(0.18, 0.4, 0.18), c * CFrame.new(math.cos(a) * 1.4, 0.3, math.sin(a) * 1.4), Color3.fromRGB(255, 214, 160), M.Neon, { CanCollide = false }, copy)
		end
		make("PointLight", { Color = Color3.fromRGB(235, 167, 98), Range = 22, Brightness = 1.2, Shadows = true }, stand)
		box("Base", Vector3.new(0.07, drop - 0.6, 0.07), L(x, ceiling - (drop - 0.6) / 2, z), Color3.fromRGB(60, 46, 38), M.Metal, { CanCollide = false }, copy)
		return copy
	end
	local stand = copy.PrimaryPart
	pose(copy, L(x, ceiling - drop, z) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	for _, p in ipairs(copy:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = false
			if p.Size.Y > 10 and p.Size.X < 0.2 then -- (its rod, up to the ceiling)
				local top = stand.Position.Y + stand.Size.Y / 2
				local roof = P(x, ceiling, z).Y
				p.Size = Vector3.new(p.Size.X, roof - top + 0.3, p.Size.Z)
				p.CFrame = CFrame.new(stand.Position.X, (top + roof + 0.3) / 2, stand.Position.Z)
			end
		end
	end
	copy.Parent = parent or folder
	playLoops(copy)
	return copy
end
