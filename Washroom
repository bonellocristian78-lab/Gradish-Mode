		TextScaled = true, TextColor3 = Color3.fromRGB(150, 240, 150), Text = "NERD MAN: SOLVE IT!", ZIndex = 11 }, quiz)
	local quizQuestion = make("TextLabel", { Size = UDim2.new(1, -20, 0, 60), Position = UDim2.fromOffset(10, 48), BackgroundTransparency = 1, Font = Enum.Font.Code,
		TextScaled = true, TextColor3 = Color3.fromRGB(255, 240, 220), Text = "", ZIndex = 11 }, quiz)
	local quizButtons = {}
	for i = 1, 3 do
		local b = make("TextButton", { Name = "Answer" .. i, Size = UDim2.fromOffset(120, 60), Position = UDim2.fromOffset(15 + (i - 1) * 135, 125), BackgroundColor3 = Color3.fromRGB(60, 46, 36),
			Font = Enum.Font.Code, TextScaled = true, TextColor3 = Color3.fromRGB(255, 240, 220), Text = "", ZIndex = 11 }, quiz)
		make("UICorner", { CornerRadius = UDim.new(0, 8) }, b)
		quizButtons[i] = b
	end
	local quizCount = make("TextLabel", { Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 200), BackgroundTransparency = 1, Font = Enum.Font.Oswald,
		TextScaled = true, TextColor3 = Color3.fromRGB(200, 190, 170), Text = "", ZIndex = 11 }, quiz)
	local function sum()
		local kind = math.random(3)
		local x, y = math.random(2, 12), math.random(2, 12)
		if kind == 1 then return ("%d + %d = ?"):format(x * 3, y * 4), x * 3 + y * 4 end
		if kind == 2 then return ("%d - %d = ?"):format(x * 5, y), x * 5 - y end
		return ("%d × %d = ?"):format(x, y), x * y
	end
	ENTITY["Nerd Man"] = function(areaName)
		local a = AREAS[areaName]
		local _, _, me = body()
		if not me then return end
		local l = F:PointToObjectSpace(me.Position)
		local start = inArea(a, -l.X * 0.8, a.y, if l.Z > (a.z0 + a.z1) / 2 then a.z1 + 6 else a.z0 - 6)
		local m = make("Model", { Name = "Nerd Man" }, folder)
		local root = box("Body", Vector3.new(2.2, 3, 1.2), CFrame.new(start + up * 2.5), Color3.fromRGB(120, 200, 110), M.SmoothPlastic, { CanCollide = false, CanQuery = false }, m)
		m.PrimaryPart = root
		local head = box("Head", Vector3.new(1.8, 1.8, 1.8), root.CFrame * CFrame.new(0, 2.4, 0), Color3.fromRGB(240, 205, 160), M.SmoothPlastic, { CanCollide = false }, m)
		lowFace(head, 2.4, FACES.nerd)
		local parts = { { head, CFrame.new(0, 2.4, 0) } }
		for _, x in ipairs({ -0.42, 0.42 }) do
			for _, r in ipairs(ring("Glasses", root.CFrame * CFrame.new(x, 2.45, -0.95), 0.3, 0.07, 8, Color3.fromRGB(30, 30, 30), M.SmoothPlastic, { CanCollide = false }, m)) do
				table.insert(parts, { r, root.CFrame:ToObjectSpace(r.CFrame) })
			end
		end
		table.insert(parts, { box("Tie", Vector3.new(0.35, 1.6, 0.1), root.CFrame * CFrame.new(0, 0.4, -0.65), Color3.fromRGB(180, 30, 40), M.SmoothPlastic, { CanCollide = false }, m), CFrame.new(0, 0.4, -0.65) })
		for _, x in ipairs({ -0.5, 0.5 }) do
			table.insert(parts, { box("Leg", Vector3.new(0.7, 1.8, 0.8), root.CFrame * CFrame.new(x, -2.4, 0), Color3.fromRGB(60, 50, 90), M.SmoothPlastic, { CanCollide = false }, m), CFrame.new(x, -2.4, 0) })
		end
		local function place(cf)
			root.CFrame = cf
			for _, e in ipairs(parts) do e[1].CFrame = cf * e[2] end
		end
		speak(head, "Hmm? A test subject!", Color3.fromRGB(150, 240, 150))
		local t0, hmmAt = os.clock(), 0
		local grabbed = false
		while alive and os.clock() - t0 < 30 do
			local dt = RunService.Heartbeat:Wait()
			local _, _, you = body()
			if not you then break end
			if os.clock() > hmmAt then
				hmmAt = os.clock() + 3 + math.random() * 2
				FX.once(LDR.Hmm, head, { Volume = 1.6 * VOLUME, RollOffMinDistance = 15, PlaybackSpeed = 0.9 + math.random() * 0.25 })
			end
			local dir = flat(you.Position - root.Position)
			if not hiddenSafe() and dir.Magnitude < 4 then
				grabbed = true
				break
			end
			local step = if hiddenSafe() then flat(RIGHT) * math.sin(os.clock()) else dir.Unit
			local pos = root.Position + step * 6 * dt
			place(CFrame.lookAt(pos, pos + step) * CFrame.new(0, math.abs(math.sin(os.clock() * 8)) * 0.15, 0))
		end
		if grabbed then -- his sums
			local _, _, you = body()
			you.Anchored = true
			local camera = workspace.CurrentCamera
			local name = camName .. "Nerd"
			RunService:BindToRenderStep(name, Enum.RenderPriority.Last.Value, function()
				local eye = you.Position + up * 1.5
				camera.CFrame = CFrame.lookAt(eye, head.Position)
			end)
			later(function() RunService:UnbindFromRenderStep(name) end)
			speak(head, "Solve these and I'll let you go.", Color3.fromRGB(150, 240, 150))
			quiz.Visible = true
			local right, start = 0, os.clock()
			while alive and right < 3 and os.clock() - start < 25 do
				local q, answer = sum()
				quizQuestion.Text = q
				quizCount.Text = ("%d / 3"):format(right)
				local choices = { answer, answer + math.random(1, 4), answer - math.random(1, 4) }
				for i = #choices, 2, -1 do
					local j = math.random(i)
					choices[i], choices[j] = choices[j], choices[i]
				end
				local picked = nil
				local hooks = {}
				for i, b in ipairs(quizButtons) do
					b.Text = tostring(choices[i])
					table.insert(hooks, b.MouseButton1Click:Connect(function() picked = choices[i] end))
				end
				table.insert(hooks, UserInputService.InputBegan:Connect(function(input)
					for i, k in ipairs({ Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three }) do
						if input.KeyCode == k then picked = choices[i] end
					end
				end))
				while alive and picked == nil and os.clock() - start < 25 do RunService.Heartbeat:Wait() end
				for _, h in ipairs(hooks) do h:Disconnect() end
				if picked == answer then
					right += 1
					FX.once(LDR.Right, SoundService)
				elseif picked ~= nil then
					FX.once(LDR.Wrong, SoundService)
					speak(head, "WRONG!", Color3.fromRGB(255, 120, 110))
					damage(15, "Nerd Man", { "You died to Nerd Man.", "He grabs you and asks you sums.", "Answer right and he lets you go." })
				end
				local _, humanoid = body()
				if not humanoid then break end
			end
			quiz.Visible = false
			RunService:UnbindFromRenderStep(name)
			if right < 3 then
				FX.once(LDR.Wrong, SoundService)
				damage(30, "Nerd Man", { "You died to Nerd Man.", "He grabs you and asks you sums.", "Answer right and he lets you go." })
				speak(head, "Too slow!", Color3.fromRGB(255, 120, 110))
			else
				speak(head, "Hmph. Not bad.", Color3.fromRGB(150, 240, 150))
			end
			local _, _, again = body()
			if again then again.Anchored = false end
			wait(1.2)
		end
		vanish(m, 0.5)
	end
