-- A wall from a to b (on its inner face, at the floor), `h` high, `t` thick, its room toward `inward`; its openings
-- { u0, u1, v0, v1 } (along it from a, up from the floor); `bands` how it looks from the floor up: { { top, LOOK.x } }
local function wall(a, b, h, t, inward, openings, bands, parent)
	local frame = CFrame.fromMatrix(a, (b - a).Unit, up) -- (its z: along x, cross up)
	local s = if (-frame.LookVector):Dot(inward) > 0 then 1 else -1 -- (+1: its z into the room)
	local len = (b - a).Magnitude
	local cuts = { 0, len }
	for _, o in ipairs(openings) do
		table.insert(cuts, o[1])
		table.insert(cuts, o[2])
	end
	table.sort(cuts)
	local function piece(u0, u1, v0, v1)
		local lo = v0
		for _, band in ipairs(bands) do
			local hi = math.min(v1, band[1])
			if hi > lo + 0.01 then band[2](Vector3.new(u1 - u0, hi - lo, t), frame * CFrame.new((u0 + u1) / 2, (lo + hi) / 2, -s * t / 2), parent) end
			lo = math.max(lo, band[1])
			if lo >= v1 then break end
		end
	end
	for i = 1, #cuts - 1 do
		local u0, u1 = cuts[i], cuts[i + 1]
		if u1 - u0 > 0.01 then
			local hole = nil
			for _, o in ipairs(openings) do
				if o[1] <= u0 + 0.01 and o[2] >= u1 - 0.01 then hole = o end
			end
			if hole then
				piece(u0, u1, 0, hole[3])
				piece(u0, u1, hole[4], h)
			else
				piece(u0, u1, 0, h)
			end
		end
	end
	return { frame = frame, s = s, len = len, openings = openings, parent = parent }
end
-- A strip along a wall (as the Hotel's Wall_Strip): from `v` up `height`, `depth` out of it, broken where an opening is;
-- `trim` { at its start, at its end }: that much shorter there (where the next wall's strip runs into the corner)
local function strip(w, v, height, depth, color, material, trim)
	local t0, t1 = trim and trim[1] or 0, trim and trim[2] or 0
	local cuts = { t0, w.len - t1 }
	local function crossing(o) return o[3] < v + height and o[4] > v end
	for _, o in ipairs(w.openings) do
		if crossing(o) then
			table.insert(cuts, math.clamp(o[1], t0, w.len - t1))
			table.insert(cuts, math.clamp(o[2], t0, w.len - t1))
		end
	end
	table.sort(cuts)
	for i = 1, #cuts - 1 do
		local u0, u1 = cuts[i], cuts[i + 1]
		local inside = false
		for _, o in ipairs(w.openings) do
			if crossing(o) and o[1] <= u0 + 0.01 and o[2] >= u1 - 0.01 then inside = true end
		end
		if not inside and u1 - u0 > 0.05 then
			box("Wall_Strip", Vector3.new(u1 - u0, height, depth), w.frame * CFrame.new((u0 + u1) / 2, v + height / 2, w.s * depth / 2), color or HOTEL.strip,
				material or M.Wood, nil, w.parent)
		end
	end
end
-- A copy of DOORS': none of its code, remotes, prompts, tags. `mode` nil: none of its joints or physics either (all anchored);
-- "rig": its joints and animation controller kept (an animated model); "physics": its joints, constraints and movers kept too
-- (DOORS' doors, locks, drawers: the parts that move let go when they move)
local function clean(model, mode)
	local all = model:GetDescendants()
	table.insert(all, model)
	for _, d in ipairs(all) do
		untag(d)
		pcall(function() if d:GetAttribute("LoadModule") ~= nil then d:SetAttribute("LoadModule", nil) end end) -- (DOORS' client would load its module)
		local joint = d:IsA("JointInstance") or d:IsA("AnimationController") or d.ClassName == "WeldConstraint"
		local physics = d:IsA("Constraint") or d:IsA("BodyMover")
		if d:IsA("LuaSourceContainer") or d:IsA("RemoteEvent") or d:IsA("BindableEvent") or d:IsA("TouchTransmitter") or d:IsA("ProximityPrompt")
			or (physics and mode ~= "physics") or (joint and mode == nil) then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CanTouch, d.Anchored = false, true
		end
	end
	return model
end

---- The opening in room 0's floor (only for you: its floor there hidden, the rest of it copies of it) ----
do
	local moved = {} -- the Hotel's parts out of your way: part -> { transparency, collide }
	local function hideLocally(p)
		if moved[p] then return end
		moved[p] = { p.LocalTransparencyModifier, p.CanCollide }
		p.LocalTransparencyModifier, p.CanCollide = 1, false
		for _, d in ipairs(p:GetChildren()) do
			if d:IsA("Decal") then
				moved[d] = { d.LocalTransparencyModifier }
				d.LocalTransparencyModifier = 1
			end
		end
	end
	later(function()
		for p, was in pairs(moved) do
			pcall(function()
				p.LocalTransparencyModifier = was[1]
				if was[2] ~= nil then p.CanCollide = was[2] end
			end)
		end
	end)
	local pieces = {}
	later(function()
		for _, piece in ipairs(pieces) do piece:Destroy() end
	end)
	local function split(p) -- a floor round the opening: up to four copies of it
		local lo, hi = Vector3.new(math.huge, 0, math.huge), Vector3.new(-math.huge, 0, -math.huge)
		for _, c in ipairs({ { -1, -1 }, { -1, 1 }, { 1, -1 }, { 1, 1 } }) do
			local l = p.CFrame:PointToObjectSpace(holeCF * Vector3.new(c[1] * holeSize.X / 2, 0, c[2] * holeSize.Z / 2))
			lo = Vector3.new(math.min(lo.X, l.X), 0, math.min(lo.Z, l.Z))
			hi = Vector3.new(math.max(hi.X, l.X), 0, math.max(hi.Z, l.Z))
		end
		local hx, hz = p.Size.X / 2, p.Size.Z / 2
		local x0, x1, z0, z1 = math.clamp(lo.X, -hx, hx), math.clamp(hi.X, -hx, hx), math.clamp(lo.Z, -hz, hz), math.clamp(hi.Z, -hz, hz)
		for _, r in ipairs({ { -hx, x0, -hz, hz }, { x1, hx, -hz, hz }, { x0, x1, -hz, z0 }, { x0, x1, z1, hz } }) do
			if r[2] - r[1] > 0.02 and r[4] - r[3] > 0.02 then
				local ok, piece = pcall(function() return p:Clone() end)
				if not (ok and piece) then
					piece = make("Part", { Color = p.Color, Material = p.Material, Transparency = p.Transparency, Reflectance = p.Reflectance }, nil)
				end
				for _, d in ipairs(piece:GetChildren()) do
					if not (d:IsA("Texture") or d:IsA("Decal")) then d:Destroy() end
				end
				untag(piece)
				piece.Anchored = true
				piece.Size = Vector3.new(r[2] - r[1], p.Size.Y, r[4] - r[3])
				piece.CFrame = p.CFrame * CFrame.new((r[1] + r[2]) / 2, 0, (r[3] + r[4]) / 2)
				piece.Parent = p.Parent -- (beside it, in its room: for DOORS, still its floor)
				table.insert(pieces, piece)
			end
		end
		hideLocally(p)
	end
	for _, p in ipairs(overlap(holeCF * CFrame.new(0, -1.2, 0), Vector3.new(holeSize.X - 0.05, 2.8, holeSize.Z - 0.05))) do
		if p:IsA("BasePart") and not p:IsDescendantOf(folder) then
			local flatPart = p:IsA("Part") and p.Shape == Enum.PartType.Block and math.abs(p.CFrame.UpVector.Y) > 0.99
			if flatPart and p.Size.X * p.Size.Z > holeSize.X * holeSize.Z * 2 then split(p) else hideLocally(p) end
		end
	end
	-- The room's furniture on the opening or in front of it (where you step onto the stairs): all of each piece
	if furniture then
		local APPROACH = 5
		for _, p in ipairs(overlap(holeCF * CFrame.new(0, 3.6, APPROACH / 2), Vector3.new(STAIR.w + 1, 6.8, holeSize.Z + APPROACH))) do
			local thing = p:FindFirstAncestorWhichIsA("Model")
			if thing and thing:IsDescendantOf(furniture) then
				for _, d in ipairs(thing:GetDescendants()) do
					if d:IsA("BasePart") then hideLocally(d) end
				end
			end
		end
	end
end

