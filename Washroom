local machines, hideSpots = {}, {}
-- Its door on its hinge: 0 shut, 1 wide open (out, toward you)
local function poseDoor(m, u)
	m.door = u
	local swing = m.hinge * CFrame.Angles(0, 1.95 * u, 0)
	for _, e in ipairs(m.doorParts) do e[1].CFrame = swing * e[2] end
end
local function swingDoor(m, to, seconds)
	local from = m.door
	task.spawn(function()
		local t0 = os.clock()
		while alive and os.clock() - t0 < seconds do
			local u = (os.clock() - t0) / seconds
			poseDoor(m, from + (to - from) * (1 - (1 - u) ^ 2))
			RunService.Heartbeat:Wait()
		end
		poseDoor(m, to)
	end)
end
local function poseDrum(m)
	m.drum.CFrame = m.drumFrame * CFrame.Angles(m.angle, 0, 0)
	local r = m.radius
	for k, p in ipairs(m.paddles) do
		p.CFrame = m.drumFrame * CFrame.Angles(m.angle + k * math.pi * 2 / 3, 0, 0) * CFrame.new(-0.25, r * 0.82, 0)
	end
	for k, p in ipairs(m.clothes) do -- (tumbling: carried up, falling back)
		local a = m.angle * 0.7 + k * 2.1
		p.CFrame = m.drumFrame * CFrame.Angles(a, 0, 0) * CFrame.new(-0.35, r * (0.25 + 0.2 * k) * (0.6 + 0.4 * math.sin(a * 1.7)), 0)
	end
end

