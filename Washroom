	-- DOORS' wardrobes (a room's, its doors on their joints; else DOORS' template given joints as a room's): to hide in
	local function wardrobeAt(at, facing)
		local w = put(T.wardrobe, at, facing, 0.42, atticModel, "rig")
		if not w then return nil end
		local main = w:FindFirstChild("Main")
		if not main then -- (the template: its body is the smaller of its two Wood)
			local best = nil
			for _, p in ipairs(w:GetChildren()) do
				if p:IsA("BasePart") and p.Name == "Wood" and (not best or p.Size.Magnitude < best.Size.Magnitude) then best = p end
			end
			main = best
			if main then main.Name = "Main" end
		end
		if not main then return nil end
		w.PrimaryPart = main
		for _, name in ipairs({ "Door1", "Door2" }) do
			local door = w:FindFirstChild(name)
			if door and door:IsA("BasePart") then
				if not main:FindFirstChild(name) then -- (its hinge at its outer edge, as a room's: 0.055 in from it)
					local sign = if main.CFrame:PointToObjectSpace(door.Position).X > 0 then 1 else -1
					local c1 = CFrame.new(sign * (door.Size.X / 2 - 0.055), 0, 0)
					make("Motor6D", { Name = name, Part0 = main, Part1 = door, C0 = main.CFrame:ToObjectSpace(door.CFrame) * c1, C1 = c1 }, main)
				end
				door.Anchored = false
			end
		end
		for _, p in ipairs(w:GetDescendants()) do -- (its knobs, each on the door nearest it)
			if p:IsA("BasePart") and p.Name == "Knob" then
				local nearest = nil
				for _, name in ipairs({ "Door1", "Door2" }) do
					local door = w:FindFirstChild(name)
					if door and (not nearest or (p.Position - door.Position).Magnitude < (p.Position - nearest.Position).Magnitude) then nearest = door end
				end
				if nearest then
					if not p:FindFirstChildWhichIsA("JointInstance") then make("WeldConstraint", { Part0 = nearest, Part1 = p }, p) end
					p.Anchored = false
				end
			end
		end
		local controller = w:FindFirstChildOfClass("AnimationController") or make("AnimationController", {}, w)
		local animator = controller:FindFirstChildOfClass("Animator") or make("Animator", {}, controller)
		local function attach(name, fallback)
			local a = main:FindFirstChild(name)
			return if a and a:IsA("Attachment") then a.WorldCFrame else main.CFrame * fallback
		end
		local spot = { kind = "wardrobe", model = w, main = main, animator = animator, tracks = {} }
		spot.front = attach("EnterAttachment", CFrame.new(0, -0.88, -4.25))
		spot.inside = attach("HideAttachment", CFrame.new(0, -0.25, 0))
		spot.look = main.CFrame.LookVector
		table.insert(attic.wardrobes, spot)
		return spot
	end
	-- DOORS' chest (the Hotel-'s Chest_1): its lid and its band swing up on their hinge at its back
	local function chestAt(at, facing, gap)
		local m = put(T.chest, at, facing, gap, atticModel)
		if not m then return nil end
		local parts = {}
		for _, p in ipairs(m:GetDescendants()) do
			if p:IsA("BasePart") then table.insert(parts, p) end
		end
		table.sort(parts, function(a, b) return a.Position.Y < b.Position.Y end)
		local base = m.PrimaryPart
		local lid = {}
		for _, p in ipairs(parts) do -- (its lid and band: the parts higher than its body's middle, not its insides)
			if p ~= base and p.Position.Y > base.Position.Y + base.Size.Y * 0.3 and p.Size.X > base.Size.X * 0.4 then table.insert(lid, p) end
		end
		local back = (base.CFrame * CFrame.new(0, base.Size.Y / 2, 0)).Position - facing * (base.Size.Z / 2) -- (along its back edge, on top)
		local chest = { model = m, base = base, lid = lid, hinge = CFrame.lookAt(back, back + facing:Cross(up)), size = base.Size }
		chest.rel = {}
		for i, p in ipairs(lid) do chest.rel[i] = chest.hinge:ToObjectSpace(p.CFrame) end
		table.insert(attic.chests, chest)
		return chest
	end

