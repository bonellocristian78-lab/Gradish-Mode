-- The box of a model's parts that are seen (not its hitboxes, its sky, its long rods), in `frame`
local extent
do
	local CORNERS = {}
	for _, x in ipairs({ -1, 1 }) do
		for _, y in ipairs({ -1, 1 }) do
			for _, z in ipairs({ -1, 1 }) do table.insert(CORNERS, Vector3.new(x, y, z)) end
		end
	end
	function extent(model, frame)
		local lo, hi = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
		for _, p in ipairs(model:GetDescendants()) do
			local s = p:IsA("BasePart") and p.Size
			if s and p.Transparency < 0.95 and not (math.min(s.X, s.Y, s.Z) < 0.1 and math.max(s.X, s.Y, s.Z) > 10) and p.Name ~= "Skybox" then
				for _, c in ipairs(CORNERS) do
					local q = frame:PointToObjectSpace(p.CFrame * (s / 2 * c))
					lo = Vector3.new(math.min(lo.X, q.X), math.min(lo.Y, q.Y), math.min(lo.Z, q.Z))
					hi = Vector3.new(math.max(hi.X, q.X), math.max(hi.Y, q.Y), math.max(hi.Z, q.Z))
				end
			end
		end
		return lo, hi
	end
end
local function copyOf(template, rig)
	if not template then return nil end
	local ok, copy = pcall(function() return template:Clone() end)
	if not (ok and copy) then return nil end
	return clean(copy, rig)
end
-- Turn a model so that its PrimaryPart is `cf` (DOORS' furniture: its PrimaryPart looks out of its front)
local function pose(model, cf)
	local primary = model.PrimaryPart
	model:PivotTo(if primary then cf * primary.CFrame:ToObjectSpace(model:GetPivot()) else cf)
end
-- A copy of DOORS' `template` standing on the floor at `at`, its front toward `facing`; with `back`, its back against
-- a wall there instead of its middle
local function put(template, at, facing, back, parent, rig)
	local copy = copyOf(template, rig)
	if not copy then return nil end
	local frame = CFrame.lookAt(at, at + facing)
	pose(copy, frame)
	local lo, hi = extent(copy, frame)
	if lo.X > hi.X then
		copy:Destroy()
		return nil
	end
	copy:PivotTo(copy:GetPivot() + frame:VectorToWorldSpace(Vector3.new(-(lo.X + hi.X) / 2, -lo.Y, if back then -hi.Z - 0.05 else -(lo.Z + hi.Z) / 2)))
	copy.Parent = parent or folder
	return copy
end
-- On a wall: `at` the middle of its back on the wall's face, `inward` out of the wall (a painting, a clock)
local function hang(template, at, inward, parent)
	local copy = copyOf(template)
	if not copy then return nil end
	local frame = CFrame.lookAt(at, at + inward)
	pose(copy, frame)
	local lo, hi = extent(copy, frame)
	copy:PivotTo(copy:GetPivot() + frame:VectorToWorldSpace(Vector3.new(-(lo.X + hi.X) / 2, -(lo.Y + hi.Y) / 2, -hi.Z - 0.02)))
	copy.Parent = parent or folder
	return copy
end
local function playLoops(model)
