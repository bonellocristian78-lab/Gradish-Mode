		spot.prompt = make("ProximityPrompt", { ActionText = "Hide", ObjectText = name, HoldDuration = 0, MaxActivationDistance = 7, RequiresLineOfSight = false,
			Style = Enum.ProximityPromptStyle.Custom }, part)
		on(spot.prompt.Triggered, function()
			if hidden == spot then task.spawn(getOut, false) else task.spawn(hide, spot) end
		end)
		table.insert(spots, spot)
		return spot
	end
	-- The open dryers: a metal clank, the door shuts behind you, the grille
	for _, m in ipairs(hideSpots) do
		local p = (m.face * CFrame.new(0, 0, -2.6)).Position
		local spot = { kind = "dryer", machine = m, grille = true, look = m.cf.LookVector, front = CFrame.new(p.X, m.cf.Y, p.Z), inside = m.inside }
		function spot.enter()
			FX.once(DOORS.hideIn, m.drum, { Volume = VOLUME })
			FX.once(SND.Clank, m.drum, { Volume = 1.2 * VOLUME })
		end
		function spot.shut() swingDoor(m, 0, 0.35) end
		function spot.leave()
			FX.once(DOORS.hideOut, m.drum, { Volume = VOLUME })
			swingDoor(m, 1, 0.3)
		end
		m.spot = addSpot(spot, m.drum, "Dryer")
	end
	-- DOORS' wardrobes: their doors open and shut on DOORS' own animations, their own sounds
	for _, w in ipairs(attic.wardrobes) do
		w.grille = false
		local function play(anim)
			local track = w.tracks[anim]
			if not track then
				local a = Instance.new("Animation")
				a.AnimationId = anim
				local ok, t = pcall(function() return w.animator:LoadAnimation(a) end)
				if not ok then return end
				track = t
				w.tracks[anim] = track
			end
			pcall(function() track:Play(0.05) end)
		end
		function w.enter()
			play(DOORS.wardrobeIn)
			if not (w.main:FindFirstChild("SoundEnter") and pcall(function() w.main.SoundEnter:Play() end)) then FX.once(DOORS.hideIn, w.main, { Volume = VOLUME }) end
		end
		function w.leave()
			play(DOORS.wardrobeOut)
			if not (w.main:FindFirstChild("SoundExit") and pcall(function() w.main.SoundExit:Play() end)) then FX.once(DOORS.hideOut, w.main, { Volume = VOLUME }) end
		end
		addSpot(w, w.main, "Wardrobe")
	end
	-- Under the tables (crouched, as the Hotel- crouches)
	for _, t in ipairs(tables) do
		local spot = { kind = "table", table = t, front = t.front, inside = t.inside * CFrame.new(0, 0.4, 0), look = (t.cf * CFrame.new(0, 0, 1)).Position - t.cf.Position,
			anim = CROUCH, exitAnim = DOORS.interact }
		function spot.enter() FX.once(DOORS.drawerClose, t.top, { Volume = VOLUME * 0.5, PlaybackSpeed = 0.6 }) end
		function spot.leave()
			pcall(function() tracks[CROUCH]:Stop(0.2) end)
		end
		t.spot = addSpot(spot, t.top, "Table")
	end
end
-- Hide's rule: not too long. At 16 s it gets to you (DOORS' own effect), at 23 s it throws you out
on(RunService.Heartbeat, function()
	if not hidden or moving then return end
	local inside = os.clock() - hideStart
	if inside > 16 and not hideMonster then
		hideMonster = setmetatable({ camlock = true, dead = false }, { __index = mainGame or {} })
		local mine = hideMonster
		task.spawn(function()
			local ok = pcall(function()
				require(LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game.RemoteListener.Modules.HideMonster)(mine, 7)
			end)
			if not ok then FX.once(SND.Whisper, SoundService, { Volume = 1.4 * VOLUME }) end
		end)
	end
	if inside > 23 then task.spawn(getOut, true) end
end)

---====== THINGS TO FIND: gold, the flashlight (in DOORS' drawers, washers, carts, crates) ======---

do -- (gold, the flashlight; the places that hold them)
	local function addGold(amount)
		FX.once(DOORS.gold, SoundService)
		FX.caption(("+%d Gold"):format(amount))
		pcall(function() -- (on your screen only)
			for _, label in ipairs(LocalPlayer.PlayerGui.PermUI:GetDescendants()) do
				if label:IsA("TextLabel") and label.Name == "Gold" and tonumber(label.Text) then label.Text = tostring(tonumber(label.Text) + amount) end
			end
		end)
	end
	local function giveFlashlight()
		local light = box("Flashlight", Vector3.new(0.2, 0.2, 0.2), workspace.CurrentCamera.CFrame, Color3.new(0, 0, 0), M.SmoothPlastic,
			{ Transparency = 1, CanCollide = false, CanQuery = false })
		local spot = make("SpotLight", { Range = 45, Angle = 50, Brightness = 2.2, Color = Color3.fromRGB(255, 240, 210), Enabled = true, Shadows = true }, light)
		on(RunService.RenderStepped, function() light.CFrame = workspace.CurrentCamera.CFrame end)
		on(UserInputService.InputBegan, function(input, processed)
			if not processed and input.KeyCode == Enum.KeyCode.F then
				spot.Enabled = not spot.Enabled
				FX.once(SND.Clank, SoundService, { Volume = 0.25 * VOLUME, PlaybackSpeed = 2.5 })
			end
		end)
		FX.caption("Flashlight (F)")
	end
	local function takeable(model, part, objectText, onTake)
		local prompt = make("ProximityPrompt", { ActionText = "Take", ObjectText = objectText, HoldDuration = 0, MaxActivationDistance = 7, RequiresLineOfSight = false,
			Style = Enum.ProximityPromptStyle.Custom }, part)
		on(prompt.Triggered, function()
			prompt:Destroy()
			animate(DOORS.interact)
			onTake()
			model:Destroy()
		end)
		return prompt
	end
	-- A pile of gold coins, sparkling as DOORS' do, its sounds
	local function goldPile(cf, parent)
		local m = make("Model", { Name = "GoldPile" }, parent or folder)
		local base = nil
		for i = 1, 9 do
			local a, r = math.random() * math.pi * 2, math.random() * 0.45
			local coin = cylinder("Coin", 0.07, 0.42, cf * CFrame.new(math.cos(a) * r, 0.04 + (i % 3) * 0.06, math.sin(a) * r) * CFrame.Angles(rnd(0.3), 0, math.pi / 2 + rnd(0.3)),
				Color3.fromRGB(255, 196, 58), M.Metal, { Reflectance = 0.35, CanCollide = false }, m)
			base = base or coin
		end
		make("ParticleEmitter", { Texture = DOORS.goldSparkle, Rate = 6, Lifetime = NumberRange.new(0.5, 1), Speed = NumberRange.new(0.2), Size = NumberSequence.new(0.35),
			LightEmission = 1, SpreadAngle = Vector2.new(180, 180) }, base)
		FX.once(DOORS.goldShine, base)
		takeable(m, base, "Gold", function() addGold(math.random(5, 25)) end)
		return m
	end
	local function flashlightItem(cf, parent)
		local m = make("Model", { Name = "FlashlightItem" }, parent or folder)
		local bodyPart = cylinder("Body", 1.0, 0.26, cf * CFrame.new(0, 0.14, 0), Color3.fromRGB(40, 42, 46), M.Metal, { CanCollide = false }, m)
		cylinder("Head", 0.32, 0.42, cf * CFrame.new(0.6, 0.2, 0), Color3.fromRGB(60, 62, 66), M.Metal, { CanCollide = false }, m)
		cylinder("Lens", 0.04, 0.34, cf * CFrame.new(0.78, 0.2, 0), Color3.fromRGB(255, 244, 210), M.Neon, { CanCollide = false }, m)
		box("Switch", Vector3.new(0.18, 0.08, 0.12), cf * CFrame.new(0, 0.28, 0), Color3.fromRGB(170, 40, 30), M.SmoothPlastic, { CanCollide = false }, m)
		takeable(m, bodyPart, "Flashlight", giveFlashlight)
		return m
	end
	local loot = {}
	local function stash(cf, parent) -- (what this place holds, made when it is opened)
		local what = table.remove(loot, 1)
		if what == "gold" then
			goldPile(cf, parent)
		elseif what == "flashlight" then
			flashlightItem(cf, parent)
		else
			FX.caption("Nothing.")
		end
	end
	local openers = {} -- the prompts that open a place (a drawer, a washer, a cart, a crate)
	local function opener(part, action, object, open)
		local prompt = make("ProximityPrompt", { ActionText = action, ObjectText = object, HoldDuration = 0.25, MaxActivationDistance = 7, RequiresLineOfSight = false,
			Style = Enum.ProximityPromptStyle.Custom }, part)
		on(prompt.Triggered, function()
			prompt:Destroy()
			animate(DOORS.interact)
			open()
		end)
		table.insert(openers, prompt)
		return prompt
	end
	-- DOORS' dressers: each drawer slides out (its own sounds)
	local function drawers(dresser, parent)
		if not dresser then return end
		local out = dresser.PrimaryPart and dresser.PrimaryPart.CFrame.LookVector or RIGHT
		for _, container in ipairs(dresser:GetChildren()) do
			if container:IsA("Model") and container.Name == "DrawerContainer" then
				local moving = {}
				for _, p in ipairs(container:GetDescendants()) do
					if p:IsA("BasePart") and p.Name ~= "Holder" then table.insert(moving, { p, p.CFrame }) end
				end
				local knob = container:FindFirstChild("Knobs") or container:FindFirstChild("Main")
				local main = container:FindFirstChild("Main")
				if knob and main then
					opener(knob, "Open", "Drawer", function()
						if not (main:FindFirstChild("Open") and pcall(function() main.Open:Play() end)) then FX.once(DOORS.drawerOpen, main) end
						task.spawn(function()
							local t0 = os.clock()
							while alive and os.clock() - t0 < 0.35 do
								local u = (os.clock() - t0) / 0.35
								for _, e in ipairs(moving) do e[1].CFrame = e[2] + out * 1.7 * (1 - (1 - u) ^ 2) end
								RunService.Heartbeat:Wait()
							end
							for _, e in ipairs(moving) do e[1].CFrame = e[2] + out * 1.7 end
							stash(CFrame.new(main.Position + up * (main.Size.Y / 2 - 0.12)) * (main.CFrame - main.CFrame.Position), parent)
						end)
					end)
				end
			end
		end
	end
	for _, d in ipairs(laundry.dressers) do drawers(d, laundryModel) end
	for _, d in ipairs(attic.dressers) do drawers(d, atticModel) end
	-- Four washers (shut, not running): their door swings open, something in the drum or nothing
	do
		local shut = {}
		for _, m in ipairs(machines) do
			if m.water and not m.wash then table.insert(shut, m) end
		end
		for _ = 1, math.min(4, #shut) do
			local m = table.remove(shut, math.random(#shut))
			m.searchable = true
			opener(m.glass, "Search", "Washer", function()
				swingDoor(m, 0.9, 0.5)
				task.delay(0.5, function() stash(m.drumFrame * CFrame.new(-0.6, -0.5, 0) * CFrame.Angles(0, -math.pi / 2, 0), laundryModel) end)
			end)
		end
	end
	for _, cart in ipairs(laundry.carts) do
		local part = cart.PrimaryPart
		if part then
			opener(part, "Search", "Cart", function()
				local cf, size = cart:GetBoundingBox()
				stash(cf * CFrame.new(0.4, size.Y / 2 + 0.1, 0), laundryModel)
			end)
		end
	end
	for _, c in ipairs(attic.crates) do
		opener(c.lid, "Open", "Crate", function()
			FX.once(DOORS.drawerOpen, c.lid, { PlaybackSpeed = 0.7 })
			local cf = c.lid.CFrame
			c.lid.CFrame = cf * CFrame.new(0, 0.3, c.size.Z / 2) * CFrame.Angles(-1.2, 0, 0) * CFrame.new(0, 0, -c.size.Z / 2)
			stash(cf * CFrame.new(0, -c.size.Y + 0.5, 0), atticModel)
		end)
	end
	-- What they hold: one flashlight, gold in about half, nothing in the rest
	for i = 1, #openers do loot[i] = if i == 1 then "flashlight" elseif math.random() < 0.5 then "gold" else "nothing" end
	for i = #loot, 2, -1 do
		local j = math.random(i)
		loot[i], loot[j] = loot[j], loot[i]
	end
end

---====== DOORS' GUIDING LIGHT: when you are stuck, its blue light shows the way, its tip in blue ======---

local guide = { part = nil }
local function clearGuide()
	if guide.part then guide.part:Destroy() end
	guide.part = nil
end
local function guideAt(target, text)
	clearGuide()
	local g = box("GuidingLight", Vector3.new(0.4, 0.4, 0.4), CFrame.new(target), Color3.fromRGB(120, 233, 255), M.Neon, { Transparency = 1, CanCollide = false, CanQuery = false })
	make("PointLight", { Color = Color3.fromRGB(39, 190, 255), Range = 12, Brightness = 2.5 }, g)
	make("ParticleEmitter", { Texture = DOORS.guiding, Color = ColorSequence.new(Color3.fromRGB(120, 233, 255)), LightEmission = 1, Rate = 25,
		Lifetime = NumberRange.new(2, 5), Speed = NumberRange.new(0.3, 1.5), Size = NumberSequence.new(0.22), SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, 0.3, 0), Drag = 0.2 }, g)
	guide.part = g
	FX.once(SND.Chime, g, { Volume = 0.35 * VOLUME, PlaybackSpeed = 1.3 })
	if text then FX.remind(text, true) end
end

local stage = { name = "start", since = os.clock(), guided = false }
local function setStage(name) -- (a new step: its guidance, if you are stuck at it)
	stage.name, stage.since, stage.guided = name, os.clock(), false
	clearGuide()
	for _, d in ipairs(doors) do
		if not d.opened then d.guide(false) end
	end
end

