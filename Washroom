local function hatchDoor(frame, name)
	local door = { model = make("Model", { Name = name }, folder), frame = frame, open = 0 }
	box("Frame", Vector3.new(7.2, 0.6, 1.4), frame * CFrame.new(0, 9.3, 0), Color3.fromRGB(70, 74, 76), M.DiamondPlate, nil, door.model)
	box("Frame", Vector3.new(0.6, 9.6, 1.4), frame * CFrame.new(-3.3, 4.8, 0), Color3.fromRGB(70, 74, 76), M.DiamondPlate, nil, door.model)
	box("Frame", Vector3.new(0.6, 9.6, 1.4), frame * CFrame.new(3.3, 4.8, 0), Color3.fromRGB(70, 74, 76), M.DiamondPlate, nil, door.model)
	-- the leaf (hinged on its left), its porthole, its wheel, its rivets: all of it held as one
	local hinge = frame * CFrame.new(-3, 4.5, 0)
	door.hinge = hinge
	local leaf = {}
	local function piece(p) table.insert(leaf, { p, hinge:ToObjectSpace(p.CFrame) }) return p end
	piece(box("Leaf", Vector3.new(6, 9, 0.8), frame * CFrame.new(0, 4.5, 0), Color3.fromRGB(92, 98, 100), M.DiamondPlate, nil, door.model))
	piece(cylinder("Porthole", 0.9, 1.6, frame * CFrame.new(0, 6.6, -0.1) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(40, 60, 65), M.Glass,
		{ Transparency = 0.3 }, door.model))
	door.wheelCenter = frame * CFrame.new(0, 4, -0.7)
	door.wheel = {}
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local p = piece(box("Wheel", Vector3.new(0.25, 0.7, 0.25), door.wheelCenter * CFrame.Angles(0, 0, a) * CFrame.new(0, 0.9, 0), Color3.fromRGB(150, 150, 140),
			M.Metal, { CanCollide = false }, door.model))
		table.insert(door.wheel, { p, a })
	end
	for _, x in ipairs({ -2.6, 2.6 }) do
		for _, y in ipairs({ 0.6, 2.8, 5, 7.2, 8.5 }) do
			piece(cylinder("Rivet", 0.3, 0.3, frame * CFrame.new(x, y, -0.45) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(70, 70, 70), M.Metal,
				{ CanCollide = false }, door.model))
		end
	end
	door.leaf = leaf
	door.light = box("Light", Vector3.new(0.8, 0.8, 0.5), frame * CFrame.new(0, 10.3, -0.4), Color3.fromRGB(255, 30, 20), M.Neon, { CanCollide = false }, door.model)
	door.glow = make("PointLight", { Color = Color3.fromRGB(255, 40, 30), Range = 14, Brightness = 2, Shadows = false }, door.light)
	door.prompt = make("ProximityPrompt", { ActionText = "Open", ObjectText = "Watertight door", HoldDuration = 0.5, MaxActivationDistance = 9,
		RequiresLineOfSight = false }, leaf[1][1])
	function door.pose(wheelAngle)
		local swing = hinge * CFrame.Angles(0, -door.open * 1.6, 0) -- (away from the room)
		for _, e in ipairs(door.leaf) do e[1].CFrame = swing * e[2] end
		for _, w in ipairs(door.wheel) do
			w[1].CFrame = swing * hinge:ToObjectSpace(door.wheelCenter) * CFrame.Angles(0, 0, w[2] + (wheelAngle or 0)) * CFrame.new(0, 0.9, 0)
		end
	end
	function door.green()
		door.light.Color = Color3.fromRGB(40, 255, 90)
		door.glow.Color = Color3.fromRGB(40, 255, 90)
	end
	return door
end
