local HOTEL = { -- the Hotel-'s rooms, from its dump: their floor, walls, trim, ceiling, wallpaper, beams, pillars
	floor = Color3.fromRGB(95, 83, 81), wall = Color3.fromRGB(89, 116, 117), strip = Color3.fromRGB(117, 98, 94), ceiling = Color3.fromRGB(107, 90, 86),
	wallpaper = "rbxassetid://9754267662", beam = Color3.fromRGB(81, 68, 65), pillar = Color3.fromRGB(99, 83, 81) }
local COLOR = { tile = Color3.fromRGB(214, 208, 186), enamel = Color3.fromRGB(228, 225, 214), steel = Color3.fromRGB(150, 155, 160),
	chrome = Color3.fromRGB(205, 208, 212), rubber = Color3.fromRGB(28, 28, 30) }
local M = Enum.Material

local function box(name, size, cf, color, material, extra, parent)
	local p = make("Part", { Name = name, Size = size, CFrame = cf, Color = color or Color3.new(0.5, 0.5, 0.5), Material = material or M.SmoothPlastic,
		Anchored = true, TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth }, parent or folder)
	for k, v in pairs(extra or {}) do p[k] = v end
	return p
end
local function cylinder(name, length, diameter, cf, color, material, extra, parent) -- (its axis along cf's X)
	local p = box(name, Vector3.new(length, diameter, diameter), cf, color, material, extra, parent)
	p.Shape = Enum.PartType.Cylinder
	return p
end
local function ball(name, size, cf, color, material, extra, parent) -- (an ellipsoid: a sphere's mesh in the box `size`)
	local p = box(name, size, cf, color, material, extra, parent)
	make("SpecialMesh", { MeshType = Enum.MeshType.Sphere }, p)
	return p
end
-- A ring round cf's Z axis (in its XY plane): `segments` short cylinders
local function ring(name, cf, radius, tube, segments, color, material, extra, parent)
	local parts = {}
	local length = 2 * math.pi * radius / segments * 1.12
	for i = 0, segments - 1 do
		table.insert(parts, cylinder(name, length, tube, cf * CFrame.Angles(0, 0, i / segments * math.pi * 2) * CFrame.new(0, radius, 0), color, material, extra, parent))
	end
	return parts
end
local function texture(p, tex, faces, studs, extra)
	if not tex then return end
	for _, face in ipairs(faces) do
		local t = make("Texture", { Texture = tex, Face = Enum.NormalId[face], StudsPerTileU = studs, StudsPerTileV = studs }, p)
		for k, v in pairs(extra or {}) do t[k] = v end
	end
end
local function decal(p, tex, face, extra)
	if not tex or not p then return nil end
	local d = make("Decal", { Texture = tex, Face = Enum.NormalId[face] }, p)
	for k, v in pairs(extra or {}) do d[k] = v end
	return d
end
-- A sloped slab from (y0, z0) to (y1, z1), its top through both (what you walk on; the steps are only seen)
local function ramp(name, width, y0, z0, y1, z1, parent)
	local a, b = P(0, y0, z0), P(0, y1, z1)
	local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.new(0, -0.5, 0)
	return box(name, Vector3.new(width, 1, (b - a).Magnitude + 0.6), cf, Color3.new(0.5, 0.5, 0.5), M.WoodPlanks, { Transparency = 1, CanQuery = false }, parent)
end
-- Steps (only seen): `n` of them from (y0, z0) to (y1, z1), `width` wide, with a nosing each
local function steps(n, width, y0, z0, y1, z1, parent)
	local rise, run = (y1 - y0) / n, (z1 - z0) / n
	for i = 1, n do
		local top = y0 + i * rise
		box("Step", Vector3.new(width, top - y0, math.abs(run)), L(0, (y0 + top) / 2, z0 + (i - 0.5) * run), HOTEL.floor, M.WoodPlanks, { CanCollide = false }, parent)
		box("Nosing", Vector3.new(width - 0.04, 0.15, 0.3), L(0, top - 0.055, z0 + (i - 1) * run + 0.09 * math.sign(run)), HOTEL.strip, M.Wood, { CanCollide = false }, parent) -- (0.06 out over its riser)
	end
	ramp("Ramp", width, y0, z0, y1, z1, parent)
end
local LOOK = {} -- how a wall looks, in bands from the floor up: a function(size, cf, parent) each
function LOOK.hotel(size, cf, parent)
