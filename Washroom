	-- A-105: it comes in and checks the hiding places, one by one (the dryers, the wardrobes). Not the tables
	ENTITY["A-105"] = function(areaName)
		local a = AREAS[areaName]
		local enter = inArea(a, 0, a.y + 4, a.z0)
		for _ = 1, 3 do -- (it knocks)
			FX.once(DOORS.knock, SoundService, { PlaybackSpeed = 0.8 })
			if not wait(0.7) then return end
		end
		if not wait(1.2) then return end
		local m = make("Model", { Name = "A-105" }, folder)
		local p = box("A-105", Vector3.new(6, 2.4, 2.4), CFrame.new(enter) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(40, 220, 160), M.Neon,
			{ Shape = Enum.PartType.Cylinder, CanCollide = false, CanQuery = false, Transparency = 0.1 }, m)
		m.PrimaryPart = p
		lowFace(p, 3, FACES.a105)
		local eye = make("SpotLight", { Color = Color3.fromRGB(90, 255, 150), Range = 22, Angle = 35, Brightness = 6, Face = Enum.NormalId.Front }, p)
		make("PointLight", { Color = Color3.fromRGB(60, 255, 150), Range = 16, Brightness = 1.5 }, p)
		FX.loop(LDR.Hum, p, { Volume = 1.6 * VOLUME, RollOffMinDistance = 15, RollOffMaxDistance = 220 })
		local function moveTo(target, speed)
			while alive do
				local dir = target - p.Position
				if dir.Magnitude < 0.5 then break end
				local dt = RunService.Heartbeat:Wait()
				p.CFrame = CFrame.lookAt(p.Position, p.Position + dir) * CFrame.Angles(0, 0, math.pi / 2)
				p.CFrame = CFrame.new(p.Position + dir.Unit * math.min(dir.Magnitude, speed * dt)) * (p.CFrame - p.Position)
				local _, _, you = body()
				if you and not hiddenSafe() and areaOf(you.Position) == areaName and (you.Position - p.Position).Magnitude < 14 then return you end
			end
			return nil
		end
		local lockers = {}
		for _, s in ipairs(spots) do
			if s.kind ~= "table" and not s.gone and areaOf(s.inside.Position) == areaName then table.insert(lockers, s) end
		end
		local _, _, me = body()
		local from = if me then me.Position else enter
		table.sort(lockers, function(x, y) return (x.inside.Position - from).Magnitude < (y.inside.Position - from).Magnitude end)
		local caught = nil
		for i = 1, math.min(4, #lockers) do
			local s = lockers[i]
			caught = moveTo(Vector3.new(s.front.X, P(0, a.y + 3.5, 0).Y, s.front.Z), 11)
			if caught or not alive then break end
			FX.once(LDR.Rattle, p, { Volume = 1.8 * VOLUME, RollOffMinDistance = 15 })
			local machine = s.machine
			if machine and hidden ~= s then -- (it rattles its door)
				local was = machine.door
				swingDoor(machine, math.max(0, was - 0.2), 0.12)
				task.delay(0.3, function() if hidden ~= s then swingDoor(machine, was, 0.15) end end)
			end
			eye.Enabled = true
			if not wait(1.3) then return end
			if hidden == s then -- found
				getOut(false)
				jumpscare(Color3.fromRGB(40, 220, 160), FACES.a105)
				kill("A-105", { "You died to A-105.", "It checks the hiding places one by one.", "Hide under a table, or in another room." })
				break
			end
		end
		if caught then
			while alive do -- (it saw you: straight at you)
				local _, _, you = body()
				if not you then break end
				if hiddenSafe() then break end
				local dir = you.Position - p.Position
				if dir.Magnitude < 4 then
					jumpscare(Color3.fromRGB(40, 220, 160), FACES.a105)
					kill("A-105", { "You died to A-105.", "Out in the open it sees you.", "Hide under a table when it comes." })
					break
				end
				p.CFrame = CFrame.new(p.Position + dir.Unit * math.min(dir.Magnitude, 30 * RunService.Heartbeat:Wait()))
			end
		end
		moveTo(inArea(a, 0, a.y + 4, a.z1), 14)
		vanish(m)
	end
	-- Big Man: in the middle of the room, hungry. He breathes in: he eats the hiding places (the dryers, the wardrobes; not
	-- the tables), and whoever is in them, or out in the open near him. Hide under a table
	ENTITY["Big Man"] = function(areaName)
		local a = AREAS[areaName]
		local at = P(a.middle.X, a.middle.Y, a.middle.Z)
		local m, p = orb("Big Man", 9, Color3.fromRGB(96, 92, 100), at + up * 6)
		p.Material = M.SmoothPlastic
		lowFace(p, 9.5, FACES.big)
		FX.once(LDR.Thud, p, { Volume = 2.4 * VOLUME, RollOffMinDistance = 40 })
		task.spawn(flicker, a.model)
		TweenService:Create(p, TweenInfo.new(0.4, Enum.EasingStyle.Bounce), { CFrame = CFrame.new(at) }):Play()
		FX.shake(5)
		if not wait(0.6) then return end
		speak(p, "I'M HUNGRY...", Color3.fromRGB(220, 210, 230))
		FX.once(LDR.Hungry, p, { Volume = 2.4 * VOLUME, RollOffMinDistance = 40 })
		FX.caption("I'm hungry...")
		if not wait(3) then return end
		local suck = FX.loop(LDR.Suck, p, { Volume = 2 * VOLUME, RollOffMinDistance = 30 })
		make("ParticleEmitter", { Texture = "rbxasset://textures/particles/smoke_main.dds", Rate = 30, Lifetime = NumberRange.new(0.8), Speed = NumberRange.new(-20),
			Size = NumberSequence.new(3, 0.5), Transparency = NumberSequence.new(0.7, 1), Color = ColorSequence.new(Color3.fromRGB(200, 200, 210)),
			SpreadAngle = Vector2.new(180, 180), EmissionDirection = Enum.NormalId.Front }, p)
		-- What he eats: the hiding places near him (the nearest three)
		local food = {}
		for _, s in ipairs(spots) do
			if s.kind ~= "table" and not s.gone and areaOf(s.inside.Position) == areaName and (s.inside.Position - at).Magnitude < 36 then table.insert(food, s) end
		end
		table.sort(food, function(x, y) return (x.inside.Position - at).Magnitude < (y.inside.Position - at).Magnitude end)
		local eaten, nextBite, t0 = {}, os.clock() + 2.5, os.clock()
		while alive and os.clock() - t0 < 9 do
			RunService.Heartbeat:Wait()
			local _, _, you = body()
			if not you then break end
			if not hiddenSafe() then -- (out in the open: pulled in)
				local dir = flat(at - you.Position)
				local d = dir.Magnitude
				if d < 26 then
					you.AssemblyLinearVelocity = dir.Unit * 15 + Vector3.new(0, you.AssemblyLinearVelocity.Y, 0)
					if d < 7 then
						FX.once(LDR.Gulp, p, { Volume = 2 * VOLUME })
						jumpscare(Color3.fromRGB(96, 92, 100), FACES.big)
						kill("Big Man", { "You died to Big Man.", "When he is hungry he eats what is near him: the lockers, and you.", "Hide under a table." })
						break
					end
				end
			end
			if os.clock() >= nextBite and #food > 0 and #eaten < 3 then -- a bite: one hiding place, gone (and you, if you were in it)
				nextBite = os.clock() + 2.5
				local s = table.remove(food, 1)
				local model = s.model or (s.machine and s.machine.model)
				s.gone = true
				s.prompt.Enabled = false
				local hid = {}
				if model then
					for _, d in ipairs(model:GetDescendants()) do
						if d:IsA("BasePart") then
							hid[d] = { d.LocalTransparencyModifier, d.CanCollide }
							d.LocalTransparencyModifier, d.CanCollide = 1, false
						end
					end
				end
				table.insert(eaten, { spot = s, parts = hid })
				FX.once(LDR.Gulp, p, { Volume = 2 * VOLUME })
				FX.shake(3)
				if hidden == s then
					getOut(false)
					jumpscare(Color3.fromRGB(96, 92, 100), FACES.big)
					kill("Big Man", { "You died to Big Man.", "He ate the place you hid in.", "Under a table he can't get you." })
					break
				end
			end
		end
		if suck then suck:Stop() end
		FX.once(LDR.Burp, p, { Volume = 2 * VOLUME, RollOffMinDistance = 30 })
		speak(p, "...full.", Color3.fromRGB(220, 210, 230))
		if not wait(1.5) then return end
		vanish(m, 1)
		task.delay(3, function() -- (and they are back, as they were)
			for _, e in ipairs(eaten) do
				for d, was in pairs(e.parts) do
					pcall(function() d.LocalTransparencyModifier, d.CanCollide = was[1], was[2] end)
				end
				e.spot.gone = false
				if hidden ~= e.spot then e.spot.prompt.Enabled = true end
			end
		end)
	end
	-- Nerd Man: he wanders up to you and grabs you: answer his sums to be let go (a wrong answer hurts)
	local quiz = make("Frame", { Name = "NerdQuiz", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.fromOffset(420, 250),
		BackgroundColor3 = Color3.fromRGB(28, 22, 18), BackgroundTransparency = 0.05, Visible = false, ZIndex = 10 }, screen)
