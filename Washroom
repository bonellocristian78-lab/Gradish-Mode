-- Where you are: "laundry", "attic", "under" (the stairs, the passages), or nil (in the Hotel)
local function areaOf(p)
	local l = F:PointToObjectSpace(p)
	if math.abs(l.X) < LW / 2 and l.Z > -LL / 2 and l.Z < LL / 2 and l.Y > -3 and l.Y < LH then return "laundry" end
	if math.abs(l.X) < AW / 2 and l.Z > AZ1 and l.Z < AZ0 and l.Y > AY - 3 and l.Y < AY + AH then return "attic" end
	if math.abs(l.X) < 5 and l.Z > TOPZ - 6 and l.Z < STAIR.z1 and l.Y > -3 and l.Y < DEPTH - 1 then return "under" end
	return nil
