local M = Enum.Material

local function box(name, size, cf, color, material, extra, parent)
	local p = make("Part", { Name = name, Size = size, CFrame = cf, Color = color or Color3.new(0.5, 0.5, 0.5), Material = material or M.SmoothPlastic,
		Anchored = true, TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth, CastShadow = false }, parent or folder)
	for k, v in pairs(extra or {}) do p[k] = v end
	return p
end
local function cylinder(name, length, diameter, cf, color, material, extra, parent) -- (its axis along cf's X)
	local p = box(name, Vector3.new(length, diameter, diameter), cf, color, material, extra, parent)
	p.Shape = Enum.PartType.Cylinder
	return p
end
local function texture(p, id, faces, studs, extra)
	if not id then return end
	for _, face in ipairs(faces) do
		local t = make("Texture", { Texture = id, Face = Enum.NormalId[face], StudsPerTileU = studs, StudsPerTileV = studs }, p)
		for k, v in pairs(extra or {}) do t[k] = v end
	end
end
local function decal(p, id, face, extra)
	if not id then return nil end
	local d = make("Decal", { Texture = id, Face = Enum.NormalId[face] }, p)
	for k, v in pairs(extra or {}) do d[k] = v end
	return d
end
local function ramp(name, width, y0, z0, y1, z1, material)
	local a, b = L(0, y0, z0).Position, L(0, y1, z1).Position
	local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.new(0, -0.5, 0)
	return box(name, Vector3.new(width, 1, (b - a).Magnitude + 0.6), cf, Color3.new(0.5, 0.5, 0.5), material, { Transparency = 1, CanQuery = false })
end
local function hotelWall(name, size, cf)
	local w = box(name, size, cf, HOTEL.wall, M.Wood)
	texture(w, HOTEL.wallpaper, { "Left", "Right", "Front", "Back" }, 3, { StudsPerTileV = 2, Transparency = 0.85 })
	return w
end
local function tileWall(name, size, cf)
	local w = box(name, size, cf, TILE, M.Slate, { Reflectance = 0.05 })
	texture(w, IMG.Tiles, { "Left", "Right", "Front", "Back", "Top", "Bottom" }, 8)
	return w
end

