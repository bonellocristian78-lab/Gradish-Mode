	local grille = make("ImageLabel", { Name = "Grille", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = IMG.Grill or "", ScaleType = Enum.ScaleType.Tile,
		TileSize = UDim2.fromOffset(46, 46), ImageTransparency = 1, Visible = false, ZIndex = 2 }, screen)
	local function doorsCamera(look) -- DOORS' camera lock (its CamLock), else one like it
		local ok = firesignal and pcall(function() firesignal(ReplicatedStorage.Bricks.CamLock.OnClientEvent, look) end)
		if ok then return end
		local camera = workspace.CurrentCamera
		RunService:BindToRenderStep(camName, Enum.RenderPriority.Last.Value, function()
			local spot = hidden
			if not spot then return end
			local eye = spot.inside.Position + Vector3.new(0, 1.2 + math.sin(os.clock() * 1.4) * 0.04, 0)
			camera.CFrame = CFrame.lookAt(eye, eye + look + Vector3.new(0, -0.1, 0))
		end)
	end
	local function tweenRoot(root, to, seconds)
		local from = root.CFrame
		local t0 = os.clock()
		while alive and os.clock() - t0 < seconds do
			local u = (os.clock() - t0) / seconds
			root.CFrame = from:Lerp(to, u * u * (3 - 2 * u))
			RunService.Heartbeat:Wait()
		end
		root.CFrame = to
	end
	function hide(spot)
		local character, _, root = body()
		if not root or hidden or moving or spot.gone then return end
		moving, hidden, hideStart = true, spot, os.clock()
		spot.prompt.Enabled = false
		if spot.enter then spot.enter() end
		animate(spot.anim or DOORS.enter)
		root.Anchored = true
		local y = root.Position.Y
		local front, inside = spot.front.Position, spot.inside.Position
		tweenRoot(root, CFrame.lookAt(Vector3.new(front.X, y, front.Z), Vector3.new(inside.X, y, inside.Z)), 0.25)
		tweenRoot(root, CFrame.lookAt(inside, inside + flat(spot.look)), 0.55)
		if spot.shut then spot.shut() end
		character:SetAttribute("Hiding", true)
		doorsCamera(spot.look)
		if spot.grille then
			grille.Visible = true
			TweenService:Create(grille, TweenInfo.new(0.4), { ImageTransparency = 0.05 }):Play()
		end
		spot.prompt.ActionText = "Get out"
		spot.prompt.Enabled = true
		moving = false
	end
	function getOut(forced)
		local spot = hidden
		local character, _, root = body()
		if not spot or moving then return end
		moving = true
		spot.prompt.Enabled = false
		if hideMonster then hideMonster.camlock = nil end -- (DOORS' Hide effect ends with it)
		hideMonster = nil
		RunService:UnbindFromRenderStep(camName)
		grille.Visible, grille.ImageTransparency = false, 1
		if character then character:SetAttribute("Hiding", false) end -- (DOORS lets the camera go itself)
		if spot.leave then spot.leave(forced) end
		animate(if forced then DOORS.forceOut else (spot.exitAnim or DOORS.exit))
		if root then
			local front = spot.front.Position
			local p = Vector3.new(front.X, spot.front.Y + 3.2, front.Z)
			tweenRoot(root, CFrame.lookAt(p, p + flat(spot.look)), if forced then 0.35 else 0.6)
			root.Anchored = false
			if forced then root.AssemblyLinearVelocity = flat(spot.look) * 30 + up * 12 end
		end
		hidden = nil
		spot.prompt.ActionText = "Hide"
		spot.prompt.Enabled = not spot.gone
		moving = false
		if forced then
			FX.caption("Get out.")
			damage(40, "Hide", { "You died to Hide.", "Don't stay hidden for too long." })
		end
	end
end
