local FX = {}
do
	local flashFrame = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1 }, screen)
	local captionLabel = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.82), Size = UDim2.fromScale(0.7, 0.05),
		BackgroundTransparency = 1, Text = "", TextScaled = true, Font = Enum.Font.Oswald, TextColor3 = Color3.fromRGB(255, 222, 189), TextStrokeTransparency = 0.3,
		TextTransparency = 1, ZIndex = 6 }, screen)
	local captionId = 0
	local function ownCaption(text, color, at, seconds)
		captionId += 1
		local mine = captionId
		captionLabel.Text, captionLabel.TextTransparency, captionLabel.TextColor3 = text, 0, color
		captionLabel.Position = UDim2.fromScale(0.5, at)
		task.delay(seconds, function()
			if captionId == mine and captionLabel.Parent then TweenService:Create(captionLabel, TweenInfo.new(0.6), { TextTransparency = 1 }):Play() end
		end)
	end
	-- DOORS' own caption, or one like it
	function FX.caption(text)
		local ok = mainGame and type(mainGame.caption) == "function" and pcall(mainGame.caption, text, true)
		if not ok then ownCaption(text, Color3.fromRGB(255, 222, 189), 0.82, 3.5) end
	end
	-- DOORS' own tip at the bottom (the Guiding Light's, in blue when it is one), or one like it
	function FX.remind(text, guiding)
		local ok = mainGame and type(mainGame.remind) == "function" and pcall(mainGame.remind, text)
		if ok and guiding then
			task.defer(function() -- (its tip, in the Guiding Light's blue)
				pcall(function()
					local tip = LocalPlayer.PlayerGui.MainUI.MainFrame:FindFirstChild("LiveTip")
					if tip and tip.Text == text then tip.TextColor3 = Color3.fromRGB(126, 205, 255) end
				end)
			end)
		end
		if not ok then ownCaption(text, if guiding then Color3.fromRGB(126, 205, 255) else Color3.fromRGB(255, 222, 189), 0.9, 6) end
	end
	-- DOORS' own location title (its jingle with it)
	function FX.title(name, jingle)
		local sound = nil
		pcall(function()
			sound = make("Sound", { Name = "LA_" .. name, SoundId = jingle, Volume = VOLUME * 0.8, PlaybackSpeed = 0.97 }, ReplicatedStorage.Sounds)
		end)
		local ok = mainGame and type(mainGame.titlelocation) == "function" and pcall(mainGame.titlelocation, name)
		if not ok then
			ownCaption(name, Color3.fromRGB(255, 222, 189), 0.3, 4)
			if sound then sound:Play() end
		end
		if sound then task.delay(12, function() sound:Destroy() end) end
	end
	function FX.shake(power)
		pcall(function() mainGame.camShaker:ShakeOnce(power, 12, 0, 0.6) end)
	end
	function FX.flash(color, strength)
		flashFrame.BackgroundColor3 = color
		flashFrame.BackgroundTransparency = 1 - (strength or 0.6)
		TweenService:Create(flashFrame, TweenInfo.new(0.7), { BackgroundTransparency = 1 }):Play()
	end
	-- A sound: an id (ours), or one of DOORS' as { id, volume, speed }
	function FX.sound(s, parent, props)
		if not s then return nil end
		local sound = make("Sound", { SoundId = if type(s) == "table" then s[1] else s, Volume = VOLUME * (if type(s) == "table" then s[2] else 1),
			PlaybackSpeed = if type(s) == "table" then s[3] else 1 }, parent or SoundService)
		for k, v in pairs(props or {}) do sound[k] = v end
		return sound
	end
	function FX.once(s, parent, props)
		local sound = FX.sound(s, parent or SoundService, props)
		if not sound then return nil end
		sound:Play()
		sound.Ended:Connect(function() sound:Destroy() end)
		task.delay(15, function() if sound.Parent then sound:Destroy() end end)
		return sound
	end
	function FX.loop(s, parent, props)
		local sound = FX.sound(s, parent, props)
		if sound then
			sound.Looped = true
			sound:Play()
		end
		return sound
	end
end
