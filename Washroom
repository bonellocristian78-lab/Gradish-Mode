local IMG, SND = {}, {}
do
	local REPO = "https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/claude/sei-qui-con-noi-ye4k62/"
	local MAGIC = { mp3 = { "ID3", "\255\251", "\255\243", "\255\242" }, png = { "\137PNG" } }
	local function valid(name, data)
		if type(data) ~= "string" or #data < 16 then return false end
		for _, start in ipairs(MAGIC[name:match("%.(%w+)$")] or {}) do
			if data:sub(1, #start) == start then return true end
		end
		return false
	end
	-- A content ID for a file of the repository (kept in the executor's folder `dir`), or nil
	local function file(dir, path, name)
		local here = dir .. "/" .. name
		if GENV.__WashroomFiles[here] then return GENV.__WashroomFiles[here] end
		pcall(function()
			if not isfolder(dir) then makefolder(dir) end
			if isfile(here) and valid(name, readfile(here)) then return end
			local data = game:HttpGet(REPO .. path .. name)
			if valid(name, data) then writefile(here, data) end
		end)
		local ok, got = pcall(function() return isfile(here) and getcustomasset(here) end)
		if not (ok and type(got) == "string") then return nil end
		GENV.__WashroomFiles[here] = got
		return got
	end
	-- All at once (several at a time)
	local names = { "Tiles.png", "Mold.png", "Grill.png", "Drum.png", "Stains.png", "Grate.png", "Buzz.mp3", "Drip.mp3", "Gurgle.mp3", "Bang.mp3",
		"Clank.mp3", "Spin.mp3", "Valve.mp3", "Chime.mp3" }
	local left = #names
	for _, n in ipairs(names) do
		task.spawn(function()
			local got = file("Washroom", "assets/washroom/", n)
			if n:find("%.png$") then IMG[n:sub(1, -5)] = got else SND[n:sub(1, -5)] = got end
			left -= 1
		end)
	end
	local t0 = os.clock()
	while left > 0 and os.clock() - t0 < 25 do task.wait(0.05) end
end
