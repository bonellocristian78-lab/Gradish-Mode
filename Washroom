local hidden = nil -- the dryer you are in
local grille = make("ImageLabel", { Name = "Grille", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = IMG.Grill or "", ScaleType = Enum.ScaleType.Tile,
	TileSize = UDim2.fromOffset(46, 46), Visible = false, ZIndex = 2 }, screen)
local camName = "WashroomHide" .. math.random(1, 1e6)
local hideMonster = nil
local hideStart = 0
local function setVignette(on)
	pcall(function() LocalPlayer.PlayerGui.MainUI.HideVignette.Visible = on end)
end
local function hiddenParts(on)
	local character = LocalPlayer.Character
	for _, d in ipairs(character and character:GetDescendants() or {}) do
		if d:IsA("BasePart") or d:IsA("Decal") then d.LocalTransparencyModifier = if on then 1 else 0 end
	end
end
local function getOut(hurt)
	local m = hidden
	if not m then return end
	hidden = nil
	RunService:UnbindFromRenderStep(camName)
	grille.Visible = false
	setVignette(false)
	if hideMonster then hideMonster.camlock = nil end -- (DOORS' Hide effect ends with it)
	hiddenParts(false)
	local _, _, root = body()
	if root then
		root.Anchored = false
		local out = m.face * CFrame.new(0, 0, -3)
		root.CFrame = CFrame.lookAt(Vector3.new(out.X, F.Y + 3.2, out.Z), Vector3.new(out.X, F.Y + 3.2, out.Z) + out.LookVector * Vector3.new(1, 0, 1))
	end
	FX.once(SND.Clank, m.drum, { Volume = 0.8 * VOLUME, PlaybackSpeed = 1.1 })
	m.prompt.ActionText = "Hide"
	if hurt then
		FX.caption("Get out.")
		damage(40, "Hide", { "You died to Hide.", "Don't stay hidden for too long." })
	end
end
-- Dupe: the wrong dryer, the false door
local function dupeAttack(at, where)
	FX.once(SND.Bang, at, { Volume = 2 * VOLUME })
	FX.once(SND.Bite, SoundService, { Volume = 1.6 * VOLUME })
	FX.once(SND.Roar, at, { Volume = 1.5 * VOLUME, PlaybackSpeed = 1.3 })
	FX.flash(Color3.fromRGB(120, 0, 0), 0.8)
	FX.shake(12)
	local eyes = {}
	for k = -1, 1, 2 do
		eyes[k] = box("DupeEye", Vector3.new(0.3, 0.3, 0.1), at.CFrame * CFrame.new(k * 0.5, 0.4, -0.3), Color3.fromRGB(255, 240, 220), M.Neon, { CanCollide = false })
	end
	task.delay(1.2, function()
		for _, e in pairs(eyes) do e:Destroy() end
	end)
	FX.caption(where)
	damage(40, "Dupe", { "You died to Dupe.", "Listen before you hide: water boiling inside means it is not a dryer.", "A door whose light never turns green is not a door." })
end
local function hide(m)
	local _, _, root = body()
	if not root or hidden then return end
	if m.dupe then
		dupeAttack(m.drum, "That one was not a dryer...")
		return
	end
	hidden, hideStart = m, os.clock()
	FX.once(SND.Clank, m.drum, { Volume = 1.6 * VOLUME })
	FX.shake(3)
	root.Anchored = true
	root.CFrame = m.inside
	hiddenParts(true)
	grille.Visible = true
	setVignette(true)
	m.prompt.ActionText = "Get out"
	local camera = workspace.CurrentCamera
	local look = m.face.LookVector
	RunService:BindToRenderStep(camName, Enum.RenderPriority.Last.Value, function()
		local t = os.clock()
		local eye = m.inside.Position + Vector3.new(0, 0.6 + math.sin(t * 1.4) * 0.04, 0)
		camera.CFrame = CFrame.lookAt(eye, eye + look + Vector3.new(math.sin(t * 0.5) * 0.08, -0.1, 0))
	end)
end
for _, m in ipairs(hideSpots) do
	m.prompt = make("ProximityPrompt", { ActionText = "Hide", ObjectText = "Dryer", HoldDuration = 0, MaxActivationDistance = 7, RequiresLineOfSight = false }, m.drum)
	on(m.prompt.Triggered, function()
		if hidden == m then getOut(false) else hide(m) end
	end)
end
-- Hide's rule: not too long. At 16 s it gets to you (DOORS' own effect), at 23 s it throws you out
on(RunService.Heartbeat, function()
	if not hidden then return end
	local inside = os.clock() - hideStart
	if inside > 16 and not hideMonster then
		hideMonster = setmetatable({ camlock = true, dead = false }, { __index = mainGame or {} })
		task.spawn(function()
			local ok = pcall(function()
				require(LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game.RemoteListener.Modules.HideMonster)(hideMonster, 7)
			end)
			if not ok then FX.once(SND.Whisper, SoundService, { Volume = 1.4 * VOLUME }) end
		end)
	end
	if inside > 23 then
		hideMonster = nil
		getOut(true)
	end
	if not hidden then hideMonster = nil end
end)

---====== THE LOOT: gold, the flashlight, the emergency key ======---

local hasKey = false
local function addGold(amount)
	FX.once(DOORS.gold, SoundService, { Volume = VOLUME })
	FX.caption(("+%d Gold"):format(amount))
	pcall(function() -- (on your screen only)
		for _, label in ipairs(LocalPlayer.PlayerGui.PermUI:GetDescendants()) do
			if label:IsA("TextLabel") and label.Name == "Gold" and tonumber(label.Text) then label.Text = tostring(tonumber(label.Text) + amount) end
		end
	end)
end
local function giveFlashlight()
	local light = box("Flashlight", Vector3.new(0.2, 0.2, 0.2), workspace.CurrentCamera.CFrame, Color3.new(0, 0, 0), M.SmoothPlastic,
		{ Transparency = 1, CanCollide = false, CanQuery = false })
	local spot = make("SpotLight", { Range = 45, Angle = 50, Brightness = 2.2, Color = Color3.fromRGB(255, 240, 210), Enabled = true, Shadows = true }, light)
	on(RunService.RenderStepped, function()
		light.CFrame = workspace.CurrentCamera.CFrame
	end)
	on(UserInputService.InputBegan, function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.F then
			spot.Enabled = not spot.Enabled
			FX.once(SND.Clank, SoundService, { Volume = 0.25 * VOLUME, PlaybackSpeed = 2.5 })
		end
	end)
	FX.caption("Flashlight (F)")
end
local loot = {} -- what each searchable place holds
do
	local places = {}
	for _, m in ipairs(machines) do
		if not m.open then table.insert(places, { part = m.glass, name = m.model.Name }) end
	end
	for _, c in ipairs(carts) do table.insert(places, { part = c.model:FindFirstChild("Bottom"), name = "Linen cart" }) end
	-- 8 of them can be searched: the key in one, the flashlight in one, gold in some, nothing in the rest
	local chosenPlaces = {}
	while #chosenPlaces < math.min(8, #places) do
		local p = table.remove(places, math.random(#places))
		table.insert(chosenPlaces, p)
	end
	for i, p in ipairs(chosenPlaces) do
		p.holds = if i == 1 then "key" elseif i == 2 then "flashlight" elseif i <= 6 then "gold" else nil
		local prompt = make("ProximityPrompt", { ActionText = "Search", ObjectText = p.name, HoldDuration = 0.4, MaxActivationDistance = 7, RequiresLineOfSight = false }, p.part)
		on(prompt.Triggered, function()
			prompt:Destroy()
			if p.holds == "key" then
				hasKey = true
				FX.once(SND.Chime, SoundService, { Volume = 0.8 * VOLUME })
				FX.caption("Emergency key: it opens the watertight door")
			elseif p.holds == "flashlight" then
				giveFlashlight()
			elseif p.holds == "gold" then
				addGold(math.random(5, 25))
			else
				FX.caption("Nothing.")
			end
		end)
		table.insert(loot, p)
	end
end

---====== THE VALVE: the water drains, the door lets go ======---

local drained = false
local function openExit()
	if exitDoor.opening then return end
	exitDoor.opening = true
	exitDoor.prompt.Enabled = false
	FX.once(SND.Hatch, exitDoor.leaf[1][1], { Volume = 1.8 * VOLUME, RollOffMinDistance = 15 })
	task.spawn(function()
		local t0 = os.clock()
		while alive and os.clock() - t0 < 3 do
			local t = os.clock() - t0
			exitDoor.open = math.clamp((t - 1) / 1.8, 0, 1) ^ 0.7
			exitDoor.pose(math.min(t, 1.2) * 5)
			RunService.Heartbeat:Wait()
		end
	end)
end
if valve then
	on(valve.prompt.Triggered, function()
		if valve.turned then return end
		valve.turned = true
		valve.prompt.Enabled = false
		FX.once(SND.Valve, valve.center, { Volume = 1.6 * VOLUME, RollOffMinDistance = 12 })
		task.spawn(function()
			local t0 = os.clock()
			while alive and os.clock() - t0 < 2.5 do -- two turns of its wheel
				valve.angle = (os.clock() - t0) / 2.5 * math.pi * 4
				valve.pose()
				RunService.Heartbeat:Wait()
			end
			if not alive then return end
			-- The water goes down the drains, gurgling
			for _, d in ipairs(drains) do FX.once(SND.Gurgle, d, { Volume = 1.6 * VOLUME, RollOffMinDistance = 15 }) end
			TweenService:Create(water, TweenInfo.new(5.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1, Size = Vector3.new(W - 0.2, 0.05, LEN - 0.2),
				CFrame = water.CFrame - Vector3.new(0, 0.3, 0) }):Play()
			wait(5.5)
			drained = true
			exitDoor.green()
			FX.once(SND.Chime, exitDoor.light, { Volume = 1.5 * VOLUME, RollOffMinDistance = 30 })
			FX.caption("The door is open.")
			exitDoor.prompt.ActionText = "Open"
		end)
	end)
end
on(exitDoor.prompt.Triggered, function()
	if drained then
		openExit()
	elseif hasKey then
		FX.caption("Emergency override")
		exitDoor.green()
		openExit()
	else
		FX.once(DOORS.locked, exitDoor.leaf[1][1], { Volume = VOLUME })
		FX.caption("It is sealed: the water holds it. Find the drain valve.")
	end
end)
on(fakeDoor.prompt.Triggered, function()
	fakeDoor.prompt.Enabled = false
	fakeDoor.open = 0.15
	fakeDoor.pose(0.6)
	dupeAttack(fakeDoor.light, "That was not a door...")
	task.delay(0.8, function()
		fakeDoor.open = 0
		fakeDoor.pose(0)
		fakeDoor.light.Color = Color3.fromRGB(30, 10, 10)
		fakeDoor.glow.Enabled = false
	end)
end)

---====== RUSH, AMBUSH ======---

local entityComing = false
local function spinAll(on)
	for _, m in ipairs(machines) do
		if not m.open then
			m.spin = if on then 22 + math.random() * 10 else 0
			if m.spinSound then
				if on then m.spinSound.Volume = 0.55 * VOLUME m.spinSound:Play() else m.spinSound:Stop() end
			end
		end
	end
end
local function entityBody(kind)
	local body = nil
	pcall(function()
		local template = ReplicatedStorage.JumpscareModels:FindFirstChild("RushNew")
		if template then body = template:Clone() end
	end)
	if not body then -- (one like it: a black, smoking face)
		body = make("Part", { Name = "Rush", Size = Vector3.new(4, 4, 4), Transparency = 1 }, nil)
		local a = make("Attachment", {}, body)
		make("ParticleEmitter", { Texture = "rbxasset://textures/particles/smoke_main.dds", Rate = 60, Lifetime = NumberRange.new(0.5, 1), Speed = NumberRange.new(1, 4),
			Size = NumberSequence.new(4, 7), Color = ColorSequence.new(Color3.new(0, 0, 0)), SpreadAngle = Vector2.new(180, 180) }, a)
		make("PointLight", { Range = 30, Brightness = 2, Color = Color3.fromRGB(200, 200, 255) }, a)
	end
	for _, d in ipairs(body:GetDescendants()) do
		if d:IsA("BodyMover") or d:IsA("LuaSourceContainer") then d:Destroy() end
		if kind == "Ambush" and (d:IsA("ParticleEmitter") or d:IsA("Light")) then d.Color = if d:IsA("Light") then Color3.fromRGB(80, 255, 120) else ColorSequence.new(Color3.fromRGB(80, 255, 120)) end
	end
	body.Anchored, body.CanCollide, body.CanQuery, body.CanTouch = true, false, false, false
	body.Parent = folder
	return body
end
local function comes(kind)
	if entityComing or not alive then return end
	entityComing = true
	local hints = if kind == "Ambush" then { "You died to Ambush.", "It comes back: stay in the dryer until the drums stop.", "Hide when the drums start spinning by themselves." }
		else { "You died to Rush.", "When the drums start spinning by themselves, hide in a dryer." }
	-- First: every empty drum spinning by itself, the lights flickering
	spinAll(true)
	FX.once(if kind == "Ambush" then DOORS.ambush else DOORS.rush, SoundService, { Volume = 1.2 * VOLUME })
	local t0 = os.clock()
	while alive and os.clock() - t0 < 4 do
		for _, t in ipairs(tubes) do tubeOn(t, math.random() < 0.55) end
		FX.shake(1.5)
		task.wait(0.08)
	end
	if not alive then return end
	-- Then it: from the stairs to the far end; Ambush again and again
	local thing = entityBody(kind)
	for _, s in ipairs(thing:GetDescendants()) do
		if s:IsA("Sound") and (s.Name == "PlaySound" or s.Name == "Footsteps") then
			s.Looped = true
			s:Play()
		end
	end
	local path = { L(0, 28, LEN / 2 + STAIR.run + 6).Position, L(0, 5, LEN / 2 + 2).Position, L(0, 5, -LEN / 2 + 2).Position }
	local passes = if kind == "Ambush" then math.random(2, 4) else 1
	for pass = 1, passes do
		local way = if pass % 2 == 1 then path else { path[3], path[2], path[1] }
		local pos, i = way[1], 2
		while alive and i <= #way do
			local dt = RunService.Heartbeat:Wait()
			local step = 95 * dt
			while step > 0 and i <= #way do
				local to = way[i] - pos
				if to.Magnitude <= step then
					pos, step, i = way[i], step - to.Magnitude, i + 1
				else
					pos, step = pos + to.Unit * step, 0
				end
			end
			thing.CFrame = CFrame.new(pos)
			local _, _, me = body()
			if me then
				local d = (me.Position - pos).Magnitude
				if d < 70 then FX.shake(6 * (1 - d / 70)) end
				-- In the Washroom and not in a dryer: as it passes you, you die
				if not hidden and not dead and math.abs((F:PointToObjectSpace(me.Position)).Z - F:PointToObjectSpace(pos).Z) < 6 and d < 40 then
					jumpscare(kind, hints)
				end
			end
		end
		if pass < passes then wait(1 + math.random() * 1.5) end
	end
	thing:Destroy()
	spinAll(false)
	for _, t in ipairs(tubes) do tubeOn(t, true) end
end
-- Once while you are here: a while after you come down (at once if DOORS sends one of its own)
task.delay(25 + math.random() * 25, function() comes(if math.random() < 0.65 then "Rush" else "Ambush") end)
on(workspace.ChildAdded, function(child)
	if child.Name == "RushMoving" then task.spawn(comes, "Rush") elseif child.Name == "AmbushMoving" then task.spawn(comes, "Ambush") end
end)

---====== THE ROOM ALIVE: drums turning, bangs, drips, flickering tubes ======---

local bangAt, dripAt, flickerAt = os.clock() + 8 + math.random() * 8, os.clock() + 2, os.clock() + 3
on(RunService.Heartbeat, function(dt)
	local now = os.clock()
	for _, m in ipairs(machines) do
		if m.spin > 0 then
			m.angle += m.spin * dt
			poseDrum(m)
		end
	end
	-- A dryer starting with a bang, like something arriving
	if now >= bangAt and not entityComing then
		bangAt = now + 10 + math.random() * 12
		local m = pick(machines)
		if not m.open then
			FX.once(SND.Bang, m.drum, { Volume = 2.2 * VOLUME, RollOffMinDistance = 20, RollOffMaxDistance = 200 })
			FX.shake(2.5)
			m.spin = 16
			if m.spinSound then m.spinSound.Volume = 0.5 * VOLUME m.spinSound:Play() end
			m.led.Color = Color3.fromRGB(60, 255, 80)
			task.delay(3 + math.random() * 2, function()
				if not entityComing then
					m.spin = 0
					if m.spinSound then m.spinSound:Stop() end
				end
				m.led.Color = Color3.fromRGB(255, 60, 40)
			end)
		end
	end
	if now >= dripAt then
		dripAt = now + 1 + math.random() * 2.5
		local d = pick(drips)
		FX.once(SND.Drip, d, { Volume = 0.7 * VOLUME, RollOffMaxDistance = 50, PlaybackSpeed = 0.85 + math.random() * 0.3 })
	end
	if now >= flickerAt and not entityComing then
		flickerAt = now + 1.5 + math.random() * 4
		local t = pick(tubes)
		tubeOn(t, false)
		FX.once(DOORS.flicker, t.tube, { Volume = 0.4 * VOLUME, RollOffMaxDistance = 40 })
		task.delay(0.06 + math.random() * 0.25, function() tubeOn(t, true) end)
	end
	-- Through the door and up the stairs: back in the Hotel, in front of the door of your room
	local _, _, me = body()
	if me and exitDoor.open > 0.5 and (me.Position - exitDoor.back.Position).Magnitude < 5 then
		me.CFrame = backInTheHotel()
		FX.caption("Back in the Hotel")
		stop()
	end
end)

-- Dead, or gone from the run: it all goes
on(humanoid0.Died, function() task.delay(4, stop) end)
later(function()
	local _, _, root = body()
	if root and (root.Position - O).Magnitude < 160 and not dead then
		root.Anchored = false
		root.CFrame = backInTheHotel()
	end
	if hidden then
		local m = hidden
		hidden = nil
		RunService:UnbindFromRenderStep(camName)
		hiddenParts(false)
		local _, _, root = body()
		if root then root.Anchored = false end
		m.prompt.ActionText = "Hide"
	end
	setVignette(false)
end)

