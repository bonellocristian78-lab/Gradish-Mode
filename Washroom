local function make(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do i[k] = v end
	i.Parent = parent
	return i
end
local function rnd(a) return (math.random() * 2 - 1) * a end
local function pick(list) return list[math.random(#list)] end
local function flat(v) return v * Vector3.new(1, 0, 1) end

local hud = if gethui then gethui() else LocalPlayer:WaitForChild("PlayerGui")
local folder = make("Model", { Name = "Washroom" }, workspace)
local screen = make("ScreenGui", { Name = "Washroom", IgnoreGuiInset = true, DisplayOrder = 100005, ResetOnSpawn = false }, hud)
local mainGame = nil -- DOORS' Main_Game: its caption, its camera shake
pcall(function() mainGame = require(LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game) end)

local alive = true
local connections, cleanups = {}, {}
local function on(signal, fn)
	local c = signal:Connect(fn)
	table.insert(connections, c)
	return c
end
local function later(fn) table.insert(cleanups, fn) end
local function stop()
	if not alive then return end
	alive = false
	for _, c in ipairs(connections) do c:Disconnect() end
	for i = #cleanups, 1, -1 do pcall(cleanups[i]) end
	folder:Destroy()
	screen:Destroy()
	if GENV.__Washroom == stop then GENV.__Washroom = nil end
end
GENV.__Washroom = stop
local function wait(seconds)
	local t0 = os.clock()
	repeat RunService.Heartbeat:Wait() until not alive or os.clock() - t0 >= seconds
	return alive
end
local function untag(d)
	pcall(function()
		for _, tag in ipairs(CollectionService:GetTags(d)) do CollectionService:RemoveTag(d, tag) end
	end)
end

---====== FILES ======---

local MAGIC = { mp3 = { "ID3", "\255\251", "\255\243", "\255\242" }, png = { "\137PNG" } }
local function valid(name, data)
	if type(data) ~= "string" or #data < 16 then return false end
	for _, start in ipairs(MAGIC[name:match("%.(%w+)$")] or {}) do
		if data:sub(1, #start) == start then return true end
	end
	return false
end
-- A content ID for a file of the repository (kept in the executor's folder `dir`), or nil
local function file(dir, path, name)
	local here = dir .. "/" .. name
	if GENV.__WashroomFiles[here] then return GENV.__WashroomFiles[here] end
	pcall(function()
		if not isfolder(dir) then makefolder(dir) end
		if isfile(here) and valid(name, readfile(here)) then return end
		local data = game:HttpGet(REPO .. path .. name)
		if valid(name, data) then writefile(here, data) end
	end)
	local ok, id = pcall(function() return isfile(here) and getcustomasset(here) end)
	if not (ok and type(id) == "string") then return nil end
	GENV.__WashroomFiles[here] = id
	return id
end
