---====== B-02, B-03: DOORS' lock on them; their key (held, or in your inventory) in it: the shackle opens, the lock falls ======---

do
	-- The key of that door: in your hand, or in your inventory
	local function heldKey(number)
		for _, holder in ipairs({ LocalPlayer.Character, LocalPlayer:FindFirstChildOfClass("Backpack") }) do
			for _, t in ipairs(holder and holder:GetChildren() or {}) do
				if t:IsA("Tool") and t.Name == "Key" and t:GetAttribute("Door") == number then return t end
			end
		end
		return nil
	end
	local function unlock(door, keyTool, after)
		local lock = door.lock
		animate(DOORS.interact)
		local from = workspace.CurrentCamera.CFrame * CFrame.new(1.1, -1.1, -2.4)
		pcall(function()
			if keyTool.Parent == LocalPlayer.Character then from = keyTool.Handle.CFrame end
		end)
		keyTool:Destroy()
		-- The key: from your hand into its keyhole, turned
		local hole = lock and lock.hole or door.leaf
		local into = hole.CFrame * CFrame.new(0, 0, -0.6) * CFrame.Angles(0, -math.pi / 2, 0)
		local k = keyModel(from, door.model, door.number)
		local t0 = os.clock()
		while alive and os.clock() - t0 < 0.45 do
			k:PivotTo(from:Lerp(into, (os.clock() - t0) / 0.45))
			RunService.Heartbeat:Wait()
		end
		for i = 1, 6 do
			k:PivotTo(into * CFrame.Angles(i / 6 * math.pi / 2, 0, 0))
			RunService.Heartbeat:Wait()
		end
		playOwn(door.model, "Unlock")
		if lock then
			-- DOORS' lock: its shackle up and open on its hinge (its attachment, as the Hotel-'s fallen ones have it)
			if lock.shackleAtt then
				local open = lock.bodyAtt.WorldCFrame * lock.open:Inverse()
				local was = lock.shackle.CFrame
				local t1 = os.clock()
				while alive and os.clock() - t1 < 0.2 do
					lock.shackle.CFrame = was:Lerp(open, (os.clock() - t1) / 0.2)
					RunService.Heartbeat:Wait()
				end
				lock.shackle.CFrame = open
				lock.shackleAtt.CFrame = lock.open
			elseif lock.shackle then
				lock.shackle.CFrame = lock.shackle.CFrame * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 1.4, 0)
			end
			wait(0.25)
			k:Destroy()
			-- Let go: it falls, all of it (welded, its shackle on its hinge), as DOORS' locks fall; its Fall as it lands
			local top = lock.body.Position
			for _, p in ipairs(lock.parts) do p.Anchored, p.CanCollide = false, true end
			task.delay(0.6, function()
				if not (alive and lock.body.Parent) then return end
				if (top - lock.body.Position).Magnitude < 0.5 then -- (where nothing moves it here: down to the floor, on its side)
					local drop = lock.body.Position.Y - (door.floor + 0.25)
					local turn = CFrame.new(lock.body.Position - up * drop) * CFrame.Angles(math.pi / 2, 0, 0.4) * lock.body.CFrame.Rotation
					local rel = {}
					for i, p in ipairs(lock.parts) do
						p.Anchored = true
						rel[i] = lock.body.CFrame:ToObjectSpace(p.CFrame)
					end
					for i, p in ipairs(lock.parts) do p.CFrame = turn * rel[i] end
				end
				if door.leaf:FindFirstChild("Fall", true) then playOwn(door.leaf, "Fall") else FX.once(DOORS.fall, lock.body) end
			end)
		else
			wait(0.25)
			k:Destroy()
		end
		door.locked = false
		door.color(Color3.fromRGB(40, 255, 90))
		if after then after() end
		wait(0.3)
		door.open()
		FX.caption(door.number)
	end
	-- DOORS' prompt on its lock (Interact, Lock: held a second)
	local function lockOn(door, after)
		local where = door.lock and door.lock.body or door.leaf
		local prompt = make("ProximityPrompt", { Name = "UnlockPrompt", ActionText = "Interact", ObjectText = "Lock", HoldDuration = 1, MaxActivationDistance = 8,
			RequiresLineOfSight = false, Style = Enum.ProximityPromptStyle.Custom }, where)
		on(prompt.Triggered, function()
			if not door.locked then return end
			local keyTool = heldKey(door.number)
			if keyTool then
				prompt:Destroy()
				task.spawn(unlock, door, keyTool, after)
			else
				animate(DOORS.interact)
				playOwn(door.model, "Error")
				FX.caption("It's locked.")
			end
		end)
	end
	lockOn(doorB02, function() setStage("open") end)
	lockOn(doorB03, function() setStage("out") end)
end

