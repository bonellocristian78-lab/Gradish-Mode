	-- DOORS' wardrobes: their doors open and shut on DOORS' own animations, their own sounds (where you stand: their
	-- EnterAttachment)
	for _, w in ipairs(attic.wardrobes) do
		w.grille = false
		local function play(anim)
			local track = w.tracks[anim]
			if not track then
				local a = Instance.new("Animation")
				a.AnimationId = anim
				local ok, t = pcall(function() return w.animator:LoadAnimation(a) end)
				if not ok then return end
				track = t
				w.tracks[anim] = track
			end
			pcall(function() track:Play(0.05) end)
		end
		function w.enter()
			play(DOORS.wardrobeIn)
			if not (w.main:FindFirstChild("SoundEnter") and pcall(function() w.main.SoundEnter:Play() end)) then FX.once(DOORS.hideIn, w.main, { Volume = VOLUME }) end
		end
		function w.leave()
			play(DOORS.wardrobeOut)
			if not (w.main:FindFirstChild("SoundExit") and pcall(function() w.main.SoundExit:Play() end)) then FX.once(DOORS.hideOut, w.main, { Volume = VOLUME }) end
		end
		addSpot(w, w.main, "Wardrobe", 9)
	end
	-- Under the tables (crouched, as the Hotel- crouches)
	for _, t in ipairs(tables) do
		local spot = { kind = "table", table = t, front = t.front * CFrame.new(0, 3.2, 0), inside = t.inside * CFrame.new(0, 0.4, 0),
			look = (t.cf * CFrame.new(0, 0, 1)).Position - t.cf.Position, anim = CROUCH, exitAnim = DOORS.interact }
		function spot.enter() FX.once(DOORS.drawerClose, t.top, { Volume = VOLUME * 0.5, PlaybackSpeed = 0.6 }) end
		function spot.leave()
			pcall(function() tracks[CROUCH]:Stop(0.2) end)
		end
		t.spot = addSpot(spot, t.top, "Table")
	end
end

