			cylinder("Hoop", 0.2, (if x == 0 then d + 0.26 else d + 0.08), cf * CFrame.new(x, 0, 0), Color3.fromRGB(52, 50, 52), M.Metal, nil, m)
		end
		for _, x in ipairs({ -len / 2 + 0.02, len / 2 - 0.02 }) do
			cylinder("End", 0.06, d - 0.25, cf * CFrame.new(x * 1.01, 0, 0), Color3.fromRGB(90, 60, 40), M.Wood, nil, m)
		end
		cylinder("Bung", 0.1, 0.32, cf * CFrame.new(0, d / 2 + 0.1, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(70, 46, 30), M.Wood, nil, m)
		return m
	end
