		local into = hole.CFrame * CFrame.new(0, 0, -0.6) * CFrame.Angles(0, -math.pi / 2, 0) -- (before its keyhole, its bit into it)
		if key.model then
			local from = key.model:GetPivot()
			local t0 = os.clock()
			while alive and os.clock() - t0 < 0.45 do
				key.model:PivotTo(from:Lerp(into, (os.clock() - t0) / 0.45))
				RunService.Heartbeat:Wait()
			end
			for i = 1, 6 do -- (it turns)
				key.model:PivotTo(into * CFrame.Angles(i / 6 * math.pi / 2, 0, 0))
				RunService.Heartbeat:Wait()
			end
		end
		playOwn(doorB02.model, "Unlock")
		if lock then
			if lock.shackle then lock.shackle.CFrame = lock.shackle.CFrame * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 1.4, 0) end
			wait(0.25)
			for _, p in ipairs(lock.parts) do -- (it falls: let go, as DOORS' locks fall)
				p.Anchored, p.CanCollide = false, true
			end
			task.delay(0.6, function() FX.once(DOORS.fall, lock.body) end)
			task.delay(8, function()
				for _, p in ipairs(lock.parts) do pcall(function() p:Destroy() end) end
			end)
		end
		if key.model then
			key.model:Destroy()
			key.model = nil
		end
		key.used = true
		doorB02.locked = false
		doorB02.color(Color3.fromRGB(40, 255, 90))
		setStage("open")
		wait(0.3)
		doorB02.open()
		FX.caption("B-02")
	end
	do
		local where = doorB02.lock and doorB02.lock.body or doorB02.leaf
		local prompt = make("ProximityPrompt", { ActionText = "Unlock", ObjectText = "Lock", HoldDuration = 0.4, MaxActivationDistance = 8, RequiresLineOfSight = false,
			Style = Enum.ProximityPromptStyle.Custom }, where)
		on(prompt.Triggered, function()
			if key.used then return end
			if key.held then
				prompt:Destroy()
				task.spawn(unlockB02)
			else
				animate(DOORS.interact)
				playOwn(doorB02.model, "Error")
				FX.caption("It's locked.")
			end
		end)
	end
end

