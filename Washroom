local FX = {}
local flashFrame = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1 }, screen)
local captionLabel = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.82), Size = UDim2.fromScale(0.7, 0.05),
	BackgroundTransparency = 1, Text = "", TextScaled = true, Font = Enum.Font.Oswald, TextColor3 = Color3.fromRGB(255, 222, 189), TextStrokeTransparency = 0.3,
	TextTransparency = 1, ZIndex = 6 }, screen)
local captionId = 0
-- DOORS' own caption, or one like it
function FX.caption(text)
	local ok = mainGame and type(mainGame.caption) == "function" and pcall(mainGame.caption, text, true)
	if ok then return end
	captionId += 1
	local id = captionId
	captionLabel.Text, captionLabel.TextTransparency = text, 0
	task.delay(3.5, function()
		if captionId == id and captionLabel.Parent then TweenService:Create(captionLabel, TweenInfo.new(0.6), { TextTransparency = 1 }):Play() end
	end)
end
function FX.shake(power)
	pcall(function() mainGame.camShaker:ShakeOnce(power, 12, 0, 0.6) end)
end
function FX.flash(color, strength)
	flashFrame.BackgroundColor3 = color
	flashFrame.BackgroundTransparency = 1 - (strength or 0.6)
	TweenService:Create(flashFrame, TweenInfo.new(0.7), { BackgroundTransparency = 1 }):Play()
end
function FX.sound(id, parent, props)
	if not id then return nil end
	local s = make("Sound", { SoundId = id, Volume = VOLUME }, parent or SoundService)
	for k, v in pairs(props or {}) do s[k] = v end
	return s
end
function FX.once(id, parent, props)
	local s = FX.sound(id, parent or SoundService, props)
	if not s then return nil end
	s:Play()
	s.Ended:Connect(function() s:Destroy() end)
	task.delay(15, function() if s.Parent then s:Destroy() end end)
	return s
end
function FX.loop(id, parent, props)
	local s = FX.sound(id, parent, props)
	if s then
		s.Looped = true
		s:Play()
	end
	return s
end

---====== WHAT HAPPENS TO YOU ======---

local dead = false
local function kill(name, hints)
	local _, humanoid = body()
	if not humanoid or dead then return end
	dead = true
	pcall(function() ReplicatedStorage.GameStats["Player_" .. LocalPlayer.Name].Total.DeathCause.Value = name end)
	if firesignal then
		task.spawn(function()
			pcall(function()
				local death = LocalPlayer.PlayerGui.MainUI:FindFirstChild("Death")
				if death and not death.Visible then death:GetPropertyChangedSignal("Visible"):Wait() end
				firesignal(ReplicatedStorage.Bricks.DeathHint.OnClientEvent, hints)
			end)
		end)
	end
	humanoid.Health = 0
end
-- DOORS' own jumpscare (Rush, Ambush), then your death
local caught = false
local function jumpscare(entity, hints)
	if caught then return end
	caught = true
	local shown = firesignal and pcall(function() firesignal(ReplicatedStorage.Bricks.Jumpscare.OnClientEvent, entity) end)
	if not shown then
		FX.flash(if entity == "Ambush" then Color3.fromRGB(40, 200, 80) else Color3.new(0, 0, 0), 0.9)
		FX.shake(10)
	end
	task.delay(if shown then 1.6 else 0.3, function() kill(entity, hints) end)
end
local function damage(amount, name, hints)
	local _, humanoid = body()
	if not humanoid then return end
	if humanoid.Health - amount <= 0 then
		kill(name, hints)
		return
	end
	humanoid.Health -= amount
	FX.flash(Color3.fromRGB(150, 0, 0), 0.5)
	FX.shake(6)
end

---====== WHERE: THE HOTEL ROOM YOU ARE IN, AND FAR BELOW IT ======---

local function roomYouAreIn()
	local rooms = workspace:FindFirstChild("CurrentRooms")
	if not rooms then return nil end
	local named = rooms:FindFirstChild(tostring(LocalPlayer:GetAttribute("CurrentRoom") or ""))
	if named then return named end
	local best, bestDistance = nil, math.huge
	for _, room in ipairs(rooms:GetChildren()) do
		local mark = room:FindFirstChild("RoomEnd") or room:FindFirstChild("RoomExit")
		if mark and mark:IsA("BasePart") then
			local d = (mark.Position - root0.Position).Magnitude
			if d < bestDistance then best, bestDistance = room, d end
		end
	end
	return best
end
local hotelRoom = roomYouAreIn()
local cameFrom = root0.CFrame
-- On the way back: in front of the door of your room, facing it
local function backInTheHotel()
	local room = if hotelRoom and hotelRoom.Parent then hotelRoom else nil
	local finish = room and (room:FindFirstChild("RoomEnd") or room:FindFirstChild("RoomExit"))
	local start = room and (room:FindFirstChild("RoomStart") or room:FindFirstChild("RoomEntrance"))
	if finish and start then
		local inward = flat(start.Position - finish.Position)
		inward = if inward.Magnitude > 0.1 then inward.Unit else Vector3.new(0, 0, 1)
		local p = finish.Position + inward * 5 + Vector3.new(0, 3.2, 0)
		return CFrame.lookAt(p, p - inward)
	end
	return cameFrom
end
