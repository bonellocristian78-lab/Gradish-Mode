	-- When: while you are in the laundry or the attic, now and then (the first a while after you come), one at a time;
	-- Glee before the ones that come at you
	local POOL = { laundry = { "A-45", "A-25", "CB-1", "A-105", "Big Man" }, attic = { "A-45", "A-25", "A-105", "Big Man", "Nerd Man", "CB-1" } }
	local WARNED = { ["A-45"] = true, ["A-25"] = true, ["CB-1"] = true, ["Big Man"] = true }
	local director = { at = nil, busy = false, last = nil }
	on(RunService.Heartbeat, function()
		if director.busy or dead then return end
		local _, _, me = body()
		if not me then return end
		local here = areaOf(me.Position)
		if here ~= "laundry" and here ~= "attic" then return end
		local now = os.clock()
		if not director.at then
			director.at = now + 45 + math.random() * 20
			return
		end
		if now < director.at then return end
		local pool = {}
		for _, name in ipairs(POOL[here]) do
			if name ~= director.last then table.insert(pool, name) end
		end
		local name = pick(pool)
		director.busy, director.last = true, name
		task.spawn(function()
			if WARNED[name] then
				glee()
				wait(1)
			end
			pcall(ENTITY[name], here)
			director.busy = false
			director.at = os.clock() + 40 + math.random() * 35
		end)
	end)
