local dead = false
local function kill(name, hints)
	local _, humanoid = body()
	if not humanoid or dead then return end
	dead = true
	pcall(function() ReplicatedStorage.GameStats["Player_" .. LocalPlayer.Name].Total.DeathCause.Value = name end)
	if firesignal then
		task.spawn(function()
			pcall(function()
				local death = LocalPlayer.PlayerGui.MainUI:FindFirstChild("Death")
				if death and not death.Visible then death:GetPropertyChangedSignal("Visible"):Wait() end
				firesignal(ReplicatedStorage.Bricks.DeathHint.OnClientEvent, hints)
			end)
		end)
	end
	humanoid.Health = 0
end
local function damage(amount, name, hints)
	local _, humanoid = body()
	if not humanoid then return end
	if humanoid.Health - amount <= 0 then
		kill(name, hints)
		return
	end
	humanoid.Health -= amount
	FX.flash(Color3.fromRGB(150, 0, 0), 0.5)
	FX.shake(6)
end

