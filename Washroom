-- cf: its base's middle, looking out of its door. `big`: a wall dryer. `open`: its door open (a hiding place)
local machines, hideSpots = {}, {}
local function machine(cf, big, open)
	local m = { model = make("Model", { Name = if big then "Dryer" else (if open then "Dryer" else "Washer") }, folder), spin = 0, angle = math.random() * 6, open = open }
	local d, h, w = if big then 6 else 5, if big then 8 else 6, if big then 6.4 else 5
	local r = if big then 2.4 else 1.7 -- its door's radius
	local doorY = if big then 4.4 else 3
	box("Body", Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, 0), STEEL, M.Metal, nil, m.model)
	box("Panel", Vector3.new(w - 0.4, 0.9, 0.2), cf * CFrame.new(0, h - 0.6, -d / 2 - 0.05), Color3.fromRGB(60, 64, 66), M.Metal, nil, m.model)
	for k = -1, 1 do cylinder("Knob", 0.25, 0.4, cf * CFrame.new(k * 0.8, h - 0.6, -d / 2 - 0.25) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(30, 30, 30), M.SmoothPlastic, nil, m.model) end
	m.led = box("Led", Vector3.new(0.18, 0.18, 0.1), cf * CFrame.new(w / 2 - 0.6, h - 0.6, -d / 2 - 0.2), Color3.fromRGB(255, 60, 40), M.Neon, { CanCollide = false }, m.model)
	local face = cf * CFrame.new(0, doorY, -d / 2)
	m.face = face
	-- Its rim, its drum (a disc on the front, with its paddles), seen through the door
	cylinder("Rim", 0.08, r * 2.2, face * CFrame.new(0, 0, -0.04) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(70, 72, 75), M.Metal, { CanCollide = false }, m.model)
	m.drumFrame = face * CFrame.new(0, 0, -0.12) * CFrame.Angles(0, math.pi / 2, 0)
	m.drum = cylinder("Drum", 0.06, r * 1.9, m.drumFrame, if open then Color3.fromRGB(12, 12, 14) else Color3.fromRGB(170, 172, 175), M.Metal, { CanCollide = false }, m.model)
	if not open then texture(m.drum, IMG.Drum, { "Left", "Right" }, 1.2) end
	m.paddles = {}
	for k = 1, 3 do
		m.paddles[k] = box("Paddle", Vector3.new(0.15, 0.7, 0.25), m.drumFrame, Color3.fromRGB(120, 122, 125), M.Metal, { CanCollide = false }, m.model)
	end
	-- Its door: the glass (open: swung aside on its hinge, its back plate behind it)
	local doorCf = face * CFrame.new(0, 0, -0.32)
	if open then
		doorCf = face * CFrame.new(-r * 1.05, 0, -0.2) * CFrame.Angles(0, 1.85, 0) * CFrame.new(r * 1.05, 0, -0.12) -- (out, toward you)
		cylinder("Door", 0.12, r * 2.1, doorCf * CFrame.new(0, 0, 0.12) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(70, 72, 75), M.Metal, { CanCollide = false }, m.model)
	end
	m.glass = cylinder("Glass", 0.12, r * 1.9, doorCf * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(160, 190, 200), M.Glass,
		{ Transparency = 0.6, CanCollide = false }, m.model)
	m.spinSound = FX.sound(SND.Spin, m.drum, { Looped = true, Volume = 0, RollOffMaxDistance = 70, RollOffMinDistance = 6 })
	m.inside = cf * CFrame.new(0, doorY - 0.4, -d / 2 + 1.6) -- where you are when hidden in it
	table.insert(machines, m)
	if open then table.insert(hideSpots, m) end
	return m
end
local function poseDrum(m)
	m.drum.CFrame = m.drumFrame * CFrame.Angles(m.angle, 0, 0)
