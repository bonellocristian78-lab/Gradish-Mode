local up = Vector3.new(0, 1, 0)
local cast
do
	local probe = RaycastParams.new()
	probe.FilterType = Enum.RaycastFilterType.Exclude
	probe.RespectCanCollide = true
	function cast(from, direction, also)
		probe.FilterDescendantsInstances = { folder, LocalPlayer.Character, also or folder }
		return workspace:Raycast(from, direction, probe)
	end
end
local rooms = workspace:FindFirstChild("CurrentRooms")
-- Room 0 (else the room you are in): its door's place on its floor, the way out through it
local hotelRoom = rooms and rooms:FindFirstChild("0")
if rooms and not (hotelRoom and hotelRoom:FindFirstChild("RoomEnd")) then
	hotelRoom = rooms:FindFirstChild(tostring(LocalPlayer:GetAttribute("CurrentRoom") or ""))
	if not hotelRoom then
		local bestDistance = math.huge
		for _, room in ipairs(rooms:GetChildren()) do
			local mark = room:FindFirstChild("RoomEnd")
			if mark and mark:IsA("BasePart") and (mark.Position - root0.Position).Magnitude < bestDistance then
				hotelRoom, bestDistance = room, (mark.Position - root0.Position).Magnitude
			end
		end
	end
end
local roomEnd = hotelRoom and hotelRoom:FindFirstChild("RoomEnd")
local out, doorFloor, endLift
if roomEnd then
	out = flat(roomEnd.CFrame.LookVector)
	out = if out.Magnitude > 0.1 then out.Unit else Vector3.new(0, 0, -1)
	local start = hotelRoom:FindFirstChild("RoomStart")
	if start and (start.Position - roomEnd.Position):Dot(out) > 0 then out = -out end -- (out: away from the room)
	endLift = roomEnd.Size.Y / 2
	doorFloor = roomEnd.Position - up * endLift -- (DOORS' RoomEnd is its doorway: its bottom is the floor)
else -- (outside the Hotel-: a door's place ahead of you)
	out = flat(workspace.CurrentCamera.CFrame.LookVector)
	out = if out.Magnitude > 0.1 then out.Unit else Vector3.new(0, 0, -1)
	local hit = cast(root0.Position + out * 16 + up * 2, Vector3.new(0, -30, 0))
	doorFloor = if hit then hit.Position else root0.Position + out * 16 - up * 3
	endLift = 4
end
local side = out:Cross(up).Unit
-- In front of the door, inside the room, facing it: where the way back leaves you
local function backInTheHotel()
	local p = doorFloor - out * 5 + up * 3.2
	return CFrame.lookAt(p, p + out)
end

-- All of it, in one frame (x across, y up, -z the way on; its origin the laundry's floor's middle, 40 under the Hotel's):
local DEPTH = 40
local LW, LL, LH = 44, 72, 22 -- the laundry: x -22..22, z -36..36, y 0..22 (its walls 1 thick, outside that)
local STAIR = { w = 6, z0 = LL / 2 + 2, z1 = LL / 2 + 62 } -- from z 38 (y 0) up to z 98 (y 40): 40 steps of 1.5
local HOLE = { z0 = STAIR.z1 - 12, z1 = STAIR.z1 + 0.1 } -- the opening in the Hotel's floor over the top of the stairs (a little
-- wider than the stairwell: its walls' tops show at its edges, never in the same place as its floor's cut)
local AW, AY, AH = 56, 6, 16 -- the attic: x -28..28, its floor 6 up, 16 high
local AZ0 = -LL / 2 - 13 -- z -49: its near wall (the steps from B-02 come up to it)
local AZ1 = AZ0 - 84 -- z -133: its far wall (B-03)
local TOPZ = AZ1 - 28 -- z -161: the door at the top of the way back
local holeSize = Vector3.new(STAIR.w + 0.2, 0, HOLE.z1 - HOLE.z0)

-- Where beside the door (one side or the other, nearer or further): where the least is in the way (the room's own walls
-- and desks count much more than its furniture, which is only taken away) and the room's floor under all of it
local furniture = hotelRoom and hotelRoom:FindFirstChild("Assets")
local function overlap(cf, size)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { folder, LocalPlayer.Character }
	local ok, found = pcall(function() return workspace:GetPartBoundsInBox(cf, size, params) end)
	return if ok and found then found else {}
end
local holeCF, F
do
	local function holeAt(offset)
		local c = doorFloor - out * (3 + holeSize.Z / 2) + side * offset
		return CFrame.lookAt(c, c + out)
	end
	local function obstacles(hole)
		local n, seen = 0, {}
		for _, p in ipairs(overlap(hole * CFrame.new(0, 3.5, 2.5), Vector3.new(STAIR.w + 1, 6, holeSize.Z + 5))) do
			if p.CanCollide and p.Transparency < 0.99 then
				local thing = p:FindFirstAncestorWhichIsA("Model")
				if furniture and thing and thing:IsDescendantOf(furniture) then
					if not seen[thing] then n += 1 end
					seen[thing] = true
				else
					n += 10
				end
			end
		end
		for _, c in ipairs({ { -1, -1 }, { -1, 1 }, { 1, -1 }, { 1, 1 } }) do
			local at = hole * Vector3.new(c[1] * STAIR.w / 2, 0, c[2] * holeSize.Z / 2)
			local hit = cast(at + up * 2, Vector3.new(0, -4, 0), furniture)
			if not hit or math.abs(hit.Position.Y - doorFloor.Y) > 0.6 then n += 100 end
		end
		return n
	end
	local fewest = math.huge
	for _, offset in ipairs({ 7.5, -7.5, 9.5, -9.5 }) do
		local hole = holeAt(offset)
		local n = obstacles(hole)
		if n < fewest then holeCF, fewest = hole, n end
	end
	local middle = holeCF.Position - up * DEPTH + out * ((HOLE.z0 + HOLE.z1) / 2)
	F = CFrame.lookAt(middle, middle + out)
end
local function L(x, y, z) return F * CFrame.new(x, y, z) end
local function P(x, y, z) return (F * CFrame.new(x, y, z)).Position end
local RIGHT, AHEAD = F.RightVector, F.LookVector -- (+x, and -z: the way on)

