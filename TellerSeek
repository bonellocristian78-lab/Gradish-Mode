local function body()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return character, humanoid, root
end
-- How high your root is over the floor, standing
local function hipOf(humanoid, root)
	local legs = if humanoid and humanoid.RigType == Enum.HumanoidRigType.R6 then 2 else (humanoid and humanoid.HipHeight or 2)
	return root.Size.Y / 2 + legs
end
-- A crucifix in your hand (yours, the mod's, the game's: a Tool called Crucifix or tagged so)
local function heldCrucifix()
	local character = LocalPlayer.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	if not tool then return nil end
	if tool.Name == "Crucifix" then return tool end
	local ok, tagged = pcall(function() return tool:HasTag("Crucifix") end)
	return if ok and tagged then tool else nil
end
local function floorUnder(at, character)
	probe.FilterDescendantsInstances = { folder, character }
	local hit = workspace:Raycast(at + UP * 2, Vector3.new(0, -14, 0), probe)
	return if hit then hit.Position.Y else nil
end

---====== ITS OTHER SCENES: your camera taken, you held still, black bars; `step(s, t, dt)` every frame ======---

local scene = nil -- (the one playing)
local function frameIn(parent, name, color, z)
	return make("Frame", { Name = name, BackgroundColor3 = color, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = z }, parent)
end
local function giveBackScene(s)
	if s.given then return end
	s.given = true
	s.camera.CameraType = s.saved.type
	s.camera.CameraSubject = s.saved.subject
	s.camera.FieldOfView = s.saved.fov
	if s.hrp.Parent then s.hrp.Anchored = s.saved.anchored end
end
local function endScene(s, leaving)
	if s.done then return end
	s.done, s.leaving = true, leaving == true
	pcall(function() RunService:UnbindFromRenderStep("TellerSeek" .. s.name) end)
	giveBackScene(s)
	for _, loop in pairs(s.loops) do pcall(function() loop:Destroy() end) end
	s.gui:Destroy()
	s.grade:Destroy()
	if scene == s then scene = nil end
	if s.onEnd then
		local ok, err = pcall(s.onEnd, s)
		if not ok then warn("[TellerSeek] " .. tostring(err)) end
	end
end
local function startScene(name, length, step)
	local character, humanoid, hrp = body()
	local camera = workspace.CurrentCamera
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not (hrp and camera and playerGui) then return nil end
	local s = { name = name, t = 0, length = length, hrp = hrp, humanoid = humanoid, character = character, camera = camera, kick = 0, loops = {},
		saved = { type = camera.CameraType, subject = camera.CameraSubject, fov = camera.FieldOfView, cframe = camera.CFrame, anchored = hrp.Anchored } }
	s.gui = make("ScreenGui", { Name = "TellerSeek" .. name, IgnoreGuiInset = true, DisplayOrder = 99999, ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, playerGui)
	s.bars = { frameIn(s.gui, "Bar", BLACK, 8), frameIn(s.gui, "Bar", BLACK, 8) }
	s.bars[2].AnchorPoint, s.bars[2].Position = Vector2.new(0, 1), UDim2.fromScale(0, 1)
	for _, bar in ipairs(s.bars) do bar.BackgroundTransparency, bar.Size = 0, UDim2.fromScale(1, 0) end
	s.dark = frameIn(s.gui, "Dark", BLACK, 7)
	s.hurt = frameIn(s.gui, "Hurt", Color3.fromRGB(160, 0, 0), 6)
	s.flash = frameIn(s.gui, "Flash", WHITE, 9)
	s.grade = make("ColorCorrectionEffect", { Name = "TellerSeekGrade" }, Lighting)
	hrp.Anchored = true
	camera.CameraType = Enum.CameraType.Scriptable
	scene = s
	RunService:BindToRenderStep("TellerSeek" .. name, Enum.RenderPriority.Last.Value + 2, function(dt)
		if s.done then return end
		dt = math.min(dt, 0.1)
		s.t += dt
		local bars = ease(span(s.t, 0, 0.6)) * (1 - ease(span(s.t, s.length - 0.6, s.length)))
		for _, bar in ipairs(s.bars) do bar.Size = UDim2.fromScale(1, 0.11 * bars) end
		s.kick = math.max(s.kick - dt * 1.8, 0)
		local ok, err = pcall(step, s, s.t, dt)
		if not ok then -- (never your camera stuck: it ends here)
			warn("[TellerSeek] " .. tostring(err))
			s.over = true
		end
		if s.over or s.t >= s.length then endScene(s) end
	end)
	return s
end
-- The camera there, shaken by the scene's jolts
local function shoot(s, cf, fov, extra)
	local amp = s.kick + (extra or 0)
	local t = s.t
	s.camera.CFrame = cf * CFrame.Angles(wobble(t * 23, 1) * 0.02 * amp, wobble(t * 21, 2) * 0.02 * amp, wobble(t * 17, 3) * 0.015 * amp)
	s.camera.FieldOfView = fov
end
-- Your body seen (from outside) or not (your own eyes: your head and what is on it out of the way)
local function showBody(character, outside)
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") then
			local onHead = d.Name == "Head" or d:FindFirstAncestorWhichIsA("Accessory") ~= nil
			d.LocalTransparencyModifier = if outside or not onHead then 0 else 1
		end
	end
end

---====== AFTER YOU: it rolls your steps (every stud you move a crumb, from crumb to crumb) ======---

local CHASE = { Slower = 1.5, Still = 3, Rush = 6, RushFrom = 45, RushTo = 16, Catch = 4.2, Lose = 4 }

function Chase.start(tl)
	local _, _, root = body()
	if not root then
		melt(tl)
		return
	end
	tl.mode, tl.chaseT, tl.hidden, tl.rushing = "chase", 0, 0, false
	tl.crumbs, tl.cursor = {}, 1
	tl.position = (tl.floor or tl.at * CFrame.new(0, -REST.height, 0)).Position
	tl.facing = flat(tl.at.LookVector)
	tl.music = sound("Chase", 0.6, 1, true)
	tl.squeak = sound("Squeak", 0.8, 1.3, true, tl.root)
	sound("Screech", 1, 0.9, false, tl.root)
	kick(tl, "UpperTorso", 300, 0, 0)
	kick(tl, "Head", 450, 0, 0)
end
local function pathLength(tl, target)
	local total, last = 0, tl.position
	for i = tl.cursor, #tl.crumbs do
		total += (tl.crumbs[i] - last).Magnitude
		last = tl.crumbs[i]
	end
	return total + (target - last).Magnitude
end
function Chase.step(tl, dt)
	local character, humanoid, root = body()
	if not root or not humanoid or humanoid.Health <= 0 then
		melt(tl)
		return
	end
	tl.chaseT += dt
	local feet = root.Position - UP * hipOf(humanoid, root)
	local last = tl.crumbs[#tl.crumbs]
	if not last or (feet - last).Magnitude > 1 then table.insert(tl.crumbs, feet) end
	if tl.cursor > 200 then -- (forget the steps it has already rolled)
		tl.crumbs = table.move(tl.crumbs, tl.cursor, #tl.crumbs, 1, {})
		tl.cursor = 1
	end
	-- Hidden: it rolls to where it lost you, looks round, and gives up
	local hiding = character:GetAttribute("Hiding") == true
	tl.hidden = if hiding then tl.hidden + dt else 0
	local distance = pathLength(tl, feet)
	if tl.hidden > CHASE.Lose or distance > FAR then
		melt(tl)
		return
	end
	-- As fast as you, a little slower (slower still while you stand still); faster when it is far behind
	local yours = humanoid.WalkSpeed
	if not tl.rushing and distance > CHASE.RushFrom then
		tl.rushing = true
		sound("Screech", 0.8, 1.15, false, tl.root)
	elseif tl.rushing and distance < CHASE.RushTo then
		tl.rushing = false
	end
	local moving = humanoid.MoveDirection.Magnitude > 0.1
	local speed = if hiding then 5 elseif tl.rushing then yours + CHASE.Rush elseif moving then yours - CHASE.Slower else yours - CHASE.Still
	local budget = math.max(speed, 5) * dt
	local facing = nil
	while budget > 0 do
		local target = tl.crumbs[tl.cursor]
		if not target then break end
		local step = target - tl.position
		if step.Magnitude <= budget then
			tl.position, budget, tl.cursor = target, budget - step.Magnitude, tl.cursor + 1
		else
			tl.position, budget = tl.position + step.Unit * budget, 0
		end
		if step.Magnitude > 0.05 then facing = step end
	end
	local f = facing and facing * Vector3.new(1, 0, 1)
	if f and f.Magnitude > 0.05 then
		local turn = math.min(dt * 8, 1)
		local mixed = tl.facing * (1 - turn) + f.Unit * turn
		if mixed.Magnitude > 1e-3 then tl.facing = mixed.Unit end
	end
	tl.floor = CFrame.lookAt(tl.position, tl.position + tl.facing)
	tl.at = tl.floor + UP * REST.height
	-- How it looks: bent into its run, its hand out, its hands reaching for you, its eye on you, its holepunch snapping
	tl.target, tl.stiff, tl.damp = POSES.chase, 7, 0.5
	tl.shake = if hiding then 0.3 elseif tl.rushing then 0.18 else 0.05
	tl.look, tl.lookAmount = root.Position + UP * 1.5, 1
	tl.wild, tl.reach, tl.reachAt = 1.25, 0.25, root.Position
	tl.screenMode, tl.eyeOpen, tl.glitch, tl.lightLevel, tl.pupil = "eye", 1, 0.02, 1, if distance < 15 then 1.2 else 1
	local period = lerp(0.45, 1.1, math.clamp(distance / 50, 0, 1)) -- (its heart, faster as it gets you)
	tl.beat = math.max(0, math.sin(tl.clock * math.pi / period)) ^ 8
	if tl.clock - tl.clickAt > 0.6 then
		tl.clickAt = tl.clock
		sound("Punch", 0.5, 1, false, tl.root)
	end
	if tl.music then tl.music.Volume = lerp(0.7, 0.3, math.clamp(distance / 60, 0, 1)) end
	if tl.squeak then tl.squeak.PlaybackSpeed = 0.8 + math.max(speed, 5) / 30 end
	-- It has you (unless you are hidden): a crucifix in your hand takes it; else it pretends to help you
	local gap = root.Position - (tl.position + UP * hipOf(humanoid, root))
	if Vector3.new(gap.X, 0, gap.Z).Magnitude < CHASE.Catch and math.abs(gap.Y) < 6 and not hiding then
		hush(tl)
		local tool = heldCrucifix()
		if tool then Cross.play(tl, tool) else Catch.play(tl) end
	end
end

