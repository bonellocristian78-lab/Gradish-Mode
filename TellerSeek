-- The crucifix in the air: a copy of the one in your hand, glowing; turned upright (its longest side up, its thinnest to it)
local function floatingCross(tool, stage)
	local model = make("Model", { Name = "TellerCrucifix" })
	pcall(function()
		tool.Archivable = true
		for _, d in ipairs(tool:GetDescendants()) do pcall(function() d.Archivable = true end) end
		local copy = tool:Clone()
		for _, child in ipairs(copy:GetChildren()) do child.Parent = model end
		copy:Destroy()
	end)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Sound") or d:IsA("LuaSourceContainer") or d:IsA("TouchTransmitter") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch = true, false, false, false
		end
	end
	local core = model:FindFirstChild("Handle") or model:FindFirstChildWhichIsA("BasePart", true)
	if not core then -- (two planks of wood)
		local wood = Color3.fromRGB(92, 64, 42)
		core = make("Part", { Name = "Handle", Size = Vector3.new(0.22, 1.7, 0.22), Color = wood, Material = Enum.Material.Wood, Anchored = true,
			CanCollide = false, CanQuery = false }, model)
		make("Part", { Name = "Crossbar", Size = Vector3.new(0.95, 0.22, 0.22), Color = wood, Material = Enum.Material.Wood, Anchored = true,
			CanCollide = false, CanQuery = false, CFrame = CFrame.new(0, 0.42, 0) }, model)
	end
	model.PrimaryPart = core
	make("PointLight", { Color = LIGHT, Brightness = 3, Range = 14 }, core)
	make("Highlight", { FillColor = LIGHT, OutlineColor = WHITE, FillTransparency = 0.45, OutlineTransparency = 0.2 }, model)
	make("ParticleEmitter", { Name = "Shine", Texture = IMG.Spark, Rate = 25, Lifetime = NumberRange.new(0.4, 0.9), Speed = NumberRange.new(0.5, 2),
		LightEmission = 1, Size = NumberSequence.new(0.35, 0), Color = ColorSequence.new(LIGHT), SpreadAngle = Vector2.new(180, 180) }, core)
	local box, size = model:GetBoundingBox()
	local axes = { { v = box.RightVector, s = size.X }, { v = box.UpVector, s = size.Y }, { v = box.LookVector, s = size.Z } }
	table.sort(axes, function(a, b) return a.s > b.s end)
	local pivot = model:GetPivot()
	local long, thin = pivot:VectorToObjectSpace(axes[1].v), pivot:VectorToObjectSpace(axes[3].v)
	if pivot:VectorToWorldSpace(long).Y < 0 then long = -long end
	local shape = CFrame.fromMatrix(Vector3.new(), long, thin, long:Cross(thin)):Inverse()
	model.Parent = stage
	return model, core, function(at, toward) -- (upright at `at`, facing `toward`)
		local side = UP:Cross(toward)
		return CFrame.fromMatrix(at, UP, toward, if side.Magnitude > 1e-3 then side.Unit else Vector3.new(1, 0, 0)) * shape
	end
end

-- One of Guiding Light's knives: its blade along its -z, its point first
local function newKnife(stage)
	local m = make("Model", { Name = "GuidingKnife" }, stage)
	local function piece(name, class, size, color, material, offset)
		local p = make(class, { Name = name, Size = size, Color = color, Material = material, Reflectance = if material == Enum.Material.Metal then 0.35 else 0,
			Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Transparency = 1 }, m)
		return { p, offset }
	end
	local steel = Color3.fromRGB(210, 216, 226)
	local k = { model = m, pieces = {
		piece("Blade", "Part", Vector3.new(0.05, 0.24, 1.2), steel, Enum.Material.Metal, CFrame.new(0, 0, -0.6)),
		piece("Point", "WedgePart", Vector3.new(0.05, 0.24, 0.36), steel, Enum.Material.Metal, CFrame.new(0, 0, -1.38)),
		piece("Guard", "Part", Vector3.new(0.12, 0.44, 0.08), Color3.fromRGB(60, 58, 64), Enum.Material.Metal, CFrame.new()),
		piece("Grip", "Part", Vector3.new(0.13, 0.17, 0.62), Color3.fromRGB(70, 44, 30), Enum.Material.Wood, CFrame.new(0, 0, 0.35)),
	} }
	local blade = k.pieces[1][1]
	k.light = make("PointLight", { Color = LIGHT, Brightness = 0, Range = 7 }, blade)
	k.trail = make("Trail", { Attachment0 = make("Attachment", { Position = Vector3.new(0, 0, 0.6) }, blade),
		Attachment1 = make("Attachment", { Position = Vector3.new(0, 0, -0.6) }, blade), Color = ColorSequence.new(LIGHT), LightEmission = 1,
		Lifetime = 0.18, Transparency = NumberSequence.new(0.2, 1), FaceCamera = true, Enabled = false }, blade)
	return k
end
local function placeKnife(k, cf, alpha)
	for _, p in ipairs(k.pieces) do
		p[1].CFrame = cf * p[2]
		if alpha and p[1].Transparency ~= alpha then p[1].Transparency = alpha end
	end
end

-- The blast: everything of it thrown out, spinning, bouncing on the floor; fire, smoke, a ring of air, a scorch where it stood
local function blast(center, floorY, parts, stage)
	local hold = anchoredPart("Blast", Vector3.new(0.2, 0.2, 0.2), stage)
	hold.CFrame = CFrame.new(center)
	local light = make("PointLight", { Color = Color3.fromRGB(255, 170, 90), Brightness = 10, Range = 40, Shadows = false }, hold)
	make("ParticleEmitter", { Name = "Smoke", Texture = IMG.Smoke, Rate = 0, Lifetime = NumberRange.new(2, 4), Speed = NumberRange.new(6, 18),
		SpreadAngle = Vector2.new(180, 180), Drag = 2, Acceleration = Vector3.new(0, 3, 0), Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-40, 40),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 7) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new(Color3.fromRGB(46, 42, 40)) }, hold):Emit(45)
	make("ParticleEmitter", { Name = "Fire", Texture = IMG.Spark, Rate = 0, Lifetime = NumberRange.new(0.3, 0.8), Speed = NumberRange.new(25, 45),
		SpreadAngle = Vector2.new(180, 180), Drag = 3, LightEmission = 1, Size = NumberSequence.new(1.2, 0),
		Color = ColorSequence.new(Color3.fromRGB(255, 220, 140), Color3.fromRGB(255, 90, 20)) }, hold):Emit(60)
	local ring = make("Part", { Name = "Shockwave", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 1, 1), Color = Color3.fromRGB(255, 210, 160),
		Material = Enum.Material.Neon, Transparency = 0.3, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
		CFrame = CFrame.new(Vector3.new(center.X, floorY + 0.3, center.Z)) * CFrame.Angles(0, 0, math.pi / 2) }, stage)
	local scorch = anchoredPart("Scorch", Vector3.new(8, 0.05, 8))
	scorch.CFrame = CFrame.new(Vector3.new(center.X, floorY + 0.03, center.Z))
	make("Decal", { Name = "Burnt", Texture = IMG.Scorch, Face = Enum.NormalId.Top }, scorch)
	task.delay(30, function() scorch:Destroy() end)
	local bits = {}
	for _, p in ipairs(parts) do
		local away = p.Position - center + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2
		if away.Magnitude < 1e-3 then away = UP end
		table.insert(bits, { part = p, v = away.Unit * (18 + math.random() * 22) + UP * (10 + math.random() * 15),
			spin = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 18, alpha = p.Transparency })
	end
	local b = { hold = hold, light = light, ring = ring, bits = bits, floorY = floorY, t = 0 }
	function b.step(dt)
		b.t += dt
		light.Brightness = 10 * math.max(0, 1 - b.t / 0.7)
		local r = 16 * out3(span(b.t, 0, 0.45))
		ring.Size = Vector3.new(0.2, r * 2 + 0.1, r * 2 + 0.1)
		ring.Transparency = lerp(0.3, 1, span(b.t, 0.1, 0.5))
		for _, bit in ipairs(bits) do
			local p = bit.part
			bit.v -= UP * 55 * dt
			local cf = (p.CFrame + bit.v * dt) * CFrame.Angles(bit.spin.X * dt, bit.spin.Y * dt, bit.spin.Z * dt)
			local low = floorY + math.min(p.Size.Y, 0.6) / 2
			if cf.Position.Y < low then
				cf = cf + UP * (low - cf.Position.Y)
				bit.v = Vector3.new(bit.v.X * 0.6, math.abs(bit.v.Y) * 0.3, bit.v.Z * 0.6)
				bit.spin *= 0.5
			end
			p.CFrame = cf
			if b.t > 2 then p.Transparency = lerp(bit.alpha, 1, span(b.t, 2, 3)) end
		end
	end
	return b
end

function Cross.play(tl, tool)
	local character, humanoid, root = body()
	if not root then
		melt(tl)
		return
	end
	tl.mode = "scene"
	local towards = flat(tl.at.Position - root.Position) -- (you to it)
	local away, right = -towards, towards:Cross(UP)
	-- Room for it: dragged back from you by the chain, as far as the room lets it (7 studs at most)
	probe.FilterDescendantsInstances = { folder, character }
	local wall = workspace:Raycast(root.Position, towards * 9, probe)
	local distance = if wall then math.clamp((wall.Position - root.Position).Magnitude - 2, 4.5, 7) else 7
	local myFloor = floorUnder(root.Position, character) or (root.Position.Y - hipOf(humanoid, root))
	local spot = Vector3.new(root.Position.X, myFloor, root.Position.Z) + towards * distance
	spot = Vector3.new(spot.X, floorUnder(spot, character) or myFloor, spot.Z)
	local tellerFrom, tellerTo = tl.at, CFrame.lookAt(spot, spot - towards) + UP * REST.height
	local standing = root.CFrame
	local head = character:FindFirstChild("Head")
	local headUp = if head then math.max(standing:PointToObjectSpace(head.Position).Y, 1) else 1.5
	local eyes0 = standing.Position + UP * (headUp + 0.15)
	local proneAt = Vector3.new(root.Position.X, myFloor, root.Position.Z) + away * 1.6 + UP * 0.55
	local prone = CFrame.lookAt(proneAt, proneAt - UP, away)

	-- Yours, out of your hand (seen no more there; the mod's is used up), up between you and it
	local hidden = {}
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(hidden, d)
			d.LocalTransparencyModifier = 1
		end
	end
	local stage = make("Folder", { Name = "TellerCross" }, folder) -- (all of the scene's own: gone with it)
	local cross, core, upright = floatingCross(tool, stage)
	local crossFrom = cross:GetPivot()
	local crossAbove = root.Position:Lerp(spot, 0.3) + UP * 4.6

	-- The ring of light under it, the chains (one from the crucifix, four out of the ring)
	local ring = anchoredPart("Ring", Vector3.new(7, 0.05, 7), stage)
	ring.CFrame = CFrame.new(spot + UP * 0.05)
	local ringImage = make("ImageLabel", { Name = "Circle", Image = IMG.Circle, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ImageTransparency = 1 },
		make("SurfaceGui", { Name = "Circle", Face = Enum.NormalId.Top, LightInfluence = 0, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
			PixelsPerStud = 40 }, ring))
	local chains = {}
	local function chain(from, part, offset, at)
		local tip = anchoredPart("ChainTip", Vector3.new(0.2, 0.2, 0.2), stage)
		local beam = make("Beam", { Name = "Chain", Attachment0 = from, Attachment1 = make("Attachment", { Name = "Tip" }, tip), Texture = CHAIN,
			TextureMode = Enum.TextureMode.Static, TextureLength = 1, TextureSpeed = -2, Width0 = 0.8, Width1 = 0.6, FaceCamera = true, Segments = 10,
			LightEmission = 1, LightInfluence = 0, Color = ColorSequence.new(LIGHT), Transparency = NumberSequence.new(0), Enabled = false }, from.Parent)
		table.insert(chains, { from = from, tip = tip, beam = beam, part = part, offset = offset, at = at })
	end
	chain(make("Attachment", { Name = "ChainFrom" }, core), tl.byName.UpperTorso, CFrame.new(0, 0.3, -0.5), 0.15)
	for i, spec in ipairs({ { "LeftUpperArm", -1, 1.8 }, { "RightUpperArm", 1, 1.95 }, { "LowerTorso", -0.4, 2.1 }, { "LowerTorso", 0.4, 2.25 } }) do
		local angle = (i - 0.5) / 4 * math.pi * 2
		local base = anchoredPart("ChainRoot", Vector3.new(0.2, 0.2, 0.2), stage)
		base.CFrame = CFrame.new(spot + Vector3.new(math.cos(angle), 0, math.sin(angle)) * 3.2 + UP * 0.1)
		chain(make("Attachment", { Name = "ChainFrom" }, base), tl.byName[spec[1]], CFrame.new(spec[2] * 0.3, 0, 0), spec[3])
	end

	-- Guiding Light: a light above it, that throws
	local orbAt = spot + UP * 10.5 + away * 1.2
	local orb = make("Part", { Name = "GuidingLight", Shape = Enum.PartType.Ball, Size = Vector3.new(1.3, 1.3, 1.3), Color = LIGHT, Material = Enum.Material.Neon,
		Transparency = 1, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, CFrame = CFrame.new(orbAt + UP * 4) }, stage)
	local glow = make("ImageLabel", { Name = "Glow", Image = IMG.GuidingGlow, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ImageTransparency = 1 },
		make("BillboardGui", { Name = "Glow", Size = UDim2.fromScale(9, 9), LightInfluence = 0 }, orb))
	local orbLight = make("PointLight", { Color = LIGHT, Brightness = 0, Range = 22 }, orb)
	local hum = nil

	-- The knives: one for its screen, one for every eye of Seek's on it
	local knives = {}
	local function addKnife(target, from, launch, part, point)
		local k = newKnife(stage)
		k.target, k.from, k.launch, k.part, k.point = target, from, launch, part, point
		table.insert(knives, k)
		return k
	end
	local screen = tl.screen.part
	addKnife("screen", 4.0, 5.3, screen, function() return screen.CFrame:PointToWorldSpace(Vector3.new(0.07, 0.03, -0.05)) end)
	local live = {}
	for _, e in ipairs(tl.eyes) do
		if not e.dead then table.insert(live, e) end
	end
	for i, e in ipairs(live) do
		local anchor = tl.byName[e.spec[1]]
		addKnife(e, 5.8, 6.3 + (i - 1) * 0.14, anchor, function() return (eyeAt(tl, e) * CFrame.new(0, 0, -0.06)).Position end)
	end
	-- Its beeps: faster and faster, till it goes
	local beeps, gap, at = {}, 0.62, 8.3
	while at < 10.95 do
		table.insert(beeps, at)
		at += gap
		gap = math.max(gap * 0.83, 0.07)
	end
	local nextBeep, lastBeep, boom = 1, -9, nil
	local cues = {
		{ 0, function()
			idSound(CRUCIFIX_SOUND, 1.2)
			sound("Holy", 0.5)
		end },
		{ 0.4, function() idSound(SLAM, 0.5, 1.4) end },
		{ 1.95, function() idSound(SLAM, 0.6, 1.2) end },
		{ 3.0, function()
			sound("Holy", 0.9)
			hum = sound("Hum", 0.5, 1, true)
		end },
		{ 8.0, function()
			if hum then hum:Destroy() end
		end },
	}
	local nextCue = 1
	local s = startScene("Cross", 14.2, function(s, t, dt)
		while cues[nextCue] and cues[nextCue][1] <= t do
			nextCue += 1
			cues[nextCue - 1][2]()
		end
		if s.danger then -- (Rush, Ambush...: it ends at once, and it is gone)
			s.over = true
			return
		end
		-- The Teller: dragged back, lifted, held in its chains, fighting them; jolted by each knife; shaking as it beeps
		local lift = 1.2 * ease(span(t, 2, 3))
		tl.at = tellerFrom:Lerp(tellerTo, ease(span(t, 0.15, 1))) + UP * lift
		tl.floor = tellerTo * CFrame.new(0, -REST.height, 0)
		tl.target, tl.stiff, tl.fits = POSES.held, 9, { POSES.heldA, POSES.heldB }
		tl.shake = if t < 8.3 then 0.4 else lerp(0.3, 1, span(t, 8.3, 11))
		tl.wild, tl.reach, tl.armScale = if t < 8.3 then 1.4 else 2, 0, 1
		tl.look, tl.lookAmount = orb.Position, if t > 3 and t < 8 then 0.5 else 0
		tl.lightLevel = 1
		tl.screenMode = if t >= 8.3 then "warn" else "eye"
		tl.eyeOpen = if tl.stabbed then 0.3 + 0.25 * math.random() else 1
		tl.glitch = if tl.stabbed and t < 8.3 then 0.35 else 0.05
		tl.cracks = 1
		while beeps[nextBeep] and beeps[nextBeep] <= t do
			lastBeep, nextBeep = beeps[nextBeep], nextBeep + 1
			sound("Beep", 0.9, 1, false, tl.root)
			kick(tl, "Head", 120, 0, (math.random() - 0.5) * 200)
		end
		tl.flash = math.exp(-math.max(t - lastBeep, 0) * 8)
		tl.countText = if t < 9.3 then "3" elseif t < 10.2 then "2" else "1"
		if not boom then stepTeller(tl, dt) end

		-- Its chains: each flies out to it and holds on
		for _, c in ipairs(chains) do
			local fly = ease(span(t, c.at, c.at + 0.25))
			c.beam.Enabled = fly > 0 and not boom
			local to = (c.part.CFrame * c.offset).Position
			c.tip.CFrame = CFrame.new(c.from.WorldPosition:Lerp(to, fly))
		end
		ringImage.ImageTransparency = if boom then 1 else 1 - 0.85 * ease(span(t, 0.3, 1.5))
		ring.CFrame = CFrame.new(spot + UP * 0.05) * CFrame.Angles(0, t * 0.6, 0)

		-- The crucifix: from your hand up between you, turned to it
		local u = ease(span(t, 0, 0.9))
		local above = crossAbove + UP * math.sin(t * 2) * 0.15
		cross:PivotTo(crossFrom:Lerp(upright(above, towards), u))

		-- Guiding Light: comes down, glows, and fades once it is done
		local come = ease(span(t, 3, 3.8))
		local fade = 1 - ease(span(t, 8, 9))
		orb.CFrame = CFrame.new(orbAt + UP * 4 * (1 - come) + UP * 5 * (1 - fade) + UP * math.sin(t * 1.7) * 0.2) -- (down, and up again as it goes)
		orb.Transparency = 1 - 0.85 * come * fade
		glow.ImageTransparency = 1 - come * fade
		orbLight.Brightness = 3 * come * fade

		-- The knives: out of its light, aimed, drawn back (shaking with the strength of it), thrown; in what they hit
		for i, k in ipairs(knives) do
			if t >= k.from and not k.stuck then
				local target = k.point()
				local around = if k.target == "screen" then orbAt + right * 0.8 else orbAt + CFrame.Angles(0, (i - 1) / math.max(#knives - 1, 1) * math.pi * 2, 0):VectorToWorldSpace(right * 1.8)
				local aim = (target - around).Unit
				if t < k.launch then
					local draw = ease(span(t, k.from + 0.3, k.launch)) * (if k.target == "screen" then 1.4 else 0.6)
					local shiver = (if k.target == "screen" then 0.06 else 0.02) * span(t, k.from + 0.3, k.launch)
					local pos = around - aim * draw + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * shiver
					placeKnife(k, CFrame.lookAt(pos, target), 1 - ease(span(t, k.from, k.from + 0.3)))
					k.light.Brightness = 1 + 3 * draw
				else
					local flight = if k.target == "screen" then 0.13 else 0.1
					local f = span(t, k.launch, k.launch + flight)
					k.trail.Enabled = true
					if not k.thrown then
						k.thrown, k.start = true, around - aim * (if k.target == "screen" then 1.4 else 0.6)
						sound("Throw", if k.target == "screen" then 1 else 0.6, 0.9 + math.random() * 0.3)
					end
					local stop = target + (target - k.start).Unit * 0.45 -- (its point in)
					placeKnife(k, CFrame.lookAt(k.start:Lerp(stop, f), stop + (stop - k.start)), 0)
					if f >= 1 then
						k.stuck, k.trail.Enabled = true, false
						k.offset = k.part.CFrame:ToObjectSpace(CFrame.lookAt(stop, stop + (stop - k.start)))
						sound("Stab", if k.target == "screen" then 1 else 0.6, 0.9 + math.random() * 0.4)
						if k.target == "screen" then
							tl.stabbed = true
							s.kick += 1.3
							kick(tl, "Head", 700, 0, 300)
							kick(tl, "UpperTorso", 300, 0, 0)
							make("ParticleEmitter", { Name = "Sparks", Texture = IMG.Spark, Rate = 0, Lifetime = NumberRange.new(0.2, 0.5),
								Speed = NumberRange.new(10, 22), SpreadAngle = Vector2.new(60, 60), LightEmission = 1, Size = NumberSequence.new(0.4, 0),
								Acceleration = Vector3.new(0, -30, 0), Color = ColorSequence.new(Color3.fromRGB(255, 240, 200)) }, screen):Emit(30)
						else
							killEye(k.target)
							s.kick += 0.25
							kick(tl, k.target.spec[1] == "Head" and "Head" or "UpperTorso", 160, (math.random() - 0.5) * 200, 0)
						end
					end
				end
			end
			if k.stuck and not boom then placeKnife(k, k.part.CFrame * k.offset) end
		end

		-- It blows up
		if t >= 11 and not boom then
			local parts = {}
			for _, d in ipairs(tl.model:GetDescendants()) do
				if d:IsA("BasePart") and d.Transparency < 1 and d ~= tl.goo then table.insert(parts, d) end -- (its puddle stays on the floor)
			end
			for _, k in ipairs(knives) do
				for _, p in ipairs(k.pieces) do table.insert(parts, p[1]) end
			end
			boom = blast(tl.byName.UpperTorso.Position, spot.Y, parts, stage)
			cross:Destroy()
			sound("Boom", 1)
			sound("Flash", 0.6)
			s.kick += 2.2
			s.flash.BackgroundTransparency = 0
			tl.light.Enabled = false
		end
		if boom then
			boom.step(dt)
			s.flash.BackgroundTransparency = span(t, 11.05, 11.6)
		end

		-- You: you watch it; then you turn your back and throw yourself down; you lie there till it is over; you get up
		local cf, fov = nil, 70
		if t < 9.4 then
			root.CFrame = CFrame.lookAt(standing.Position, standing.Position + towards)
		elseif t < 9.9 then
			root.CFrame = CFrame.lookAt(standing.Position, standing.Position + CFrame.Angles(0, math.pi * ease(span(t, 9.4, 9.9)), 0):VectorToWorldSpace(towards))
		elseif t < 12.6 then
			root.CFrame = CFrame.lookAt(standing.Position, standing.Position + away):Lerp(prone, ease(span(t, 9.9, 10.4)))
		else
			root.CFrame = prone:Lerp(CFrame.lookAt(standing.Position, standing.Position + towards), ease(span(t, 12.6, 13.6)))
		end
		local chest = tl.byName.UpperTorso.Position
		local lyingEyes = proneAt + away * headUp + UP * 0.35
		if t < 2 then
			local look = CFrame.lookAt(eyes0, chest)
			cf, fov = if t < 0.6 then s.saved.cframe:Lerp(look, ease(span(t, 0, 0.6))) else look, lerp(70, 60, span(t, 0, 2))
		elseif t < 4 then
			cf, fov = CFrame.lookAt(spot + right * 7 + UP * 3 - towards * 1, spot + UP * 4.2), 60
		elseif t < 5.3 then -- (from the side: Guiding Light above, its knife drawn back, its screen below)
			cf, fov = CFrame.lookAt(spot + right * 4.8 + UP * 5.5 + away * 1.5, (orbAt + screen.Position) / 2), 60
		elseif t < 5.9 then -- (at its face, as the knife goes in)
			cf, fov = CFrame.lookAt(tl.at:PointToWorldSpace(Vector3.new(1.5, REST.head.Y + 0.3, REST.head.Z - 3.2)), screen.Position), 50
		elseif t < 8.1 then
			cf, fov = CFrame.lookAt(eyes0 + right * 2.2 - towards * 0.5, chest + UP * 0.6), 68
		elseif t < 9.4 then -- (in front of its face, closer and closer to its beeping screen)
			cf, fov = CFrame.lookAt(tl.at:PointToWorldSpace(Vector3.new(0.2, REST.head.Y, REST.head.Z - lerp(4.5, 2.2, span(t, 8.1, 9.4)))), screen.Position), 50
		elseif t < 9.9 then -- (you turn)
			local yaw = math.pi * ease(span(t, 9.4, 9.9))
			cf = CFrame.lookAt(eyes0, eyes0 + CFrame.Angles(0, yaw, 0):VectorToWorldSpace(towards) - UP * 0.15) * CFrame.Angles(0, 0, rad(6) * math.sin(yaw))
		elseif t < 12.6 then -- (down you go, and stay down)
			local u2 = ease(span(t, 9.9, 10.45))
			local pos = eyes0:Lerp(lyingEyes, u2)
			local pitch = -rad(35) * math.sin(math.pi * u2) - rad(8) * u2
			cf, fov = CFrame.lookAt(pos, pos + away) * CFrame.Angles(pitch, 0, rad(20) * u2), lerp(70, 78, u2)
		else -- (you get up and look back)
			local u3 = ease(span(t, 12.6, 13.8))
			local pos = lyingEyes:Lerp(eyes0, u3)
			local yaw = math.pi * u3
			cf = CFrame.lookAt(pos, pos + CFrame.Angles(0, yaw, 0):VectorToWorldSpace(away) - UP * 0.35 * u3) * CFrame.Angles(0, 0, rad(20) * (1 - u3))
		end
		shoot(s, cf, fov, if t >= 8.3 and t < 9.4 then 0.3 * span(t, 8.3, 9.4) else 0)
	end)
	if not s then
		melt(tl)
		return
	end
	s.abortable = true
	s.onEnd = function()
		if hum then hum:Destroy() end
		stage:Destroy()
		for _, d in ipairs(hidden) do pcall(function() d.LocalTransparencyModifier = 0 end) end
		if tool:GetAttribute("GradishCrucifix") then tool:Destroy() end -- (the mod's is used up; the game's own stays the game's)
		tl.model:Destroy()
		tl.mode = "gone"
		if s.leaving then return end
		achievement()
	end
end

