local function make(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do i[k] = v end
	if parent then i.Parent = parent end
	return i
end
local function span(t, a, b) return math.clamp((t - a) / (b - a), 0, 1) end
local function ease(u)
	u = math.clamp(u, 0, 1)
	return u * u * (3 - 2 * u)
end
local function out3(u)
	u = math.clamp(u, 0, 1)
	return 1 - (1 - u) ^ 3
end
local function backOut(u) -- past it, and back
	u = math.clamp(u, 0, 1) - 1
	return 1 + 3.2 * u ^ 3 + 2.2 * u ^ 2
end
local function lerp(a, b, u) return a + (b - a) * u end
local function flat(v)
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 1e-3 then f.Unit else Vector3.new(0, 0, -1)
end
local function wobble(t, seed) -- smooth, never the same twice: about -1..1
	return (math.sin(t * 1.7 + seed) + math.sin(t * 2.9 + seed * 2.3) * 0.6 + math.sin(t * 5.3 + seed * 4.1) * 0.3) / 1.9
end

