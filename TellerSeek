table.insert(connections, RunService.RenderStepped:Connect(function(dt)
	dt = math.min(dt, 0.1)
	local camera = workspace.CurrentCamera
	for i = #tellers, 1, -1 do
		local tl = tellers[i]
		if tl.mode == "gone" then
			table.remove(tellers, i)
			continue
		end
		if (film and film.tl == tl) or tl.mode == "scene" then continue end
		if tl.mode == "wait" then -- (it looks at you, its heart going; then it screams and comes)
			tl.waitT += dt
			tl.target, tl.stiff = POSES.stare, 5
			tl.look, tl.lookAmount, tl.wild = camera.CFrame.Position, 1, 0.8
			tl.screenMode, tl.eyeOpen, tl.glitch, tl.shake = "eye", 1, 0.02, 0.04
			tl.beat = math.max(0, math.sin(tl.clock * math.pi / 0.55)) ^ 8
			if tl.waitT > 1.6 then Chase.start(tl) end
		elseif tl.mode == "chase" then
			Chase.step(tl, dt)
		elseif tl.mode == "melt" then
			tl.meltT += dt
			tl.shrink = 1 - ease(span(tl.meltT, 0, 1.2)) -- (its hands and its eyes go back in first)
			tl.at = tl.base - UP * ease(span(tl.meltT, 0.6, 2.6)) * (REST.height + 5)
			tl.puddle = 8.5 * (1 - span(tl.meltT, 2.4, 3.2))
			tl.shake, tl.glitch = 0.5 * (1 - span(tl.meltT, 0, 2.6)), 0.3
			if tl.meltT > 3.2 then
				tl.model:Destroy()
				table.remove(tellers, i)
				continue
			end
		end
		if tl.mode ~= "scene" then stepTeller(tl, dt) end -- (if it just got you, its scene moves it from now on)
	end
end))

