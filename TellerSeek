local function file(dir, name, magic)
	local here = FOLDER .. "/" .. name
	pcall(function()
		if not isfolder(FOLDER) then makefolder(FOLDER) end
		if isfile(here) and readfile(here):sub(1, #magic) == magic then return end
		local data = game:HttpGet(REPO .. "assets/" .. dir .. "/" .. name)
		if type(data) == "string" and data:sub(1, #magic) == magic then writefile(here, data) end -- (never a "404: Not Found")
	end)
	local ok, there = pcall(isfile, here)
	return if ok and there then here else nil
end
local function asset(path)
	if not path then return nil end
	local ok, id = pcall(getcustomasset, path)
	return if ok and type(id) == "string" then id else nil
end
local function loadKit(dir, name)
	local id = asset(file(dir, name, "<roblox!"))
	if not id then return nil end
	local ok, objects = pcall(function() return game:GetObjects(id) end)
	return if ok and type(objects) == "table" then objects[1] else nil
end

