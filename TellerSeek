---====== WHEN: the first of Seek's eyes you can see, near you (once each time Seek's eyes come) ======---

local armed, quiet, every = true, 0, 0
local function seen(eye, hrp, camera)
	local ok, at = pcall(function() return if eye:IsA("Model") then eye:GetPivot().Position else eye.Position end)
	if not ok or (at - hrp.Position).Magnitude > NEAR then return false end
	probe.FilterDescendantsInstances = { folder, hrp.Parent, eye }
	local from = camera.CFrame.Position
	local hit = workspace:Raycast(from, at - from, probe)
	return hit == nil or (hit.Position - at).Magnitude < 4 -- (nothing between, or the wall it is on)
end
table.insert(connections, RunService.Heartbeat:Connect(function(dt)
	every += dt
	if every < 0.25 then return end
	local step = every
	every = 0
	local character = LocalPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	local count = 0
	for _, eye in ipairs(CollectionService:GetTagged("SeekEye")) do
		if eye:IsDescendantOf(workspace) and not eye:IsDescendantOf(folder) then
			count += 1
			if armed and not film and not scene and hrp and camera and seen(eye, hrp, camera) then
				armed = false
				task.spawn(play)
			end
		end
	end
	quiet = if count == 0 then quiet + step else 0
	if quiet > 8 then armed = true end -- (Seek's eyes gone: the next time they come, again)
end))

