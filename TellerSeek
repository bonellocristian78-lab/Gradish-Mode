---====== THE RIGS: each model's joints read once and taken off; every part anchored, put where its pose says every frame ======---

local function isJoint(d) return d:IsA("Motor6D") or d:IsA("Weld") or d:IsA("ManualWeld") end
local function rig(model, root)
	local edges = {}
	for _, d in ipairs(model:GetDescendants()) do
		if isJoint(d) and d.Part0 and d.Part1 then
			table.insert(edges, { a = d.Part0, b = d.Part1, c0 = d.C0, c1 = d.C1, name = d.Part1.Name, motor = d:IsA("Motor6D") })
		end
	end
	-- out from its root, each part on the one it hangs from (its motor before any weld; a weld can be either way round)
	local joints, order, placed, queue, at = {}, {}, { [root] = true }, { root }, 1
	while queue[at] do
		local p = queue[at]
		at += 1
		for pass = 1, 2 do
			for _, e in ipairs(edges) do
				if e.motor == (pass == 1) then
					local child, j = nil, nil
					if e.a == p and not placed[e.b] then
						child, j = e.b, { p0 = p, c0 = e.c0, c1inv = e.c1:Inverse(), name = e.name }
					elseif e.b == p and not placed[e.a] then
						child, j = e.a, { p0 = p, c0 = e.c1, c1inv = e.c0:Inverse(), name = "" }
					end
					if child then
						placed[child], joints[child] = true, j
						table.insert(order, child)
						table.insert(queue, child)
					end
				end
			end
		end
	end
	for _, d in ipairs(model:GetDescendants()) do
		if isJoint(d) or d:IsA("WeldConstraint") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch = true, false, false, false
		end
	end
	return { root = root, joints = joints, order = order, world = {} }
end
-- Its parts where its pose (T: a turn per joint, by its part's name) puts them; scale makes its joints longer or shorter
local function pose(r, rootCF, T, scale)
	local w = r.world
	w[r.root] = rootCF
	r.root.CFrame = rootCF
	for _, p in ipairs(r.order) do
		local j = r.joints[p]
		local c0, c1inv = j.c0, j.c1inv
		if scale and scale ~= 1 then
			c0 = c0.Rotation + c0.Position * scale
			c1inv = c1inv.Rotation + c1inv.Position * scale
		end
		local cf = w[j.p0] * c0 * (T[j.name] or ID) * c1inv
		w[p] = cf
		p.CFrame = cf
	end
end

