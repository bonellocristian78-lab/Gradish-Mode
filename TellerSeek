local BLACK, WHITE = Color3.new(0, 0, 0), Color3.new(1, 1, 1)
local function buildEye(parent, z)
	local e = {}
	e.root = make("Frame", { Name = "SeekEye", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1), SizeConstraint = Enum.SizeConstraint.RelativeYY, ZIndex = z }, parent)
	local function img(name, image, size, zi, p)
		return make("ImageLabel", { Name = name, Image = image, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5), Size = size, ZIndex = zi }, p)
	end
	-- the almond's box: the ball is seen only inside it, the socket covers its corners
	local box = make("Frame", { Name = "Opening", BackgroundColor3 = BLACK, BorderSizePixel = 0, ClipsDescendants = true, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.98, 0.5), ZIndex = 1 }, e.root)
	img("Ball", IMG.EyeBall, UDim2.fromScale(1 / 0.98, 2), 1, box)
	e.iris = img("Iris", IMG.EyeIris, UDim2.fromScale(0.42 / 0.98, 0.84), 2, box)
	e.pupil = make("Frame", { Name = "Pupil", BackgroundColor3 = BLACK, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.36, 0.36), ZIndex = 3 }, e.iris)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, e.pupil)
	local shine = make("Frame", { Name = "Shine", BackgroundColor3 = WHITE, BackgroundTransparency = 0.25, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.34, 0.3), Size = UDim2.fromScale(0.16, 0.16), ZIndex = 4 }, e.iris)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, shine)
	e.strands = img("Strands", IMG.Strands, UDim2.fromScale(0.9, 0), 5, box)
	e.upper = make("Frame", { Name = "UpperLid", BackgroundColor3 = BLACK, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.1, 0.62), ZIndex = 6 }, box)
	e.lower = make("Frame", { Name = "LowerLid", BackgroundColor3 = BLACK, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.1, 0.62), ZIndex = 6 }, box)
	local top = img("Edge", IMG.LidEdge, UDim2.fromScale(1, 0.55), 6, e.upper)
	top.AnchorPoint, top.Position = Vector2.new(0.5, 0.42), UDim2.fromScale(0.5, 1)
	local bottom = img("Edge", IMG.LidEdge, UDim2.fromScale(1, 0.55), 6, e.lower)
	bottom.AnchorPoint, bottom.Position, bottom.Rotation = Vector2.new(0.5, 0.58), UDim2.fromScale(0.5, 0), 180
	img("Socket", IMG.EyeSocket, UDim2.fromScale(1.6, 1.6), 2, e.root)
	-- open: 0 shut .. 1 wide; where it looks: -1..1 across and down; its pupil: 1 as it is, bigger or smaller
	function e.set(open, lx, ly, pupil)
		open = math.clamp(open, 0, 1)
		e.upper.Position = UDim2.fromScale(0.5, 0.5 - 0.5 * open)
		e.lower.Position = UDim2.fromScale(0.5, 0.5 + 0.5 * open)
		e.strands.Size = UDim2.fromScale(0.9, open)
		e.strands.ImageTransparency = if open < 0.02 or open > 0.85 then 1 else open / 0.85
		e.iris.Position = UDim2.fromScale(0.5 + math.clamp(lx, -1, 1) * 0.17, 0.5 + math.clamp(ly, -1, 1) * 0.16)
		local s = 0.36 * math.clamp(pupil, 0.3, 2.2)
		e.pupil.Size = UDim2.fromScale(s, s)
	end
	e.set(0, 0, 0, 1)
	return e
end

