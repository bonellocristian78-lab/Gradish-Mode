-- Its ticket, Seek's black spreading on it (both its faces)
local function newTicket()
	local part = make("Part", { Name = "Ticket", Size = Vector3.new(0.55, 0.82, 0.03), Color = Color3.fromRGB(236, 230, 212), Material = Enum.Material.SmoothPlastic,
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Transparency = 1 }, folder)
	local goo = {}
	for _, face in ipairs({ "Front", "Back" }) do
		make("Decal", { Name = "Paper", Texture = IMG.Ticket, Face = Enum.NormalId[face] }, part)
		table.insert(goo, make("Decal", { Name = "Seek", Texture = IMG.TicketGoo, Face = Enum.NormalId[face], Transparency = 1 }, part))
	end
	return part, goo
end

function Catch.play(tl)
	local character, humanoid, root = body()
	if not root then
		melt(tl)
		return
	end
	tl.mode = "scene"
	local towards = flat(tl.at.Position - root.Position) -- (you to it)
	local floorY = floorUnder(root.Position, character) or (root.Position.Y - hipOf(humanoid, root))
	local here = Vector3.new(root.Position.X, floorY, root.Position.Z)
	local standing = root.CFrame
	local head = character:FindFirstChild("Head")
	local headUp = if head then math.max(standing:PointToObjectSpace(head.Position).Y, 1) else 1.5
	local lying = CFrame.lookAt(here + UP * 0.55, here + UP * 1.55, -towards) -- (on your back, your head away from it)
	local spot = here + towards * 3.4
	local tellerFrom, tellerTo = tl.at, CFrame.lookAt(spot, spot - towards) + UP * REST.height
	local right = towards:Cross(UP)
	local ticket, ticketGoo = newTicket()
	local gloom = make("Highlight", { Name = "SeekGloom", FillColor = GOO, OutlineColor = Color3.fromRGB(70, 0, 8), FillTransparency = 1,
		OutlineTransparency = 1, DepthMode = Enum.HighlightDepthMode.Occluded }, character)
	local chest = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or root
	local drip = dripper(chest, 0)
	local edge, dropFrom = nil, nil
	local function heartbeat(volume, speed) return function() sound("Heartbeat", volume, speed) end end
	local cues = {
		{ 0, function()
			sound("Thud", 1)
			sound("Screech", 0.6, 1.2, false, tl.root)
		end },
		{ 1, function() sound("Ding", 0.8) end },
		{ 3.6, function() sound("Paper", 1) end },
		{ 4.6, function() sound("Gloom", 0.9) end },
		{ 5, heartbeat(0.8, 1) },
		{ 5.8, heartbeat(0.8, 1) },
		{ 6.4, heartbeat(0.9, 1) },
		{ 6.6, function() -- (it stops pretending)
			sound("Glitch", 0.9)
			sound("Screech", 1, 1, false, tl.root)
			kick(tl, "UpperTorso", 350, 0, 0)
			kick(tl, "Head", 500, 0, 200)
		end },
		{ 6.75, function() sound("Squelch", 1, 0.9) end },
		{ 7.3, function() sound("Squelch", 1, 0.7) end },
		{ 7.6, function() sound("Choke", 1) end },
		{ 8.4, heartbeat(1, 1) },
		{ 9.4, heartbeat(0.8, 0.92) },
		{ 10.6, heartbeat(0.65, 0.84) },
		{ 11.6, heartbeat(0.5, 0.75) },
		{ 11.85, function() sound("Stab", 0.8, 0.45) end }, -- (the snap)
	}
	local nextCue = 1
	local s = startScene("Catch", 12, function(s, t, dt)
		while cues[nextCue] and cues[nextCue][1] <= t do
			nextCue += 1
			cues[nextCue - 1][2]()
		end
		-- The Teller: at your feet; pretending (its hands back in, its eyes shut, kind words on its screen); then itself again
		tl.at = tellerFrom:Lerp(tellerTo, ease(span(t, 0, 0.6)))
		tl.floor = tl.at * CFrame.new(0, -REST.height, 0)
		local pretending = t >= 0.8 and t < 6.6
		tl.armScale = if t < 0.6 then 1 elseif t < 6.6 then 1 - ease(span(t, 0.6, 1.3)) else ease(span(t, 6.6, 7.05))
		tl.eyesShut = pretending
		tl.screenMode = if pretending then "kind" else "eye"
		tl.kindText = if t < 2.4 then "ARE YOU OK?" else "TAKE YOUR TICKET"
		tl.glitch = if t < 0.8 then 0.3 elseif pretending then 0.4 * span(t, 5.2, 6.6) else 0.05 -- (it pretends well, then it slips)
		tl.lightLevel = if pretending then 0.15 else 1
		tl.target, tl.stiff = if t < 0.8 then POSES.chase elseif t < 1.6 then POSES.kind elseif t < 3.4 then POSES.offer elseif t < 6.6 then POSES.kind
			elseif t < 7.2 then POSES.arch else POSES.grab, if t < 6.6 then 6 else 11
		tl.shake = if t >= 6.6 and t < 7.2 then 0.6 elseif t >= 7.8 then 0.06 else 0
		tl.look, tl.lookAmount = s.camera.CFrame.Position, if t >= 7.8 then 0.5 else 0.9
		tl.wild = if t >= 7.2 then 0.6 else 1
		tl.reach, tl.reachAt = if t >= 7.2 then 0.55 else 0, root.Position
		tl.pupil = if t >= 7.8 then lerp(1, 1.25, span(t, 7.8, 11.5)) else 1
		tl.beat = math.max(0, math.sin(t * math.pi / 0.5)) ^ 8
		stepTeller(tl, dt)

		-- You: knocked down; lying there; then lifted by the throat into its hand, struggling, weaker and weaker
		local hand = tl.byName.Hand.CFrame
		local neck = hand.Position - UP * (headUp - 0.6) - towards * 0.3 -- (its hand round your throat, your head above it)
		local held = CFrame.lookAt(neck, neck + towards) * CFrame.Angles(0.15, 0, 0)
		if t < 0.45 then
			root.CFrame = standing:Lerp(lying, span(t, 0, 0.45) ^ 2)
		elseif t < 7.2 then
			root.CFrame = lying * CFrame.Angles(math.sin(t * 2.4) * 0.02, 0, 0)
		else
			local fight = 0.08 * (1 - span(t, 8, 11.6))
			root.CFrame = lying:Lerp(held, ease(span(t, 7.2, 7.8))) * CFrame.Angles(wobble(t * 7, 1) * fight, wobble(t * 6, 2) * fight, wobble(t * 8, 3) * fight)
		end
		local eyes = root.CFrame * CFrame.new(0, headUp + 0.15, 0)
		local pov = CFrame.lookAt(eyes.Position, tl.byName.Head.Position) -- (where your eyes look: the ticket is held before them)

		-- Its ticket: in its hand, held out to you; then in yours; Seek's black taking it; then dropped
		if t >= 1.6 and t < 3.4 then
			ticket.Transparency = 0
			ticket.CFrame = hand * CFrame.new(-0.3, -0.15, -0.3) * CFrame.Angles(0, 0, math.rad(80))
		elseif t >= 3.4 and t < 7.2 then
			local hold = pov * CFrame.new(0.28, -0.3, -1.1) * CFrame.Angles(0.25, math.pi + 0.15, 0.08)
			local from = hand * CFrame.new(-0.3, -0.15, -0.3) * CFrame.Angles(0, 0, math.rad(80))
			ticket.CFrame = from:Lerp(hold, ease(span(t, 3.4, 4.2)))
		elseif t >= 7.2 then
			dropFrom = dropFrom or ticket.CFrame
			local u = span(t, 7.2, 7.8)
			ticket.CFrame = dropFrom:Lerp(CFrame.new(here + right * 0.6 + UP * 0.03) * CFrame.Angles(math.pi / 2, 0, 0.6), u * u)
		end
		for _, decal in ipairs(ticketGoo) do decal.Transparency = 1 - ease(span(t, 4.4, 5.8)) end

		-- Seek's black on you: on your body, dripping off you; on your sight, from its edges in; closing in as it chokes you
		gloom.FillTransparency = 1 - 0.85 * ease(span(t, 4.8, 7))
		gloom.OutlineTransparency = 1 - 0.7 * ease(span(t, 4.8, 7))
		drip.Rate = 8 * span(t, 4.8, 7)
		if t >= 4.6 and not edge then
			edge = make("ImageLabel", { Name = "Gloom", Image = IMG.GooEdge, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(2.6, 2.6), ZIndex = 5 }, s.gui)
		end
		if edge then
			local size = if t < 8 then lerp(2.6, 1.15, ease(span(t, 4.6, 7))) else lerp(1.15, 0.45, ease(span(t, 8, 11.8)))
			edge.Size = UDim2.fromScale(size * (1 + 0.03 * tl.beat), size * (1 + 0.03 * tl.beat))
		end
		s.grade.Saturation = -0.2 - 0.65 * span(t, 4.6, 7)
		s.grade.Contrast = 0.1 + 0.2 * span(t, 4.6, 7)
		s.grade.TintColor = WHITE:Lerp(Color3.fromRGB(255, 150, 150), span(t, 8, 11.5))
		s.hurt.BackgroundTransparency = if t < 0.7 then lerp(0.35, 1, span(t, 0, 0.7)) else 1 - 0.25 * span(t, 9, 11.8)
		s.dark.BackgroundTransparency = 1 - span(t, 11.8, 11.95)

		-- The camera: your eyes as you fall and lie there; from the side as it bends over you; your eyes on the ticket; from
		-- above as Seek's black takes you; your eyes again; from the side as it lifts you; your eyes, its screen, up close
		local itsHead = tl.byName.Head.Position
		local mid = (root.Position + tl.at.Position) / 2
		local cf, fov, outside = nil, 70, false
		if t < 2.2 then
			cf = CFrame.lookAt(eyes.Position, itsHead) * CFrame.Angles(0, 0, rad(12) * span(t, 0, 0.45))
		elseif t < 3.4 then
			cf, fov, outside = CFrame.lookAt(here + right * 8 + UP * 2.5 + towards * 1.7, mid + UP * 2), 55, true
		elseif t < 5.4 then
			local look = ticket.Position:Lerp(itsHead, ease(span(t, 4.6, 5.4)))
			cf = CFrame.lookAt(eyes.Position, look) * CFrame.Angles(0, 0, rad(8))
		elseif t < 6.6 then
			local turn = rad(lerp(-20, 20, span(t, 5.4, 6.6)))
			cf, fov, outside = CFrame.lookAt(here + UP * 7.5 + CFrame.Angles(0, turn, 0):VectorToWorldSpace(-towards * 0.8), here), 60, true
		elseif t < 9 then
			cf = CFrame.lookAt(eyes.Position, tl.screen.part.Position)
		elseif t < 10.4 then
			cf, fov, outside = CFrame.lookAt(hand.Position + right * 7 + UP * 1.2 - towards * 1, hand.Position - UP * 1.2), 55, true
		else
			cf, fov = CFrame.lookAt(eyes.Position, tl.screen.part.Position), lerp(70, 45, span(t, 10.4, 11.8))
		end
		showBody(character, outside)
		local struggle = if t >= 7.8 and not outside then 0.25 * (1 - span(t, 9, 11.8)) else 0
		shoot(s, cf, fov, struggle + (if t < 0.5 then 0.8 else 0))
	end)
	if not s then
		melt(tl)
		return
	end
	s.onEnd = function()
		ticket:Destroy()
		gloom:Destroy()
		drip:Destroy()
		if s.leaving then return end
		die() -- (its hand round your throat: you are gone)
		melt(tl)
	end
end

