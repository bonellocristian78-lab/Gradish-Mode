local function blend(into, a, b, u)
	for _, j in ipairs(JOINTS) do
		local p, q = a[j] or ZERO, b[j] or ZERO
		local o = into[j]
		if not o then
			o = {}
			into[j] = o
		end
		o[1], o[2], o[3] = lerp(p[1], q[1], u), lerp(p[2], q[2], u), lerp(p[3], q[3], u)
	end
	return into
end
-- A jolt to one of its joints (degrees a second): its springs take it from there
local function kick(tl, joint, x, y, z)
	local v = tl.vel[joint]
	if v then
		v[1], v[2], v[3] = v[1] + x, v[2] + y, v[3] + z
	end
end

