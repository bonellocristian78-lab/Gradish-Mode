		Size = UDim2.fromScale(1.6 * 0.86, 0.86), SizeConstraint = Enum.SizeConstraint.RelativeYY, ZIndex = 2 }, e.root)
	e.cracks = img("Cracks", IMG.TVCracks, UDim2.fromScale(1, 1), 1, e.face)
	local box = make("Frame", { Name = "Almond", BackgroundColor3 = BLACK, BorderSizePixel = 0, ClipsDescendants = true, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.31, 0.2), ZIndex = 2 }, e.face)
	make("ImageLabel", { Name = "White", Image = IMG.TVWhite, BackgroundColor3 = WHITE, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 1 }, box)
	e.pupil = make("Frame", { Name = "Pupil", BackgroundColor3 = Color3.fromRGB(6, 6, 8), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.92, 0.92), SizeConstraint = Enum.SizeConstraint.RelativeYY, ZIndex = 2 }, box)
	round(e.pupil)
	local shine = make("Frame", { Name = "Shine", BackgroundColor3 = WHITE, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.33, 0.3), Size = UDim2.fromScale(0.22, 0.22), ZIndex = 3 }, e.pupil)
	round(shine)
	e.upper, e.lower = lids(box)
	e.blob = img("Goo", IMG.TVBlob, UDim2.fromScale(1, 1), 3, e.face)
	e.broken = make("ImageLabel", { Name = "Broken", Image = IMG.ScreenCrack, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 4,
		Visible = false }, e.root)
	-- as buildEye's; and its cracks (0 none .. 1 all of them), its goo's swelling
	function e.set(open, lx, ly, pupil, cracks, swell)
		open = math.clamp(open, 0, 1)
		e.upper.Position = UDim2.fromScale(0.5, 0.5 - 0.5 * open)
		e.lower.Position = UDim2.fromScale(0.5, 0.5 + 0.5 * open)
		e.pupil.Position = UDim2.fromScale(0.5 + math.clamp(lx, -1, 1) * 0.3, 0.5 + math.clamp(ly, -1, 1) * 0.14)
		local s = 0.92 * math.clamp(pupil, 0.5, 1.25)
		e.pupil.Size = UDim2.fromScale(s, s)
		local c = math.clamp(cracks or 1, 0, 1)
		e.cracks.Size = UDim2.fromScale(lerp(0.7, 1.06, c), lerp(0.7, 1.06, c))
		e.cracks.ImageTransparency = 1 - math.min(c * 2, 1)
		local g = 0.86 * (1 + 0.04 * (swell or 0))
		e.face.Size = UDim2.fromScale(1.6 * g, g)
	end
	e.set(1, 0, 0, 1, 1, 0)
	return e
end

