		e.lower.Position = UDim2.fromScale(0.5, 0.5 + 0.5 * open)
		e.strands.Size = UDim2.fromScale(0.9, open)
		e.strands.ImageTransparency = if open < 0.02 or open > 0.85 then 1 else open / 0.85
		e.iris.Position = UDim2.fromScale(0.5 + math.clamp(lx, -1, 1) * 0.17, 0.5 + math.clamp(ly, -1, 1) * 0.16)
		local s = 0.36 * math.clamp(pupil, 0.3, 2.2)
		e.pupil.Size = UDim2.fromScale(s, s)
	end
	e.set(0, 0, 0, 1)
	return e
end

-- Its screen's eye, the way it was asked for: grey glass, Seek's rocky goo, a white almond with a big black pupil, cracks out to
-- the corners (mine: the goo drips, the white has veins, the cracks grow, the glass has lines and breaks)
local function buildTVEye(parent, z)
	local e = {}
	e.root = make("Frame", { Name = "TVEye", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = z }, parent)
	make("ImageLabel", { Name = "Glass", Image = IMG.TVBack, BackgroundColor3 = Color3.fromRGB(205, 205, 208), BorderSizePixel = 0,
