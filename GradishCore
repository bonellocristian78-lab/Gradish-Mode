--[[
================================================================================

        G R A D I S H   C O R E

        Shared engine for every Gradish entity. Each entity script becomes a
        short profile; everything below is written once and used by all of
        them.

        HOW TO USE IT

            local Core = loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/main/GradishCore"
            ))()

            Core:Spawn({ Name = "Yeller", Asset = "...", ... })

        WHAT EVERY ENTITY NOW GETS FOR FREE
        -----------------------------------
        * Four achievements instead of one: survived, died, untouched, and
          banished with a crucifix. All of the wording lives in one file,
          AchievementConfig, so nobody has to edit four scripts to change a
          title.
        * Crucifixion detection, for all of them, without hijacking the ritual.
        * Light tells that RESTORE. The old scripts tinted rooms and never put
          them back, so the colour of a dead entity stayed on the map for the
          rest of the run.
        * Closet checks, escalation, multi-pass chains and encores. See the
          MECHANICS section.

        THREE THINGS I LEARNED FROM THE SPAWNER SOURCE, WRITTEN DOWN SO NOBODY
        HAS TO REDISCOVER THEM
        ---------------------------------------------------------------------
        1. entity:Run(true) deep-copies the entity, config included, and runs
           the COPY. Anything you change on your object afterwards is ignored.
           This core uses Run(false) so live tuning actually reaches the entity
           that is moving.

        2. Movement.Speed is not the number you wrote. Create() rewrites it as
           65 / 100 * yourSpeed. So escalation multiplies the stored value; it
           never assigns a raw one.

        3. The model attribute "Running" is set to true on run and never set
           back. Re-running the same entity object silently does nothing. Each
           extra pass therefore builds a fresh entity, which is exactly why the
           old nested Rebound script worked.

        MECHANICS (all of them are world actions, none of them draw on screen)
        ---------------------------------------------------------------------
        Tell         rooms ahead shift to the entity colour before it arrives
                     and shift back when it leaves, strongest nearest you
        ClosetCheck  if you are hiding as it passes, it stops beside your
                     closet for a moment before moving on
        Linger       it reaches YOUR room and stays a few seconds before
                     carrying on, still fully able to hurt you
        Escalate     every rebound makes it faster and widens its reach
        Variance     a few percent of random speed on every spawn, so you
                     cannot count it out
        Passes       run the entity several times in one visit, N rooms apart
        Encore       a chance it turns around and comes back after despawning
        Registry     entities know about each other; two at once is its own
                     achievement, and the same entity cannot double-spawn

        Two more subsystems live here rather than on any one entity:

        Core.Crucifix   owns the crucifix model, hands one out, and can hide
                        one in the furniture on a rising-odds search
        Core.RedSeek    paints the Seek chase models red and awards you for
                        living through one

================================================================================
]]

-- One instance shared by every entity script, so they all see the same
-- registry and the achievements library is fetched once.
if getgenv and getgenv().GradishCore then
	return getgenv().GradishCore
end

---====== SERVICES ======---

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

---====== CORE ======---

local Core = {
	Version = "1.0",
	Debug   = true,

	-- Live entities, by name. Cross-script, because every entity shares this
	-- module instance.
	Active = {},

	-- Achievement identifiers already granted this session.
	Granted = {},
}

---====== DISK LOG ======---
--[[ Everything printed also goes to a file in the executor's workspace
     folder. The Roblox console cannot be read from outside the game, but a
     file on disk can, so this is what makes "send me the console output"
     unnecessary -- the log is just there afterwards.

     Written with appendfile where the executor has it, falling back to
     read-modify-write, and silently doing nothing if neither exists. ]]

local LOG_FILE = "gradish_log.txt"
local logBuffer = {}
local logFlushQueued = false

local function flushLog()
	logFlushQueued = false
	if #logBuffer == 0 then return end

	local chunk = table.concat(logBuffer, "\n") .. "\n"
	table.clear(logBuffer)

	pcall(function()
		if appendfile then
			appendfile(LOG_FILE, chunk)
		elseif writefile and isfile and readfile then
			local existing = isfile(LOG_FILE) and readfile(LOG_FILE) or ""
			writefile(LOG_FILE, existing .. chunk)
		end
	end)
end

-- Batched, because a writefile per print would stutter the game.
local function toDisk(line)
	table.insert(logBuffer, line)

	if not logFlushQueued then
		logFlushQueued = true
		task.delay(1, flushLog)
	end
end

pcall(function()
	if writefile then
		writefile(LOG_FILE, ("[Gradish] session started %s\n"):format(os.date("%Y-%m-%d %H:%M:%S")))
	end
end)

Core.LogFile = LOG_FILE
Core.FlushLog = flushLog

---====== UTIL ======---

local function log(name, format, ...)
	local line = ("[Gradish/%s] "):format(name) .. format:format(...)
	toDisk(line)

	if not Core.Debug then return end
	print(line)
end

-- For warnings, which must reach the disk even with Debug off.
local function logAlways(name, format, ...)
	local line = ("[Gradish/%s] "):format(name) .. format:format(...)
	toDisk(line)
	print(line)
end

Core.Log = logAlways

-- Runs fn, reports failure, never lets it escape. A broken cosmetic must not
-- be able to stop an entity from moving.
local function safe(name, label, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		-- Failures go to the disk log too, or the one line that explains a
		-- broken run is the one line nobody can send me.
		local line = ("[Gradish/%s] %s FAILED: %s"):format(name, label, tostring(err))
		toDisk(line)
		warn(line)
	end
	return ok
end

local function tween(instance, duration, properties)
	if typeof(instance) ~= "Instance" then return nil end
	local info = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	local ok, animation = pcall(TweenService.Create, TweenService, instance, info, properties)
	if ok and animation then
		animation:Play()
		return animation
	end
	return nil
end

local function isBlank(value)
	return value == nil or value == ""
end

local function getCharacter()
	return LocalPlayer.Character
end

local function getHumanoid()
	local character = getCharacter()
	return character and character:FindFirstChildOfClass("Humanoid") or nil
end

local function getRoot()
	local character = getCharacter()
	return character and character:FindFirstChild("HumanoidRootPart") or nil
end

local function isPlayerDead()
	local humanoid = getHumanoid()
	return humanoid == nil or humanoid.Health <= 0
end

-- The spawner reads this same attribute to decide whether you are safe, so it
-- is the authoritative answer to "am I in a closet".
local function isHiding()
	local character = getCharacter()
	if not character then return false end
	return character:GetAttribute("Hiding") == true
end

local function currentRoomNumber()
	local data = ReplicatedStorage:FindFirstChild("GameData")
	local value = data and data:FindFirstChild("LatestRoom")
	return value and tonumber(value.Value) or 0
end

local function latestRoomValue()
	local data = ReplicatedStorage:FindFirstChild("GameData")
	return data and data:FindFirstChild("LatestRoom") or nil
end

local function getCurrentRooms()
	return Workspace:FindFirstChild("CurrentRooms")
end

--[[ Janitor. Hand it connections, instances or undo functions; Clean() runs
     everything in reverse. This is what guarantees a despawned entity leaves
     no tinted lights and no listeners behind. ]]
local Janitor = {}
Janitor.__index = Janitor

function Janitor.new()
	return setmetatable({ _tasks = {} }, Janitor)
end

function Janitor:Give(item)
	table.insert(self._tasks, item)
	return item
end

function Janitor:Clean()
	for index = #self._tasks, 1, -1 do
		local item = self._tasks[index]
		self._tasks[index] = nil

		pcall(function()
			if typeof(item) == "RBXScriptConnection" then
				item:Disconnect()
			elseif typeof(item) == "Instance" then
				item:Destroy()
			elseif type(item) == "function" then
				item()
			end
		end)
	end
end

---====== ACHIEVEMENTS ======---
--[[ One library instance for the whole mod, fetched on first use. Awards are
     queued with a gap, because two popups on the same frame make the DOORS
     achievement UI overwrite itself. ]]

local Achievements = {
	library  = nil,
	loaded   = false,
	queue    = {},
	draining = false,
}

--[[ Only latch on SUCCESS.

     It used to set self.loaded = true before the fetch, so a single failed
     HttpGet -- a network blip, a GitHub hiccup, a rate limit -- left library
     nil for the rest of the run and every achievement after it was dropped in
     silence. One warn at startup and then nothing, which is indistinguishable
     from achievements simply not working.

     Now a failure leaves it unloaded so the next award tries again, with a
     short backoff so a genuinely unreachable GitHub is not hammered once per
     badge. ]]
function Achievements:Load()
	if self.library then return self.library end

	-- Do not retry more than once every few seconds.
	if self.nextAttempt and os.clock() < self.nextAttempt then
		return nil
	end

	self.attempts = (self.attempts or 0) + 1

	local ok, result = pcall(function()
		return loadstring(game:HttpGet(
			"https://raw.githubusercontent.com/RegularVynixu/DOORS-Custom-Achievements/main/init.luau"
		))()
	end)

	if ok and result then
		self.library = result
		logAlways("Achievements", "library loaded on attempt %d", self.attempts)
		return self.library
	end

	self.nextAttempt = os.clock() + 5
	logAlways("Achievements", "library fetch failed (attempt %d), will retry: %s",
		self.attempts, tostring(result))

	return nil
end

function Achievements:Drain()
	if self.draining then return end
	self.draining = true

	task.spawn(function()
		while #self.queue > 0 do
			local entry = table.remove(self.queue, 1)
			local library = self:Load()

			if library then
				pcall(function()
					library:Grant(entry, { CheckOwned = false, Remember = true })
				end)
			else
				--[[ Put it BACK rather than dropping it.

				     Before, a missing library meant the award was quietly
				     thrown away and the queue moved on -- the badge was gone
				     even though the run had earned it. It now returns to the
				     front and the drain waits for the retry window. ]]
				table.insert(self.queue, 1, entry)
				logAlways("Achievements", "no library yet, %s is waiting", tostring(entry.Title))

				task.wait(5)
				continue
			end

			toDisk(("[Gradish] achievement: %s  (Image %s)")
				:format(tostring(entry.Title), entry.Image and tostring(entry.Image) or "NONE"))
			print("[Gradish] achievement: " .. tostring(entry.Title))

			--[[ Does the popup actually USE our Image?

			     The library hands the whole table to DOORS' own
			     AchievementUnlock module. That is their code, and nobody has
			     read it -- it may honour Image, ignore it, or want a format we
			     are not giving it. Rather than guess again, look at what
			     appeared and write down what its ImageLabels ended up showing.

			     If the log says our custom asset, the picture is reaching the
			     popup. If it says something else, DOORS is overriding us and
			     no amount of fixing the image manager will help. ]]
			task.delay(0.7, function()
				pcall(function()
					local gui = LocalPlayer:FindFirstChild("PlayerGui")
					local popup = gui and gui:FindFirstChild("AchievementUnlock", true)

					if not popup then
						toDisk("[Gradish] no AchievementUnlock found in PlayerGui to inspect")
						return
					end

					local seen = 0
					for _, descendant in ipairs(popup:GetDescendants()) do
						if descendant:IsA("ImageLabel") and descendant.Image ~= "" then
							seen += 1
							toDisk(("[Gradish]    popup image: %s = %s")
								:format(descendant.Name, descendant.Image))
						end
					end

					if seen == 0 then
						toDisk("[Gradish]    the popup shows no image at all")
					end
				end)
			end)

			task.wait(2.6) -- let each popup finish before the next one starts
		end

		self.draining = false
	end)
end

--[[ Exported so tools outside the Core can reach the same queue, the same
     retry backoff and the same "already granted" set. GradishDev grants and
     revokes through this rather than loading its own copy of the library,
     which would have kept a second, disagreeing cache of what you own. ]]
Core.Achievements = Achievements

function Achievements:Award(entry)
	if not entry or isBlank(entry.Identifier) then return end
	if Core.Granted[entry.Identifier] then return end

	Core.Granted[entry.Identifier] = true
	table.insert(self.queue, entry)
	self:Drain()
end

---====== ACHIEVEMENT IMAGES ======---
--[[ Badge art is managed from the repo, not from Roblox.

     One file per entity in ImagesA/ (Images-Achievement), each returning a
     table that says where its picture comes from:

         return { Source = "roblox", Value = "rbxassetid://133397789900538" }
         return { Source = "url",    Value = "https://example.com/rose.png" }
         return { Source = "file",   Value = "myimages/rose.png" }

     roblox  an ordinary asset ID. Nothing to download, always works.
     url     any image on the internet. Fetched once, written to the executor's
             folder, and handed to getcustomasset, which is the same trick the
             entity models use to load a .rbxm from GitHub.
     file    a picture already on your machine, relative to the executor's
             workspace folder. Nothing leaves your PC.

     Resolved once per key per session and cached, because getcustomasset on a
     freshly downloaded file is not free. A file that is missing, unreachable or
     malformed falls through to whatever the achievement had inline, so a broken
     image can never stop a badge being awarded. ]]

local Images = {
	cache  = {},
	folder = "ImagesA",
	base   = "https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/main/ImagesA/",
}

Core.Images = Images

--[[ Warm the cache before anything needs it.

     Every entity name plus the death light keys, fetched once in the
     background at startup. After this every Resolve during a spawn is a table
     lookup rather than a download. ]]
function Images:Prefetch()
	local keys = {
		"Retter", "Rose Hell", "Yeller", "Rebound", "Corrode", "Rude",
		"Silence", "Speedster Purpleist", "Blue Hell", "Mischievous Light",
		-- The death-light symbols. Silence and Blue Hell are not here: their
		-- lights now share the entity key above rather than a lowercase file
		-- of their own, so listing them again would fetch the same picture
		-- twice.
		"mischievous", "corroded", "violet",
	}

	task.spawn(function()
		local got = 0
		for _, key in ipairs(keys) do
			if self:Resolve(key, true) then got += 1 end
			task.wait(0.15)  -- do not open fourteen sockets at once
		end
		logAlways("Images", "prefetched %d of %d", got, #keys)
	end)
end

-- "Rose Hell" -> "RoseHell", so the filename is predictable.
local function imageKey(name)
	return (tostring(name):gsub("[^%w]", ""))
end

local function downloadImage(url, key)
	if not (getcustomasset and writefile) then
		logAlways("Images", "executor has no getcustomasset, cannot use a url image")
		return nil
	end

	-- Keep the original extension: getcustomasset decides how to read the file
	-- from it, and a .png served as .txt will not load.
	local extension = url:match("%.(%a%a%a%a?)$") or "png"
	local fileName = ("gradish_badge_%s.%s"):format(key, extension)

	local ok, result = pcall(function()
		if not (isfile and isfile(fileName)) then
			writefile(fileName, game:HttpGet(url))
		end
		return getcustomasset(fileName, true)
	end)

	if not ok then
		logAlways("Images", "could not fetch %s: %s", url, tostring(result))
		return nil
	end

	return result
end

--[[ Works out what you gave it, so you never have to say.

     Source = "roblox" / "url" / "file" was ceremony: every value already tells
     you which it is. Now an ImagesA file can be one line -- just the thing --
     and the old table form still works if you prefer being explicit. ]]
local function detectSource(value)
	local text = tostring(value)

	if text:match("^rbxassetid://") or text:match("^rbxasset://") then return "roblox" end
	if text:match("^%d+$") then return "roblox" end        -- a bare asset number
	if text:match("^https?://") then return "url" end
	return "file"
end

--[[ Never block the caller.

     This used to run an HttpGet, a writefile and a getcustomasset inline, and
     it is called from buildAchievements, which runs inside Core:Spawn. So
     creating an entity stopped dead waiting on GitHub -- three images meant
     three round trips before the thing could appear in the corridor.

     A cache miss now starts the fetch in the background and returns nil for
     now. Prefetch() warms everything at startup, so by the time any entity
     spawns the answer is already sitting in the cache. ]]
function Images:Resolve(name, blocking)
	local key = imageKey(name)
	if key == "" then return nil end

	local cached = self.cache[key]
	if cached ~= nil then
		return cached ~= false and cached or nil
	end

	if not blocking then
		if not self.fetching then self.fetching = {} end

		if not self.fetching[key] then
			self.fetching[key] = true
			task.spawn(function()
				self:Resolve(name, true)
				self.fetching[key] = nil
			end)
		end

		return nil
	end

	local ok, definition = pcall(function()
		return loadstring(game:HttpGet(self.base .. key))()
	end)

	if not ok or definition == nil then
		-- No file for this entity is the normal case, not an error.
		self.cache[key] = false
		return nil
	end

	--[[ Three shapes accepted, in order of how little you have to type:

	         return "rbxassetid://123"                    a bare string
	         return { Image = "https://..." }             a named field
	         return { Source = "url", Value = "https://" } the old explicit form
	]]
	local value, source

	if type(definition) == "string" then
		value = definition
	elseif type(definition) == "table" then
		value = definition.Image or definition.Value or definition[1]
		source = definition.Source
	end

	if isBlank(value) then
		logAlways("Images", "%s gave nothing usable", key)
		self.cache[key] = false
		return nil
	end

	source = tostring(source or detectSource(value)):lower()

	local result = nil

	if source == "roblox" then
		-- A bare number is a perfectly reasonable thing to paste.
		result = value:match("^%d+$") and ("rbxassetid://" .. value) or value

	elseif source == "url" then
		result = downloadImage(value, key)

	elseif source == "file" then
		if getcustomasset then
			local worked, asset = pcall(getcustomasset, value, true)
			result = worked and asset or nil
			if not worked then
				logAlways("Images", "%s: could not read the local file %s", key, tostring(value))
			end
		end

	else
		logAlways("Images", "%s has an unknown Source %q", key, source)
	end

	if result then
		logAlways("Images", "%s resolved as %s", key, source)
	end

	self.cache[key] = result or false
	return result
end

---====== ACHIEVEMENT CONFIG ======---
--[[ All the wording lives in one editable file so nobody has to go hunting
     through four entity scripts to change a title. Fetched once per session;
     if it is unreachable, every achievement still gets generated from the
     entity name and nothing breaks. ]]

local AchievementConfig = {
	Url    = "https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/main/AchievementConfig",
	data   = nil,
	loaded = false,
}

Core.AchievementConfig = AchievementConfig

function AchievementConfig:Get()
	if self.loaded then return self.data end
	self.loaded = true

	local ok, result = pcall(function()
		return loadstring(game:HttpGet(self.Url))()
	end)

	if ok and type(result) == "table" then
		self.data = result
	else
		warn("[Gradish] AchievementConfig unreachable, using generated names: " .. tostring(result))
		self.data = { Entities = {}, Special = {} }
	end

	return self.data
end

-- Pulls one of the shared achievements out of the config file.
local function specialAchievement(key, fallback)
	local data  = AchievementConfig:Get()
	local entry = (data.Special or {})[key]

	if type(entry) ~= "table" then
		entry = fallback
	end
	if not entry then return nil end

	-- A blank Image must be absent rather than empty, or the popup tries to
	-- load "" as a texture.
	local copy = {}
	for key2, value in pairs(entry) do copy[key2] = value end
	if isBlank(copy.Image) then copy.Image = nil end

	return copy
end

--[[ Builds the four achievements for an entity.

     Three layers, each overriding the one below it:
         1. generated from the entity name   (always works)
         2. AchievementConfig.Entities[name] (where you normally edit)
         3. profile.Achievements             (inline, for one-offs)

     Setting a key to false at either of the top two layers switches that
     achievement off. ]]
local function buildAchievements(profile)
	local name     = profile.Name
	local data     = AchievementConfig:Get()
	local fromFile = (data.Entities or {})[name] or {}
	local inline   = profile.Achievements or {}
	--[[ A plain asset ID written here WINS. This is back-to-front from how it
	     was, on purpose.

	     The URL manager had ImagesA take priority, which meant a decal ID typed
	     into this file was silently ignored whenever an ImagesA entry existed
	     -- so "I put the ID in" and "the badge shows something else" were both
	     true at once, which is impossible to debug from the outside.

	     Now: Image here beats everything. ImagesA is the fallback for entities
	     that have no ID yet, and DefaultImage is the last resort. ]]
	local image = inline.Image
		or fromFile.Image
		or Images:Resolve(name)
		or data.DefaultImage

	--[[ SHORT FORM.

	     Six lines per badge, four badges per entity, was a lot of typing to
	     say two sentences. A badge can now be written as one string:

	         Survive = "Survived Corrode | Slow, but the floor remembers him",

	     Title before the pipe, description after it. The Identifier is derived
	     the same way the generated defaults derive it, so a short-form badge
	     and a full-table badge with no Identifier end up with the same save
	     key -- switching between the two forms cannot orphan someone's
	     earned badge.

	     The full table form still works and still wins, for when you want the
	     Reason line or a per-badge image. ]]
	local function expand(value)
		if type(value) == "table" then return value end
		if type(value) ~= "string" then return {} end

		local title, desc = value:match("^(.-)%s*|%s*(.+)$")
		if not title then return { Title = value } end

		return { Title = title, Desc = desc }
	end

	--[[ Three levels of off switch, checked from the outside in:

	         AchievementConfig.Enabled = false     nothing is ever awarded
	         Entities["X"].Enabled = false         that entity awards nothing
	         Entities["X"].Survive = false         just that one badge is off

	     A disabled badge is not "awarded silently" -- it is never built, so it
	     never reaches the queue and never writes to the save file. ]]
	local function build(key, defaults)
		if data.Enabled == false then return nil end
		if fromFile.Enabled == false then return nil end
		if inline.Enabled == false then return nil end
		if inline[key] == false or fromFile[key] == false then return nil end

		local fileEntry   = expand(fromFile[key])
		local inlineEntry = expand(inline[key])

		local entry = {
			Identifier = inlineEntry.Identifier or fileEntry.Identifier or defaults.Identifier,
			Title      = inlineEntry.Title      or fileEntry.Title      or defaults.Title,
			Desc       = inlineEntry.Desc       or fileEntry.Desc       or defaults.Desc,
			Reason     = inlineEntry.Reason     or fileEntry.Reason     or defaults.Reason,
		}

		local chosen = inlineEntry.Image or fileEntry.Image or image
		if not isBlank(chosen) then
			entry.Image = chosen
		end

		return entry
	end

	return {
		Survive = build("Survive", {
			Identifier = name,
			Title      = ("Survived %s"):format(name),
			Desc       = ("You walked away from %s"):format(name),
			Reason     = ("Survive an encounter with %s"):format(name),
		}),

		Death = build("Death", {
			Identifier = name .. " Victim",
			Title      = ("Died to %s"):format(name),
			Desc       = ("%s caught you"):format(name),
			Reason     = ("Die to %s"):format(name),
		}),

		Untouched = build("Untouched", {
			Identifier = name .. " Untouched",
			Title      = ("Untouched by %s"):format(name),
			Desc       = "Not a scratch on you",
			Reason     = ("Survive %s without taking a single hit"):format(name),
		}),

		Crucify = build("Crucify", {
			Identifier = name .. " Banished",
			Title      = ("Banished %s"):format(name),
			Desc       = ("%s met the crucifix"):format(name),
			Reason     = "Does not count towards progression",
		}),
	}
end

--[[ Exported, because three different things want to ask "what would this
     config actually produce?" and none of them should re-implement the
     answer: the dev console, the config checker, and anything you write
     later. Pass a whole profile, or just { Name = "Corrode" }. ]]
Core.BuildAchievements = buildAchievements

-- Every entity the mod ships, so the checker and the console can walk them
-- without you having to keep a second list in your head.
Core.EntityNames = {
	"Retter", "Rose Hell", "Yeller", "Rebound", "Corrode", "Rude",
	"Silence", "Speedster Purpleist", "Blue Hell", "Mischievous Light",
}

--[[ Every badge the current configuration would ever hand out, flattened.

     Short form is expanded, defaults are filled in, disabled ones are absent
     -- it is the real list, not a description of the config file. Entities
     named in AchievementConfig that are not in EntityNames are included too,
     so a badge you added for something of your own still shows up. ]]
function Core.AllAchievements()
	local data = AchievementConfig:Get()
	local seen, out = {}, {}

	local names = {}
	for _, name in ipairs(Core.EntityNames) do names[name] = true end
	for name in pairs(data.Entities or {}) do names[name] = true end

	for name in pairs(names) do
		for slot, entry in pairs(buildAchievements({ Name = name })) do
			if type(entry) == "table" and entry.Identifier and not seen[entry.Identifier] then
				seen[entry.Identifier] = true
				table.insert(out, {
					id = entry.Identifier, from = name .. "." .. slot, entry = entry,
				})
			end
		end
	end

	for key, entry in pairs(data.Special or {}) do
		if type(entry) == "table" and entry.Identifier and not seen[entry.Identifier] then
			seen[entry.Identifier] = true
			table.insert(out, {
				id = entry.Identifier, from = "Special." .. key, entry = entry,
			})
		end
	end

	table.sort(out, function(a, b) return a.from < b.from end)
	return out
end

