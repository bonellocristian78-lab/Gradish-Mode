--[[ Fires the death hints the way the spawner does.

     The spawner owns this normally: its DamagePlayer sets your health and, at
     zero, waits for the death screen and fires DeathHint with the entity's
     hints and its colour name.

     Anything that kills you WITHOUT going through DamagePlayer -- the acid,
     Rude -- skips all of that, and DOORS falls back to "Died to Unknown" with
     no hint text. That is what happened: the log shows ten acid burns down to
     zero, and the death screen had nothing to say.

     So those paths call this instead. Same two arguments, same order, read out
     of the spawner source. ]]
local function fireDeathHints(profile)
	if not profile then return end

	local hints = profile.DeathHints
	if type(hints) ~= "table" or #hints == 0 then return end

	if not firesignal then
		logAlways("Death", "this executor has no firesignal, DOORS will say Unknown")
		return
	end

	task.spawn(function()
		local ok, err = pcall(function()
			local gui = LocalPlayer:WaitForChild("PlayerGui", 5)
			local mainUI = gui and gui:WaitForChild("MainUI", 5)
			local screen = mainUI and mainUI:FindFirstChild("Death")
			if not screen then return end

			-- The spawner waits for the screen before firing. So do we, or the
			-- hint arrives before anything is listening.
			if not screen.Visible then
				screen:GetPropertyChangedSignal("Visible"):Wait()
			end

			local remotes = ReplicatedStorage:FindFirstChild("RemotesFolder")
			local hint = remotes and remotes:FindFirstChild("DeathHint")
			if not hint then return end

			-- Must be a name DOORS knows. DeathLight repaints it afterwards.
			local colour = profile.DeathType or "Blue"

			firesignal(hint.OnClientEvent, hints, colour)
			logAlways("Death", "hints fired for %s (%s)", tostring(profile.Name), colour)
		end)

		if not ok then
			logAlways("Death", "could not fire hints: %s", tostring(err))
		end
	end)
end

Core.FireDeathHints = fireDeathHints

local DeathLight = {
	pending  = nil,
	watching = false,
}

Core.DeathLight = DeathLight

--[[ Paints EVERY ImageLabel under the holder, not three named ones.

     The named-path version left the figure showing the previous death's
     colour: the dialog turned red for Retter while the character stayed green
     from a Corrode death before it. Whichever object actually carries the
     figure, walking the whole subtree reaches it.

     It also logs what it found and what the values were, so if a colour is
     still wrong the log says which object kept it. ]]
local function paintDeathScreen(screen, palette, verbose)
	local painted = {}

	local function paint(instance, property, colour)
		if not instance or not colour then return end

		pcall(function()
			local before = instance[property]
			instance[property] = colour

			if verbose then
				table.insert(painted, ("%s.%s %s -> %s")
					:format(instance.Name, property, tostring(before), tostring(colour)))
			end
		end)
	end

	paint(screen, "ImageColor3", palette.Screen)

	local holder = screen:FindFirstChild("Hodler")
	if holder then
		local picture
		if palette.Image and palette.ReplaceFigure then
			picture = Core.Images:Resolve(palette.Image)
		end

		-- Everything under the holder is the light's figure in one form or
		-- another: outer, inner, and the Glitch variants of both.
		for _, descendant in ipairs(holder:GetDescendants()) do
			if descendant:IsA("ImageLabel") then
				paint(descendant, "ImageColor3", palette.Light)
				if picture then paint(descendant, "Image", picture) end
			elseif descendant:IsA("TextLabel") then
				paint(descendant, "TextColor3", palette.Dialog or palette.Light)
			end
		end
	elseif verbose then
		table.insert(painted, "NO Hodler -- the figure could not be reached")
	end

	-- The grain, and its inner copy.
	for _, name in ipairs({ "Static", "GlitchStatic" }) do
		local layer = screen:FindFirstChild(name)
		if layer then
			paint(layer, "ImageColor3", palette.Static)
			for _, descendant in ipairs(layer:GetDescendants()) do
				if descendant:IsA("ImageLabel") then
					paint(descendant, "ImageColor3", palette.Static)
				end
			end
		end
	end

	-- The hint text sits beside the holder, not inside it.
	for _, descendant in ipairs(screen:GetChildren()) do
		if descendant:IsA("TextLabel") then
			paint(descendant, "TextColor3", palette.Dialog or palette.Light)
		end
	end

	if verbose and #painted > 0 then
		logAlways("DeathLight", "painted %d:", #painted)
		for _, line in ipairs(painted) do
			logAlways("DeathLight", "   %s", line)
		end
	end

	return #painted
end

-- Called by an entity as it kills you, so the screen knows whose light to be.
function DeathLight:Arm(nameOrPalette)
	local palette = nameOrPalette

	if type(nameOrPalette) == "string" then
		palette = Core.DeathLights[nameOrPalette]
		if not palette then
			logAlways("DeathLight", "no death light called %q", nameOrPalette)
			return
		end
	end

	if type(palette) ~= "table" then return end

	self.pending = palette
	self:Watch()
end

function DeathLight:Watch()
	if self.watching then return end

	local gui = LocalPlayer:FindFirstChild("PlayerGui")
	local mainUI = gui and gui:FindFirstChild("MainUI")
	local screen = mainUI and mainUI:FindFirstChild("Death")
	if not screen then return end

	self.watching = true

	screen:GetPropertyChangedSignal("Visible"):Connect(function()
		if not screen.Visible then return end

		local palette = self.pending
		if not palette then return end
		self.pending = nil

		-- DOORS paints these as the screen animates in, so one pass at the
		-- wrong moment gets overwritten. Keep repainting for a second.
		task.spawn(function()
			--[[ Repaint for as long as the screen is up, not for a fixed
			     window.

			     Three seconds was not enough and the reason is the order DOORS
			     builds the screen in: the hint text arrives LAST, so late
			     passes caught it and it stayed painted, while the moon and the
			     figure were written again after the window closed and went
			     back to default. That is exactly what the screenshots showed
			     -- red text, default light.

			     So it holds until the screen goes away, with a generous cap so
			     a stuck screen cannot leave this spinning forever. ]]
			local painted = paintDeathScreen(screen, palette, true)

			local deadline = os.clock() + (palette.HoldFor or 45)
			local passes = 0

			while screen.Visible and os.clock() < deadline do
				paintDeathScreen(screen, palette, false)
				passes += 1
				task.wait(0.1)
			end

			logAlways("DeathLight", "held for %d pass(es), %d object(s) on the first", passes, painted)
		end)
	end)

	logAlways("DeathLight", "watching the death screen")
end

---====== RITUAL COLOUR ======---
--[[ The spawner only knows two banish colours:

         Storage.CrucifixTypes = {
             guiding = { Color = (137, 207, 255) },   -- blue
             curious = { Color = (255, 227, 137) },   -- yellow
         }

     That table is a local inside the spawner, so it cannot be added to from
     out here. But the ritual clones its Repentance model into workspace and
     THEN colours it, so waiting for that model to appear and recolouring it
     afterwards gets any colour you like, without touching the spawner at all.

     The spawner tints everything carrying the GiveMeColor tag. We use the
     same set where we can reach it, and fall back to every light, beam and
     emitter in the model. ]]

Crucifix.pendingColour  = nil   -- set by whoever is being banished right now
Crucifix.pendingRainbow = false
Crucifix.ritualWatching = false
Crucifix.painting       = nil   -- the Repentance model being painted right now

local function taggedForColour(model)
	-- Vynixu's utilities inject QueryDescendants, and the spawner itself uses
	-- exactly this selector, so try it first.
	local ok, result = pcall(function()
		return model:QueryDescendants(".GiveMeColor")
	end)
	if ok and type(result) == "table" and #result > 0 then
		return result
	end

	-- Otherwise the tag directly.
	local tagged = {}
	pcall(function()
		for _, instance in ipairs(CollectionService:GetTagged("GiveMeColor")) do
			if instance:IsDescendantOf(model) then
				table.insert(tagged, instance)
			end
		end
	end)
	if #tagged > 0 then return tagged end

	-- Last resort: everything that emits light in the model.
	local fallback = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("Light") or descendant:IsA("Beam")
			or descendant:IsA("ParticleEmitter")
		then
			table.insert(fallback, descendant)
		end
	end
	return fallback
end

local function recolourRitual(model, colour, quiet)
	local targets = taggedForColour(model)
	local count = 0

	for _, instance in ipairs(targets) do
		pcall(function()
			if instance:IsA("Light") or instance:IsA("BasePart") then
				instance.Color = colour
				count += 1
			elseif instance:IsA("ParticleEmitter") or instance:IsA("Beam") then
				instance.Color = ColorSequence.new(colour)
				count += 1
			end
		end)
	end

	if not quiet then
		logAlways("Crucifix", "ritual recoloured, %d object(s)", count)
	end
end

--[[ Paint one Repentance model, according to whatever is pending.

     Split out of WatchRitual so the same code can run from the ChildAdded
     event AND from a direct call, for the case where the model reached the
     workspace before anyone was listening. Consumes the pending values, so
     calling it twice for one ritual is harmless -- the second call finds
     nothing to do and leaves. ]]
function Crucifix:PaintRitual(model)
	if not model or self.painting == model then return end

	local colour  = self.pendingColour
	local rainbow = self.pendingRainbow
	self.pendingColour  = nil
	self.pendingRainbow = false

	if not colour and not rainbow then return end

	self.painting = model

	--[[ THE RAINBOW RITUAL.

	     This was missing entirely and it is why the rainbow crucifix looked
	     like an ordinary one: the variant carries no Color, so pendingColour
	     was nil, so the watcher returned immediately and the spawner's own
	     blue was left alone.

	     A crucifix that beats every entity in the game should not produce the
	     same pentagram as the one that beats none of them. This cycles the
	     whole ritual through the hue wheel for as long as it lasts. ]]
	if rainbow then
		task.spawn(function()
			--[[ The target list is resolved ONCE and reused.

			     The first version called recolourRitual every tick, and that
			     function walks the model's whole descendant tree to find what
			     to paint. Twenty times a second for fourteen seconds is
			     roughly three hundred full tree walks during the single most
			     expensive moment in the game. The colours are identical; this
			     just stops paying for them. ]]
			local targets = taggedForColour(model)
			local hue = 0
			local deadline = os.clock() + 14   -- the ritual runs about 10s

			while model.Parent and os.clock() < deadline do
				hue = (hue + 0.02) % 1
				local shade = Color3.fromHSV(hue, 0.9, 1)

				for _, instance in ipairs(targets) do
					pcall(function()
						if instance:IsA("Light") or instance:IsA("BasePart") then
							instance.Color = shade
						elseif instance:IsA("ParticleEmitter") or instance:IsA("Beam") then
							instance.Color = ColorSequence.new(shade)
						end
					end)
				end

				task.wait(0.05)
			end

			self.painting = nil
			logAlways("Crucifix", "rainbow ritual finished (%d object(s))", #targets)
		end)
		return
	end

	-- Let the spawner finish applying its own colour first, then override.
	task.spawn(function()
		for _ = 1, 4 do
			task.wait(0.1)
			if not model.Parent then break end
			recolourRitual(model, colour)
		end
		self.painting = nil
	end)
end

function Crucifix:WatchRitual()
	if self.ritualWatching then return end
	self.ritualWatching = true

	Workspace.ChildAdded:Connect(function(child)
		if child.Name ~= "Repentance" then return end
		self:PaintRitual(child)
	end)

	logAlways("Crucifix", "watching for the ritual")
end

