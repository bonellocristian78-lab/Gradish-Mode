---====== MECHANIC: THE TELL ======---
--[[ Rooms ahead of you shift to the entity colour before it arrives, and
     shift BACK when it leaves.

     The old per-entity scripts did the first half by hand and never did the
     second, so after Rose Hell died the corridor stayed pink for the rest of
     the run and Rebound's blue stacked on top of it.

     Two details make it read as light rather than as a filter:

       * Falloff. The room you are standing in gets the colour at full
         strength; each room further along gets less of it, blended against
         whatever colour that light already was. A corridor lit from one end
         looks lit from one end.

       * Staggered restore. Lights do not all snap back on the same frame.
         Each one returns after its own small delay, so the colour drains out
         of the map instead of being switched off. ]]

--[[ THE ORIGINALS MUST BE SHARED, NOT PER SESSION.

     They were a local inside startTell, one table per entity, and that quietly
     broke the restore the moment two entities were out together -- which the
     schedule allows on purpose and which the Two At Once achievement exists
     for.

     What happened: Retter tints a light amber. Yeller arrives, and ITS
     remember() snapshots the light as it reads right now -- amber -- and files
     that as the original. Retter leaves and correctly restores white. Yeller
     leaves later and faithfully restores the light to Retter's amber. The
     corridor is now permanently wearing a dead entity's colour, which is
     exactly the bug this mechanic was written to fix.

     It also ruined the tell itself in two ways: the second entity's colour was
     blended against the first one's instead of against the room, washing it
     out, and whichever entity despawned first wiped the survivor's warning
     light while it was still hunting you.

     So the true original lives at module scope, written once by whoever
     touches a light first and never overwritten. Ownership is tracked as a set
     of sessions per light, so a restore can tell the difference between "the
     last entity left, put it back" and "one of two left, the other still needs
     its colour".

     Weak keys: DOORS unloads rooms behind you, and without them every light in
     a 100-room run would be pinned in memory for the whole session. ]]

local trueOriginals = setmetatable({}, { __mode = "k" })
local tellOwners    = setmetatable({}, { __mode = "k" })

local function startTell(session)
	local settings = session.profile.Tell
	if not settings or not settings.Color then return end

	local reach   = settings.Reach or 5
	local minimum = settings.MinStrength or 0.2
	local mine    = {}   -- lights this session tinted
	local tinted  = {}   -- rooms this session already walked

	-- Records the genuine value, once, the first time anything touches it.
	local function remember(instance, keys)
		if trueOriginals[instance] then return trueOriginals[instance] end

		local snapshot = {}
		for _, key in ipairs(keys) do
			local ok, value = pcall(function() return instance[key] end)
			if ok then snapshot[key] = value end
		end

		trueOriginals[instance] = snapshot
		return snapshot
	end

	local function claim(instance)
		local owners = tellOwners[instance]
		if not owners then
			owners = {}
			tellOwners[instance] = owners
		end

		owners[session] = settings
		mine[instance] = true
	end

	-- strength 1 is right on top of you, 0 is out past the entity's reach.
	local function strengthFor(roomNumber)
		if not settings.Falloff then return 1 end

		local gap = math.abs(roomNumber - currentRoomNumber())
		return math.clamp(1 - (gap / reach), minimum, 1)
	end

	local function tintRoom(room)
		if not room or tinted[room] then return end
		tinted[room] = true

		local number   = tonumber(room.Name) or currentRoomNumber()
		local strength = strengthFor(number)
		local fade     = settings.FadeIn or 1

		for _, descendant in ipairs(room:GetDescendants()) do
			if descendant:IsA("Light") then
				-- Always blend from the TRUE original, never from what the
				-- light happens to read right now. Reading it live is what let
				-- one entity's tint become another's baseline.
				local original = remember(descendant, { "Color", "Brightness" })
				claim(descendant)

				local base = original.Color or Color3.new(1, 1, 1)

				tween(descendant, fade, {
					Color      = base:Lerp(settings.Color, strength),
					Brightness = (original.Brightness or 1)
						* (1 + ((settings.BrightnessBoost or 1) - 1) * strength),
				})

			elseif descendant:IsA("BasePart") and descendant.Name == "Neon" then
				local original = remember(descendant, { "Color" })
				claim(descendant)

				local base = original.Color or Color3.new(1, 1, 1)
				tween(descendant, fade, { Color = base:Lerp(settings.Color, strength) })
			end
		end
	end

	local function tintAhead()
		local rooms = getCurrentRooms()
		if not rooms then return end

		local latest = currentRoomNumber()
		for _, room in ipairs(rooms:GetChildren()) do
			local number = tonumber(room.Name)
			if number and number >= latest then
				tintRoom(room)
			end
		end
	end

	tintAhead()
	session.tintAhead = tintAhead

	-- Rooms generated while it chases you get tinted too, otherwise you
	-- outrun your own warning light within a few doors.
	local rooms = getCurrentRooms()
	if rooms then
		session.janitor:Give(rooms.ChildAdded:Connect(function(room)
			if not session.active then return end
			task.wait(0.15) -- let the room finish streaming in
			pcall(tintRoom, room)
		end))
	end

	--[[ RESTORE, OWNERSHIP AWARE.

	     Three outcomes rather than one:

	       last owner leaves    put the light back to its true original
	       another owner stays  re-apply THAT entity's colour, because the old
	                            code wiped a living entity's warning light when
	                            the other one despawned
	       owner is stale       a session that died without cleaning up used to
	                            pin the light forever. Swept here instead. ]]
	session.janitor:Give(function()
		local fade = settings.FadeOut or 0.8

		for instance in pairs(mine) do
			if typeof(instance) == "Instance" and instance.Parent then
				local owners = tellOwners[instance]

				if owners then
					owners[session] = nil

					-- Sweep anyone who is no longer running, or a leaked
					-- session would keep this light hostage for the whole run.
					for other in pairs(owners) do
						if not other.active then owners[other] = nil end
					end
				end

				local original = trueOriginals[instance] or {}

				-- Whoever is still hunting you gets their colour back. The
				-- strongest remaining claim wins if there are several.
				local remaining, strongest = nil, -1
				if owners then
					for other, otherSettings in pairs(owners) do
						local weight = otherSettings.Priority or 0
						if weight > strongest then
							strongest = weight
							remaining = otherSettings
						end
					end
				end

				local delay = math.random() * (settings.RestoreStagger or 0.4)

				if remaining then
					local base = original.Color or Color3.new(1, 1, 1)
					local goal = { Color = base:Lerp(remaining.Color, remaining.MinStrength or 0.6) }

					task.delay(delay, function()
						if instance.Parent then tween(instance, fade, goal) end
					end)
				else
					if owners then tellOwners[instance] = nil end

					task.delay(delay, function()
						if instance.Parent then tween(instance, fade, original) end
					end)
				end
			end
		end

		table.clear(mine)
		table.clear(tinted)
	end)

	log(session.name, "tell online")
end

---====== MECHANIC: CLOSET CHECK ======---
--[[ If you are in a closet when it comes past, it stops outside and waits.

     Safe by construction, and that is the point. EntityMoveTo checks the
     Paused attribute every Stepped frame, and the detection loop skips damage
     and crucifixion entirely while paused, so a paused entity beside your
     closet cannot hurt you. All it does is refuse to leave.

     Step out early and it notices: leaving the closet resumes it at once,
     which is a far worse outcome than simply waiting. ]]

local function startClosetCheck(session)
	local settings = session.profile.ClosetCheck
	if not settings or not settings.Enabled then return end

	local range    = settings.Range or 22
	local pauseFor = settings.PauseFor or 1.6
	local chance   = settings.Chance or 1
	local cooldown = settings.Cooldown or 12

	local nextAllowed = 0
	local busy = false

	session.janitor:Give(RunService.Heartbeat:Connect(function()
		if not session.active or busy then return end

		local entity = session.entity
		local model  = entity and entity.Model
		local root   = getRoot()
		if not model or not model.Parent or not root then return end

		if model:GetAttribute("BeingBanished") then return end
		if model:GetAttribute("Paused") then return end
		if not isHiding() then return end
		if os.clock() < nextAllowed then return end

		local ok, pivot = pcall(function() return model:GetPivot().Position end)
		if not ok or (pivot - root.Position).Magnitude > range then return end

		if math.random() > chance then
			nextAllowed = os.clock() + cooldown
			return
		end

		busy = true
		session.stats.closetChecks += 1
		log(session.name, "stopped outside your closet")

		pcall(function() entity:Pause() end)

		task.spawn(function()
			local until_ = os.clock() + pauseFor

			while os.clock() < until_ do
				if not session.active or not model.Parent then break end
				if model:GetAttribute("BeingBanished") then break end
				if not isHiding() then
					log(session.name, "you moved, it heard you")
					break
				end
				task.wait(0.1)
			end

			--[[ Do NOT resume a banished entity.

			     The crucifixion pauses the model to hold it still for the
			     ritual. Resuming here would hand it straight back its
			     movement -- you would watch it get crucified and then simply
			     carry on, which looks exactly like the crucifix failing. ]]
			if model.Parent and not model:GetAttribute("BeingBanished") then
				pcall(function() entity:Resume() end)
			else
				log(session.name, "not resuming, it is being banished")
			end

			nextAllowed = os.clock() + cooldown
			busy = false
		end)
	end))

	log(session.name, "closet check online")
end

---====== SPEED STACK ======---
--[[ Two mechanics own the speed at the same time: escalation raises it on
     every rebound, lingering drops it to a crawl in your room.

     An earlier version had both writing absolute numbers, and they fought. A
     rebound starting mid-linger wiped the throttle and the entity shot off
     while it was supposed to be standing still; then the linger ended and
     restored the pre-escalation number, wiping the escalation with it.

     Now neither one writes the speed. Each owns a multiplier and the value is
     always base * escalation * linger, recomputed whenever either changes. ]]

local function ensureSpeedStack(session)
	if session.speed then return session.speed end

	local config = session.entity and session.entity.Config
	if not config then return nil end

	session.speed = {
		base       = config.Movement.Speed, -- already includes Variance
		escalation = 1,
		linger     = 1,
	}
	return session.speed
end

local function applySpeed(session)
	local stack  = session.speed
	local config = session.entity and session.entity.Config
	if not stack or not config then return end

	config.Movement.Speed = stack.base * stack.escalation * stack.linger
end

---====== MECHANIC: LINGER ======---
--[[ It reaches the room you are standing in and stays there for a few
     seconds before carrying on.

     This deliberately does NOT use Pause. Pause sets the attribute the
     detection loop reads, so a paused entity cannot damage you at all, and
     stopping in your room would make it SAFER than passing through. That is
     backwards.

     So the speed is throttled to a crawl instead. The entity is effectively
     standing still, every damage and crucifixion check stays live, and if you
     are out in the open while it sits there it will still take you.

     EntityMoveTo captures speed when it is called, so the throttle lands on
     the next node rather than the current one. That is a fraction of a second
     and you cannot see it. ]]

local function startLinger(session)
	local settings = session.profile.Linger
	if not settings or not settings.Enabled then return end

	local stack = ensureSpeedStack(session)
	if not stack then return end

	local duration   = settings.Duration or { 2, 3 }
	local factor     = settings.SpeedFactor or 0.02
	local chance     = settings.Chance or 1
	local cooldown   = settings.Cooldown or 6
	local maxPerVisit = settings.MaxPerVisit or math.huge

	local nextAllowed = 0
	local busy = false

	session.linger = function()
		if busy or not session.active then return end
		if os.clock() < nextAllowed then return end
		if session.stats.lingers >= maxPerVisit then return end
		if math.random() > chance then return end

		local model = session.entity and session.entity.Model
		if not model or not model.Parent then return end
		if model:GetAttribute("BeingBanished") then return end

		busy = true
		session.stats.lingers += 1

		local seconds = duration[1]
			+ math.random() * math.max((duration[2] or duration[1]) - duration[1], 0)

		log(session.name, "stopping in your room for %.1fs", seconds)

		-- Own the linger slot of the stack, not the speed itself. A rebound
		-- escalating mid-linger now raises the base it is throttling, instead
		-- of cancelling the throttle.
		stack.linger = factor
		applySpeed(session)

		task.spawn(function()
			task.wait(seconds)

			stack.linger = 1
			applySpeed(session)

			nextAllowed = os.clock() + cooldown
			busy = false
			log(session.name, "moving again")
		end)
	end

	log(session.name, "linger online")
end

-- Is that room the one the player is standing in?
local function isPlayersRoom(room)
	if not room then return false end
	return tonumber(room.Name) == currentRoomNumber()
end

--[[ Forward declaration. The acid can kill you after its entity has gone, so
     it needs to end that visit itself -- but finish() is defined much further
     down with the rest of the lifecycle, and a local is not visible before it
     is declared. Assigned the moment finish() exists. ]]
local finishSession

---====== MECHANIC: ACID TRAIL ======---
--[[ It spits as it goes, and what lands stays.

     This is the first mechanic here that outlives the entity. Every other one
     ends when the thing despawns; acid does not. A room Corrode passed through
     is still dangerous a quarter of a minute later, so the route you were
     about to take back is closed and you have to think about the floor, which
     no other Gradish entity has ever made you do.

     Puddles are placed by raycasting down from the entity, so they land on
     whatever the floor actually is rather than at a guessed height. Damage is
     applied the way the spawner applies its own -- a direct write to
     Humanoid.Health -- so it behaves consistently with everything else. ]]

local function startAcidTrail(session)
	local settings = session.profile.Acid
	if not settings or not settings.Enabled then return end

	local interval   = settings.Interval or 0.4
	local radius     = settings.Radius or 4.5
	local lifetime   = settings.Lifetime or 14
	local damage     = settings.Damage or 7
	local tickRate   = settings.TickRate or 0.6
	local maxPuddles = settings.MaxPuddles or 40
	local colour     = settings.Color or Color3.fromRGB(120, 230, 70)

	local puddles = {}
	local lastDrop = 0
	local lastHurt = 0
	local lastPosition = nil

	local function makePuddle(at)
		-- Oldest first, so a long chase does not fill the map with parts.
		if #puddles >= maxPuddles then
			local oldest = table.remove(puddles, 1)
			if oldest then pcall(function() oldest:Destroy() end) end
		end

		local puddle = Instance.new("Part")
		puddle.Name         = "GradishAcid"
		puddle.Shape        = Enum.PartType.Cylinder
		puddle.Size         = Vector3.new(0.25, radius * 2, radius * 2)
		puddle.CFrame       = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90))
		puddle.Anchored     = true
		puddle.CanCollide   = false
		puddle.CanQuery     = false
		puddle.CanTouch     = false
		puddle.CastShadow   = false
		puddle.Material     = Enum.Material.Neon
		puddle.Color        = colour
		puddle.Transparency = 0.35
		puddle.Parent       = Workspace

		local light = Instance.new("PointLight")
		light.Color      = colour
		light.Brightness = 1.4
		light.Range      = radius * 2
		light.Parent     = puddle

		local fumes = Instance.new("ParticleEmitter")
		fumes.Color        = ColorSequence.new(colour)
		fumes.Size         = NumberSequence.new(0.6, 1.4)
		fumes.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0.75),
			NumberSequenceKeypoint.new(1, 1),
		})
		fumes.Lifetime      = NumberRange.new(1.5, 3)
		fumes.Rate          = 8
		fumes.Speed         = NumberRange.new(0.5, 1.5)
		fumes.SpreadAngle   = Vector2.new(30, 30)
		fumes.LightEmission = 0.5
		fumes.Parent        = puddle

		--[[ NOT given to the janitor, deliberately.

		     It was, and that quietly broke the one thing this mechanic exists
		     for. The janitor runs 1.5s after despawn and Destroys everything it
		     holds, so a 14-second lifetime was being cut to 1.5 and the floor
		     was safe the frame Corrode left. Every puddle already deletes
		     itself through the delay chain below, which is independent of the
		     session, so an orphan lives out its natural life and no longer. ]]
		table.insert(puddles, puddle)

		-- Boils away rather than blinking out.
		task.delay(lifetime - 2, function()
			if not puddle.Parent then return end
			tween(puddle, 2, { Transparency = 1 })
			pcall(function() fumes.Rate = 0 end)

			task.delay(2.1, function()
				local index = table.find(puddles, puddle)
				if index then table.remove(puddles, index) end
				pcall(function() puddle:Destroy() end)
			end)
		end)

		return puddle
	end

	--[[ TWO loops, not one, and only one of them belongs to the session.

	     They were a single Heartbeat, and that was the second half of the bug.
	     The shared guard `if not model.Parent then return end` sat at the top,
	     so the burning stopped the instant the entity despawned or was
	     crucified -- the floor went safe immediately and banishing Corrode
	     sanitised the whole map, which is the opposite of the intended trade.

	     SPIT needs the model and dies with the session.
	     BURN must never mention the model, is not janitored, and ends itself
	     when the last puddle is gone. ]]

	session.janitor:Give(RunService.Heartbeat:Connect(function()
		if not session.active then return end

		local model = session.entity and session.entity.Model
		if not model or not model.Parent then return end

		local now = os.clock()
		if now - lastDrop < interval then return end

		local ok, pivot = pcall(function() return model:GetPivot().Position end)
		if not ok or not pivot then return end

		-- Only drip while it is actually moving. A paused or lingering entity
		-- should not pool acid under itself.
		local moved = lastPosition == nil or (pivot - lastPosition).Magnitude > 1
		lastPosition = pivot
		if not moved or model:GetAttribute("Paused") then return end

		lastDrop = now

		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { model, getCharacter() }

		local hit = Workspace:Raycast(pivot, Vector3.new(0, -60, 0), params)
		if hit then
			safe(session.name, "acid drop", makePuddle, hit.Position + Vector3.new(0, 0.15, 0))
		end
	end))

	local burning
	burning = RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now - lastHurt < tickRate then return end
		lastHurt = now

		-- Self-terminating, or every Corrode visit would leave a Heartbeat
		-- connection running for the rest of the session with nothing to do.
		if #puddles == 0 and not session.active then
			log(session.name, "acid field burned out, %d burn(s) total", session.stats.acidTicks or 0)
			pcall(function() burning:Disconnect() end)
			return
		end

		-- Everything here is nil-guarded independently: nothing will ever
		-- disconnect this loop for us, so a death or a respawn must not turn
		-- it into an error thrown every frame forever.
		local root = getRoot()
		local humanoid = getHumanoid()
		if not root or not humanoid or humanoid.Health <= 0 then return end

		for index = #puddles, 1, -1 do
			local puddle = puddles[index]

			if not puddle or not puddle.Parent then
				table.remove(puddles, index)
			else
				local flat = Vector3.new(puddle.Position.X, root.Position.Y, puddle.Position.Z)

				if (flat - root.Position).Magnitude <= radius then
					humanoid.Health = math.max(humanoid.Health - damage, 0)
					session.stats.acidTicks = (session.stats.acidTicks or 0) + 1
					log(session.name, "acid burn, %d HP left", math.floor(humanoid.Health))

					--[[ The acid can finish you after Corrode has gone. It has
					     to claim that kill itself, or finish() sees a corpse
					     with stats.died false and every OTHER entity that
					     happens to be out awards its own death badge. ]]
					if humanoid.Health <= 0 and not session.stats.died then
						session.stats.died = true
						log(session.name, "the acid finished you")

						if session.profile.DeathLight then
							pcall(function()
								Core.DeathLight:Arm(session.profile.DeathLight)
							end)
						end

						-- Or DOORS says "Died to Unknown": this kill never
						-- went through the spawner's DamagePlayer.
						pcall(function() fireDeathHints(session.profile) end)
						safe(session.name, "acid death", function() finishSession(session) end)
					end

					break -- one burn per tick, not one per puddle
				end
			end
		end
	end)

	log(session.name, "acid trail online (%.1fs interval, %d damage every %.1fs, %ds lifetime)",
		interval, damage, tickRate, lifetime)
end

---====== MECHANIC: ESCALATION ======---
--[[ Every rebound makes it faster and widens its reach, so the fifth pass of
     something like Yeller is not the fight the first pass was.

     Movement.Speed is MULTIPLIED, never assigned: Create() already rewrote it
     as 65 / 100 * yourSpeed, so assigning a raw number would send the entity
     into orbit. And this only reaches the entity at all because Core runs it
     with Run(false); Run(true) would be escalating a discarded copy. ]]

local function setupEscalation(session)
	local settings = session.profile.Escalate
	if not settings then return end

	local config = session.entity and session.entity.Config
	local stack  = ensureSpeedStack(session)
	if not config or not stack then return end

	session.escalation = {
		baseRange = config.Damage.Range,
		steps     = 0,
	}
end

local function escalate(session)
	-- The log showed it still escalating after the visit had ended.
	if not session.active or session.stats.died then return end

	local settings = session.profile.Escalate
	local state    = session.escalation
	local stack    = session.speed
	if not settings or not state or not stack then return end

	local config = session.entity and session.entity.Config
	if not config then return end

	state.steps += 1

	local speedGain = settings.SpeedPerRebound or 0
	local rangeGain = settings.RangePerRebound or 0
	local speedCap  = settings.MaxSpeedMultiplier or 2

	if speedGain ~= 0 then
		stack.escalation = math.min(1 + speedGain * state.steps, speedCap)
		applySpeed(session)
	end

	if rangeGain ~= 0 then
		local cap = settings.MaxRange or (state.baseRange * 3)
		config.Damage.Range = math.min(state.baseRange + rangeGain * state.steps, cap)
	end

	log(session.name, "escalated to speed x%.2f, range %.0f",
		stack.escalation, config.Damage.Range)
end

---====== MECHANIC: CRUCIFIXION WATCH ======---
--[[ Do NOT reach for the CrucifixionOverwrite callback to detect this. It
     does not notify you, it REPLACES the whole banish ritual with your
     function, pentagram and all.

     The spawner already tells us everything through an attribute:

        BeingBanished -> true        the ritual started
        flipped back to false        the entity resisted
        never reset, or model gone   the banish stuck

     Polling the outcome rather than assuming it means this keeps working if
     an entity is ever given Resist = true. ]]

local function startCrucifixionWatch(session)
	local entity = session.entity
	local model  = entity and entity.Model
	if not model then return end

	local watching = false

	--[[ Start listening for the Repentance model NOW, not when the ritual
	     starts.

	     It used to connect inside resolve(), which runs after BeingBanished
	     has already flipped -- and the spawner clones Repentance into the
	     workspace in the same breath. On a fast frame the model landed before
	     the connection existed, ChildAdded never fired for it, and the ritual
	     kept the spawner's blue. That is the "sometimes it works" the
	     crucifix colours have had all along. The call is idempotent. ]]
	if Core.Crucifix then
		Core.Crucifix:WatchRitual()
	end

	local function resolve()
		watching = true
		session.stats.crucifixUsed = true
		log(session.name, "crucifix ritual started")

		--[[ Hand the ritual watcher the colour for THIS banish before the
		     Repentance model lands in workspace. Core.Crucifix rather than the
		     local, because the crucifix module is defined further down the
		     file and is not in scope here -- but it exists by the time this
		     ever runs. ]]
		if Core.Crucifix then
			Core.Crucifix.pendingColour  = session.ritualColour or session.profile.CrucifixColor
			Core.Crucifix.pendingRainbow = session.rainbowRitual == true
			Core.Crucifix:WatchRitual()

			-- And if it beat us into the workspace anyway, catch it there.
			local already = Workspace:FindFirstChild("Repentance")
			if already then
				Core.Crucifix:PaintRitual(already)
			end
		end

		task.spawn(function()
			local deadline = os.clock() + (session.profile.CrucifixTimeout or 12)

			while os.clock() < deadline do
				if not model.Parent then break end

				if model:GetAttribute("BeingBanished") ~= true then
					watching = false -- a later attempt can still be caught
					log(session.name, "crucifixion resisted")
					return
				end

				task.wait(0.25)
			end

			session.stats.crucifixBanished = true
			log(session.name, "banished")

			if session.achievements.Crucify then
				Achievements:Award(session.achievements.Crucify)
			end

			-- The dev crucifix says so, whichever entity it was used on.
			if session.crucifixVariant then
				local variant = Core.CrucifixVariants[session.crucifixVariant]
				if variant and variant.Achievement then
					local data = AchievementConfig:Get()
					local entry = (data.Special or {})[variant.Achievement]

					if type(entry) ~= "table" then
						entry = {
							Identifier = "You tried the dev crucifix",
							Title      = "You tried the dev crucifix",
							Desc       = "That one was not supposed to be in the drawers",
							Reason     = "Banish anything with the rainbow crucifix",
						}
					end

					Achievements:Award(entry)
				end
			end

			-- The rare one. Only reachable on a corroded roll, so it is its
			-- own award rather than a variant of the usual banish.
			if session.corroded then
				local key = (session.profile.Corroded or {}).Achievement or "Corroded"
				local entry = (session.achievements or {})[key]

				if type(entry) ~= "table" then
					local data = AchievementConfig:Get()
					entry = (((data.Entities or {})[session.name] or {})[key])
				end

				if type(entry) == "table" then
					Achievements:Award(entry)
				else
					log(session.name, "corroded banish, but no %q achievement configured", key)
				end
			end

			--[[ A banish does not go through Despawn().

			     The ritual locks the model to the prop and then calls
			     model:Destroy() on it directly, so the OnDespawned callback
			     never fires. Without this, finish() never runs -- no survive
			     achievement, no cleanup -- and the tinted lights stay on for
			     the rest of the run. ]]
			if session.onBanished then
				safe(session.name, "banish cleanup", session.onBanished)
			end
		end)
	end

	--[[ A corroded crucifix overrides the resist roll while you hold it.

	     Resist is read once, when the ritual starts, so it is enough to keep
	     the flag correct in real time rather than trying to intercept the
	     moment you raise it. Holding the green one turns her rare accident
	     into a decision you made in a drawer ten rooms ago. ]]
	session.janitor:Give(RunService.Heartbeat:Connect(function()
		--[[ Latch on the VARIANT, not on session.corroded.

		     It used to latch on session.corroded, which is the flag that says
		     "this was the rare green banish" and hands out the Corroded
		     achievement further up. So picking up the crimson, violet or
		     rainbow crucifix set it too, and banishing anything with any
		     coloured crucifix awarded that entity's corroded badge -- a badge
		     whose whole point is that it is rare. ]]
		if not session.active or session.crucifixVariant then return end

		local character = getCharacter()
		local held = character and character:FindFirstChildOfClass("Tool")
		if not held then return end

		local beats, key, variant = Core.CrucifixBeats(held, session.name)
		if not beats then return end

		local config = session.entity and session.entity.Config
		if not config then return end

		if config.Crucifixion.Resist then
			config.Crucifixion.Resist = false
			log(session.name, "you are holding the %s one -- it cannot resist that", key)
		end

		session.crucifixVariant = key
		session.rainbowRitual = variant.Rainbow == true

		-- Only the green one counts as a corroded banish.
		if key == "Corroded" then
			session.corroded = true
		end

		session.ritualColour = variant.Color
			or (session.profile.Corroded or {}).Color
			or Color3.fromRGB(86, 214, 92)
	end))

	if model:GetAttribute("BeingBanished") == true then
		resolve()
		return
	end

	session.janitor:Give(model:GetAttributeChangedSignal("BeingBanished"):Connect(function()
		if watching then return end
		if model:GetAttribute("BeingBanished") ~= true then return end
		resolve()
	end))
end

---====== REGISTRY ======---
--[[ Every entity script shares this module instance, so entities can see each
     other. That buys two things a per-script setup could not: the same entity
     cannot spawn twice at once, and being caught between two of them is its
     own achievement. ]]

local function liveCount()
	local count = 0
	for _ in pairs(Core.Active) do count += 1 end
	return count
end

local function register(session)
	Core.Active[session.name] = session

	local count = liveCount()
	if count > 1 then
		local names = {}
		for name in pairs(Core.Active) do table.insert(names, name) end
		table.sort(names)

		log(session.name, "two at once: %s", table.concat(names, " + "))
		Achievements:Award(doubleTroubleAchievement())
	end
end

local function unregister(session)
	if Core.Active[session.name] == session then
		Core.Active[session.name] = nil
	end
end

---====== CRUCIFIX ======---
--[[ Shared by both crucifix scripts, so the model is fetched once no matter
     which one you use.

     WHAT THE SPAWNER ACTUALLY CHECKS (Entity Spawner V2, line 281):

         local tool = Character:FindFirstChildOfClass("Tool")
         if tool and (tool.Name == name or tool:HasTag(name)) then

     A Tool, parented to your Character -- equipped, not sitting in the
     Backpack -- named "Crucifix" or tagged "Crucifix". That is the whole
     check. The spawner brings its own Repentance asset for the pentagram, so
     the tool needs no contents of its own, and it calls tool:Destroy() when it
     fires, which is how the counters below know one was spent. ]]

local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Crucifix = {
	template  = nil,  -- captured once, cloned after that
	current   = nil,  -- the live Tool
	given     = 0,
	spent     = 0,
	foundInDrawers = 0,
	source    = "none",
	searched  = {},   -- prompts already rummaged through
}

Core.Crucifix = Crucifix

--[[ These are the values you already run by hand, and they stay that way.

     An earlier version forced Range = 0, reasoning that the Entity Spawner
     should own crucifixion and the loader's own logic should stay inert. That
     was being clever about a script that cannot be read: if Range gates
     whether the tool is built at all, setting it to zero quietly switches the
     whole thing off. If you want to try the inert version, change it here and
     see whether a crucifix still appears. ]]
Crucifix.Loader = {
	Url     = "https://raw.githubusercontent.com/PenguinManiack/Crucifix/main/Crucifix.lua",
	Uses    = 1,
	Range   = 30,
	Timeout = 12,
}

local function collectTools(into)
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	for _, container in ipairs({ backpack, getCharacter() }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") then into[child] = true end
			end
		end
	end
end

local function firstUnseenTool(seen)
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	for _, container in ipairs({ backpack, getCharacter() }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") and not seen[child] then return child end
			end
		end
	end
	return nil
end

--[[ Runs the crucifix loader once and takes whatever Tool it drops.

     That script is MoonSec obfuscated, so this cannot sandbox it and does not
     pretend to. What it does do is run it ONCE per session rather than on
     every crucifix, set its own knobs before it runs, and then own the result
     -- the tool gets renamed, tagged and watched here, not there. ]]
local function runLoader()
	local settings = Crucifix.Loader

	local seen = {}
	collectTools(seen)

	logAlways("Crucifix", "running the model loader (Uses=%s, Range=%s)", tostring(settings.Uses), tostring(settings.Range))

	local ok, err = pcall(function()
		_G.Uses  = settings.Uses
		_G.Range = settings.Range
		loadstring(game:HttpGet(settings.Url))()
	end)

	if not ok then
		warn("[Gradish/Crucifix] the loader errored: " .. tostring(err))
		return nil
	end

	-- It may parent the tool a frame or several later.
	local deadline = os.clock() + settings.Timeout
	while os.clock() < deadline do
		local found = firstUnseenTool(seen)
		if found then return found end
		task.wait(0.1)
	end

	-- Nothing NEW showed up. The loader may refuse to build a second one in
	-- the same session, in which case an existing crucifix is the right
	-- answer rather than a failure.
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	for _, container in ipairs({ backpack, getCharacter() }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") and child.Name == "Crucifix" then
					logAlways("Crucifix", "no new tool, reusing the one already here")
					return child
				end
			end
		end
	end

	warn("[Gradish/Crucifix] the loader ran but produced no tool within "
		.. settings.Timeout .. "s")
	return nil
end

-- Last resort so you are never left with nothing. Two planks, and it works.
local function buildCrucifix()
	local tool = Instance.new("Tool")
	tool.RequiresHandle = true

	local handle = Instance.new("Part")
	handle.Name          = "Handle"
	handle.Size          = Vector3.new(0.22, 1.7, 0.22)
	handle.Color         = Color3.fromRGB(92, 64, 42)
	handle.Material      = Enum.Material.Wood
	handle.CanCollide    = false
	handle.CanQuery      = false
	handle.Massless      = true
	handle.TopSurface    = Enum.SurfaceType.Smooth
	handle.BottomSurface = Enum.SurfaceType.Smooth
	handle.Parent        = tool

	local bar = handle:Clone()
	bar.Name   = "Crossbar"
	bar.Size   = Vector3.new(0.95, 0.22, 0.22)
	bar.CFrame = handle.CFrame * CFrame.new(0, 0.42, 0)
	bar.Parent = tool

	local weld = Instance.new("WeldConstraint")
	weld.Part0  = handle
	weld.Part1  = bar
	weld.Parent = handle

	tool.Grip = CFrame.new(0, -0.45, 0) * CFrame.Angles(math.rad(-90), 0, 0)
	return tool
end

--[[ Deliberately light. The loader's tool arrives configured correctly, and
     touching more than the name and the tag is exactly what broke an earlier
     attempt at this. Only the two things the spawner reads are guaranteed. ]]
local function claim(tool)
	tool.Name = "Crucifix"
	pcall(function() CollectionService:AddTag(tool, "Crucifix") end)
	tool:SetAttribute("GradishCrucifix", true)
	return tool
end

function Crucifix:Obtain()
	if self.template then
		self.source = "template"
		return claim(self.template:Clone())
	end

	local fromLoader = runLoader()
	if fromLoader then
		self.source = "loader"
		self.template = fromLoader:Clone() -- pristine, taken before claiming
		return claim(fromLoader)
	end

	self.source = "built"
	return claim(buildCrucifix())
end

function Crucifix:Watch(tool)
	-- The spawner destroys the tool when the banish begins, so losing its
	-- ancestry is the signal that one was spent.
	tool.AncestryChanged:Connect(function(_, parent)
		if parent ~= nil then return end
		if self.current ~= tool then return end

		self.current = nil
		self.spent += 1
		logAlways("Crucifix", "used (%d spent)", self.spent)
	end)
end

--[[ reason is just for the log. equip = true puts it straight in your hand,
     which is what the dev giver wants; the drawer version leaves it in your
     backpack so you have to choose to hold it. ]]
function Crucifix:Give(reason, equip)
	local character = getCharacter()
	local humanoid  = getHumanoid()

	if not character or not humanoid or humanoid.Health <= 0 then
		return nil
	end

	if self.current and self.current.Parent then
		self.current:Destroy()
		self.current = nil
	end

	local ok, tool = pcall(function() return self:Obtain() end)
	if not ok or not tool then
		warn("[Gradish/Crucifix] could not obtain one: " .. tostring(tool))
		return nil
	end

	if tool.Parent == nil then
		tool.Parent = LocalPlayer:FindFirstChildOfClass("Backpack") or character
	end

	self.current = tool
	self.given += 1
	self:Watch(tool)

	if equip and tool.Parent ~= character then
		pcall(function() humanoid:EquipTool(tool) end)
		if tool.Parent ~= character then
			pcall(function() tool.Parent = character end)
		end
	end

	logAlways("Crucifix", "given via %s (%s)", self.source, reason or "manual")
	return tool
end

---====== CRUCIFIX: FOUND IN DRAWERS ======---
--[[ Rummage through furniture and occasionally one is in there.

     Hooking ProximityPromptService.PromptTriggered rather than hunting for
     specific models means this does not depend on knowing what DOORS calls
     its furniture: whatever you just searched, we see it.

     The name matching below IS a guess though, and an honest one. If your
     drawers are named something not in Hints, set Debug = true and the full
     path of everything you open gets printed, so you can read the real name
     off the console and add it. ]]

local DRAWER_HINTS = {
	"drawer", "dresser", "wardrobe", "cabinet", "closet",
	"chest", "desk", "shelf", "bin", "nightstand", "locker",
}

--[[ THIS IS NO LONGER A GUESS.

     Read straight out of a place dump of the game. Every drawer in DOORS is
     built the same way:

         Dresser / Drawer / Table        <Model>
           DrawerContainer               <Model>
             Event                       <BindableEvent>
             Constraint                  <PrismaticConstraint>
             Main                        <MeshPart>   (Open / Close sounds)
             Knobs                       <MeshPart>
               ActivateEventPrompt       <ProximityPrompt>
             LootHolder                  <Part>
               SpawnPile                 <Part>   (Paper, Pencil, Plywood)

     The prompt is called ActivateEventPrompt, it carries ActionText "Open" and
     ObjectText "Drawer", and it sits inside Knobs -- which is why it was not
     visible in a screenshot of DrawerContainer's direct children, and why I
     spent a while unsure whether drawers used prompts at all. They do.

     Counts in that dump: Drawer x20, Dresser x12, Table x2.

     So the match is now three exact checks, with the old fuzzy word list kept
     only as a last resort in case a room variant is built differently. ]]
local function looksLikeFurniture(prompt, hints)
	-- 1. The prompt's own name, straight from the game.
	if prompt.Name == "ActivateEventPrompt" then return true end

	-- 2. What it says on screen. Every drawer prompt reads "Open Drawer".
	if prompt.ObjectText == "Drawer" then return true end

	-- 3. Its container. Knobs sits inside DrawerContainer in every case.
	local node = prompt
	local depth = 0
	while node and depth < 4 do
		if node.Name == "DrawerContainer" then return true end
		node = node.Parent
		depth += 1
	end

	-- 4. Fallback: the original word matching, for anything unexpected.
	local text = ((prompt.ObjectText or "") .. " " .. (prompt.ActionText or "")):lower()

	node = prompt
	depth = 0
	while node and depth < 6 do
		local name = node.Name:lower()
		for _, hint in ipairs(hints) do
			if name:find(hint, 1, true) or text:find(hint, 1, true) then
				return true
			end
		end
		node = node.Parent
		depth += 1
	end

	return false
end

--[[ Whether this drawer still has its clutter in it.

     LootHolder is always present and always has a SpawnPile, so "empty
     LootHolder" was the wrong test -- I had guessed it before reading the
     dump. The item, when there is one, is a mesh inside SpawnPile alongside
     the fixed ItemSpawn and weld objects. ]]
local FURNITURE_FIXTURES = {
	ItemSpawn = true, ManualWeld = true, Weld = true,
	Container = true, HoldAttach = true, Attachment = true,
}

local function drawerStillHasLoot(prompt)
	local node = prompt
	local depth = 0
	local container

	while node and depth < 4 do
		if node.Name == "DrawerContainer" then container = node break end
		node = node.Parent
		depth += 1
	end
	if not container then return nil end

	local holder = container:FindFirstChild("LootHolder")
	local pile = holder and holder:FindFirstChild("SpawnPile")
	if not pile then return nil end

	for _, child in ipairs(pile:GetChildren()) do
		if not FURNITURE_FIXTURES[child.Name] then
			return true, child.Name
		end
	end

	return false
end

--[[ The odds are a rising curve, not a flat roll.

     A flat 12% was wrong in both directions: you search dozens of drawers in a
     DOORS run, so you would almost always find one within the first few rooms,
     and on an unlucky run you could search fifty and get nothing.

     So it starts low and climbs with every drawer you have opened without
     finding anything. Early searching is rarely rewarded, persistent searching
     always is eventually, and neither outcome feels arbitrary. MinRoom also
     keeps it out of the opening rooms entirely, where a crucifix would trivial-
     ise everything that comes next. ]]
---====== DEATH TYPES ======---
--[[ The spawner resolves Death.Type against its own two-entry table, and then
     against the children of

         PlayerGui.MainUI.Initiator.Main_Game.Health.Music

     which is the game's own list. Read out of the place dump, that list is:

         Yellow   the curious light
         Blue     the guiding light
         Glitch
         Static
         Rush

     So there were never two death types. There are five, the spawner already
     accepts all of them, and nobody had used the other three. Set DeathType on
     any profile to one of these names.

     Discovered again at runtime and written to the log, in case an update
     changes the list. ]]

--[[ CORRECTION: Static is not one of these.

     Health.Music is a Folder of Sounds named Yellow, Blue, Glitch and Rush.
     Static exists, but it is a child INSIDE Glitch, and the spawner only walks
     direct children of Music -- so DeathType = "Static" never resolves and
     falls through to the default. It was wrong here and wrong on Yeller. ]]
Core.DeathTypes = { "Yellow", "Blue", "Glitch", "Rush" }

function Core.DiscoverDeathTypes()
	local ok, found = pcall(function()
		local gui = LocalPlayer:FindFirstChild("PlayerGui")
		local music = gui and gui:FindFirstChild("MainUI")
		music = music and music:FindFirstChild("Initiator")
		music = music and music:FindFirstChild("Main_Game")
		music = music and music:FindFirstChild("Health")
		music = music and music:FindFirstChild("Music")
		if not music then return nil end

		local names = {}
		for _, child in ipairs(music:GetChildren()) do
			table.insert(names, child.Name)
		end
		return names
	end)

	if ok and found and #found > 0 then
		Core.DeathTypes = found
		logAlways("Core", "death types available: %s", table.concat(found, ", "))
	else
		logAlways("Core", "could not read Health.Music, using the known list: %s",
			table.concat(Core.DeathTypes, ", "))
	end

	return Core.DeathTypes
end

--[[ ADDING A DEATH TYPE THAT THE GAME DOES NOT HAVE.

     The spawner resolves Death.Type by walking the children of Health.Music
     and matching on name. That folder is an ordinary Folder of ordinary
     Sounds, sitting in PlayerGui where the client can write to it -- so a new
     death light is just a new child with the right name.

     Clone an existing entry (to inherit whatever properties the death screen
     reads), rename it, swap its SoundId, and DeathType = "Mischievous" starts
     resolving. Nothing in the spawner needs to change and nothing is patched.

     Each entry carries an End child, so that is cloned too and its sound
     swapped if one is given. ]]
function Core.RegisterDeathType(name, soundId, endSoundId, copyFrom)
	if isBlank(name) then return false end

	local ok, result = pcall(function()
		local gui = LocalPlayer:FindFirstChild("PlayerGui")
		local music = gui and gui:FindFirstChild("MainUI")
		music = music and music:FindFirstChild("Initiator")
		music = music and music:FindFirstChild("Main_Game")
		music = music and music:FindFirstChild("Health")
		music = music and music:FindFirstChild("Music")
		if not music then return "no Health.Music" end

		if music:FindFirstChild(name) then return "already there" end

		local template = music:FindFirstChild(copyFrom or "Blue")
			or music:FindFirstChildOfClass("Sound")
		if not template then return "nothing to clone" end

		local entry = template:Clone()
		entry.Name = name

		if not isBlank(soundId) then entry.SoundId = soundId end

		local ending = entry:FindFirstChild("End")
		if ending and not isBlank(endSoundId) then
			ending.SoundId = endSoundId
		end

		entry.Parent = music
		return true
	end)

	if ok and result == true then
		table.insert(Core.DeathTypes, name)
		logAlways("Core", "death type %q registered, cloned from %s", name, copyFrom or "Blue")
		return true
	end

	logAlways("Core", "could not register death type %q: %s", name, tostring(result))
	return false
end

---====== CUSTOM DEATH LIGHT ======---
--[[ The thing that appears when you die and tells you what killed you.

     Probed from the live game rather than guessed. MainUI.Death is an
     ImageLabel, and underneath it:

         Death              ImageLabel   the whole screen, ImageColor3 tints it
           Hodler
             Label          ImageLabel   the light character
               Label        ImageLabel   its colour lives HERE
             GlitchLabel                 the Glitch variant of the same
           Static           ImageLabel   the grain over everything
             Static
           HelpfulDialog    TextLabel    the hint text. TextColor3 was
                                         0.62, 0.94, 1 -- guiding-light blue
           GlitchDialog

     The spawner ends a death by firing DeathHint with a colour NAME, and the
     probe caught it: arg 2 was the string "Blue". DOORS' own code then paints
     those objects.

     WHY THIS OVERRIDES RATHER THAN REGISTERING A NEW NAME.

