-- Translates a Gradish profile into the shape Spawner:Create expects.
local function buildConfig(profile)
	local rebounds   = profile.Rebounds or {}
	local reboundMin = rebounds[1] or 0
	local reboundMax = rebounds[2] or 0

	local lights      = profile.Lights or {}
	local shake       = profile.CameraShake or {}
	local crucifixion = profile.Crucifixion or {}

	return {
		Entity = {
			Name         = profile.Name,
			Asset        = profile.Asset,
			HeightOffset = profile.HeightOffset or 0,
		},

		Lights = {
			Flicker = {
				Enabled  = lights.Flicker or false,
				Duration = lights.FlickerDuration or 1,
			},
			Shatter = lights.Shatter or false,
			Repair  = lights.Repair or false,
		},

		Earthquake = {
			Enabled = profile.Earthquake or false,
		},

		CameraShake = {
			Enabled = shake.Enabled or false,
			Range   = shake.Range or 100,
			Values  = shake.Values or { 30, 40, 0.1, 1 },
		},

		Movement = {
			Speed    = profile.Speed or 100,
			Delay    = profile.Delay or 0,
			Reversed = profile.Reversed or false,
		},

		Rebounding = {
			-- The spawner throws if this is enabled with a zero or inverted
			-- range, so the switch is derived rather than trusted.
			Enabled = (reboundMin > 0 and reboundMax >= reboundMin),
			Type    = profile.ReboundType or "Ambush",
			Min     = math.max(reboundMin, 1),
			Max     = math.max(reboundMax, 1),
			Delay   = profile.ReboundDelay or 0,
		},

		Damage = {
			Enabled      = true,
			IgnoreHiding = profile.IgnoreHiding or false,
			Range        = profile.DamageRange or 30,
			Amount       = profile.Damage or 125,
		},

		Crucifixion = {
			Enabled = crucifixion.Enabled ~= false,
			Type    = crucifixion.Type or "Guiding",
			Range   = crucifixion.Range or 40,
			Resist  = crucifixion.Resist or false,
			Break   = crucifixion.Break ~= false,
		},

		Death = {
			Type  = profile.DeathType or "Guiding",
			Hints = profile.DeathHints or { "You died to...", profile.Name },
			Cause = profile.DeathCause or profile.Name,
		},
	}
end

