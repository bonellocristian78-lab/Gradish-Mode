--[[
================================================================================

        G R A D I S H   C O R E

        Shared engine for every Gradish entity. Each entity script becomes a
        short profile; everything below is written once and used by all of
        them.

        HOW TO USE IT

            local Core = loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/main/GradishCore"
            ))()

            Core:Spawn({ Name = "Yeller", Asset = "...", ... })

        WHAT EVERY ENTITY NOW GETS FOR FREE
        -----------------------------------
        * Four achievements instead of one: survived, died, untouched, and
          banished with a crucifix. All of the wording lives in one file,
          AchievementConfig, so nobody has to edit four scripts to change a
          title.
        * Crucifixion detection, for all of them, without hijacking the ritual.
        * Light tells that RESTORE. The old scripts tinted rooms and never put
          them back, so the colour of a dead entity stayed on the map for the
          rest of the run.
        * Closet checks, escalation, multi-pass chains and encores. See the
          MECHANICS section.

        THREE THINGS I LEARNED FROM THE SPAWNER SOURCE, WRITTEN DOWN SO NOBODY
        HAS TO REDISCOVER THEM
        ---------------------------------------------------------------------
        1. entity:Run(true) deep-copies the entity, config included, and runs
           the COPY. Anything you change on your object afterwards is ignored.
           This core uses Run(false) so live tuning actually reaches the entity
           that is moving.

        2. Movement.Speed is not the number you wrote. Create() rewrites it as
           65 / 100 * yourSpeed. So escalation multiplies the stored value; it
           never assigns a raw one.

        3. The model attribute "Running" is set to true on run and never set
           back. Re-running the same entity object silently does nothing. Each
           extra pass therefore builds a fresh entity, which is exactly why the
           old nested Rebound script worked.

        MECHANICS (all of them are world actions, none of them draw on screen)
        ---------------------------------------------------------------------
        Tell         rooms ahead shift to the entity colour before it arrives
                     and shift back when it leaves, strongest nearest you
        ClosetCheck  if you are hiding as it passes, it stops beside your
                     closet for a moment before moving on
        Linger       it reaches YOUR room and stays a few seconds before
                     carrying on, still fully able to hurt you
        Escalate     every rebound makes it faster and widens its reach
        Variance     a few percent of random speed on every spawn, so you
                     cannot count it out
        Passes       run the entity several times in one visit, N rooms apart
        Encore       a chance it turns around and comes back after despawning
        Registry     entities know about each other; two at once is its own
                     achievement, and the same entity cannot double-spawn

        Two more subsystems live here rather than on any one entity:

        Core.Crucifix   owns the crucifix model, hands one out, and can hide
                        one in the furniture on a rising-odds search
        Core.RedSeek    paints the Seek chase models red and awards you for
                        living through one

================================================================================
]]

-- One instance shared by every entity script, so they all see the same
-- registry and the achievements library is fetched once.
if getgenv and getgenv().GradishCore then
	return getgenv().GradishCore
end

---====== SERVICES ======---

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

---====== CORE ======---

local Core = {
	Version = "1.0",
	Debug   = true,

	-- Live entities, by name. Cross-script, because every entity shares this
	-- module instance.
	Active = {},

	-- Achievement identifiers already granted this session.
	Granted = {},
}

---====== UTIL ======---

local function log(name, format, ...)
	if not Core.Debug then return end
	print(("[Gradish/%s] "):format(name) .. format:format(...))
end

-- Runs fn, reports failure, never lets it escape. A broken cosmetic must not
-- be able to stop an entity from moving.
local function safe(name, label, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warn(("[Gradish/%s] %s failed: %s"):format(name, label, tostring(err)))
	end
	return ok
end

local function tween(instance, duration, properties)
	if typeof(instance) ~= "Instance" then return nil end
	local info = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	local ok, animation = pcall(TweenService.Create, TweenService, instance, info, properties)
	if ok and animation then
		animation:Play()
		return animation
	end
	return nil
end

local function isBlank(value)
	return value == nil or value == ""
end

local function getCharacter()
	return LocalPlayer.Character
end

local function getHumanoid()
	local character = getCharacter()
	return character and character:FindFirstChildOfClass("Humanoid") or nil
end

local function getRoot()
	local character = getCharacter()
	return character and character:FindFirstChild("HumanoidRootPart") or nil
end

local function isPlayerDead()
	local humanoid = getHumanoid()
	return humanoid == nil or humanoid.Health <= 0
end

-- The spawner reads this same attribute to decide whether you are safe, so it
-- is the authoritative answer to "am I in a closet".
local function isHiding()
	local character = getCharacter()
	if not character then return false end
	return character:GetAttribute("Hiding") == true
end

local function currentRoomNumber()
	local data = ReplicatedStorage:FindFirstChild("GameData")
	local value = data and data:FindFirstChild("LatestRoom")
	return value and tonumber(value.Value) or 0
end

local function latestRoomValue()
	local data = ReplicatedStorage:FindFirstChild("GameData")
	return data and data:FindFirstChild("LatestRoom") or nil
end

local function getCurrentRooms()
	return Workspace:FindFirstChild("CurrentRooms")
end

--[[ Janitor. Hand it connections, instances or undo functions; Clean() runs
     everything in reverse. This is what guarantees a despawned entity leaves
     no tinted lights and no listeners behind. ]]
local Janitor = {}
Janitor.__index = Janitor

function Janitor.new()
	return setmetatable({ _tasks = {} }, Janitor)
end

function Janitor:Give(item)
	table.insert(self._tasks, item)
	return item
end

function Janitor:Clean()
	for index = #self._tasks, 1, -1 do
		local item = self._tasks[index]
		self._tasks[index] = nil

		pcall(function()
			if typeof(item) == "RBXScriptConnection" then
				item:Disconnect()
			elseif typeof(item) == "Instance" then
				item:Destroy()
			elseif type(item) == "function" then
				item()
			end
		end)
	end
end

---====== ACHIEVEMENTS ======---
--[[ One library instance for the whole mod, fetched on first use. Awards are
     queued with a gap, because two popups on the same frame make the DOORS
     achievement UI overwrite itself. ]]

local Achievements = {
	library  = nil,
	loaded   = false,
	queue    = {},
	draining = false,
}

function Achievements:Load()
	if self.loaded then return self.library end
	self.loaded = true

	local ok, result = pcall(function()
		return loadstring(game:HttpGet(
			"https://raw.githubusercontent.com/RegularVynixu/DOORS-Custom-Achievements/main/init.luau"
		))()
	end)

	if ok and result then
		self.library = result
	else
		warn("[Gradish] could not load the achievements library: " .. tostring(result))
	end

	return self.library
end

function Achievements:Drain()
	if self.draining then return end
	self.draining = true

	task.spawn(function()
		while #self.queue > 0 do
			local entry = table.remove(self.queue, 1)
			local library = self:Load()

			if library then
				pcall(function()
					library:Grant(entry, { CheckOwned = false, Remember = true })
				end)
			end

			print("[Gradish] achievement: " .. tostring(entry.Title))
			task.wait(2.6) -- let each popup finish before the next one starts
		end

		self.draining = false
	end)
end

function Achievements:Award(entry)
	if not entry or isBlank(entry.Identifier) then return end
	if Core.Granted[entry.Identifier] then return end

	Core.Granted[entry.Identifier] = true
	table.insert(self.queue, entry)
	self:Drain()
end

---====== ACHIEVEMENT CONFIG ======---
--[[ All the wording lives in one editable file so nobody has to go hunting
     through four entity scripts to change a title. Fetched once per session;
     if it is unreachable, every achievement still gets generated from the
     entity name and nothing breaks. ]]

local AchievementConfig = {
	Url    = "https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/main/AchievementConfig",
	data   = nil,
	loaded = false,
}

Core.AchievementConfig = AchievementConfig

function AchievementConfig:Get()
	if self.loaded then return self.data end
	self.loaded = true

	local ok, result = pcall(function()
		return loadstring(game:HttpGet(self.Url))()
	end)

	if ok and type(result) == "table" then
		self.data = result
	else
		warn("[Gradish] AchievementConfig unreachable, using generated names: " .. tostring(result))
		self.data = { Entities = {}, Special = {} }
	end

	return self.data
end

-- Pulls one of the shared achievements out of the config file.
local function specialAchievement(key, fallback)
	local data  = AchievementConfig:Get()
	local entry = (data.Special or {})[key]

	if type(entry) ~= "table" then
		entry = fallback
	end
	if not entry then return nil end

	-- A blank Image must be absent rather than empty, or the popup tries to
	-- load "" as a texture.
	local copy = {}
	for key2, value in pairs(entry) do copy[key2] = value end
	if isBlank(copy.Image) then copy.Image = nil end

	return copy
end

--[[ Builds the four achievements for an entity.

     Three layers, each overriding the one below it:
         1. generated from the entity name   (always works)
         2. AchievementConfig.Entities[name] (where you normally edit)
         3. profile.Achievements             (inline, for one-offs)

     Setting a key to false at either of the top two layers switches that
     achievement off. ]]
local function buildAchievements(profile)
	local name     = profile.Name
	local data     = AchievementConfig:Get()
	local fromFile = (data.Entities or {})[name] or {}
	local inline   = profile.Achievements or {}
	local image    = inline.Image or fromFile.Image or data.DefaultImage

	local function build(key, defaults)
		if inline[key] == false or fromFile[key] == false then return nil end

		local fileEntry   = type(fromFile[key]) == "table" and fromFile[key] or {}
		local inlineEntry = type(inline[key])   == "table" and inline[key]   or {}

		local entry = {
			Identifier = inlineEntry.Identifier or fileEntry.Identifier or defaults.Identifier,
			Title      = inlineEntry.Title      or fileEntry.Title      or defaults.Title,
			Desc       = inlineEntry.Desc       or fileEntry.Desc       or defaults.Desc,
			Reason     = inlineEntry.Reason     or fileEntry.Reason     or defaults.Reason,
		}

		local chosen = inlineEntry.Image or fileEntry.Image or image
		if not isBlank(chosen) then
			entry.Image = chosen
		end

		return entry
	end

	return {
		Survive = build("Survive", {
			Identifier = name,
			Title      = ("Survived %s"):format(name),
			Desc       = ("You walked away from %s"):format(name),
			Reason     = ("Survive an encounter with %s"):format(name),
		}),

		Death = build("Death", {
			Identifier = name .. " Victim",
			Title      = ("Died to %s"):format(name),
			Desc       = ("%s caught you"):format(name),
			Reason     = ("Die to %s"):format(name),
		}),

		Untouched = build("Untouched", {
			Identifier = name .. " Untouched",
			Title      = ("Untouched by %s"):format(name),
			Desc       = "Not a scratch on you",
			Reason     = ("Survive %s without taking a single hit"):format(name),
		}),

		Crucify = build("Crucify", {
			Identifier = name .. " Banished",
			Title      = ("Banished %s"):format(name),
			Desc       = ("%s met the crucifix"):format(name),
			Reason     = "Does not count towards progression",
		}),
	}
end

