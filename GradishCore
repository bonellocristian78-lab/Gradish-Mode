local function newStats()
	return {
		hits             = 0,
		rebounds         = 0,
		closetChecks     = 0,
		lingers          = 0,
		acidTicks        = 0,
		lowestHealth     = 100,
		died             = false,
		crucifixUsed     = false,
		crucifixBanished = false,
	}
end

-- Hands out the achievements this visit earned. Crucify is not here: the
-- watch awards that the moment the banish sticks.
local function finish(session)
	if session.finished then return end
	session.finished = true

	local stats = session.stats
	local list  = session.achievements

	log(session.name, "visit over | %s | %d hit(s) | %d rebound(s) | %d closet check(s) | %d linger(s) | %d acid burn(s)",
		stats.died and "DIED" or (stats.crucifixBanished and "BANISHED" or "SURVIVED"),
		stats.hits, stats.rebounds, stats.closetChecks, stats.lingers, stats.acidTicks or 0)

	--[[ ONLY stats.died decides the death badge.

	     It used to be `stats.died or isPlayerDead()`, and the second half is
	     global. So when Yeller killed you while Corrode was out, Corrode's
	     despawn saw a dead player and awarded "Dissolved" as well -- and the
	     schedule puts two entities on screen together often enough that this
	     was the normal case, not an edge one. Rude's kill, an acid kill and any
	     ordinary DOORS death all reached it the same way. isPlayerDead also
	     returns true while the Character is nil, so a despawn landing in the
	     respawn window awarded a death badge for an entity that never touched
	     you.

	     stats.died is per-session and is set only by this entity's own
	     OnDamagePlayer, or by its own acid. isPlayerDead survives purely as the
	     guard that stops Survive being handed to a corpse.

	     A Gradish entity that is merely present when something else kills you
	     now correctly awards nothing: it did not kill you, and you did not walk
	     away from it either. ]]
	if stats.died then
		if list.Death then Achievements:Award(list.Death) end

	elseif not isPlayerDead() then
		if list.Survive then Achievements:Award(list.Survive) end

		if stats.hits == 0 and list.Untouched then
			Achievements:Award(list.Untouched)
		end

	else
		log(session.name, "you died, but not to this one -- no award")
	end
end

-- Fills the forward declaration made above the acid mechanic.
finishSession = finish

local function waitRoomChanges(count)
	local value = latestRoomValue()
	if not value then
		task.wait(5)
		return
	end

	for _ = 1, count do
		value.Changed:Wait()
	end
end

---====== CORE:SPAWN ======---
--[[ profile fields, all optional except Name and Asset:

     Name, Asset, HeightOffset
     Speed, Delay, Reversed
     Damage, DamageRange, IgnoreHiding
     Rebounds = {min, max}, ReboundType, ReboundDelay
     Lights = { Flicker, FlickerDuration, Shatter, Repair }
     CameraShake = { Enabled, Range, Values }
     Earthquake
     DeathType, DeathHints, DeathCause
     Crucifixion = { Enabled, Type, Range, Resist, Break }

     Tell        = { Color, FadeIn, FadeOut, BrightnessBoost }
     ClosetCheck = { Enabled, Range, PauseFor, Chance, Cooldown }
     Escalate    = { SpeedPerRebound, RangePerRebound, MaxSpeedMultiplier, MaxRange }
     Passes, PassGap
     Encore      = { Chance, Delay, Reversed }
     Achievements = { Image, Survive = {...} or false, Death, Untouched, Crucify }

     Callbacks you can add on top: OnSpawned, OnStartMoving, OnEnterRoom,
     OnRebounding, OnDespawned, OnDamagePlayer. They receive the session. ]]

function Core:Spawn(profile, passIndex, carriedStats)
	assert(type(profile) == "table", "Core:Spawn needs a profile table")
	assert(not isBlank(profile.Name),  "profile.Name is required")
	assert(not isBlank(profile.Asset), "profile.Asset is required")

	--[[ Never spawn on top of one of the game's own.

	     Seek was already guarded. Rush and Ambush were not, and they are the
	     common case: a Gradish entity arriving mid-Rush gives you two things
	     to outrun in a corridor built for one, which is not difficulty, it is
	     just unfair. Their models carry these names while they are moving. ]]
	for _, name in ipairs({ "SeekMovingNewClone", "RushMoving", "AmbushMoving" }) do
		if Workspace:FindFirstChild(name) then
			log(profile.Name, "skipped, %s is already out there", name)
			return nil
		end
	end

	local pass = passIndex or 1

	-- One at a time. Without the shared registry each script could only
	-- guess at this.
	if pass == 1 and Core.Active[profile.Name] then
		log(profile.Name, "already out there, not spawning a second one")
		return nil
	end

	local session = {
		profile      = profile,
		name         = profile.Name,
		pass         = pass,
		passes       = profile.Passes or 1,
		janitor      = Janitor.new(),
		active       = false,
		finished     = false,
		entity       = nil,
		achievements = buildAchievements(profile),
		stats        = carriedStats or newStats(),
	}

	local ok, entity = pcall(function()
		return getSpawner():Create(buildConfig(profile))
	end)

	if not ok or not entity then
		warn(("[Gradish/%s] could not create the entity: %s"):format(profile.Name, tostring(entity)))
		return nil
	end

	session.entity = entity

	--[[ A small random speed difference on every spawn.

	     Fixed numbers are what make a fanmade entity feel like a script: the
	     third time you meet it you already know exactly how long you have.
	     Five percent either way is not enough to notice as unfairness, and it
	     is enough that you cannot count it out. ]]
	local variance = profile.Variance or 0
	if variance > 0 then
		local factor = 1 + (math.random() * 2 - 1) * variance
		entity.Config.Movement.Speed *= factor
		log(profile.Name, "arriving %+.0f%% off its usual pace", (factor - 1) * 100)
	end

	--[[ RESIST, AND THE CORRODED EXCEPTION

	     Some entities shrug the crucifix off. The spawner supports that with
	     Crucifixion.Resist, but it reads the flag once, at the moment the
	     ritual begins, so the decision has to be made now rather than when you
	     raise the crucifix.

	     Rose Hell uses this: nearly every attempt on her fails. Rarely, the
	     roll comes up corroded instead -- the ritual runs in a sick green
	     rather than the usual blue, and it works. That is the only way she
	     ever goes down to a crucifix, and it has its own achievement. ]]
	local crucifixion = profile.Crucifixion or {}
	local corroded = profile.Corroded

	if corroded and math.random() < (corroded.Chance or 0) then
		session.corroded     = true
		session.ritualColour = corroded.Color or Color3.fromRGB(90, 220, 90)
		entity.Config.Crucifixion.Resist = false

		log(profile.Name, "the crucifix is CORRODED this time -- it will work")

	elseif crucifixion.ResistChance and math.random() < crucifixion.ResistChance then
		entity.Config.Crucifixion.Resist = true
		log(profile.Name, "will resist the crucifix this time")
	end

	local function hook(name, fn)
		entity:SetCallback(name, fn)
	end

	local function custom(name, ...)
		local fn = profile[name]
		if type(fn) == "function" then
			safe(session.name, name .. " hook", fn, session, ...)
		end
	end

	---------------------------------------------------------------- spawned
	hook("OnSpawned", function()
		session.active = true
		log(session.name, "spawned (pass %d of %d)", session.pass, session.passes)

		register(session)

		safe(session.name, "tell",        startTell, session)
		safe(session.name, "closet check",startClosetCheck, session)
		safe(session.name, "linger",      startLinger, session)
		safe(session.name, "acid trail", startAcidTrail, session)
		safe(session.name, "escalation",  setupEscalation, session)
		safe(session.name, "crucifix watch", startCrucifixionWatch, session)

		custom("OnSpawned")
	end)

	hook("OnStartMoving", function()
		custom("OnStartMoving")
	end)

	hook("OnEnterRoom", function(room, firstTime)
		-- Keep the tell ahead of the entity as the map keeps generating.
		if session.tintAhead then
			pcall(session.tintAhead)
		end

		-- It has walked into the room you are standing in.
		if session.linger and isPlayersRoom(room) then
			safe(session.name, "linger", session.linger)
		end

		custom("OnEnterRoom", room, firstTime)
	end)

	hook("OnLookAt", function(lineOfSight)
		session.lookingAt = lineOfSight
	end)

	hook("OnRebounding", function(startOfRebound)
		if startOfRebound then
			session.stats.rebounds += 1
			safe(session.name, "escalate", escalate, session)
		end
		custom("OnRebounding", startOfRebound)
	end)

	hook("OnDespawning", function()
		custom("OnDespawning")
	end)

	---------------------------------------------------------------- despawn
	--[[ Stands in for OnDespawned when the entity is banished.

	     The crucifix ritual destroys the model directly rather than going
	     through Despawn(), so that callback never arrives. Everything the
	     despawn path would have done has to happen here instead, or a
	     crucified entity leaves its lights tinted and its achievements
	     unawarded. Passes and encores are deliberately skipped: a banished
	     entity is gone. ]]
	session.onBanished = function()
		if not session.active then return end

		session.active = false
		unregister(session)
		finish(session)

		task.delay(1.5, function()
			safe(session.name, "cleanup", function() session.janitor:Clean() end)
		end)
	end

	hook("OnDespawned", function()
		session.active = false
		unregister(session)
		log(session.name, "despawned")

		custom("OnDespawned")

		-- Put the world back before anything else decides what happens next.
		task.delay(1.5, function()
			safe(session.name, "cleanup", function() session.janitor:Clean() end)
		end)

		local stats = session.stats

		-- A banished or lethal entity does not come back.
		if stats.died or stats.crucifixBanished then
			finish(session)
			return
		end

		-- Another scheduled pass of the same visit.
		if session.pass < session.passes then
			task.spawn(function()
				waitRoomChanges(profile.PassGap or 2)
				-- A fresh entity each time: the Running attribute is never
				-- reset, so re-running this one would silently do nothing.
				Core:Spawn(profile, session.pass + 1, stats)
			end)
			return
		end

		-- Encore: it turns around and comes back.
		local encore = profile.Encore
		if encore and not session.encored and math.random() < (encore.Chance or 0) then
			session.encored = true

			task.spawn(function()
				task.wait(encore.Delay or 3)

				local returning = {}
				for key, value in pairs(profile) do returning[key] = value end
				returning.Passes = 1
				returning.Encore = nil
				if encore.Reversed ~= false then
					returning.Reversed = not profile.Reversed
				end

				log(session.name, "encore, coming back the other way")
				Core:Spawn(returning, 1, stats)
			end)
			return
		end

		finish(session)
	end)

	------------------------------------------------------------------ damage
	hook("OnDamagePlayer", function(newHealth)
		local stats = session.stats
		stats.hits += 1
		stats.lowestHealth = math.min(stats.lowestHealth, math.max(newHealth, 0))

		if newHealth <= 0 then
			stats.died = true
			log(session.name, "killed the player")

			-- Whose light appears on the death screen. Armed before the
			-- screen exists, because the spawner fires DeathHint immediately.
			if profile.DeathLight then
				safe(session.name, "arm death light", function()
					Core.DeathLight:Arm(profile.DeathLight)
				end)
			end
			-- Award now: the entity may keep running long after you drop.
			finish(session)
		else
			log(session.name, "hit you, %d HP left", newHealth)
		end

		custom("OnDamagePlayer", newHealth)
	end)

	--[[ Run(false), not Run(true).

	     Run(true) deep-copies the entity and runs the copy, which means the
	     object we are holding is not the one moving and every live tweak
	     below -- escalation, pause, resume -- would land on a discarded
	     table. Each pass already builds a fresh entity, so there is nothing
	     for the copy to protect. ]]
	entity:Run(false)

	return session
end

---====== HELPERS FOR ENTITY SCRIPTS ======---

-- True if any Gradish entity is currently out.
--[[ Public award, for entities that are not built on Spawner:Create.

     Rude is the reason this exists: he stands still and changes the rules
     rather than walking a path, so he never goes through Core:Spawn and never
     gets a session -- but his achievements still belong in the same queue, or
     two popups land on the same frame and eat each other. ]]
function Core.AwardAchievement(entry)
	Achievements:Award(entry)
end

function Core:AnyActive()
	return liveCount() > 0
end

function Core:IsActive(name)
	return Core.Active[name] ~= nil
end

function Core:ActiveNames()
	local names = {}
	for name in pairs(Core.Active) do table.insert(names, name) end
	table.sort(names)
	return names
end

