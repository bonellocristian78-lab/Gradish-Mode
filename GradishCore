-- Does this crucifix beat that entity?
function Core.CrucifixBeats(tool, entityName)
	if not tool then return false end

	local key = tool:GetAttribute("CrucifixVariant")

	-- The old attribute, kept so a crucifix from a previous version still works.
	if not key and tool:GetAttribute("Corroded") then key = "Corroded" end
	if not key then return false end

	local variant = Core.CrucifixVariants[key]
	if not variant then return false end

	if variant.Beats == "*" then return true, key, variant end

	if type(variant.Beats) == "table" then
		for _, name in ipairs(variant.Beats) do
			if name == entityName then return true, key, variant end
		end
	end

	return false, key, variant
end

local function tintTool(tool, colour)
	local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
	if not handle then return nil end

	local existing = handle:FindFirstChild("VariantTint")
	if existing then existing:Destroy() end

	local highlight
	pcall(function()
		highlight = Instance.new("Highlight")
		highlight.Name                = "VariantTint"
		highlight.FillColor           = colour
		highlight.FillTransparency    = 0.4
		highlight.OutlineColor        = colour
		highlight.OutlineTransparency = 0.15
		highlight.DepthMode           = Enum.HighlightDepthMode.Occluded
		highlight.Adornee             = handle
		highlight.Parent              = handle
	end)

	pcall(function() handle.Color = colour end)

	for _, descendant in ipairs(tool:GetDescendants()) do
		pcall(function()
			if descendant:IsA("ParticleEmitter") or descendant:IsA("Beam") then
				descendant.Color = ColorSequence.new(colour)
			elseif descendant:IsA("Light") then
				descendant.Color = colour
			end
		end)
	end

	local glow = handle:FindFirstChild("VariantGlow")
	if not glow then
		pcall(function()
			glow = Instance.new("PointLight")
			glow.Name       = "VariantGlow"
			glow.Brightness  = 1.2
			glow.Range       = 10
			glow.Parent      = handle
		end)
	end
	if glow then pcall(function() glow.Color = colour end) end

	return highlight, glow
end

function Core.MakeVariant(tool, key)
	if not tool then return nil end

	local variant = Core.CrucifixVariants[key]
	if not variant then
		logAlways("Crucifix", "no variant called %q", tostring(key))
		return tool
	end

	tool:SetAttribute("CrucifixVariant", key)
	tool.ToolTip = variant.Tooltip or key

	if variant.Rainbow then
		--[[ Cycles rather than sitting on one colour. A thing that beats every
		     entity in the game should not look like the other three. ]]
		local highlight, glow = tintTool(tool, Color3.fromRGB(255, 255, 255))

		task.spawn(function()
			local hue = 0
			while tool.Parent do
				hue = (hue + 0.012) % 1
				local colour = Color3.fromHSV(hue, 0.85, 1)

				pcall(function()
					if highlight then
						highlight.FillColor = colour
						highlight.OutlineColor = colour
					end
					if glow then glow.Color = colour end
				end)

				task.wait(0.05)
			end
		end)
	else
		tintTool(tool, variant.Color)
	end

	logAlways("Crucifix", "%s crucifix -- %s", key, variant.Note or "")
	return tool
end

-- Kept so older calls still work.
function Core.MakeCorroded(tool, colour)
	return Core.MakeVariant(tool, "Corroded")
end

function Loot:Pick(settings)
	local pool = {}
	local total = 0

	for _, entry in ipairs(LOOT_TABLE) do
		local weight = entry.Weight or 0

		-- Per-item caps, so you cannot end a run holding four crucifixes.
		local cap = (settings.Caps or {})[entry.Key]
		if cap and (self.found[entry.Key] or 0) >= cap then
			weight = 0
		end

		if weight > 0 then
			total += weight
			table.insert(pool, { entry = entry, upTo = total })
		end
	end

	if total == 0 then return nil end

	local roll = math.random() * total
	for _, slot in ipairs(pool) do
		if roll <= slot.upTo then return slot.entry end
	end

	return pool[#pool] and pool[#pool].entry or nil
end

function Loot:Grant(entry, equip)
	self.found[entry.Key] = (self.found[entry.Key] or 0) + 1

	if entry.FromLoader then
		local tool = Core.Crucifix:Give("found in furniture", equip)

		if tool and entry.Variant then
			Core.MakeVariant(tool, entry.Variant)
		end

		return tool
	end

	local ok, tool = pcall(entry.Build)
	if not ok or not tool then
		logAlways("Loot", "could not build %s: %s", entry.Key, tostring(tool))
		return nil
	end

	local character = LocalPlayer.Character
	tool.Parent = LocalPlayer:FindFirstChildOfClass("Backpack") or character

	if equip and character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then pcall(function() humanoid:EquipTool(tool) end) end
	end

	return tool
end

---====== SHOWING IT IN THE DRAWER ======---
--[[ Without this, finding a crucifix is a line in the console and a tool that
     quietly appears in your backpack. You can easily search the drawer that
     had it and never notice.

     So it gets put where the game puts loot. From the dump:

         DrawerContainer > LootHolder > SpawnPile > ItemSpawn

     ItemSpawn is the anchor point the clutter is welded around, so that is
     where the crucifix goes, with a Highlight on it. A Highlight tints through
     materials and textures, and more to the point it draws through the drawer
     front, so the glow is visible the moment the drawer slides open. ]]

local function findSpawnPile(prompt)
	local node, depth = prompt, 0
	local container

	while node and depth < 4 do
		if node.Name == "DrawerContainer" then
			container = node
			break
		end
		node = node.Parent
		depth += 1
	end
	if not container then return nil end

	local holder = container:FindFirstChild("LootHolder")
	local pile = holder and holder:FindFirstChild("SpawnPile")

	return pile, container
end

--[[ What to show in the drawer, per item.

     It used to build a crucifix whatever the roll produced -- the log caught
     it: "there is vitamins in this one", and a crucifix was placed. Each entry
     now draws itself, and anything without a builder shows nothing rather
     than lying about what is in there. ]]
local function decorate(part, colour, material)
	part.Color         = colour
	part.Material      = material or Enum.Material.SmoothPlastic
	part.Anchored      = true
	part.CanCollide    = false
	part.CanQuery      = false
	part.CanTouch      = false
	part.CastShadow    = false
	part.Massless      = true
	part.TopSurface    = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

local ITEM_VISUALS = {
	Bandage = function()
		local part = Instance.new("Part")
		part.Size = Vector3.new(0.5, 0.22, 0.42)
		return decorate(part, Color3.fromRGB(240, 235, 220))
	end,

	Glowstick = function()
		local part = Instance.new("Part")
		part.Size = Vector3.new(0.9, 0.16, 0.16)
		decorate(part, Color3.fromRGB(120, 255, 160), Enum.Material.Neon)
		part.Transparency = 0.15
		return part
	end,

	Vitamins = function()
		local part = Instance.new("Part")
		part.Size = Vector3.new(0.34, 0.5, 0.34)
		return decorate(part, Color3.fromRGB(255, 180, 60))
	end,
}

-- The crucifixes all share a shape and differ only in colour.
local function crucifixVisual(colour)
	local shaft = Instance.new("Part")
	shaft.Name = "GradishCrucifixLoot"
	shaft.Size = Vector3.new(0.14, 0.95, 0.14)
	decorate(shaft, colour, Enum.Material.Wood)

	local bar = Instance.new("Part")
	bar.Name = "Bar"
	bar.Size = Vector3.new(0.5, 0.14, 0.14)
	decorate(bar, colour, Enum.Material.Wood)

	return shaft, bar
end

function Crucifix:ShowInDrawer(prompt, tool, settings, entry)
	settings = settings or {}
	if settings.Enabled == false then return end
	if not entry then return end

	local pile, container = findSpawnPile(prompt)
	if not pile then
		logAlways("Crucifix", "no SpawnPile on %s, showing nothing", prompt:GetFullName())
		return
	end

	local anchorPart = pile:FindFirstChild("ItemSpawn") or pile
	local ok, anchor = pcall(function()
		if anchorPart:IsA("BasePart") then return anchorPart.CFrame end
		return anchorPart:GetPivot()
	end)
	if not ok or not anchor then
		logAlways("Crucifix", "no anchor inside %s", pile:GetFullName())
		return
	end

	--[[ The right shape for the thing you actually found. A crucifix for
	     everything was the bug the log caught. ]]
	local parts = {}
	local colour = settings.Color or Color3.fromRGB(255, 238, 170)

	if entry.FromLoader then
		local variant = entry.Variant and Core.CrucifixVariants[entry.Variant]
		local woodColour = (variant and variant.Color) or Color3.fromRGB(150, 110, 70)
		if entry.Variant == "Rainbow" then woodColour = Color3.fromRGB(255, 255, 255) end

		local shaft, bar = crucifixVisual(woodColour)
		shaft.CFrame = anchor * CFrame.new(0, 0.25, 0)
		bar.CFrame   = shaft.CFrame * CFrame.new(0, 0.2, 0)
		parts = { shaft, bar }

		if variant then colour = variant.Color or colour end

	elseif ITEM_VISUALS[entry.Key] then
		local part = ITEM_VISUALS[entry.Key]()
		part.Name = "GradishLoot"
		part.CFrame = anchor * CFrame.new(0, 0.2, 0)
		parts = { part }
		colour = part.Color

	else
		logAlways("Crucifix", "no drawer visual for %s, showing nothing", entry.Key)
		return
	end

	for _, part in ipairs(parts) do
		part.Parent = pile
	end

	-- Highlight adorns one thing, so the pieces go under a Model.
	local holder = parts[1]

	local highlight = Instance.new("Highlight")
	highlight.Name                = "GradishLootGlow"
	highlight.FillColor           = colour
	highlight.FillTransparency    = settings.FillTransparency or 0.25
	highlight.OutlineColor        = colour
	highlight.OutlineTransparency = 0
	highlight.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Adornee             = holder
	highlight.Parent              = holder

	local drawerGlow
	if settings.GlowDrawer and container then
		drawerGlow = Instance.new("Highlight")
		drawerGlow.Name                = "GradishDrawerGlow"
		drawerGlow.FillColor           = colour
		drawerGlow.FillTransparency    = 0.75
		drawerGlow.OutlineColor        = colour
		drawerGlow.OutlineTransparency = 0.2
		drawerGlow.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
		drawerGlow.Adornee             = container
		drawerGlow.Parent              = container
	end

	logAlways("Crucifix", "placed %s (%d part(s)) at %s",
		entry.Key, #parts, pile:GetFullName())

	task.spawn(function()
		local deadline = os.clock() + (settings.Duration or 10)

		while os.clock() < deadline and holder.Parent do
			local wave = 0.15 + 0.2 * math.abs(math.sin(os.clock() * 2))
			pcall(function() highlight.FillTransparency = wave end)
			task.wait(0.05)
		end

		for _, part in ipairs(parts) do
			pcall(function() part:Destroy() end)
		end
		if drawerGlow then pcall(function() drawerGlow:Destroy() end) end
	end)
end

function Crucifix:EnableDrawers(settings)
	settings = settings or {}

	local base       = settings.Chance or 0.04
	local ramp       = settings.RampPerSearch or 0.012
	local ceiling    = settings.MaxChance or 0.4
	local minRoom    = settings.MinRoom or 10
	local maxPerRun  = settings.MaxPerRun or 1
	local hints      = settings.Hints or DRAWER_HINTS
	local anyPrompt  = settings.AnyPrompt or false
	local equip      = settings.AutoEquip or false
	local debugMode  = settings.Debug or false

	if self.drawersEnabled then return end
	self.drawersEnabled = true

	local searches = 0

	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if player ~= LocalPlayer then return end

		if debugMode then
			logAlways("Crucifix", "you opened: %s  (ObjectText=%q ActionText=%q)", prompt:GetFullName(), tostring(prompt.ObjectText), tostring(prompt.ActionText))
		end

		if self.foundInDrawers >= maxPerRun then return end

		-- Not furniture: costs you nothing, does not count as a search.
		if not anyPrompt and not looksLikeFurniture(prompt, hints) then return end

		-- One roll per piece of furniture. No standing there spamming it.
		-- A forced test ignores both this and the room floor, or you could
		-- not test in the room you happen to be standing in.
		if not self.forceNext then
			if self.searched[prompt] then return end
			self.searched[prompt] = true

			if currentRoomNumber() < minRoom then return end
		end

		local odds = math.min(base + ramp * searches, ceiling)
		searches += 1

		if debugMode then
			local hasLoot, what = drawerStillHasLoot(prompt)
			logAlways("Crucifix", "search %d, odds %.1f%%, clutter: %s", searches, odds * 100, hasLoot and what or tostring(hasLoot))
		end

		if not self.forceNext and math.random() > odds then return end
		self.forceNext = false

		self.foundInDrawers += 1
		logAlways("Crucifix", "there is something in this one")

		task.wait(settings.Delay or 0.35) -- let the drawer finish opening

		--[[ ORDER MATTERS HERE, and getting it wrong is why this looked dead.

		     Give() runs the crucifix loader, which on the first call takes up
		     to twelve seconds. Showing the drawer visual afterwards meant it
		     appeared long after the drawer had slid shut and you had walked
		     off -- indistinguishable from nothing happening at all.

		     The visual goes first, immediately, while the drawer is still
		     open. The tool arrives when it arrives. ]]
		local entry = Core.Loot:Pick(settings)
		if not entry then
			logAlways("Crucifix", "loot table is empty, nothing to give")
			return
		end

		logAlways("Crucifix", "there is %s in this one", entry.Label or entry.Key)

		safe("Crucifix", "show in drawer", function()
			self:ShowInDrawer(prompt, self.template, settings.Highlight or {}, entry)
		end)

		local tool = Core.Loot:Grant(entry, equip)

		-- The find achievement is for the crucifix specifically, which is
		-- what it has always said on it.
		if tool and entry.FromLoader then
			Achievements:Award(crucifixFoundAchievement())
		end
	end)

	--[[ A four percent chance that climbs slowly is unplayable to TEST. This
	     makes the next drawer you open a guaranteed find, so the placement,
	     the glow and the handover can be checked in one go rather than by
	     opening forty drawers and hoping. ]]
	if settings.ForceKey then
		local UserInputService = game:GetService("UserInputService")

		UserInputService.InputBegan:Connect(function(input, processed)
			if processed or input.KeyCode ~= settings.ForceKey then return end

			self.forceNext = true
			self.foundInDrawers = 0  -- lift the per-run cap for the test
			logAlways("Crucifix", "forced: the NEXT drawer you open has one")
		end)

		logAlways("Crucifix", "press %s to force the next drawer", settings.ForceKey.Name)
	end

	logAlways("Crucifix", "drawer search armed (from %d%%, +%.1f%% each, room %d onward, %d per run)", math.floor(base * 100 + 0.5), ramp * 100, minRoom, maxPerRun)
end

---====== RED SEEK ======---
--[[ Turns the Seek chase models red, and awards you for living through one.

     Two models are handled: SeekMovingNewClone, which is the chase Seek that
     the entity scripts already check for before spawning, and Eye.

     WHY IT IS NOT JUST part.Color = red
     -----------------------------------
     A BasePart wearing a SurfaceAppearance or a MeshPart with a TextureID
     draws the texture, not the colour, so setting Color on those does exactly
     nothing visible. Stripping them is what actually makes the model red.
     That is destructive to the local copy of the model, which is fine here --
     it is a clone that gets thrown away when the chase ends -- but it is the
     reason StripTextures exists as a switch rather than being unconditional.

     The chase model also streams its parts in rather than arriving complete,
     so DescendantAdded keeps painting whatever shows up late. ]]

local RedSeek = {
	enabled = false,
	tracked = {},
	settings = nil,
}

Core.RedSeek = RedSeek

local function paintInstance(instance, colour, strip)
	if instance:IsA("BasePart") then
		instance.Color = colour

		if strip then
			-- PBR and mesh textures both win over Color, so they have to go.
			local appearance = instance:FindFirstChildOfClass("SurfaceAppearance")
			if appearance then appearance:Destroy() end

			if instance:IsA("MeshPart") and instance.TextureID ~= "" then
				instance.TextureID = ""
			end
		end

	elseif instance:IsA("Decal") or instance:IsA("Texture") then
		instance.Color3 = colour

	elseif instance:IsA("ParticleEmitter") or instance:IsA("Beam") then
		instance.Color = ColorSequence.new(colour)

	elseif instance:IsA("Light") then
		instance.Color = colour

	elseif instance:IsA("SurfaceAppearance") and strip then
		instance:Destroy()
	end
end

--[[ A Highlight is the thing that actually makes something red.

     Setting Color on every part was the original approach and it is not
     enough: a MeshPart wearing a SurfaceAppearance or a TextureID draws the
     texture and ignores Color completely, and if the underlying part happens
     to be black then stripping the texture leaves you with black, not red.
     That is exactly the "he is always black" result.

     A Highlight sits on top of the whole model and tints it regardless of
     material, texture or mesh, which is why it goes on first and the
     per-part colouring is now the backup rather than the plan. ]]
local function addHighlight(model, colour, settings)
	if not settings.UseHighlight then return nil end

	local existing = model:FindFirstChild("GradishRedTint")
	if existing then return existing end

	local highlight = Instance.new("Highlight")
	highlight.Name              = "GradishRedTint"
	highlight.FillColor         = colour
	highlight.FillTransparency  = settings.FillTransparency or 0.35
	highlight.OutlineColor      = colour
	highlight.OutlineTransparency = settings.OutlineTransparency or 0
	highlight.DepthMode         = Enum.HighlightDepthMode.Occluded
	highlight.Adornee           = model
	highlight.Parent            = model

	return highlight
end

local function paintModel(model, colour, strip, settings)
	settings = settings or {}

	pcall(function() addHighlight(model, colour, settings) end)
	pcall(function() paintInstance(model, colour, strip) end)

	local painted, parts = 0, 0
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then parts += 1 end

		local ok = pcall(function() paintInstance(descendant, colour, strip) end)
		if ok then painted += 1 end
	end

	logAlways("RedSeek", "%s: %d descendant(s), %d BasePart(s), highlight=%s", model.Name, painted, parts, tostring(settings.UseHighlight ~= false))
end

function RedSeek:Track(model)
	if self.tracked[model] then return end
	self.tracked[model] = true

	local settings = self.settings
	local colour   = settings.Color
	local strip    = settings.StripTextures

	logAlways("RedSeek", "painting %s at %s", model.Name, model:GetFullName())
	paintModel(model, colour, strip, settings)

	-- The chase model builds itself up over a second or two, so anything that
	-- arrives after the first pass gets painted as it lands.
	local streaming
	streaming = model.DescendantAdded:Connect(function(descendant)
		task.defer(function()
			pcall(function() paintInstance(descendant, colour, strip) end)
		end)
	end)

	local isSeek = (model.Name == settings.SeekName)

	local leaving
	leaving = model.AncestryChanged:Connect(function(_, parent)
		if parent ~= nil then return end

		pcall(function() streaming:Disconnect() end)
		pcall(function() leaving:Disconnect() end)
		self.tracked[model] = nil

		if not isSeek then return end

		--[[ The model is removed both when you escape and when it catches
		     you, so surviving has to be checked rather than assumed. The
		     short wait is for the case where the killing blow and the model
		     removal land on the same frame: without it you can be awarded a
		     survival a moment before your health reaches zero. ]]
		task.spawn(function()
			task.wait(settings.DeathGrace or 1.5)

			if isPlayerDead() then
				logAlways("RedSeek", "he got you")
				return
			end

			logAlways("RedSeek", "you made it out")
			Achievements:Award(redSeekAchievement())
		end)
	end)
end

--[[ FindFirstChild returns ONE match. That was the bug behind "the wall eyes
     do not work either": there are many objects named Eye in a run and only
     the first one ever got painted. This walks the whole tree and takes all
     of them. ]]
function RedSeek:Scan()
	local wanted = {}
	for _, name in ipairs(self.settings.Models) do wanted[name] = true end

	for _, descendant in ipairs(Workspace:GetDescendants()) do
		if wanted[descendant.Name] and not self.tracked[descendant] then
			-- Only Models and Parts: a Sound called Eye is not a wall eye.
			if descendant:IsA("Model") or descendant:IsA("BasePart") then
				self:Track(descendant)
			end
		end
	end
end

function RedSeek:Enable(settings)
	if self.enabled then return end
	self.enabled = true

	settings = settings or {}

	self.settings = {
		Color         = settings.Color or Color3.fromRGB(255, 0, 0),
		Models        = settings.Models or { "SeekMovingNewClone", "Eye" },
		SeekName      = settings.SeekName or "SeekMovingNewClone",
		StripTextures = settings.StripTextures ~= false,
		DeathGrace    = settings.DeathGrace or 1.5,
		PollInterval  = settings.PollInterval or 2,

		-- The Highlight is what actually makes him red. Per-part colouring is
		-- the fallback for anything a Highlight will not cover.
		UseHighlight        = settings.UseHighlight ~= false,
		FillTransparency    = settings.FillTransparency or 0.35,
		OutlineTransparency = settings.OutlineTransparency or 0,
	}

	local wanted = {}
	for _, name in ipairs(self.settings.Models) do wanted[name] = true end

	-- Direct children of Workspace are caught the instant they appear.
	Workspace.ChildAdded:Connect(function(child)
		if not wanted[child.Name] then return end
		task.wait(0.1) -- let it finish parenting its first parts
		pcall(function() self:Track(child) end)
	end)

	-- And a slow poll for anything that turns up nested rather than at the
	-- top level. Two name lookups every couple of seconds is cheap; hooking
	-- Workspace.DescendantAdded instead would fire on every part in the game.
	task.spawn(function()
		while self.enabled do
			pcall(function() self:Scan() end)
			task.wait(self.settings.PollInterval)
		end
	end)

	self:Scan()

	logAlways("RedSeek", "armed for: %s", table.concat(self.settings.Models, ", "))
end

