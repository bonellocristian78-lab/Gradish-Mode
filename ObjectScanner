-- DOORS' scanner, ObjectScanner.rbxm: the Nokia itself, and for every kind its animations, its screen, its sounds and its star
local REPO = "https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/"
local BRANCHES = { "main", "claude/sei-qui-con-noi-ye4k62" }
local function loadModel()
	for _, branch in ipairs(BRANCHES) do
		local ok, body = pcall(function() return game:HttpGet(REPO .. branch .. "/ObjectScanner.rbxm") end)
		if ok and type(body) == "string" and body:sub(1, 8) == "<roblox!" then
			local loaded, model = pcall(function()
				if not isfolder("ObjectScanner") then makefolder("ObjectScanner") end
				writefile("ObjectScanner/ObjectScanner.rbxm", body)
				return game:GetObjects(getcustomasset("ObjectScanner/ObjectScanner.rbxm"))[1]
			end)
			if loaded and model then return model end
		end
	end
	return nil
end
local template = loadModel()
if not template then
	warn("[Scanner] its model could not be loaded")
	return
end
local SCREEN_UI = template.Handle.Top.Screen.ScreenUI

