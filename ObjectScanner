-- MAP (the GameBoy's): the room you are in and the next, from above, turning as you turn; bright: what is worth finding, the door
FN.MAP = { label = "MAP", clean = true }
do
	local m = { token = 0 }
	local function above(d, floor) -- a ceiling, a lamp: flat, over your head (DOORS tags its ceilings)
		if CollectionService:HasTag(d, "PartCeiling") then return true end
		local cf, s = d.CFrame, d.Size
		local tall = math.abs(cf.RightVector.Y) * s.X + math.abs(cf.UpVector.Y) * s.Y + math.abs(cf.LookVector.Y) * s.Z
		return tall < 3 and cf.Position.Y > floor + 4
	end
	local function mark(at, size, shape)
		local p = Instance.new("Part")
		p.Shape = shape
		p.Size = size
		p.Material = Enum.Material.Neon
		p.Color = Color3.new(1, 1, 1)
		p.Anchored = true
		p.CFrame = CFrame.new(at)
		p.Parent = m.world
		table.insert(m.marks, p)
	end
	local function build(room)
		m.token += 1
		local token = m.token
		m.room, m.moving, m.marks = room, {}, {}
		m.world:ClearAllChildren()
		local root = myRoot()
		if not (room and root) then return end
		local floor = root.Position.Y - 3
		local list = { room, roomAt(1) }
		local holder = Instance.new("Model")
		holder.Parent = m.world
		task.spawn(function()
			for _, r in ipairs(list) do
				copyRoom(r, holder, function(d) return d.Size.Magnitude > 1.5 and not above(d, floor) end, m.moving, function() return m.token == token end)
			end
		end)
		for i in pairs(index.worth) do
			for _, r in ipairs(list) do
				if i:IsDescendantOf(r) then mark(whereIs(i) + Vector3.new(0, 6, 0), Vector3.new(2.5, 2.5, 2.5), Enum.PartType.Ball) end
			end
		end
		local door = exitOf(room)
		if door then mark(door.Position + Vector3.new(0, 8, 0), Vector3.new(5, 1, 5), Enum.PartType.Block) end
	end
	function FN.MAP.enter(c)
		m.token += 1
		m.cam = W.new("Camera", c, { FieldOfView = 30 })
		m.world = W.new("ViewportFrame", c, { Size = UDim2.fromScale(1, 1), CurrentCamera = m.cam, Ambient = Color3.new(1, 1, 1), LightColor = Color3.new(1, 1, 1),
			LightDirection = Vector3.new(0, -1, 0), ImageColor3 = CONFIG.Screen })
		W.arrow(c, UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.14, 0.14)) -- you
		m.room, m.marks, m.moving, m.nextFollow = false, {}, {}, 0
	end
	function FN.MAP.step(_, now)
		local room = roomAt(0)
		if room ~= m.room then build(room) end
		local root = myRoot()
		if root then
			m.cam.CFrame = CFrame.lookAt(root.Position + Vector3.new(0, 100, 0), root.Position, flat(workspace.CurrentCamera.CFrame.LookVector))
		end
		for i, p in ipairs(m.marks) do p.Transparency = if math.floor(now * 3 + i * 0.5) % 2 == 0 then 0 else 0.6 end
		if now >= m.nextFollow then
			m.nextFollow = now + 0.5
			for _, pair in ipairs(m.moving) do
				if pair[1].Parent then pair[2].CFrame = pair[1].CFrame end
			end
		end
	end
	function FN.MAP.leave() m.token += 1 end
end

