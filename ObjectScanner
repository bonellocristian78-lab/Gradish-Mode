local function ease(u) return u * u * (3 - 2 * u) end

-- SCANNER: DOORS' own. Every 2.5 s a pulse 60 studs around you; what is worth finding shows as a star where it is
FN.ITEMS = { label = "SCANNER" }
do
	local ghosts, lastPulse, nextPulse = {}, -10, 0
	local function boxOf(i)
		if i:IsA("Model") then return i:GetBoundingBox() end
		return i.CFrame, i.Size
	end
	local function ensureViewport()
		if ui.viewport then return end
		local v = Instance.new("ViewportFrame")
		v.Name = "Scan"
		v.Size = UDim2.fromScale(1, 1)
		v.BackgroundTransparency = 1
		v.Ambient, v.LightColor = Color3.new(1, 1, 1), Color3.new(1, 1, 1)
		v.ZIndex = ui.image.ZIndex + 1
		v.ImageColor3 = CONFIG.Screen
		local cam = Instance.new("Camera")
		cam.Parent = v
		v.CurrentCamera = cam
		v.Parent = ui.inner
		local ring = Instance.new("Part") -- the pulse, spreading on the floor
		ring.Shape = Enum.PartType.Cylinder
		ring.Material = Enum.Material.Neon
		ring.Anchored, ring.CanCollide, ring.Transparency = true, false, 1
		ring.Color = CONFIG.Screen
		ring.Parent = v
		ui.viewport, ui.cam, ui.ring = v, cam, ring
	end
	local function clearGhosts()
		for _, g in pairs(ghosts) do g.part:Destroy() end
		ghosts = {}
	end
	local function ghostAlpha(g, alpha)
		g.part.Transparency = alpha
		for _, d in ipairs(g.part:GetDescendants()) do
			if d:IsA("Decal") or d:IsA("Texture") then d.Transparency = alpha end
		end
	end
	local function newGhost(target)
		local part = S.d.assets.Star:Clone()
		part.Anchored, part.CanCollide, part.CanQuery = true, false, false
		part.Color = CONFIG.Screen
		part.Parent = ui.viewport
		local g = { born = math.huge, order = 1, found = true, part = part, seed = math.random() * 50 }
		ghostAlpha(g, 1)
		ghosts[target] = g
		return g
	end
	local function pulse()
		local root = myRoot()
		if not root then return end
		play("pulse")
		oneShot(S.d.assets.Ping, 1)
		S.flash, lastPulse = 1, os.clock()
		local found = gather(index.worth, MODE.PulseRange) -- what is worth finding, and DOORS' own (the Mines' salvage)
		local character = LocalPlayer.Character
		for _, tag in ipairs(MODE.Tags) do
			for _, i in ipairs(CollectionService:GetTagged(tag)) do
				if not index.worth[i] and i:IsDescendantOf(workspace) and not (character and i:IsDescendantOf(character)) then
					local dist = (boxOf(i).Position - root.Position).Magnitude
					if dist <= MODE.PulseRange then table.insert(found, { inst = i, dist = dist }) end
				end
			end
		end
		table.sort(found, function(a, b) return a.dist < b.dist end)
		for order, f in ipairs(found) do
			local g = ghosts[f.inst] or newGhost(f.inst)
			g.born = os.clock() + f.dist / MODE.PulseRange * 0.6
			g.order, g.found = order, false
		end
	end
	function FN.ITEMS.enter()
		ensureViewport()
		ui.viewport.Visible = true
		nextPulse = os.clock() + 0.3
	end
	function FN.ITEMS.leave()
		clearGhosts()
		if ui.viewport then ui.viewport.Visible = false end
		local scanned = sound("ScannedIdle")
		if scanned then scanned:Stop() end
	end
	function FN.ITEMS.step(_, now)
		local camera = workspace.CurrentCamera
		local grow = 1 - (1 - math.clamp((now - S.bootedAt) / 0.8, 0, 1)) ^ 3
		ui.cam.CFrame = camera.CFrame
		ui.cam.FieldOfView = 1 + (camera.FieldOfView - 1) * grow
		local root = myRoot()
		if nextPulse <= now then
			nextPulse = now + MODE.PulseInterval
			pulse()
		end
		local u = (now - lastPulse) / 0.8
		if root and u < 1 then
			local size = MODE.PulseRange * 2 * u
			ui.ring.Size = Vector3.new(0.15, size, size)
			ui.ring.CFrame = CFrame.new(root.Position - Vector3.new(0, 2.8, 0)) * CFrame.Angles(0, 0, math.pi / 2)
			ui.ring.Transparency = 0.4 + 0.6 * u
		else
			ui.ring.Transparency = 1
		end
		local showing = false
		for target, g in pairs(ghosts) do
			if target.Parent then
				local cf, size = boxOf(target)
				local at = cf.Position - Vector3.new(0, size.Y * 0.5, 0)
				local far = (at - ui.cam.CFrame.Position).Magnitude
				g.part.CFrame = ui.cam.CFrame.Rotation + at
				g.part.Size = S.d.assets.Star.Size * (1 + far / MODE.PulseRange * 0.6)
				local age = now - g.born
				if age >= 0 and not g.found then
					g.found = true
					oneShot(S.d.assets.Found, 1 + (g.order - 1) * 0.08)
				end
				local alpha = (if age < 0 then 0 elseif age < 0.15 then age / 0.15 else math.clamp(1 - (age - 0.15) / MODE.RevealTime, 0, 1))
					* (1 + math.noise(now * 12, g.seed) * 0.35)
				ghostAlpha(g, 1 - math.clamp(alpha, 0, 1) * 0.7)
				if alpha > 0.05 then showing = true end
				if age > MODE.RevealTime + 1 then
					g.part:Destroy()
					ghosts[target] = nil
				end
			else
				g.part:Destroy()
				ghosts[target] = nil
			end
		end
		local scanned = sound("ScannedIdle")
		if scanned then
			if showing and not scanned.IsPlaying then scanned:Play() elseif not showing and scanned.IsPlaying then scanned:Stop() end
		end
	end
end

