	ui.image.ImageTransparency = 0.6
	updateTorch()
	task.delay(if fromOff then 0.9 else 0.35, function()
		if S.token ~= token or not S.on or not ui.gui then return end
		S.booting = false
		S.bootedAt = if fromOff then os.clock() else -10
		enterFn()
	end)
