-- Every part of it (not what it keeps in its folders)
local function partsOf(tool)
	local out = {}
	for _, child in ipairs(tool:GetChildren()) do
		if child:IsA("BasePart") then table.insert(out, child) end
		if child:IsA("BasePart") or child:IsA("Model") then
			for _, d in ipairs(child:GetDescendants()) do
				if d:IsA("BasePart") then table.insert(out, d) end
			end
		end
	end
	return out
end
-- The middle of what you see of it, in its handle's space (what its tricks turn about)
local function centreOf(tool, handle)
	local lo, hi = { math.huge, math.huge, math.huge }, { -math.huge, -math.huge, -math.huge }
	for _, p in ipairs(partsOf(tool)) do
		if p.Transparency < 1 then
			local at, half = handle.CFrame:PointToObjectSpace(p.Position), p.Size / 2
			lo = { math.min(lo[1], at.X - half.X), math.min(lo[2], at.Y - half.Y), math.min(lo[3], at.Z - half.Z) }
			hi = { math.max(hi[1], at.X + half.X), math.max(hi[2], at.Y + half.Y), math.max(hi[3], at.Z + half.Z) }
		end
	end
	if lo[1] > hi[1] then return Vector3.new(0, 0, 0) end
	return Vector3.new((lo[1] + hi[1]) / 2, (lo[2] + hi[2]) / 2, (lo[3] + hi[3]) / 2)
end

-- The colour of its body, for its picture: what takes its colour, or its biggest part (if not a texture)
local function bodyColor(d)
	if #d.paint > 0 then return d.paint[1][1].Color end
	local best, most = nil, 0
	for _, p in ipairs(partsOf(d.tool)) do
		local volume = p.Size.X * p.Size.Y * p.Size.Z
		if p.Transparency < 1 and p ~= d.screen and volume > most then best, most = p, volume end
	end
	if best and not (best:IsA("MeshPart") and best.TextureID ~= "") then return best.Color end
	return KINDS[KIND].body or rgb(78, 80, 78)
end

-- A new scanner of the kind chosen: { tool, handle, screen, face, paint, torch, native, grip, centre, assets, body }
local function make()
	local d = { paint = {} }
	local tool
	if KIND == "Nokia" then
		tool = template:Clone()
		tool.Name = "ObjectScanner"
		d.handle, d.screen, d.face = tool.Handle, tool.Handle.Top.Screen, FRONT
		tool.Handle.Top.Screen.ScreenUI.Enabled = false
	elseif KIND == "Tablet" and tabletModel then
		tool = tabletModel:Clone()
		tool.Name = TITLE
		d.handle, d.screen, d.native = tool.Handle, tool.Handle.Screen, true -- its own animations (fire, equip, idle) and sounds (Use, Idle, Disable)
		local own = tool:FindFirstChild("Storage") and tool.Storage:FindFirstChild("ScreenUI")
		d.face = if own and own:IsA("SurfaceGui") then own.Face else FRONT
	else
		tool = Instance.new("Tool")
		tool.Name = TITLE
		local root = piece(tool, "Handle", Vector3.new(0.3, 0.3, 0.3), CFrame.new(), rgb(0, 0, 0))
		root.Transparency = 1
		local built = BUILD[KIND](root, CONFIG.Body or KINDS[KIND].body)
		for _, p in ipairs(root:GetDescendants()) do -- all of it on its handle (the lid's pieces on the lid)
			if p:IsA("BasePart") and p ~= built.lid then
				local base = if built.lid and p:IsDescendantOf(built.lid) then built.lid else root
				local w = Instance.new("Weld")
				w.Part0, w.Part1 = base, p
				w.C0 = base.CFrame:ToObjectSpace(p.CFrame)
				w.Parent = p
			end
		end
		local grip = Instance.new("Attachment")
		grip.Name = "ToolGripAttach"
		grip.CFrame = GRIP
		grip.Parent = root
		for _, name in ipairs({ "BootSystem", "SystemIdle", "CloseSystem" }) do template.Handle[name]:Clone().Parent = root end
		d.handle, d.screen, d.face, d.paint, d.torch, d.led = root, built.screen, FRONT, built.paint, built.torch, built.led
	end
	-- What every kind needs of DOORS' scanner: its sounds, its star and pings, its animations, its Inspect
	for _, name in ipairs({ "NextMode", "ScannedIdle" }) do
		if not d.handle:FindFirstChild(name) then template.Handle[name]:Clone().Parent = d.handle end
	end
	if not tool:FindFirstChild("ScannerAssets") then template.ScannerAssets:Clone().Parent = tool end
	if not tool:FindFirstChild("Animations") then template.Animations:Clone().Parent = tool end
	if not tool:FindFirstChild("Inspect") then
		local inspect = Instance.new("BindableEvent")
		inspect.Name = "Inspect"
		inspect.Parent = tool
	end
	for _, s in ipairs(tool:GetDescendants()) do
		if s:IsA("Sound") then
			s.Playing = false
			if KIND ~= "Nokia" and not d.native then s.PlaybackSpeed = KINDS[KIND].pitch end
		end
	end
	tool:SetAttribute("ScannerMode", "")
	tool:SetAttribute("Durability", tool:GetAttribute("DurabilityMax") or 300) -- full, and it stays so
	tool:SetAttribute("_OriginalOwner", nil)
	tool:SetAttribute("_ServerAnimated", true) -- its animations are played here, not by DOORS' inventory
	tool:SetAttribute("CannotDrop", true) -- dropped here (X), not by DOORS' server, which does not know it
	tool:SetAttribute("NameSingular", TITLE)
	tool:SetAttribute("NamePlural", TITLE)
	tool:SetAttribute("GradishScanner", true)
	tool.RequiresHandle = false -- no Roblox grip: it is held on its own Motor6D, as in DOORS
	tool.CanBeDropped = false
	pcall(function() tool:AddTag("Tool") end)
	for _, p in ipairs(partsOf(tool)) do p.CanCollide, p.CanQuery, p.CanTouch, p.Massless, p.Anchored = false, false, false, true, false end
	d.tool = tool
	local grip = d.handle:FindFirstChild("ToolGripAttach")
	d.grip = if grip then grip.CFrame else tool.Grip
	d.centre = centreOf(tool, d.handle)
	d.assets = tool.ScannerAssets
	d.body = bodyColor(d)
	if LIGHT then -- the Light's glow on it, and its sparkles
		local color = LIGHTS[LIGHT].color
		local glow = Instance.new("PointLight")
		glow.Name = "LightGlow"
		glow.Color, glow.Brightness, glow.Range, glow.Shadows = color, 1, 6, false
		glow.Parent = d.handle
		local at = Instance.new("Attachment")
		at.Name = "LightSparkles"
		at.Position = d.centre
		at.Parent = d.handle
		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Name = "Sparkles"
		sparkles.Texture = "rbxassetid://2581223252" -- DOORS' own (the Guiding Light's, on the doors)
		sparkles.Color = ColorSequence.new(color)
		sparkles.LightEmission = 1
		sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12), NumberSequenceKeypoint.new(1, 0) })
		sparkles.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		sparkles.Lifetime = NumberRange.new(0.6, 1.2)
		sparkles.Rate = 7
		sparkles.Speed = NumberRange.new(0.2, 0.6)
		sparkles.SpreadAngle = Vector2.new(180, 180)
		sparkles.Parent = at
		if d.led then d.led.Color = color end
	end
	return d
end

---- ICONS: every scanner's inventory picture, drawn here in its own colours (a PNG, made in Lua) ----
local ICON = {}
do
	local N = 128 -- pixels a side
	local function clamp01(x) return if x < 0 then 0 elseif x > 1 then 1 else x end

	-- Shapes, by their signed distance (pixels: < 0 inside)
	local function box(cx, cy, hw, hh, r)
		return { bb = { cx - hw, cy - hh, cx + hw, cy + hh }, d = function(x, y)
			local qx, qy = math.abs(x - cx) - (hw - r), math.abs(y - cy) - (hh - r)
			local ox, oy = math.max(qx, 0), math.max(qy, 0)
			return math.sqrt(ox * ox + oy * oy) + math.min(math.max(qx, qy), 0) - r
		end }
	end
	local function circle(cx, cy, r)
		return { bb = { cx - r, cy - r, cx + r, cy + r }, d = function(x, y)
			return math.sqrt((x - cx) ^ 2 + (y - cy) ^ 2) - r
		end }
	end
	local function ring(cx, cy, r, w)
		return { bb = { cx - r - w, cy - r - w, cx + r + w, cy + r + w }, d = function(x, y)
			return math.abs(math.sqrt((x - cx) ^ 2 + (y - cy) ^ 2) - r) - w
		end }
	end
	local function seg(ax, ay, bx, by, r)
		return { bb = { math.min(ax, bx) - r, math.min(ay, by) - r, math.max(ax, bx) + r, math.max(ay, by) + r }, d = function(x, y)
			local pax, pay, bax, bay = x - ax, y - ay, bx - ax, by - ay
			local h = clamp01((pax * bax + pay * bay) / (bax * bax + bay * bay))
			local dx, dy = pax - bax * h, pay - bay * h
			return math.sqrt(dx * dx + dy * dy) - r
		end }
	end
	local function star(cx, cy, R, w) -- a sparkle: two thin diamonds, crossed
		local k = 1 / math.sqrt(R * R + w * w)
		return { bb = { cx - R, cy - R, cx + R, cy + R }, d = function(x, y)
			local ax, ay = math.abs(x - cx), math.abs(y - cy)
			return math.min((ax * w + ay * R - R * w) * k, (ax * R + ay * w - R * w) * k)
		end }
	end
	local function frame(cx, cy, hw, hh, w) -- a box's outline only
		local inner = box(cx, cy, hw, hh, 0)
		return { bb = { cx - hw - w, cy - hh - w, cx + hw + w, cy + hh + w }, d = function(x, y) return math.abs(inner.d(x, y)) - w end }
	end

	local INK = { 0.09, 0.08, 0.1 }
	local function mul(c, k) return { math.min(c[1] * k, 1), math.min(c[2] * k, 1), math.min(c[3] * k, 1) } end
	local function mix(a, b, t) return { a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t } end

	-- Paints a shape on the canvas: o.outline (dark border, pixels), o.grad (lighter at its top), o.glow (soft, pixels), o.alpha
	local function paint(cv, shape, color, o)
		o = o or {}
		local alpha, ow, glow, grad = o.alpha or 1, o.outline or 0, o.glow, o.grad or 0
		local pad = math.max(ow, glow or 0) + 2
		local cs, sn = math.cos(cv.rot), math.sin(cv.rot)
		local b = shape.bb
		local X0, Y0, X1, Y1 = math.huge, math.huge, -math.huge, -math.huge
		for _, corner in ipairs({ { b[1] - pad, b[2] - pad }, { b[3] + pad, b[2] - pad }, { b[1] - pad, b[4] + pad }, { b[3] + pad, b[4] + pad } }) do
			local lx, ly = corner[1] - 64, corner[2] - 64
			local px, py = cs * lx - sn * ly + 64, sn * lx + cs * ly + 64
			X0, Y0, X1, Y1 = math.min(X0, px), math.min(Y0, py), math.max(X1, px), math.max(Y1, py)
		end
		local R, G, B, A = cv.r, cv.g, cv.b, cv.a
		local top, height = b[2], math.max(b[4] - b[2], 1)
		local function blend(i, c, a)
			if a <= 0 then return end
			local under = A[i] * (1 - a)
			local out = a + under
			R[i] = (c[1] * a + R[i] * under) / out
			G[i] = (c[2] * a + G[i] * under) / out
			B[i] = (c[3] * a + B[i] * under) / out
			A[i] = out
		end
		for py = math.max(math.floor(Y0), 0), math.min(math.ceil(Y1), N - 1) do
			for px = math.max(math.floor(X0), 0), math.min(math.ceil(X1), N - 1) do
				local sx, sy = px + 0.5 - 64, py + 0.5 - 64
				local lx, ly = cs * sx + sn * sy + 64, -sn * sx + cs * sy + 64
				local d = shape.d(lx, ly)
				local i = py * N + px + 1
				if glow then
					blend(i, color, (if d <= 0 then 1 else (1 - clamp01(d / glow)) ^ 2) * alpha)
				else
					if ow > 0 then blend(i, INK, clamp01(0.5 - (d - ow)) * alpha) end
					local cover = clamp01(0.5 - d) * alpha
					if cover > 0 then
						blend(i, if grad ~= 0 then mul(color, 1 + grad * (0.5 - (ly - top) / height)) else color, cover)
					end
				end
			end
		end
	end

