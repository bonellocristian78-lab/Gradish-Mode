	-- Its silhouette, for the Light's glow behind it
	local HALO = {
		Nokia = function() return box(64, 66, 34, 54, 10) end,
		Tablet = function() return box(64, 64, 52, 37, 9) end,
		Computer = function() return box(64, 66, 54, 46, 8) end,
		Phone = function() return box(64, 64, 30, 52, 12) end,
		GameBoy = function() return box(64, 64, 40, 56, 9) end,
	}

	local function crcTable()
		local t = {}
		for n = 0, 255 do
			local c = n
			for _ = 1, 8 do c = if bit32.band(c, 1) == 1 then bit32.bxor(0xEDB88320, bit32.rshift(c, 1)) else bit32.rshift(c, 1) end
			t[n] = c
		end
		return t
	end
	local CRC = crcTable()
	local function crc32(s)
		local c = 0xFFFFFFFF
		for i = 1, #s do c = bit32.bxor(CRC[bit32.band(bit32.bxor(c, string.byte(s, i)), 0xFF)], bit32.rshift(c, 8)) end
		return bit32.bxor(c, 0xFFFFFFFF)
	end
	local function u32(n) return string.char(bit32.band(bit32.rshift(n, 24), 255), bit32.band(bit32.rshift(n, 16), 255), bit32.band(bit32.rshift(n, 8), 255), bit32.band(n, 255)) end
	local function chunk(kind, data) return u32(#data) .. kind .. data .. u32(crc32(kind .. data)) end

	-- The canvas as a PNG: 8-bit RGBA, stored (not packed) inside zlib
	local function encode(cv)
		local rows = table.create(N)
		for y = 0, N - 1 do
			local row = table.create(N + 1)
			row[1] = "\0"
			for x = 0, N - 1 do
				local i = y * N + x + 1
				row[x + 2] = string.char(math.floor(cv.r[i] * 255 + 0.5), math.floor(cv.g[i] * 255 + 0.5), math.floor(cv.b[i] * 255 + 0.5), math.floor(cv.a[i] * 255 + 0.5))
			end
			rows[y + 1] = table.concat(row)
		end
		local raw = table.concat(rows)
		local a, b = 1, 0
		for i = 1, #raw do
			a = (a + string.byte(raw, i)) % 65521
			b = (b + a) % 65521
		end
		local parts, at = { "\120\1" }, 1
		while at <= #raw do
			local piece = raw:sub(at, at + 65534)
			at += #piece
			local last = if at > #raw then 1 else 0
			table.insert(parts, string.char(last, #piece % 256, math.floor(#piece / 256), 255 - #piece % 256, 255 - math.floor(#piece / 256)) .. piece)
		end
		table.insert(parts, u32(b * 65536 + a))
		return "\137PNG\r\n\26\n" .. chunk("IHDR", u32(N) .. u32(N) .. "\8\6\0\0\0") .. chunk("IDAT", table.concat(parts)) .. chunk("IEND", "")
	end

	--[[ ICON.png(kind, screen, body, light): the PNG of a scanner of that kind, its screen in `screen`, its body in `body`
	     (colours as {r, g, b}, 0 to 1); `light` (a colour, or nil): a Light's glow around it and its sparkles ]]
	function ICON.png(kind, screenColor, body, light)
		local cv = { r = table.create(N * N, 0), g = table.create(N * N, 0), b = table.create(N * N, 0), a = table.create(N * N, 0), rot = math.rad(TILT[kind]) }
		if light then paint(cv, HALO[kind](), light, { glow = 14, alpha = 0.55 }) end
		DRAW[kind](cv, screenColor, body)
		if light then
			cv.rot = 0
			sparkle(cv, 18, 22, 11, light)
			sparkle(cv, 110, 30, 7, light)
			sparkle(cv, 106, 108, 9, light)
		end
		return encode(cv)
	end
end
