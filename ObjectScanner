-- Off: the screen folds to a line and goes out
local function closeScreen(animate)
	if S.on and not S.booting and ui.gui then leaveFn() end
	S.token += 1
	S.on, S.booting, S.alert = false, false, nil
	updateTorch()
	if not ui.gui then return end
	ui.alert.Visible = false
	ui.frame.Visible, ui.off.Visible = false, true
	if not animate then
		ui.offFrame.Size = UDim2.fromScale(0, 0.1)
		return
	end
	local offFrame = ui.offFrame
	offFrame.Size = UDim2.fromScale(1, 1)
	TweenService:Create(offFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.fromScale(1, 0.1) }):Play()
	task.delay(0.31, function()
		if not S.on then
			TweenService:Create(offFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.fromScale(0, 0.1) }):Play()
		end
	end)
end
-- F: the next function (a burst of static between)
local function nextFn()
	local switching = S.on and not S.booting and ui.gui ~= nil
	if switching then leaveFn() end
	S.fn = S.fn % #FNS + 1
	S.d.tool:SetAttribute("ScannerFunction", FNS[S.fn])
	play("next_mode")
	local s = sound("NextMode")
	if s then s:Play() end
	if switching then
		S.token += 1
		local token = S.token
		S.booting, S.flash = true, 1
		ui.mode.Text = current().label
		task.delay(0.15, function()
			if S.token ~= token or not S.on or not ui.gui then return end
			S.booting = false
			enterFn()
		end)
	end
end

-- Its screen, CONFIG.FPS times a second: its static, what is coming, its function
local function step(dt)
	local now = os.clock()
	S.flash = math.max(S.flash - dt * 2.5, 0)
	animateStatic()
	if not S.on then return end
	if now >= S.nextThreat then
		S.nextThreat = now + 0.25
		local before = {}
		for _, t in ipairs(S.threats) do before[t.inst] = true end
		S.threats = scanThreats(now)
		S.alert = nil
		for _, t in ipairs(S.threats) do
			if t.moving and not S.alert then S.alert = t end
			if not before[t.inst] then logLine("!! " .. t.what .. " " .. metres(t.dist)) end
		end
	end
	if S.alert and now >= S.nextBeep then -- it warns you, faster as it comes
		S.nextBeep = now + math.clamp(S.alert.dist / 150, 0.15, 1.2)
		oneShot(S.d.assets.Ping, 1.6)
	end
	ui.alert.Visible = S.alert ~= nil and FNS[S.fn] ~= "ENTITIES" and math.floor(now * 4) % 2 == 0
	if S.booting then return end
	local f = current()
	if f.step then f.step(dt, now) end
end
