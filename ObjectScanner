end)

-- SNAKE (the Nokia's): left click turns it left, right click right; it goes through the walls
FN.SNAKE = { label = "SNAKE", clean = true }
do
	local g = {}
	local COLS, ROWS = 14, 10
	local DIRS = { { 1, 0 }, { 0, 1 }, { -1, 0 }, { 0, -1 } } -- right, down, left, up: clockwise
	local function free()
		for _ = 1, 300 do
			local x, y, hit = math.random(0, COLS - 1), math.random(0, ROWS - 1), false
			for _, s in ipairs(g.body) do
				if s[1] == x and s[2] == y then hit = true break end
			end
			if not hit then return { x, y } end
		end
		return nil
	end
	local function reset(now)
		g.body = { { 5, 5 }, { 4, 5 }, { 3, 5 } }
		g.dir, g.turns, g.over, g.points = 1, {}, nil, 0
		g.food = free()
		g.next = now + 0.5
	end
	local function cell(i)
		local f = g.cells[i]
		if not f then
			f = W.new("Frame", g.board, { Size = UDim2.fromScale(1 / COLS, 1 / ROWS), BackgroundColor3 = CONFIG.Screen, BackgroundTransparency = 0, ZIndex = 9 })
			g.cells[i] = f
		end
		f.Visible = true
		return f
	end
	function FN.SNAKE.enter(c)
		g.cells = {}
		g.board = W.new("Frame", c, { Position = UDim2.fromScale(0, 0.13), Size = UDim2.fromScale(1, 0.75), BackgroundColor3 = hsv(CONFIG.Screen, 0.2),
			BackgroundTransparency = 0.5, ClipsDescendants = true })
		W.new("UIStroke", g.board, { Color = CONFIG.Screen, Thickness = 1 })
		g.score = W.text(c, { Size = UDim2.fromScale(1, 0.12), TextXAlignment = Enum.TextXAlignment.Left })
		W.text(c, { Position = UDim2.fromScale(0, 0.89), Size = UDim2.fromScale(1, 0.11), Text = "< LEFT CLICK   RIGHT CLICK >", TextTransparency = 0.35 })
		reset(os.clock())
	end
	function FN.SNAKE.step(_, now)
		if g.over then
			if now >= g.over then reset(now) end
		elseif now >= g.next then
			g.next = now + math.max(0.2 - #g.body * 0.005, 0.09)
			local turn = table.remove(g.turns, 1)
			if turn then g.dir = if turn > 0 then g.dir % 4 + 1 else (g.dir + 2) % 4 + 1 end
			local head, d = g.body[1], DIRS[g.dir]
			local nx, ny = (head[1] + d[1]) % COLS, (head[2] + d[2]) % ROWS
			local eats = g.food ~= nil and nx == g.food[1] and ny == g.food[2]
			for i = 1, #g.body - (if eats then 0 else 1) do -- (its tail moves out of the way, unless it grows)
				if g.body[i][1] == nx and g.body[i][2] == ny then
					g.over = now + 1.6
					S.snakeBest = math.max(S.snakeBest, g.points)
					oneShot(S.d.assets.Ping, 0.5)
					break
				end
			end
			if not g.over then
				table.insert(g.body, 1, { nx, ny })
				if eats then
					g.points += 1
					oneShot(S.d.assets.Found, 1 + math.min(g.points, 20) * 0.03)
					g.food = free()
				else
					table.remove(g.body)
				end
			end
		end
		local n = 0
		for i, s in ipairs(g.body) do
			n += 1
			local f = cell(n)
			f.Position = UDim2.fromScale(s[1] / COLS, s[2] / ROWS)
			f.BackgroundTransparency = if g.over and math.floor(now * 6) % 2 == 1 then 0.75 elseif i == 1 then 0 else 0.3
		end
		if g.food then
			n += 1
			local f = cell(n)
			f.Position = UDim2.fromScale(g.food[1] / COLS, g.food[2] / ROWS)
			f.BackgroundTransparency = if math.floor(now * 4) % 2 == 1 then 0.5 else 0
		end
		for i = n + 1, #g.cells do g.cells[i].Visible = false end
		g.score.Text = if g.over then ("GAME OVER  %d"):format(g.points) else ("SCORE %d  BEST %d"):format(g.points, math.max(S.snakeBest, g.points))
	end
	local function steer(way)
		if not g.over and #g.turns < 2 then table.insert(g.turns, way) end
		return true
	end
	function FN.SNAKE.left() return steer(-1) end
	function FN.SNAKE.right() return steer(1) end
end

