	Golden = { title = "Golden Tablet", color = rgb(255, 205, 70) }, -- (the Curious Tablet: the Curious Light's, in gold)
}
local LIGHT_NAMES = { guiding = "Guiding", guidinglight = "Guiding", curious = "Curious", curiouslight = "Curious", golden = "Golden",
	goldentablet = "Golden", curioustablet = "Golden" }
-- Its screen's colours, by name
