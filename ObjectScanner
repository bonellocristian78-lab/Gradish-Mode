-- HIDING and TRAPS: a radar of where to hide (or of the traps) 60 studs around, and the nearest
local function nearbyFunction(label, set, none, extra)
	local fn = { label = label }
	local s = {}
	function fn.enter(c)
		s.radar = W.radar(c, 60)
		s.text = W.text(c, { Position = UDim2.fromScale(0, 0.8), Size = UDim2.fromScale(1, 0.12) })
		s.extra = W.text(c, { Position = UDim2.fromScale(0, 0.9), Size = UDim2.fromScale(1, 0.1), TextTransparency = 0.2 })
		s.list, s.next = {}, 0
	end
	function fn.step(_, now)
		if now >= s.next then
			s.next = now + 0.3
			s.list = gather(set, 60)
			s.extra.Text = if extra then extra() else ""
		end
		local dots = {}
		for i, item in ipairs(s.list) do dots[i] = { pos = item.pos, hot = i == 1 } end
		s.radar.show(dots, now)
		local first = s.list[1]
		s.text.Text = if first then first.what .. " " .. metres(first.dist) else none
	end
	return fn
end
