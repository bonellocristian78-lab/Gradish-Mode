-- Traps: the Dupe's fake door, the Snare, the Giggle on the ceiling, the Gloombats' eggs
local TRAPS = { Dupe = "FAKE DOOR", FakeDoor = "FAKE DOOR", Snare = "SNARE", GiggleCeiling = "GIGGLE", GloomEgg = "GLOOM EGG" }
-- What is coming: DOORS' entities (the ones that run through the rooms are "moving")
local THREATS = { RushMoving = "RUSH", AmbushMoving = "AMBUSH", BackdoorRush = "BLITZ", A60 = "A-60", A120 = "A-120", GlitchRush = "GLITCH",
	GlitchAmbush = "GLITCH", JeffTheKiller = "JEFF", SeekMovingNewClone = "SEEK", SeekMoving = "SEEK", Eyes = "EYES", BackdoorLookman = "LOOKMAN",
	FigureRig = "FIGURE", FigureRagdoll = "FIGURE", GiggleCeiling = "GIGGLE", GrumbleRig = "GRUMBLE", Screech = "SCREECH", Halt = "HALT",
	Shade = "HALT", Dread = "DREAD" }
local MOVING = { RUSH = true, AMBUSH = true, BLITZ = true, ["A-60"] = true, ["A-120"] = true, GLITCH = true, JEFF = true, SEEK = true }

local rooms = workspace:FindFirstChild("CurrentRooms")
local index = { worth = {}, hide = {}, trap = {} } -- everything of the rooms worth knowing, kept up to date as they come and go
local function consider(d)
	local name = d.Name
	local model, part = d:IsA("Model"), d:IsA("BasePart")
	if WORTH[name] and (model or part) then index.worth[d] = "ITEM" end
	if model then
		local hide = HIDE[name] or HIDE_MODULES[d:GetAttribute("LoadModule") or ""] or (CollectionService:HasTag(d, "HidingSpot") and "HIDING SPOT")
		if hide then index.hide[d] = hide end
	end
	if TRAPS[name] and (model or part) and (name ~= "Dupe" or (d.Parent and d.Parent.Name == "SideroomDupe")) then index.trap[d] = TRAPS[name] end
end
if rooms then
	for _, d in ipairs(rooms:GetDescendants()) do consider(d) end
	on(rooms.DescendantAdded, consider)
end

local function myRoot()
	local character = LocalPlayer.Character
	return character and (character.PrimaryPart or character:FindFirstChild("HumanoidRootPart"))
end
local function whereIs(i)
	if i:IsA("Model") then return i:GetPivot().Position end
	return i.Position
end
-- What of a set is within `range` of you, nearest first: { { inst, pos, dist, what } } (the thing itself, not a piece of it with the same name)
local function gather(set, range)
	local root = myRoot()
	local out = {}
	if not root then return out end
	for i, what in pairs(set) do
		if not (rooms and i:IsDescendantOf(rooms)) then -- taken (by you or anyone), or its room gone
			set[i] = nil
		else
			local up, inside = i.Parent, false
			while up and up ~= rooms do
				if set[up] then inside = true break end
				up = up.Parent
			end
			if not inside then
				local pos = whereIs(i)
				local dist = (pos - root.Position).Magnitude
				if dist <= range then table.insert(out, { inst = i, pos = pos, dist = dist, what = what }) end
			end
		end
	end
	table.sort(out, function(a, b) return a.dist < b.dist end)
	return out
end

-- The room you are in, and the one ahead
local function roomAt(offset)
	local n = tonumber(LocalPlayer:GetAttribute("CurrentRoom"))
	return rooms and n and rooms:FindFirstChild(tostring(n + (offset or 0))) or nil
end
-- Its way out: the door to the next room (and its number), or where the room ends
local function exitOf(room)
	local door = room:FindFirstChild("Door")
	local part = door and (door:FindFirstChild("Door") or door.PrimaryPart) or room:FindFirstChild("RoomExit")
	local number = door and tonumber(door:GetAttribute("RoomID")) or ((tonumber(room.Name) or 0) + 1)
	local lock = if door and door:FindFirstChild("Lock") then "LOCKED: KEY" elseif room:FindFirstChild("Gate") then "GATE: LEVER" else nil
	return part, number, lock
end

-- What is coming, and what is around: { { inst, what, pos, dist, moving } }, what moves first, then the nearest
local seen = setmetatable({}, { __mode = "k" }) -- where models were: anything not a player that moves fast is something
local function scanThreats(now)
	local root = myRoot()
	local out = {}
	if not root then return out end
	local function take(m, what, moving)
		local ok, cf = pcall(function() return m:GetPivot() end)
		if ok then table.insert(out, { inst = m, what = what, pos = cf.Position, dist = (cf.Position - root.Position).Magnitude, moving = moving }) end
	end
	for _, m in ipairs(workspace:GetChildren()) do
		if m:IsA("Model") and not Players:GetPlayerFromCharacter(m) and m ~= (S.dropped and S.dropped.model) then
			local what = THREATS[m.Name]
			if what then
				take(m, what, MOVING[what] == true)
			else
				local ok, cf = pcall(function() return m:GetPivot() end)
				if ok then
					local last = seen[m]
					seen[m] = { pos = cf.Position, at = now }
					if last and now - last.at > 0.05 and (cf.Position - last.pos).Magnitude / (now - last.at) > 30 then take(m, m.Name:upper():sub(1, 10), true) end
				end
			end
		end
	end
	for _, m in ipairs(workspace.CurrentCamera:GetChildren()) do
		if THREATS[m.Name] then take(m, THREATS[m.Name], false) end
	end
	for _, room in ipairs({ roomAt(0), roomAt(1) }) do
		for _, child in ipairs(room:GetChildren()) do
			if THREATS[child.Name] then take(child, THREATS[child.Name], false) end
			for _, grandchild in ipairs(child:GetChildren()) do
				if THREATS[grandchild.Name] and grandchild:IsA("Model") then take(grandchild, THREATS[grandchild.Name], false) end
			end
		end
	end
	table.sort(out, function(a, b)
		if a.moving ~= b.moving then return a.moving end
		return a.dist < b.dist
	end)
	return out
end

-- A copy of a room's parts (the ones `accept` wants) in a viewport; the ones that move, listed to follow
local KEEP = { Decal = true, Texture = true, SurfaceAppearance = true, SpecialMesh = true }
local function copyRoom(room, holder, accept, moving, still)
	local count = 0
	for _, d in ipairs(room:GetDescendants()) do
		if not still() then return end
		if d:IsA("BasePart") and d.Transparency < 0.95 and accept(d) then
			local ok, copy = pcall(function() return d:Clone() end)
			if ok and copy then
				for _, k in ipairs(copy:GetChildren()) do
					if not KEEP[k.ClassName] then k:Destroy() end
				end
				copy.Anchored = true
				copy.Parent = holder
				if not d.Anchored then table.insert(moving, { d, copy }) end
				count += 1
				if count % 250 == 0 then task.wait() end
			end
		end
	end
end

