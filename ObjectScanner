-- Its picture in your inventory, in its colours: drawn once for each set of colours, kept in the executor's folder
local function hexOf(c) return string.format("%02x%02x%02x", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)) end
local function refreshIcon(d)
	local path = ("ObjectScanner/Icons/%s_%s_%s_%s.png"):format(KIND, LIGHT or "Normal", hexOf(CONFIG.Screen), hexOf(d.body))
	local ok, id = pcall(function()
		if not isfolder("ObjectScanner") then makefolder("ObjectScanner") end
		if not isfolder("ObjectScanner/Icons") then makefolder("ObjectScanner/Icons") end
		if not isfile(path) then
			local function three(c) return { c.R, c.G, c.B } end
			writefile(path, ICON.png(KIND, three(CONFIG.Screen), three(d.body), if LIGHT then three(LIGHTS[LIGHT].color) else nil))
		end
		return getcustomasset(path)
	end)
	if ok and type(id) == "string" then d.tool.TextureId = id end
end

