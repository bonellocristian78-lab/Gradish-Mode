-- HIDING and TRAPS: a radar of where to hide (or of the traps) 60 studs around, and the nearest
local function nearbyFunction(label, set, none, extra)
	local fn = { label = label }
	local s = {}
	function fn.enter(c)
		s.radar = W.radar(c, 60)
		s.text = W.text(c, { Position = UDim2.fromScale(0, 0.8), Size = UDim2.fromScale(1, 0.12) })
		s.extra = W.text(c, { Position = UDim2.fromScale(0, 0.9), Size = UDim2.fromScale(1, 0.1), TextTransparency = 0.2 })
		s.list, s.next = {}, 0
	end
	function fn.step(_, now)
		if now >= s.next then
			s.next = now + 0.3
			s.list = gather(set, 60)
			s.extra.Text = if extra then extra() else ""
		end
		local dots = {}
		for i, item in ipairs(s.list) do dots[i] = { pos = item.pos, hot = i == 1 } end
		s.radar.show(dots, now)
		local first = s.list[1]
		s.text.Text = if first then first.what .. " " .. metres(first.dist) else none
	end
	return fn
end
FN.HIDING = nearbyFunction("HIDING", index.hide, "NOWHERE TO HIDE", function()
	return ("%d NEARBY"):format(#gather(index.hide, 60))
end)
FN.TRAPS = nearbyFunction("TRAPS", index.trap, "NO TRAPS", function() -- and in a room with the Dupe: the real door's number
	local room = roomAt(0)
	if room and room:GetAttribute("HasDupe") then return ("DUPE! REAL DOOR: %03d"):format(select(2, exitOf(room))) end
	return ""
end)

-- SNAKE (the Nokia's): left click turns it left, right click right; it goes through the walls
FN.SNAKE = { label = "SNAKE", clean = true }
do
	local g = {}
	local COLS, ROWS = 14, 10
	local DIRS = { { 1, 0 }, { 0, 1 }, { -1, 0 }, { 0, -1 } } -- right, down, left, up: clockwise
	local function free()
		for _ = 1, 300 do
			local x, y, hit = math.random(0, COLS - 1), math.random(0, ROWS - 1), false
			for _, s in ipairs(g.body) do
				if s[1] == x and s[2] == y then hit = true break end
			end
			if not hit then return { x, y } end
		end
		return nil
	end
	local function reset(now)
		g.body = { { 5, 5 }, { 4, 5 }, { 3, 5 } }
		g.dir, g.turns, g.over, g.points = 1, {}, nil, 0
		g.food = free()
		g.next = now + 0.5
	end
	local function cell(i)
		local f = g.cells[i]
		if not f then
			f = W.new("Frame", g.board, { Size = UDim2.fromScale(1 / COLS, 1 / ROWS), BackgroundColor3 = CONFIG.Screen, BackgroundTransparency = 0, ZIndex = 9 })
			g.cells[i] = f
		end
		f.Visible = true
		return f
	end
	function FN.SNAKE.enter(c)
		g.cells = {}
		g.board = W.new("Frame", c, { Position = UDim2.fromScale(0, 0.13), Size = UDim2.fromScale(1, 0.75), BackgroundColor3 = hsv(CONFIG.Screen, 0.2),
			BackgroundTransparency = 0.5, ClipsDescendants = true })
		W.new("UIStroke", g.board, { Color = CONFIG.Screen, Thickness = 1 })
		g.score = W.text(c, { Size = UDim2.fromScale(1, 0.12), TextXAlignment = Enum.TextXAlignment.Left })
		W.text(c, { Position = UDim2.fromScale(0, 0.89), Size = UDim2.fromScale(1, 0.11), Text = "< LEFT CLICK   RIGHT CLICK >", TextTransparency = 0.35 })
		reset(os.clock())
	end
	function FN.SNAKE.step(_, now)
		if g.over then
			if now >= g.over then reset(now) end
		elseif now >= g.next then
			g.next = now + math.max(0.2 - #g.body * 0.005, 0.09)
			local turn = table.remove(g.turns, 1)
			if turn then g.dir = if turn > 0 then g.dir % 4 + 1 else (g.dir + 2) % 4 + 1 end
			local head, d = g.body[1], DIRS[g.dir]
			local nx, ny = (head[1] + d[1]) % COLS, (head[2] + d[2]) % ROWS
			local eats = g.food ~= nil and nx == g.food[1] and ny == g.food[2]
			for i = 1, #g.body - (if eats then 0 else 1) do -- (its tail moves out of the way, unless it grows)
				if g.body[i][1] == nx and g.body[i][2] == ny then
					g.over = now + 1.6
					S.snakeBest = math.max(S.snakeBest, g.points)
					oneShot(S.d.assets.Ping, 0.5)
					break
				end
			end
			if not g.over then
				table.insert(g.body, 1, { nx, ny })
				if eats then
					g.points += 1
					oneShot(S.d.assets.Found, 1 + math.min(g.points, 20) * 0.03)
					g.food = free()
				else
					table.remove(g.body)
				end
			end
		end
		local n = 0
		for i, s in ipairs(g.body) do
			n += 1
			local f = cell(n)
			f.Position = UDim2.fromScale(s[1] / COLS, s[2] / ROWS)
			f.BackgroundTransparency = if g.over and math.floor(now * 6) % 2 == 1 then 0.75 elseif i == 1 then 0 else 0.3
		end
		if g.food then
			n += 1
			local f = cell(n)
			f.Position = UDim2.fromScale(g.food[1] / COLS, g.food[2] / ROWS)
			f.BackgroundTransparency = if math.floor(now * 4) % 2 == 1 then 0.5 else 0
		end
		for i = n + 1, #g.cells do g.cells[i].Visible = false end
		g.score.Text = if g.over then ("GAME OVER  %d"):format(g.points) else ("SCORE %d  BEST %d"):format(g.points, math.max(S.snakeBest, g.points))
	end
	local function steer(way)
		if not g.over and #g.turns < 2 then table.insert(g.turns, way) end
		return true
	end
	function FN.SNAKE.left() return steer(-1) end
	function FN.SNAKE.right() return steer(1) end
	function FN.SNAKE.key(k) -- (the Golden Tablet's arrows: where it goes; never straight back)
		local want = ({ [Enum.KeyCode.Right] = 1, [Enum.KeyCode.Down] = 2, [Enum.KeyCode.Left] = 3, [Enum.KeyCode.Up] = 4 })[k]
		if not want then return false end
		if not g.over and want ~= (g.dir + 1) % 4 + 1 then g.dir, g.turns = want, {} end
		return true
	end
end

-- X-RAY (the Tablet's, as its own script): the room you are in, seen through its screen, and a star on what opens the way
FN.XRAY = { label = "X-RAY", clean = true }
do
	local x = { token = 0 }
	local OBJECTIVES = { KeyObtain = true, ElectricalKeyObtain = true, LeverForGate = true, LiveBreakerPolePickup = true, LiveHintBook = true,
		FuseObtain = true, GeneratorFuse = true, MinesAnchor = true, WaterPump = true, TimerLever = true }
	local function build(room)
		x.token += 1
		local token = x.token
		x.room, x.moving, x.stars = room, {}, {}
		x.normal:ClearAllChildren()
		x.special:ClearAllChildren()
		if not room then return end
		local holder = Instance.new("Model")
		holder.Name = room.Name
		holder.Parent = x.normal
		task.spawn(copyRoom, room, holder, function(d) return d.Size.Magnitude > 0.2 end, x.moving, function() return x.token == token end)
		for i in pairs(index.worth) do
			if OBJECTIVES[i.Name] and i:IsDescendantOf(room) then
				local star = S.d.assets.Star:Clone()
				star.Anchored, star.Transparency, star.Color = true, 0, CONFIG.Screen
				star.CFrame = CFrame.new(whereIs(i))
				star.Parent = x.special
				table.insert(x.stars, star)
			end
		end
	end
	function FN.XRAY.enter(c)
		x.token += 1
		x.cam = W.new("Camera", c, { FieldOfView = 1 })
		x.normal = W.new("ViewportFrame", c, { Size = UDim2.fromScale(1, 1), CurrentCamera = x.cam, Ambient = Color3.fromRGB(150, 150, 150),
			LightColor = Color3.new(1, 1, 1), ImageColor3 = CONFIG.Screen })
		x.special = W.new("ViewportFrame", c, { Size = UDim2.fromScale(1, 1), CurrentCamera = x.cam, Ambient = Color3.new(1, 1, 1),
			LightColor = Color3.new(1, 1, 1), ImageColor3 = hsv(CONFIG.Screen, 1.5), ZIndex = 9 })
		TweenService:Create(x.cam, TweenInfo.new(3, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), { FieldOfView = 30 }):Play()
		TweenService:Create(x.special, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut, 10, true), { ImageColor3 = hsv(CONFIG.Screen, 0.45) }):Play()
		x.nextFollow = 0
		build(roomAt(0))
	end
	function FN.XRAY.step(_, now)
		local room = roomAt(0)
		if room ~= x.room then -- a new room: static, and the new one
			S.flash = 1
			build(room)
		end
		local screen = S.d.screen
		local out = screen.CFrame:VectorToWorldSpace(Vector3.FromNormalId(S.d.face)) -- its screen looks at you: it sees the other way
		x.cam.CFrame = CFrame.lookAt(screen.Position, screen.Position - out, screen.CFrame.UpVector)
		x.normal.LightDirection = x.cam.CFrame.LookVector - Vector3.new(0, 1, 0)
		for _, star in ipairs(x.stars) do star.CFrame = CFrame.lookAt(star.Position, x.cam.CFrame.Position) end
		if now >= x.nextFollow then
			x.nextFollow = now + 0.5
			for _, pair in ipairs(x.moving) do
				if pair[1].Parent then pair[2].CFrame = pair[1].CFrame end
			end
		end
	end
	function FN.XRAY.leave() x.token += 1 end
end

-- THE GOLDEN TABLET'S APPS (once it is powered up): its games, its feed. Each as the functions are; key(k) for the arrows
-- (and Space), wheel(d) for the mouse wheel, held(dir) to ask whether left (-1) or right (1) is held
