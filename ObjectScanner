local function current() return FN[FNS[S.fn]] end
local function enterFn()
	local f = current()
	ui.content:ClearAllChildren()
	ui.mode.Text = f.label
	ui.image.ImageTransparency = if f.clean then 1 else 0.85
	if f.enter then f.enter(ui.content) end
end
local function leaveFn()
	local f = current()
	if f.leave then f.leave() end
	if ui.content then ui.content:ClearAllChildren() end
end
-- On: it boots (its picture and its name), then its function
local function startScreen(fromOff)
	S.token += 1
	local token = S.token
	S.on, S.booting = true, true
	applyColor(CONFIG.Screen)
	ui.image.Image = MODE.BootImage
	ui.mode.Text = if GOLDEN then (if GOLD.powered then "CURIOUS OS" else "GOLDEN TABLET") else KINDS[KIND].title:upper()
	ui.frame.Visible, ui.off.Visible = true, false
	ui.content:ClearAllChildren()
	S.flash = 1
	if fromOff then S.bootFrom = os.clock() end
	ui.image.ImageTransparency = 0.6
	task.delay(if fromOff then 0.9 else 0.35, function()
		if S.token ~= token or not S.on or not ui.gui then return end
		S.booting = false
		S.bootedAt = if fromOff then os.clock() else -10
		enterFn()
	end)
end
-- Off: the screen folds to a line and goes out
local function closeScreen(animate)
	if S.on and not S.booting and ui.gui then leaveFn() end
	S.token += 1
	S.on, S.booting, S.alert = false, false, nil
	if not ui.gui then return end
	ui.alert.Visible = false
	ui.frame.Visible, ui.off.Visible = false, true
	if not animate then
		ui.offFrame.Size = UDim2.fromScale(0, 0.1)
		return
	end
	local offFrame = ui.offFrame
	offFrame.Size = UDim2.fromScale(1, 1)
	TweenService:Create(offFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.fromScale(1, 0.1) }):Play()
	task.delay(0.31, function()
		if not S.on then
			TweenService:Create(offFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.fromScale(0, 0.1) }):Play()
		end
	end)
end
-- F: the next function (a burst of static between)
local function nextFn()
	local switching = S.on and not S.booting and ui.gui ~= nil
	if switching then leaveFn() end
	S.fn = S.fn % #FNS + 1
	S.d.tool:SetAttribute("ScannerFunction", FNS[S.fn])
	play("next_mode")
	local s = sound("NextMode")
	if s then s:Play() end
	if switching then
		S.token += 1
		local token = S.token
		S.booting, S.flash = true, 1
		ui.mode.Text = current().label
		task.delay(0.15, function()
			if S.token ~= token or not S.on or not ui.gui then return end
			S.booting = false
			enterFn()
		end)
	end
end

---- THE GOLDEN TABLET: the Lights it feels, its lightning when charged, what its screen says of them, its frames per second ----

local APPS = { "SNAKE", "FLAPPY", "BREAKOUT", "2048", "TRIS", "FEED" } -- (its own, once powered up)
if GOLDEN then
	-- The Lights: the Guiding Light's and the Curious Light's sparkles (DOORS' own texture, in their colour), and whatever is
	-- named for them; kept up to date as they come and go
	local SPARKLE = "2581223252"
	local function kindOf(i)
		local name = i.Name:lower()
		if name:find("curious", 1, true) then return "Curious" end
		if name:find("guiding", 1, true) then return "Guiding" end
		if i:IsA("ParticleEmitter") and tostring(i.Texture):find(SPARKLE, 1, true) then
			local ok, c = pcall(function() return i.Color.Keypoints[1].Value end)
			if ok and c then
				local h, sat = c:ToHSV()
				if sat > 0.35 and h > 0.07 and h < 0.2 then return "Curious" end
				if sat > 0.35 and h > 0.45 and h < 0.7 then return "Guiding" end
			end
		end
		return nil
	end
	local function consider(i)
		if i:IsA("ParticleEmitter") or i:IsA("BasePart") or i:IsA("Model") or i:IsA("Light") then
			local kind = kindOf(i)
			if kind then GOLD.lights[i] = kind end
		end
	end
	for _, i in ipairs(workspace:GetDescendants()) do consider(i) end
	on(workspace.DescendantAdded, consider)
	-- The Light it feels (18 studs round it): the Curious Light before the Guiding Light; none on you or in your hands
	function GOLD.feel()
		local d = S.d
		if not d then return nil end
		local at, me = d.handle.Position, LocalPlayer.Character
		local felt = nil
		for i, kind in pairs(GOLD.lights) do
			if not i:IsDescendantOf(workspace) then -- (gone)
				GOLD.lights[i] = nil
			elseif kind ~= felt and felt ~= "Curious" and not i:IsDescendantOf(d.tool) and not (me and i:IsDescendantOf(me)) then
				local lit = true
				if i:IsA("ParticleEmitter") then lit = i.Enabled ~= false end
				if i:IsA("Light") then lit = i.Enabled ~= false and (i.Brightness or 1) > 0 end
				local pos = nil
				if lit then
					if i:IsA("BasePart") then
						pos = i.Position
					elseif i:IsA("Model") then
						local ok, cf = pcall(function() return i:GetPivot() end)
						pos = if ok then cf.Position else nil
					else
						local holder = i.Parent
						if holder:IsA("Attachment") then pos = holder.WorldPosition elseif holder:IsA("BasePart") then pos = holder.Position end
					end
				end
				if pos and (pos - at).Magnitude < 18 then felt = kind end
			end
		end
		return felt
	end
end
