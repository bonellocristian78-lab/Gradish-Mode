			if now >= g.over then reset(now) end
		else
			g.px = math.clamp(g.px + heldDir() * 1.1 * dt, PADDLE / 2, 1 - PADDLE / 2)
			if now < g.wait then
				g.bx = g.px
			else
				g.bx += g.vx * dt
				g.by += g.vy * dt
				if g.bx < 0.015 or g.bx > 0.985 then
					g.vx = -g.vx
					g.bx = math.clamp(g.bx, 0.015, 0.985)
				end
				if g.by < 0.02 then
					g.vy = math.abs(g.vy)
				end
				if g.vy > 0 and g.by > 0.88 and g.by < 0.93 and math.abs(g.bx - g.px) < PADDLE / 2 + 0.015 then -- (off the paddle, where it hits it)
					local off = (g.bx - g.px) / (PADDLE / 2)
					local speed = math.min(math.sqrt(g.vx * g.vx + g.vy * g.vy) * 1.02, 0.85)
					g.vx, g.vy = speed * math.sin(off * 1.05), -speed * math.cos(off * 1.05)
					sfx("tap", 1.2)
				end
				local c, r = math.floor(g.bx * COLS), math.floor((g.by - 0.06) / 0.07)
				if r >= 0 and r < ROWS and c >= 0 and c < COLS then
					local b = g.bricks[r * COLS + c + 1]
					if b and b.alive then
						b.alive = false
						b.frame.Visible = false
						g.vy = -g.vy
						g.points += 1
						oneShot(S.d.assets.Found, 1 + (ROWS - r) * 0.06)
						local left = 0
						for _, other in ipairs(g.bricks) do
							if other.alive then left += 1 end
						end
						if left == 0 then level(now) end
					end
				end
				if g.by > 1.02 then
					g.lives -= 1
					oneShot(S.d.assets.Ping, 0.5)
					S.flash = math.max(S.flash, 0.5)
					if g.lives <= 0 then
						g.over = now + 1.6
						S.breakoutBest = math.max(S.breakoutBest or 0, g.points)
					else
						serve(now)
					end
				end
			end
		end
		g.paddle.Position = UDim2.fromScale(g.px, 0.9)
		g.ball.Position = UDim2.fromScale(g.bx, g.by)
		g.ball.Visible = not g.over
		g.score.Text = if g.over then ("GAME OVER  %d"):format(g.points) else ("SCORE %d  LIVES %d"):format(g.points, g.lives)
	end
	FN.BREAKOUT.left = function() return true end -- (held: the paddle; a click is not an on and off)
	FN.BREAKOUT.right = function() return true end
	function FN.BREAKOUT.key(k) return k == Enum.KeyCode.Left or k == Enum.KeyCode.Right end
end

-- 2048: the arrows slide the tiles; two the same make one
local TWENTY = { label = "2048", clean = true } -- (2048: its name is a number)
FN["2048"] = TWENTY
do
	local g = {}
	local function empty()
		local out = {}
		for i = 1, 16 do
			if g.cells[i] == 0 then table.insert(out, i) end
		end
		return out
	end
	local function spawn()
		local list = empty()
		if #list > 0 then g.cells[list[math.random(#list)]] = if math.random() < 0.9 then 2 else 4 end
	end
	local function stuck()
		if #empty() > 0 then return false end
		for r = 0, 3 do
			for c = 0, 3 do
				local v = g.cells[r * 4 + c + 1]
				if (c < 3 and g.cells[r * 4 + c + 2] == v) or (r < 3 and g.cells[(r + 1) * 4 + c + 1] == v) then return false end
			end
		end
		return true
	end
	local function reset()
		g.cells, g.points, g.over = table.create(16, 0), 0, false
		spawn()
		spawn()
	end
	-- One line of four (its indices, the way they slide toward the first): slid and merged
	local function slide(idx)
		local vals = {}
		for _, i in ipairs(idx) do
			if g.cells[i] ~= 0 then table.insert(vals, g.cells[i]) end
		end
		local out, k = {}, 1
		while k <= #vals do
			if vals[k + 1] and vals[k + 1] == vals[k] then
				table.insert(out, vals[k] * 2)
				g.points += vals[k] * 2
				k += 2
			else
				table.insert(out, vals[k])
				k += 1
			end
		end
		local moved = false
		for n, i in ipairs(idx) do
			local v = out[n] or 0
			if g.cells[i] ~= v then moved = true end
			g.cells[i] = v
		end
		return moved
	end
	local function push(dir) -- 1 left, 2 right, 3 up, 4 down
		local moved = false
		for line = 0, 3 do
			local idx = {}
			for k = 0, 3 do
				if dir == 1 then table.insert(idx, line * 4 + k + 1)
				elseif dir == 2 then table.insert(idx, line * 4 + (3 - k) + 1)
				elseif dir == 3 then table.insert(idx, k * 4 + line + 1)
				else table.insert(idx, (3 - k) * 4 + line + 1) end
			end
			if slide(idx) then moved = true end
		end
		if moved then
			spawn()
			sfx("tap", 1.3)
			if stuck() then
				g.over = true
				S.best2048 = math.max(S.best2048 or 0, g.points)
				oneShot(S.d.assets.Ping, 0.5)
			end
		end
	end
	function TWENTY.enter(c)
		g.score = W.text(c, { Size = UDim2.fromScale(1, 0.11), TextXAlignment = Enum.TextXAlignment.Left })
		local grid = W.new("Frame", c, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.13), Size = UDim2.fromScale(0.86, 0.86) })
		W.new("UIAspectRatioConstraint", grid, { AspectRatio = 1 })
		g.tiles = {}
		for i = 1, 16 do
			local r, col = math.floor((i - 1) / 4), (i - 1) % 4
			local tile = W.new("Frame", grid, { Position = UDim2.new(col / 4, 2, r / 4, 2), Size = UDim2.new(0.25, -4, 0.25, -4), BackgroundColor3 = CONFIG.Screen, BackgroundTransparency = 0.85 })
			W.new("UICorner", tile, { CornerRadius = UDim.new(0.12, 0) })
			g.tiles[i] = { frame = tile, text = W.text(tile, { Size = UDim2.fromScale(1, 1), ZIndex = 10 }) }
		end
		if not g.cells then reset() end
	end
	function TWENTY.step(_, now)
		for i = 1, 16 do
			local v, t = g.cells[i], g.tiles[i]
			t.frame.BackgroundTransparency = if v == 0 then 0.85 else math.max(0.6 - math.log(v, 2) * 0.05, 0.05)
			t.text.Text = if v == 0 then "" else tostring(v)
			t.text.TextColor3 = if v >= 8 then hsv(CONFIG.Screen, 0.15) else CONFIG.Screen
		end
		g.score.Text = if g.over then (if math.floor(now * 2) % 2 == 0 then "NO MOVES  CLICK" else ("SCORE %d"):format(g.points)) else ("SCORE %d  BEST %d"):format(g.points, math.max(S.best2048 or 0, g.points))
	end
	function TWENTY.key(k)
		local dir = ({ [Enum.KeyCode.Left] = 1, [Enum.KeyCode.Right] = 2, [Enum.KeyCode.Up] = 3, [Enum.KeyCode.Down] = 4 })[k]
		if not dir then return false end
		if not g.over then push(dir) end
		return true
	end
	TWENTY.left = function()
		if g.over then reset() end
		return true
	end
end

-- TRIS: you and it, noughts and crosses; the arrows choose, a click plays (X); it plays O
FN.TRIS = { label = "TRIS", clean = true }
do
	local g = {}
	local LINES = { { 1, 2, 3 }, { 4, 5, 6 }, { 7, 8, 9 }, { 1, 4, 7 }, { 2, 5, 8 }, { 3, 6, 9 }, { 1, 5, 9 }, { 3, 5, 7 } }
	local function winner(b)
		for _, l in ipairs(LINES) do
			if b[l[1]] ~= "" and b[l[1]] == b[l[2]] and b[l[2]] == b[l[3]] then return b[l[1]] end
		end
		for i = 1, 9 do
			if b[i] == "" then return nil end
		end
		return "DRAW"
	end
	local function reset()
		g.b, g.cursor, g.result, g.thinking = table.create(9, ""), 5, nil, false
	end
	local function aiMove() -- win, block, the middle, a corner, anything
		for _, mark in ipairs({ "O", "X" }) do
			for _, l in ipairs(LINES) do
				local count, free = 0, nil
				for _, i in ipairs(l) do
					if g.b[i] == mark then count += 1 elseif g.b[i] == "" then free = i end
				end
				if count == 2 and free then return free end
			end
		end
		if g.b[5] == "" then return 5 end
		local corners = {}
		for _, i in ipairs({ 1, 3, 7, 9 }) do
			if g.b[i] == "" then table.insert(corners, i) end
		end
		if #corners > 0 then return corners[math.random(#corners)] end
		for i = 1, 9 do
			if g.b[i] == "" then return i end
		end
		return nil
	end
	local function finish()
		g.result = winner(g.b)
		if g.result then
			S.trisScore = S.trisScore or { X = 0, O = 0 }
			if g.result == "X" or g.result == "O" then S.trisScore[g.result] += 1 end
			oneShot(if g.result == "X" then S.d.assets.Found else S.d.assets.Ping, 0.8)
		end
	end
	function FN.TRIS.enter(c)
		g.score = W.text(c, { Size = UDim2.fromScale(1, 0.11), TextXAlignment = Enum.TextXAlignment.Left })
		local grid = W.new("Frame", c, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.13), Size = UDim2.fromScale(0.86, 0.86) })
		W.new("UIAspectRatioConstraint", grid, { AspectRatio = 1 })
		g.cells = {}
		for i = 1, 9 do
			local r, col = math.floor((i - 1) / 3), (i - 1) % 3
			local cell = W.new("Frame", grid, { Position = UDim2.new(col / 3, 2, r / 3, 2), Size = UDim2.new(1 / 3, -4, 1 / 3, -4), BackgroundColor3 = CONFIG.Screen })
			W.new("UIStroke", cell, { Color = CONFIG.Screen, Thickness = 1 })
			g.cells[i] = { frame = cell, text = W.text(cell, { Size = UDim2.fromScale(1, 1), ZIndex = 10 }) }
		end
		if not g.b then reset() end
	end
	function FN.TRIS.step(_, now)
		for i = 1, 9 do
			local cell = g.cells[i]
			cell.text.Text = g.b[i]
			cell.frame.BackgroundTransparency = if i == g.cursor and not g.result and math.floor(now * 3) % 2 == 0 then 0.55 else 0.9
		end
		local score = S.trisScore or { X = 0, O = 0 }
		g.score.Text = if g.result == "DRAW" then "DRAW  CLICK" elseif g.result then (if g.result == "X" then "YOU WIN  CLICK" else "IT WINS  CLICK")
			else ("YOU %d  IT %d"):format(score.X, score.O)
	end
	function FN.TRIS.key(k)
		local move = ({ [Enum.KeyCode.Left] = -1, [Enum.KeyCode.Right] = 1, [Enum.KeyCode.Up] = -3, [Enum.KeyCode.Down] = 3 })[k]
		if not move then return false end
		local n = g.cursor + move
		if (move == -1 and g.cursor % 3 == 1) or (move == 1 and g.cursor % 3 == 0) or n < 1 or n > 9 then return true end
		g.cursor = n
		sfx("tap", 1.6)
		return true
	end
	FN.TRIS.left = function()
		if g.result then
			reset()
			return true
		end
		if g.thinking or g.b[g.cursor] ~= "" then return true end
		g.b[g.cursor] = "X"
		sfx("tap", 1.2)
		finish()
		if not g.result then
			g.thinking = true
			task.delay(0.45, function()
				g.thinking = false
				local i = aiMove()
				if i and not g.result then
					g.b[i] = "O"
					sfx("tap", 0.9)
					finish()
				end
			end)
		end
		return true
	end
end

