local KIND_NAMES = { nokia = "Nokia", radar = "Nokia", scanner = "Nokia", objectscanner = "Nokia", tablet = "Tablet", nvcs = "Tablet",
	nvcs3000 = "Tablet" }
local LIGHTS = {
