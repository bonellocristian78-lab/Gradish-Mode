-- What is coming: DOORS' entities (the ones that run through the rooms are "moving")
local THREATS = { RushMoving = "RUSH", AmbushMoving = "AMBUSH", BackdoorRush = "BLITZ", A60 = "A-60", A120 = "A-120", GlitchRush = "GLITCH",
	GlitchAmbush = "GLITCH", JeffTheKiller = "JEFF", SeekMovingNewClone = "SEEK", SeekMoving = "SEEK", Eyes = "EYES", BackdoorLookman = "LOOKMAN",
