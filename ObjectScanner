end

-- FLAPPY: click (or Space, or up) to flap, through the gaps
FN.FLAPPY = { label = "FLAPPY", clean = true }
do
	local g = {}
	local GAP, PIPE, SPEED, FALL, FLAP, X = 0.38, 0.12, 0.34, 2.3, -0.78, 0.25
	local function clear()
		for _, p in ipairs(g.pipes or {}) do
			p.top:Destroy()
			p.bottom:Destroy()
		end
		g.pipes = {}
	end
	local function reset(now)
		clear()
		g.y, g.vy, g.next, g.points, g.over, g.started = 0.5, 0, now + 0.4, 0, nil, false
		if g.hint then g.hint.Visible = true end
	end
	local function die(now)
		g.over = now + 1.4
		S.flappyBest = math.max(S.flappyBest or 0, g.points)
		oneShot(S.d.assets.Ping, 0.5)
		S.flash = math.max(S.flash, 0.6)
	end
	function FN.FLAPPY.enter(c)
		g.score = W.text(c, { Size = UDim2.fromScale(1, 0.11), TextXAlignment = Enum.TextXAlignment.Left })
		g.board = board(c)
		g.bird = W.round(block(g.board, 10), 0.35)
		g.bird.AnchorPoint, g.bird.Size = Vector2.new(0.5, 0.5), UDim2.fromScale(0.07, 0.1)
		g.hint = W.text(g.board, { Position = UDim2.fromScale(0, 0.72), Size = UDim2.fromScale(1, 0.12), Text = "CLICK TO FLAP", TextTransparency = 0.3 })
		g.pipes = {}
		reset(os.clock())
	end
	function FN.FLAPPY.step(dt, now)
		dt = math.min(dt, 0.05)
		if g.over then
			if now >= g.over then reset(now) end
		elseif g.started then
			g.vy += FALL * dt
			g.y += g.vy * dt
			if now >= g.next then
				g.next = now + 1.45
				table.insert(g.pipes, { x = 1.02, gap = 0.26 + math.random() * 0.48, top = block(g.board), bottom = block(g.board) })
			end
			for i = #g.pipes, 1, -1 do
				local p = g.pipes[i]
				p.x -= SPEED * dt
				if p.x < -PIPE - 0.05 then
					p.top:Destroy()
					p.bottom:Destroy()
					table.remove(g.pipes, i)
				else
					if p.x < X + 0.03 and p.x + PIPE > X - 0.03 and (g.y - 0.045 < p.gap - GAP / 2 or g.y + 0.045 > p.gap + GAP / 2) then die(now) end
					if not p.passed and p.x + PIPE < X - 0.03 then
						p.passed = true
						g.points += 1
						oneShot(S.d.assets.Found, 1 + math.min(g.points, 20) * 0.03)
					end
				end
			end
			if not g.over and (g.y > 0.96 or g.y < 0.04) then die(now) end
		end
		for _, p in ipairs(g.pipes) do
			p.top.Position, p.top.Size = UDim2.fromScale(p.x, 0), UDim2.fromScale(PIPE, math.max(p.gap - GAP / 2, 0))
			p.bottom.Position, p.bottom.Size = UDim2.fromScale(p.x, p.gap + GAP / 2), UDim2.fromScale(PIPE, math.max(1 - p.gap - GAP / 2, 0))
		end
		g.bird.Position = UDim2.fromScale(X, g.y)
		g.bird.Rotation = math.clamp(g.vy * 45, -30, 70)
		g.bird.BackgroundTransparency = if g.over and math.floor(now * 6) % 2 == 1 then 0.75 else 0
		g.score.Text = if g.over then ("GAME OVER  %d"):format(g.points) else ("SCORE %d  BEST %d"):format(g.points, math.max(S.flappyBest or 0, g.points))
	end
	local function flap()
		if g.over then return true end
		g.started = true
		g.hint.Visible = false
		g.vy = FLAP
		sfx("tap", 1.5)
		return true
	end
	FN.FLAPPY.left, FN.FLAPPY.right = flap, flap
	function FN.FLAPPY.key(k)
		if k == Enum.KeyCode.Space or k == Enum.KeyCode.Up then return flap() end
		return false
	end
	function FN.FLAPPY.leave() g.pipes = {} end
end

