---- ITS MODEL: DOORS' own (Nokia) or the tablet's; held as DOORS holds its scanner ----

local FRONT = Enum.NormalId.Front

-- Every part of it (not what it keeps in its folders)
local function partsOf(tool)
	local out = {}
	for _, child in ipairs(tool:GetChildren()) do
		if child:IsA("BasePart") then table.insert(out, child) end
		if child:IsA("BasePart") or child:IsA("Model") then
			for _, d in ipairs(child:GetDescendants()) do
				if d:IsA("BasePart") then table.insert(out, d) end
			end
		end
	end
	return out
end
-- The middle of what you see of it, in its handle's space (what its tricks turn about)
local function centreOf(tool, handle)
	local lo, hi = { math.huge, math.huge, math.huge }, { -math.huge, -math.huge, -math.huge }
	for _, p in ipairs(partsOf(tool)) do
		if p.Transparency < 1 then
			local at, half = handle.CFrame:PointToObjectSpace(p.Position), p.Size / 2
			lo = { math.min(lo[1], at.X - half.X), math.min(lo[2], at.Y - half.Y), math.min(lo[3], at.Z - half.Z) }
			hi = { math.max(hi[1], at.X + half.X), math.max(hi[2], at.Y + half.Y), math.max(hi[3], at.Z + half.Z) }
		end
	end
	if lo[1] > hi[1] then return Vector3.new(0, 0, 0) end
	return Vector3.new((lo[1] + hi[1]) / 2, (lo[2] + hi[2]) / 2, (lo[3] + hi[3]) / 2)
end

-- A new scanner of the kind chosen: { tool, handle, screen, face, native, grip, centre, assets }
local function make()
	local d = {}
	local tool
	if KIND == "Nokia" then
		tool = template:Clone()
		tool.Name = "ObjectScanner"
		d.handle, d.screen, d.face = tool.Handle, tool.Handle.Top.Screen, FRONT
		tool.Handle.Top.Screen.ScreenUI.Enabled = false
	else
		tool = tabletModel:Clone()
		tool.Name = TITLE
		d.handle, d.screen, d.native = tool.Handle, tool.Handle.Screen, true -- its own animations (fire, equip, idle) and sounds (Use, Idle, Disable)
		local own = tool:FindFirstChild("Storage") and tool.Storage:FindFirstChild("ScreenUI")
		d.face = if own and own:IsA("SurfaceGui") then own.Face else FRONT
	end
	-- What every kind needs of DOORS' scanner: its sounds, its star and pings, its animations, its Inspect
	for _, name in ipairs({ "NextMode", "ScannedIdle" }) do
		if not d.handle:FindFirstChild(name) then template.Handle[name]:Clone().Parent = d.handle end
	end
	if not tool:FindFirstChild("ScannerAssets") then template.ScannerAssets:Clone().Parent = tool end
	if not tool:FindFirstChild("Animations") then template.Animations:Clone().Parent = tool end
	if not tool:FindFirstChild("Inspect") then
		local inspect = Instance.new("BindableEvent")
		inspect.Name = "Inspect"
		inspect.Parent = tool
	end
	for _, s in ipairs(tool:GetDescendants()) do
		if s:IsA("Sound") then s.Playing = false end
	end
	tool:SetAttribute("ScannerMode", "")
	tool:SetAttribute("Durability", tool:GetAttribute("DurabilityMax") or 300) -- full, and it stays so
	tool:SetAttribute("_OriginalOwner", nil)
	tool:SetAttribute("_ServerAnimated", true) -- its animations are played here, not by DOORS' inventory
	tool:SetAttribute("CannotDrop", true) -- dropped here (X), not by DOORS' server, which does not know it
	tool:SetAttribute("NameSingular", TITLE)
	tool:SetAttribute("NamePlural", TITLE)
	tool:SetAttribute("GradishScanner", true)
	tool.RequiresHandle = false -- no Roblox grip: it is held on its own Motor6D, as in DOORS
	tool.CanBeDropped = false
	pcall(function() tool:AddTag("Tool") end)
	for _, p in ipairs(partsOf(tool)) do p.CanCollide, p.CanQuery, p.CanTouch, p.Massless, p.Anchored = false, false, false, true, false end
	d.tool = tool
	local grip = d.handle:FindFirstChild("ToolGripAttach")
	d.grip = if grip then grip.CFrame else tool.Grip
	d.centre = centreOf(tool, d.handle)
	d.assets = tool.ScannerAssets
	if GOLDEN then -- the Golden Tablet: its body gold (its screen as it is), and its screen turned upright for when it is held as a phone
		for _, p in ipairs(partsOf(tool)) do
			if p ~= d.screen and p.Transparency < 1 then
				pcall(function() p.TextureID = "" end)
				local _, sat, v = p.Color:ToHSV()
				p.Color = Color3.fromHSV(0.12, math.clamp(0.55 + sat * 0.4, 0, 1), math.clamp(0.5 + v * 0.5, 0, 1))
				p.Material, p.Reflectance = Enum.Material.Foil, 0.08
			end
		end
		for _, a in ipairs(tool:GetDescendants()) do
			if a:IsA("SurfaceAppearance") then a:Destroy() end
		end
		local n = Vector3.FromNormalId(d.face) -- (its screen's face, in its own space: the axis it turns about)
		local size = d.screen.Size
		local swapped = if math.abs(n.Z) > 0.5 then Vector3.new(size.Y, size.X, size.Z) elseif math.abs(n.X) > 0.5 then Vector3.new(size.X, size.Z, size.Y)
			else Vector3.new(size.Z, size.Y, size.X)
		local upright = Instance.new("Part")
		upright.Name = "ScreenUpright"
		upright.Size, upright.Transparency = swapped, 1
		upright.CFrame = d.screen.CFrame * CFrame.fromAxisAngle(n, -math.pi / 2)
		upright.CanCollide, upright.CanQuery, upright.CanTouch, upright.Massless, upright.Anchored = false, false, false, true, false
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1 = d.screen, upright
		weld.Parent = upright
		upright.Parent = d.screen
		d.upright = upright
		d.normal = d.handle.CFrame:VectorToObjectSpace(d.screen.CFrame:VectorToWorldSpace(n)) -- (the same axis, in its handle's space)
	end
	if LIGHT then -- the Light's glow on it, and its sparkles
		local color = LIGHTS[LIGHT].color
		local glow = Instance.new("PointLight")
		glow.Name = "LightGlow"
		glow.Color, glow.Brightness, glow.Range, glow.Shadows = color, 1, 6, false
		glow.Parent = d.handle
		local at = Instance.new("Attachment")
		at.Name = "LightSparkles"
		at.Position = d.centre
		at.Parent = d.handle
		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Name = "Sparkles"
		sparkles.Texture = "rbxassetid://2581223252" -- DOORS' own (the Guiding Light's, on the doors)
		sparkles.Color = ColorSequence.new(color)
		sparkles.LightEmission = 1
		sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12), NumberSequenceKeypoint.new(1, 0) })
		sparkles.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		sparkles.Lifetime = NumberRange.new(0.6, 1.2)
		sparkles.Rate = 7
		sparkles.Speed = NumberRange.new(0.2, 0.6)
		sparkles.SpreadAngle = Vector2.new(180, 180)
		sparkles.Parent = at
	end
	return d
end

---- ITS ICON: its own (DOORS' / the tablet's). In a Light's colour or yours: its own picture, its screen recoloured, the
---- Light's glow and sparkles around it (made once, kept in the executor's folder) ----

local ICON_BASES = { Nokia = "assets/scanner/Nokia.icon", Tablet = "assets/scanner/Tablet.icon" } -- its own picture, ready to be recoloured
local ICON = {}
do
	local function clamp01(x) return if x < 0 then 0 elseif x > 1 then 1 else x end
	local function toHSV(r, g, b)
		local mx, mn = math.max(r, g, b), math.min(r, g, b)
		local d = mx - mn
		local h = 0
		if d > 0 then
			if mx == r then h = ((g - b) / d) % 6 elseif mx == g then h = (b - r) / d + 2 else h = (r - g) / d + 4 end
			h /= 6
		end
		return h, if mx > 0 then d / mx else 0, mx
	end
	local function fromHSV(h, s, v)
		local i = math.floor(h * 6) % 6
		local f = h * 6 - math.floor(h * 6)
		local p, q, t = v * (1 - s), v * (1 - f * s), v * (1 - (1 - f) * s)
		if i == 0 then return v, t, p elseif i == 1 then return q, v, p elseif i == 2 then return p, v, t
		elseif i == 3 then return p, q, v elseif i == 4 then return t, p, v end
		return v, p, q
	end

	local CRC = {}
	for n = 0, 255 do
		local c = n
		for _ = 1, 8 do c = if bit32.band(c, 1) == 1 then bit32.bxor(0xEDB88320, bit32.rshift(c, 1)) else bit32.rshift(c, 1) end
		CRC[n] = c
	end
	local function crc32(s)
		local c = 0xFFFFFFFF
		for i = 1, #s do c = bit32.bxor(CRC[bit32.band(bit32.bxor(c, string.byte(s, i)), 0xFF)], bit32.rshift(c, 8)) end
		return bit32.bxor(c, 0xFFFFFFFF)
	end
	local function u32(n) return string.char(bit32.band(bit32.rshift(n, 24), 255), bit32.band(bit32.rshift(n, 16), 255), bit32.band(bit32.rshift(n, 8), 255), bit32.band(n, 255)) end
	local function chunk(kind, data) return u32(#data) .. kind .. data .. u32(crc32(kind .. data)) end
	-- Rows of RGBA (each after its filter byte) as a PNG: stored, not packed, inside zlib
	local function encode(w, h, raw)
		local a, b = 1, 0
		for i = 1, #raw do
			a = (a + string.byte(raw, i)) % 65521
			b = (b + a) % 65521
		end
		local parts, at = { "\120\1" }, 1
		while at <= #raw do
			local piece = raw:sub(at, at + 65534)
			at += #piece
			local last = if at > #raw then 1 else 0
			table.insert(parts, string.char(last, #piece % 256, math.floor(#piece / 256), 255 - #piece % 256, 255 - math.floor(#piece / 256)) .. piece)
		end
		table.insert(parts, u32(b * 65536 + a))
		return "\137PNG\r\n\26\n" .. chunk("IHDR", u32(w) .. u32(h) .. "\8\6\0\0\0") .. chunk("IDAT", table.concat(parts)) .. chunk("IEND", "")
	end

	local SCREEN_S = 0.63 -- how green its screen is in its own picture (its saturation)
	-- The Golden Tablet's gold: its body's light (0 dark, 1 bright) to a colour
	local GOLD_RAMP = { { 0, 0.2, 0.11, 0.02 }, { 0.3, 0.59, 0.36, 0.05 }, { 0.62, 0.93, 0.72, 0.23 }, { 0.85, 1, 0.89, 0.51 }, { 1, 1, 0.98, 0.84 } }
	local function goldAt(l)
		for i = 2, #GOLD_RAMP do
			local a, b = GOLD_RAMP[i - 1], GOLD_RAMP[i]
			if l <= b[1] then
				local u = (l - a[1]) / (b[1] - a[1])
				return a[2] + (b[2] - a[2]) * u, a[3] + (b[3] - a[3]) * u, a[4] + (b[4] - a[4]) * u
			end
		end
		return 1, 0.98, 0.84
	end
	--[[ ICON.paint(base, color, light, gilded): a PNG of its own picture (base: a .icon file, see assets/scanner/) with its
	     screen, and the green it casts on its body, in `color` (what the file says takes it); with `light`, the Light's
	     glow and sparkles in it; `gilded` (the Golden Tablet): its body gold, a softer glow, no sparkles. Colours as
	     { r, g, b }, 0 to 1 ]]
	function ICON.paint(base, color, light, gilded)
		assert(base:sub(1, 8) == "SCNICON2", "not an icon")
		local w, h = base:byte(9) * 256 + base:byte(10), base:byte(11) * 256 + base:byte(12)
		local th, ts, tv = toHSV(color[1], color[2], color[3])
		local rows, at = table.create(h), 13
		for y = 1, h do
			local row = table.create(w + 1)
			row[1] = "\0"
			for x = 1, w do
				local r, g, b, a, glow, spark, core, paint = string.byte(base, at, at + 7)
				at += 8
				r, g, b, a = r / 255, g / 255, b / 255, a / 255
				local _, s0 = toHSV(r, g, b)
				local body = 1 - clamp01((s0 - 0.25) / 0.2) -- (not its screen: grey)
				local l0 = 0.299 * r + 0.587 * g + 0.114 * b
				if paint > 0 then -- its screen (saturated), and its light on the body: to the new colour
					local _, s, v = toHSV(r, g, b)
					local m, k = clamp01((s - 0.25) / 0.2), paint / 255
					local nr, ng, nb = fromHSV(th, math.min(s * ts / SCREEN_S, 1), v * (1 - m + m * tv))
					r, g, b = r + (nr - r) * k, g + (ng - g) * k, b + (nb - b) * k
				end
				if gilded and a > 0 then -- its body gold, by its own light
					local gr, gg, gb = goldAt(clamp01(l0 / 0.8))
					r, g, b = r + (gr - r) * body, g + (gg - g) * body, b + (gb - b) * body
				end
				if light then
					local ga = glow / 255 * (if gilded then 0.35 else 0.55) -- under it, its glow
					local under = ga * (1 - a)
					local out = a + under
					if out > 0 then
						r, g, b = (r * a + light[1] * under) / out, (g * a + light[2] * under) / out, (b * a + light[3] * under) / out
					end
					a = out
					for _, layer in ipairs(if gilded then {} else { { spark / 255, light }, { core / 255, { 1, 1, 1 } } }) do -- over it, its sparkles
						local k, c = layer[1], layer[2]
						if k > 0 then
							local keep = a * (1 - k)
							out = k + keep
							r, g, b = (c[1] * k + r * keep) / out, (c[2] * k + g * keep) / out, (c[3] * k + b * keep) / out
							a = out
						end
					end
				end
				row[x + 1] = string.char(math.floor(clamp01(r) * 255 + 0.5), math.floor(clamp01(g) * 255 + 0.5), math.floor(clamp01(b) * 255 + 0.5), math.floor(clamp01(a) * 255 + 0.5))
			end
			rows[y] = table.concat(row)
		end
		return encode(w, h, table.concat(rows))
	end
end
---- END ICON ----

-- Its icon in your inventory: its own; in a Light or in a colour of yours, its own recoloured (once, then kept); the Golden
-- Tablet's, its own in gold
local function useIcon(d)
	local base = ICON_BASES[KIND]
	if not (base and (LIGHT or CUSTOM)) then return end
	local c = CONFIG.Screen
	local path = ("ObjectScanner/Icons/%s_%s_%02x%02x%02x_2.png"):format(KIND, LIGHT or "Normal", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
	pcall(function()
		if not isfolder("ObjectScanner") then makefolder("ObjectScanner") end
		if not isfolder("ObjectScanner/Icons") then makefolder("ObjectScanner/Icons") end
		if not isfile(path) then
			local data = nil
			for _, branch in ipairs(BRANCHES) do
				local ok, body = pcall(function() return game:HttpGet(REPO .. branch .. "/" .. base) end)
				if ok and type(body) == "string" and body:sub(1, 8) == "SCNICON2" then
					data = body
					break
				end
			end
			if not data then return end
			local function three(color) return { color.R, color.G, color.B } end
			writefile(path, ICON.paint(data, three(c), if LIGHT then three(LIGHTS[LIGHT].color) else nil, GOLDEN))
		end
		d.tool.TextureId = getcustomasset(path)
	end)
end

---- ITS SCREEN: DOORS' scanner's (its picture, its frame, its battery, its static) on both, in its colour ----

local S = {
	d = nil, -- the scanner: what make() gave
	on = false, fn = 1, booting = false, token = 0, -- its screen: on or off, its function (FNS), booting
