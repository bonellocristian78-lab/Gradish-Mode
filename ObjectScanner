local W = {}
function W.new(class, parent, props)
	local o = Instance.new(class)
	if o:IsA("GuiObject") then
		o.BackgroundTransparency = 1
		o.BorderSizePixel = 0
		o.ZIndex = 8
	end
	for k, v in pairs(props or {}) do o[k] = v end
	o.Parent = parent
	return o
end
function W.text(parent, props)
	local l = W.new("TextLabel", parent, { TextColor3 = CONFIG.Screen, TextScaled = true, Text = "" })
	pcall(function() l.FontFace = ui.mode.FontFace end)
	for k, v in pairs(props) do l[k] = v end
	return l
end
function W.round(o, k) W.new("UICorner", o, { CornerRadius = UDim.new(k or 1, 0) }) return o end
function W.square(o) W.new("UIAspectRatioConstraint", o, { AspectRatio = 1 }) return o end
-- An arrow (its top is where it points): Rotation in degrees, clockwise
function W.arrow(parent, position, size)
	local holder = W.square(W.new("Frame", parent, { AnchorPoint = Vector2.new(0.5, 0.5), Position = position, Size = size }))
	local c = CONFIG.Screen
	W.new("Frame", holder, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.12), Size = UDim2.fromScale(0.13, 0.8), BackgroundColor3 = c, BackgroundTransparency = 0 })
	for _, side in ipairs({ -1, 1 }) do
		W.new("Frame", holder, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5 + side * 0.13, 0.24), Size = UDim2.fromScale(0.13, 0.42),
			Rotation = -side * 45, BackgroundColor3 = c, BackgroundTransparency = 0 })
	end
	return holder
end
local function flat(v)
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 1e-3 then f.Unit else Vector3.new(0, 0, -1)
end
-- Where something is, seen from you, as the camera looks: right (x) and ahead (y), in studs
local function relative(pos)
	local cam = workspace.CurrentCamera
	local character = LocalPlayer.Character
	local root = character and character.PrimaryPart
	local from = if root then root.Position else cam.CFrame.Position
	local rel = pos - from
	return rel:Dot(flat(cam.CFrame.RightVector)), rel:Dot(flat(cam.CFrame.LookVector))
end
-- The angle of an arrow to it (0: ahead)
local function bearing(pos)
	local x, y = relative(pos)
	return math.deg(math.atan2(x, y))
end
-- A radar: you in the middle, looking up; dots for what is around, out to `range` studs
function W.radar(parent, range)
	local r = { range = range, dots = {} }
	local c = CONFIG.Screen
	local disc = W.round(W.square(W.new("Frame", parent, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromScale(0.8, 0.8), BackgroundColor3 = hsv(c, 0.35), BackgroundTransparency = 0.75 })))
	W.new("UIStroke", disc, { Color = c, Thickness = 1.5 })
	local inner = W.round(W.new("Frame", disc, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.5, 0.5) }))
	W.new("UIStroke", inner, { Color = c, Thickness = 1, Transparency = 0.5 })
	W.new("Frame", disc, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = c, BackgroundTransparency = 0.7 })
	W.new("Frame", disc, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 1, 1, 0), BackgroundColor3 = c, BackgroundTransparency = 0.7 })
	r.sweep = W.new("Frame", disc, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 2, 0.5, 0), BackgroundColor3 = c, BackgroundTransparency = 0.35 })
	W.arrow(disc, UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.16, 0.16))
	r.disc = disc
	-- list: { { pos = Vector3, hot = blinking } }
	function r.show(list, now)
		for i, item in ipairs(list) do
			local dot = r.dots[i]
			if not dot then
				dot = W.round(W.square(W.new("Frame", disc, { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = c, BackgroundTransparency = 0, ZIndex = 9 })))
				r.dots[i] = dot
			end
			local x, y = relative(item.pos)
			x, y = x / r.range, y / r.range
			local m = math.sqrt(x * x + y * y)
			if m > 1 then x, y = x / m, y / m end -- farther: on the edge, smaller
			dot.Position = UDim2.fromScale(0.5 + x * 0.5, 0.5 - y * 0.5)
			dot.Size = UDim2.fromScale(if m > 1 then 0.06 else 0.1, if m > 1 then 0.06 else 0.1)
			dot.BackgroundTransparency = if item.hot and math.floor(now * 6) % 2 == 1 then 0.75 else 0
			dot.Visible = true
		end
		for i = #list + 1, #r.dots do r.dots[i].Visible = false end
		r.sweep.Rotation = (now * 200) % 360
	end
	return r
end
-- Distance, as it says it: metres (a stud is 0.28 m)
local function metres(studs) return ("%dm"):format(math.floor(studs * 0.28 + 0.5)) end

