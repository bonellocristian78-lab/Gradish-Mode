	smoke.Size = sequence({ { 0, 2 }, { 1, 5 } })
	smoke.Transparency = sequence({ { 0, 1 }, { 0.2, 0.35 }, { 1, 1 } })
	smoke.RotSpeed = NumberRange.new(-40, 40)
	smoke.Rotation = NumberRange.new(0, 360)
	smoke.Rate = 0
	smoke.Parent = disc

	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = "rbxassetid://" .. CONFIG.Textures.Spark
	sparks.Color = ColorSequence.new(WHITE)
	sparks.LightEmission = 1
	sparks.LightInfluence = 0
	sparks.EmissionDirection = Enum.NormalId.Bottom
	sparks.Lifetime = NumberRange.new(0.6, 1.6)
	sparks.Speed = NumberRange.new(3, 10)
	sparks.Acceleration = Vector3.new(0, -8, 0)
	sparks.SpreadAngle = Vector2.new(35, 35)
	sparks.Size = sequence({ { 0, 0.8 }, { 1, 0 } })
	sparks.Rate = 0
	sparks.Parent = disc

	local streaks = Instance.new("ParticleEmitter")
	streaks.Texture = "rbxassetid://" .. CONFIG.Textures.Streak
	streaks.Color = ColorSequence.new(WHITE)
	streaks.LightEmission = 0.4
	streaks.LightInfluence = 0
	streaks.Orientation = Enum.ParticleOrientation.VelocityParallel
	streaks.EmissionDirection = Enum.NormalId.Bottom
	streaks.Lifetime = NumberRange.new(0.3, 0.5)
	streaks.Speed = NumberRange.new(20, 35)
	streaks.Size = sequence({ { 0, 1.2 }, { 1, 0 } })
	streaks.Transparency = sequence({ { 0, 0.5 }, { 1, 1 } })
	streaks.Rate = 0
