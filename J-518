---====== IL CORPO ======---
--[[ Il corpo non va più a scatti. La logica dice dove deve andare e dove deve guardare; un solo
     ciclo per frame ce lo porta: accelera al massimo di Acceleration, va a Speed, rallenta da solo
     negli ultimi stud e si ferma senza strappi. La discesa e la risalita invece scrivono loro la
     posizione (driven), perché sono curve disegnate apposta.

     Sopra la posizione ci sono gli strati:
     - galleggia: due onde lente su e giù, e un dondolio
     - si piega in avanti quando accelera, all'indietro quando frena, di lato quando curva
     - il colpo per bussare: si carica all'indietro, colpisce, rimbalza e si ferma
     - ascolta: si sporge verso l'anta
     - la grandezza, per uscire dal portale e rientrarci ]]

local model, sounds = nil, {}

local SLOW_RADIUS = 8     -- da quanti stud dall'arrivo inizia a rallentare
local KNOCK_HIT   = 0.3   -- il colpo arriva a questo punto del movimento, dopo la carica

local body = {
	position     = Vector3.zero, -- dove sta, senza gli strati
	velocity     = Vector3.zero,
	lastPosition = Vector3.zero,
	lastVelocity = Vector3.zero,
	goal         = nil,          -- dove sta andando; nil = si ferma piano dove si trova
	driven       = false,
	lookAt       = nil,          -- dove guarda; nil = dove va
	yaw          = 0,
	yawSpeed     = 0,
	spin         = 0,            -- giri al secondo in più (quando viene risucchiato)
	pitch        = 0,
	roll         = 0,
	knockAt      = -math.huge,   -- quando è partito l'ultimo colpo
	listen       = 0,
	listenTarget = 0,
	scale        = 1,
	shownScale   = 1,
}

-- Il colpo nel tempo: quanto va avanti lungo lo sguardo, e quanto si piega in avanti
local function knockOffset(t)
	if t < 0 or t > 1.2 then return 0, 0 end
	if t < 0.22 then
		local x = smooth(t / 0.22)
		return -0.7 * x, -0.12 * x
	elseif t < KNOCK_HIT then
		local x = ((t - 0.22) / (KNOCK_HIT - 0.22)) ^ 2
		return -0.7 + 2.9 * x, -0.12 + 0.4 * x
	end
	local x = t - KNOCK_HIT
	local wave = math.exp(-x * 7) * math.cos(x * 11)
	return 2.2 * wave, 0.28 * wave
end

stepBody = function(deltaTime)
	if not (model and model.Parent) or state.paused or state.caught then return end
	deltaTime = math.clamp(deltaTime, 1 / 240, 1 / 20)
	local now = os.clock()

	if body.driven then
		body.velocity = (body.position - body.lastPosition) / deltaTime
	else
		local desired = Vector3.zero
		if body.goal then
			local offset = body.goal - body.position
			local distance = offset.Magnitude
			if distance > 0.01 then
				desired = offset.Unit * CONFIG.Speed * math.min(distance / SLOW_RADIUS, 1)
			end
		end
		local steer = (desired - body.velocity) * 8 -- con SLOW_RADIUS 8: arriva senza superare il punto
		if steer.Magnitude > CONFIG.Acceleration then
			steer = steer.Unit * CONFIG.Acceleration
		end
		body.velocity += steer * deltaTime
		body.position += body.velocity * deltaTime
	end
	body.lastPosition = body.position

	-- Guarda dove deve, se no dove va; si gira piano
	local flat = Vector3.new(body.velocity.X, 0, body.velocity.Z)
	local target = body.yaw
	local look = body.lookAt and flatUnit(body.lookAt - body.position)
	if look then
		target = yawOf(look)
	elseif flat.Magnitude > 1.5 then
		target = yawOf(flat)
	end
	local before = body.yaw
	body.yaw = turnTowards(body.yaw, target, 1 - math.exp(-5 * deltaTime)) + body.spin * math.pi * 2 * deltaTime
	body.yawSpeed = (body.yaw - before) / deltaTime

	-- Si piega con il movimento
	local forward = Vector3.new(-math.sin(body.yaw), 0, -math.cos(body.yaw))
	local acceleration = (body.velocity - body.lastVelocity) / deltaTime
	body.lastVelocity = body.velocity
	local blend = 1 - math.exp(-6 * deltaTime)
	local pitchTarget = math.clamp(-flat:Dot(forward) * 0.012 - acceleration:Dot(forward) * 0.008, -0.35, 0.35)
	local rollTarget = if body.spin > 0 then 0 else math.clamp(-body.yawSpeed * 0.1, -0.3, 0.3)
	body.pitch += (pitchTarget - body.pitch) * blend
	body.roll += (rollTarget - body.roll) * blend
	body.listen += (body.listenTarget - body.listen) * (1 - math.exp(-4 * deltaTime))

	local lunge, knockPitch = knockOffset(now - body.knockAt)
	lunge += body.listen * 0.6
	local bob = math.sin(now * 1.7) * 0.28 + math.sin(now * 0.63 + 1) * 0.14
	local sway = math.sin(now * 1.1) * 0.05 + body.listen * 0.18

	if math.abs(body.scale - body.shownScale) > 0.004 then
		body.shownScale = body.scale
		pcall(function()
			model:ScaleTo(math.max(body.scale, 0.05))
		end)
	end

	model:PivotTo(CFrame.new(body.position + forward * lunge + Vector3.new(0, bob, 0))
		* CFrame.Angles(0, body.yaw, 0)
		* CFrame.Angles(body.pitch - knockPitch, 0, body.roll + sway))
end

-- Aspetta, ma resta fermo finché il crocifisso lo tiene
local function waitActive(seconds)
	local deadline = os.clock() + seconds
	while not state.finished and not state.caught do
		if state.paused then
			deadline += RunService.Heartbeat:Wait()
		elseif os.clock() >= deadline then
			return true
		else
			RunService.Heartbeat:Wait()
		end
	end
	return false
end

-- Ci va e aspetta di esserci arrivato davvero, fermo. È un fantasma: i mobili non lo fermano
local function moveTo(point, lookAt)
	body.goal = point
	body.lookAt = lookAt
	local deadline = os.clock() + (point - body.position).Magnitude / CONFIG.Speed + 5
	while not state.finished and not state.caught and model and model.Parent do
		RunService.Heartbeat:Wait()
		if state.paused then
			deadline = math.max(deadline, os.clock() + 5)
		elseif ((point - body.position).Magnitude < 0.3 and body.velocity.Magnitude < 1) or os.clock() > deadline then
			return true
		end
	end
	return false
end

---====== I COLPI ======---
--[[ Un solo punto d'impatto riusato per tutti i colpi: una Part con il suono, l'emitter della
     polvere e una luce che si accende per un attimo, spostata davanti all'armadio di turno. ]]

local knockPoint, knockDust, knockLight = nil, nil, nil

local function dustAt(position, amount)
	if not knockPoint then
		knockPoint = newPart("KnockPoint", Vector3.new(1, 1, 1), CFrame.new(position), 1)
		knockDust = Instance.new("ParticleEmitter")
		knockDust.Texture = "rbxassetid://" .. CONFIG.Textures.Dust
		knockDust.Color = ColorSequence.new(Color3.fromRGB(150, 146, 140))
		knockDust.LightEmission = 0
		knockDust.LightInfluence = 1
		knockDust.Lifetime = NumberRange.new(0.8, 1.6)
		knockDust.Speed = NumberRange.new(2, 6)
		knockDust.SpreadAngle = Vector2.new(70, 70)
		knockDust.Acceleration = Vector3.new(0, -6, 0)
		knockDust.Drag = 1.5
		knockDust.Size = sequence({ { 0, 0.8 }, { 1, 2 } })
		knockDust.Transparency = sequence({ { 0, 0.5 }, { 1, 1 } })
		knockDust.RotSpeed = NumberRange.new(-60, 60)
		knockDust.Rate = 0
		knockDust.Parent = knockPoint
		knockLight = Instance.new("PointLight")
		knockLight.Color = COLD
		knockLight.Brightness = 0
		knockLight.Range = 10
		knockLight.Shadows = false
		knockLight.Parent = knockPoint
	end
	knockPoint.CFrame = CFrame.new(position)
	knockDust:Emit(amount)
end

local function knockAt(position, loud)
	dustAt(position, if loud then 14 else 8)
	knockLight.Brightness = if loud then 2.5 else 1.5
	tween(knockLight, 0.35, { Brightness = 0 })
	playSound(CONFIG.Sounds.Knock, if loud then 3 else 1.6, 0.8 + math.random() * 0.25, knockPoint)
end

local function inspect(spot, geometry)
	local contact = Vector3.new(spot.front.X, geometry.floorY + 4, spot.front.Z)
	local stand = contact + spot.out * CONFIG.StandOff
	stand = Vector3.new(stand.X, geometry.floorY + CONFIG.HoverHeight, stand.Z)

	-- Ci va guardando dove va; arrivato, si gira verso l'anta
	if not moveTo(stand) then return false end
	body.lookAt = contact
	if not waitActive(0.35) then return false end

	for _ = 1, CONFIG.KnockCount do
		if not waitActive(0) then return false end

		-- Si carica, e il colpo arriva a KNOCK_HIT
		body.knockAt = os.clock()
		if not waitActive(KNOCK_HIT) then return false end

		local inside = hiddenIn(spot)
		knockAt(contact, inside)
		if inside then
			-- Sei lì dentro: lo senti addosso
			shake(3.5, 12, 0, 0.5)
		elseif LocalPlayer.Character and (LocalPlayer.Character:GetPivot().Position - contact).Magnitude < 35 then
			shake(1, 8, 0, 0.3)
		end

		if not waitActive(CONFIG.KnockInterval) then return false end
	end

	-- Si sporge verso l'anta e ascolta
	body.listenTarget = 1
	local listened = waitActive(CONFIG.ListenTime)
	body.listenTarget = 0
	body.lookAt = nil
	return listened
end

-- Una stanza senza armadi: la attraversa in tre punti lungo il lato lungo, e ascolta
local function searchPoints(geometry)
	local points = {}
	for _, fraction in ipairs({ -0.3, 0.3, 0 }) do
		local point = geometry.center + geometry.axis * geometry.length * fraction
		table.insert(points, Vector3.new(point.X, geometry.floorY + CONFIG.HoverHeight, point.Z))
	end
	return points
end

