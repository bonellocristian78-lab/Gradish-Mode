--[[ Un solo punto d'impatto riusato per tutti i colpi: una Part con il suono e l'emitter della
     polvere, spostata davanti all'armadio di turno. ]]

local knockPoint, knockDust = nil, nil

local function dustAt(position, amount)
	if not knockPoint then
		knockPoint = newPart("KnockPoint", Vector3.new(1, 1, 1), CFrame.new(position), 1)
		knockDust = Instance.new("ParticleEmitter")
		knockDust.Texture = "rbxassetid://" .. CONFIG.Textures.Dust
		knockDust.Color = ColorSequence.new(Color3.fromRGB(150, 146, 140))
		knockDust.LightEmission = 0
		knockDust.LightInfluence = 1
		knockDust.Lifetime = NumberRange.new(0.8, 1.6)
		knockDust.Speed = NumberRange.new(2, 6)
		knockDust.SpreadAngle = Vector2.new(70, 70)
		knockDust.Acceleration = Vector3.new(0, -6, 0)
		knockDust.Size = sequence({ { 0, 0.8 }, { 1, 2 } })
		knockDust.Transparency = sequence({ { 0, 0.5 }, { 1, 1 } })
		knockDust.RotSpeed = NumberRange.new(-60, 60)
		knockDust.Rate = 0
		knockDust.Parent = knockPoint
	end
	knockPoint.CFrame = CFrame.new(position)
	knockDust:Emit(amount)
end

local function knockAt(position, loud)
	dustAt(position, if loud then 14 else 8)
	playSound(CONFIG.Sounds.Knock, if loud then 3 else 1.6, 0.8 + math.random() * 0.25, knockPoint)
end

local function inspect(spot, geometry)
	local contact = Vector3.new(spot.front.X, geometry.floorY + 4, spot.front.Z)
	local stand = contact + spot.out * CONFIG.StandOff
	stand = Vector3.new(stand.X, geometry.floorY + CONFIG.HoverHeight, stand.Z)

	if not moveTo(stand, contact) then return false end
	faceTowards(contact)

	for _ = 1, CONFIG.KnockCount do
		if not waitActive(0) then return false end

		-- Si butta in avanti contro l'anta e torna indietro
		local from = state.position
		local lunge = from:Lerp(Vector3.new(contact.X, from.Y, contact.Z), 0.35)
		local startedAt = os.clock()
		while os.clock() - startedAt < 0.09 and not state.paused do
			state.position = from:Lerp(lunge, (os.clock() - startedAt) / 0.09)
			render()
			RunService.Heartbeat:Wait()
		end

		local inside = hiddenIn(spot)
		knockAt(contact, inside)
		if inside then
			-- Sei lì dentro: lo senti addosso
			shake(3.5, 12, 0, 0.5)
		elseif LocalPlayer.Character and (LocalPlayer.Character:GetPivot().Position - contact).Magnitude < 35 then
			shake(1, 8, 0, 0.3)
		end

		startedAt = os.clock()
		while os.clock() - startedAt < 0.2 and not state.paused do
			state.position = lunge:Lerp(from, (os.clock() - startedAt) / 0.2)
			render()
			RunService.Heartbeat:Wait()
		end
		state.position = from
		if not state.paused then
			render()
		end

		if not waitActive(CONFIG.KnockInterval) then return false end
	end

	-- Ascolta
	return waitActive(CONFIG.ListenTime)
end

-- Una stanza senza armadi: la attraversa in tre punti lungo il lato lungo, e ascolta
local function searchPoints(geometry)
	local points = {}
	for _, fraction in ipairs({ -0.3, 0.3, 0 }) do
		local point = geometry.center + geometry.axis * geometry.length * fraction
		table.insert(points, Vector3.new(point.X, geometry.floorY + CONFIG.HoverHeight, point.Z))
	end
	return points
end

---====== LA CACCIA ======---

local sightParams = RaycastParams.new()
sightParams.FilterType = Enum.RaycastFilterType.Exclude
sightParams.RespectCanCollide = true

local function canSee(target, character)
	-- Come nello spawner di Vynixu: armadi e letti non bloccano la vista, devi esserci dentro
	local ignore = CollectionService:GetTagged("HidingSpot")
	table.insert(ignore, character)
	table.insert(ignore, folder)
	sightParams.FilterDescendantsInstances = ignore
	return workspace:Raycast(state.position, target - state.position, sightParams) == nil
end

local function jumpscare(humanoid)
	state.caught = true
	state.hunting = false
	log("ti ha visto")

	if not CONFIG.Jumpscare then
		kill(humanoid)
		finish("preso")
		return
	end

	pcall(function()
		sounds["Close Scream"].Volume = 3
		sounds["Close Scream"].PlaybackSpeed = 0.9
		sounds["Close Scream"]:Play()
		sounds["Far Static"].Volume = 2
	end)
	shake(12, 18, 0, 1.4)

	-- Ti arriva in faccia e resta lì, ovunque guardi; lo schermo lampeggia bianco e nero
	local startedAt = os.clock()
	local stepName = "J518Jumpscare" .. tostring(startedAt)
	RunService:BindToRenderStep(stepName, Enum.RenderPriority.Camera.Value + 1, function()
		if not (model and model.Parent) then return end
		local view = workspace.CurrentCamera.CFrame
		local progress = math.clamp((os.clock() - startedAt) / 0.18, 0, 1)
		local gap = 10 - 7 * (1 - (1 - progress) ^ 3)
		-- Il volto (l'attachment Main) sta 0.84 stud sotto il centro della parte
		model:PivotTo(CFrame.new(view.Position + view.LookVector * gap + view.UpVector * 0.84) * view.Rotation)
	end)
	track(function()
		RunService:UnbindFromRenderStep(stepName)
	end)

	for index = 1, 6 do
		flash(if index % 2 == 0 then WHITE else Color3.new(0, 0, 0), 0.15, 0.12)
		task.wait(0.1)
	end

	task.wait(0.5)
	if humanoid.Parent and humanoid.Health > 0 then
		kill(humanoid)
	end
	task.wait(0.8)
	finish("jumpscare")
end

local closePortal -- più giù, con l'entrata e l'uscita

local function banish(tool)
	state.paused = true
	state.banishing = true
	state.hunting = false
	log("crocifisso")

	local result = Ritual.Run({
		Model   = model,
		Tool    = tool,
		Resist  = CONFIG.Resist,
		-- RushNew è una parte invisibile di 15 per 17 stud: il volto è grande 6
		BoxSize = Vector3.new(6, 7, 6),
		Alive   = function()
			return not state.finished
		end,
	})

	if result == "Banished" then
		-- Lui è finito nel buco; il portale da cui era venuto si richiude da solo
		if state.portal and not state.finished then
			closePortal(state.portal)
		end
		finish("esorcizzato")
	elseif result == "Failed" then
		-- Si è liberato: riprende il giro, e tra un attimo ti vede di nuovo
		log("il crocifisso si è spezzato")
		state.position = model:GetPivot().Position
		state.banishing = false
		state.paused = false
		task.delay(1.5, function()
			if not state.finished and not state.caught then
				state.hunting = true
			end
		end)
	end
end

local function watch()
	if not state.hunting or state.paused or state.caught then return end

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then return end

	local head = character:FindFirstChild("Head")
	local target = (head or root).Position
	local distance = (target - state.position).Magnitude

	-- Il crocifisso conta prima: se lo hai in mano e ti vede, lo ferma
	local tool = Ritual and Ritual.Held()
	if tool and distance <= CONFIG.CrucifixRange and canSee(target, character) then
		spawnSafe("rituale", banish, tool)
		return
	end

	if distance <= CONFIG.KillRange and not character:GetAttribute("Hiding") and canSee(target, character) then
		spawnSafe("jumpscare", jumpscare, humanoid)
	end
end

