local function taggedIn(room, tag)
	local list = {}
	for _, instance in ipairs(CollectionService:GetTagged(tag)) do
		if instance:IsDescendantOf(room) then
			table.insert(list, instance)
		end
	end
	return list
end

--[[ Il centro e le altezze della stanza.

     Il pavimento è la Part più grande con il tag PartFloor: in DOORS è il pavimento vero della
     stanza, centrato. Il soffitto invece non si trova con un raycast, perché DOORS gli spegne
     CanQuery (tag CanQueryFalse): si prende la Part con il tag PartCeiling più vicina al centro. ]]
local function measureRoom(room)
	local boxCFrame, boxSize = room:GetBoundingBox()
	local center = boxCFrame.Position
	local floorY = nil

	local floorPart, floorArea = nil, 0
	for _, floor in ipairs(taggedIn(room, "PartFloor")) do
		if floor:IsA("BasePart") and floor.Size.X * floor.Size.Z > floorArea then
			floorPart, floorArea = floor, floor.Size.X * floor.Size.Z
		end
	end

	if floorPart then
		center = floorPart.Position
		floorY = floorPart.Position.Y + floorPart.Size.Y / 2
	else
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.RespectCanCollide = true
		params.FilterDescendantsInstances = characters()
		local hit = workspace:Raycast(boxCFrame.Position, Vector3.new(0, -60, 0), params)
		floorY = if hit then hit.Position.Y else boxCFrame.Position.Y - boxSize.Y / 2
	end

	local ceilingY, nearest = nil, math.huge
	for _, ceiling in ipairs(taggedIn(room, "PartCeiling")) do
		if ceiling:IsA("BasePart") then
			local bottom = ceiling.Position.Y - ceiling.Size.Y / 2
			local distance = (Vector3.new(ceiling.Position.X, 0, ceiling.Position.Z) - Vector3.new(center.X, 0, center.Z)).Magnitude
			if bottom > floorY + 6 and distance < nearest then
				ceilingY, nearest = bottom, distance
			end
		end
	end
	ceilingY = math.clamp(ceilingY or floorY + 14, floorY + 8, floorY + 40)

	-- L'asse lungo della stanza, per perlustrarla quando non ha armadi
	local axis, length = Vector3.xAxis, boxSize.X
	if floorPart then
		local size = floorPart.Size
		if size.Z > size.X then
			axis, length = floorPart.CFrame.LookVector, size.Z
		else
			axis, length = floorPart.CFrame.RightVector, size.X
		end
	elseif boxSize.Z > boxSize.X then
		axis, length = Vector3.zAxis, boxSize.Z
	end

	return {
		center   = Vector3.new(center.X, floorY, center.Z),
		floorY   = floorY,
		ceilingY = ceilingY,
		axis     = flatUnit(axis) or Vector3.xAxis,
		length   = length,
	}
end

--[[ Gli armadi della stanza. Davanti a sé ognuno ha l'ExitAttachment, dove esci quando smetti di
     nasconderti: è il lato dell'anta. Se non c'è, il davanti è il lato verso il centro. ]]
local function spotsIn(room, geometry)
	local spots = {}
	for _, spot in ipairs(taggedIn(room, "HidingSpot")) do
		if spot:IsA("Model") or spot:IsA("BasePart") then
			local pivot = spot:GetPivot().Position
			local exit = spot:FindFirstChild("ExitAttachment", true)
			local front = if exit and exit:IsA("Attachment") then exit.WorldPosition else pivot
			local out = flatUnit(front - pivot) or flatUnit(geometry.center - pivot) or Vector3.xAxis
			table.insert(spots, { model = spot, pivot = pivot, front = front, out = out })
		end
	end
	return spots
end

-- Il giro: sempre l'armadio più vicino a dove si trova, fino a MaxSpots
local function planRoute(spots, from)
	local route, left = {}, table.clone(spots)
	local here = from
	while #left > 0 and #route < CONFIG.MaxSpots do
		local bestIndex, bestDistance = 1, math.huge
		for index, spot in ipairs(left) do
			local distance = (spot.front - here).Magnitude
			if distance < bestDistance then
				bestIndex, bestDistance = index, distance
			end
		end
		local spot = table.remove(left, bestIndex)
		table.insert(route, spot)
		here = spot.front
	end
	return route
end

-- Sei nascosto proprio in quell'armadio?
local function hiddenIn(spot)
	local character = LocalPlayer.Character
	if not character or not character:GetAttribute("Hiding") then return false end

	local hidden = spot.model:FindFirstChild("HiddenPlayer")
	if hidden and hidden:IsA("ObjectValue") and hidden.Value then
		return hidden.Value == LocalPlayer or hidden.Value == character
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	return root ~= nil and (root.Position - spot.pivot).Magnitude < 5
end

---====== IL MODELLO ======---

local function loadModel()
	local model = nil

	if type(LoadCustomInstance) == "function" then
		local ok, result = pcall(LoadCustomInstance, CONFIG.ModelUrl)
		if ok and typeof(result) == "Instance" then
			model = result
		end
	end

	if not model then
		if not (getcustomasset and writefile) then
			problem("il tuo executor non ha getcustomasset: non posso caricare il modello")
			return nil
		end
		local file = "gradish_j518.txt"
		local ok, result = pcall(function()
			writefile(file, game:HttpGet(CONFIG.ModelUrl))
			return game:GetObjects(getcustomasset(file, true))[1]
		end)
		pcall(function()
			if isfile and delfile and isfile(file) then delfile(file) end
		end)
		if not ok or typeof(result) ~= "Instance" then
			problem("il modello non si è caricato: %s", tostring(result))
			return nil
		end
		model = result
	end

	if not model:IsA("Model") then
		local wrapper = Instance.new("Model")
		model.Parent = wrapper
		model = wrapper
	end
	model.Name = CONFIG.ModelName

	local root = model:FindFirstChild("RushNew", true) or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if not (root and root:IsA("BasePart")) then
		problem("il modello non ha nessuna parte")
		return nil
	end
	model.PrimaryPart = root

	local sounds = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			-- Un fantasma: non tocca, non blocca, non fa ombra
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.CastShadow = false
		elseif descendant:IsA("JointInstance") and (descendant.Part0 == nil or descendant.Part1 == nil) then
			-- Nel modello c'è una Weld con una parte sola: non tiene niente
			descendant:Destroy()
		elseif descendant:IsA("ParticleEmitter") and CONFIG.MaxLiveParticles then
			local life = descendant.Lifetime.Max
			if life > 0 and descendant.Rate * life > CONFIG.MaxLiveParticles then
				log("%s: %d particelle/s portate a %d", descendant.Name, descendant.Rate, CONFIG.MaxLiveParticles / life)
				descendant.Rate = CONFIG.MaxLiveParticles / life
			end
		elseif descendant:IsA("Sound") then
			descendant.Playing = false
			sounds[descendant.Name] = descendant
		end
	end

	return model, sounds
end

