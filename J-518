-- Il portale si chiude del tutto: gira forte, si stringe, un lampo e un ultimo sbuffo di fumo
closePortal = function(portal)
	portal.spin = 9
	pcall(function()
		local farewell = sounds["Leave Scream Far"]:Clone()
		farewell.Parent = portal.disc
		farewell:Play()
	end)
	sizePortal(portal, 0, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	portal.smoke:Emit(25)
	task.wait(0.45)
	flash(WHITE, 0.35, 0.6)
	shake(2.5, 10, 0, 0.6)
	portal.glow = 0
	portal.smoke.Rate = 0
	portal.sparks.Rate = 0
	portal.streaks.Rate = 0
	task.wait(1.6)
end

local function descend(portal, geometry)
	local from = portal.disc.Position + Vector3.new(0, 1.5, 0)
	local to = Vector3.new(geometry.center.X, geometry.floorY + CONFIG.HoverHeight, geometry.center.Z)

	state.position = from
	local character = LocalPlayer.Character
	if character then faceTowards(character:GetPivot().Position) end
	render()
	model.Parent = folder

	for _, name in ipairs({ "Far Scream", "Far Static", "Close Scream" }) do
		if sounds[name] then sounds[name]:Play() end
	end

	portal.spin = 4
	portal.glow = 6
	portal.streaks.Rate = 80
	flash(WHITE, 0.55, 0.4)

	local startedAt = os.clock()
	while not state.finished do
		local progress = math.clamp((os.clock() - startedAt) / CONFIG.DescendTime, 0, 1)
		-- Scende di colpo e frena all'ultimo
		local eased = 1 - (1 - progress) ^ 4
		state.position = from:Lerp(to, eased)
		render()
		if progress >= 1 then break end
		RunService.Heartbeat:Wait()
	end

	-- L'arrivo: discreto, ma lo senti nei piedi
	playSound(CONFIG.Sounds.Impact, 1.2, 0.8)
	shake(3, 8, 0, 0.7)
	dustAt(Vector3.new(to.X, geometry.floorY + 0.5, to.Z), 20)
	portal.spin = 1.5
	portal.glow = 2
	portal.streaks.Rate = 0
	portal.sparks.Rate = 8
	portal.smoke.Rate = 6
	sizePortal(portal, CONFIG.PortalSize * 0.6, 0.8)
end

local function ascend(portal, geometry)
	local below = Vector3.new(geometry.center.X, geometry.floorY + CONFIG.HoverHeight, geometry.center.Z)
	if not moveTo(below) then return end

	-- Il portale si riapre
	sizePortal(portal, CONFIG.PortalSize, 0.6)
	portal.spin = 3
	portal.glow = 5
	portal.streaks.Rate = 60
	pcall(function() sounds["Leave Scream"]:Play() end)

	local from = state.position
	local to = portal.disc.Position + Vector3.new(0, 2, 0)
	local startedAt = os.clock()
	while not state.finished do
		local progress = math.clamp((os.clock() - startedAt) / CONFIG.ReturnTime, 0, 1)
		-- Parte piano e viene risucchiato
		state.position = from:Lerp(to, progress ^ 3)
		render()
		if progress >= 1 then break end
		RunService.Heartbeat:Wait()
	end

	state.hunting = false
	for _, sound in pairs(sounds) do
		pcall(function() sound:Stop() end)
	end
	if model then model.Parent = nil end

	closePortal(portal)
end

---====== AVVIO ======---

local function main()
	local room = currentRoom()
	if not room then
		problem("non trovo la stanza in cui sei")
		finish("nessuna stanza")
		return
	end

	-- Se DOORS scarica la stanza mentre è qui, se ne va anche lui
	track(room.AncestryChanged:Connect(function()
		if not room:IsDescendantOf(workspace) then
			finish("la stanza è stata tolta")
		end
	end))

	local geometry = measureRoom(room)
	log("stanza %s: pavimento %.1f, soffitto %.1f", room.Name, geometry.floorY, geometry.ceilingY)

	-- Il modello prima del portale, così scende in orario
	local loadedSounds
	model, loadedSounds = loadModel()
	if not model then
		finish("niente modello")
		return
	end
	sounds = loadedSounds
	track(model)

	---- 1. IL PORTALE e dieci secondi di avviso ----
	local portal = buildPortal(Vector3.new(geometry.center.X, geometry.ceilingY - 0.1, geometry.center.Z))
	state.portal = portal
	startAtmosphere(room, portal)
	sizePortal(portal, CONFIG.PortalSize, CONFIG.PortalOpen, Enum.EasingStyle.Quart)

	local heart = playSound(CONFIG.Sounds.Heart, 0, 0.7, nil, true)
	local rumble = playSound(CONFIG.Sounds.Rumble, 0, 0.35, nil, true)
	track(heart)
	track(rumble)
	tween(heart, CONFIG.Countdown * 0.8, { Volume = 1.2, PlaybackSpeed = 1.3 }, Enum.EasingStyle.Linear)
	local rumbleRise = tween(rumble, CONFIG.Countdown - 0.8, { Volume = 1 }, Enum.EasingStyle.Linear)
	mood.flicker = os.clock() + 1.2

	local startedAt = os.clock()
	local nextBeat = startedAt + 1
	while not state.finished do
		local elapsed = os.clock() - startedAt
		if elapsed >= CONFIG.Countdown then break end
		local progress = elapsed / CONFIG.Countdown

		mood.dim = progress
		mood.gray = math.min(progress * 1.25, 1)
		portal.glow = 1 + 3 * progress
		portal.spin = 1 + 1.5 * progress
		portal.smoke.Rate = 4 + 18 * progress
		portal.sparks.Rate = 2 + 20 * progress

		-- I battiti, sempre più fitti. L'ultimo secondo è silenzio
		if elapsed < CONFIG.Countdown - 0.8 and os.clock() >= nextBeat then
			playSound(CONFIG.Sounds.Beat, 0.6 + 0.8 * progress, 0.45 + 0.15 * progress)
			mood.pulse = 1
			shake(0.6 + 1.5 * progress, 6, 0, 0.35)
			if math.random() < 0.35 + 0.5 * progress then
				mood.flicker = os.clock() + 0.25 + 0.4 * math.random()
			end
			nextBeat = os.clock() + 1.15 - 0.8 * progress
		end

		if elapsed >= CONFIG.Countdown - 0.8 and heart.Volume > 0 then
			heart.Volume = 0
			rumbleRise:Cancel()
			rumble.Volume = 0.2
			-- Il portale trattiene il fiato
			sizePortal(portal, CONFIG.PortalSize * 0.85, 0.6, Enum.EasingStyle.Sine)
		end

		task.wait(0.03)
	end
	if state.finished then return end
	heart:Stop()

	---- 2. LA DISCESA ----
	mood.dim = 1
	mood.gray = 1
	descend(portal, geometry)
	if state.finished then return end
	rumble.Volume = 0.35

	---- 3. LA CACCIA: gli armadi, uno per uno ----
	state.hunting = true
	local lastWatch = 0
	track(RunService.Heartbeat:Connect(function()
		if os.clock() - lastWatch < 0.05 then return end
		lastWatch = os.clock()
		local ok, err = pcall(watch)
		if not ok then
			problem("controllo del giocatore: %s", tostring(err))
		end
	end))

	local route = planRoute(spotsIn(room, geometry), state.position)
	log("%d armadi da controllare", #route)

	if #route > 0 then
		for _, spot in ipairs(route) do
			if state.finished or state.caught or state.banishing then return end
			if spot.model.Parent then
				inspect(spot, geometry)
			end
		end
	else
		for _, point in ipairs(searchPoints(geometry)) do
			if state.finished or state.caught or state.banishing then return end
			moveTo(point)
			waitActive(CONFIG.ListenTime * 1.5)
		end
	end
	if state.finished or state.caught or state.banishing then return end

	---- 4. IL RITORNO ----
	ascend(portal, geometry)
	finish("tornato nel portale")
end

task.delay(CONFIG.Failsafe, function()
	finish("failsafe")
end)

spawnSafe("J-518", main)
