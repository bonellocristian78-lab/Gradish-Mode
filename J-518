local model, sounds = nil, {}

local function render(offset)
	if not (model and model.Parent) then return end
	local cframe = CFrame.new(state.position) * state.facing
	if offset then cframe *= offset end
	model:PivotTo(cframe)
end

local function faceTowards(point, deltaTime)
	local direction = flatUnit(point - state.position)
	if not direction then return end
	local target = CFrame.lookAt(Vector3.zero, direction)
	state.facing = if deltaTime then state.facing:Lerp(target, 1 - math.exp(-8 * deltaTime)) else target
end

-- Aspetta, ma resta fermo finché il crocifisso lo tiene
local function waitActive(seconds)
	local deadline = os.clock() + seconds
	while not state.finished and not state.caught do
		if state.paused then
			deadline += RunService.Heartbeat:Wait()
		elseif os.clock() >= deadline then
			return true
		else
			RunService.Heartbeat:Wait()
		end
	end
	return false
end

-- In linea retta, con un leggero ondeggiare: è un fantasma, i mobili non lo fermano
local function moveTo(point, lookAt)
	while not state.finished and not state.caught and model and model.Parent do
		local deltaTime = RunService.Heartbeat:Wait()
		if not state.paused then
			local offset = point - state.position
			local distance = offset.Magnitude
			if distance < 0.1 then return true end
			state.position += offset.Unit * math.min(CONFIG.Speed * deltaTime, distance)
			faceTowards(lookAt or point, deltaTime)
			render(CFrame.new(0, math.sin(os.clock() * 2.2) * 0.3, 0))
		end
	end
	return false
end

