-- Il portale si chiude del tutto: gira forte, si stringe con la molla, un lampo, un ultimo sbuffo
closePortal = function(portal)
	portal.spin = 9
	pcall(function()
		local farewell = sounds["Leave Scream Far"]:Clone()
		farewell.Parent = portal.mouth
		farewell:Play()
	end)
	portal.omega, portal.damping = 7, 0.8
	portal.target = 0
	portal.smoke:Emit(25)
	task.wait(0.45)
	flash(WHITE, 0.35, 0.6)
	shake(2.5, 10, 0, 0.6)
	portal.glow = 0
	portal.smoke.Rate = 0
	portal.sparks.Rate = 0
	portal.streaks.Rate = 0
	task.wait(1.6)
end

-- L'arrivo: discreto, ma lo senti nei piedi
local function land(portal, geometry, point)
	playSound(CONFIG.Sounds.Impact, 1.2, 0.8)
	shake(3, 8, 0, 0.7)
	local floor = Vector3.new(point.X, geometry.floorY + 0.05, point.Z)
	dustAt(floor + Vector3.new(0, 0.45, 0), 20)
	floorRing(floor)
	portal.spin = 1.5
	portal.glow = 2.5
	portal.streaks.Rate = 0
	portal.sparks.Rate = 8
	portal.smoke.Rate = 6
	portal.omega, portal.damping = 5, 0.7
	portal.target = 0.6
end

local function descend(portal, geometry)
	local start = portal.position - Vector3.new(0, 1.2, 0)
	local hover = Vector3.new(geometry.center.X, geometry.floorY + CONFIG.HoverHeight, geometry.center.Z)

	local character = LocalPlayer.Character
	local toPlayer = character and flatUnit(character:GetPivot().Position - start)
	if toPlayer then body.yaw = yawOf(toPlayer) end
	body.driven = true
	body.goal = nil
	body.lookAt = nil
	body.position = start
	body.lastPosition = start
	body.velocity = Vector3.zero
	body.lastVelocity = Vector3.zero
	body.scale = 0.05
	body.shownScale = 0.05
	pcall(function() model:ScaleTo(0.05) end)
	model:PivotTo(CFrame.new(start) * CFrame.Angles(0, body.yaw, 0))
	model.Parent = folder

	for _, name in ipairs({ "Far Scream", "Far Static", "Close Scream" }) do
		if sounds[name] then sounds[name]:Play() end
	end

	portal.omega, portal.damping = 6, 0.45
	portal.target = 1.15
	portal.spin = 4
	portal.glow = 7
	portal.streaks.Rate = 80
	flash(WHITE, 0.6, 0.5)

	-- Esce: si gonfia dalla bocca del portale e resta appeso un attimo
	local startedAt = os.clock()
	while not state.finished do
		local t = (os.clock() - startedAt) / CONFIG.EmergeTime
		if t >= 1 then break end
		body.scale = 0.05 + 0.65 * (1 - (1 - t) ^ 3)
		body.position = start - Vector3.new(0, 1.3 * smooth(t), 0)
		RunService.Heartbeat:Wait()
	end
	if state.finished then return end

	-- Cade sempre più veloce, sbatte appena sotto l'altezza a cui gira e rimbalza fino a fermarsi
	local from = body.position
	local impactAt = 0.55
	local landed = false
	startedAt = os.clock()
	while not state.finished do
		local u = math.clamp((os.clock() - startedAt) / CONFIG.DescendTime, 0, 1)
		body.scale = 0.7 + 0.3 * smooth(u / 0.4)
		local y
		if u < impactAt then
			y = from.Y + (hover.Y - 0.9 - from.Y) * (u / impactAt) ^ 2
		else
			if not landed then
				landed = true
				land(portal, geometry, hover)
			end
			local v = (u - impactAt) / (1 - impactAt)
			y = hover.Y - 0.9 * math.exp(-5 * v) * math.cos(9 * v)
		end
		local across = from:Lerp(hover, smooth(u / impactAt))
		body.position = Vector3.new(across.X, y, across.Z)
		if u >= 1 then break end
		RunService.Heartbeat:Wait()
	end

	body.scale = 1
	body.position = hover
	body.velocity = Vector3.zero
	body.driven = false
end

local function ascend(portal, geometry)
	local below = Vector3.new(geometry.center.X, geometry.floorY + CONFIG.HoverHeight, geometry.center.Z)
	if not moveTo(below) then return end

	-- Il portale si riapre e lo chiama
	portal.omega, portal.damping = 5, 0.6
	portal.target = 1
	portal.spin = 3
	portal.glow = 5
	portal.smoke.Rate = 14
	portal.streaks.Rate = 60
	pcall(function() sounds["Leave Scream"]:Play() end)

	-- Si abbassa un attimo, poi viene risucchiato girando su se stesso e rimpicciolendo
	body.driven = true
	body.goal = nil
	local from = body.position
	local to = portal.position - Vector3.new(0, 0.6, 0)
	local startedAt = os.clock()
	while not state.finished do
		local u = math.clamp((os.clock() - startedAt) / CONFIG.ReturnTime, 0, 1)
		local crouch = 0.8 * math.sin(math.pi * math.clamp(u / 0.3, 0, 1))
		local rise = math.clamp((u - 0.2) / 0.8, 0, 1)
		body.position = from:Lerp(to, rise ^ 3) - Vector3.new(0, crouch, 0)
		body.spin = 2.5 * rise * rise
		body.scale = 1 - 0.95 * math.clamp((rise - 0.55) / 0.45, 0, 1) ^ 2
		portal.spin = 3 + 6 * rise
		if u >= 1 then break end
		RunService.Heartbeat:Wait()
	end

	state.hunting = false
	for _, sound in pairs(sounds) do
		pcall(function() sound:Stop() end)
	end
	if model then model.Parent = nil end

	closePortal(portal)
end

