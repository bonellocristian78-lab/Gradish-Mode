local function taggedIn(room, tag)
	local list = {}
	for _, instance in ipairs(CollectionService:GetTagged(tag)) do
		if instance:IsDescendantOf(room) then
			table.insert(list, instance)
		end
	end
	return list
end

--[[ Il centro e le altezze della stanza.

     Il pavimento è la Part più grande con il tag PartFloor: in DOORS è il pavimento vero della
     stanza, centrato. Il soffitto invece non si trova con un raycast, perché DOORS gli spegne
     CanQuery (tag CanQueryFalse): si prende la Part con il tag PartCeiling più vicina al centro. ]]
local function measureRoom(room)
	local boxCFrame, boxSize = room:GetBoundingBox()
	local center = boxCFrame.Position
	local floorY = nil

	local floorPart, floorArea = nil, 0
	for _, floor in ipairs(taggedIn(room, "PartFloor")) do
		if floor:IsA("BasePart") and floor.Size.X * floor.Size.Z > floorArea then
			floorPart, floorArea = floor, floor.Size.X * floor.Size.Z
		end
	end

	if floorPart then
		center = floorPart.Position
		floorY = floorPart.Position.Y + floorPart.Size.Y / 2
	else
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.RespectCanCollide = true
		params.FilterDescendantsInstances = characters()
		local hit = workspace:Raycast(boxCFrame.Position, Vector3.new(0, -60, 0), params)
		floorY = if hit then hit.Position.Y else boxCFrame.Position.Y - boxSize.Y / 2
	end

	local ceilingY, nearest = nil, math.huge
	for _, ceiling in ipairs(taggedIn(room, "PartCeiling")) do
		if ceiling:IsA("BasePart") then
			local bottom = ceiling.Position.Y - ceiling.Size.Y / 2
			local distance = (Vector3.new(ceiling.Position.X, 0, ceiling.Position.Z) - Vector3.new(center.X, 0, center.Z)).Magnitude
			if bottom > floorY + 6 and distance < nearest then
				ceilingY, nearest = bottom, distance
			end
		end
	end
	ceilingY = math.clamp(ceilingY or floorY + 14, floorY + 8, floorY + 40)

	-- L'asse lungo della stanza, per perlustrarla quando non ha armadi
	local axis, length = Vector3.xAxis, boxSize.X
	if floorPart then
		local size = floorPart.Size
		if size.Z > size.X then
			axis, length = floorPart.CFrame.LookVector, size.Z
		else
			axis, length = floorPart.CFrame.RightVector, size.X
		end
	elseif boxSize.Z > boxSize.X then
		axis, length = Vector3.zAxis, boxSize.Z
	end

	return {
		center   = Vector3.new(center.X, floorY, center.Z),
		floorY   = floorY,
		ceilingY = ceilingY,
		axis     = flatUnit(axis) or Vector3.xAxis,
		length   = length,
	}
end

--[[ Gli armadi della stanza. Davanti a sé ognuno ha l'ExitAttachment, dove esci quando smetti di
     nasconderti: è il lato dell'anta. Se non c'è, il davanti è il lato verso il centro. ]]
local function spotsIn(room, geometry)
	local spots = {}
	for _, spot in ipairs(taggedIn(room, "HidingSpot")) do
		if spot:IsA("Model") or spot:IsA("BasePart") then
			local pivot = spot:GetPivot().Position
			local exit = spot:FindFirstChild("ExitAttachment", true)
			local front = if exit and exit:IsA("Attachment") then exit.WorldPosition else pivot
			local out = flatUnit(front - pivot) or flatUnit(geometry.center - pivot) or Vector3.xAxis
			table.insert(spots, { model = spot, pivot = pivot, front = front, out = out })
		end
	end
	return spots
end

-- Il giro: sempre l'armadio più vicino a dove si trova, fino a MaxSpots
local function planRoute(spots, from)
	local route, left = {}, table.clone(spots)
	local here = from
	while #left > 0 and #route < CONFIG.MaxSpots do
		local bestIndex, bestDistance = 1, math.huge
		for index, spot in ipairs(left) do
			local distance = (spot.front - here).Magnitude
			if distance < bestDistance then
				bestIndex, bestDistance = index, distance
			end
		end
		local spot = table.remove(left, bestIndex)
		table.insert(route, spot)
		here = spot.front
	end
	return route
end

-- Sei nascosto proprio in quell'armadio?
local function hiddenIn(spot)
	local character = LocalPlayer.Character
	if not character or not character:GetAttribute("Hiding") then return false end

	local hidden = spot.model:FindFirstChild("HiddenPlayer")
	if hidden and hidden:IsA("ObjectValue") and hidden.Value then
		return hidden.Value == LocalPlayer or hidden.Value == character
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	return root ~= nil and (root.Position - spot.pivot).Magnitude < 5
end

---====== IL MODELLO ======---

local function loadModel()
	local model = nil

	if type(LoadCustomInstance) == "function" then
		local ok, result = pcall(LoadCustomInstance, CONFIG.ModelUrl)
		if ok and typeof(result) == "Instance" then
			model = result
		end
	end

	if not model then
		if not (getcustomasset and writefile) then
			problem("il tuo executor non ha getcustomasset: non posso caricare il modello")
			return nil
		end
		local file = "gradish_j518.txt"
		local ok, result = pcall(function()
			writefile(file, game:HttpGet(CONFIG.ModelUrl))
			return game:GetObjects(getcustomasset(file, true))[1]
		end)
		pcall(function()
			if isfile and delfile and isfile(file) then delfile(file) end
		end)
		if not ok or typeof(result) ~= "Instance" then
			problem("il modello non si è caricato: %s", tostring(result))
			return nil
		end
		model = result
	end

	if not model:IsA("Model") then
		local wrapper = Instance.new("Model")
		model.Parent = wrapper
		model = wrapper
	end
	model.Name = CONFIG.ModelName

	local root = model:FindFirstChild("RushNew", true) or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if not (root and root:IsA("BasePart")) then
		problem("il modello non ha nessuna parte")
		return nil
	end
	model.PrimaryPart = root

	local sounds = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			-- Un fantasma: non tocca, non blocca, non fa ombra
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.CastShadow = false
		elseif descendant:IsA("JointInstance") and (descendant.Part0 == nil or descendant.Part1 == nil) then
			-- Nel modello c'è una Weld con una parte sola: non tiene niente
			descendant:Destroy()
		elseif descendant:IsA("ParticleEmitter") and CONFIG.MaxLiveParticles then
			local life = descendant.Lifetime.Max
			if life > 0 and descendant.Rate * life > CONFIG.MaxLiveParticles then
				log("%s: %d particelle/s portate a %d", descendant.Name, descendant.Rate, CONFIG.MaxLiveParticles / life)
				descendant.Rate = CONFIG.MaxLiveParticles / life
			end
		elseif descendant:IsA("Sound") then
			descendant.Playing = false
			sounds[descendant.Name] = descendant
		end
	end

	return model, sounds
end

---====== IL PORTALE ======---
--[[ Un vortice che pende dal soffitto, non un disco piatto.

     - La bocca: un disco nero appena sotto il soffitto, e una massa nera che si gonfia verso il
       basso a ogni battito.
     - Sotto la bocca cinque anelli del cerchio di DOORS, uno sotto l'altro, sempre più piccoli e
       più trasparenti: un imbuto che scende. Girano in versi opposti e ondeggiano ognuno per
       conto suo, così muovendo la camera si vede la profondità.
     - Sei tentacoli d'ombra che pendono dal bordo e si contorcono.
     - Una colonna di luce fredda fino al pavimento e un faro che illumina la stanza dall'alto.
     - Fumo nero che scende e viene risucchiato su, scintille, strisce.

     Si apre e si chiude con una molla: arriva, supera un poco e si assesta. Luce e rotazione
     inseguono piano i valori che gli si danno, quindi non cambiano mai di colpo. Tutto si
     aggiorna in un solo ciclo per frame, e le tele hanno una misura fissa. ]]

local RING_LAYERS = {
	-- quanto sotto il soffitto, grandezza rispetto alla bocca, colore, trasparenza, giri al secondo
	{ depth = 0.06, scale = 1.00, colour = WHITE,                        transparency = 0.05, speed = 24 },
	{ depth = 0.45, scale = 0.80, colour = Color3.fromRGB(150, 150, 156), transparency = 0.2,  speed = -40 },
	{ depth = 1.00, scale = 0.62, colour = WHITE,                        transparency = 0.35, speed = 62 },
	{ depth = 1.70, scale = 0.46, colour = Color3.fromRGB(110, 110, 118), transparency = 0.5,  speed = -90 },
	{ depth = 2.50, scale = 0.32, colour = WHITE,                        transparency = 0.62, speed = 130 },
}
local TENDRILS = 6

local function ringDisc(name, position, textureId, colour, face)
	local disc = newPart(name, Vector3.new(0.05, 0.02, 0.05), CFrame.new(position), 1)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Bottom
	gui.LightInfluence = 0
	gui.Brightness = 2.5
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(256, 256)
	gui.Parent = disc
	local image = Instance.new("ImageLabel")
	image.BackgroundTransparency = 1
	image.Size = UDim2.fromScale(1, 1)
	image.Image = "rbxassetid://" .. textureId
	image.ImageColor3 = colour
	image.ImageTransparency = 1
	image.Rotation = math.random(0, 359)
	image.Parent = gui
	return disc, image
end

local function buildPortal(position, geometry)
	local size = CONFIG.PortalSize
	local rings = CONFIG.Textures.Rings
	local height = math.max(position.Y - geometry.floorY, 1)

	-- La bocca: un cerchio nero con un bordo sfumato
	local mouth = newPart("PortalMouth", Vector3.new(0.05, 0.02, 0.05), CFrame.new(position), 1)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Bottom
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(256, 256)
	gui.Parent = mouth
	local void = Instance.new("Frame")
	void.AnchorPoint = Vector2.new(0.5, 0.5)
	void.Position = UDim2.fromScale(0.5, 0.5)
	void.Size = UDim2.fromScale(0.78, 0.78)
	void.BackgroundColor3 = BLACK
	void.BorderSizePixel = 0
	void.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = void
	local edge = Instance.new("ImageLabel")
	edge.BackgroundTransparency = 1
	edge.Size = UDim2.fromScale(1, 1)
	edge.Image = "rbxassetid://" .. rings[1]
	edge.ImageColor3 = BLACK
	edge.ZIndex = 2
	edge.Parent = gui

	-- La massa nera che si gonfia sotto la bocca: una sfera schiacciata, con le sue ombre
	local mass = newPart("PortalMass", Vector3.one * 0.05, CFrame.new(position), 0)
	mass.Color = BLACK
	mass.Material = Enum.Material.SmoothPlastic
	local ellipsoid = Instance.new("SpecialMesh")
	ellipsoid.MeshType = Enum.MeshType.Sphere
	ellipsoid.Parent = mass

	-- L'imbuto di anelli
	local layers = {}
	for index, spec in ipairs(RING_LAYERS) do
		local disc, image = ringDisc("PortalRing", position - Vector3.new(0, spec.depth, 0), rings[(index - 1) % #rings + 1], spec.colour)
		table.insert(layers, { part = disc, image = image, spec = spec })
	end

	-- I tentacoli: una Beam dal bordo a un punto che pende, e si contorcono
	local tendrils = {}
	for index = 1, TENDRILS do
		local angle = (index - 1) / TENDRILS * math.pi * 2 + math.random() * 0.4
		local rim = Vector3.new(math.cos(angle), 0, math.sin(angle)) * size * 0.42
		local root = Instance.new("Attachment")
		root.Parent = mouth
		local tip = Instance.new("Attachment")
		tip.Parent = mouth
		local beam = Instance.new("Beam")
		beam.Attachment0 = root
		beam.Attachment1 = tip
		beam.Texture = "rbxassetid://" .. CONFIG.Textures.Smoke
		beam.TextureMode = Enum.TextureMode.Stretch
		beam.TextureSpeed = 0.6
		beam.Color = ColorSequence.new(Color3.fromRGB(0, 0, 0), Color3.fromRGB(24, 24, 28))
		beam.Transparency = sequence({ { 0, 0.05 }, { 0.7, 0.45 }, { 1, 1 } })
