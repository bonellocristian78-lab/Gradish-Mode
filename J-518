--[[ Tutto quello che crea finisce in cleanup: connessioni, istanze e funzioni che rimettono a
     posto. finish() le esegue al contrario, quindi prima si stacca un ciclo e poi si ripristina
     quello che toccava. Una seconda esecuzione toglie la prima. ]]

if _G.J518Cleanup then
	pcall(_G.J518Cleanup)
end

local cleanup = {}
local state = {
	finished = false,
	hunting  = false,  -- può vederti e ucciderti
	paused   = false,  -- fermo per il crocifisso
	banishing = false, -- il rituale è in corso: il giro aspetta
	caught   = false,
	portal   = nil,
}

local function track(item)
	table.insert(cleanup, item)
	return item
end

local dismiss

local function finish(reason)
	if state.finished then return end
	state.finished = true
	state.hunting = false
	log("fine: %s", reason)

	for index = #cleanup, 1, -1 do
		local item = cleanup[index]
		pcall(function()
			if typeof(item) == "RBXScriptConnection" then
				item:Disconnect()
			elseif typeof(item) == "Instance" then
				item:Destroy()
			elseif type(item) == "function" then
				item()
			end
		end)
	end
	table.clear(cleanup)

	if _G.J518Cleanup == dismiss then
		_G.J518Cleanup = nil
	end
end

dismiss = function()
	finish("tolto da una nuova esecuzione")
end
_G.J518Cleanup = dismiss

