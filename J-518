local function stepPortal(portal, deltaTime, now)
	if not portal.mouth.Parent then return end

	local omega, damping = portal.omega, portal.damping
	portal.openSpeed += ((portal.target - portal.open) * omega * omega - portal.openSpeed * 2 * damping * omega) * deltaTime
	portal.open = math.max(portal.open + portal.openSpeed * deltaTime, 0)
	local follow = 1 - math.exp(-4 * deltaTime)
	portal.shownGlow += (portal.glow - portal.shownGlow) * follow
	portal.shownSpin += (portal.spin - portal.shownSpin) * follow
	portal.beat = math.max(portal.beat - deltaTime * 2.5, 0)

	local open = portal.open
	local fade = math.clamp(open * 3, 0, 1)
	local size = math.max(CONFIG.PortalSize * open, 0.05)
	local position = portal.position

	portal.mouth.Size = Vector3.new(size, 0.02, size)
	portal.void.BackgroundTransparency = 1 - fade
	portal.edge.ImageTransparency = 1 - fade

	-- La massa respira, e a ogni battito si gonfia verso il basso
	local breathe = 0.12 + 0.03 * math.sin(now * 1.3) + 0.12 * portal.beat
	portal.mass.Size = Vector3.new(size * 0.55, math.max(size * breathe, 0.05), size * 0.55)
	portal.mass.CFrame = CFrame.new(position)

	for index, layer in ipairs(portal.layers) do
		local spec = layer.spec
		local wobble = Vector3.new(math.noise(now * 0.4, index * 3.1), 0, math.noise(now * 0.4, index * 7.3)) * 0.6 * open
		local diameter = math.max(size * spec.scale, 0.05)
		layer.part.Size = Vector3.new(diameter, 0.02, diameter)
		layer.part.CFrame = CFrame.new(position - Vector3.new(0, spec.depth * math.min(open, 1.2), 0) + wobble)
		layer.image.Rotation = (layer.image.Rotation + spec.speed * portal.shownSpin * deltaTime) % 360
		layer.image.ImageTransparency = spec.transparency + (1 - spec.transparency) * (1 - fade)
	end

	for _, tendril in ipairs(portal.tendrils) do
		local t = now * 0.7 + tendril.seed
		tendril.root.Position = tendril.rim * open
		tendril.tip.Position = tendril.hang * open + Vector3.new(
			math.noise(t, 1.3) * 1.6,
			-tendril.length * open * (1 + 0.25 * portal.beat) + math.noise(t, 4.2),
			math.noise(t, 8.8) * 1.6
		)
		tendril.beam.CurveSize0 = math.noise(t * 1.3, 2.2) * 4 * open
		tendril.beam.CurveSize1 = math.noise(t * 1.3, 6.6) * 3 * open
		tendril.beam.Width0 = 0.9 * fade
		tendril.beam.Width1 = 0.15 * fade
	end

	-- La luce trema piano, non a scatti
	local glow = portal.shownGlow * (1 - 0.25 * math.max(math.noise(now * 6, 0.5), 0) * 2)
	portal.spot.Brightness = glow * 0.9
	portal.light.Brightness = glow * 0.5
	local shaft = math.clamp(portal.shownGlow / 6, 0, 1) * math.min(open, 1)
	for _, entry in ipairs(portal.shafts) do
		local width = math.max(size * entry.width, 0.05)
		entry.part.Size = Vector3.new(portal.height, width, width)
		entry.part.Transparency = 1 - (entry.strength + entry.strength * 0.8 * portal.beat) * shaft
	end
end

