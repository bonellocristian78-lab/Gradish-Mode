		image.Size = UDim2.fromScale(scales[index], scales[index])
		image.BackgroundTransparency = 1
		image.Image = "rbxassetid://" .. textureId
		image.ImageColor3 = colours[index]
		image.Rotation = math.random(0, 359)
		image.ZIndex = 1 + index
		image.Parent = gui
		table.insert(rings, { image = image, speed = speeds[index] })
	end

	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxassetid://" .. CONFIG.Textures.Smoke
	smoke.Color = ColorSequence.new(Color3.fromRGB(0, 0, 0), Color3.fromRGB(30, 30, 34))
	smoke.LightEmission = 0
