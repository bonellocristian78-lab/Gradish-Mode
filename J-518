--[[ Un disco rivolto in giù, appena sotto il soffitto. Dentro: una massa nera al centro e gli
     anelli del cerchio di DOORS, bianchi e neri, che girano in versi opposti. Sotto: fumo nero,
     scintille e strisce bianche che cadono, e una luce bianca che trema. La tela della SurfaceGui
     è fissa (512), non cresce con il portale. ]]

local function buildPortal(position)
	local disc = newPart("Portal", Vector3.new(0.2, 0.05, 0.2), CFrame.new(position), 1)

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Bottom
	gui.LightInfluence = 0
	gui.Brightness = 2.5
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(512, 512)
	gui.Parent = disc

	local mass = Instance.new("Frame")
	mass.AnchorPoint = Vector2.new(0.5, 0.5)
	mass.Position = UDim2.fromScale(0.5, 0.5)
	mass.Size = UDim2.fromScale(0.6, 0.6)
	mass.BackgroundColor3 = BLACK
	mass.BorderSizePixel = 0
	mass.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = mass

	local rings = {}
	local colours = { WHITE, BLACK, WHITE }
	local speeds = { 40, -65, 95 }
	local scales = { 1, 0.82, 0.62 }
	for index, textureId in ipairs(CONFIG.Textures.Rings) do
