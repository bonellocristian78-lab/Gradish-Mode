---====== L'ATMOSFERA ======---
--[[ Le luci della stanza e il colore dello schermo li comanda un solo ciclo per frame, finché
     dura. Si ricorda com'erano e alla fine li rimette, piano.

     Niente bianco e nero su tutta la stanza, e niente numeri a caso a ogni frame: le luci calano
     e prendono un colore freddo, lo schermo perde un po' di colore, e quando tremano seguono un
     rumore liscio, ognuna per conto suo. Il bianco e nero pieno resta al portale. Il flicker di
     DOORS (Module_Events.flicker) qui no: rimette le luci al valore che aveva letto, e
     cancellerebbe il buio che stiamo facendo. ]]

local mood = {
	dim        = 0,   -- 0 luci normali, 1 abbassate
	cold       = 0,   -- 0 colori normali, 1 stanza fredda e un po' spenta
	pulse      = 0,   -- il colpo di un battito, si spegne da solo
	surge      = 0,   -- quanto tremano adesso, insegue surgeUntil piano
	surgeUntil = 0,   -- fino a quando tremano (os.clock)
}

local stepBody -- più giù, con il corpo: lo muove lo stesso ciclo

local function startAtmosphere(room, portal)
	local lights = {}
	for _, light in ipairs(room:GetDescendants()) do
		if light:IsA("Light") then
			table.insert(lights, { light = light, brightness = light.Brightness, colour = light.Color, seed = #lights * 1.37 + 0.5 })
		end
	end

	local camera = workspace.CurrentCamera
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "J518Grade"
	grade.Parent = camera

	-- Rimettere a posto viene DOPO lo stop del ciclo: in cleanup è prima, e si esegue al contrario
	track(function()
		for _, entry in ipairs(lights) do
			if entry.light.Parent then
				tween(entry.light, 1.5, { Brightness = entry.brightness, Color = entry.colour })
			end
		end
		tween(grade, 1.5, { Saturation = 0, Contrast = 0, Brightness = 0, TintColor = WHITE })
		task.delay(1.6, function()
			grade:Destroy()
		end)
	end)

	track(RunService.RenderStepped:Connect(function(deltaTime)
		local now = os.clock()
		mood.pulse = math.max(mood.pulse - deltaTime * 2.5, 0)
		mood.surge += ((if now < mood.surgeUntil then 1 else 0) - mood.surge) * (1 - math.exp(-10 * deltaTime))

		for _, entry in ipairs(lights) do
			local light = entry.light
			if light.Parent then
				local wave = math.clamp(math.noise(now * 9, entry.seed) * 1.6 + 0.35, 0, 1)
				light.Brightness = entry.brightness * (1 - 0.7 * mood.dim) * (1 - 0.75 * mood.surge * wave) * (1 - 0.3 * mood.pulse)
				light.Color = entry.colour:Lerp(COLD, 0.5 * mood.cold)
			end
		end

		grade.Saturation = -0.35 * mood.cold
		grade.Contrast = 0.12 * mood.cold
		grade.TintColor = WHITE:Lerp(TINT, mood.cold)
		grade.Brightness = -0.05 * mood.pulse

		stepPortal(portal, deltaTime, now)
		stepBody(deltaTime)
	end))
end

