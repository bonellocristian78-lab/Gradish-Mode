---====== L'ATMOSFERA ======---
--[[ Le luci della stanza e il colore dello schermo li comanda un solo ciclo per frame, finché
     dura. Si ricorda com'erano e alla fine li rimette, piano. Il flicker di DOORS
     (Module_Events.flicker) qui no: rimette le luci al valore che aveva letto, e cancellerebbe
     il buio che stiamo facendo. ]]

local mood = {
	dim     = 0,   -- 0 luci normali, 1 quasi spente
	gray    = 0,   -- 0 a colori, 1 bianco e nero
	pulse   = 0,   -- il colpo di un battito, si spegne da solo
	flicker = 0,   -- fino a quando le luci tremano (os.clock)
}

local function startAtmosphere(room, portal)
	local lights = {}
	for _, light in ipairs(room:GetDescendants()) do
		if light:IsA("PointLight") or light:IsA("SpotLight") or light:IsA("SurfaceLight") then
			lights[light] = light.Brightness
		end
	end

	local camera = workspace.CurrentCamera
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "J518Grade"
	grade.Parent = camera

	-- Rimettere a posto viene DOPO lo stop del ciclo: in cleanup è prima, e si esegue al contrario
	track(function()
		for light, brightness in pairs(lights) do
			if light.Parent then
				tween(light, 1.5, { Brightness = brightness })
			end
		end
		tween(grade, 1.5, { Saturation = 0, Contrast = 0, Brightness = 0 })
		task.delay(1.6, function()
			grade:Destroy()
		end)
	end)

	track(RunService.RenderStepped:Connect(function(deltaTime)
		local now = os.clock()
		mood.pulse = math.max(mood.pulse - deltaTime * 3, 0)

		local shaking = now < mood.flicker
		for light, brightness in pairs(lights) do
			if light.Parent then
				local level = brightness * (1 - 0.8 * mood.dim)
				if shaking and math.random() < 0.5 then
					level *= math.random() * 0.4
				end
				light.Brightness = level
			end
		end

		grade.Saturation = -mood.gray
		grade.Contrast = 0.3 * mood.gray
		grade.Brightness = -0.04 * mood.gray - 0.12 * mood.pulse

		if portal.disc.Parent then
			for _, ring in ipairs(portal.rings) do
				ring.image.Rotation = (ring.image.Rotation + ring.speed * portal.spin * deltaTime) % 360
			end
			-- La luce del portale trema sempre un po'
			local jitter = if math.random() < 0.15 then math.random() * 0.6 else 1
			portal.light.Brightness = portal.glow * jitter
		end
	end))
end

