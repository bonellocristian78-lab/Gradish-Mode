---====== UTILITÀ ======---

local function flatUnit(vector)
	local flat = Vector3.new(vector.X, 0, vector.Z)
	if flat.Magnitude < 0.05 then return nil end
	return flat.Unit
end

local function tween(instance, duration, goals, style, direction)
	local playing = TweenService:Create(instance, TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goals)
	playing:Play()
	return playing
end

local function sequence(points)
	local keypoints = {}
	for _, point in ipairs(points) do
		table.insert(keypoints, NumberSequenceKeypoint.new(point[1], point[2]))
	end
	return NumberSequence.new(keypoints)
end

local function newPart(name, size, cframe, transparency)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Transparency = transparency
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Parent = folder
	return part
end

-- Un suono. Quelli in loop restano finché li si ferma; gli altri si tolgono da soli
local function playSound(soundId, volume, speed, parent, looped)
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. soundId
	sound.Volume = volume
	sound.PlaybackSpeed = speed or 1
	sound.Looped = looped == true
	sound.Parent = parent or folder
	sound:Play()
	if not looped then
		task.delay(12, function()
			sound:Destroy()
		end)
	end
	return sound
end

