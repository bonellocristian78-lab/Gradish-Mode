---- its body: every part anchored, put where its pose says every frame ----
local model = make("Model", { Name = "Listener" }, nil)
local function part(name, size, color, material, ball)
	local p = make("Part", { Name = name, Size = size, Color = color or FLESH, Material = material or Enum.Material.Slate, Anchored = true,
		CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false }, model)
	if ball then make("SpecialMesh", { MeshType = Enum.MeshType.Sphere }, p) end
	return p
end
local B = {
	Pelvis = part("Pelvis", Vector3.new(2, 0.9, 1)),
	Chest = part("Chest", Vector3.new(2.6, 3, 1.5)),
	Mouth = part("Mouth", Vector3.new(1.5, 2.1, 0.3), GLOW, Enum.Material.Neon),
	Neck = part("Neck", Vector3.new(0.6, 1, 0.6), DARKF),
	Head = part("Head", Vector3.new(1.3, 2.1, 1.5), FLESH, Enum.Material.Slate, true),
}
local ribs = {}
for i = 1, 5 do ribs[i] = part("Rib", Vector3.new(2.3 - math.abs(i - 3) * 0.25, 0.2, 0.25), DARKF) end
local LIMBS = {}
for _, side in ipairs({ -1, 1 }) do
	LIMBS[side] = {
		upperArm = part("UpperArm", Vector3.new(0.6, 3, 0.6)),
		lowerArm = part("LowerArm", Vector3.new(0.5, 3.2, 0.5), DARKF),
		hand = part("Hand", Vector3.new(0.7, 1, 0.3), DARKF),
		claws = { part("Claw", Vector3.new(0.12, 1, 0.12), Color3.fromRGB(220, 210, 190)), part("Claw", Vector3.new(0.12, 1.1, 0.12), Color3.fromRGB(220, 210, 190)),
			part("Claw", Vector3.new(0.12, 0.9, 0.12), Color3.fromRGB(220, 210, 190)) },
		upperLeg = part("UpperLeg", Vector3.new(0.8, 3, 0.8)),
		lowerLeg = part("LowerLeg", Vector3.new(0.6, 3, 0.6), DARKF),
		foot = part("Foot", Vector3.new(0.8, 0.4, 1.4), DARKF),
	}
end
make("PointLight", { Color = GLOW, Range = 14, Brightness = 2, Shadows = false }, B.Mouth)
model.PrimaryPart = B.Pelvis

local LEG = 3 -- a thigh, a shin
-- Its pose: on the floor at `cf` (turned its way), `phase` of its walk, `gait` how much it walks (0 standing), `reach`
-- its arms out, `head` its head's turn
local function pose(cf, phase, gait, reach, head)
	-- How high its hips: its lower foot on the floor
	local drops = {}
	for _, side in ipairs({ -1, 1 }) do
		local p = phase + (if side < 0 then 0 else math.pi)
		local swing = math.sin(p) * 0.55 * gait
		local bend = math.max(0, math.cos(p)) * gait + 0.15
		drops[side] = { swing, bend, LEG * math.cos(swing) + LEG * math.cos(swing - bend) + 0.4 }
	end
	local hips = cf * CFrame.new(0, math.max(drops[-1][3], drops[1][3]) + 0.3, 0) * CFrame.Angles(0, math.sin(phase) * 0.12 * gait, 0)
	B.Pelvis.CFrame = hips
	local chest = hips * CFrame.new(0, 0.45, 0) * CFrame.Angles(-0.28 - 0.08 * gait, 0, math.sin(phase) * 0.05 * gait)
	B.Chest.CFrame = chest * CFrame.new(0, 1.5, 0)
	B.Mouth.CFrame = chest * CFrame.new(0, 1.5, -0.62)
	for i, rib in ipairs(ribs) do rib.CFrame = chest * CFrame.new(0, 0.45 + i * 0.42, -0.8) end
	local neck = chest * CFrame.new(0, 3, 0)
	B.Neck.CFrame = neck * CFrame.new(0, 0.5, 0)
	B.Head.CFrame = neck * CFrame.new(0, 1, 0) * head * CFrame.new(0, 1, -0.15)
	for _, side in ipairs({ -1, 1 }) do
		local l, d = LIMBS[side], drops[side]
		local hip = hips * CFrame.new(0.55 * side, -0.3, 0) * CFrame.Angles(d[1], 0, 0)
		l.upperLeg.CFrame = hip * CFrame.new(0, -LEG / 2, 0)
		local knee = hip * CFrame.new(0, -LEG, 0) * CFrame.Angles(-d[2], 0, 0)
		l.lowerLeg.CFrame = knee * CFrame.new(0, -LEG / 2, 0)
		l.foot.CFrame = CFrame.new((knee * CFrame.new(0, -LEG, 0)).Position) * cf.Rotation * CFrame.new(0, -0.2, -0.3)
		local p = phase + (if side < 0 then math.pi else 0) -- (its arms against its legs)
		local shoulder = chest * CFrame.new(1.5 * side, 2.7, 0) * CFrame.Angles(math.sin(p) * 0.4 * gait + reach, 0, side * 0.14)
		l.upperArm.CFrame = shoulder * CFrame.new(0, -1.5, 0)
		local elbow = shoulder * CFrame.new(0, -3, 0) * CFrame.Angles(0.35 + 0.2 * gait + reach * 0.4, 0, 0)
		l.lowerArm.CFrame = elbow * CFrame.new(0, -1.6, 0)
		local wrist = elbow * CFrame.new(0, -3.2, 0)
		l.hand.CFrame = wrist * CFrame.new(0, -0.5, 0)
		for i, claw in ipairs(l.claws) do claw.CFrame = wrist * CFrame.new((i - 2) * 0.25, -1.3, -0.1) * CFrame.Angles(0.35, 0, 0) end
	end
end

---- where it goes ----
local _, _, root = P.body()
local room = W.room(W.here())
local camera = workspace.CurrentCamera
local spots = if room then W.points(room) else {}
if #spots < 2 then -- (outside DOORS: around you)
	local at = W.floor(if root then root.Position else camera.CFrame.Position)
	local ahead = flat(camera.CFrame.LookVector)
	ahead = if ahead.Magnitude > 0.01 then ahead.Unit else Vector3.new(0, 0, -1)
	spots = { at + ahead * 30 }
	for i = 1, 5 do table.insert(spots, W.floor(at + Vector3.new(rnd(25), 2, rnd(25)))) end
end
local door = spots[1]
local pos = door
local look = flat((spots[math.min(2, #spots)] - door))
look = if look.Magnitude > 0.01 then look.Unit else Vector3.new(0, 0, -1)
local target = spots[math.min(2, #spots)]
local state, stateAt = "enter", os.clock()
local phase, gait, reach, noise = 0, 0, 0, 0
local twitch, twitchUntil = CFrame.new(), 0
local clickAt, beatAt = os.clock() + 1, 0
local click, roar, heart = sfx("Click"), sfx("Roar"), sfx("Heartbeat")
local got = false
model.Parent = folder
pose(CFrame.lookAt(pos, pos + look), 0, 0, 0, CFrame.new())
FX.caption("It is blind. It hears you: crouch, or hide.", GLOW, 4)
FX.flicker(room, 1.5)

local function set(s, t)
	state, stateAt = s, os.clock()
	target = t or target
end
local born = os.clock()
on(RunService.Heartbeat, function(dt)
	local now = os.clock()
	local _, _, me = P.body()
	local hidden = P.hiding()
	local d = if me then flat(me.Position - pos).Magnitude else math.huge
	-- What it hears: your steps, near it (not crouched, not hidden)
	if me and not hidden and d < 70 and P.speed() > 2 and not P.crouching() then
		noise += dt * (if d < 35 then 1 else 0.5) * math.clamp(P.speed() / 15, 0.3, 1.5)
	else
		noise = math.max(0, noise - dt * 0.4)
	end
	if now - born > DURATION and state ~= "leave" then set("leave", door) end
	if (state == "wander" or state == "listen") and noise > 1.2 and me then
		set("charge", me.Position)
		FX.once(roar, B.Head, { Volume = 2 * VOLUME, RollOffMinDistance = 20 })
		FX.shake(6)
	end
	-- What it does
	local speed = SPEEDS[state] or 0
	if state == "charge" then
		if hidden then
			local spot = W.yourSpot()
			set("search", if spot then spot:GetPivot().Position else target)
		elseif me then
			target = me.Position
			if d < 3.5 and not got then
				got = true
				task.spawn(FX.face, B.Head, roar, GLOW, function() HURT.kill("the Listener", HINTS) end)
			end
		end
		if now - stateAt > 5 then
			noise = 0
			set("listen")
		end
	elseif state == "listen" then
		speed = 0
		if now - stateAt > 2.2 then set("wander", pick(spots)) end
	elseif state == "sniff" then
		speed = 0
		if now - stateAt > 2.5 then
			noise = 0
			set("wander", pick(spots))
		end
	end
	local to = flat(target - pos)
	if speed > 0 and to.Magnitude > 1.5 then
		-- (turning toward it, as fast as it can: a turn of its yaw, so straight behind it is turned to as well)
		local a, b = math.atan2(look.X, look.Z), math.atan2(to.X, to.Z)
		a += math.clamp((b - a + math.pi) % (2 * math.pi) - math.pi, -dt * 7, dt * 7)
		look = Vector3.new(math.sin(a), 0, math.cos(a))
		pos = W.floor(pos + look * math.min(speed * dt, to.Magnitude) + Vector3.new(0, 2, 0))
		phase += dt * speed / 3.2
		gait = math.min(1, gait + dt * 3)
	else
		gait = math.max(0, gait - dt * 3)
		if speed > 0 then -- (there)
			if state == "enter" or state == "wander" then
				if math.random() < 0.4 then set("listen") else set("wander", pick(spots)) end
			elseif state == "search" then
				set("sniff")
			elseif state == "leave" then
				stop()
				return
			end
		end
	end
	reach = reach + ((if state == "charge" then 1.3 else 0) - reach) * math.min(dt * 5, 1)
	-- Its head: toward what it hears, cocked, twitching
	if now >= twitchUntil and math.random() < dt * 0.8 then
		twitch, twitchUntil = CFrame.Angles(rnd(0.4), rnd(0.6), rnd(0.5)), now + 0.15
	end
	local turn = 0
	if me and d < 60 then
		local rel = CFrame.lookAt(pos, pos + look):PointToObjectSpace(me.Position)
		turn = math.clamp(math.atan2(-rel.X, -rel.Z), -0.9, 0.9) * (if state == "listen" or state == "charge" then 1 else 0.3)
	end
	local head = CFrame.Angles(if state == "sniff" then -0.6 else 0.1, turn, math.sin(now * 0.8) * 0.3) * (if now < twitchUntil then twitch else CFrame.new())
	pose(CFrame.lookAt(pos, pos + look), phase, gait, reach, head)
	-- Its throat clicking; your heart, when it is near
	if now >= clickAt then
		clickAt = now + 1.2 + math.random() * 1.6
		FX.once(click, B.Head, { Volume = 1.4 * VOLUME, RollOffMinDistance = 10, PlaybackSpeed = 0.9 + math.random() * 0.3 })
	end
	if d < 22 and now >= beatAt then
		beatAt = now + 0.45 + d / 40
		FX.once(heart, SoundService, { Volume = (1 - d / 22) * 1.6 * VOLUME })
	end
	FX.near(pos, 40, if state == "charge" then 4 else 1.5)
end)
