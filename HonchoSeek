local function partsByName(model) -- (only the names there is one of)
	local found, count = {}, {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			count[d.Name] = (count[d.Name] or 0) + 1
			found[d.Name] = d
		end
	end
	for name, n in pairs(count) do
		if n > 1 then found[name] = nil end
	end
	return found
end
local function rootOf(model) -- its rig's Root (the one in SeekRig first), or its PrimaryPart
	local any = nil
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == "Root" then
			if d.Parent and d.Parent.Name == "SeekRig" then return d end
			any = any or d
		end
	end
	return any or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

-- DOORS' own, out of sight and silent (only for you), once; switched back off if the server switches it on
local function hide(entry, d, silence)
	if d:IsA("BasePart") or d:IsA("Decal") then
		table.insert(entry.hidden, { d, "LocalTransparencyModifier", d.LocalTransparencyModifier })
		d.LocalTransparencyModifier = 1
	elseif d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Beam") or d:IsA("Trail") or d:IsA("Fire") or d:IsA("Smoke") then
		table.insert(entry.hidden, { d, "Enabled", d.Enabled })
		d.Enabled = false
		if entry.watch then
			table.insert(entry.watch, d:GetPropertyChangedSignal("Enabled"):Connect(function() if d.Enabled then d.Enabled = false end end))
		end
	elseif silence and d:IsA("Sound") then
		table.insert(entry.hidden, { d, "Volume", d.Volume })
		d.Volume = 0
		table.insert(entry.watch, d:GetPropertyChangedSignal("Volume"):Connect(function() if d.Volume ~= 0 then d.Volume = 0 end end))
	end
end
local function unhide(entry, still)
	if entry.watch then for _, c in ipairs(entry.watch) do c:Disconnect() end end
	if still then for _, h in ipairs(entry.hidden) do pcall(function() h[1][h[2]] = h[3] end) end end
end

-- What it found in DOORS' Seek, in the executor's folder (HonchoSeek/SeekStructure.txt) and the console
local function describe(original, mode)
	pcall(function()
		local top = original:GetFullName()
		local lines = { "HonchoSeek on " .. top .. (if os.date then " at " .. os.date("%Y-%m-%d %H:%M:%S") else ""), "mode: " .. mode, "" }
		for _, d in ipairs(original:GetDescendants()) do
			if #lines > 500 then break end
			local path = d:GetFullName():sub(#top + 2)
			if d:IsA("BasePart") then
				table.insert(lines, ("part  %s [%s] size %.2f %.2f %.2f transparency %.2f"):format(path, tostring(d.ClassName), d.Size.X, d.Size.Y,
					d.Size.Z, d.Transparency))
			elseif d:IsA("JointInstance") then
				table.insert(lines, ("joint %s %s -> %s"):format(path, d.Part0 and d.Part0.Name or "-", d.Part1 and d.Part1.Name or "-"))
			elseif d:IsA("Sound") or d:IsA("Animator") or d:IsA("Model") then
				table.insert(lines, ("%s  %s"):format(tostring(d.ClassName), path))
			end
		end
		if not isfolder(FOLDER) then makefolder(FOLDER) end
		writefile(FOLDER .. "/SeekStructure.txt", table.concat(lines, "\n"))
	end)
	print(("[HonchoSeek] %s: %s"):format(original.Name, mode))
end

local probe = RaycastParams.new()
probe.FilterType = Enum.RaycastFilterType.Exclude

local function dressSeek(original)
	if seeks[original] or not original:IsDescendantOf(workspace) then return end
	local follow = rootOf(original)
	if not follow then
		warn("[HonchoSeek] nothing in " .. original.Name .. " to follow: left as it is")
		return
	end
	local copy = honcho:Clone()
	local root = copy:FindFirstChild("RootPart")
	root.Anchored = true
	local entry = { original = original, copy = copy, root = root, follow = follow, hidden = {}, watch = {}, motors = {}, ties = {},
		state = "emerge", time = 0, seen = {}, born = os.clock(), floor = nil, look = nil }
	for _, m in ipairs(copy:GetDescendants()) do
		if m:IsA("Motor6D") and m.Part1 then
			entry.motors[m.Part1.Name] = m
			if m.Part1.Name:find("^Tie") then table.insert(entry.ties, m) end
		end
	end
	entry.footsteps = copy:FindFirstChild("Footsteps", true)
	entry.scream = Instance.new("Sound")
	entry.scream.Name, entry.scream.SoundId, entry.scream.Volume, entry.scream.RollOffMinDistance = "HonchoScream", SCREAM, 2, 30
	entry.scream.Parent = root
	-- What DOORS plays on its Seek: the animations of its first seconds are its rise and its run; one after those, with it
	-- standing still, is the crucifix
	local animator = original:FindFirstChildWhichIsA("Animator", true)
	if animator then
		table.insert(entry.watch, animator.AnimationPlayed:Connect(function(track)
			local id = track.Animation and track.Animation.AnimationId or ""
			if os.clock() - entry.born < 4 then
				entry.seen[id] = true
			elseif not entry.seen[id] and entry.state ~= "crux" and entry.state ~= "cruxend" and (entry.pace or 0) < 3 then
				entry.state, entry.time = "crux", 0
				entry.scream.PlaybackSpeed = 0.8
				entry.scream:Play()
				table.insert(entry.watch, track.Stopped:Connect(function()
					if entry.state == "crux" then entry.state, entry.time = "cruxend", 0 end
				end))
			end
		end))
	end
	copy.Parent = folder
	-- Only now, Honcho in its place: DOORS' Seek out of sight and silent
	for _, d in ipairs(original:GetDescendants()) do hide(entry, d, true) end
	table.insert(entry.watch, original.DescendantAdded:Connect(function(d) hide(entry, d, true) end))
	seeks[original] = entry
	describe(original, ("Honcho on its %s (%d of its animations made his)"):format(follow.Name, (function()
		local n = 0
		for _ in pairs(ANIMS) do n += 1 end
		return n
	end)()))
end

local function undressSeek(original, gone)
	local entry = seeks[original]
	if not entry then return end
	seeks[original] = nil
	unhide(entry, not gone)
	if gone and entry.state == "crux" and ANIMS.cruxend then -- taken by the crucifix: he goes down before he goes
		entry.state, entry.time = "cruxend", 0
		entry.leaving = true
		seeks[{}] = entry -- (kept a moment longer, on its own)
		task.delay(ANIMS.cruxend.length + 0.2, function() entry.copy:Destroy() end)
		return
	end
	entry.copy:Destroy()
end

-- The kit's eye where DOORS' own is (each piece on its piece: DOORS turns and sizes its veins at random); it blinks as it
local function dressEye(original)
	if eyes[original] or not kitEye or not original:IsDescendantOf(workspace) or original:IsDescendantOf(folder) then return end
	local copy = kitEye:Clone()
	local theirs = partsByName(original)
	local matched = 0
	for _, p in ipairs(copy:GetDescendants()) do
		local t = p:IsA("BasePart") and theirs[p.Name]
		if t then
			p.CFrame = t.CFrame
			if p.Name == "Veins" then p.Size = t.Size end
			matched += 1
		end
	end
	if matched == 0 then copy:PivotTo(original:GetPivot()) end
	local entry = { copy = copy, hidden = {} }
	local theirEye, ourEye = theirs.Eye, copy:FindFirstChild("Eye")
	if theirEye and ourEye then
		entry.blink = theirEye:GetPropertyChangedSignal("Transparency"):Connect(function()
			ourEye.Transparency = theirEye.Transparency
			for _, d in ipairs(ourEye:GetChildren()) do
				if d:IsA("Decal") then d.Transparency = theirEye.Transparency end
			end
		end)
	end
	copy.Parent = folder
	for _, d in ipairs(original:GetDescendants()) do hide(entry, d, false) end
	eyes[original] = entry
end

-- The kit's hand where DOORS' own is, piece by piece, every frame (it grabs as DOORS' does)
local function dressArm(original)
	if arms[original] or not kitArm or not original:IsDescendantOf(workspace) or original:IsDescendantOf(folder) then return end
	local copy = kitArm:Clone()
	local theirs, ours = partsByName(original), partsByName(copy)
	local entry = { copy = copy, hidden = {}, pairs = {} }
	for name, part in pairs(ours) do
		if theirs[name] then
			table.insert(entry.pairs, { part, theirs[name] })
			part.CFrame = theirs[name].CFrame
		else
			part.Transparency = 1 -- (nothing of DOORS' to stand on: unseen)
		end
	end
	if #entry.pairs == 0 then
		copy:Destroy()
		return
	end
	entry.anchor = entry.pairs[1][2]
	copy.Parent = folder
	for _, d in ipairs(original:GetDescendants()) do hide(entry, d, false) end
	arms[original] = entry
end

---====== EVERY FRAME ======---

local function floorUnder(entry, at)
	probe.FilterDescendantsInstances = { folder, entry.original, LocalPlayer.Character }
	local hit = workspace:Raycast(at + Vector3.new(0, 2, 0), Vector3.new(0, -30, 0), probe)
	if hit then entry.floor = hit.Position.Y end
	return entry.floor or (at.Y - 5.8)
end

local function stepSeek(entry, dt, now)
	local anim
	if not entry.leaving then
		-- Where: DOORS' Seek's place, on the floor under it, turned the way it goes
		local at = entry.follow.Position
		local flat = (at - (entry.last or at)) * Vector3.new(1, 0, 1)
		entry.pace = flat.Magnitude / math.max(dt, 1e-3)
		entry.last = at
		local look = if entry.pace > 2 then flat.Unit else entry.follow.CFrame.LookVector * Vector3.new(1, 0, 1)
		if look.Magnitude > 1e-3 then entry.look = (entry.look or look.Unit):Lerp(look.Unit, math.min(dt * 10, 1)) end
		local pos = Vector3.new(at.X, floorUnder(entry, at) - HON_FLOOR, at.Z)
		entry.root.CFrame = CFrame.lookAt(pos, pos + (entry.look or Vector3.new(0, 0, -1)))
	end
	-- Which: out of the floor (until it runs), the run (as fast as it goes), the crucifix
	if entry.state == "emerge" and (entry.pace or 0) > 6 then entry.state, entry.time = "run", 0 end
	if entry.state == "emerge" then
		anim = ANIMS.emerge
		if anim and entry.time >= anim.length then
			entry.state, entry.time = "run", 0
			entry.scream:Play() -- (out)
		end
	end
	local speed = 1
	if entry.state == "run" then
		anim = ANIMS.run
		speed = math.clamp((entry.pace or 0) / 20, 0.35, 1.6)
	elseif entry.state == "crux" then
		anim = if ANIMS.cruxstart and entry.time < ANIMS.cruxstart.length then ANIMS.cruxstart else ANIMS.cruxloop
	elseif entry.state == "cruxend" then
		anim = ANIMS.cruxend
	end
	entry.time += dt * speed
	if anim then
		local t = entry.time
		if anim == ANIMS.cruxloop and ANIMS.cruxstart then t -= ANIMS.cruxstart.length end
		t = if anim.looped and anim.length > 0 then t % anim.length else math.min(t, anim.length)
		for name, list in pairs(anim.joints) do
			local motor = entry.motors[name]
			if motor then motor.Transform = poseAt(list, t) end
		end
	end
	-- His tie swings (more as he runs); his footsteps while he runs
	local swing = if entry.state == "run" then 0.25 else 0.08
	for i, m in ipairs(entry.ties) do
		m.Transform = CFrame.Angles(math.sin(now * 9 + i * 0.7) * swing * (0.5 + i * 0.15), 0, math.sin(now * 5.3 + i) * swing * 0.4)
	end
	if entry.footsteps then
		local running = entry.state == "run" and (entry.pace or 0) > 3
		if running and not entry.footsteps.IsPlaying then entry.footsteps:Play() elseif not running and entry.footsteps.IsPlaying then entry.footsteps:Stop() end
		entry.footsteps.PlaybackSpeed = math.clamp((entry.pace or 0) / 22, 0.6, 1.5)
	end
end

table.insert(connections, RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()
	local gone = {}
	for original, entry in pairs(seeks) do
		if entry.leaving then
			if entry.copy.Parent then stepSeek(entry, dt, now) else table.insert(gone, original) end
		elseif not original:IsDescendantOf(workspace) then
			table.insert(gone, original)
		else
			stepSeek(entry, dt, now)
		end
	end
	for _, original in ipairs(gone) do -- (after the loop: the table is not changed while it is gone through)
		if seeks[original] and seeks[original].leaving then seeks[original] = nil else undressSeek(original, true) end
	end
	local camera = workspace.CurrentCamera
	local me = camera and camera.CFrame.Position
	for original, entry in pairs(arms) do
		if not original:IsDescendantOf(workspace) then
			entry.copy:Destroy()
			arms[original] = nil
		elseif not me or (entry.anchor.Position - me).Magnitude < ARM_RANGE then
			for _, pair in ipairs(entry.pairs) do pair[1].CFrame = pair[2].CFrame end
		end
	end
end))

-- When it gets you: his scream
local function watchDeath(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then return end
	table.insert(connections, humanoid.Died:Connect(function()
		local root = character:FindFirstChild("HumanoidRootPart")
		for original, entry in pairs(seeks) do
			if not entry.leaving and root and (entry.root.Position - root.Position).Magnitude < 25 then
				entry.scream.PlaybackSpeed = 1
				entry.scream:Play()
			end
		end
	end))
end
if LocalPlayer.Character then task.spawn(watchDeath, LocalPlayer.Character) end
table.insert(connections, LocalPlayer.CharacterAdded:Connect(watchDeath))

-- DOORS' Seek, its eyes and its hands: now and every time they come
local function consider(d)
	if NAMES[d.Name] and d:IsA("Model") and not d:IsDescendantOf(folder) then
		task.delay(0.1, dressSeek, d) -- (its pieces arrive with it)
	elseif d.Name == "Seek_Arm" and d:IsA("Model") and not d:IsDescendantOf(folder) then
		task.delay(0.1, dressArm, d)
	end
end
for _, d in ipairs(workspace:GetDescendants()) do consider(d) end
table.insert(connections, workspace.DescendantAdded:Connect(consider))
for _, eye in ipairs(CollectionService:GetTagged("SeekEye")) do task.spawn(dressEye, eye) end
table.insert(connections, CollectionService:GetInstanceAddedSignal("SeekEye"):Connect(function(eye) task.delay(0.1, dressEye, eye) end))
table.insert(connections, CollectionService:GetInstanceRemovedSignal("SeekEye"):Connect(function(eye)
	local entry = eyes[eye]
	if entry then
		eyes[eye] = nil
		if entry.blink then entry.blink:Disconnect() end
		entry.copy:Destroy()
	end
end))

SESSION.__HonchoSeek = function()
	for _, c in ipairs(connections) do c:Disconnect() end
	for original, entry in pairs(seeks) do
		if not entry.leaving then unhide(entry, original:IsDescendantOf(workspace)) end
	end
	for original, entry in pairs(eyes) do
		if entry.blink then entry.blink:Disconnect() end
		unhide(entry, original:IsDescendantOf(workspace))
	end
	for original, entry in pairs(arms) do unhide(entry, original:IsDescendantOf(workspace)) end
	table.clear(seeks)
	table.clear(eyes)
	table.clear(arms)
	folder:Destroy()
end
