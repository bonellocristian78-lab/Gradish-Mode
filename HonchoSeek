local function seekFK(T)
	local w = { Root = ID }
	for _, j in ipairs(SEEK_RIG) do
		local s = SJ[j[1]]
		w[j[1]] = w[s.p0] * s.c0 * (T[j[1]] or ID) * s.c1inv
	end
	return w
end

-- Honcho's rig, from the kit: his joints (a Motor6D before a weld), parents first from his RootPart (at the origin, turned
-- as in the kit: his character's axes are his RootPart's)
local HJ, HSIZE, HORDER = {}, {}, {}
for _, d in ipairs(honcho:GetDescendants()) do
	if (d:IsA("Motor6D") or d:IsA("Weld") or d:IsA("ManualWeld")) and d.Part0 and d.Part1 then
		local name = d.Part1.Name
		if not (HJ[name] and HJ[name].motor) then
			HJ[name] = { p0 = d.Part0.Name, c0 = d.C0, c1inv = d.C1:Inverse(), motor = d:IsA("Motor6D") }
		end
	elseif d:IsA("BasePart") then
		HSIZE[d.Name] = d.Size
	end
end
do
	local function visit(name)
		for child, j in pairs(HJ) do
			if j.p0 == name and not table.find(HORDER, child) then
				table.insert(HORDER, child)
				visit(child)
			end
		end
	end
	visit("RootPart")
end
local HROOT = rot(honcho.RootPart.CFrame)
local function honFK(T)
	local w = { RootPart = HROOT }
	for _, name in ipairs(HORDER) do
		local j = HJ[name]
		if w[j.p0] then w[name] = w[j.p0] * j.c0 * (T[name] or ID) * j.c1inv end
	end
	return w
end
local s0, h0 = seekFK({}), honFK({})

local function rotBetween(a, b) -- the smallest turn taking direction a onto b
	a, b = a.Unit, b.Unit
	local axis = a:Cross(b)
	local s, c = axis.Magnitude, a:Dot(b)
	if s < 1e-8 then
		if c > 0 then return ID end
		local p = if math.abs(a.X) < 0.9 then a:Cross(Vector3.new(1, 0, 0)) else a:Cross(UP)
		return CFrame.fromAxisAngle(p.Unit, math.pi)
	end
	return CFrame.fromAxisAngle(axis / s, math.atan2(s, c))
end
local function toH(R) return HROOT * R * HROOT:Inverse() end -- a turn of Seek's world as one of Honcho's
local function sdir(a, b) return HROOT:VectorToWorldSpace(b - a) end -- a direction of Seek's, in Honcho's world
local function yawOnly(R)
	local f = R:VectorToWorldSpace(Vector3.new(0, 0, -1))
	f = Vector3.new(f.X, 0, f.Z)
	if f.Magnitude < 1e-6 then return ID end
	return rotBetween(Vector3.new(0, 0, -1), f.Unit)
end
local function jointH(w, child) local j = HJ[child] return (w[j.p0] * j.c0).Position end
local function jointS(w, child) local j = SJ[child] return (w[j.p0] * j.c0).Position end

local CORNERS = {}
for _, x in ipairs({ -0.5, 0.5 }) do
	for _, y in ipairs({ -0.5, 0.5 }) do
		for _, z in ipairs({ -0.5, 0.5 }) do table.insert(CORNERS, Vector3.new(x, y, z)) end
	end
end
local SEEK_BODY = { "LeftLowerLeg", "RightLowerLeg", "LeftUpperLeg", "RightUpperLeg", "LowerTorso", "UpperTorso", "Head", "LeftUpperArm",
	"RightUpperArm", "LeftLowerArm", "RightLowerArm" }
local HON_BODY = { "LeftFoot", "RightFoot", "LeftLowerLeg", "RightLowerLeg", "Pelvis", "UpperTorso", "Head", "LeftHand", "RightHand",
	"LeftUpperArm", "RightUpperArm" }
local function extent(w, names, sizes, turn) -- its lowest and highest point, up its character's axis
	local lo, hi = math.huge, -math.huge
	for _, n in ipairs(names) do
		local cf, size = w[n], sizes[n]
		if cf and size then
			for _, c in ipairs(CORNERS) do
				local y = turn:VectorToObjectSpace(cf * (size * c)).Y
				lo, hi = math.min(lo, y), math.max(hi, y)
			end
		end
	end
	return lo, hi
end
-- The floors (Seek's: the bottom of its run; Honcho's: the kit's FloorPart) and how much bigger Honcho is
local floorPart = honcho:FindFirstChild("FloorPart")
local HON_FLOOR = if floorPart then floorPart.Position.Y - floorPart.Size.Y / 2 - honcho.RootPart.Position.Y else -6.39
local SEEK_FLOOR0 = math.min(s0.LeftLowerLeg.Position.Y, s0.RightLowerLeg.Position.Y) - 1.2
local K = (HROOT:VectorToObjectSpace(h0.Pelvis.Position).Y - HON_FLOOR) / (s0.LowerTorso.Position.Y - SEEK_FLOOR0)
local SEEK_FLOOR = SEEK_FLOOR0
local HEAD_LIFT = 0.6

-- Honcho's joints for one pose of Seek's: { [part] = Transform }
local function retarget(seekT)
	local ws = seekFK(seekT)
	local T, wh = {}, { RootPart = HROOT }
	local function place(name, R, pos)
		local j = HJ[name]
		local Rt = rot(j.c0):Inverse() * rot(wh[j.p0]):Inverse() * R * rot(j.c1inv:Inverse())
		local t = if pos then CFrame.new(pos) * Rt else Rt
		T[name] = t
		wh[name] = wh[j.p0] * j.c0 * t * j.c1inv
	end
	local function follow(name)
		local j = HJ[name]
		T[name] = ID
		wh[name] = wh[j.p0] * j.c0 * j.c1inv
	end
	local function aim(name, child, target)
		follow(name)
		place(name, rotBetween(jointH(wh, child) - jointH(wh, name), target) * rot(wh[name]))
	end
	-- His pelvis: Seek's hips' turn since its rest, and their way up and down (scaled)
	local turn = rot(ws.LowerTorso) * rot(s0.LowerTorso):Inverse()
	local move = (ws.LowerTorso.Position - s0.LowerTorso.Position) * K
	place("Pelvis", toH(turn) * rot(h0.Pelvis), rot(HJ.Pelvis.c0):VectorToObjectSpace(HROOT:VectorToWorldSpace(Vector3.new(0, move.Y, 0))))
	-- His spine: its three pieces share Seek's bend from hips to chest
	local spine = sdir(ws.LowerTorso.Position, ws.UpperTorso.Position)
	local pieces, shares = { "LowerTorso", "MiddleTorso", "UpperTorso" }, { 1 / 3, 1 / 2, 1 }
	for i, name in ipairs(pieces) do
		for k = i, #pieces do follow(pieces[k]) end
		place(name, ID:Lerp(rotBetween(jointH(wh, "Neck") - jointH(wh, name), spine), shares[i]) * rot(wh[name]))
	end
	-- His head: Seek's head's own turn beyond its chest's, on his chest; lifted toward upright; his neck halfway
	local chest = rot(ws.UpperTorso) * rot(s0.UpperTorso):Inverse()
	local head = rot(ws.Head) * rot(s0.Head):Inverse()
	local Rhead = (rot(wh.UpperTorso) * rot(h0.UpperTorso):Inverse()) * toH(chest:Inverse() * head) * rot(h0.Head)
	Rhead = ID:Lerp(rotBetween(Rhead:VectorToWorldSpace(UP), HROOT:VectorToWorldSpace(UP)), HEAD_LIFT) * Rhead
	follow("Neck")
	place("Neck", ID:Lerp(Rhead * rot(h0.Head):Inverse() * rot(h0.Neck) * rot(wh.Neck):Inverse(), 0.5) * rot(wh.Neck))
	place("Head", Rhead)
	-- His arms: the shoulder pad on his chest, the upper arm along Seek's, the forearm along Seek's, the rest straight
	for _, side in ipairs({ "Left", "Right" }) do
		follow(side .. "Shoulder")
		local shoulder, elbow, wrist = jointS(ws, side .. "UpperArm"), jointS(ws, side .. "LowerArm"), ws[side .. " Hand"].Position
		aim(side .. "UpperArm", side .. "UpperWrist", sdir(shoulder, elbow))
		aim(side .. "UpperWrist", side .. "LowerWrist", sdir(elbow, wrist))
		follow(side .. "LowerWrist")
		follow(side .. "Hand")
	end
	-- His legs: the thigh along Seek's, both shin pieces along Seek's shin, the foot flat, turned as his hips
	for _, side in ipairs({ "Left", "Right" }) do
		local hip, knee = jointS(ws, side .. "UpperLeg"), jointS(ws, side .. "LowerLeg")
		local foot = ws[side .. "LowerLeg"] * Vector3.new(0, -1.1, 0)
		aim(side .. "UpperLeg", side .. "MiddleLeg", sdir(hip, knee))
		aim(side .. "MiddleLeg", side .. "LowerLeg", sdir(knee, foot))
		aim(side .. "LowerLeg", side .. "Ankle", sdir(knee, foot))
		follow(side .. "Ankle")
		place(side .. "Foot", toH(yawOnly(turn)) * rot(h0[side .. "Foot"]))
	end
	-- On the floor as Seek is: standing, his lowest point as Seek's; under the floor, as much of him under as of Seek
	local sLo, sHi = extent(ws, SEEK_BODY, SSIZE, ID)
	sLo, sHi = sLo * K - SEEK_FLOOR * K, sHi * K - SEEK_FLOOR * K
	local hLo, hHi = extent(honFK(T), HON_BODY, HSIZE, HROOT)
	hLo, hHi = hLo - HON_FLOOR, hHi - HON_FLOOR
	local under = math.clamp(-sLo / math.max(sHi - sLo, 1e-3), 0, 1)
	local lift = (sLo - hLo) * (1 - under) + (sHi - hHi) * under
	T.Pelvis = T.Pelvis + rot(HJ.Pelvis.c0):VectorToObjectSpace(HROOT:VectorToWorldSpace(Vector3.new(0, lift, 0)))
	return T
end

-- The kit's animations, each keyframe made Honcho's: { joints = { [part] = { { t, cf }, ... } }, length, looped }
local function posesOf(frame)
	local T = {}
	for _, d in ipairs(frame:GetDescendants()) do
		if d:IsA("Pose") and d.Weight > 0 then T[d.Name] = d.CFrame end
	end
	return T
end
local ANIMS = {}
local saves = honcho:FindFirstChild("AnimSaves")
if saves then
	local run = saves:FindFirstChild("run")
	if run then -- (Seek's floor: the bottom of its run)
		local low = math.huge
		for _, frame in ipairs(run:GetKeyframes()) do
			local ws = seekFK(posesOf(frame))
			for _, n in ipairs({ "LeftLowerLeg", "RightLowerLeg" }) do
				for _, c in ipairs(CORNERS) do low = math.min(low, (ws[n] * (SSIZE[n] * c)).Y) end
			end
		end
		SEEK_FLOOR = low
	end
	for _, kfs in ipairs(saves:GetChildren()) do
		if kfs:IsA("KeyframeSequence") then
			local anim = { joints = {}, length = 0, looped = kfs.Loop }
			local frames = kfs:GetKeyframes()
			table.sort(frames, function(a, b) return a.Time < b.Time end)
			for _, frame in ipairs(frames) do
				anim.length = math.max(anim.length, frame.Time)
				for name, t in pairs(retarget(posesOf(frame))) do
					anim.joints[name] = anim.joints[name] or {}
					table.insert(anim.joints[name], { t = frame.Time, cf = t })
				end
			end
			ANIMS[kfs.Name:lower()] = anim
		end
	end
	saves:Destroy()
end
SESSION.__HonchoSeekAnimations = ANIMS -- (made for Honcho: to look at them)
local function poseAt(list, time) -- (all its keyframes are linear)
	local a, b = list[1], nil
	for i = 2, #list do
		if list[i].t <= time then a = list[i] else b = list[i] break end
	end
	if not b or time <= a.t then return a.cf end
	return a.cf:Lerp(b.cf, (time - a.t) / (b.t - a.t))
end

