local function clean(model, keepAnchored) -- nothing of DOORS' in it, nothing that collides, no shadows, fewer particles
	model:SetAttribute("LoadModule", nil)
	local all = model:GetDescendants()
	table.insert(all, model)
	for _, d in ipairs(all) do
		for _, tag in ipairs(CollectionService:GetTags(d)) do CollectionService:RemoveTag(d, tag) end
		if d:IsA("LuaSourceContainer") or d:IsA("ProximityPrompt") or d:IsA("TouchTransmitter") or d:IsA("Animation")
			or d:IsA("AnimationController") or d:IsA("Animator") or d:IsA("BodyMover") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CanCollide, d.CanTouch, d.CanQuery, d.Massless, d.CastShadow = false, false, false, true, false
			d.Anchored = keepAnchored
		elseif d:IsA("Light") then
			d.Shadows = false
		elseif d:IsA("ParticleEmitter") then
			d.Rate = math.min(d.Rate, MAX_RATE)
		end
	end
end
