if SETTINGS.SaveInstance and typeof(saveinstance) == "function" then
	caption("DoorsDump: saveinstance, this takes a while")

	local name = ROOT .. "_place"
	-- Executors disagree on the signature, so try both.
	local ok = pcall(saveinstance, { FileName = name })
	if not ok then
		ok = pcall(saveinstance, game, { FileName = name })
	end
	print("[DoorsDump] saveinstance " .. (ok and ("-> " .. name) or "failed"))
end

