local ReplicatedFirst   = game:GetService("ReplicatedFirst")
local Stats             = game:GetService("Stats")
local Workspace         = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

local SETTINGS = {
	MeasureSeconds   = 8,
	DecompileModules = true,
	TreeDepth        = 14,
	MaxTreeLines     = 80000,

	-- A full saveinstance as well. Slow, and some executors crash on DOORS,
	-- so it is off unless you turn it on.
	SaveInstance     = false,
}

---====== WRITING FILES ======---

if typeof(writefile) ~= "function" then
	warn("[DoorsDump] your executor has no writefile -- nothing can be saved")
	return
end

local ROOT = "DoorsDump_" .. os.date("%Y-%m-%d_%H-%M-%S")
local hasFolders = typeof(makefolder) == "function"

local function folderExists(path)
	if typeof(isfolder) ~= "function" then return false end
	local ok, yes = pcall(isfolder, path)
	return ok and yes
end

local function ensureFolder(relative)
	if not hasFolders then return end

	local path = ROOT
	if not folderExists(path) then pcall(makefolder, path) end

	for part in relative:gmatch("[^/]+") do
		path = path .. "/" .. part
		if not folderExists(path) then pcall(makefolder, path) end
	end
end

-- Without folder support everything goes flat, prefixed with the run name.
local function fileName(relative)
	if hasFolders then return ROOT .. "/" .. relative end
	return ROOT .. "__" .. (relative:gsub("/", "__"))
end

local function write(relative, text)
	ensureFolder(relative:match("^(.*)/[^/]+$") or "")

	local ok, err = pcall(writefile, fileName(relative), text)
	if not ok then
		warn("[DoorsDump] could not write " .. relative .. ": " .. tostring(err))
	end
	return ok
end

---====== SAYING WHAT IS HAPPENING ======---

local function caption(text)
	print("[DoorsDump] " .. text)
	pcall(function()
		require(LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game).caption(text, true)
	end)
end

local report = {}

local function line(format, ...)
	if select("#", ...) > 0 then
		format = format:format(...)
	end
	table.insert(report, format)
end

local function head(title)
	line("")
	line("== " .. title .. " " .. ("="):rep(math.max(0, 60 - #title)))
end

local function read(instance, property)
	local ok, value = pcall(function() return instance[property] end)
	if ok then return value end
	return nil
end

---====== MEASURING ======---
--[[ Frame times plus where the time goes. FrameTime is the whole frame;
     RenderCPUFrameTime the part spent preparing the picture; HeartbeatTime
     the game's own scripts; the draw calls are how many separate things the
     GPU is asked to draw, and the shadow ones are the shadow passes alone.
     If the frame is much longer than render + scripts, something else --
     usually memory -- is the problem, and no graphics cut will fix it.

     Each is read under pcall: not every Roblox build exposes all of them. ]]

local STAT_PROPERTIES = {
	"FrameTime", "RenderCPUFrameTime", "RenderGPUFrameTime", "HeartbeatTime",
	"PhysicsStepTime", "SceneDrawcallCount", "ShadowsDrawcallCount", "SceneTriangleCount",
}

local function measure(seconds)
	local deltas, sums, counts = {}, {}, {}

	local connection = RunService.RenderStepped:Connect(function(dt)
		deltas[#deltas + 1] = dt
		for _, property in ipairs(STAT_PROPERTIES) do
			local ok, value = pcall(function() return Stats[property] end)
			if ok and type(value) == "number" then
				sums[property] = (sums[property] or 0) + value
				counts[property] = (counts[property] or 0) + 1
			end
		end
	end)
	task.wait(seconds)
	connection:Disconnect()

	local result = { frames = #deltas, stats = {} }

	local total = 0
	for _, dt in ipairs(deltas) do total += dt end
	result.seconds = total
	if #deltas == 0 or total <= 0 then return result end

	local worstFirst = table.clone(deltas)
	table.sort(worstFirst, function(a, b) return a > b end)

	local function lowFps(fraction)
		local count = math.max(1, math.floor(#worstFirst * fraction))
		local slow = 0
		for index = 1, count do slow += worstFirst[index] end
		return count / slow
	end

	local stutters = 0
	for _, dt in ipairs(deltas) do
		if dt > 0.05 then stutters += 1 end
	end

	result.avg      = #deltas / total
	result.low1     = lowFps(0.01)
	result.low5     = lowFps(0.05)
	result.worst    = worstFirst[1]
	result.stutters = stutters

	for property, sum in pairs(sums) do
		result.stats[property] = sum / counts[property]
	end

	return result
end

local function statsLine(stats)
	local function ms(property)
		local value = stats[property]
		return value and ("%.2f ms"):format(value * 1000) or "?"
	end
	local function n(property)
		local value = stats[property]
		return value and ("%.0f"):format(value) or "?"
	end
	return ("frame %s | render CPU %s | GPU %s | scripts %s | physics %s | draw calls %s (shadows %s) | triangles %s")
		:format(ms("FrameTime"), ms("RenderCPUFrameTime"), ms("RenderGPUFrameTime"), ms("HeartbeatTime"),
			ms("PhysicsStepTime"), n("SceneDrawcallCount"), n("ShadowsDrawcallCount"), n("SceneTriangleCount"))
end

local function inRoomZero()
	local data = ReplicatedStorage:FindFirstChild("GameData")
	local latest = data and data:FindFirstChild("LatestRoom")
	return latest == nil or latest.Value == 0
end

local safeHere = inRoomZero()

