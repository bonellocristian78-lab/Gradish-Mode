---====== 6. EVERY GRAPHICS LEVEL ======---
--[[ The question that matters most: can this PC run max graphics at all?
     Measured at four levels instead of guessed.

     It sets settings().Rendering.QualityLevel -- the value the engine really
     renders from, and one that is never saved -- and puts yours back after.
     Writing the SAVED setting instead would not change the picture during a
     game at all: the test would measure one level four times and report it
     as four. Each row also records the level the engine reports afterwards,
     so a level that did not take shows up as one.

     Written after every level, so a crash at graphics 10 keeps the rows
     before it. Only in room 0: it means standing still for half a minute. ]]

local rendering = nil
pcall(function() rendering = settings().Rendering end)

local function renderLevelFor(level)
	local maxLevel = 22
	pcall(function() maxLevel = rendering:GetMaxQualityLevel() end)

	local value = 1
	if level > 1 then
		value = math.floor((maxLevel - 1) * level / 10)
		if value == 20 then value = 21 end
	end

	for _, item in ipairs(Enum.QualityLevel:GetEnumItems()) do
		if item.Value == value then return item end
	end
	return nil
end

if not safeHere then
	write("graphics_sweep.txt", "skipped: you were past room 0. Run the dump again in room 0 for this.")
elseif not rendering then
	write("graphics_sweep.txt", "skipped: this executor cannot reach settings().Rendering")
else
	local before = rendering.QualityLevel
	local capText = "?"
	if typeof(getfpscap) == "function" then
		local ok, cap = pcall(getfpscap)
		if ok then capText = tostring(cap) end
	end

	local rows = {
		"your level before the test: " .. tostring(before),
		"fps cap: " .. capText .. "   (at a cap of 60, FPS cannot read higher than 60)",
		"",
	}

	for _, level in ipairs({ 1, 4, 7, 10 }) do
		caption(("DoorsDump: stand still, testing graphics %d"):format(level))

		local target = renderLevelFor(level)
		local set = target ~= nil and pcall(function() rendering.QualityLevel = target end)
		task.wait(2)

		local result = measure(4)
		table.insert(rows, ("graphics %2d  (%s, engine now %s)"):format(
			level, set and "set" or "SET FAILED", tostring(rendering.QualityLevel)))

		if result.avg then
			table.insert(rows, ("    %5.1f FPS avg | 5%% low %5.1f | worst %4.0f ms | stutters %d"):format(
				result.avg, result.low5, result.worst * 1000, result.stutters))
			table.insert(rows, "    " .. statsLine(result.stats))
		else
			table.insert(rows, "    no frames measured")
		end

		write("graphics_sweep.txt", table.concat(rows, "\n"))
	end

	pcall(function() rendering.QualityLevel = before end)
	table.insert(rows, "")
	table.insert(rows, "your level was put back: " .. tostring(rendering.QualityLevel))
	write("graphics_sweep.txt", table.concat(rows, "\n"))
end

---====== 7. INSTANCE TREES ======---

local function attributesOf(instance)
	local ok, attributes = pcall(function() return instance:GetAttributes() end)
	if not ok or next(attributes) == nil then return "" end

	local parts = {}
	for key, value in pairs(attributes) do
		table.insert(parts, key .. "=" .. tostring(value))
	end
	table.sort(parts)

	local text = table.concat(parts, ", ")
	if #text > 200 then text = text:sub(1, 200) .. "..." end
	return "  {" .. text .. "}"
end

local function dumpTree(root, label, maxDepth)
	if not root then return 0 end

	local lines = {}
	local truncated = false

	local function walk(instance, depth)
		if #lines >= SETTINGS.MaxTreeLines then
			truncated = true
			return
		end

		local extra = ""
		if instance:IsA("ValueBase") then
			local value = read(instance, "Value")
			extra = " = " .. tostring(value)
		end

		table.insert(lines, ("  "):rep(depth) .. instance.Name .. "  [" .. instance.ClassName .. "]"
			.. extra .. attributesOf(instance))

		if #lines % 3000 == 0 then task.wait() end

		local children = instance:GetChildren()
		if depth < maxDepth then
			for _, child in ipairs(children) do
				walk(child, depth + 1)
			end
		elseif #children > 0 then
			table.insert(lines, ("  "):rep(depth + 1) .. "... " .. #children .. " more below")
		end
	end

	walk(root, 0)
	if truncated then
		table.insert(lines, "... TRUNCATED at " .. SETTINGS.MaxTreeLines .. " lines")
	end

	write("tree_" .. label .. ".txt", table.concat(lines, "\n"))
	task.wait()
	return #lines
end

do
	local counts = {}
	counts.ReplicatedStorage = dumpTree(ReplicatedStorage, "ReplicatedStorage", SETTINGS.TreeDepth)
	counts.ReplicatedFirst   = dumpTree(ReplicatedFirst, "ReplicatedFirst", SETTINGS.TreeDepth)
	counts.PlayerGui         = dumpTree(LocalPlayer:FindFirstChild("PlayerGui"), "PlayerGui", SETTINGS.TreeDepth)
	counts.PlayerScripts     = dumpTree(LocalPlayer:FindFirstChild("PlayerScripts"), "PlayerScripts", SETTINGS.TreeDepth)
	counts.Lighting          = dumpTree(Lighting, "Lighting", SETTINGS.TreeDepth)
	counts.Character         = dumpTree(LocalPlayer.Character, "Character", 6)
	counts.CurrentRooms      = dumpTree(Workspace:FindFirstChild("CurrentRooms"), "CurrentRooms", 5)

	-- The rest of Workspace, shallow: entities that are out right now show up
	-- here as top-level models, and that is where their names are.
	local shallow = {}
	for _, child in ipairs(Workspace:GetChildren()) do
		table.insert(shallow, child.Name .. "  [" .. child.ClassName .. "]" .. attributesOf(child))
	end
	write("tree_Workspace_top.txt", table.concat(shallow, "\n"))

	local summary = {}
	for name, count in pairs(counts) do
		table.insert(summary, name .. " " .. count)
	end
	print("[DoorsDump] tree lines: " .. table.concat(summary, ", "))
end

---====== 8. MODULE SOURCES ======---

local function isEngineInternal(instance)
	local ok, full = pcall(function() return instance:GetFullName() end)
	if not ok then return false end
	-- Roblox's own core scripts. The last non-DOORS dump was 22,000 of them,
	-- and none of it is the game.
	return full:match("^CoreGui") ~= nil or full:match("^CorePackages") ~= nil
		or full:match("^RobloxReplicatedStorage") ~= nil
end

local function collectScripts()
	local seen, list = {}, {}

	local function add(instance)
		if not instance or seen[instance] then return end
		if not (instance:IsA("ModuleScript") or instance:IsA("LocalScript")) then return end
		if isEngineInternal(instance) then return end
		seen[instance] = true
		table.insert(list, instance)
	end

	for _, root in ipairs({
		ReplicatedStorage, ReplicatedFirst,
		LocalPlayer:FindFirstChild("PlayerGui"), LocalPlayer:FindFirstChild("PlayerScripts"),
		LocalPlayer.Character,
	}) do
		if root then
			for _, d in ipairs(root:GetDescendants()) do add(d) end
		end
	end

	--[[ Modules the game required and then un-parented. DOORS keeps some of
	     its logic in modules that no longer sit anywhere in the tree, and
	     this is the only way to reach those. ]]
	if typeof(getloadedmodules) == "function" then
		local ok, loaded = pcall(getloadedmodules)
		if ok and type(loaded) == "table" then
			for _, module in ipairs(loaded) do add(module) end
		end
	end

	return list
end

do
	local scripts = collectScripts()
	local index = {}
	local decompiled, failed = 0, 0
	local canDecompile = SETTINGS.DecompileModules and typeof(decompile) == "function"

	--[[ Decompiling can hold the game for a second per script on a native
	     decompiler. Past room 0 that is a frozen player next to whatever is
	     coming, so outside room 0 the scripts are only listed. ]]
	if canDecompile and not safeHere then
		canDecompile = false
		caption("DoorsDump: scripts only listed -- run it again in room 0 to decompile them")
	end

	caption(("DoorsDump: %s %d scripts"):format(canDecompile and "decompiling" or "listing", #scripts))

	for position, script in ipairs(scripts) do
		local full = script:GetFullName()
		local status = "listed"

		if canDecompile then
			local ok, source = pcall(decompile, script)

			if ok and type(source) == "string" and #source > 0 then
				-- Windows paths top out near 260 characters, and a DOORS
				-- module path can be longer than that on its own.
				local safe = full:gsub("[^%w%._%-]", "_")
				if #safe > 120 then safe = safe:sub(1, 120) end

				write(("modules/%04d_%s.lua"):format(position, safe),
					"-- " .. script.ClassName .. "  " .. full .. "\n" .. source)
				decompiled += 1
				status = "ok"
			else
				failed += 1
				status = "FAILED"
			end

			task.wait()   -- after every script, so one slow one never stacks on the next
			if position % 50 == 0 then
				caption(("DoorsDump: %d / %d scripts"):format(position, #scripts))
			end
		end

		table.insert(index, ("%04d  %-7s %-12s %s"):format(position, status, script.ClassName, full))
	end

	write("modules/_index.txt", table.concat(index, "\n"))
	print(("[DoorsDump] scripts: %d found, %d decompiled, %d failed"):format(#scripts, decompiled, failed))
end

