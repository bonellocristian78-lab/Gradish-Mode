---====== 5. WHAT EACH ROOM COSTS ======---

local LIGHT_CLASSES = { PointLight = true, SpotLight = true, SurfaceLight = true }

local function census(root)
	local c = {
		instances = 0, parts = 0, meshParts = 0, castShadow = 0, small2 = 0, small4 = 0,
		lights = 0, shadowLights = 0, particles = 0, particleRate = 0,
		beams = 0, trails = 0, decals = 0, textures = 0, surfaceAppearance = 0,
		highlights = 0, sounds = 0, guis = 0,
	}

	for _, d in ipairs(root:GetDescendants()) do
		c.instances += 1

		-- The whole Workspace can be tens of thousands of instances; hand a
		-- frame back now and then so the game does not freeze.
		if c.instances % 4000 == 0 then task.wait() end

		if d:IsA("BasePart") then
			c.parts += 1
			if d:IsA("MeshPart") then c.meshParts += 1 end
			if d.CastShadow then
				c.castShadow += 1
				-- The same two sizes DoorsBoost cuts at: 2 studs in its
				-- Quality preset, 4 in Smooth.
				local longest = math.max(d.Size.X, d.Size.Y, d.Size.Z)
				if longest < 2 then c.small2 += 1 end
				if longest < 4 then c.small4 += 1 end
			end
		elseif LIGHT_CLASSES[d.ClassName] then
			c.lights += 1
			if d.Shadows then c.shadowLights += 1 end
		elseif d:IsA("ParticleEmitter") then
			c.particles += 1
			c.particleRate += d.Rate
		elseif d:IsA("Beam") then
			c.beams += 1
		elseif d:IsA("Trail") then
			c.trails += 1
		elseif d:IsA("Texture") then       -- before Decal: Texture IS a Decal
			c.textures += 1
		elseif d:IsA("Decal") then
			c.decals += 1
		elseif d:IsA("SurfaceAppearance") then
			c.surfaceAppearance += 1
		elseif d:IsA("Highlight") then
			c.highlights += 1
		elseif d:IsA("Sound") then
			c.sounds += 1
		elseif d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
			c.guis += 1
		end
	end

	return c
end

local function censusLine(label, c)
	line("%-24s inst %6d | parts %5d mesh %4d | casters %5d (<2: %4d, <4: %4d) | lights %3d shadowed %3d | particles %3d rate %5.0f | beams %3d trails %3d | decals %4d tex %4d | SA %3d | HL %2d | sounds %3d | guis %3d",
		label, c.instances, c.parts, c.meshParts, c.castShadow, c.small2, c.small4,
		c.lights, c.shadowLights, c.particles, c.particleRate, c.beams, c.trails,
		c.decals, c.textures, c.surfaceAppearance, c.highlights, c.sounds, c.guis)
end

head("COST CENSUS")
