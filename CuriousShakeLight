--[[
================================================================================

        C U R I O U S   S H A K E   L I G H T

        DOORS' Shakelight, from the Admin Panel, in the Curious Light's yellow:
        its glass, its switch, its light and its sparkles yellow, its own icon.
        It is DOORS' own: its animations, its shaking, its light are DOORS'.

        Shake it a few times (4 shakes, close together) and it is charged with
        the Curious Light: where you walk with it in your hand it leaves a
        trail of yellow light on the floor, glowing and fading. Shake it again
        to keep it charged.

            loadstring(game:HttpGet("https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/claude/sei-qui-con-noi-ye4k62/CuriousShakeLight"))()

        Without DOORS' Admin Panel (the Hotel-, or a run without the pass):
        DOORS' flashlight from the Curious Door's kit, in yellow, made here
        (only for you), shaken by its own animation.
        The Curious Door gives it too, from its chest.

================================================================================
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer
local GENV = if getgenv then getgenv() else _G

local TITLE = "Curious Shake Light"
local YELLOW = Color3.fromRGB(255, 214, 60)
local GLASS = Color3.fromRGB(255, 226, 70)
local NEON = Color3.fromRGB(255, 236, 120)
local LIGHT = Color3.fromRGB(255, 222, 110)
local TRAIL = { shakes = 4, within = 6, lasts = 25, step = 1.6, fade = 18, most = 90 } -- (shakes in `within` s charge it for `lasts` s)

local function make(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do i[k] = v end
	i.Parent = parent
	return i
end
local function caption(text)
	print("[" .. TITLE .. "] " .. text)
	pcall(function() require(LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game).caption(text, true) end)
end

-- One at a time: running it again takes the old one's trail and watch away
if type(GENV.__CuriousShakeLightStop) == "function" then pcall(GENV.__CuriousShakeLightStop) end
local connections, alive = {}, true
local function on(signal, fn)
	local c = signal:Connect(fn)
	table.insert(connections, c)
	return c
end

---====== DOORS' ADMIN PANEL: it gives the Shakelight ======---

local remotes = ReplicatedStorage:FindFirstChild("RemotesFolder")
local runCommand = remotes and remotes:FindFirstChild("AdminPanelRunCommand")
local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
local isAdmin = (tonumber(LocalPlayer:GetAttribute("ServerAdmin")) or 0) >= 1 or (playerGui ~= nil and playerGui:FindFirstChild("DoorsAdmin") ~= nil)
local LOCAL = not (runCommand and isAdmin) -- (no Admin Panel: DOORS' flashlight from the kit, made here)
local ME = { [LocalPlayer.Name] = LocalPlayer.Name }

local FOLDER = "CuriousDoor" -- (the executor's folder, the Curious Door's: its kit and its icons kept there)
local ICONS = FOLDER .. "/Icons"
local REPO = "https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/claude/sei-qui-con-noi-ye4k62/"
-- The Curious Door's kit (fetched once, kept in its folder): its pieces by name
local function kit()
	local here = FOLDER .. "/CuriousKit.rbxm"
	local out = {}
	pcall(function()
		if not isfolder(FOLDER) then makefolder(FOLDER) end
		if not (isfile(here) and readfile(here):sub(1, 8) == "<roblox!") then
			local data = game:HttpGet(REPO .. "assets/curious/CuriousKit.rbxm")
			if type(data) == "string" and data:sub(1, 8) == "<roblox!" then writefile(here, data) end
		end
		local root = game:GetObjects(getcustomasset(here))[1]
		for _, d in ipairs(root:GetDescendants()) do -- (nothing of DOORS' own systems on our copies)
			for name in pairs(d:GetAttributes()) do d:SetAttribute(name, nil) end
			for _, tag in ipairs(d:GetTags()) do d:RemoveTag(tag) end
			if d:IsA("ProximityPrompt") or d:IsA("LuaSourceContainer") then d:Destroy() end
		end
		for _, m in ipairs(root:GetChildren()) do out[m.Name] = m end
	end)
	return out
end
---====== ITS ICON: the item's own (the Admin Panel's), recoloured: pixel by pixel where the game lets its pixels be read
---====== (EditableImage: each pixel to the colour of its light, kept in the executor's folder), else tinted by DOORS' own
---====== hotbar (its ScannerColor) ======---

local PNG = {}
do
	local CRC = {}
	for n = 0, 255 do
		local c = n
		for _ = 1, 8 do c = if bit32.band(c, 1) == 1 then bit32.bxor(0xEDB88320, bit32.rshift(c, 1)) else bit32.rshift(c, 1) end
		CRC[n] = c
	end
	local function crc32(s)
		local c = 0xFFFFFFFF
		for i = 1, #s do c = bit32.bxor(CRC[bit32.band(bit32.bxor(c, string.byte(s, i)), 0xFF)], bit32.rshift(c, 8)) end
		return bit32.bxor(c, 0xFFFFFFFF)
	end
	local function u32(n) return string.char(bit32.band(bit32.rshift(n, 24), 255), bit32.band(bit32.rshift(n, 16), 255), bit32.band(bit32.rshift(n, 8), 255), bit32.band(n, 255)) end
	local function chunk(kind, data) return u32(#data) .. kind .. data .. u32(crc32(kind .. data)) end
	-- Rows of RGBA (each after its filter byte) as a PNG: stored, not packed, inside zlib
	function PNG.encode(w, h, raw)
		local a, b = 1, 0
		for i = 1, #raw do
			a = (a + string.byte(raw, i)) % 65521
			b = (b + a) % 65521
		end
		local parts, at = { "\120\1" }, 1
		while at <= #raw do
			local piece = raw:sub(at, at + 65534)
			at += #piece
			local last = if at > #raw then 1 else 0
			table.insert(parts, string.char(last, #piece % 256, math.floor(#piece / 256), 255 - #piece % 256, 255 - math.floor(#piece / 256)) .. piece)
		end
		table.insert(parts, u32(b * 65536 + a))
		return "\137PNG\r\n\26\n" .. chunk("IHDR", u32(w) .. u32(h) .. "\8\6\0\0\0") .. chunk("IDAT", table.concat(parts)) .. chunk("IEND", "")
	end
end
-- Its light (0 dark, 1 bright) to a colour: { light, r, g, b } in order
local RAMPS = {
	gold = { { 0, 52, 28, 4 }, { 0.3, 150, 92, 14 }, { 0.62, 238, 184, 58 }, { 0.85, 255, 228, 130 }, { 1, 255, 250, 214 } },
	yellow = { { 0, 66, 42, 0 }, { 0.3, 190, 128, 6 }, { 0.62, 255, 206, 46 }, { 0.85, 255, 236, 120 }, { 1, 255, 252, 220 } },
}
local TINTS = { gold = Color3.fromRGB(255, 204, 92), yellow = Color3.fromRGB(255, 228, 96) }
local function rampAt(stops, l)
	for i = 2, #stops do
		local a, b = stops[i - 1], stops[i]
		if l <= b[1] then
			local u = (l - a[1]) / (b[1] - a[1])
			return math.floor(a[2] + (b[2] - a[2]) * u + 0.5), math.floor(a[3] + (b[3] - a[3]) * u + 0.5), math.floor(a[4] + (b[4] - a[4]) * u + 0.5)
		end
	end
	local last = stops[#stops]
	return last[2], last[3], last[4]
end
-- The icon `id` recoloured with `ramp`, as a file (made once): its path, or nil where its pixels cannot be read
local function recoloured(id, name, ramp)
	local path = ICONS .. "/" .. name .. ".png"
	pcall(function()
		if isfile(path) then return end
		local AssetService = game:GetService("AssetService")
		local ok, image = pcall(function() return AssetService:CreateEditableImageAsync(Content.fromUri(id)) end)
		if not (ok and image) then image = AssetService:CreateEditableImageAsync(id) end
		local w, h = image.Size.X, image.Size.Y
		local pixels = image:ReadPixelsBuffer(Vector2.new(0, 0), image.Size)
		local rows = table.create(h)
		for y = 0, h - 1 do
			local row = table.create(w + 1)
			row[1] = "\0"
			for x = 0, w - 1 do
				local at = (y * w + x) * 4
				local r, g, b = buffer.readu8(pixels, at), buffer.readu8(pixels, at + 1), buffer.readu8(pixels, at + 2)
				local nr, ng, nb = rampAt(RAMPS[ramp], (0.299 * r + 0.587 * g + 0.114 * b) / 255)
				row[x + 2] = string.char(nr, ng, nb, buffer.readu8(pixels, at + 3))
			end
			rows[y + 1] = table.concat(row)
		end
		pcall(function() image:Destroy() end)
		if not isfolder(FOLDER) then makefolder(FOLDER) end
		if not isfolder(ICONS) then makefolder(ICONS) end
		writefile(path, PNG.encode(w, h, table.concat(rows)))
	end)
	local ok, asset = pcall(function() return isfile(path) and getcustomasset(path) end)
	return if ok and type(asset) == "string" then asset else nil
end
-- The tool's icon: the Admin Panel's own for `item`, in `ramp`'s colour (at once DOORS' tint, then, if it can be made, its
-- recoloured copy)
local function recolourIcon(tool, item, ramp)
	local id = nil
	pcall(function() id = LocalPlayer.PlayerGui.DoorsAdmin.AdminPanel.Items[item]:GetAttribute("Image") end)
	if type(id) ~= "string" or id == "" then id = tool.TextureId end
	if id and id ~= "" then tool.TextureId = id end
	tool:SetAttribute("ScannerColor", TINTS[ramp])
	if not id or id == "" then return end
	task.spawn(function()
		local made = recoloured(id, item .. "_" .. ramp .. "_" .. (id:match("%d+") or "0"), ramp)
		if made and tool.Parent then
			tool.TextureId = made
			tool:SetAttribute("ScannerColor", nil)
		end
	end)
end

-- The tool the Admin Panel is about to give you: the first new one named for it (or, failing that, any new one)
local function arriving(stem)
	local known = {}
	local function places()
		local out = { LocalPlayer:FindFirstChildOfClass("Backpack") }
		if LocalPlayer.Character then table.insert(out, LocalPlayer.Character) end
		return out
	end
	for _, place in ipairs(places()) do
		for _, t in ipairs(place:GetChildren()) do known[t] = true end
	end
	local since = os.clock()
	return function()
		local other = nil
		for _, place in ipairs(places()) do
			for _, t in ipairs(place:GetChildren()) do
				if t:IsA("Tool") and not known[t] then
					if t.Name:lower():find(stem, 1, true) then return t end
					other = other or t
				end
			end
		end
		return if os.clock() - since > 3 then other else nil
	end
end

---====== ITS LOOK: yellow (its glass yellow, its metal amber, what glows yellow), its own icon in yellow ======---

local function curious(tool)
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 1 then
			if d:IsA("MeshPart") then pcall(function() d.TextureID = "" end) end
			if d.Material == Enum.Material.Neon then
				d.Color = NEON
			elseif d.Material == Enum.Material.Glass or d.Material == Enum.Material.Ice or d.Transparency > 0.2 then
				d.Color = GLASS
			else
				local _, s, v = d.Color:ToHSV() -- (its own light and dark, in amber)
				d.Color = Color3.fromHSV(0.11, math.clamp(0.75 + s * 0.25, 0, 1), math.clamp(0.35 + v * 0.65, 0, 1))
			end
		elseif d:IsA("SurfaceAppearance") then
			d:Destroy()
		elseif d:IsA("Light") then
			d.Color = LIGHT
		elseif d:IsA("ParticleEmitter") then
			d.Color = ColorSequence.new(YELLOW)
		elseif d:IsA("Beam") then
			d.Color = ColorSequence.new(YELLOW)
		end
	end
	local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart", true)
	if handle then -- the Curious Light's glow on it, and its sparkles
		make("PointLight", { Name = "CuriousGlow", Color = LIGHT, Brightness = 0.6, Range = 5, Shadows = false }, handle)
		make("ParticleEmitter", { Name = "CuriousSparkles", Texture = "rbxassetid://2581223252", Color = ColorSequence.new(YELLOW), LightEmission = 1,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12), NumberSequenceKeypoint.new(1, 0) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
			Lifetime = NumberRange.new(0.6, 1.2), Rate = 6, Speed = NumberRange.new(0.2, 0.6), SpreadAngle = Vector2.new(180, 180) }, handle)
	end
	tool:SetAttribute("NameSingular", TITLE)
	tool:SetAttribute("NamePlural", TITLE .. "s")
	tool.ToolTip = TITLE
	recolourIcon(tool, "Shakelight", "yellow") -- (its own icon, the Admin Panel's, in yellow)
	return handle
end

---====== ITS TRAIL: shaken enough, it leaves the Curious Light where you walk ======---

local folder = make("Folder", { Name = "CuriousTrail" }, workspace)
local marks = {}
local probe = RaycastParams.new()
probe.FilterType = Enum.RaycastFilterType.Exclude

local function sparkles(parent, rate)
	return make("ParticleEmitter", { Name = "Sparkles", Texture = "rbxassetid://2581223252", Color = ColorSequence.new(YELLOW), LightEmission = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.18), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) }),
		Lifetime = NumberRange.new(1.5, 3), Rate = rate, Speed = NumberRange.new(0.3, 0.9), SpreadAngle = Vector2.new(25, 25),
		Acceleration = Vector3.new(0, 0.6, 0), EmissionDirection = Enum.NormalId.Right }, parent)
end
-- A mark of light on the floor at `at`: it glows, then fades away
local function mark(at, n)
	local disc = make("Part", { Name = "CuriousMark", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.05, 1.3, 1.3),
		CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.pi / 2), Material = Enum.Material.Neon, Color = YELLOW, Transparency = 0.3,
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false }, folder)
	local glow = if n % 3 == 0 then make("PointLight", { Name = "Glow", Color = LIGHT, Brightness = 1.2, Range = 8, Shadows = false }, disc) else nil
	local emitter = if n % 2 == 0 then sparkles(disc, 3) else nil
	table.insert(marks, disc)
	while #marks > TRAIL.most do
		local old = table.remove(marks, 1)
		pcall(function() old:Destroy() end)
	end
	local fade = TweenInfo.new(TRAIL.fade, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
	TweenService:Create(disc, fade, { Transparency = 1 }):Play()
	if glow then TweenService:Create(glow, fade, { Brightness = 0 }):Play() end
	task.delay(TRAIL.fade * 0.6, function()
		if emitter and emitter.Parent then emitter.Rate = 0 end
	end)
	task.delay(TRAIL.fade + 3, function()
		local i = table.find(marks, disc)
		if i then table.remove(marks, i) end
		disc:Destroy()
	end)
end

---====== GIVE IT ======---

local tool = nil
if LOCAL then -- DOORS' flashlight from the kit, into your backpack (DOORS' hotbar shows it; held on its own animations)
	local KIT = kit()
	if not KIT.Flashlight then
		caption("Il kit della Curious Door non si è caricato: riprova.")
		folder:Destroy()
		return
	end
	tool = KIT.Flashlight:Clone()
	tool.Name = "Shakelight"
	tool.TextureId = "rbxassetid://121351942740185" -- (DOORS' Shakelight's own icon)
	tool.CanBeDropped = false
	local seen = false
	for _, f in ipairs(tool:GetChildren()) do -- (one Animations folder)
		if f.Name == "Animations" then
			if seen then f:Destroy() end
			seen = true
		end
	end
	for _, p in ipairs(tool:GetDescendants()) do
		if p:IsA("BasePart") then p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, false, true end
	end
	local neon = tool.Handle:FindFirstChild("Neon") -- (its light: lit, always)
	if neon then neon.Transparency = 0 end
	tool.Parent = LocalPlayer:FindFirstChildOfClass("Backpack")
else
	local poll = arriving("shake")
	runCommand:FireServer("Give Items", { Players = ME, Items = { Shakelight = "Shakelight" } })
	local deadline = os.clock() + 10
	repeat
		task.wait(0.1)
		tool = poll()
	until tool or os.clock() > deadline or not alive
	if not tool then
		caption("Il Pannello Admin non ha dato la Shakelight: riprova.")
		folder:Destroy()
		return
	end
end
local handle = curious(tool)

local shakes, chargedUntil, count = {}, 0, 0
local lastAt = nil
-- Charged: its lights flare, a shimmer
local function flare()
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("Light") then
			local was = d.Brightness
			d.Brightness = was * 2.5 + 1
			TweenService:Create(d, TweenInfo.new(0.8), { Brightness = was }):Play()
		end
	end
	if handle then
		local s = make("Sound", { Name = "CuriousShimmer", SoundId = "rbxassetid://9125986239", Volume = 0.6 }, handle)
		s:Play()
		task.delay(4, function() s:Destroy() end)
		local burst = sparkles(handle, 0)
		pcall(function() burst:Emit(25) end)
		task.delay(3, function() burst:Destroy() end)
	end
end
-- Made here, it shakes itself: DOORS' flashlight's relight in your hand, a rattle, its light flickering (DOORS' own
-- Shakelight does all this itself); it lights while in your hand
local relight = nil
local function shakeIt()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	local anim = tool:FindFirstChild("Animations") and tool.Animations:FindFirstChild("relight")
	pcall(function()
		if not relight and animator and anim then relight = animator:LoadAnimation(anim) end
		relight:Play(0.05, 1, 1.6)
	end)
	local sound = handle and (handle:FindFirstChild("sound_flick") or handle:FindFirstChild("sound_flicker"))
	if sound then pcall(function() sound:Play() end) end
	local grip, t0 = tool.Grip, os.clock()
	local jiggle
	jiggle = on(RunService.RenderStepped, function()
		local t = os.clock() - t0
		if t > 0.32 or tool.Parent ~= LocalPlayer.Character then
			jiggle:Disconnect()
			tool.Grip = grip
			return
		end
		local k = math.sin(t / 0.32 * math.pi)
		tool.Grip = grip * CFrame.new(0, math.sin(t * 70) * 0.12 * k, 0) * CFrame.Angles(math.sin(t * 55) * 0.35 * k, 0, 0)
	end)
end
if LOCAL then
	on(tool.Equipped, function()
		for _, d in ipairs(tool:GetDescendants()) do
			if d:IsA("Light") then d.Enabled = true end
		end
	end)
end
on(tool.Activated, function() -- (a shake)
	if LOCAL then shakeIt() end
	local now = os.clock()
	table.insert(shakes, now)
	while shakes[1] and now - shakes[1] > TRAIL.within do table.remove(shakes, 1) end
	if #shakes >= TRAIL.shakes then
		if chargedUntil < now then flare() end
		chargedUntil = now + TRAIL.lasts
	end
end)
on(RunService.Heartbeat, function()
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if os.clock() >= chargedUntil or not root or tool.Parent ~= character then
		lastAt = nil
		return
	end
	local at = root.Position
	if lastAt and ((at - lastAt) * Vector3.new(1, 0, 1)).Magnitude < TRAIL.step then return end
	probe.FilterDescendantsInstances = { character, folder }
	local hit = workspace:Raycast(at, Vector3.new(0, -6, 0), probe)
	if not hit then return end
	lastAt = at
	count += 1
	mark(hit.Position + Vector3.new(0, 0.03, 0), count)
end)
on(tool.AncestryChanged, function()
	if not tool.Parent then chargedUntil = 0 end
end)

GENV.__CuriousShakeLightStop = function()
	alive = false
	for _, c in ipairs(connections) do c:Disconnect() end
	pcall(function() folder:Destroy() end)
	if LOCAL then pcall(function() tool:Destroy() end) end
end
