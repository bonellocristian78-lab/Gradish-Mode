local W = {}
local probe = RaycastParams.new()
probe.FilterType = Enum.RaycastFilterType.Exclude
function W.cast(from, direction)
	probe.FilterDescendantsInstances = { folder, LocalPlayer.Character }
	return workspace:Raycast(from, direction, probe)
end
function W.latest()
	local data = ReplicatedStorage:FindFirstChild("GameData")
	local latest = data and data:FindFirstChild("LatestRoom")
	return latest and latest.Value or nil
end
function W.rooms()
	local folderOf = workspace:FindFirstChild("CurrentRooms")
	if not folderOf then return nil end
	local list = {}
	for _, r in ipairs(folderOf:GetChildren()) do
		if tonumber(r.Name) then table.insert(list, r) end
	end
	table.sort(list, function(a, b) return tonumber(a.Name) < tonumber(b.Name) end)
	return if #list > 0 then list else nil
end
function W.room(n)
	local folderOf = workspace:FindFirstChild("CurrentRooms")
	return folderOf and folderOf:FindFirstChild(tostring(n)) or nil
end
-- Where it floats over a point: 4 studs over the floor under it
function W.over(p)
	local hit = W.cast(p + Vector3.new(0, 5, 0), Vector3.new(0, -30, 0))
	return (hit and hit.Position or p) + Vector3.new(0, 4, 0)
end
-- The way through a room: its entrance, its nodes, its exit
function W.points(room)
	local pts = {}
	local entrance, exit = room:FindFirstChild("RoomEntrance"), room:FindFirstChild("RoomExit")
	if entrance and entrance:IsA("BasePart") then table.insert(pts, entrance.Position) end
	local nodes = room:FindFirstChild("PathfindNodes") or room:FindFirstChild("Nodes")
	if nodes then
		local list = {}
		for _, n in ipairs(nodes:GetChildren()) do
			if n:IsA("BasePart") then table.insert(list, n) end
		end
		table.sort(list, function(a, b) return (tonumber(a.Name) or 0) < (tonumber(b.Name) or 0) end)
		for _, n in ipairs(list) do table.insert(pts, n.Position) end
	end
	if exit and exit:IsA("BasePart") then table.insert(pts, exit.Position) end
	if #pts == 0 then table.insert(pts, room:GetPivot().Position) end
	for i, p in ipairs(pts) do pts[i] = W.over(p) end
	return pts
end
-- The middle of a room
function W.center(room)
	local pts = W.points(room)
	return pts[math.max(1, math.ceil(#pts / 2))]
end
-- The rooms loaded: the lowest (the lobby, as far as this goes), yours, the highest
function W.span()
	local list = W.rooms()
	if not list then return nil end
	local lo, hi = tonumber(list[1].Name), tonumber(list[#list].Name)
	local here = math.clamp(W.latest() or hi, lo, hi)
	return lo, here, hi
end
-- From room a to room b (either way), through each room on the way; `center`: it stops in the middle of b
function W.route(a, b, center)
	local pts = {}
	local step = if a <= b then 1 else -1
	for n = a, b, step do
		local room = W.room(n)
		if room then
			local list = W.points(room)
			if step < 0 then
				local back = {}
				for i = #list, 1, -1 do table.insert(back, list[i]) end
				list = back
			end
			if center and n == b then
				for i = 1, math.max(1, math.ceil(#list / 2)) do table.insert(pts, list[i]) end
			else
				for _, p in ipairs(list) do table.insert(pts, p) end
			end
		end
	end
	return pts
end
-- Outside DOORS: a straight line through you, along your look
function W.line(towardYou, length)
	local _, _, root = P.body()
	local camera = workspace.CurrentCamera
	local at = root and root.Position or camera.CFrame.Position
	local look = camera.CFrame.LookVector * Vector3.new(1, 0, 1)
	look = if look.Magnitude > 0.01 then look.Unit else Vector3.new(0, 0, -1)
	local far = at - look * (length or 220)
	local near = at + look * 30
	if towardYou then return { far, near } end
	return { near + look * 10, far }
end
-- The hiding places of a room of a kind ("locker", "table", "all"), nearest to `from` first
local TABLES = { "Bed", "Table", "Desk", "Cot", "Bench" }
local HIDES = { "Wardrobe", "Locker", "Closet", "Cabinet", "HidingSpot", "Toolshed", "Fridge", "Bed", "Table", "Desk", "Cot", "Bench" }
function W.kindOf(name)
	for _, word in ipairs(TABLES) do
		if name:find(word) then return "table" end
	end
	return "locker"
end
function W.isHiding(model)
	if not model:IsA("Model") or model:IsDescendantOf(folder) then return false end
	for _, word in ipairs(HIDES) do
		if model.Name:find(word) then return true end
	end
	return false
end
function W.spots(room, kind, from)
	local list = {}
	for _, d in ipairs(room and room:GetDescendants() or {}) do
		if W.isHiding(d) and (kind == "all" or W.kindOf(d.Name) == kind) and not (d.Parent and W.isHiding(d.Parent)) then
			table.insert(list, d)
		end
	end
	if from then
		table.sort(list, function(a, b) return (a:GetPivot().Position - from).Magnitude < (b:GetPivot().Position - from).Magnitude end)
	end
	return list
end
-- The hiding place you are in, or nil
function W.yourSpot()
	local _, _, root = P.body()
	if not root or not P.hiding() then return nil end
	local best, bestDistance = nil, 12
	for _, room in ipairs(W.rooms() or {}) do
		for _, d in ipairs(W.spots(room, "all")) do
			local distance = (d:GetPivot().Position - root.Position).Magnitude
			if distance < bestDistance then best, bestDistance = d, distance end
		end
	end
	return best
end

