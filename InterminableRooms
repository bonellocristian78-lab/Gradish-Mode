local HURT = {}
-- DOORS' death screen: "You died to ...", and the wiki's tips
function HURT.deathScreen(e)
	local spec = e.spec
	pcall(function()
		local stats = ReplicatedStorage.GameStats["Player_" .. LocalPlayer.Name].Total
		stats.DeathCause.Value = e.name
	end)
	if not firesignal then return end
	local hints = { "You died to " .. e.name .. "." }
	for _, h in ipairs(spec.h or {}) do table.insert(hints, h) end
	if #hints == 1 and spec.b then table.insert(hints, spec.b) end
	task.spawn(function()
		pcall(function()
			local deathScreen = LocalPlayer.PlayerGui.MainUI:FindFirstChild("Death")
			if not deathScreen then return end
			if not deathScreen.Visible then deathScreen:GetPropertyChangedSignal("Visible"):Wait() end
			firesignal(ReplicatedStorage.RemotesFolder.DeathHint.OnClientEvent, hints, "Blue")
		end)
	end)
end
function HURT.kill(e)
	local _, humanoid = P.body()
	if not humanoid then return end
	HURT.deathScreen(e)
	humanoid.Health = 0
end
function HURT.kick(e)
	if CONFIG.Kick then
		LocalPlayer:Kick(("You were kicked by %s."):format(e.name))
	else
		HURT.kill(e)
	end
end
-- `amount` of your health; at 0 it is its jumpscare and your death
function HURT.damage(e, amount)
	local _, humanoid = P.body()
	if not humanoid or amount <= 0 then return end
	if humanoid.Health - amount <= 0 then
		e.struck = true
		FX.jumpscare(e, function() HURT.kill(e) end)
		return
	end
	humanoid.Health -= amount
	FX.flash(e.color, 0.4)
	FX.shake(4)
	FX.once(e.sounds.hit, e.part, { Volume = CONFIG.Volume })
end
-- It caught you: whatever its damage is
function HURT.strike(e)
	if e.struck or not P.body() then return end
	local now = os.clock()
	if now < (e.cooldown or 0) then return end
	local d = e.spec.d
	if d == "kill" or d == "kill+kick" then
		e.struck = true
		FX.jumpscare(e, function()
			HURT.kill(e)
			if d == "kill+kick" and CONFIG.Kick then task.delay(1.5, function() LocalPlayer:Kick(("You were kicked by %s."):format(e.name)) end) end
		end)
	elseif d == "kick" then
		e.struck = true
		FX.jumpscare(e, function() HURT.kick(e) end)
	elseif d == "half" then
		local _, humanoid = P.body()
		e.cooldown = now + 1.5
		HURT.damage(e, humanoid.Health * 0.5)
	elseif d == "one" then
		local _, humanoid = P.body()
		e.cooldown = now + 3
		humanoid.Health = math.min(humanoid.Health, 1)
		FX.flash(e.color, 0.7)
		FX.once(e.sounds.jump or e.sounds.hit, SoundService)
	elseif type(d) == "number" or type(d) == "table" then
		e.cooldown = now + 0.8
		HURT.damage(e, between(d, 10))
	end
end

