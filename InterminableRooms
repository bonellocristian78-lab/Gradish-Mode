local Entity = {}
Entity.__index = Entity
local live = {} -- this run's
local MODES = {}

function Entity.new(name, opts)
	opts = opts or {}
	local spec = ENTITIES[name]
	local self = setmetatable({ name = name, spec = spec, alive = true, mult = 1, scale = opts.scale or 1, born = os.clock(), owned = {} }, Entity)
	self.rainbow = spec.c == "rainbow"
	self.color = rgb(spec.c)
	self.sounds = {}
	for role, f in pairs(spec.s or {}) do
		if type(f) == "table" then
			self.sounds[role] = {}
			for _, x in ipairs(f) do table.insert(self.sounds[role], asset(x)) end
		else
			self.sounds[role] = asset(f)
		end
	end
	if type(self.sounds.speak) == "table" then self.speak, self.sounds.speak = self.sounds.speak, nil end
	local size = 7 * self.scale
	self.part = make("Part", { Name = name, Size = Vector3.new(2, 2, 2), Transparency = 1, Anchored = true, CanCollide = false, CanTouch = false,
		CanQuery = false, CastShadow = false, CFrame = CFrame.new(0, -5000, 0) }, folder)
	self.gui = make("BillboardGui", { Size = UDim2.fromScale(size * FX.aspect(spec), size), LightInfluence = 0, MaxDistance = 2000,
		Brightness = 1.4 }, self.part)
	self.image = make("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit,
		ImageTransparency = if has(spec, "ghost") then 1 else 0 }, self.gui)
	FX.picture(self.image, spec)
	if not spec.img then -- no picture on the wiki: its name, in its colour
		make("TextLabel", { Size = UDim2.fromScale(1, 0.4), Position = UDim2.fromScale(0, 0.3), BackgroundTransparency = 1, Text = name,
			TextScaled = true, Font = Enum.Font.Arcade, TextColor3 = self.color, TextStrokeTransparency = 0 }, self.gui)
	end
	self.light = make("PointLight", { Color = self.color, Range = 26 * math.max(self.scale, 0.6), Brightness = 2.5, Shadows = false }, self.part)
	local loud = if has(spec, "loud") then 1.7 else 1
	self.amb = FX.sound(self.sounds.amb, self.part, { Looped = true, Volume = CONFIG.Volume * 1.6 * loud, RollOffMinDistance = 18,
		RollOffMaxDistance = 420 })
	self.far = FX.sound(self.sounds.far, SoundService, { Looped = true, Volume = 0 })
	SESSION.live += 1
	table.insert(live, self)
	return self
end
function Entity:at(p)
	self.position = p
	self.part.CFrame = CFrame.new(p)
end
function Entity:spawnAt(p)
	self:at(p)
	if self.amb then self.amb:Play() end
	if self.far then self.far:Play() end
	FX.once(self.sounds.spawn, SoundService, { Volume = CONFIG.Volume * 1.3 })
end
-- Gone: its despawn sound, it fades
function Entity:remove()
	if not self.alive then return end
	self.alive = false
	SESSION.live = math.max(0, SESSION.live - 1)
	FX.once(self.sounds.despawn, SoundService)
	if self.far then self.far:Destroy() end
	for _, o in ipairs(self.owned) do pcall(function() o:Destroy() end) end
	local part = self.part
	TweenService:Create(self.image, TweenInfo.new(0.5), { ImageTransparency = 1 }):Play()
	TweenService:Create(self.light, TweenInfo.new(0.5), { Brightness = 0 }):Play()
	if self.amb then TweenService:Create(self.amb, TweenInfo.new(0.5), { Volume = 0 }):Play() end
	task.delay(0.6, function() part:Destroy() end)
end
function Entity:own(instance)
	table.insert(self.owned, instance)
	return instance
end
-- How far you are (math.huge: no you)
function Entity:distance()
	local _, _, root = P.body()
	if not root or not self.position then return math.huge end
	return (root.Position - self.position).Magnitude
end
-- You are in its sight, `reach` studs from where it went this frame (from -> to), nothing in between
function Entity:sees(from, to, reach)
	local character, _, root = P.body()
	if not root then return false end
	local p = root.Position
	local seg = to - from
	local len2 = seg:Dot(seg)
	local t = if len2 > 0 then math.clamp((p - from):Dot(seg) / len2, 0, 1) else 0
	local closest = from + seg * t
	if (p - closest).Magnitude > reach then return false end
	local hit = W.cast(closest, p - closest)
	return not hit or hit.Instance:IsDescendantOf(character)
end
-- It catches you if it can: hidden, you are safe, unless it ignores that ("nohide") or only goes for the hidden ("hiders")
function Entity:catch(from, to, reach)
	if self.struck or not self.alive then return end
	local spec = self.spec
	local hidden = P.hiding()
	if has(spec, "hiders") then
		if not hidden then return end
	elseif hidden and not has(spec, "nohide") then
		return
	end
	if self:sees(from, to, reach or self:reach()) then HURT.strike(self) end
end
function Entity:reach()
	return 12 + math.min((self.spec.v or 0) / 60, 10) * self.scale
end
-- How fast now: its speed (or its speeding up), times what its rebounds added, at most MaxSpeed
function Entity:speed()
	local spec = self.spec
	local v = spec.v or 60
	if spec.a then
		local u = math.clamp((os.clock() - self.born) / 8, 0, 1)
		v = spec.a[1] + (spec.a[2] - spec.a[1]) * u
	end
	return math.clamp(v * self.mult * (self.boost or 1), 4, CONFIG.MaxSpeed)
end
function Entity:wait(seconds)
	local t0 = os.clock()
	while self.alive and os.clock() - t0 < seconds do
		local dt = RunService.Heartbeat:Wait()
		if self.runner and self.position then self:catch(self.position, self.position, self:reach() * 0.7) end -- (a runner idling)
		if self.onWait then self.onWait(dt) end
	end
	return self.alive
end
-- Along a list of points at its speed, catching you on the way. False when it is gone
function Entity:travel(pts, opts)
	opts = opts or {}
	local spec = self.spec
	if #pts == 0 then return self.alive end
	if not self.position then self:at(pts[1]) end
	local i = 1
	local pause, burst, glitchAt = 0, os.clock(), 0
	while self.alive and pts[i] do
		local dt = RunService.Heartbeat:Wait()
		if self.struck then return false end
		local from = self.position
		local budget = self:speed() * dt
		if has(spec, "steps") then -- in intervals: a burst, a stop
			local phase = (os.clock() - burst) % 1
			budget = if phase < 0.35 then budget * 2.6 else 0
		end
		if has(spec, "laggy") and os.clock() > glitchAt then
			glitchAt = os.clock() + 0.25
			if math.random() < 0.3 then pause = os.clock() + 0.18 end
		end
		if os.clock() < pause then budget = 0 end
		if has(spec, "jitter") and math.random() < 0.004 then -- back a little, every so often
			i = math.max(1, i - 2)
		end
		if has(spec, "stray") then -- off its way, after you, while it sees you
			local _, _, root = P.body()
			if root and not P.hiding() and self:distance() < 45 and self:sees(from, from, 45) then
				local to = root.Position - from
				if to.Magnitude > 1 then self:at(from + to.Unit * math.min(budget, to.Magnitude)) end
				budget = 0
			end
		end
		while budget > 0 and pts[i] do
			local to = pts[i] - self.position
			if to.Magnitude <= budget then
				budget -= to.Magnitude
				self:at(pts[i])
				i += 1
			else
				self:at(self.position + to.Unit * budget)
				budget = 0
			end
		end
		self:catch(from, self.position)
		if opts.each then
			if opts.each(dt) == false then return self.alive end
		end
	end
	return self.alive
end

---====== THE SHARED LOOP: its face moving, its colour, you feeling it near ======---

local loop
loop = RunService.Heartbeat:Connect(function()
	local t = os.clock()
	local nearest, nearestColor, shakeIt = math.huge, nil, false
	for i = #live, 1, -1 do
		local e = live[i]
		if not e.alive then
			table.remove(live, i)
		else
			FX.frame(e.image, e.spec, t - e.born)
			if e.spec.fc then e.image.Position = UDim2.fromScale(rnd(0.03), rnd(0.03)) end
			if e.rainbow then
				e.color = Color3.fromHSV((t * 0.4) % 1, 0.9, 1)
				e.light.Color = e.color
			end
			local d = e:distance()
			if e.far then e.far.Volume = CONFIG.Volume * math.clamp((d - 60) / 200, 0, 1) end
			if d < nearest and not has(e.spec, "ghost") then nearest, nearestColor = d, e.color end
			if d < 70 and ((e.spec.v or 0) >= 300 or has(e.spec, "shake")) then shakeIt = true end
		end
	end
	local k = if nearestColor then math.clamp(1 - nearest / 90, 0, 1) else 0
	tint.Enabled = k > 0
	if k > 0 then tint.TintColor = Color3.new(1, 1, 1):Lerp(nearestColor, k * 0.4) end
	if shakeIt and (SESSION.shakeAt or 0) < t then
		SESSION.shakeAt = t + 0.3
		FX.shake(2 + k * 5)
	end
end)

---====== WHAT IT DOES: THE RUNNERS ======---

local spawnEntity -- (summons)

-- At your room: the hiding places of a kind, one by one. Hidden in the one it checks, you die. `breaks`: it breaks them
function MODES.checkSpots(e, kind, breaks)
	local room = W.room(W.latest() or -1)
	if not room then return true end
	local spots = W.spots(room, kind, e.position)
	for _, spot in ipairs(spots) do
		if not e.alive or e.struck then return false end
		local pivot = spot:GetPivot()
		local front = W.over(pivot.Position + pivot.LookVector * 3.5)
		if not e:travel({ front }) then return false end
		if not e:wait(if breaks then 0.25 else 0.4) then return false end
		FX.once(e.sounds.brk or e.sounds.step, e.part)
		task.spawn(function() -- it shakes
			for _ = 1, 6 do
				spot:PivotTo(pivot * CFrame.new(rnd(0.15), 0, rnd(0.15)))
				task.wait(0.04)
			end
			spot:PivotTo(pivot)
		end)
		if W.yourSpot() == spot and not breaks then
			HURT.strike(e)
			return false
		end
		if breaks then MODES.breakSpot(e, spot) end
	end
	return true
end
-- A hiding place gone: see-through, its prompts off ("lock": only for a while), a few pieces flying
function MODES.breakSpot(e, spot)
	local locking = has(e.spec, "lock")
	for _, d in ipairs(spot:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			d.Enabled = false
			if locking then task.delay(15, function() d.Enabled = true end) end
		elseif d:IsA("BasePart") and not locking then
			d.LocalTransparencyModifier = 0.85
		end
	end
	if locking then return end
	for _ = 1, 5 do
		local p = make("Part", { Size = Vector3.new(0.6, 0.6, 0.6) * (0.5 + math.random()), Color = Color3.fromRGB(70, 60, 55), Anchored = false,
			CanCollide = false, CanQuery = false, CFrame = spot:GetPivot() * CFrame.new(rnd(1), 2 + rnd(1), rnd(1)) }, folder)
		p.AssemblyLinearVelocity = Vector3.new(rnd(25), 20 + math.random() * 15, rnd(25))
		task.delay(3, function() p:Destroy() end)
	end
end
-- What it does where it stops: minions, a thief's grab, an explosion
function MODES.minions(e)
	local sm = e.spec.sm
	if type(sm) == "table" and sm[1] then
		task.spawn(spawnEntity, pick(sm), { scale = 0.8 })
	elseif type(sm) == "table" and sm.self then
		for _ = 1, between(sm.count, 3) do task.spawn(spawnEntity, e.name, { scale = 0.45, minion = true, at = e.position }) end
	else
		task.spawn(spawnEntity, e.name, { scale = 0.45, minion = true, at = e.position })
	end
end
function MODES.explode(e, radius)
	FX.once(e.sounds.boom or e.sounds.jump, SoundService, { Volume = CONFIG.Volume * 1.5 })
	local ball = make("Part", { Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), Material = Enum.Material.Neon, Color = e.color,
		Anchored = true, CanCollide = false, CanQuery = false, CFrame = CFrame.new(e.position), Transparency = 0.2 }, folder)
	TweenService:Create(ball, TweenInfo.new(0.5), { Size = Vector3.one * radius * 2, Transparency = 1 }):Play()
	task.delay(0.6, function() ball:Destroy() end)
	FX.flash(e.color, 0.7)
	FX.shake(12)
	if e:distance() < radius and not P.hiding() then
		local d = e.spec.d
		if d == 0 or d == nil then e.spec = table.clone(e.spec); e.spec.d = "kill" end
		HURT.strike(e)
	end
end
-- A ball of its colour thrown at you; it hurts what it hits (`blast`: it bursts where it lands, a moment later)
function MODES.throw(e, blast)
	local _, _, root = P.body()
	if not root or not e.position then return end
	local from, target = e.position, root.Position
	local ball = make("Part", { Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), Material = Enum.Material.Neon, Color = e.color,
		Anchored = true, CanCollide = false, CanQuery = false, CFrame = CFrame.new(from) }, folder)
	FX.once(e.sounds.hit or e.sounds.step, ball)
	task.spawn(function()
		local dir = (target - from)
		local t0, time = os.clock(), math.max(dir.Magnitude / 70, 0.2)
		while os.clock() - t0 < time and ball.Parent do
			local u = (os.clock() - t0) / time
			ball.CFrame = CFrame.new(from + dir * u + Vector3.new(0, math.sin(u * math.pi) * (if blast then 8 else 1.5), 0))
			local _, _, r = P.body()
			if not blast and r and (r.Position - ball.Position).Magnitude < 3.2 and e.alive then
				HURT.damage(e, between(type(e.spec.d) == "number" and e.spec.d or { 5, 15 }, 10))
				break
			end
			RunService.Heartbeat:Wait()
		end
		if blast and ball.Parent then
			task.wait(1.2)
			local _, _, r = P.body()
			FX.once(e.sounds.boom, ball)
			if r and (r.Position - ball.Position).Magnitude < 10 and not P.hiding() then HURT.damage(e, math.random(10, 40)) end
		end
		ball:Destroy()
	end)
end
-- Its name, gliding across your screen (V-15) while it is close
function MODES.glide(e, leftToRight)
	local label = make("TextLabel", { Size = UDim2.fromScale(0.5, 0.12), BackgroundTransparency = 1, Text = e.name, TextScaled = true,
		Font = Enum.Font.Arcade, TextColor3 = e.color, TextStrokeTransparency = 0.3, ZIndex = 3,
		Position = UDim2.fromScale(if leftToRight then -0.5 else 1, 0.2 + math.random() * 0.5) }, overlay)
	TweenService:Create(label, TweenInfo.new(2.4, Enum.EasingStyle.Linear), { Position = UDim2.fromScale(if leftToRight then 1 else -0.5,
		label.Position.Y.Scale) }):Play()
	task.delay(2.5, function() label:Destroy() end)
end
-- Your screen, covered with it (AN-55)
function MODES.cover(e, seconds)
	local cover = make("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Tile,
		TileSize = UDim2.fromOffset(160, 160), ZIndex = 4 }, overlay)
	FX.picture(cover, e.spec)
	task.delay(seconds, function()
		TweenService:Create(cover, TweenInfo.new(0.6), { ImageTransparency = 1 }):Play()
		task.delay(0.7, function() cover:Destroy() end)
	end)
end
-- A thief: to you, it takes one of your items, and runs; catch it and you have it back
function MODES.steal(e)
	local _, _, root = P.body()
	if not root then return end
	local t0 = os.clock()
	while e.alive and os.clock() - t0 < 6 and e:distance() > 4 do
		local dt = RunService.Heartbeat:Wait()
		local to = root.Position - e.position
		if to.Magnitude > 0.1 then e:at(e.position + to.Unit * math.min(to.Magnitude, 40 * dt)) end
	end
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	local tools = backpack and backpack:GetChildren() or {}
	if #tools == 0 or e:distance() > 4 then return end
	local tool = pick(tools)
	tool.Parent = nil
	table.insert(SESSION.stolen, tool)
	FX.once(e.sounds.scream or e.sounds.hit, e.part)
	e.loot = tool
end
-- The way to your room (`toYou`) or away from it, to the lobby, from the room it is in (it remembers where it ends)
function MODES.leg(e, toYou, center)
	local lo, here = W.span()
	if not lo then return W.line(toYou) end
	local from = math.clamp(e.roomAt or (if toYou then lo else here), lo, here)
	e.roomAt = if toYou then here else lo
	return W.route(from, e.roomAt, center)
end

function MODES.rush(e)
	local spec = e.spec
	e.runner = true
	local lo, here, hi = W.span()
	local reverse = spec.rv == true
	local start = lo
	if lo then
		if spec.st == "ahead" then start = hi elseif spec.st == "here" then start = here elseif spec.st == "behind" then start = math.max(lo, here - 3) end
	end
	e.roomAt = start
	-- Where it shows up, and the way it goes
	local path
	if not lo then
		path = W.line(not reverse)
	elseif reverse then
		path = W.route(start, lo)
	elseif start == here and spec.st == "here" then
		path = { W.center(W.room(here)) }
	else
		path = W.route(start, here, spec.i ~= nil or spec.ck ~= nil or spec.sk ~= nil)
	end
	if #path == 0 then return end
	e:spawnAt(path[1])
	FX.flicker(1.5)
	if has(spec, "toast") then MODES.cover(e, 3.5) end
	-- Before it sets off: far ones a moment (the sound comes first), the ones in your room a few seconds
	if not e:wait(if spec.st == "here" or has(spec, "wait") then 3 else CONFIG.Delay) then return end
	local textAt = 0
	local looked = false
	local function each()
		if has(spec, "text") and os.clock() > textAt and e:distance() < 160 then
			textAt = os.clock() + 1.6
			MODES.glide(e, has(spec, "lefttext"))
		end
		if has(spec, "shoot") and math.random() < 0.02 then MODES.throw(e, true) end
		if has(spec, "zap") and math.random() < 0.03 then FX.flash(Color3.new(1, 1, 1), 0.5) end
		if has(spec, "enrage") and not e.boost and e:distance() < 60 and not P.hiding() and e:sees(e.position, e.position, 60) then
			e.boost = 2.2 -- it saw you: much faster, for half a minute
			FX.once(e.sounds.scream, e.part)
			task.delay(30, function() e.boost = nil end)
		end
		if has(spec, "look") and not looked and e:distance() < 90 then -- you look at it: its horn, and it rushes back
			local camera = workspace.CurrentCamera
			local to = e.position - camera.CFrame.Position
			if to.Magnitude > 0 and camera.CFrame.LookVector:Dot(to.Unit) > 0.93 then
				looked = true
				FX.once(e.sounds.scream or e.sounds.spawn, e.part)
				return false
			end
		end
		return true
	end
	if not e:travel(path, { each = each }) then return end
	if lo then e.roomAt = if reverse then lo else here end
	if looked then
		e:travel(MODES.leg(e, false))
		return
	end
	-- Where it stopped (your room, or the lobby for the ones going back)
	local function arrived()
		if spec.ck and not MODES.checkSpots(e, spec.ck, false) then return false end
		if spec.br and not MODES.checkSpots(e, spec.br, true) then return false end
		if has(spec, "thief") then MODES.steal(e) end
		if has(spec, "minions") then MODES.minions(e) end
		if spec.i and not e:wait(spec.i) then return false end
		return e.alive
	end
	if not reverse and not arrived() then return end
	if spec.sk then -- down into the floor
		local base = e.position
		local t0 = os.clock()
		while e.alive and os.clock() - t0 < 1.5 do
			RunService.Heartbeat:Wait()
			e:at(base - Vector3.new(0, (os.clock() - t0) / 1.5 * 9, 0))
		end
		return
	end
	if spec.by then -- on, past your room, the way it was going
		local dir = (path[#path] - (path[#path - 1] or path[1]))
		dir = if dir.Magnitude > 0.1 then dir.Unit else Vector3.new(0, 0, -1)
		e:travel({ e.position + dir * e:speed() * spec.by })
	end
	-- Rebounds: back to the lobby, to your room again..., faster each time
	local toYou = reverse
	for _ = 1, between(spec.r, 0) do
		if not e.alive then return end
		e.mult *= (spec.u or 1)
		FX.once(e.sounds.rebound or e.sounds.spawn, SoundService, { Volume = CONFIG.Volume * 0.8 })
		FX.flicker(0.8)
		if not e:travel(MODES.leg(e, toYou, toYou and (spec.ck ~= nil))) then return end
		if toYou and spec.ck and not MODES.checkSpots(e, spec.ck, false) then return end
		if toYou and has(spec, "minions") then MODES.minions(e) end
		toYou = not toYou
	end
	if spec.bk and not toYou then
		if not e:travel(MODES.leg(e, false)) then return end
	end
	if has(spec, "fake") then -- gone... and back
		e.image.Visible, e.light.Enabled = false, false
		if e.amb then e.amb.Volume = 0 end
		if not e:wait(5 + math.random() * 3) then return end
		e.image.Visible, e.light.Enabled = true, true
		if e.amb then e.amb.Volume = CONFIG.Volume * 1.6 end
		FX.once(e.sounds.spawn, SoundService)
		e.position = nil
		e.roomAt = nil
		e:travel(MODES.leg(e, true))
	end
	if has(spec, "explode") then MODES.explode(e, 26) end
	if e.loot then -- it got away with it
		e.loot = nil
	end
end

---====== THE ONES IN YOUR ROOM ======---

-- Somewhere in your room (outside DOORS: in front of you)
function MODES.inRoom(which)
	local here = W.latest()
	local room = here and W.room(here)
	if room then
		local pts = W.points(room)
		if which == "door" then
			local exit = room:FindFirstChild("RoomExit")
			local middle = pts[math.max(1, math.ceil(#pts / 2))]
			if exit and exit:IsA("BasePart") then
				local inward = (middle - exit.Position) * Vector3.new(1, 0, 1)
				return W.over(exit.Position + (if inward.Magnitude > 0.1 then inward.Unit * 5 else Vector3.zero)), pts
			end
			return pts[#pts], pts
		elseif which == "random" then
			return pick(pts), pts
		elseif which == "corner" then
			local _, _, root = P.body()
			local best, far = pts[1], -1
			for _, p in ipairs(pts) do
				local d = root and (p - root.Position).Magnitude or 0
				if d > far then best, far = p, d end
			end
			return best, pts
		end
		return pts[math.max(1, math.ceil(#pts / 2))], pts
	end
	local line = W.line(false, 60)
	return line[1], { line[1], line[1] + Vector3.new(12, 0, 0), line[1] + Vector3.new(-12, 0, 6), line[1] + Vector3.new(0, 0, 12) }
end

function MODES.stand(e)
	local spec = e.spec
	local at = MODES.inRoom(if has(spec, "guard") then "door" else "center")
	e:spawnAt(at)
	local life = spec.du or 10
	local t0 = os.clock()
	local restore = {}
	if has(spec, "scream") then -- so loud nothing else can be heard
		FX.once(e.sounds.scream or e.sounds.amb, SoundService, { Volume = CONFIG.Volume * 1.8, Looped = true })
		for _, s in ipairs(workspace:GetDescendants()) do
			if s:IsA("Sound") and not s:IsDescendantOf(folder) and s.Volume > 0 then
				restore[s] = s.Volume
				s.Volume *= 0.12
			end
		end
	end
	if has(spec, "flash") then
		task.spawn(FX.jumpscare, e)
		life = math.min(life, 0.9)
	end
	if has(spec, "heal") then -- E-50: click it for 8 health
		local prompt = make("ProximityPrompt", { ActionText = "Take", ObjectText = e.name, HoldDuration = 0, MaxActivationDistance = 12,
			RequiresLineOfSight = false }, e.part)
		prompt.Triggered:Connect(function()
			local _, humanoid = P.body()
			if humanoid then humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 8) end
			if e.spec.d == "one" then HURT.strike(e) end
			FX.once(e.sounds.hit or e.sounds.spawn, SoundService)
			e:remove()
		end)
	end
	local docile = has(spec, "docile")
	if docile then e.image.ImageColor3 = Color3.fromRGB(140, 200, 255) end
	local hiddenSince = nil
	local base = e.position
	while e.alive and os.clock() - t0 < life do
		local dt = RunService.Heartbeat:Wait()
		local _, humanoid, root = P.body()
		local u = (os.clock() - t0) / life
		if has(spec, "grow") then e.gui.Size = UDim2.fromScale(7 * (1 + u * 3), 7 * (1 + u * 3)) end
		if has(spec, "dance") then e:at(base + Vector3.new(0, math.abs(math.sin(os.clock() * 6)) * 2, 0)) end
		if has(spec, "kicker") and humanoid and root then -- A-0, the anticheat: too fast, and out
			if humanoid.WalkSpeed > 26 or (root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude > 45 then HURT.strike(e) end
		end
		if has(spec, "guard") and root and (root.Position - e.position).Magnitude < 9 then
			if docile then -- A-404, angered: red, at you
				docile = false
				e.image.ImageColor3 = Color3.fromRGB(255, 60, 60)
				e.light.Color = Color3.fromRGB(255, 40, 40)
				FX.once(e.sounds.jump or e.sounds.spawn, SoundService)
			end
			HURT.strike(e)
		end
		if has(spec, "camper") or has(spec, "mimic") then -- the ones that punish hiding too long
			if P.hiding() then
				hiddenSince = hiddenSince or os.clock()
				if os.clock() - hiddenSince > (if has(spec, "mimic") then 3 else 20) then HURT.strike(e) end
			else
				hiddenSince = nil
			end
		end
		if (has(spec, "touchkill") or spec.d == "kill") and not has(spec, "guard") and not has(spec, "kicker") then
			e:catch(e.position, e.position, 5)
		end
		if e.speak and math.random() < dt / 4 then FX.once(pick(e.speak), e.part) end
	end
	for s, v in pairs(restore) do pcall(function() s.Volume = v end) end
	if has(spec, "explode") then MODES.explode(e, 25) end
end

function MODES.wander(e)
	local spec = e.spec
	local at, pts = MODES.inRoom("random")
	if e.minionAt then at = e.minionAt end
	e:spawnAt(at)
	local life = spec.du or 40
	local speed = math.clamp(spec.v or 16, 6, 60)
	local t0 = os.clock()
	local target, nextShot, nextCharge = pick(pts), os.clock() + 3, os.clock() + 6 + math.random() * 4
	local charging = 0
	while e.alive and os.clock() - t0 < life do
		local dt = RunService.Heartbeat:Wait()
		local _, _, root = P.body()
		local goal = target
		local v = speed
		if os.clock() < charging and root then goal, v = root.Position, speed * 4 end
		local to = (goal - e.position) * Vector3.new(1, 0, 1)
		if to.Magnitude < 1.5 then
			target = pick(pts)
		else
			e:at(e.position + to.Unit * math.min(to.Magnitude, v * dt))
		end
		if has(spec, "jitter") and math.random() < 0.02 then target = pick(pts) end
		if has(spec, "charge") and os.clock() > nextCharge then
			nextCharge = os.clock() + 6 + math.random() * 5
			charging = os.clock() + 1
			FX.once(e.sounds.scream or e.sounds.hit, e.part)
		end
		if has(spec, "shoot") and os.clock() > nextShot then
			nextShot = os.clock() + 2.5 + math.random() * 2
			if not P.hiding() then MODES.throw(e, false) end
		end
		-- Close to it: it kicks you away, it hurts (E-1: only with your light on it; Noah: only the hidden)
		if e:distance() < 5.5 * math.max(e.scale, 0.6) and os.clock() > (e.kickedAt or 0) then
			local touch = has(spec, "touch") or spec.d == "kill" or (type(spec.d) == "number" and spec.d > 0) or type(spec.d) == "table"
			if touch and (not has(spec, "flashlight") or P.holdingLight()) then
				if has(spec, "hiders") then
					if P.hiding() then HURT.strike(e) end
				elseif not P.hiding() then
					e.kickedAt = os.clock() + 0.8
					HURT.strike(e)
					if root then
						local away = (root.Position - e.position) * Vector3.new(1, 0, 1)
						away = if away.Magnitude > 0.1 then away.Unit else Vector3.new(1, 0, 0)
						root.AssemblyLinearVelocity += away * 40 + Vector3.new(0, 18, 0)
						FX.once(e.sounds.hit, e.part)
					end
				end
			end
		end
		if e.speak and math.random() < dt / 5 then FX.once(pick(e.speak), e.part) end
	end
	if has(spec, "explode") then MODES.explode(e, 22) end
end

function MODES.chase(e)
	local spec = e.spec
	local at = MODES.inRoom("corner")
	e:spawnAt(at)
	if not e:wait(1.5) then return end
	local life = spec.du or 25
	local speed = math.clamp(spec.v or 30, 8, 120)
	local friend = has(spec, "friend")
	local t0, lostAt = os.clock(), nil
	while e.alive and os.clock() - t0 < life do
		local dt = RunService.Heartbeat:Wait()
		local _, _, root = P.body()
		if not root then break end
		if P.hiding() and not friend then
			lostAt = lostAt or os.clock()
			if os.clock() - lostAt > 3 then break end
		else
			lostAt = nil
			local to = (root.Position - e.position)
			local keep = if friend then 5 else 0
			if to.Magnitude > keep + 0.5 then e:at(e.position + to.Unit * math.min(to.Magnitude - keep, speed * dt)) end
			if not friend and to.Magnitude < 4.5 then
				if has(spec, "sendback") then -- back to the room before
					local here = W.latest()
					local before = here and W.room(here - 1)
					if before then root.CFrame = CFrame.new(W.center(before)) end
					FX.flash(e.color, 0.8)
					break
				elseif has(spec, "thief") then
					MODES.steal(e)
					break
				end
				HURT.strike(e)
			end
		end
	end
	e:travel({ e.position + Vector3.new(rnd(40), 0, rnd(40)) })
end

function MODES.hop(e)
	local spec = e.spec
	local at = MODES.inRoom("random")
	e:spawnAt(at)
	local life = spec.du or 12
	local t0 = os.clock()
	while e.alive and os.clock() - t0 < life do
		local _, _, root = P.body()
		local goal = if root and not P.hiding() then root.Position else e.position + Vector3.new(rnd(12), 0, rnd(12))
		local from = e.position
		local to = (goal - from) * Vector3.new(1, 0, 1)
		local reach = math.min(to.Magnitude, (spec.v or 30) * 0.55)
		local land = W.over(from + (if to.Magnitude > 0.1 then to.Unit * reach else Vector3.zero))
		local h0 = os.clock()
		while e.alive and os.clock() - h0 < 0.5 do
			RunService.Heartbeat:Wait()
			local u = (os.clock() - h0) / 0.5
			e:at(from:Lerp(land, u) + Vector3.new(0, math.sin(u * math.pi) * 6, 0))
		end
		FX.once(e.sounds.step, e.part)
		if e:distance() < 5 and not P.hiding() then HURT.strike(e) end
		if not e:wait(0.15) then return end
	end
end

function MODES.orbit(e)
	local _, _, root = P.body()
	if not root then return end
	local angle = math.random() * math.pi * 2
	e:spawnAt(root.Position + Vector3.new(math.cos(angle), 0, math.sin(angle)) * 40)
	local t0 = os.clock()
	while e.alive do
		local dt = RunService.Heartbeat:Wait()
		local _, _, r = P.body()
		if not r then return end
		local u = (os.clock() - t0) / 14
		local radius = 40 * (1 - u)
		angle += dt * (1.5 + u * 3)
		e:at(r.Position + Vector3.new(math.cos(angle) * radius, 1, math.sin(angle) * radius))
		if radius < 3 then
			if not P.hiding() then HURT.strike(e) end
			return
		end
	end
end

function MODES.lurk(e)
	local spec = e.spec
	e:spawnAt(MODES.inRoom("corner"))
	e.image.ImageTransparency = 0.55
	e.light.Brightness = 0.6
	local t0 = os.clock()
	while e.alive and os.clock() - t0 < (spec.du or 30) do
		RunService.Heartbeat:Wait()
		if e:distance() < 12 and not P.hiding() then -- too close: it lunges
			e.image.ImageTransparency = 0
			FX.once(e.sounds.scream or e.sounds.jump, e.part)
			local _, _, root = P.body()
			if root then e:travel({ root.Position }) end
			HURT.strike(e)
			return
		end
	end
end

function MODES.ceiling(e)
	for _ = 1, 3 do
		local _, _, root = P.body()
		if not root or not e.alive then return end
		local above = W.cast(root.Position, Vector3.new(0, 40, 0))
		local top = above and above.Position - Vector3.new(0, 2, 0) or root.Position + Vector3.new(0, 14, 0)
		local target = root.Position
		e:spawnAt(top)
		e.image.ImageTransparency = 0.9
		FX.once(e.sounds.step or e.sounds.amb or e.sounds.spawn, e.part, { Volume = CONFIG.Volume * 1.6 }) -- the cue: move
		if not e:wait(1.4) then return end
		e.image.ImageTransparency = 0
		local t0 = os.clock()
		while e.alive and os.clock() - t0 < 0.25 do
			RunService.Heartbeat:Wait()
			e:at(top:Lerp(target, (os.clock() - t0) / 0.25))
		end
		local _, _, r = P.body()
		if r and (r.Position - target).Magnitude < 6 and not P.hiding() then
			HURT.strike(e)
			return
		end
		FX.shake(5)
		if not e:wait(2.5) then return end
	end
end

function MODES.wall(e)
	local here = W.latest()
	local room = here and W.room(here)
	local center = MODES.inRoom("center")
	local right = Vector3.new(1, 0, 0)
	if room then
		local entrance, exit = room:FindFirstChild("RoomEntrance"), room:FindFirstChild("RoomExit")
		if entrance and exit then
			local forward = (exit.Position - entrance.Position) * Vector3.new(1, 0, 1)
			if forward.Magnitude > 0.1 then right = forward.Unit:Cross(Vector3.yAxis) end
		end
	end
	if math.random() < 0.5 then right = -right end
	e.gui.Size = UDim2.fromScale(16, 16)
	local width = 30
	e:spawnAt(center - right * width)
	e:travel({ center + right * width }, { each = function()
		e:catch(e.position, e.position, 9)
		return true
	end })
end

---====== ON YOUR SCREEN ======---

function MODES.screen(e)
	local spec = e.spec
	e:spawnAt(Vector3.new(0, -5000, 0))
	local button = make("ImageButton", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.22, 0.22), BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.2 + math.random() * 0.6, 0.2 + math.random() * 0.6), ZIndex = 5, ScaleType = Enum.ScaleType.Fit,
		AutoButtonColor = false }, overlay)
	e:own(button)
	make("UIAspectRatioConstraint", { AspectRatio = FX.aspect(spec) }, button)
	FX.picture(button, spec)
	local clicks = between(spec.cl, 1)
	local count = 0
	FX.once(e.sounds.spawn or e.sounds.amb, SoundService)
	if e.amb then e.amb.Parent = SoundService; e.amb:Play() end
	button.MouseButton1Click:Connect(function()
		if clicks <= 0 then return end
		count += 1
		FX.once(e.sounds.hit or e.sounds.step, SoundService)
		button.Size = UDim2.fromScale(0.25, 0.25)
		TweenService:Create(button, TweenInfo.new(0.15), { Size = UDim2.fromScale(0.22, 0.22) }):Play()
		button.Position = UDim2.fromScale(0.2 + math.random() * 0.6, 0.2 + math.random() * 0.6)
		if count >= clicks then
			if has(spec, "bite") then HURT.strike(e) end
			if has(spec, "clone") and math.random() < 0.5 then
				task.spawn(spawnEntity, e.name, {})
			end
			e:remove()
		end
	end)
	local t0 = os.clock()
	local life = spec.du or (if clicks > 0 then 60 else 8)
	if has(spec, "still") then -- Trollface-90: stop moving, or it gets you
		if not e:wait(1) then return end
		local _, _, root = P.body()
		local look = workspace.CurrentCamera.CFrame.LookVector
		local t1 = os.clock()
		while e.alive and os.clock() - t1 < 1.4 do
			RunService.Heartbeat:Wait()
			local _, _, r = P.body()
			local moved = r and root and (r.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude > 2
			local turned = workspace.CurrentCamera.CFrame.LookVector:Dot(look) < 0.985
			if moved or turned then
				HURT.strike(e)
				break
			end
		end
		return
	end
	while e.alive and os.clock() - t0 < life do
		RunService.Heartbeat:Wait()
		FX.frame(button, spec, os.clock())
	end
end

---====== THE ONES THAT CALL OTHERS ======---

function MODES.summon(e)
	local spec = e.spec
	e:spawnAt(MODES.inRoom("center"))
	local sm = spec.sm or {}
	local names = {}
	if sm.names then
		names = sm.names
	elseif sm.prefix then
		for name, s in pairs(ENTITIES) do
			if name:sub(1, #sm.prefix) == sm.prefix and s.m ~= "summon" then table.insert(names, name) end
		end
	elseif sm.color then -- A-300: it turns a colour, and an entity of that colour comes
		local colors = {}
		for _, s in pairs(ENTITIES) do
			if type(s.c) == "table" and s.m == "rush" then table.insert(colors, s.c) end
		end
		local c = pick(colors)
		local t0 = os.clock()
		while e.alive and os.clock() - t0 < 3 do
			RunService.Heartbeat:Wait()
			local shown = Color3.fromHSV((os.clock() * 1.5) % 1, 0.9, 1)
			e.image.ImageColor3, e.light.Color = shown, shown
		end
		e.image.ImageColor3, e.light.Color = rgb(c), rgb(c)
		for name, s in pairs(ENTITIES) do
			if type(s.c) == "table" and s.c[1] == c[1] and s.c[2] == c[2] and s.c[3] == c[3] and s.m == "rush" then table.insert(names, name) end
		end
	end
	if not e:wait(2) then return end
	FX.once(e.sounds.scream or e.sounds.spawn, SoundService)
	for _ = 1, between(sm.count, 1) do
		if #names > 0 then task.spawn(spawnEntity, pick(names), {}) end
	end
	e:wait(1)
end

function MODES.order(e)
	e:spawnAt(MODES.inRoom("center"))
	local cc = make("ColorCorrectionEffect", { Saturation = -1, Contrast = 0.2 }, Lighting)
	e:own(cc)
	local word = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.fromScale(0.6, 0.15),
		BackgroundTransparency = 1, TextScaled = true, Font = Enum.Font.Arcade, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0,
		ZIndex = 6 }, overlay)
	e:own(word)
	for _ = 1, 4 do
		local hide = math.random() < 0.5
		word.Text = if hide then "HIDE" else "DON'T HIDE"
		FX.once(e.sounds.spawn or e.sounds.amb, SoundService)
		if not e:wait(5) then return end
		if P.hiding() ~= hide then
			HURT.strike(e)
			return
		end
		word.Text = ""
		if not e:wait(2) then return end
	end
end

function MODES.sign(e)
	e:spawnAt(MODES.inRoom("random"))
	local note = make("BillboardGui", { Size = UDim2.fromScale(10, 4), StudsOffset = Vector3.new(0, 6, 0), LightInfluence = 0, MaxDistance = 60 }, e.part)
	make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(40, 30, 25), BackgroundTransparency = 0.2,
		TextColor3 = Color3.fromRGB(255, 222, 189), TextScaled = true, Font = Enum.Font.Oswald, TextWrapped = true,
		Text = e.spec.b or e.name }, note)
	e:wait(e.spec.du or 25)
end

---====== SPAWNING ======---

local MAX_LIVE = 14
function spawnEntity(name, opts)
	opts = opts or {}
	if not ENTITIES[name] or SESSION.live >= MAX_LIVE then return end
	prepare(ENTITIES[name])
	local e = Entity.new(name, opts)
	e.minionAt = opts.at
	local mode = MODES[e.spec.m] or MODES.rush
	if opts.minion then mode = MODES.wander end
	local ok, err = pcall(mode, e)
	if not ok then warn("[InterminableRooms] " .. name .. ": " .. tostring(err)) end
	if e.alive then e:remove() end
end

