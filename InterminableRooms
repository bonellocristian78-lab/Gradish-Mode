local MAGIC = { mp3 = { "ID3", "\255\251", "\255\243", "\255\242" }, png = { "\137PNG" } }
local function valid(name, data)
	if type(data) ~= "string" or #data < 16 then return false end
	for _, start in ipairs(MAGIC[name:match("%.(%w+)$")] or {}) do
		if data:sub(1, #start) == start then return true end
	end
	return false
end
-- A content ID for one of its files, or nil (no executor support, no internet)
local function asset(name)
	if type(name) ~= "string" then return nil end
	local path = CONFIG.Folder .. "/" .. name
	if SESSION.assets[path] then return SESSION.assets[path] end
	pcall(function()
		if not isfolder(CONFIG.Folder) then makefolder(CONFIG.Folder) end
		if isfile(path) and valid(name, readfile(path)) then return end
		local data = game:HttpGet(CONFIG.AssetsUrl .. name)
		if valid(name, data) then writefile(path, data) end -- an error page is never kept
	end)
	local ok, id = pcall(function() return isfile(path) and getcustomasset(path) end)
	if not (ok and type(id) == "string") then return nil end
	SESSION.assets[path] = id
	return id
end
-- All of an entity's files, at once (several at a time)
local function prepare(spec)
	local names = {}
	if spec.img then table.insert(names, spec.img[1]) end
	for _, f in ipairs(spec.fc or {}) do table.insert(names, f) end
	for _, f in pairs(spec.s or {}) do
		if type(f) == "table" then
			for _, x in ipairs(f) do table.insert(names, x) end
		else
			table.insert(names, f)
		end
	end
	local left = #names
	for _, n in ipairs(names) do
		task.spawn(function()
			asset(n)
			left -= 1
		end)
	end
	local t0 = os.clock()
	while left > 0 and os.clock() - t0 < 25 do task.wait(0.05) end
end

