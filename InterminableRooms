local function norm(s) return (tostring(s):lower():gsub("[^%w]", "")) end
local function baseName(name) return (name:gsub("%s*%b()", ""):gsub("%s*#%d+$", "")) end
-- Its name as written on the wiki; else the same letters and digits; else its name without "(IF)", "(Scrapped)"...
-- (the game's own first)
local function find(wanted)
	if ENTITIES[wanted] then return wanted end
	local n = norm(wanted)
	local best = nil
	local function better(a, b)
		local ea, eb = ENTITIES[a], ENTITIES[b]
		if (ea.w == nil) ~= (eb.w == nil) then return ea.w == nil end
		if #a ~= #b then return #a < #b end
		return a < b
	end
	for name in pairs(ENTITIES) do
		if norm(name) == n and (not best or better(name, best)) then best = name end
	end
	if best then return best end
	for name in pairs(ENTITIES) do
		if norm(baseName(name)) == n and (not best or better(name, best)) then best = name end
	end
	return best
end
local function suggestions(wanted)
	local n, list = norm(wanted), {}
	for name in pairs(ENTITIES) do
		local m = norm(name)
		if n ~= "" and (m:find(n, 1, true) or n:find(norm(baseName(name)), 1, true)) then table.insert(list, name) end
	end
	table.sort(list, function(a, b) return #a < #b or (#a == #b and a < b) end)
	return table.concat(list, ", ", 1, math.min(#list, 12))
end

