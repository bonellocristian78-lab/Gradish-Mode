function FX.shake(power)
	if power <= 0 then return end
	if mainGame and mainGame.camShaker then
		pcall(function() mainGame.camShaker:ShakeOnce(power, 14, 0, 0.6) end)
		return
	end
	task.spawn(function() -- outside DOORS: the camera, jolted
		local camera = workspace.CurrentCamera
		for _ = 1, 6 do
			camera.CFrame *= CFrame.Angles(math.rad(rnd(power * 0.15)), math.rad(rnd(power * 0.15)), 0)
			RunService.RenderStepped:Wait()
		end
	end)
end
function FX.flash(color, strength)
	flashFrame.BackgroundColor3 = color
	flashFrame.BackgroundTransparency = 1 - (strength or 0.6)
	TweenService:Create(flashFrame, TweenInfo.new(0.7), { BackgroundTransparency = 1 }):Play()
end
-- DOORS' own flicker of the room's lights (or the lights of the room, off and on)
function FX.flicker(seconds)
	local room = W.room(W.latest() or -1)
	local ok = pcall(function()
		require(ReplicatedStorage.ModulesClient.Module_Events).flicker(room, seconds)
	end)
	if ok or not room then return end
	task.spawn(function()
		local lights = {}
		for _, d in ipairs(room:GetDescendants()) do
			if d:IsA("Light") and d.Enabled then table.insert(lights, d) end
		end
		local t0 = os.clock()
		while os.clock() - t0 < seconds do
			for _, l in ipairs(lights) do l.Enabled = math.random() < 0.5 end
			task.wait(0.07)
		end
		for _, l in ipairs(lights) do l.Enabled = true end
	end)
end
function FX.sound(id, parent, props)
	if not id then return nil end
	local s = make("Sound", { SoundId = id, Volume = CONFIG.Volume }, parent or SoundService)
	for k, v in pairs(props or {}) do s[k] = v end
	return s
end
function FX.once(id, parent, props)
	local s = FX.sound(id, parent, props)
	if not s then return nil end
	s:Play()
	s.Ended:Connect(function() s:Destroy() end)
	task.delay(20, function() if s.Parent then s:Destroy() end end)
	return s
end
-- A picture on a label: still, its GIF (a sheet of frames), or its faces in turn
function FX.picture(label, spec, scale)
	local img = spec.img
	if not img then return end
	label.Image = asset(img[1]) or ""
	if #img == 6 then -- {file, frames, columns, w, h, fps}
		label.ImageRectSize = Vector2.new(img[4], img[5])
	end
end
function FX.frame(label, spec, t)
	local img = spec.img
	if img and #img == 6 then
		local frame = math.floor(t * img[6]) % img[2]
		label.ImageRectOffset = Vector2.new((frame % img[3]) * img[4], math.floor(frame / img[3]) * img[5])
	elseif spec.fc then -- its faces, one after another, quickly, never the same twice in a row
		local slot = math.floor(t * 12)
		if label:GetAttribute("Slot") ~= slot then
			label:SetAttribute("Slot", slot)
			label.Image = asset(spec.fc[math.random(#spec.fc)]) or label.Image
		end
	end
end
function FX.aspect(spec)
	local img = spec.img
	if not img then return 1 end
	local w, h = if #img == 6 then img[4] else img[2], if #img == 6 then img[5] else img[3]
	return math.clamp(w / math.max(h, 1), 0.3, 3)
end

-- Its face, all over your screen, its jumpscare sound; then (`after`) whatever it does to you
function FX.jumpscare(e, after)
	local spec = e.spec
	local gui = make("ScreenGui", { Name = "IRJumpscare", IgnoreGuiInset = true, DisplayOrder = 100020, ResetOnSpawn = false }, hud)
	local back = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = e.color, BackgroundTransparency = 0.35, BorderSizePixel = 0 }, gui)
	local face = make("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.4, 0.4),
		BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit }, gui)
	FX.picture(face, spec)
	make("UIAspectRatioConstraint", { AspectRatio = FX.aspect(spec) }, face)
	local s = e.sounds
	FX.once(s.jump or s.scream or s.hit or s.spawn, SoundService, { Volume = CONFIG.Volume * 1.6 })
	FX.shake(10)
	local t0 = os.clock()
	while os.clock() - t0 < 0.9 do
		local u = (os.clock() - t0) / 0.9
		face.Size = UDim2.fromScale(0.4 + u * 1.1, 0.4 + u * 1.1)
		face.Position = UDim2.fromScale(0.5 + rnd(0.02), 0.5 + rnd(0.02))
		back.BackgroundTransparency = 0.25 + math.random() * 0.3
		FX.frame(face, spec, os.clock())
		RunService.RenderStepped:Wait()
	end
	gui:Destroy()
	if after then after() end
end

