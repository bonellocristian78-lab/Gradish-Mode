---====== SESSION: the one before (of this same script) goes first; the files already loaded are kept ======---

local GENV = if getgenv then getgenv() else _G
local KEY = "__Surprise_" .. NAME
if GENV[KEY] then pcall(GENV[KEY]) end
GENV.__SurpriseFiles = GENV.__SurpriseFiles or {}
GENV.__SurpriseKits = GENV.__SurpriseKits or {}

local function make(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do i[k] = v end
	i.Parent = parent
	return i
end
local function rnd(a) return (math.random() * 2 - 1) * a end
local function pick(list) return list[math.random(#list)] end
local function flat(v) return v * Vector3.new(1, 0, 1) end

local hud = if gethui then gethui() else LocalPlayer:WaitForChild("PlayerGui")
local folder = make("Folder", { Name = NAME }, workspace)
local screen = make("ScreenGui", { Name = NAME, IgnoreGuiInset = true, DisplayOrder = 100010, ResetOnSpawn = false }, hud)
local mainGame = nil -- DOORS' Main_Game: its camera shake
pcall(function() mainGame = require(LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game) end)

local alive = true
local connections, cleanups = {}, {}
local function on(signal, fn)
	local c = signal:Connect(fn)
	table.insert(connections, c)
	return c
end
local function later(fn) table.insert(cleanups, fn) end -- (undone when it ends, the last first)
local function stop()
	if not alive then return end
	alive = false
	for _, c in ipairs(connections) do c:Disconnect() end
	for i = #cleanups, 1, -1 do pcall(cleanups[i]) end
	folder:Destroy()
	screen:Destroy()
	if GENV[KEY] == stop then GENV[KEY] = nil end
end
GENV[KEY] = stop
-- Waits, as long as it is about; false once it is gone
local function wait(seconds)
	local t0 = os.clock()
	repeat RunService.Heartbeat:Wait() until not alive or os.clock() - t0 >= seconds
	return alive
end

---====== FILES: downloaded once into the executor's folder, then read from there ======---

local MAGIC = { mp3 = { "ID3", "\255\251", "\255\243", "\255\242" }, png = { "\137PNG" }, rbxm = { "<roblox!" } }
local function valid(name, data)
	if type(data) ~= "string" or #data < 16 then return false end
	for _, start in ipairs(MAGIC[name:match("%.(%w+)$")] or {}) do
		if data:sub(1, #start) == start then return true end
	end
	return false
end
-- A content ID for a file of the repository's `path`, kept in the folder `dir`; nil without the executor's support
local function file(dir, path, name)
	if type(name) ~= "string" then return nil end
	local here = dir .. "/" .. name
	if GENV.__SurpriseFiles[here] then return GENV.__SurpriseFiles[here] end
	pcall(function()
		if not isfolder(dir) then makefolder(dir) end
		if isfile(here) and valid(name, readfile(here)) then return end
		local data = game:HttpGet(REPO .. path .. name)
		if valid(name, data) then writefile(here, data) end -- an error page is never kept
	end)
	local ok, id = pcall(function() return isfile(here) and getcustomasset(here) end)
	if not (ok and type(id) == "string") then return nil end
	GENV.__SurpriseFiles[here] = id
	return id
end
local function sfx(name) return file("Surprise", "assets/surprise/", name .. ".mp3") end
-- A kit (.rbxm), loaded once a game (what is used of it is always a copy)
local function kit(dir, path, name)
	local here = dir .. "/" .. name
	if GENV.__SurpriseKits[here] then return GENV.__SurpriseKits[here] end
	local id = file(dir, path, name)
	if not id then return nil end
	local ok, objects = pcall(function() return game:GetObjects(id) end)
	if not (ok and type(objects) == "table" and objects[1]) then return nil end
	GENV.__SurpriseKits[here] = objects[1]
	return objects[1]
end
-- A copy of a kit's model as a thing to look at: nothing of DOORS' in it, nothing that collides or casts shadows
local function clean(model)
	model:SetAttribute("LoadModule", nil)
	local all = model:GetDescendants()
	table.insert(all, model)
	for _, d in ipairs(all) do
		for _, tag in ipairs(CollectionService:GetTags(d)) do CollectionService:RemoveTag(d, tag) end
		if d:IsA("LuaSourceContainer") or d:IsA("ProximityPrompt") or d:IsA("TouchTransmitter") or d:IsA("Animation")
			or d:IsA("AnimationController") or d:IsA("Animator") or d:IsA("BodyMover") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CanCollide, d.CanTouch, d.CanQuery, d.Massless, d.CastShadow = false, false, false, true, false
		elseif d:IsA("Light") then
			d.Shadows = false
		elseif d:IsA("ParticleEmitter") then
			d.Rate = math.min(d.Rate, 15)
		end
	end
	return model
end

---====== YOU ======---

local P = {}
function P.body()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then return character, humanoid, root end
	return nil, nil, nil
end
function P.hiding()
	local character = LocalPlayer.Character
	return character ~= nil and character:GetAttribute("Hiding") == true
end
function P.crouching()
	local character = LocalPlayer.Character
	return character ~= nil and character:GetAttribute("Crouching") == true
end
function P.speed()
	local _, _, root = P.body()
	return if root then flat(root.AssemblyLinearVelocity).Magnitude else 0
end
-- How straight you look at a point (1: right at it), 0 if something is between
function P.looks(at)
	local camera = workspace.CurrentCamera
	local from = camera.CFrame.Position
	local to = at - from
	if to.Magnitude < 0.1 then return 1 end
	local dot = camera.CFrame.LookVector:Dot(to.Unit)
	if dot < 0.5 then return dot end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { folder, LocalPlayer.Character }
	params.RespectCanCollide = true
	local hit = workspace:Raycast(from, to * 0.97, params)
	if hit then return 0 end
	return dot
end

---====== THE ROOMS ======---

local W = {}
local probe = RaycastParams.new()
probe.FilterType = Enum.RaycastFilterType.Exclude
probe.RespectCanCollide = true -- (the rooms' invisible parts, their nodes, their entrances: not walls, not floors)
function W.cast(from, direction)
	probe.FilterDescendantsInstances = { folder, LocalPlayer.Character }
	return workspace:Raycast(from, direction, probe)
end
function W.latest()
	local data = ReplicatedStorage:FindFirstChild("GameData")
	local latest = data and data:FindFirstChild("LatestRoom")
	return latest and latest.Value or nil
end
function W.rooms()
	local all = workspace:FindFirstChild("CurrentRooms")
	if not all then return nil end
	local list = {}
	for _, r in ipairs(all:GetChildren()) do
		if tonumber(r.Name) then table.insert(list, r) end
	end
	table.sort(list, function(a, b) return tonumber(a.Name) < tonumber(b.Name) end)
	return if #list > 0 then list else nil
end
function W.room(n)
	local all = workspace:FindFirstChild("CurrentRooms")
	return all and n and all:FindFirstChild(tostring(n)) or nil
end
function W.floor(p)
	local hit = W.cast(p + Vector3.new(0, 3, 0), Vector3.new(0, -40, 0))
	return if hit then hit.Position else p
end
function W.over(p, lift) return W.floor(p) + Vector3.new(0, lift or 0, 0) end
-- The way through a room: its entrance, its nodes, its exit (on the floor)
function W.points(room)
	local pts = {}
	local entrance, exit = room:FindFirstChild("RoomEntrance"), room:FindFirstChild("RoomExit")
	if entrance and entrance:IsA("BasePart") then table.insert(pts, entrance.Position) end
	local nodes = room:FindFirstChild("PathfindNodes") or room:FindFirstChild("Nodes")
	if nodes then
		local list = {}
		for _, n in ipairs(nodes:GetChildren()) do
			if n:IsA("BasePart") then table.insert(list, n) end
		end
		table.sort(list, function(a, b) return (tonumber(a.Name) or 0) < (tonumber(b.Name) or 0) end)
		for _, n in ipairs(list) do table.insert(pts, n.Position) end
	end
	if exit and exit:IsA("BasePart") then table.insert(pts, exit.Position) end
	if #pts == 0 then table.insert(pts, room:GetPivot().Position) end
	for i, p in ipairs(pts) do pts[i] = W.floor(p) end
	return pts
end
-- Every room's points, once ({ number, point }), to tell which room a point is in: W.at(map, p)
function W.map()
	local map = {}
	for _, room in ipairs(W.rooms() or {}) do
		for _, p in ipairs(W.points(room)) do table.insert(map, { tonumber(room.Name), p }) end
	end
	return map
end
function W.at(map, p)
	local best, bestDistance = nil, math.huge
	for _, m in ipairs(map) do
		local d = (m[2] - p).Magnitude
		if d < bestDistance then best, bestDistance = m[1], d end
	end
	return best
end
-- The room you are in (the one nearest to you), its number
function W.here()
	local _, _, root = P.body()
	return W.at(W.map(), if root then root.Position else workspace.CurrentCamera.CFrame.Position)
end
-- From room a to room b (either way), through every room between
function W.route(a, b)
	local pts = {}
	local step = if a <= b then 1 else -1
	for n = a, b, step do
		local room = W.room(n)
		if room then
			local list = W.points(room)
			for i = (if step > 0 then 1 else #list), (if step > 0 then #list else 1), step do table.insert(pts, list[i]) end
		end
	end
	return pts
end
-- A runner's way: from the oldest room loaded, through yours, to the newest; outside DOORS, a line through you
function W.runway()
	local list = W.rooms()
	if list and #list > 1 then return W.route(tonumber(list[1].Name), tonumber(list[#list].Name)) end
	local _, _, root = P.body()
	local camera = workspace.CurrentCamera
	local at = W.floor(if root then root.Position else camera.CFrame.Position)
	local look = flat(camera.CFrame.LookVector)
	look = if look.Magnitude > 0.01 then look.Unit else Vector3.new(0, 0, -1)
	return { at - look * 220, at, at + look * 120 }
end
-- The hiding places of a room ("locker": wardrobes, lockers, closets...; "bed": beds, tables...; "all")
local LOW = { "Bed", "Table", "Desk", "Cot", "Bench" }
local HIDES = { "Wardrobe", "Locker", "Closet", "Cabinet", "HidingSpot", "Toolshed", "Fridge", "Bed", "Table", "Desk", "Cot", "Bench" }
function W.kindOf(name)
	for _, word in ipairs(LOW) do
		if name:find(word) then return "bed" end
	end
	return "locker"
end
local function isHiding(model)
	if not model:IsA("Model") or model:IsDescendantOf(folder) then return false end
	for _, word in ipairs(HIDES) do
		if model.Name:find(word) then return true end
	end
	return false
end
function W.spots(room, kind)
	local list = {}
	for _, d in ipairs(room and room:GetDescendants() or {}) do
		if isHiding(d) and (kind == "all" or W.kindOf(d.Name) == kind) and not (d.Parent and isHiding(d.Parent)) then table.insert(list, d) end
	end
	return list
end
-- The hiding place you are in, or nil
function W.yourSpot()
	local _, _, root = P.body()
	if not root or not P.hiding() then return nil end
	local best, bestDistance = nil, 12
	for _, room in ipairs(W.rooms() or {}) do
		for _, d in ipairs(W.spots(room, "all")) do
			local distance = (d:GetPivot().Position - root.Position).Magnitude
			if distance < bestDistance then best, bestDistance = d, distance end
		end
	end
	return best
end
-- The lights of a room
function W.lights(room)
	local list = {}
	for _, d in ipairs(room and room:GetDescendants() or {}) do
		if d:IsA("Light") then table.insert(list, d) end
	end
	return list
end

---====== EFFECTS ======---

local FX = {}
local flashFrame = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1 }, screen)
local STATIC = "rbxassetid://8681113503" -- DOORS' static (A-90's)
local staticFrame = make("ImageLabel", { Size = UDim2.fromScale(1.2, 1.2), Position = UDim2.fromScale(-0.1, -0.1), BackgroundTransparency = 1,
	Image = STATIC, ScaleType = Enum.ScaleType.Tile, TileSize = UDim2.fromOffset(256, 256), ImageTransparency = 1, ZIndex = 0 }, screen)
local captionLabel = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.84), Size = UDim2.fromScale(0.7, 0.06),
	BackgroundTransparency = 1, Text = "", TextScaled = true, Font = Enum.Font.Oswald, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.2,
	TextTransparency = 1, ZIndex = 6 }, screen)
local tint = make("ColorCorrectionEffect", { Name = NAME .. "Tint", Enabled = false }, Lighting)
later(function() tint:Destroy() end)

local shakeNow = 0
function FX.shake(power)
	if power <= 0 then return end
	local ok = mainGame and mainGame.camShaker and pcall(function() mainGame.camShaker:ShakeOnce(power, 12, 0, 0.45) end)
	if not ok then shakeNow = math.max(shakeNow, power) end
end
local shakeName = NAME .. "Shake" .. math.random(1, 1e6)
RunService:BindToRenderStep(shakeName, (Enum.RenderPriority.Camera and Enum.RenderPriority.Camera.Value or 200) + 1, function(dt)
	if shakeNow <= 0.05 then return end
	local camera = workspace.CurrentCamera
	camera.CFrame *= CFrame.Angles(math.rad(rnd(shakeNow * 0.3)), math.rad(rnd(shakeNow * 0.3)), math.rad(rnd(shakeNow * 0.15)))
	shakeNow = math.max(0, shakeNow - dt * 14)
end)
later(function() RunService:UnbindFromRenderStep(shakeName) end)
-- The screen shaking as it comes: harder the nearer it is (every quarter of a second at most)
local nearAt = 0
function FX.near(pos, range, power)
	local _, _, root = P.body()
	if not root or os.clock() < nearAt then return end
	local u = 1 - (root.Position - pos).Magnitude / range
	if u <= 0 then return end
	nearAt = os.clock() + 0.25
	FX.shake(power * u)
end
local captionId = 0
function FX.caption(text, color, seconds)
	captionId += 1
	local id = captionId
	captionLabel.Text, captionLabel.TextColor3, captionLabel.TextTransparency = text, color or Color3.new(1, 1, 1), 0
	task.delay(seconds or 3.2, function()
		if captionId == id and captionLabel.Parent then TweenService:Create(captionLabel, TweenInfo.new(0.6), { TextTransparency = 1 }):Play() end
	end)
end
function FX.flash(color, strength)
	flashFrame.BackgroundColor3 = color
	flashFrame.BackgroundTransparency = 1 - (strength or 0.6)
	TweenService:Create(flashFrame, TweenInfo.new(0.7), { BackgroundTransparency = 1 }):Play()
end
-- Static over the screen: 0 none, 1 all of it
function FX.static(amount)
	staticFrame.ImageTransparency = 1 - math.clamp(amount, 0, 0.85)
	if amount > 0 then staticFrame.Position = UDim2.fromScale(-0.1 + rnd(0.05), -0.1 + rnd(0.05)) end
end
-- The colour of everything: a colour and how much (0 off)
function FX.tint(color, amount)
	tint.Enabled = amount > 0
	tint.TintColor = Color3.new(1, 1, 1):Lerp(color, math.clamp(amount, 0, 1))
	tint.Saturation = -0.3 * amount
end
-- DOORS' own flicker of a room's lights (or its lights off and on)
function FX.flicker(room, seconds)
	if not room then return end
	local ok = pcall(function() require(ReplicatedStorage.ModulesClient.Module_Events).flicker(room, seconds) end)
	if ok then return end
	task.spawn(function()
		local lights = {}
		for _, l in ipairs(W.lights(room)) do
			if l.Enabled then table.insert(lights, l) end
		end
		local t0 = os.clock()
		while os.clock() - t0 < seconds do
			for _, l in ipairs(lights) do l.Enabled = math.random() < 0.5 end
			task.wait(0.07)
		end
		for _, l in ipairs(lights) do l.Enabled = true end
	end)
end
-- DOORS' own shattering of a room's lights (or its lights off, with the sound of glass)
function FX.shatter(room, at)
	if not room then return end
	local ok = pcall(function() require(ReplicatedStorage.ModulesClient.Module_Events).shatter(room) end)
	if ok then return end
	FX.once("rbxassetid://6737581315", at) -- (DOORS' glass)
	for _, l in ipairs(W.lights(room)) do l.Enabled = false end
end
-- A room dark, until it ends (only for you)
function FX.dark(room)
	for _, l in ipairs(W.lights(room)) do
		if l.Enabled then
			l.Enabled = false
			later(function() l.Enabled = true end)
		end
	end
end
function FX.sound(id, parent, props)
	if not id then return nil end
	local s = make("Sound", { SoundId = id, Volume = VOLUME }, parent or SoundService)
	for k, v in pairs(props or {}) do s[k] = v end
	return s
end
function FX.once(id, parent, props)
	local s = FX.sound(id, parent or SoundService, props)
	if not s then return nil end
	s:Play()
	s.Ended:Connect(function() s:Destroy() end)
	task.delay(20, function() if s.Parent then s:Destroy() end end)
	return s
end
function FX.loop(id, parent, props)
	local s = FX.sound(id, parent, props)
	if not s then return nil end
	s.Looped = true
	s:Play()
	return s
end
-- Its face in yours: the camera on `part` a moment (from your side of it, closer and closer, shaking), its sound; then
-- `after`. (The camera is set after DOORS' own has moved it, every frame)
function FX.face(part, sound, color, after)
	local camera = workspace.CurrentCamera
	local away = flat(camera.CFrame.Position - part.Position)
	away = if away.Magnitude > 0.1 then away.Unit else Vector3.new(0, 0, 1)
	local distance = math.clamp(part.Size.Magnitude * 1.6, 3, 14)
	local name = NAME .. "Face" .. math.random(1, 1e6)
	local t0 = os.clock()
	RunService:BindToRenderStep(name, Enum.RenderPriority.Last.Value, function()
		local u = math.min((os.clock() - t0) / 0.9, 1)
		local from = part.Position + away * distance * (1 - u * 0.6) + Vector3.new(rnd(0.3), rnd(0.3), rnd(0.3))
		camera.CFrame = CFrame.lookAt(from, part.Position)
	end)
	FX.once(sound, SoundService, { Volume = VOLUME * 2 })
	FX.flash(color, 0.5)
	FX.shake(8)
	task.wait(0.9)
	RunService:UnbindFromRenderStep(name)
	if after then after() end
end

---====== WHAT IT DOES TO YOU ======---

local HURT = {}
-- DOORS' death screen: "You died to ...", and its tips
function HURT.kill(name, hints)
	local _, humanoid = P.body()
	if not humanoid then return end
	pcall(function() ReplicatedStorage.GameStats["Player_" .. LocalPlayer.Name].Total.DeathCause.Value = name end)
	if firesignal then
		task.spawn(function()
			pcall(function()
				local death = LocalPlayer.PlayerGui.MainUI:FindFirstChild("Death")
				if not death then return end
				if not death.Visible then death:GetPropertyChangedSignal("Visible"):Wait() end
				firesignal(ReplicatedStorage.RemotesFolder.DeathHint.OnClientEvent, hints, "Blue")
			end)
		end)
	end
	humanoid.Health = 0
end
-- `amount` of your health; true if it was the last of it (then: its jumpscare, `face`, and your death)
function HURT.damage(amount, name, hints, color, face, sound)
	local _, humanoid = P.body()
	if not humanoid then return false end
	if humanoid.Health - amount <= 0 then
		if face then
			FX.face(face, sound, color, function() HURT.kill(name, hints) end)
		else
			HURT.kill(name, hints)
		end
		return true
	end
	humanoid.Health -= amount
	FX.flash(color, 0.45)
	FX.shake(5)
	return false
end

---====== GOING ======---

-- You, unhidden, within `reach` of `pos`, nothing solid between: your root; else nil
local function exposed(pos, reach)
	local character, _, root = P.body()
	if not root or P.hiding() then return nil end
	local to = root.Position - pos
	if to.Magnitude > reach then return nil end
	if to.Magnitude > 2 then
		local hit = W.cast(pos, to)
		if hit and not hit.Instance:IsDescendantOf(character) then return nil end
	end
	return root
end
-- Along `pts` at `speed` studs a second (a number, or a function of the time gone); step(pos, dir, dt) every frame, true
-- from it stops it. -> where it stopped
local function travel(pts, speed, step)
	local pos = pts[1]
	if not pos then return nil end
	local i, t, dir = 2, 0, Vector3.new(0, 0, -1)
	if pts[2] and (pts[2] - pos).Magnitude > 1e-3 then dir = (pts[2] - pos).Unit end
	while alive and i <= #pts do
		local dt = RunService.Heartbeat:Wait()
		t += dt
		local left = (if type(speed) == "function" then speed(t) else speed) * dt
		while left > 0 and i <= #pts do
			local to = pts[i] - pos
			local d = to.Magnitude
			if d > 1e-3 then dir = to.Unit end
			if d <= left then
				pos, i, left = pts[i], i + 1, left - d
			else
				pos, left = pos + dir * left, 0
			end
		end
		if step(pos, dir, dt) then return pos end
	end
	return pos
end
-- A model held as one: place(cf) puts the frame `ref` (a CFrame) at cf, every part of it with it (all anchored)
local function rigid(model, ref)
	local parts = {}
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
			table.insert(parts, { p, ref:ToObjectSpace(p.CFrame) })
		end
	end
	return function(cf)
		for _, e in ipairs(parts) do e[1].CFrame = cf * e[2] end
	end
end
-- The same way backwards
local function reversed(pts)
	local back = {}
	for i = #pts, 1, -1 do table.insert(back, pts[i]) end
	return back
end
---====== HONCHO: the kit's body (assets/seek/HonchoSeek.rbxm, HonchoSeek's own), with Seek's animations made his ======---

local HONCHO_SCREAM = "rbxassetid://82613796053949" -- Honcho's ("archives_honcho_cutscenelanding")
local TIE = { "TieTop", "TieUpper", "TieMiddle", "TieLower", "TieBottom" }
-- A maker of Honchos (nil without the kit): .new(scale) -> one, anchored, posed part by part every :step(dt):
--   :play(animation, speed) (emerge, run, cruxstart, cruxloop, cruxend; a negative speed backwards), :place(floor point, look)
local function loadHoncho()
	local source = kit("HonchoSeek", "assets/seek/", "HonchoSeek.rbxm")
	local honcho = source and source:FindFirstChild("Honcho")
	if not (honcho and honcho:FindFirstChild("RootPart")) then return nil end
	honcho = honcho:Clone()
	--[[ The kit's AnimSaves are Seek's (poses of Seek's joints). For each keyframe: Seek's body in that pose (its rig below,
	     from seekidk.rbxm; its left arm a mirror of its right, as its animations were made on), then Honcho's joints turned so
	     that each of his bones points where Seek's does: his pelvis turns as Seek's hips, his three spine pieces share Seek's
	     bend, his head looks as Seek's (lifted a little: it looks ahead, not at the floor), his long arms and three-piece legs
	     along Seek's, his feet flat. Seek's way forward is left out (where he goes is DOORS' Seek's); up and down is kept,
	     scaled, with his lowest point where Seek's is (under the floor as much of him as of Seek) ]]
	local ID = CFrame.new()
	local UP = Vector3.new(0, 1, 0)
	local function rot(cf) return cf - cf.Position end

	-- Seek's rig: { part, its parent, C0, C1, size }, parents first; its root (Root) at the origin, unturned
	local SEEK_RIG = {
		{ "UpperTorso", "Root", CFrame.new(0.06886, -0.00026, -0.08232, 1, 0, 0, 0, 1, 0, 0, 0, 1), CFrame.new(-0.00149, -0.6522, 0.32526, 1, -0.00271, 0.00097, 0.00277, 0.81883, -0.57403, 0.00076, 0.57403, 0.81883), Vector3.new(1.8844, 2.0938, 1.2062) },
		{ "RightUpperArm", "UpperTorso", CFrame.new(0.73478, 0.3453, -0.00837, 1, 0, 0, -0, 1, 0, 0, 0, 1), CFrame.new(-0.59587, 0.57632, 0.00151, 0.71882, 0.69519, -0.00093, -0.69519, 0.71881, -0.00348, -0.00175, 0.00315, 0.99999), Vector3.new(1.7019, 1.8276, 0.5863) },
		{ "RightLowerArm", "RightUpperArm", CFrame.new(0.58366, -0.47067, -0.03382, 0.71882, 0.69519, -0.00093, -0.69519, 0.71881, -0.00348, -0.00175, 0.00315, 0.99999), CFrame.new(-0.60226, 0.85772, 0.00247, 0.68925, 0.72452, -0.00105, -0.72452, 0.68924, -0.00364, -0.00191, 0.00327, 0.99999), Vector3.new(2.1206, 1.9670, 0.4753) },
		{ "Right Hand", "RightLowerArm", CFrame.new(1.17294, -1.3811, -0.1167, 0.98158, -0.1801, -0.06379, 0.17273, 0.97918, -0.10662, 0.08166, 0.09364, 0.99225), CFrame.new(0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1), Vector3.new(1.1674, 1.6975, 1.0081) },
		{ "LowerTorso", "UpperTorso", CFrame.new(0.02499, -1.53859, -0.19141, 1, -0.00271, 0.00097, 0.00277, 0.81883, -0.57403, 0.00076, 0.57403, 0.81883), CFrame.new(-0.00144, 0.36233, 0.30781, 1, 0.00277, 0.00075, -0.0027, 0.82044, 0.57173, 0.00097, -0.57173, 0.82044), Vector3.new(1.4399, 1.4695, 1.1647) },
		{ "LeftUpperLeg", "LowerTorso", CFrame.new(-0.41058, -0.37458, -0.04164, 1, 0, 0, 0, 1, 0, 0, 0, 1), CFrame.new(0, 0.82896, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1), Vector3.new(0.7415, 2.6086, 1.0880) },
		{ "LeftLowerLeg", "LeftUpperLeg", CFrame.new(-0.09052, -0.84928, -0.17233, 1, 0, 0, 0, 1, 0, 0, 0, 1), CFrame.new(-0.19111, 1.47121, 0.2248, 0.90073, 0.13828, 0.41179, 0.16579, 0.76679, -0.62012, -0.40151, 0.62683, 0.66774), Vector3.new(0.5151, 2.3295, 1.1200) },
		{ "RightUpperLeg", "LowerTorso", CFrame.new(0.37051, -0.32354, -0.01776, 1, 0, 0, 0, 1, 0, 0, 0, 1), CFrame.new(0, 0.82896, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1), Vector3.new(0.9894, 2.4744, 1.1935) },
		{ "RightLowerLeg", "RightUpperLeg", CFrame.new(0.09816, -0.90246, -0.21807, 1, 0, 0, 0, 1, 0, 0, 0, 1), CFrame.new(0.09974, 1.35335, 0.12263, 0.62797, -0.25546, -0.73512, -0.22265, 0.84613, -0.48424, 0.74571, 0.46776, 0.47447), Vector3.new(0.5450, 2.4633, 1.1677) },
		{ "Head", "UpperTorso", CFrame.new(0.0313, 0.37179, 0.77239, 1, -0.00271, 0.00097, 0.00277, 0.81883, -0.57403, 0.00076, 0.57403, 0.81883), CFrame.new(-0.00473, -0.19682, 0.97652, 1, -0.00125, 0.00022, 0.00126, 0.96479, -0.26303, 0.00012, 0.26303, 0.96479), Vector3.new(1.2445, 1.3973, 1.3196) },
		{ "LeftUpperArm", "UpperTorso", CFrame.new(-0.73478, 0.3453, -0.00837, 1, -0, 0, 0, 1, 0, 0, 0, 1), CFrame.new(0.59587, 0.57632, 0.00151, 0.71882, -0.69519, 0.00093, 0.69519, 0.71881, -0.00348, 0.00175, 0.00315, 0.99999), Vector3.new(1.7019, 1.8276, 0.5863) },
		{ "LeftLowerArm", "LeftUpperArm", CFrame.new(-0.58366, -0.47067, -0.03382, 0.71882, -0.69519, 0.00093, 0.69519, 0.71881, -0.00348, 0.00175, 0.00315, 0.99999), CFrame.new(0.60226, 0.85772, 0.00247, 0.68925, -0.72452, 0.00105, 0.72452, 0.68924, -0.00364, 0.00191, 0.00327, 0.99999), Vector3.new(1.7874, 1.7275, 0.5165) },
		{ "Left Hand", "LeftLowerArm", CFrame.new(-1.11893, -1.32516, -0.29968, 0.99782, -0.04756, 0.04578, 0.05882, 0.95537, -0.28951, -0.02997, 0.29157, 0.95608), CFrame.new(0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1), Vector3.new(1.1671, 1.6977, 1.0074) },
	}
	local SJ, SSIZE = {}, {}
	for _, j in ipairs(SEEK_RIG) do
		SJ[j[1]] = { p0 = j[2], c0 = j[3], c1inv = j[4]:Inverse() }
		SSIZE[j[1]] = j[5]
	end
	local function seekFK(T)
		local w = { Root = ID }
		for _, j in ipairs(SEEK_RIG) do
			local s = SJ[j[1]]
			w[j[1]] = w[s.p0] * s.c0 * (T[j[1]] or ID) * s.c1inv
		end
		return w
	end

	-- Honcho's rig, from the kit: his joints (a Motor6D before a weld), parents first from his RootPart (at the origin, turned
	-- as in the kit: his character's axes are his RootPart's)
	local HJ, HSIZE, HORDER = {}, {}, {}
	for _, d in ipairs(honcho:GetDescendants()) do
		if (d:IsA("Motor6D") or d:IsA("Weld") or d:IsA("ManualWeld")) and d.Part0 and d.Part1 then
			local name = d.Part1.Name
			if not (HJ[name] and HJ[name].motor) then
				HJ[name] = { p0 = d.Part0.Name, c0 = d.C0, c1inv = d.C1:Inverse(), motor = d:IsA("Motor6D") }
			end
		elseif d:IsA("BasePart") then
			HSIZE[d.Name] = d.Size
		end
	end
	do
		local function visit(name)
			for child, j in pairs(HJ) do
				if j.p0 == name and not table.find(HORDER, child) then
					table.insert(HORDER, child)
					visit(child)
				end
			end
		end
		visit("RootPart")
	end
	local HROOT = rot(honcho.RootPart.CFrame)
	local function honFK(T)
		local w = { RootPart = HROOT }
		for _, name in ipairs(HORDER) do
			local j = HJ[name]
			if w[j.p0] then w[name] = w[j.p0] * j.c0 * (T[name] or ID) * j.c1inv end
		end
		return w
	end
	local s0, h0 = seekFK({}), honFK({})

	local function rotBetween(a, b) -- the smallest turn taking direction a onto b
		a, b = a.Unit, b.Unit
		local axis = a:Cross(b)
		local s, c = axis.Magnitude, a:Dot(b)
		if s < 1e-8 then
			if c > 0 then return ID end
			local p = if math.abs(a.X) < 0.9 then a:Cross(Vector3.new(1, 0, 0)) else a:Cross(UP)
			return CFrame.fromAxisAngle(p.Unit, math.pi)
		end
		return CFrame.fromAxisAngle(axis / s, math.atan2(s, c))
	end
	local function toH(R) return HROOT * R * HROOT:Inverse() end -- a turn of Seek's world as one of Honcho's
	local function sdir(a, b) return HROOT:VectorToWorldSpace(b - a) end -- a direction of Seek's, in Honcho's world
	local function yawOnly(R)
		local f = R:VectorToWorldSpace(Vector3.new(0, 0, -1))
		f = Vector3.new(f.X, 0, f.Z)
		if f.Magnitude < 1e-6 then return ID end
		return rotBetween(Vector3.new(0, 0, -1), f.Unit)
	end
	local function jointH(w, child) local j = HJ[child] return (w[j.p0] * j.c0).Position end
	local function jointS(w, sj, child) local j = sj[child] return (w[j.p0] * j.c0).Position end

	local CORNERS = {}
	for _, x in ipairs({ -0.5, 0.5 }) do
		for _, y in ipairs({ -0.5, 0.5 }) do
			for _, z in ipairs({ -0.5, 0.5 }) do table.insert(CORNERS, Vector3.new(x, y, z)) end
		end
	end
	local SEEK_BODY = { "LeftLowerLeg", "RightLowerLeg", "LeftUpperLeg", "RightUpperLeg", "LowerTorso", "UpperTorso", "Head", "LeftUpperArm",
		"RightUpperArm", "LeftLowerArm", "RightLowerArm" }
	local HON_BODY = { "LeftFoot", "RightFoot", "LeftLowerLeg", "RightLowerLeg", "Pelvis", "UpperTorso", "Head", "LeftHand", "RightHand",
		"LeftUpperArm", "RightUpperArm" }
	local function extent(w, names, sizes, turn) -- its lowest and highest point, up its character's axis
		local lo, hi = math.huge, -math.huge
		for _, n in ipairs(names) do
			local cf, size = w[n], sizes[n]
			if cf and size then
				for _, c in ipairs(CORNERS) do
					local y = turn:VectorToObjectSpace(cf * (size * c)).Y
					lo, hi = math.min(lo, y), math.max(hi, y)
				end
			end
		end
		return lo, hi
	end
	-- The floors (Seek's: the bottom of its run; Honcho's: the kit's FloorPart) and how much bigger Honcho is
	local floorPart = honcho:FindFirstChild("FloorPart")
	local HON_FLOOR = if floorPart then floorPart.Position.Y - floorPart.Size.Y / 2 - honcho.RootPart.Position.Y else -6.39
	local SEEK_FLOOR0 = math.min(s0.LeftLowerLeg.Position.Y, s0.RightLowerLeg.Position.Y) - 1.2
	local K = (HROOT:VectorToObjectSpace(h0.Pelvis.Position).Y - HON_FLOOR) / (s0.LowerTorso.Position.Y - SEEK_FLOOR0)
	local SEEK_FLOOR = SEEK_FLOOR0
	local HEAD_LIFT = 0 -- (his head exactly as Seek's)

	-- Honcho's joints for one pose of Seek's: ws, its parts from its Root; rest, its parts at rest; sj, its joints.
	-- -> { [part] = Transform }
	local function retargetWorld(ws, rest, sj)
		local T, wh = {}, { RootPart = HROOT }
		local function place(name, R, pos)
			local j = HJ[name]
			local Rt = rot(j.c0):Inverse() * rot(wh[j.p0]):Inverse() * R * rot(j.c1inv:Inverse())
			local t = if pos then CFrame.new(pos) * Rt else Rt
			T[name] = t
			wh[name] = wh[j.p0] * j.c0 * t * j.c1inv
		end
		local function follow(name)
			local j = HJ[name]
			T[name] = ID
			wh[name] = wh[j.p0] * j.c0 * j.c1inv
		end
		local function aim(name, child, target)
			follow(name)
			place(name, rotBetween(jointH(wh, child) - jointH(wh, name), target) * rot(wh[name]))
		end
		-- His pelvis: Seek's hips' turn since its rest, and their way up and down (scaled)
		local turn = rot(ws.LowerTorso) * rot(rest.LowerTorso):Inverse()
		local move = (ws.LowerTorso.Position - rest.LowerTorso.Position) * K
		place("Pelvis", toH(turn) * rot(h0.Pelvis), rot(HJ.Pelvis.c0):VectorToObjectSpace(HROOT:VectorToWorldSpace(Vector3.new(0, move.Y, 0))))
		-- His spine: its three pieces share Seek's bend from hips to chest
		local spine = sdir(ws.LowerTorso.Position, ws.UpperTorso.Position)
		local pieces, shares = { "LowerTorso", "MiddleTorso", "UpperTorso" }, { 1 / 3, 1 / 2, 1 }
		for i, name in ipairs(pieces) do
			for k = i, #pieces do follow(pieces[k]) end
			place(name, ID:Lerp(rotBetween(jointH(wh, "Neck") - jointH(wh, name), spine), shares[i]) * rot(wh[name]))
		end
		-- His head: Seek's head's own turn beyond its chest's, on his chest; lifted toward upright; his neck halfway
		local chest = rot(ws.UpperTorso) * rot(rest.UpperTorso):Inverse()
		local head = rot(ws.Head) * rot(rest.Head):Inverse()
		local Rhead = (rot(wh.UpperTorso) * rot(h0.UpperTorso):Inverse()) * toH(chest:Inverse() * head) * rot(h0.Head)
		Rhead = ID:Lerp(rotBetween(Rhead:VectorToWorldSpace(UP), HROOT:VectorToWorldSpace(UP)), HEAD_LIFT) * Rhead
		follow("Neck")
		place("Neck", ID:Lerp(Rhead * rot(h0.Head):Inverse() * rot(h0.Neck) * rot(wh.Neck):Inverse(), 0.5) * rot(wh.Neck))
		place("Head", Rhead)
		-- His arms: the shoulder pad on his chest, the upper arm along Seek's, the forearm along Seek's, the rest straight
		for _, side in ipairs({ "Left", "Right" }) do
			follow(side .. "Shoulder")
			local shoulder, elbow, wrist = jointS(ws, sj, side .. "UpperArm"), jointS(ws, sj, side .. "LowerArm"), ws[side .. " Hand"].Position
			aim(side .. "UpperArm", side .. "UpperWrist", sdir(shoulder, elbow))
			aim(side .. "UpperWrist", side .. "LowerWrist", sdir(elbow, wrist))
			follow(side .. "LowerWrist")
			follow(side .. "Hand")
		end
		-- His legs: the thigh along Seek's, both shin pieces along Seek's shin, the foot flat, turned as his hips
		for _, side in ipairs({ "Left", "Right" }) do
			local hip, knee = jointS(ws, sj, side .. "UpperLeg"), jointS(ws, sj, side .. "LowerLeg")
			local foot = ws[side .. "LowerLeg"] * Vector3.new(0, -1.1, 0)
			aim(side .. "UpperLeg", side .. "MiddleLeg", sdir(hip, knee))
			aim(side .. "MiddleLeg", side .. "LowerLeg", sdir(knee, foot))
			aim(side .. "LowerLeg", side .. "Ankle", sdir(knee, foot))
			follow(side .. "Ankle")
			place(side .. "Foot", toH(yawOnly(turn)) * rot(h0[side .. "Foot"]))
		end
		-- On the floor as Seek is: standing, his lowest point as Seek's; under the floor, as much of him under as of Seek
		local sLo, sHi = extent(ws, SEEK_BODY, SSIZE, ID)
		sLo, sHi = sLo * K - SEEK_FLOOR * K, sHi * K - SEEK_FLOOR * K
		local hLo, hHi = extent(honFK(T), HON_BODY, HSIZE, HROOT)
		hLo, hHi = hLo - HON_FLOOR, hHi - HON_FLOOR
		local under = math.clamp(-sLo / math.max(sHi - sLo, 1e-3), 0, 1)
		local lift = (sLo - hLo) * (1 - under) + (sHi - hHi) * under
		T.Pelvis = T.Pelvis + rot(HJ.Pelvis.c0):VectorToObjectSpace(HROOT:VectorToWorldSpace(Vector3.new(0, lift, 0)))
		return T
	end
	local function retarget(seekT) return retargetWorld(seekFK(seekT), s0, SJ) end

	-- The kit's animations, each keyframe made Honcho's: { joints = { [part] = { { t, cf }, ... } }, length, looped }
	local function posesOf(frame)
		local T = {}
		for _, d in ipairs(frame:GetDescendants()) do
			if d:IsA("Pose") and d.Weight > 0 then T[d.Name] = d.CFrame end
		end
		return T
	end
	local ANIMS = {}
	local saves = honcho:FindFirstChild("AnimSaves")
	if saves then
		local run = saves:FindFirstChild("run")
		if run then -- (Seek's floor: the bottom of its run)
			local low = math.huge
			for _, frame in ipairs(run:GetKeyframes()) do
				local ws = seekFK(posesOf(frame))
				for _, n in ipairs({ "LeftLowerLeg", "RightLowerLeg" }) do
					for _, c in ipairs(CORNERS) do low = math.min(low, (ws[n] * (SSIZE[n] * c)).Y) end
				end
			end
			SEEK_FLOOR = low
		end
		for _, kfs in ipairs(saves:GetChildren()) do
			if kfs:IsA("KeyframeSequence") then
				local anim = { joints = {}, length = 0, looped = kfs.Loop }
				local frames = kfs:GetKeyframes()
				table.sort(frames, function(a, b) return a.Time < b.Time end)
				for _, frame in ipairs(frames) do
					anim.length = math.max(anim.length, frame.Time)
					for name, t in pairs(retarget(posesOf(frame))) do
						anim.joints[name] = anim.joints[name] or {}
						table.insert(anim.joints[name], { t = frame.Time, cf = t })
					end
				end
				ANIMS[kfs.Name:lower()] = anim
			end
		end
		saves:Destroy()
	end
	local function poseAt(list, time) -- (all its keyframes are linear)
		local a, b = list[1], nil
		for i = 2, #list do
			if list[i].t <= time then a = list[i] else b = list[i] break end
		end
		if not b or time <= a.t then return a.cf end
		return a.cf:Lerp(b.cf, (time - a.t) / (b.t - a.t))
	end
	clean(honcho)
	if floorPart then floorPart:Destroy() end -- (only where his feet are, in the kit)
	local maker = { anims = ANIMS }
	function maker.new(scale)
		scale = scale or 1
		local copy = honcho:Clone()
		local root = copy:FindFirstChild("RootPart")
		local one = { model = copy, root = root, parts = {}, anim = nil, time = 0, speed = 1, pace = 0 }
		for _, p in ipairs(copy:GetDescendants()) do
			if p:IsA("BasePart") then
				p.Anchored = true
				if scale ~= 1 then p.Size *= scale end
				if p == root or HJ[p.Name] then table.insert(one.parts, { p, p.Name }) end
			elseif p:IsA("SpecialMesh") and scale ~= 1 then
				p.Scale *= scale
			end
		end
		one.footsteps = copy:FindFirstChild("Footsteps", true)
		one.scream = FX.sound(HONCHO_SCREAM, root, { Volume = 2 * VOLUME, RollOffMinDistance = 30 * scale })
		copy.Parent = folder
		function one:play(name, speed)
			local anim = ANIMS[name]
			if not anim then return end
			if anim ~= self.anim then self.time = if (speed or 1) < 0 then anim.length else 0 end
			self.anim, self.speed = anim, speed or 1
		end
		-- His feet on the floor at `pos`, facing `look`
		function one:place(pos, look)
			local at = pos - Vector3.new(0, HON_FLOOR * scale, 0)
			look = flat(look or Vector3.new(0, 0, -1))
			root.CFrame = CFrame.lookAt(at, at + (if look.Magnitude > 1e-3 then look.Unit else Vector3.new(0, 0, -1)))
		end
		function one:step(dt)
			local T, anim = {}, self.anim
			if anim then
				self.time += dt * self.speed
				local t = if (anim.looped or anim == ANIMS.run) and anim.length > 0 then self.time % anim.length else math.clamp(self.time, 0, anim.length)
				for name, list in pairs(anim.joints) do T[name] = poseAt(list, t) end
			end
			local now = os.clock()
			local swing = if self.pace > 3 then 0.25 else 0.08 -- (his tie swings, more as he runs)
			for i, name in ipairs(TIE) do
				T[name] = CFrame.Angles(math.sin(now * 9 + i * 0.7) * swing * (0.5 + i * 0.15), 0, math.sin(now * 5.3 + i) * swing * 0.4)
			end
			local w = honFK(T)
			local toRoot = HROOT:Inverse()
			for _, pair in ipairs(self.parts) do
				local cf = w[pair[2]]
				if cf and pair[1] ~= root then
					local rel = toRoot * cf
					if scale ~= 1 then rel = rel - rel.Position + rel.Position * scale end
					pair[1].CFrame = root.CFrame * rel
				end
			end
			if self.footsteps then -- his footsteps while he goes
				local going = self.pace > 3
				if going and not self.footsteps.IsPlaying then self.footsteps:Play() elseif not going and self.footsteps.IsPlaying then self.footsteps:Stop() end
				self.footsteps.PlaybackSpeed = math.clamp(self.pace / (22 * scale), 0.5, 1.5)
			end
		end
		return one
	end
	return maker
end

local RED = Color3.fromRGB(210, 40, 40)
local SPEED = 70 -- studs a second
local REACH = 16 -- how near he gets you
local HINTS = { "You died to Honcho.", "When the lights flicker and you hear him scream, hide.", "He runs through every room, like Rush." }

local maker = loadHoncho()
if not maker then
	warn("[HonchoRush] its kit could not be loaded")
	stop()
	return
end

local map = W.map()
local pts = W.runway()
local h = maker.new(1)
local head = h.model:FindFirstChild("Head", true) or h.root
h:place(pts[1], pts[2] - pts[1])
FX.flicker(W.room(W.here()), 2.5)

-- Out of the floor, far away, screaming
h:play("emerge", 1.2)
h.scream:Play()
local t0 = os.clock()
local out = if maker.anims.emerge then maker.anims.emerge.length / 1.2 else 0
while alive and os.clock() - t0 < out do h:step(RunService.Heartbeat:Wait()) end

-- Through every room
local rumble = FX.loop(sfx("Rumble"), h.root, { Volume = 1.6 * VOLUME, RollOffMinDistance = 20, RollOffMaxDistance = 260 })
h:play("run", SPEED / 22)
h.pace = SPEED
local got, lastRoom = false, nil
travel(pts, SPEED, function(pos, dir, dt)
	h:place(pos, dir)
	h:step(dt)
	FX.near(pos, 100, 7)
	local n = W.at(map, pos)
	if n ~= lastRoom then
		lastRoom = n
		FX.flicker(W.room(n), 1.5)
	end
	if not got and exposed(h.root.Position, REACH) then
		got = true
		task.spawn(FX.face, head, HONCHO_SCREAM, RED, function() HURT.kill("Honcho", HINTS) end)
	end
	return false
end)

-- Back into the floor
if rumble then rumble:Stop() end
h.pace = 0
