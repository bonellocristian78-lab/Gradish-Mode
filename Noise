local function sound(id, props, parent)
	if not id then return nil end
	local s = make("Sound", { SoundId = id, Volume = CONFIG.Volume }, parent)
	for k, v in pairs(props or {}) do s[k] = v end
	return s
end

-- A sound that plays once and goes
local function oneShot(id, parent, props)
	local s = sound(id, props, parent)
	if not s then return end
	s:Play()
	s.Ended:Connect(function() s:Destroy() end)
	task.delay(12, function() if s.Parent then s:Destroy() end end)
end

