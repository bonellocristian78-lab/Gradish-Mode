---====== PLAYING THE KIT'S ANIMATIONS: its KeyframeSequences, joint by joint (any game) ======---

local STYLE = { Linear = "Linear", Cubic = "Cubic", CubicV2 = "Cubic", Elastic = "Elastic", Bounce = "Bounce" }

local function prepare(kfs)
	local joints, markers, length = {}, {}, 0
	local frames = kfs:GetKeyframes()
	table.sort(frames, function(a, b) return a.Time < b.Time end)
	for _, frame in ipairs(frames) do
		length = math.max(length, frame.Time)
		for _, d in ipairs(frame:GetDescendants()) do
			if d:IsA("Pose") and d.Weight > 0 then
				joints[d.Name] = joints[d.Name] or {}
				table.insert(joints[d.Name], { t = frame.Time, cf = d.CFrame, style = d.EasingStyle.Name, dir = d.EasingDirection.Name })
			elseif d:IsA("KeyframeMarker") then
				table.insert(markers, { t = frame.Time, value = d.Value })
			end
		end
	end
	return { joints = joints, markers = markers, length = length, looped = kfs.Loop }
end

local function poseOf(list, time)
	local a, b = list[1], nil
	for i = 2, #list do
		if list[i].t <= time then a = list[i] else b = list[i] break end
	end
	if not b or a.style == "Constant" or time <= a.t then return a.cf end
	local dir = a.dir -- the old styles have In and Out swapped, as in Roblox
	if a.style ~= "CubicV2" and a.style ~= "Linear" then dir = if dir == "In" then "Out" elseif dir == "Out" then "In" else dir end
	local alpha = TweenService:GetValue((time - a.t) / (b.t - a.t), Enum.EasingStyle[STYLE[a.style] or "Linear"], Enum.EasingDirection[dir])
	return a.cf:Lerp(b.cf, alpha)
end

-- A rig that plays one prepared animation at a time; onMarker hears its KeyframeMarkers
local function newRig(model)
	local rig = { motors = {}, anim = nil, time = 0, speed = 1, done = true, onMarker = nil }
	for _, m in ipairs(model:GetDescendants()) do
		if m:IsA("Motor6D") and m.Part1 then rig.motors[m.Part1.Name] = m end
	end
	function rig:play(anim, speed)
		if not anim then return end
		if self.anim ~= anim then self.time = 0 end
		self.anim, self.speed, self.done = anim, speed or 1, false
	end
	function rig:step(dt)
		local a = self.anim
		if not a or self.done then return end
		local before = self.time
		self.time += dt * self.speed
		local wrapped = false
		if self.time >= a.length then
			if a.looped and a.length > 0 then
				self.time %= a.length
				wrapped = true
			else
				self.time, self.done = a.length, true
			end
		end
		if self.onMarker then
			for _, m in ipairs(a.markers) do
				if (not wrapped and m.t > before and m.t <= self.time) or (wrapped and (m.t > before or m.t <= self.time)) then
					self.onMarker(m)
				end
			end
		end
		for name, list in pairs(a.joints) do
			local motor = self.motors[name]
			if motor then motor.Transform = poseOf(list, self.time) end
		end
	end
	return rig
end

---====== NOISE ======---

local current = nil -- the Noise of now

local function makeNoise()
	local source = piece("NoiseModel")
	local anims = {}
	local model
	if source then
		model = source:Clone()
		local saves = model:FindFirstChild("AnimSaves")
		for _, name in ipairs({ "Emerge", "Walk", "HijackWalk", "Jumpscare" }) do
			local kfs = saves and saves:FindFirstChild(name)
			if kfs then anims[name] = prepare(kfs) end
		end
		if saves then saves:Destroy() end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("Sound") and d.SoundId == "" and type(d:GetAttribute("id")) == "string" then d.SoundId = d:GetAttribute("id") end
		end
		clean(model, true)
	else -- built: a black shape in blue light, with sparks
		model = Instance.new("Model")
		local root = make("Part", { Name = "HumanoidRootPart", Size = Vector3.new(2, 2.4, 1), Transparency = 1 }, model)
		local core = make("Part", { Name = "Core", Size = Vector3.new(2.4, 5, 1.2), Color = Color3.new(0, 0, 0), Material = Enum.Material.Neon }, model)
		make("WeldConstraint", { Part0 = root, Part1 = core }, core)
		make("ParticleEmitter", { Name = "NoiseStatic", Rate = 60, Lifetime = NumberRange.new(0.2, 0.5), Speed = NumberRange.new(2, 6),
			SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.25, 0), Color = ColorSequence.new(BLUE), LightEmission = 1 }, core)
		make("PointLight", { Name = "PointLight", Range = 16 }, root)
		make("Highlight", { Name = "Highlight" }, model)
		model.PrimaryPart = root
	end
	model.Name = "Noise"
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = p == root, false, false, false, true end
	end
	paint(model, 0)
	local box, size = model:GetBoundingBox()
	local noise = { model = model, root = root, anims = anims, rig = newRig(model), level = -1,
		hip = root.Position.Y - (box.Y - size.Y / 2), -- how high its root stands above the floor
		glow = model:FindFirstChildOfClass("Highlight") or make("Highlight", {}, model),
		light = root:FindFirstChildWhichIsA("PointLight") or make("PointLight", { Range = 16 }, root) }
	noise.glow.DepthMode = Enum.HighlightDepthMode.Occluded
	noise.textures = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Texture") then table.insert(noise.textures, d) end
	end
	noise.light.Shadows = false
	function noise:sound(name) return self.root:FindFirstChild(name) end
	function noise:emitter(name, on)
		for _, d in ipairs(self.model:GetDescendants()) do
			if d:IsA("ParticleEmitter") and d.Name == name then d.Enabled = on end
		end
	end
	function noise:burst(name, count)
		for _, d in ipairs(self.model:GetDescendants()) do
			if d:IsA("ParticleEmitter") and d.Name == name then d:Emit(count) end
		end
	end
	noise.rig.onMarker = function(m) -- its feet on the floor
		local step = noise:sound(if noise.level > 0 then "EnragedFootstep" else "Footstep")
		if step and m.value ~= nil then step:Play() end
	end
	return noise
end

-- Calm or rushing: its colors, its glow, its sounds and icons
local function setLevel(noise, rushing)
	local level = if rushing then 1 else 0
	if noise.level == level then return end
	noise.level = level
	paint(noise.model, level)
	noise.glow.FillColor, noise.glow.OutlineColor = if rushing then BLUE else DEEP, if rushing then PALE else BLUE
	noise.glow.FillTransparency, noise.glow.OutlineTransparency = if rushing then 0.35 else 0.75, 0
	noise.light.Color, noise.light.Brightness, noise.light.Range = BLUE, if rushing then 6 else 2, if rushing then 28 else 16
	noise:emitter("FFIcon", rushing)
	noise:emitter("HijackGlitch", rushing)
	noise:emitter("PlayIcon", not rushing)
	local ff, idle, angry = noise:sound("FastForward"), noise:sound("Idle"), noise:sound("EnragedIdle")
	if ff then if rushing then ff:Play() else ff:Stop() end end
	if idle then if rushing then idle:Stop() else idle:Play() end end
	if angry then if rushing then angry:Play() else angry:Stop() end end
end

-- Blue static over the screen, thicker as it gets closer
local overlay = make("ScreenGui", { Name = "NoiseStatic", IgnoreGuiInset = true, DisplayOrder = 99999, ResetOnSpawn = false, Enabled = false }, hud)
local flash = make("Frame", { Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLUE, BackgroundTransparency = 1, BorderSizePixel = 0 }, overlay)
local dots = {}
for i = 1, 60 do
	dots[i] = make("Frame", { Size = UDim2.fromOffset(math.random(2, 7), math.random(2, 4)), BackgroundColor3 = BLUE, BorderSizePixel = 0,
		BackgroundTransparency = 1 }, overlay)
end
local function shimmer(closeness) -- 0 far, 1 on you
	overlay.Enabled = closeness > 0 or flash.BackgroundTransparency < 1
	for _, d in ipairs(dots) do
		d.Position = UDim2.fromScale(math.random(), math.random())
		d.BackgroundTransparency = 1 - closeness * math.random(30, 90) / 100
	end
end
local function blueFlash(strength)
	overlay.Enabled = true
	flash.BackgroundTransparency = 1 - (strength or 0.8)
	TweenService:Create(flash, TweenInfo.new(0.8), { BackgroundTransparency = 1 }):Play()
end
local function shake(power)
	if mainGame and mainGame.camShaker then pcall(function() mainGame.camShaker:ShakeOnce(power, 14, 0, 0.8) end) end
end

local function scream(noise)
	-- The tape's scream, from it: loud up to 80 studs, still loud well beyond
	oneShot(files.scream, noise.root, { Volume = CONFIG.Volume * 2, RollOffMinDistance = 80, RollOffMaxDistance = 600 })
	local emerge = noise:sound("EnragedEmerge")
	if emerge then emerge:Play() end
	blueFlash(0.6)
end

-- Its own way out: it freezes, its tape goes bad (torn poses, jumps, ghosts, missing pieces), and it shuts off like an old TV:
-- the picture squashes into a line, the line into a dot, the dot goes out
local function fizzle(noise)
	if noise.gone then return end
	noise.gone = true
	noise.rig.anim = nil -- frozen where it is
	for _, name in ipairs({ "Idle", "EnragedIdle", "FastForward", "Footstep", "EnragedFootstep", "Pause" }) do
		local s = noise:sound(name)
		if s then s:Stop() end
	end
	for _, name in ipairs({ "Rewind", "Fizzle" }) do
		local s = noise:sound(name)
		if s then s:Play() end
	end
	for _, name in ipairs({ "PlayIcon", "PauseIcon", "FFIcon" }) do noise:emitter(name, false) end
	noise:emitter("HijackGlitch", true)
	noise:emitter("FizzleParticle", true)
	noise.glow.OutlineTransparency = 0
	shimmer(0)
	task.spawn(function()
		local model, root = noise.model, noise.root
		local base = root.CFrame
		local parts, motors, rest = {}, {}, {}
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and d ~= root then table.insert(parts, d) end
			if d:IsA("Motor6D") then
				table.insert(motors, d)
				rest[d] = d.Transform
			end
		end
		-- Two ghosts, as when the tape slips: see-through copies of it, frozen in its pose
		local ghosts = {}
		for i = 1, 2 do
			local ghost = model:Clone()
			local pieces = {}
			for _, d in ipairs(ghost:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored, d.Material, d.Color, d.Transparency = true, Enum.Material.Neon, if i == 1 then BLUE else PALE, 1
					table.insert(pieces, d)
				elseif not d:IsA("Attachment") and not d:IsA("Model") then
					d:Destroy()
				end
			end
			ghost.Name = "NoiseGhost"
			ghost.Parent = folder
			ghosts[i] = { model = ghost, parts = pieces }
		end
		task.wait(0.15)
		local t0 = os.clock()
		while alive and model.Parent and os.clock() - t0 < 1.3 do
			local k = (os.clock() - t0) / 1.3 -- worse and worse
			for _, m in ipairs(motors) do
				m.Transform = if math.random() < 0.3 + k * 0.5 then rest[m] * CFrame.Angles(rnd(0.3 + k), rnd(0.3 + k), rnd(0.3 + k)) else rest[m]
			end
			local jump = if math.random() < 0.15 + k * 0.2 then base.RightVector * rnd(1) * (1.5 + math.random() * 2) else Vector3.new()
			root.CFrame = base + jump + Vector3.new(rnd(0.3), rnd(0.15), rnd(0.3))
			for _, p in ipairs(parts) do p.LocalTransparencyModifier = if math.random() < 0.15 + k * 0.45 then 1 else 0 end
			noise.glow.FillColor = ({ BLUE, PALE, DEEP })[math.random(3)]
			noise.glow.FillTransparency = math.random() * 0.6
			for i, ghost in ipairs(ghosts) do
				local shown = math.random() < 0.5
				for _, p in ipairs(ghost.parts) do p.Transparency = if shown then 0.5 + math.random() * 0.35 else 1 end
				if shown then ghost.model:PivotTo(base * CFrame.new((if i == 1 then -1 else 1) * (0.5 + math.random() * 1.2), rnd(0.2), 0)) end
			end
			if math.random() < 0.3 then noise:burst("PauseBlack", 4) end
			task.wait(1 / 20)
		end
		for _, ghost in ipairs(ghosts) do ghost.model:Destroy() end
		if not (alive and model.Parent) then return end
		-- Off: the picture squashes into a bright line, the line into a dot, the dot goes out
		for _, p in ipairs(parts) do p.LocalTransparencyModifier = 1 end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("ParticleEmitter") then d.Enabled = false end
		end
		noise.glow.FillTransparency, noise.glow.OutlineTransparency = 1, 1
		local wind = noise:sound("WindDown")
		if wind then wind:Play() end
		local center = base.Position + Vector3.new(0, 0.6, 0)
		local line = make("Part", { Name = "NoiseOff", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
			Material = Enum.Material.Neon, Color = PALE, Size = Vector3.new(2.6, 5, 0.05) }, folder)
		make("PointLight", { Color = BLUE, Brightness = 5, Range = 14 }, line)
		local s0 = os.clock()
		while alive and os.clock() - s0 < 0.55 do
			local u = os.clock() - s0
			local w, h
			if u < 0.1 then -- the picture squashes
				w, h = 2.6, 5 - 4.9 * (u / 0.1)
			elseif u < 0.32 then -- the line flares and shrinks to a dot
				local v = (u - 0.1) / 0.22
				w, h = 2.6 * (1 + 0.6 * math.sin(v * math.pi)) * (1 - v) + 0.18 * v, 0.1
			else -- the dot goes out
				w = 0.18 * (1 - (u - 0.32) / 0.23)
				h = w
			end
			line.Size = Vector3.new(math.max(w, 0.01), math.max(h, 0.01), 0.05)
			line.CFrame = CFrame.lookAt(center, workspace.CurrentCamera.CFrame.Position)
			RunService.Heartbeat:Wait()
		end
		line:Destroy()
		task.wait(0.4) -- its last sounds
		model:Destroy()
	end)
end

