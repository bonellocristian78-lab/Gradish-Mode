local SMOKE = "rbxasset://textures/particles/smoke_main.dds" -- Roblox's own
-- On the floor: glass everywhere, a cloud of dust, its back and buttons come off, a last blue spark, thin smoke for a while
local function crash(at, inward)
	for _, id in ipairs({ SOUNDS.glass, SOUNDS.crack, SOUNDS.bulb }) do
		oneShot(id, tvMain, { Volume = CONFIG.Volume * 1.6, PlaybackSpeed = 0.8 })
	end
	shards(at + Vector3.new(0, 0.6, 0), Vector3.new(0, 1, 0), 26)
	if sparks then sparks:Emit(40) end
	loose(tvMain:FindFirstChild("TVBack"), inward * 7 + Vector3.new(rnd(3), 9, rnd(3)))
	loose(tvMain:FindFirstChild("TVButtons"), inward * 4 + Vector3.new(rnd(6), 12, rnd(6)))
	local holder = make("Part", { Name = "Dust", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1,
		Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(at) }, folder)
	make("ParticleEmitter", { Texture = SMOKE, Rate = 0, Lifetime = NumberRange.new(1.2, 2.4), Speed = NumberRange.new(3, 9),
		SpreadAngle = Vector2.new(85, 85), Drag = 3, Size = NumberSequence.new(1.5, 5), Transparency = NumberSequence.new(0.35, 1),
		Color = ColorSequence.new(Color3.fromRGB(120, 125, 140)), Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-40, 40) }, holder):Emit(30)
	make("ParticleEmitter", { Texture = SMOKE, Rate = 5, Lifetime = NumberRange.new(2, 3.5), Speed = NumberRange.new(1, 2),
		SpreadAngle = Vector2.new(15, 15), Acceleration = Vector3.new(0, 1.5, 0), Size = NumberSequence.new(0.6, 2.6),
		Transparency = NumberSequence.new(0.55, 1), Color = ColorSequence.new(Color3.fromRGB(45, 48, 58)) }, holder)
	local light = make("PointLight", { Color = BLUE, Brightness = 0, Range = 12 }, holder)
	task.spawn(function()
		for _ = 1, 6 do
			light.Brightness = math.random() * 4
			task.wait(0.06 + math.random() * 0.1)
		end
		light.Brightness = 0
	end)
	task.delay(14, function() holder:Destroy() end)
	kick(0.09)
end

-- After the hit it shakes; the left bracket gives and it swings from the right one; after `dangle` seconds that one gives too,
-- it falls, turning onto its back, lands, bounces and breaks more. The hammer stays in it
local function dropTV(dangle)
	local drop = { landed = false }
	local start = tvMain.CFrame
	local box, size = tv:GetBoundingBox()
	local center = start:PointToObjectSpace(box.Position)
	local sx, sy = size.X / 2 - 0.45, size.Y / 2 - 0.35
	local hinge = start * CFrame.new(center + Vector3.new(sx, sy, size.Z / 2)) -- where the right bracket holds it
	local held = hinge:ToObjectSpace(start)
	local hang = math.atan2(sx, sy) -- its middle right under that bracket
	local inward = start.LookVector * Vector3.new(1, 0, 1)
	inward = if inward.Magnitude > 0.01 then inward.Unit else Vector3.new(0, 0, -1)
	local lying = CFrame.Angles(0, rnd(0.4), 0) * CFrame.lookAt(Vector3.new(), inward) * CFrame.Angles(math.pi / 2, 0, 0) -- screen up
	local stuck = stuckOffset()
	local function swing(s) return hang * (1 - math.exp(-1.5 * s) * math.cos(5.4 * s)) end
	local first, fall, creaked, sparkAt = false, nil, false, 0
	local t0 = os.clock()
	local connection
	connection = on(RunService.Heartbeat, function()
		local s = os.clock() - t0
		local cf
		if s < 0.5 then -- the blow
			local k = math.exp(-7 * s)
			cf = start * CFrame.Angles(0.06 * k * math.sin(s * 47), 0, 0.04 * k * math.sin(s * 39))
		elseif s < 0.5 + dangle then -- hanging from one bracket
			if not first then
				first = true
				local mount = folder:FindFirstChild("Mount1")
				if mount then oneShot(SOUNDS.crack, mount, { Volume = CONFIG.Volume, PlaybackSpeed = 1.5 }) end
				loose(mount, Vector3.new(rnd(3), 2, rnd(3)))
				if sparks then sparks:Emit(20) end
			end
			cf = hinge * CFrame.Angles(0, 0, swing(s - 0.5)) * held
			if sparks and os.clock() >= sparkAt then
				sparkAt = os.clock() + 0.2 + math.random() * 0.3
				sparks:Emit(math.random(3, 8))
			end
			if not creaked and s > 1.1 then
				creaked = true
				oneShot(SOUNDS.crack, tvMain, { Volume = CONFIG.Volume * 0.35, PlaybackSpeed = 0.45 })
			end
		else
			if not fall then -- the other bracket gives
				local mount = folder:FindFirstChild("Mount2")
				if mount then oneShot(SOUNDS.crack, mount, { Volume = CONFIG.Volume, PlaybackSpeed = 1.3 }) end
				loose(mount, Vector3.new(rnd(3), 2, rnd(3)))
				local from = hinge * CFrame.Angles(0, 0, swing(dangle)) * held
				local below = from.Position + inward * 1.6
				local floor = floorUnder(below) or (below - Vector3.new(0, 9, 0))
				local to = Vector3.new(below.X, floor.Y + center.Z + size.Z / 2, below.Z) -- its back on the floor
				fall = { from = from, to = to, floor = Vector3.new(below.X, floor.Y, below.Z), time = math.sqrt(2 * math.max(from.Y - to.Y, 0.2) / 80) }
			end
			local f = s - 0.5 - dangle
			if f < fall.time then -- falling, turning onto its back
				local u = f / fall.time
				local p = fall.from.Position:Lerp(fall.to, u)
				cf = CFrame.new(p.X, fall.from.Y - 40 * f * f, p.Z) * fall.from.Rotation:Lerp(lying, u * u)
			else
				if not drop.landed then
					drop.landed = true
					crash(fall.floor, inward)
				end
				local b = f - fall.time
				local hop = 0.4 * math.abs(math.sin(b * 11)) * math.exp(-b * 6)
				cf = CFrame.new(fall.to + Vector3.new(0, hop, 0)) * lying * CFrame.Angles(0.1 * math.exp(-b * 5) * math.sin(b * 20), 0, 0)
				if b > 1.5 then
					cf = CFrame.new(fall.to) * lying
					connection:Disconnect()
				end
			end
		end
		tv:PivotTo(cf)
		setHammer(tvMain.CFrame * stuck)
	end)
	return drop
end

do
	local JOINTS = { root = { "Root", "RootJoint" }, waist = { "Waist" }, neck = { "Neck" }, rS = { "RightShoulder", "Right Shoulder" },
		rE = { "RightElbow" }, rW = { "RightWrist" }, lS = { "LeftShoulder", "Left Shoulder" }, lE = { "LeftElbow" },
		rH = { "RightHip", "Right Hip" }, rK = { "RightKnee" }, lH = { "LeftHip", "Left Hip" }, lK = { "LeftKnee" } }
	local ZERO = { 0, 0, 0 }
	local function ease(u) return u * u * (3 - 2 * u) end
	local EASE = { smooth = ease, out = function(u) return 1 - (1 - u) ^ 3 end, ["in"] = function(u) return u ^ 3 end }
	local function lerpNum(a, b, u) return a + (b - a) * u end
	local function flatDir(from, to)
		local d = (to - from) * Vector3.new(1, 0, 1)
		return if d.Magnitude > 0.01 then d.Unit else Vector3.new(0, 0, -1)
	end
	-- The camera stays on this side of any wall
	local function safe(from, eye)
		if (eye - from).Magnitude < 0.05 then return eye end
		local hit = cast(from, eye - from)
		return if hit then hit.Position + (from - eye).Unit * 0.6 else eye
	end

	-- Your body, pose by pose. Seconds; degrees in each joint's parent, { pitch, yaw, roll }: pitch > 0 lifts an arm or a leg
	-- forward (< 0 bows the waist, bends a knee); yaw > 0 turns left; roll > 0 opens the right arm. `aim`: your head up to the TV
	local GRAB, TOSS, CATCH, TURN, RELEASE = 0.62, 1.15, 1.6, 2.15, 3.195
	local function keys(aim)
		return {
			{ t = 0, pose = {} },
			-- down to it, one knee lower than the other
			{ t = 0.45, pose = { waist = { -40, 0, 0 }, neck = { -30, 0, 0 }, rS = { 62, 0, 10 }, rE = { 22, 0, 0 }, lS = { 18, 0, -12 },
				lE = { 30, 0, 0 }, rH = { 78, 0, 0 }, rK = { -110, 0, 0 }, lH = { 35, 0, 0 }, lK = { -75, 0, 0 } } },
			-- the hand closes on it
			{ t = 0.7, pose = { waist = { -44, 0, 0 }, neck = { -32, 0, 0 }, rS = { 75, 0, 6 }, rE = { 8, 0, 0 }, rW = { -25, 0, 0 },
				lS = { 20, 0, -14 }, lE = { 32, 0, 0 }, rH = { 82, 0, 0 }, rK = { -115, 0, 0 }, lH = { 38, 0, 0 }, lK = { -80, 0, 0 } } },
			-- up, and it goes up in the air, turning once
			{ t = TOSS, ease = "out", pose = { waist = { 4, 0, 0 }, neck = { 18, 0, 0 }, rS = { 70, 0, 12 }, rE = { 75, 0, 0 },
				lS = { 8, 0, -8 }, lE = { 20, 0, 0 } } },
			-- caught
			{ t = CATCH, pose = { rS = { 58, 0, 10 }, rE = { 85, 0, 0 }, lS = { 6, 0, -6 }, lE = { 15, 0, 0 }, rH = { 10, 0, 0 },
				rK = { -18, 0, 0 }, lH = { 10, 0, 0 }, lK = { -18, 0, 0 } } },
			-- turned to the TV, the left hand points at it
			{ t = TURN, pose = { waist = { 0, -15, 0 }, neck = { aim, 15, 0 }, rS = { 120, 0, 25 }, rE = { 95, 0, 0 }, lS = { 85, 0, -5 },
				lE = { 5, 0, 0 }, rH = { -15, 0, 0 }, rK = { -25, 0, 0 }, lH = { 25, 0, 0 }, lK = { -20, 0, 0 } } },
			-- the wind-up: the hammer behind your head, the body twisted back, held
			{ t = 2.7, ease = "out", pose = { waist = { 12, -40, 0 }, neck = { aim, 40, 0 }, rS = { 200, 0, 20 }, rE = { 100, 0, 0 },
				rW = { 30, 0, 0 }, lS = { 95, 0, -10 }, rH = { -20, 0, 0 }, rK = { -38, 0, 0 }, lH = { 32, 0, 0 }, lK = { -12, 0, 0 } } },
			{ t = 3.05, pose = { waist = { 15, -44, 0 }, neck = { aim, 44, 0 }, rS = { 206, 0, 22 }, rE = { 105, 0, 0 }, rW = { 35, 0, 0 },
				lS = { 98, 0, -10 }, rH = { -22, 0, 0 }, rK = { -42, 0, 0 }, lH = { 34, 0, 0 }, lK = { -12, 0, 0 } } },
			-- the throw: everything forward at once
			{ t = 3.22, ease = "in", pose = { waist = { -22, 32, 0 }, neck = { aim, -28, 0 }, rS = { 85, 0, 8 }, rE = { 8, 0, 0 },
				rW = { -20, 0, 0 }, lS = { 20, 0, -40 }, lE = { 65, 0, 0 }, rH = { -32, 0, 0 }, rK = { -12, 0, 0 }, lH = { 48, 0, 0 },
				lK = { -48, 0, 0 } } },
			-- and through
			{ t = 3.6, ease = "out", pose = { waist = { -30, 40, 0 }, neck = { aim, -32, 0 }, rS = { 28, 0, -24 }, rE = { 25, 0, 0 },
				lS = { 2, 0, -32 }, lE = { 45, 0, 0 }, rH = { -36, 0, 0 }, rK = { -30, 0, 0 }, lH = { 52, 0, 0 }, lK = { -58, 0, 0 } } },
			-- watching it
			{ t = 4.6, pose = { waist = { -4, 12, 0 }, neck = { aim, -8, 0 }, rS = { 10, 0, 0 }, rE = { 18, 0, 0 }, lS = { 6, 0, -4 },
				lE = { 14, 0, 0 }, rH = { -10, 0, 0 }, rK = { -12, 0, 0 }, lH = { 20, 0, 0 }, lK = { -22, 0, 0 } } },
		}
	end
	local function poseAt(list, t)
		local a, b = list[#list], list[#list]
		for i = 2, #list do
			if list[i].t > t then
				a, b = list[i - 1], list[i]
				break
			end
		end
		local u = if b.t > a.t then (EASE[b.ease] or ease)(math.clamp((t - a.t) / (b.t - a.t), 0, 1)) else 1
		local out = {}
		for name in pairs(JOINTS) do
			local p, q = a.pose[name] or ZERO, b.pose[name] or ZERO
			out[name] = { lerpNum(p[1], q[1], u), lerpNum(p[2], q[2], u), lerpNum(p[3], q[3], u) }
		end
		return out
	end

	-- You walk to it, pick it up, toss it once in the air, turn to the TV, wind up and throw it; it flies spinning in slow
	-- motion and hits the screen. The camera tells it like a film
	function throwHammer()
		local character, _, root = body()
		if not character or not hammer or not tvMain or state == "broken" then return end
		local wasState = state
		state = "broken"
		if hammerPrompt then hammerPrompt.Enabled = false end
		local noise = current
		local noiseOut = noise ~= nil and not noise.gone and (wasState == "chase" or wasState == "emerging")
		shimmer(0)
		if noiseOut then -- it pauses, like a tape
			noise.rig.speed = 0
			noise:emitter("PauseIcon", true)
			local pause = noise:sound("Pause")
			if pause then pause:Play() end
		end
		if video then pcall(function() video:Pause() end) video.Visible = false end
		if picture then picture.Visible = true end

		local camera = workspace.CurrentCamera
		local up = Vector3.new(0, 1, 0)
		local startPos = root.Position
		local saved = { type = camera.CameraType, fov = camera.FieldOfView, cframe = camera.CFrame, anchored = root.Anchored,
			stopcam = mainGame and mainGame.stopcam }
		if mainGame then mainGame.stopcam = true end
		root.Anchored = true
		camera.CameraType = Enum.CameraType.Scriptable

		-- Black bars, as in a film
		local bars = make("ScreenGui", { Name = "NoiseCutscene", IgnoreGuiInset = true, DisplayOrder = 99998, ResetOnSpawn = false }, hud)
		local top = make("Frame", { Size = UDim2.fromScale(1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, bars)
		local bottomBar = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, bars)
		for _, bar in ipairs({ top, bottomBar }) do TweenService:Create(bar, TweenInfo.new(0.35), { Size = UDim2.fromScale(1, 0.11) }):Play() end

		-- Your joints, and your legs' lengths to keep your feet on the floor when you bend (R15)
		local joints = {}
		for name, names in pairs(JOINTS) do
			for _, n in ipairs(names) do
				local m = character:FindFirstChild(n, true)
				if m and m:IsA("Motor6D") then
					local q = m.C0.Rotation
					joints[name] = { motor = m, q = q, qi = q:Inverse() }
					break
				end
			end
		end
		local legs = nil
		if joints.rH and joints.rK then
			local ankle = character:FindFirstChild("RightAnkle", true)
			local a = (joints.rK.motor.C0.Position - joints.rH.motor.C1.Position).Magnitude
			local b = if ankle and ankle:IsA("Motor6D") then (ankle.C0.Position - joints.rK.motor.C1.Position).Magnitude else a
			legs = function(hip, knee) return a * math.cos(math.rad(hip)) + b * math.cos(math.rad(hip + knee)) - (a + b) end
		end
		local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm") or root
		local GRIP = CFrame.new(0, if hand.Name == "Right Arm" then -0.9 else -0.2, 0) * CFrame.Angles(-math.pi / 2, 0, 0) * CFrame.new(0, 0.6, 0)

		local hammerAt = hammer.Position
		local toHammer = flatDir(startPos, hammerAt)
		local rootPos, face, pose = startPos, toHammer, {}
		local standAt = Vector3.new(hammerAt.X, startPos.Y, hammerAt.Z) - toHammer * 2
		local walk = (standAt - startPos) * Vector3.new(1, 0, 1)
		if walk:Dot(toHammer) <= 0.05 or cast(startPos, walk) then standAt = startPos end -- already there, or something in the way
		local approach = math.clamp((standAt - startPos).Magnitude / 11, 0, 0.9)
		local toTV = flatDir(standAt, screen.Position)
		local rightTV = toTV:Cross(up)
		local head = (standAt + up * 1.5)
		local aim = math.clamp(math.deg(math.atan2(screen.Position.Y - head.Y, ((screen.Position - head) * Vector3.new(1, 0, 1)).Magnitude)), -20, 50)
		local list = keys(aim)
		local t0, seq = os.clock(), math.huge

		-- The body: where it stands, where it faces, its pose; written after Roblox's animations, before physics
		local function bodyAt(now)
			if now < seq then -- walking to the hammer
				local u = if approach > 0 then math.clamp((now - t0) / approach, 0, 1) else 1
				rootPos = startPos:Lerp(standAt, u)
				local step = math.sin(u * approach * 10) * (1 - u ^ 4)
				pose = { waist = { -8, 0, 0 }, neck = { -20, 0, 0 }, rH = { 30 * step, 0, 0 }, lH = { -30 * step, 0, 0 },
					rK = { -40 * math.max(step, 0), 0, 0 }, lK = { -40 * math.max(-step, 0), 0, 0 }, rS = { -22 * step, 0, 0 },
					lS = { 22 * step, 0, 0 }, rE = { 15, 0, 0 }, lE = { 15, 0, 0 } }
				return
			end
			local t = now - seq
			pose = poseAt(list, t)
			face = toHammer:Lerp(toTV, ease(math.clamp((t - CATCH) / (TURN - CATCH), 0, 1))).Unit
			local lunge = ease(math.clamp((t - 3.1) / 0.3, 0, 1)) * 0.9 -- a step into the throw
			rootPos = if lunge > 0 and not cast(standAt, toTV * 1.4) then standAt + toTV * lunge else standAt
		end
		local writer = on(RunService.PreSimulation or RunService.Stepped, function()
			bodyAt(os.clock())
			local dy = if legs and pose.lH then math.max(legs(pose.lH[1], pose.lK[1]), legs(pose.rH[1], pose.rK[1])) else 0
			for name, j in pairs(joints) do
				local a = pose[name] or ZERO
				local r = CFrame.fromEulerAnglesYXZ(math.rad(a[1]), math.rad(a[2]), math.rad(a[3]))
				if name == "root" then r = CFrame.new(0, dy, 0) * r end
				j.motor.Transform = j.qi * r * j.q
			end
			root.CFrame = CFrame.lookAt(rootPos, rootPos + face)
		end)

		-- The picture: the camera of the moment, the hammer where it is, the TV's static until it breaks
		local shot, carry, broken, staticAt = nil, nil, false, 0
		RunService:BindToRenderStep("NoiseCutscene", Enum.RenderPriority.Last.Value + 2, function(dt)
			local now = os.clock()
			for _, d in ipairs(character:GetDescendants()) do -- seen from outside, even in first person
				if d:IsA("BasePart") or d:IsA("Decal") then d.LocalTransparencyModifier = 0 end
			end
			if carry then setHammer(carry(now)) end
			if not broken and picture and now >= staticAt then
				staticAt = now + 1 / 15
				sheetFrame(picture, math.random(0, 19))
			end
			if shot then
				local cf, fov = shot(now)
				cutShake *= math.exp(-6 * (dt or 1 / 60))
				if cutShake > 0.001 then cf = cf * CFrame.Angles(rnd(cutShake), rnd(cutShake), rnd(cutShake * 0.5)) end
				camera.CFrame, camera.FieldOfView = cf, fov
			end
		end)

		local done = false
		local function restore()
			if done then return end
			done = true
			restoreCutscene = nil
			RunService:UnbindFromRenderStep("NoiseCutscene")
			writer:Disconnect()
			for _, j in pairs(joints) do j.motor.Transform = CFrame.new() end
			camera.CameraType = saved.type
			camera.FieldOfView = saved.fov
			if mainGame then mainGame.stopcam = saved.stopcam end
			if root.Parent then root.Anchored = saved.anchored end
			bars:Destroy()
			tint.Saturation, tint.Contrast = 0, 0
			blur.Size = 0
		end
		restoreCutscene = restore
		local function hold(seconds) -- false: the event was stopped meanwhile
			task.wait(seconds)
			return alive and not done
		end
		local function till(t) -- until that moment of the throw
			while alive and not done and os.clock() - seq < t do RunService.RenderStepped:Wait() end
			return alive and not done
		end

		-- 1. Low on the floor beyond the hammer: you come to it, bend down and take it
		local sideH = toHammer:Cross(up)
		shot = function(now)
			local k = math.clamp((now - t0) / (approach + 1), 0, 1)
			local eye = safe(hammerAt + up * 0.5, hammerAt + toHammer * lerpNum(2.6, 1.9, k) + sideH * 1.7 + up * lerpNum(0.4, 0.7, k))
			return CFrame.lookAt(eye, hammerAt:Lerp(rootPos + up * 0.5, 0.45)) * CFrame.Angles(0, 0, math.rad(9)), lerpNum(64, 54, k)
		end
		if not hold(approach) then return end
		seq = os.clock()
		if not till(GRAB) then return end
		carry = function() return hand.CFrame * GRIP end
		oneShot(SOUNDS.click, root)

		-- 2. Up, and it goes up in the air, turning once, and back into your hand: the camera goes round you
		if not till(1.0) then return end
		local around = os.clock()
		shot = function(now)
			local u = ease(math.clamp((now - around) / 0.75, 0, 1))
			local chest = rootPos + up * 1.6
			local side = CFrame.fromAxisAngle(up, math.rad(lerpNum(40, 10, u))):VectorToWorldSpace(face)
			local eye = safe(chest, chest + side * 4.5 + up * 0.3)
			return CFrame.lookAt(eye, hammer.Position:Lerp(chest + up * 0.8, 0.5)), 52
		end
		if not till(TOSS) then return end
		local tossFrom = hammer.CFrame
		carry = function(now)
			local u = math.clamp((now - seq - TOSS) / (CATCH - TOSS), 0, 1)
			local to = hand.CFrame * GRIP
			local p = tossFrom.Position:Lerp(to.Position, u) + up * (math.sin(u * math.pi) * 1.6)
			return CFrame.new(p) * to.Rotation * CFrame.Angles(-u * math.pi * 2, 0, 0)
		end
		if not till(CATCH) then return end
		carry = function() return hand.CFrame * GRIP end
		oneShot(SOUNDS.click, root, { PlaybackSpeed = 1.3 })

		-- 3. You turn to the TV and point at it: behind your shoulder the camera pulls back while it narrows, so the TV stays the
		-- same size and the room stretches around it
		if not till(1.75) then return end
		local shoulder = safe(standAt + up * 2.3, standAt + rightTV * 1.5 + up * 2.3 - toTV * 2.2)
		local toScreen = (screen.Position - shoulder).Unit
		local base = (screen.Position - shoulder).Magnitude
		local wall = cast(shoulder, -toScreen * 7)
		local back = if wall then math.max((wall.Position - shoulder).Magnitude - 0.6, 0) else 7
		local dolly = os.clock()
		shot = function(now)
			local u = ease(math.clamp((now - dolly) / 0.85, 0, 1))
			local distance = base + back * u
			return CFrame.lookAt(screen.Position - toScreen * distance, screen.Position), 2 * math.deg(math.atan(math.tan(math.rad(30)) * base / distance))
		end
		if hum then hum.Volume = 0.6 * CONFIG.Volume end

		-- 4. The wind-up, from below; the colours drain
		if not till(2.6) then return end
		local hero = os.clock()
		shot = function(now)
			local u = math.clamp((now - hero) / 0.5, 0, 1)
			local eye = safe(standAt + up * 2, standAt + toTV * lerpNum(3.6, 3.2, u) - rightTV * 2.1 + up * 0.35)
			return CFrame.lookAt(eye, rootPos + up * 2.3 - toTV * 0.2) * CFrame.Angles(0, 0, math.rad(-6)), lerpNum(52, 46, u)
		end
		TweenService:Create(tint, TweenInfo.new(0.5), { Saturation = -0.35, Contrast = 0.2 }):Play()

		-- 5. The throw, from behind you: a punch, a blur
		if not till(3.1) then return end
		shot = function(now)
			local eye = safe(standAt + up * 2, standAt - toTV * 3.4 + rightTV * 1.2 + up * 2.6)
			return CFrame.lookAt(eye, screen.Position), lerpNum(50, 76, math.clamp((now - seq - RELEASE) / 0.12, 0, 1))
		end
		if not till(RELEASE) then return end
		carry = nil
		blur.Size = 14
		TweenService:Create(blur, TweenInfo.new(0.35), { Size = 0 }):Play()
		kick(0.02)
		oneShot(SOUNDS.whir, root, { PlaybackSpeed = 2.4, Volume = CONFIG.Volume * 0.5 })

		-- 6. In the air, in slow motion, end over end; the camera turns round it; the last stretch from beside the TV
		local from = hammer.CFrame
		local target = tvMain.CFrame * stuckOffset()
		local distance = (target.Position - from.Position).Magnitude
		local dir = (target.Position - from.Position).Unit
		local axis = dir:Cross(up)
		axis = if axis.Magnitude > 0.01 then axis.Unit else rightTV
		local spins = math.max(2, math.floor(distance / 5)) * math.pi * 2
		local arc = 0.6 + distance * 0.05
		local duration = math.clamp(distance / 8, 1.1, 1.9)
		local launched = os.clock()
		local whir = sound(SOUNDS.whir, { Volume = CONFIG.Volume * 0.7, Looped = true }, hammer)
		if whir then whir:Play() end
		local trail = nil
		pcall(function()
			local a0 = make("Attachment", { Position = Vector3.new(0, 0.8, 0) }, hammer)
			local a1 = make("Attachment", { Position = Vector3.new(0, -0.8, 0) }, hammer)
			trail = make("Trail", { Attachment0 = a0, Attachment1 = a1, Lifetime = 0.3, Color = ColorSequence.new(BLUE),
				Transparency = NumberSequence.new(0.3, 1), LightEmission = 1 }, hammer)
		end)
		carry = function(now)
			local s = math.clamp((now - launched) / duration, 0, 1)
			local u = s + 0.7 * math.sin(2 * math.pi * s) / (2 * math.pi) -- fast, slow, fast
			if whir then whir.PlaybackSpeed = 0.45 + 0.75 * (1 + 0.7 * math.cos(2 * math.pi * s)) end
			local p = from.Position:Lerp(target.Position, u) + up * (math.sin(u * math.pi) * arc)
			local turn = CFrame.fromAxisAngle(axis, spins * (1 - u)) * target.Rotation -- ends exactly as it sticks
			if u < 0.1 then turn = from.Rotation:Lerp(turn, u / 0.1) end
			return CFrame.new(p) * turn
		end
		shot = function(now)
			local s = math.clamp((now - launched) / duration, 0, 1)
			local p = hammer.Position
			local ring = CFrame.fromAxisAngle(dir, math.rad(lerpNum(35, -130, ease(s)))):VectorToWorldSpace(axis * 3.2 + up * 0.5)
			return CFrame.lookAt(safe(p, p + ring - dir * lerpNum(2.2, 0.8, s)), p + dir * 1.2), lerpNum(64, 44, s)
		end
		while alive and not done and os.clock() - launched < duration * 0.86 do RunService.RenderStepped:Wait() end
		local tvLook, tvRight = tvMain.CFrame.LookVector, tvMain.CFrame.RightVector
		local beside = safe(screen.Position + tvLook, screen.Position + tvLook * 4.8 + tvRight * 2.8 - up * 0.9)
		shot = function() return CFrame.lookAt(beside, screen.Position), 50 end
		while alive and not done and os.clock() - launched < duration do RunService.RenderStepped:Wait() end
		if not (alive and not done) then return end
		carry = nil
		setHammer(target)
		if trail then trail.Enabled = false end
		if whir then whir:Destroy() end

		-- 7. The hit: a blink of stillness, the glass bursts, the TV shakes and starts to give
		broken = true
		breakTV()
		blueFlash(0.9)
		kick(0.05)
		tint.Contrast = 0.45
		if not hold(0.12) then return end
		TweenService:Create(tint, TweenInfo.new(0.6), { Contrast = 0.2 }):Play()
		shards(screen.Position + tvLook * 0.4, tvLook, 18)
		for _, name in ipairs({ "Mount1", "Mount2" }) do
			local mount = tv:FindFirstChild(name)
			if mount then mount.Parent = folder end -- they stay on the wall, the TV moves without them
		end
		local tvStart = tvMain.Position
		local drop = dropTV(if noiseOut then 3.2 else 1.8)
		local hit = os.clock()
		shot = function(now)
			local u = ease(math.clamp((now - hit) / 1.1, 0, 1))
			local p = tvMain.Position
			local eye = safe(tvStart + tvLook * 1.5, p + tvLook * lerpNum(4.8, 6.6, u) + tvRight * lerpNum(2.8, 3.2, u) - up * lerpNum(0.9, 1.4, u))
			return CFrame.lookAt(eye, p), lerpNum(50, 58, u)
		end
		if not hold(1.1) then return end

		-- 8. Noise, if it was out: its own end, before your eyes
		if noiseOut and noise.model.Parent then
			local seen = os.clock()
			local spot = (noise.model:FindFirstChild("Head") or noise.root).Position
			local toYou = flatDir(spot, rootPos)
			local side = toYou:Cross(up)
			fizzle(noise)
			shot = function(now)
				local u = ease(math.clamp((now - seen) / 2, 0, 1))
				local eye = safe(spot, spot + toYou * lerpNum(6.5, 5, u) + side * 1.4 + up * 0.5)
				return CFrame.lookAt(eye, spot) * CFrame.Angles(math.noise(now * 3, 1) * 0.03, math.noise(now * 3, 2) * 0.03, 0), 55
			end
			if not hold(2.1) then return end
		end

		-- 9. The TV, from the floor of the room: it hangs from one bracket, the other gives, it falls and breaks
		local flatLook = flatDir(Vector3.new(), tvLook)
		local base9 = tvStart + flatLook * 8 + tvRight * 2.5
		local ground = floorUnder(base9) or (base9 - Vector3.new(0, 8, 0))
		local wide = safe(tvStart + flatLook * 1.5, Vector3.new(base9.X, ground.Y + 1.4, base9.Z))
		shot = function() return CFrame.lookAt(wide, tvMain.Position), 60 end
		local waited = os.clock()
		while alive and not done and not drop.landed and os.clock() - waited < 6 do RunService.RenderStepped:Wait() end
		if not hold(1.3) then return end

		-- 10. Back to you
		local leaving, fov, back10 = camera.CFrame, camera.FieldOfView, os.clock()
		local home = saved.cframe + (rootPos - startPos)
		shot = function(now)
			local u = ease(math.clamp((now - back10) / 0.6, 0, 1))
			return leaving:Lerp(home, u), lerpNum(fov, saved.fov, u)
		end
		for _, bar in ipairs({ top, bottomBar }) do TweenService:Create(bar, TweenInfo.new(0.5), { Size = UDim2.fromScale(1, 0) }):Play() end
		TweenService:Create(tint, TweenInfo.new(0.6), { Saturation = 0, Contrast = 0 }):Play()
		if not hold(0.65) then return end
		restore()
	end
end

---====== RUN ======---

local function run()
	if CONFIG.Time > 0 then task.wait(CONFIG.Time) end
	local t0 = os.clock()
	while not filesReady and os.clock() - t0 < 20 do task.wait(0.1) end
	buildTV()
	if CONFIG.Hammer then
		hammer = makeHammer()
		hammer.Name = "NoiseHammer"
		hammerPrompt = make("ProximityPrompt", { Name = "ThrowPrompt", ActionText = "Throw at the TV", ObjectText = "Hammer",
			HoldDuration = 0.25, MaxActivationDistance = 9, RequiresLineOfSight = false }, hammer)
		if mainGame or LocalPlayer.PlayerGui:FindFirstChild("MainUI") then -- DOORS draws its own prompt: Roblox's would be a second one
			hammerPrompt.Style = Enum.ProximityPromptStyle.Custom
		end
		on(hammerPrompt.Triggered, function() task.spawn(throwHammer) end)
	end
	while alive and not placeTV() do task.wait(1) end
	placeHammer()
	hum = sound(files.static, { Looped = true, Volume = 0.15 * CONFIG.Volume, RollOffMaxDistance = 50 }, screen)
	if hum then hum:Play() end

	-- Waiting: static on the screen; stare at it and the world turns blue
	local seen, room, frame = 0, latestRoom(), 0
	while alive and state == "waiting" do
		local dt = RunService.RenderStepped:Wait()
		if CONFIG.FollowDoors and latestRoom() ~= room then -- a new room: the TV is above its door now
			room = latestRoom()
			placeTV()
			placeHammer()
			seen = 0
		end
		if files.sheets[1] then -- the tape's first second, static, over and over
			frame = (frame + dt * TAPE.fps) % 20
			sheetFrame(picture, math.floor(frame))
		end
		seen = if lookingAt(screen) then seen + dt else math.max(seen - dt * 0.5, 0)
		local p = math.clamp(seen / CONFIG.LookTime, 0, 1)
		if hum then hum.Volume = (0.15 + p * 0.85) * CONFIG.Volume end
		tint.TintColor = Color3.new(1 - p * 0.45, 1 - p * 0.3, 1)
		if seen >= CONFIG.LookTime then break end
	end
	if not alive or state ~= "waiting" then return end
	tint.TintColor = Color3.new(1, 1, 1)
	if playTape() and alive then emerge() end
end

local cleanup = function()
	alive = false
	pcall(function() RunService:UnbindFromRenderStep("NoiseCutscene") end)
	for _, c in ipairs(connections) do c:Disconnect() end
	if restoreCutscene then pcall(restoreCutscene) end
	for _, i in ipairs({ folder, overlay, tint, blur }) do i:Destroy() end
	local bars = hud:FindFirstChild("NoiseCutscene")
	if bars then bars:Destroy() end
end
if getgenv then getgenv().__NoiseCleanup = cleanup end

task.spawn(run)
