local probe = RaycastParams.new()
probe.FilterType = Enum.RaycastFilterType.Exclude
-- A ray that sees the world, not this event's pieces nor you
local function cast(from, direction)
	probe.FilterDescendantsInstances = { folder, LocalPlayer.Character }
	return workspace:Raycast(from, direction, probe)
end
-- The floor under a point (or nil): the ray starts at the point itself, so a ceiling above it is never taken for the floor
local function floorUnder(position)
	local hit = cast(position, Vector3.new(0, -40, 0))
	return hit and hit.Position or nil
end

---====== BLUE: red, and the white of its flash, turned blue ======---

local function blueOf(color, level)
	local _, s, v = color:ToHSV()
	if s < 0.15 and v < 0.85 then return color end -- greys and blacks stay
	return Color3.fromHSV(0.62 - level * 0.02, math.clamp(math.max(s, 0.6) + level * 0.1, 0, 1), math.max(v, 0.5))
end

local function sequenceOf(seq, level)
	local points = {}
	for _, k in ipairs(seq.Keypoints) do table.insert(points, ColorSequenceKeypoint.new(k.Time, blueOf(k.Value, level))) end
	return ColorSequence.new(points)
end

local function paint(model, level)
	for _, d in ipairs(model:GetDescendants()) do
		if d:GetAttribute("KeepColor") then continue end
		if d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") then
			d.Color = sequenceOf(d.Color, level)
		elseif d:IsA("Light") then
			d.Color = blueOf(d.Color, level)
		elseif d:IsA("Texture") then -- its static: black, now blue
			d.Color3 = if level > 0 then BLUE else DEEP
		elseif d:IsA("Decal") then
			d.Color3 = blueOf(d.Color3, level)
		elseif d:IsA("BasePart") then
			d.Color = blueOf(d.Color, level)
		end
	end
end

