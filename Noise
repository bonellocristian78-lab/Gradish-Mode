-- On the TV's own VideoFrame when the executor can feed it the video, otherwise frame by frame
local function playTape()
	state = "tape"
	if hum then hum:Stop() end
	local length = TAPE.frames / TAPE.fps
	local playingVideo = false
	if video and files.webm then
		pcall(function()
			if video.IsLoaded then
				video.Visible, picture.Visible = true, false
				video.Looped = false
				video:Play()
				playingVideo = true
			end
		end)
	end
	local audio = nil
	if not playingVideo then
		pcall(function() game:GetService("ContentProvider"):PreloadAsync({ picture }) end)
		audio = sound(files.tape, { Volume = CONFIG.Volume * 1.6, RollOffMinDistance = 18, RollOffMaxDistance = 160 }, screen)
		if audio then audio:Play() end
	end
	local lights = {}
	for _, light in ipairs(screen:GetDescendants()) do
		if light:IsA("Light") then table.insert(lights, light) end
	end
	local start, screamed = os.clock(), false
	while alive and state == "tape" and os.clock() - start < length do
		local t = os.clock() - start
		if not playingVideo then sheetFrame(picture, math.floor(t * TAPE.fps)) end
		local glow = 0.5 + math.random() * 0.6
		for _, light in ipairs(lights) do light.Color, light.Brightness = BLUE, glow end
		tint.TintColor = Color3.new(1 - math.min(t / length, 1) * 0.3, 1 - math.min(t / length, 1) * 0.2, 1)
		if not screamed and t > 7.4 then -- the scream: the room's lights flicker, the camera shakes
			screamed = true
			shake(4)
			pcall(function()
				local events = require(game:GetService("ReplicatedStorage").ModulesClient.Module_Events)
				events.flicker(roomModel(), 1.5)
			end)
		end
		RunService.RenderStepped:Wait()
	end
	if audio then audio:Destroy() end
	if video then pcall(function() video:Pause() end) end
	tint.TintColor = Color3.new(1, 1, 1)
	return state == "tape" -- false: the TV was broken meanwhile
end

---====== THE CHASE ======---

-- It walks your steps: every stud you move is a crumb, and it goes from crumb to crumb
local function chase(noise)
	local _, _, root = body()
	if not root then return end
	state = "chase"
	local crumbs, cursor = { root.Position }, 1
	local started, startRoom = os.clock(), latestRoom()
	local rushing, lastScream, shimmerAt, still = false, -math.huge, 0, false
	setLevel(noise, false)
	noise.rig:play(noise.anims.Walk, 1)

	local function pathLength(target)
		local total, last = 0, noise.position
		for i = cursor, #crumbs do
			total += (crumbs[i] - last).Magnitude
			last = crumbs[i]
		end
		return total + (target - last).Magnitude
	end

	while alive and state == "chase" and not noise.gone do
		local dt = RunService.Heartbeat:Wait()
		local _, humanoid, liveRoot = body()
		local room = latestRoom()
		if not liveRoot or liveRoot ~= root or os.clock() - started > CONFIG.ChaseTime
			or (room and startRoom and room >= startRoom + CONFIG.ChaseRooms) then
			fizzle(noise) -- you died, or got away
			break
		end
		local here = root.Position
		if (here - crumbs[#crumbs]).Magnitude > 1 then table.insert(crumbs, here) end
		if cursor > 200 then -- forget the steps it has already walked
			crumbs = table.move(crumbs, cursor, #crumbs, 1, {})
			cursor = 1
		end

		local distance = pathLength(here)
		if not rushing and distance > CONFIG.FarDistance and os.clock() - lastScream > CONFIG.ScreamCooldown then
			rushing, lastScream = true, os.clock()
			scream(noise)
			noise.rig:play(noise.anims.HijackWalk or noise.anims.Walk, 1.6)
		elseif rushing and distance < CONFIG.CloseDistance then
			rushing = false
			noise.rig:play(noise.anims.Walk, 1)
		end
		setLevel(noise, rushing)

		-- As fast as you, a hair slower; slower still while you stand still; faster when it rushes
		local yours = humanoid.WalkSpeed
		local moving = humanoid.MoveDirection.Magnitude > 0.1 or (root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude > 1
		if moving == still then -- you stopped (or went on): its pause icon says so
			still = not moving
			noise:emitter("PauseIcon", still)
			local pause = noise:sound("Pause")
			if still and pause then pause:Play() end
		end
		local speed = if rushing then yours + CONFIG.Rush
			elseif moving then yours + CONFIG.SpeedOffset
			else yours + CONFIG.SpeedOffset - CONFIG.StillSlowdown
		if not rushing then noise.rig.speed = math.clamp(speed / 14, 0.5, 1.6) end
		local budget = math.max(speed, 1) * dt
		local facing = nil
		while budget > 0 do
			local target = crumbs[cursor] or here
			local step = target - noise.position
			if step.Magnitude <= budget then
				noise.position = target
				budget -= step.Magnitude
				if not crumbs[cursor] then break end
				cursor += 1
			else
				noise.position += step.Unit * budget
				budget = 0
			end
			if step.Magnitude > 0.05 then facing = step end
		end
		-- Its feet on the floor where yours were: your root's height minus your legs, plus its own
		local flat = facing and facing * Vector3.new(1, 0, 1)
		if flat and flat.Magnitude > 0.05 then noise.look = flat.Unit end
		local legs = if humanoid.RigType == Enum.HumanoidRigType.R6 then 2 else (humanoid.HipHeight or 2)
		local at = Vector3.new(noise.position.X, noise.position.Y - root.Size.Y / 2 - legs + noise.hip, noise.position.Z)
		noise.root.CFrame = CFrame.lookAt(at, at + (noise.look or Vector3.new(0, 0, -1)))

		if (here - noise.position).Magnitude < CONFIG.KillDistance then
			-- Caught: it turns to you, the jumpscare, and you are gone
			state = "done"
			noise.rig:play(noise.anims.Jumpscare, 2)
			local kill = noise:sound("KillPlayer")
			if kill then kill:Play() end
			if os.clock() - lastScream > 1 then scream(noise) end
			blueFlash(0.9)
			shake(8)
			task.delay(0.6, function() humanoid.Health = 0 end)
			task.delay(2.2, fizzle, noise)
			break
		end
		if os.clock() >= shimmerAt then -- 20 times a second is plenty for static
			shimmerAt = os.clock() + 0.05
			shimmer(math.clamp(1 - distance / 40, 0, 1) * 0.8)
		end
	end
	if state == "chase" then state = "done" end
end

-- Out of the TV: on the floor in front of it, crawling out with its Emerge animation
local function emerge()
	state = "emerging"
	local noise = makeNoise()
	current = noise
	local front = screen.CFrame * CFrame.new(0, 0, -4) -- the kit welds it 4 studs in front of the screen
	local floor = floorUnder(front.Position) or (front.Position - Vector3.new(0, 6, 0))
	local look = screen.CFrame.LookVector * Vector3.new(1, 0, 1)
	noise.look = if look.Magnitude > 0.01 then look.Unit else Vector3.new(0, 0, -1)
	local at = Vector3.new(front.Position.X, floor.Y + noise.hip, front.Position.Z)
	noise.root.CFrame = CFrame.lookAt(at, at + noise.look)
	noise.position = Vector3.new(at.X, at.Y - noise.hip + 3, at.Z) -- where your root would be, there
	noise.model.Parent = folder
	setLevel(noise, false)
	noise:burst("FlashParticle", 40)
	local sfx = noise:sound("Emerge")
	if sfx then sfx:Play() end
	blueFlash(0.5)
	shake(5)
	if noise.anims.Emerge then
		noise.rig:play(noise.anims.Emerge, CONFIG.EmergeSpeed)
		local t0 = os.clock()
		while alive and state == "emerging" and not noise.rig.done and os.clock() - t0 < 12 do task.wait(0.05) end
	else
		task.wait(1)
	end
	if alive and state == "emerging" then chase(noise) end
end

---====== THE HAMMER: a cutscene, and the TV breaks ======---

local function breakTV()
	local glass = tvMain:FindFirstChild("BrokenScreen")
	if glass then
		glass.Transparency = 0
		local decal = glass:FindFirstChildOfClass("Decal")
		if decal then decal.Transparency = 0 end
	end
	if picture then picture.Visible = false end
	if video then pcall(function() video:Pause() end) video.Visible = false end
	screen.Transparency = 1
	for _, light in ipairs(screen:GetDescendants()) do
		if light:IsA("Light") then light.Enabled = false end
	end
	if hum then hum:Stop() end
	local sparks = make("ParticleEmitter", { Name = "Sparks", Enabled = false, Rate = 0, Lifetime = NumberRange.new(0.3, 0.8),
		Speed = NumberRange.new(8, 18), SpreadAngle = Vector2.new(70, 70), Acceleration = Vector3.new(0, -40, 0),
		Size = NumberSequence.new(0.15, 0), Color = ColorSequence.new(PALE), LightEmission = 1 }, screen)
	sparks:Emit(45)
	for _, id in ipairs({ SOUNDS.glass, SOUNDS.crack, SOUNDS.bulb }) do oneShot(id, tvMain, { Volume = CONFIG.Volume * 1.4 }) end
	tint.TintColor = Color3.new(1, 1, 1)
end

do
	local function joint(character, names)
		for _, name in ipairs(names) do
			local m = character:FindFirstChild(name, true)
			if m and m:IsA("Motor6D") then return m end
		end
		return nil
	end
	local function ease(u) return u * u * (3 - 2 * u) end
	local function lerpNum(a, b, u) return a + (b - a) * u end

	-- You pick it up, wind up and throw it into the screen; the camera tells it like a film
	function throwHammer()
		local character, humanoid, root = body()
		if not character or not hammer or not tvMain or state == "broken" then return end
		local wasState = state
		state = "broken"
		if hammerPrompt then hammerPrompt.Enabled = false end
		local camera = workspace.CurrentCamera
		local saved = { type = camera.CameraType, fov = camera.FieldOfView, cframe = camera.CFrame, anchored = root.Anchored,
			stopcam = mainGame and mainGame.stopcam }
		if mainGame then mainGame.stopcam = true end
		root.Anchored = true
		camera.CameraType = Enum.CameraType.Scriptable

		-- Black bars, as in a film
		local bars = make("ScreenGui", { Name = "NoiseCutscene", IgnoreGuiInset = true, DisplayOrder = 99998, ResetOnSpawn = false }, hud)
		local top = make("Frame", { Size = UDim2.fromScale(1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, bars)
		local bottomBar = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, bars)
		for _, bar in ipairs({ top, bottomBar }) do TweenService:Create(bar, TweenInfo.new(0.4), { Size = UDim2.fromScale(1, 0.11) }):Play() end

		local up = Vector3.new(0, 1, 0)
		local start = root.Position
		local hammerAt = hammer.Position
		local target = tvMain.CFrame * stuckOffset()
		local function flatDir(from, to)
			local d = (to - from) * Vector3.new(1, 0, 1)
			return if d.Magnitude > 0.01 then d.Unit else Vector3.new(0, 0, -1)
		end
		local toHammer, toTV = flatDir(start, hammerAt), flatDir(start, target.Position)
		local sideHammer = toHammer:Cross(up)
		local right = toTV:Cross(up)
		local waist = joint(character, { "Waist", "RootJoint" })
		local shoulder = joint(character, { "RightShoulder", "Right Shoulder" })
		local elbow = joint(character, { "RightElbow" })
		local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm") or root
		local held = false
		local shot = nil -- the camera of the moment: a function of t
		local t0 = os.clock()
		local pose = { waist = 0, shoulder = 0, elbow = 0, yaw = toHammer }

		-- The body: written after Roblox's animations, before physics
		local poseConnection = on(RunService.PreSimulation or RunService.Stepped, function()
			if waist then waist.Transform = CFrame.Angles(math.rad(pose.waist), 0, 0) end
			if shoulder then shoulder.Transform = CFrame.Angles(math.rad(pose.shoulder), 0, 0) end
			if elbow then elbow.Transform = CFrame.Angles(math.rad(pose.elbow), 0, 0) end
		end)
		RunService:BindToRenderStep("NoiseCutscene", Enum.RenderPriority.Last.Value + 2, function()
			local t = os.clock() - t0
			for _, d in ipairs(character:GetDescendants()) do -- seen from outside, even in first person
				if d:IsA("BasePart") or d:IsA("Decal") then d.LocalTransparencyModifier = 0 end
			end
			root.CFrame = CFrame.lookAt(root.Position, root.Position + pose.yaw)
			if held then hammer.CFrame = hand.CFrame * CFrame.new(0, -0.9, 0) * CFrame.Angles(-math.pi / 2, 0, 0) end
			if shot then
				local cf, fov = shot(t)
				camera.CFrame, camera.FieldOfView = cf, fov
			end
		end)
		local function phase(seconds, fn) -- fn(u) every frame for that long
			local from = os.clock()
			repeat
				local u = math.clamp((os.clock() - from) / seconds, 0, 1)
				fn(u)
				RunService.RenderStepped:Wait()
			until u >= 1 or not alive
		end

		-- 1. Down to the floor: a low shot by the hammer
		shot = function(t)
			local u = math.clamp(t / 1, 0, 1)
			local eye = hammerAt + sideHammer * lerpNum(3.4, 2.6, u) + up * lerpNum(0.8, 1.2, u) - toHammer * 0.5
			return CFrame.lookAt(eye, hammerAt:Lerp(start + up, 0.35)), 62
		end
		phase(0.9, function(u)
			local e = ease(u)
			pose.waist, pose.shoulder, pose.elbow = -50 * e, 55 * e, 15 * e
		end)
		held = true
		oneShot(SOUNDS.click, root)

		-- 2. Up, a turn to the TV, the arm back: over the shoulder
		shot = function(t)
			local u = math.clamp((t - 0.9) / 1.6, 0, 1)
			local eye = start + right * lerpNum(2.6, 1.9, u) + up * lerpNum(2.4, 2.8, u) - toTV * lerpNum(4.8, 3.6, u)
			return CFrame.lookAt(eye, target.Position), lerpNum(70, 56, ease(u))
		end
		phase(0.7, function(u)
			local e = ease(u)
			pose.waist, pose.shoulder, pose.elbow = -50 * (1 - e), 55 * (1 - e), 15 * (1 - e)
			pose.yaw = toHammer:Lerp(toTV, e).Unit
		end)
		phase(0.75, function(u)
			local e = ease(u)
			pose.waist, pose.shoulder, pose.elbow = 18 * e, 205 * e, 70 * e -- the wind-up, behind the head
		end)
		task.wait(0.12)

		-- 3. The throw: the arm comes down, the hammer leaves
		phase(0.14, function(u)
			pose.waist, pose.shoulder, pose.elbow = lerpNum(18, -25, u), lerpNum(205, 50, u), lerpNum(70, 5, u)
		end)
		held = false
		local from = hammer.Position
		local flight = math.clamp((target.Position - from).Magnitude / 30, 0.7, 1.4) -- slow motion
		local height = 1.2 + (target.Position - from).Magnitude * 0.06
		local dir = (target.Position - from).Unit
		local launched = os.clock() - t0
		shot = function(t)
			local u = math.clamp((t - launched) / flight, 0, 1)
			local p = hammer.Position
			local eye = p - dir * lerpNum(3.4, 4.6, u) + up * 0.9 + right * 0.7
			return CFrame.lookAt(eye, p + dir * 2) * CFrame.Angles(0, 0, math.rad(6 * math.sin(u * math.pi))), lerpNum(58, 42, u)
		end
		local whir = sound(SOUNDS.whir, { PlaybackSpeed = 1.8, Volume = CONFIG.Volume * 0.8, Looped = true }, hammer)
		if whir then whir:Play() end
		local trail = nil
		pcall(function()
			local a0 = make("Attachment", { Position = Vector3.new(0, 0.8, 0) }, hammer)
			local a1 = make("Attachment", { Position = Vector3.new(0, -0.8, 0) }, hammer)
			trail = make("Trail", { Attachment0 = a0, Attachment1 = a1, Lifetime = 0.25, Color = ColorSequence.new(BLUE),
				Transparency = NumberSequence.new(0.3, 1), LightEmission = 1 }, hammer)
		end)
		phase(flight, function(u)
			local p = from:Lerp(target.Position, u) + up * (math.sin(u * math.pi) * height)
			local spin = CFrame.Angles(-u * math.pi * 5, 0, 0) -- end over end
			hammer.CFrame = CFrame.lookAt(p, p + dir) * spin
		end)
		hammer.CFrame = target
		if trail then trail.Enabled = false end
		if whir then whir:Destroy() end

		-- 4. Impact: glass, sparks, a flash, the camera shakes
		breakTV()
		blueFlash(0.7)
		shake(10)
		local hit = os.clock() - t0
		local tvLook, tvRight = tvMain.CFrame.LookVector, tvMain.CFrame.RightVector
		shot = function(t)
			local u = math.clamp((t - hit) / 1.2, 0, 1)
			local trembling = if u < 0.4 then (0.4 - u) * 0.6 else 0
			local jitter = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * trembling
			local eye = screen.Position + tvLook * lerpNum(5, 6.5, u) + tvRight * 2.2 + up * 0.4 + jitter
			return CFrame.lookAt(eye, screen.Position), lerpNum(48, 64, ease(u))
		end
		pose.waist, pose.shoulder, pose.elbow = 0, 0, 0
		task.wait(1.2)

		-- 5. Noise, if it was out: it fizzles before your eyes
		local noise = current
		if noise and not noise.gone and (wasState == "chase" or wasState == "emerging") then
			local seen = os.clock() - t0
			local head = noise.model:FindFirstChild("Head") or noise.root
			shot = function(t)
				local u = math.clamp((t - seen) / 1.6, 0, 1)
				local p = head.Position
				local toYou = flatDir(p, start)
				local side = toYou:Cross(up)
				return CFrame.lookAt(p + toYou * lerpNum(7, 5.5, u) + side * 1.5 + up * 0.6, p), 55
			end
			fizzle(noise)
			task.wait(1.6)
		end

		-- 6. Back to you
		local leaving = camera.CFrame
		local fov = camera.FieldOfView
		local back = os.clock() - t0
		shot = function(t)
			local u = ease(math.clamp((t - back) / 0.6, 0, 1))
			return leaving:Lerp(saved.cframe, u), lerpNum(fov, saved.fov, u)
		end
		for _, bar in ipairs({ top, bottomBar }) do TweenService:Create(bar, TweenInfo.new(0.5), { Size = UDim2.fromScale(1, 0) }):Play() end
		task.wait(0.65)
		RunService:UnbindFromRenderStep("NoiseCutscene")
		poseConnection:Disconnect()
		for _, m in ipairs({ waist, shoulder, elbow }) do
			if m then m.Transform = CFrame.identity end
		end
		camera.CameraType = saved.type
		camera.FieldOfView = saved.fov
		if mainGame then mainGame.stopcam = saved.stopcam end
		if root.Parent then root.Anchored = saved.anchored end
		bars:Destroy()
		if humanoid.Health > 0 then state = "broken" end
	end
end

---====== RUN ======---

local function run()
	if CONFIG.Time > 0 then task.wait(CONFIG.Time) end
	local t0 = os.clock()
	while not filesReady and os.clock() - t0 < 20 do task.wait(0.1) end
	buildTV()
	if CONFIG.Hammer then
		hammer = makeHammer()
		hammer.Name = "NoiseHammer"
		hammerPrompt = make("ProximityPrompt", { Name = "ThrowPrompt", ActionText = "Throw at the TV", ObjectText = "Hammer",
			HoldDuration = 0.25, MaxActivationDistance = 9, RequiresLineOfSight = false }, hammer)
		on(hammerPrompt.Triggered, function() task.spawn(throwHammer) end)
	end
	while alive and not placeTV() do task.wait(1) end
	placeHammer()
	hum = sound(files.static, { Looped = true, Volume = 0.15 * CONFIG.Volume, RollOffMaxDistance = 50 }, screen)
	if hum then hum:Play() end

	-- Waiting: static on the screen; stare at it and the world turns blue
	local seen, room, frame = 0, latestRoom(), 0
	while alive and state == "waiting" do
		local dt = RunService.RenderStepped:Wait()
		if CONFIG.FollowDoors and latestRoom() ~= room then -- a new room: the TV is above its door now
			room = latestRoom()
			placeTV()
			placeHammer()
			seen = 0
		end
		if files.sheets[1] then -- the tape's first second, static, over and over
			frame = (frame + dt * TAPE.fps) % 20
			sheetFrame(picture, math.floor(frame))
		end
		seen = if lookingAt(screen) then seen + dt else math.max(seen - dt * 0.5, 0)
		local p = math.clamp(seen / CONFIG.LookTime, 0, 1)
		if hum then hum.Volume = (0.15 + p * 0.85) * CONFIG.Volume end
		tint.TintColor = Color3.new(1 - p * 0.45, 1 - p * 0.3, 1)
		if seen >= CONFIG.LookTime then break end
	end
	if not alive or state ~= "waiting" then return end
	tint.TintColor = Color3.new(1, 1, 1)
	if playTape() and alive then emerge() end
end

local cleanup = function()
	alive = false
	pcall(function() RunService:UnbindFromRenderStep("NoiseCutscene") end)
	for _, c in ipairs(connections) do c:Disconnect() end
	for _, i in ipairs({ folder, overlay, tint }) do i:Destroy() end
	local bars = hud:FindFirstChild("NoiseCutscene")
	if bars then bars:Destroy() end
end
if getgenv then getgenv().__NoiseCleanup = cleanup end

task.spawn(run)
