---====== PLAYING THE KIT'S ANIMATIONS: its KeyframeSequences, joint by joint (any game) ======---

local STYLE = { Linear = "Linear", Cubic = "Cubic", CubicV2 = "Cubic", Elastic = "Elastic", Bounce = "Bounce" }

local function prepare(kfs)
	local joints, markers, length = {}, {}, 0
	local frames = kfs:GetKeyframes()
	table.sort(frames, function(a, b) return a.Time < b.Time end)
	for _, frame in ipairs(frames) do
		length = math.max(length, frame.Time)
		for _, d in ipairs(frame:GetDescendants()) do
			if d:IsA("Pose") and d.Weight > 0 then
				joints[d.Name] = joints[d.Name] or {}
				table.insert(joints[d.Name], { t = frame.Time, cf = d.CFrame, style = d.EasingStyle.Name, dir = d.EasingDirection.Name })
			elseif d:IsA("KeyframeMarker") then
				table.insert(markers, { t = frame.Time, value = d.Value })
			end
		end
	end
	return { joints = joints, markers = markers, length = length, looped = kfs.Loop }
end

local function poseOf(list, time)
	local a, b = list[1], nil
	for i = 2, #list do
		if list[i].t <= time then a = list[i] else b = list[i] break end
	end
	if not b or a.style == "Constant" or time <= a.t then return a.cf end
	local dir = a.dir -- the old styles have In and Out swapped, as in Roblox
	if a.style ~= "CubicV2" and a.style ~= "Linear" then dir = if dir == "In" then "Out" elseif dir == "Out" then "In" else dir end
	local alpha = TweenService:GetValue((time - a.t) / (b.t - a.t), Enum.EasingStyle[STYLE[a.style] or "Linear"], Enum.EasingDirection[dir])
	return a.cf:Lerp(b.cf, alpha)
end

-- A rig that plays one prepared animation at a time; onMarker hears its KeyframeMarkers
local function newRig(model)
	local rig = { motors = {}, anim = nil, time = 0, speed = 1, done = true, onMarker = nil }
	for _, m in ipairs(model:GetDescendants()) do
		if m:IsA("Motor6D") and m.Part1 then rig.motors[m.Part1.Name] = m end
	end
	function rig:play(anim, speed)
		if not anim then return end
		if self.anim ~= anim then self.time = 0 end
		self.anim, self.speed, self.done = anim, speed or 1, false
	end
	function rig:step(dt)
		local a = self.anim
		if not a or self.done then return end
		local before = self.time
		self.time += dt * self.speed -- a negative speed plays it backwards
		local wrapped = false
		if self.time >= a.length or self.time < 0 then
			if a.looped and a.length > 0 then
				self.time %= a.length
				wrapped = true
			else
				self.time, self.done = math.clamp(self.time, 0, a.length), true
			end
		end
		if self.onMarker and self.speed > 0 then
			for _, m in ipairs(a.markers) do
				if (not wrapped and m.t > before and m.t <= self.time) or (wrapped and (m.t > before or m.t <= self.time)) then
					self.onMarker(m)
				end
			end
		end
		for name, list in pairs(a.joints) do
			local motor = self.motors[name]
			if motor then motor.Transform = poseOf(list, self.time) end
		end
	end
	return rig
end

---====== NOISE ======---

local current = nil -- the Noise of now

-- Noise as it chases you ("NoiseModel", B-90 in it), or another of the kit's bodies ("NoiseModel(WithoutB-90)")
local function makeNoise(name)
	local source = piece(name or "NoiseModel")
	local anims = {}
	local model
	if source then
		model = source:Clone()
		local saves = model:FindFirstChild("AnimSaves")
		for _, name in ipairs({ "Emerge", "Walk", "HijackWalk", "Jumpscare" }) do
			local kfs = saves and saves:FindFirstChild(name)
			if kfs then anims[name] = prepare(kfs) end
		end
		if saves then saves:Destroy() end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("Sound") and d.SoundId == "" and type(d:GetAttribute("id")) == "string" then d.SoundId = d:GetAttribute("id") end
		end
		clean(model, true)
	else -- built: a black shape in blue light, with sparks
		model = Instance.new("Model")
		local root = make("Part", { Name = "HumanoidRootPart", Size = Vector3.new(2, 2.4, 1), Transparency = 1 }, model)
		local core = make("Part", { Name = "Core", Size = Vector3.new(2.4, 5, 1.2), Color = Color3.new(0, 0, 0), Material = Enum.Material.Neon }, model)
		make("WeldConstraint", { Part0 = root, Part1 = core }, core)
		make("ParticleEmitter", { Name = "NoiseStatic", Rate = 60, Lifetime = NumberRange.new(0.2, 0.5), Speed = NumberRange.new(2, 6),
			SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.25, 0), Color = ColorSequence.new(BLUE), LightEmission = 1 }, core)
		make("PointLight", { Name = "PointLight", Range = 16 }, root)
		make("Highlight", { Name = "Highlight" }, model)
		model.PrimaryPart = root
	end
	model.Name = "Noise"
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = p == root, false, false, false, true end
	end
	paint(model, 0)
	local box, size = model:GetBoundingBox()
	local noise = { model = model, root = root, anims = anims, rig = newRig(model), level = -1,
		hip = root.Position.Y - (box.Y - size.Y / 2), -- how high its root stands above the floor
		glow = model:FindFirstChildOfClass("Highlight") or make("Highlight", {}, model),
		light = root:FindFirstChildWhichIsA("PointLight") or make("PointLight", { Range = 16 }, root) }
	noise.glow.DepthMode = Enum.HighlightDepthMode.Occluded
	noise.textures = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Texture") then table.insert(noise.textures, d) end
	end
	noise.light.Shadows = false
	function noise:sound(name) return self.root:FindFirstChild(name) end
	function noise:emitter(name, on)
		for _, d in ipairs(self.model:GetDescendants()) do
			if d:IsA("ParticleEmitter") and d.Name == name then d.Enabled = on end
		end
	end
	function noise:burst(name, count)
		for _, d in ipairs(self.model:GetDescendants()) do
			if d:IsA("ParticleEmitter") and d.Name == name then d:Emit(count) end
		end
	end
	noise.rig.onMarker = function(m) -- its feet on the floor
		local step = noise:sound(if noise.level > 0 then "EnragedFootstep" else "Footstep")
		if step and m.value ~= nil then step:Play() end
	end
	return noise
end

-- Calm or rushing: its colors, its glow, its sounds and icons
local function setLevel(noise, rushing)
	local level = if rushing then 1 else 0
	if noise.level == level then return end
	noise.level = level
	paint(noise.model, level)
	noise.glow.FillColor, noise.glow.OutlineColor = if rushing then BLUE else DEEP, if rushing then PALE else BLUE
	noise.glow.FillTransparency, noise.glow.OutlineTransparency = if rushing then 0.35 else 0.75, 0
	noise.light.Color, noise.light.Brightness, noise.light.Range = BLUE, if rushing then 6 else 2, if rushing then 28 else 16
	noise:emitter("FFIcon", rushing)
	noise:emitter("HijackGlitch", rushing)
	noise:emitter("PlayIcon", not rushing)
	local ff, idle, angry = noise:sound("FastForward"), noise:sound("Idle"), noise:sound("EnragedIdle")
	if ff then if rushing then ff:Play() else ff:Stop() end end
	if idle then if rushing then idle:Stop() else idle:Play() end end
	if angry then if rushing then angry:Play() else angry:Stop() end end
end

