-- After the hit it swings on its arm, pushed back by the blow; the arm starts to give (dust from the ceiling), then tears
-- out: the TV falls, turning onto its back, and the arm, its bar and its plate fall too, now that nothing holds them. On the
-- floor it bounces and breaks more. The hammer stays in it. `dangle`: seconds it swings
local function dropTV(dangle)
	local drop = { landed = false }
	local start = tvMain.CFrame
	local base = arm and arm:FindFirstChild("Base")
	local hinge = if base then CFrame.new(base.Position) * start.Rotation else start * CFrame.new(0, 2.5, 1.5)
	if base then base.Parent = folder end -- the plate stays on the ceiling while the rest swings from it
	local held = hinge:ToObjectSpace(start)
	local back = 0 -- how far its back is behind its middle: it lies on it
	for _, p in ipairs(tvMain:GetDescendants()) do
		if p:IsA("BasePart") then back = math.max(back, start:PointToObjectSpace(p.Position).Z + p.Size.Z / 2) end
	end
	back = math.max(back, tvMain.Size.Z / 2)
	local inward = start.LookVector * Vector3.new(1, 0, 1)
	inward = if inward.Magnitude > 0.01 then inward.Unit else Vector3.new(0, 0, -1)
	local lying = CFrame.Angles(0, rnd(0.4), 0) * CFrame.lookAt(Vector3.new(), inward) * CFrame.Angles(math.pi / 2, 0, 0) -- screen up
	local stuck = stuckOffset()
	local function swing(s) -- back and forth on its arm, a little sideways too, less and less
		return math.rad(-24) * math.exp(-0.9 * s) * math.sin(5 * s), math.rad(5) * math.exp(-1.2 * s) * math.sin(3.3 * s + 0.6)
	end
	local function hanging(s)
		local pitch, roll = swing(s)
		return hinge * CFrame.Angles(pitch, 0, roll) * held
	end
	local fall, creaked, giving, sparkAt = nil, false, false, 0
	local t0 = os.clock()
	local connection
	connection = on(RunService.Heartbeat, function()
		local s = os.clock() - t0
		local cf
		if s < dangle then
			cf = hanging(s)
			if sparks and os.clock() >= sparkAt then
				sparkAt = os.clock() + 0.2 + math.random() * 0.3
				sparks:Emit(math.random(3, 8))
			end
			if not creaked and s > 0.7 then
				creaked = true
				oneShot(SOUNDS.crack, tvMain, { Volume = CONFIG.Volume * 0.35, PlaybackSpeed = 0.45 })
			end
			if not giving and base and s > dangle - 0.45 then -- the plate starts to come off the ceiling
				giving = true
				oneShot(SOUNDS.crack, base, { Volume = CONFIG.Volume, PlaybackSpeed = 1.2 })
				local dust = make("Part", { Name = "CeilingDust", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
					Transparency = 1, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(base.Position) }, folder)
				make("ParticleEmitter", { Texture = SMOKE, Rate = 0, Lifetime = NumberRange.new(1, 2), Speed = NumberRange.new(1, 3),
					SpreadAngle = Vector2.new(60, 60), Acceleration = Vector3.new(0, -6, 0), EmissionDirection = Enum.NormalId.Bottom,
					Size = NumberSequence.new(0.6, 2.2), Transparency = NumberSequence.new(0.4, 1), Color = ColorSequence.new(Color3.fromRGB(140, 140, 150)) }, dust):Emit(18)
				task.delay(3, function() dust:Destroy() end)
			end
		else
			if not fall then -- torn out: the TV falls, and the arm with it
				oneShot(SOUNDS.crack, tvMain, { Volume = CONFIG.Volume, PlaybackSpeed = 0.9 })
				local from = hanging(dangle)
				for _, part in ipairs(if arm then arm:GetDescendants() else {}) do
					if part:IsA("BasePart") then loose(part, inward * 2 + Vector3.new(rnd(3), 1, rnd(3))) end
				end
				if base then loose(base, inward * 2 + Vector3.new(rnd(2), 0, rnd(2))) end
				local below = from.Position + inward * 1.6
				local floor = floorUnder(below) or (below - Vector3.new(0, 9, 0))
				local to = Vector3.new(below.X, floor.Y + back, below.Z)
				fall = { from = from, to = to, floor = Vector3.new(below.X, floor.Y, below.Z), time = math.sqrt(2 * math.max(from.Y - to.Y, 0.2) / 120) }
			end
			local f = s - dangle
			if f < fall.time then -- falling, turning onto its back
				local u = f / fall.time
				local p = fall.from.Position:Lerp(fall.to, u)
				cf = CFrame.new(p.X, fall.from.Y - 60 * f * f, p.Z) * fall.from.Rotation:Lerp(lying, u * u)
			else
				if not drop.landed then
					drop.landed = true
					crash(fall.floor, inward)
				end
				local b = f - fall.time
				local hop = 0.4 * math.abs(math.sin(b * 11)) * math.exp(-b * 6)
				cf = CFrame.new(fall.to + Vector3.new(0, hop, 0)) * lying * CFrame.Angles(0.1 * math.exp(-b * 5) * math.sin(b * 20), 0, 0)
				if b > 1.5 then
					cf = CFrame.new(fall.to) * lying
					connection:Disconnect()
				end
			end
		end
		tv:PivotTo(cf)
		setHammer(tvMain.CFrame * stuck)
	end)
	return drop
end

