			end
			for _, item in ipairs(circle.attachments) do
				item.a.Position = Vector3.new(item.at.X * k, item.at.Y, item.at.Z * k)
			end
			for _, item in ipairs(circle.beams) do
				if not item.chain then
					item.b.Width0, item.b.Width1 = item.w0 * k, item.w1 * k
					item.b.CurveSize0, item.b.CurveSize1 = item.c0 * k, item.c1 * k
				end
				item.b.Enabled = k > 0.02
			end
			for _, item in ipairs(circle.lights) do item.l.Brightness = item.brightness * k end
			if entity and hold then entity.CFrame = CFrame.new(hold - (if finish then finish.Position else Vector3.new())) end
		end
		function circle.burst(count)
			for _, e in ipairs(model:GetDescendants()) do
				if e:IsA("ParticleEmitter") then e:Emit(count) end
			end
		end
		model.Name = "NoiseCircle"
		model.Parent = folder
		return circle
	end

	-- B-90: the kit's face that does not stop (its face, its angry face, its STOP, its glitch)
	local function newB90()
		local source = piece("B90Moving")
		local model
		if source then
			model = clean(source:Clone())
		else
			model = make("Model", { Name = "B90Moving" }, nil)
			local core = make("Part", { Name = "A90New", Size = Vector3.new(6, 6, 6), Transparency = 1 }, model)
			local holderAt = make("Attachment", { Name = "Attachment" }, core)
			make("ParticleEmitter", { Name = "Face", Texture = "rbxassetid://11924478218", Rate = 30, Lifetime = NumberRange.new(0.2), LockedToPart = true,
				Size = NumberSequence.new(3), Color = ColorSequence.new(Color3.new(0, 0, 0)), Speed = NumberRange.new(0.5) }, holderAt)
			make("ParticleEmitter", { Name = "FaceAngry", Texture = "rbxassetid://11924266902", Rate = 30, Lifetime = NumberRange.new(0.2), LockedToPart = true,
				Size = NumberSequence.new(5), Color = ColorSequence.new(Color3.fromRGB(35, 138, 255)), Speed = NumberRange.new(0.5), ZOffset = 2 }, holderAt)
			make("ParticleEmitter", { Name = "StopIcon", Texture = "rbxassetid://12246141362", Enabled = false, Rate = 30, Lifetime = NumberRange.new(0.2),
				LockedToPart = true, Size = NumberSequence.new(3), Color = ColorSequence.new(Color3.fromRGB(0, 0, 255)), ZOffset = 1 }, holderAt)
			clean(model)
		end
		local core = model:FindFirstChild("A90New") or model:FindFirstChildWhichIsA("BasePart")
		model.PrimaryPart = core
		local rel = {}
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then rel[p] = core.CFrame:ToObjectSpace(p.CFrame) end
		end
		local b90 = { model = model, core = core, grow = sizer(model) }
		function b90.place(position)
			for p, r in pairs(rel) do p.CFrame = CFrame.new(position) * r end
		end
		function b90.emitter(name, on, burst)
			for _, e in ipairs(model:GetDescendants()) do
				if e:IsA("ParticleEmitter") and e.Name == name then
					if on ~= nil then e.Enabled = on end
					if burst then e:Emit(burst) end
				end
			end
		end
		model.Name = "B90"
		return b90
	end

	-- The crucifix in the air: a copy of the one in your hand (yours is used up), glowing
	local function floating(tool, hand)
		local model = make("Model", { Name = "NoiseCrucifix" }, nil)
		pcall(function()
			tool.Archivable = true
			for _, d in ipairs(tool:GetDescendants()) do pcall(function() d.Archivable = true end) end
			local copy = tool:Clone()
			for _, child in ipairs(copy:GetChildren()) do child.Parent = model end
			copy:Destroy()
		end)
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("Sound") or d:IsA("TouchTransmitter") then d:Destroy() end
		end
		clean(model)
		local core = model:FindFirstChild("Handle") or model:FindFirstChildWhichIsA("BasePart", true)
		if not core then
			core = make("Part", { Name = "Handle", Size = Vector3.new(0.22, 1.7, 0.22), Color = Color3.fromRGB(92, 64, 42), Material = Enum.Material.Wood,
				CFrame = hand.CFrame, Anchored = true, CanCollide = false, CanQuery = false }, model)
			make("Part", { Name = "Crossbar", Size = Vector3.new(0.95, 0.22, 0.22), Color = Color3.fromRGB(92, 64, 42), Material = Enum.Material.Wood,
				CFrame = hand.CFrame * CFrame.new(0, 0.42, 0), Anchored = true, CanCollide = false, CanQuery = false }, model)
		end
		model.PrimaryPart = core
		make("PointLight", { Color = LIGHT, Brightness = 3, Range = 14 }, core)
		make("Highlight", { FillColor = LIGHT, OutlineColor = Color3.new(1, 1, 1), FillTransparency = 0.4, OutlineTransparency = 0.2 }, model)
		make("ParticleEmitter", { Name = "Shine", Rate = 25, Lifetime = NumberRange.new(0.4, 0.9), Speed = NumberRange.new(0.5, 2), LightEmission = 1,
			Size = NumberSequence.new(0.35, 0), Color = ColorSequence.new(LIGHT), SpreadAngle = Vector2.new(180, 180) }, core)
		local chainFrom = make("Attachment", { Name = "ChainFrom", Position = Vector3.new(0, 0.42, 0) }, core)
		model.Parent = folder
		if tool:GetAttribute("GradishCrucifix") then tool:Destroy() end -- ours is used up; the game's own stays the game's
		return model, core, chainFrom
	end

	-- It caught you, but you hold a crucifix. No film: you watch it with your own eyes. A chain from the crucifix catches it
	-- and it rewinds back, its walk played backwards; your crucifix flies up above it, the circle opens, it rises arms wide;
	-- B-90 is pulled out of its head along one smooth curve while the circle divides in two, the body it wore turning white;
	-- three pulls, both at once, and both go down into their circles
	function crucify(noise, tool)
		local character, _, root = body()
		if not character or noise.gone then
			state = "done"
			return
		end
		state = "crucified"
		shimmer(0)
		for _, name in ipairs({ "Idle", "EnragedIdle", "FastForward", "Footstep", "EnragedFootstep" }) do
			local s = noise:sound(name)
			if s then s:Stop() end
		end
		noise.rig.speed = 0 -- paused, like a tape
		noise:emitter("FFIcon", false)
		noise:emitter("HijackGlitch", false)
		noise:emitter("PauseIcon", true)
		local pause = noise:sound("Pause")
		if pause then pause:Play() end
		oneShot(CRUCIFIX, root, { Volume = CONFIG.Volume * 1.5 })
		blueFlash(0.4)
		shake(4)

		-- Where things go: it rewinds away from you, its circle there, B-90's to the side with the most room
		local me = root.Position
		local start = noise.root.Position
		local floor0 = floorUnder(start + up) or (start - Vector3.new(0, noise.hip, 0))
		local h = start.Y - floor0.Y
		local away = flatDir(me, start)
		local wall = cast(floor0 + up * 2, away * 9)
		local C1 = floor0 + away * math.min(if wall then math.max((wall.Position - (floor0 + up * 2)).Magnitude - 2.5, 0) else 6, 6)
		C1 = Vector3.new(C1.X, (floorUnder(C1 + up * 3) or C1).Y, C1.Z)
		local function room(dir)
			local hit = cast(C1 + up * 2, dir * 10)
			return if hit then (hit.Position - (C1 + up * 2)).Magnitude else 10
		end
		local sideDir = away:Cross(up)
		local splitDir = if room(sideDir) >= room(-sideDir) then sideDir else -sideDir
		if room(splitDir) < 4.5 then splitDir = away end -- no room beside it: behind it
		local C2 = C1 + splitDir * math.clamp(room(splitDir) - 1.5, 4, 7)
		C2 = Vector3.new(C2.X, (floorUnder(C2 + up * 3) or C2).Y, C2.Z)
		local mid = (C1 + C2) * 0.5
		local ceiling = cast(mid + up * 2, up * 16)
		local high = if ceiling then math.min(8, ceiling.Position.Y - mid.Y - 1.2) else 8
		local lift = 1.5
		local face = -away -- it faces you all along

		-- The pieces
		local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm") or root
		local handle = tool:FindFirstChild("Handle")
		local grip = if handle and handle:IsA("BasePart") then hand.CFrame:ToObjectSpace(handle.CFrame) else CFrame.new(0, -0.4, -0.5)
		local cross, crossCore, chainFrom = floating(tool, hand)
		local white = makeNoise(if piece("NoiseModel(WithoutB-90)") then "NoiseModel(WithoutB-90)" else nil)
		white.model.Name = "NoiseWhite"
		for _, d in ipairs(white.model:GetDescendants()) do
			if d:IsA("Texture") then d.Color3 = Color3.new(0, 0, 0) -- its static black on white
			elseif d:IsA("ParticleEmitter") then d.Enabled = false
			elseif d:IsA("BasePart") and not piece("NoiseModel(WithoutB-90)") and d ~= white.root then d.Color = Color3.fromRGB(205, 205, 205) end
		end
		fade(white.model, white.root, 1)
		local b90 = newB90()
		b90.grow(0.08)
		local circles = { newCircle(), nil }
		circles[1].place(C1, 0, 0, nil)
		local chest = holder("NoiseChest", start + up)
		local b90Point = holder("B90Point", start + up * 2)
		local tip = holder("ChainTip", crossCore.Position)
		local toNoise = chain(chainFrom, make("Attachment", { Name = "Tip" }, tip), 0.9)
		toNoise.Enabled = false
		local toB90 = chain(chainFrom, make("Attachment", { Name = "Hit" }, b90Point), 0.9)
		toB90.Enabled = false
		local rewind = noise:sound("Rewind")

		local t0, last = os.clock(), os.clock()
		local done = {}
		local function once(name) if done[name] then return false end done[name] = true return true end
		local from = nil -- its joints when it stops rewinding
		local B90top = C2 + up * (h + lift + 1.6)
		while alive do
			local now = os.clock()
			local t, dt = now - t0, now - last
			last = now
			if t >= 9 then break end

			-- Where the body is: rewound back, lifted, pulled three times, pulled down
			local back = smoother(span(t, 0.45, 1.85))
			local pull = 0
			for _, at in ipairs({ 6.2, 6.8, 7.4 }) do pull = math.max(pull, 0.5 * math.sin(math.pi * span(t, at, at + 0.4))) end
			local sink = span(t, 8.0, 8.5) ^ 2 * 7
			local at = start:Lerp(C1 + up * h, back) + up * (lift * smoother(span(t, 2.0, 3.0)) - pull - sink)
			noise.root.CFrame = CFrame.lookAt(at, at + face)
			white.root.CFrame = noise.root.CFrame
			local chestAt = at + up * 1.2
			chest.CFrame = CFrame.new(chestAt)

			-- Rewinding: its own walk, backwards, and the tape's rewind
			if t >= 0.45 and once("rewind") then
				noise:emitter("PauseIcon", false)
				if noise.anims.Walk then noise.rig:play(noise.anims.Walk, -1.6) end
				if rewind then rewind:Play() end
			end
			if t >= 1.85 and once("rest") then
				noise.rig.anim = nil
				if rewind then rewind:Stop() end
				from = {}
				for name, motor in pairs(noise.rig.motors) do from[name] = motor.Transform end
			end
			if from then -- into its rest, arms wide, struggling more and more
				local u = smoother(span(t, 1.85, 2.8))
				local pain = 0.35 + 0.65 * span(t, 3, 8)
				rest(noise, from, u, t, pain)
				if white.model.Parent then rest(white, from, u, t, pain) end
			end

			-- The crucifix: in your hand, then up above it, then above both
			local crossAt
			if t < 1.85 then
				crossAt = hand.CFrame * grip
			else
				local f = smoother(span(t, 1.85, 2.75))
				local hold = hand.CFrame * grip
				local above = C1:Lerp(mid, smoother(span(t, 3.0, 6.0))) + up * high
				local p = bezier(hold.Position, hold.Position + up * 2, above + up * 1, above, f)
				crossAt = CFrame.new(p) * CFrame.Angles(0, (t - 1.85) * 1.5 * f, 0)
			end
			cross:PivotTo(crossAt)
			-- Its chain flies out and holds it
			local fly = smoother(span(t, 0.1, 0.35))
			if fly > 0 then toNoise.Enabled = true end
			tip.CFrame = CFrame.new(crossCore.Position:Lerp(chestAt, fly))
			if fly >= 1 and once("caught") then oneShot(SLAM, noise.root, { Volume = CONFIG.Volume * 0.35, PlaybackSpeed = 1.5 }) end

			-- The circle opens under it; at the split a second one divides from it and slides under B-90
			local open = EASE.out(span(t, 2.0, 2.9)) * (1 - smoother(span(t, 8.05, 8.6)))
			if t >= 2.0 and once("open") then oneShot(RUMBLE, root, { Volume = CONFIG.Volume * 0.8 }) end
			local spin = 1 + 3 * span(t, 6, 8) + 6 * span(t, 8, 8.4)
			circles[1].speed = spin
			circles[1].place(C1, open, dt, chestAt)

			-- The split
			local u = smoother(span(t, 3.0, 6.0))
			local headAt = at + up * 2.4
			local b90At
			if t < 3.0 then
				b90At = headAt
			elseif t < 6.0 then
				b90At = bezier(headAt, headAt + up * 1.2 + splitDir, B90top + up * 0.6, B90top, u)
			else
				local calm = span(t, 6.0, 6.8)
				b90At = B90top + Vector3.new(math.noise(t, 1, 0), math.noise(t, 2, 0), math.noise(t, 3, 0)) * 0.3 * calm - up * (pull + sink)
			end
			if t >= 3.0 then
				if once("split") then
					b90.model.Parent = folder
					white.model.Parent = folder
					circles[2] = newCircle()
					toB90.Enabled = true
					oneShot(GLITCH, b90.core, { Volume = CONFIG.Volume })
					oneShot(files.scream, b90.core, { Volume = CONFIG.Volume * 1.3, RollOffMinDistance = 60 })
					for _, name in ipairs({ "Rays_Thin", "Rays_Thick", "Core", "Wave", "HijackFace", "HijackFaceGlitch" }) do noise:emitter(name, false) end
				end
				b90.grow(lerpNum(0.08, 1, smoother(span(t, 3.0, 5.0))))
				local change = smoother(span(t, 3.2, 5.2))
				fade(noise.model, noise.root, change)
				fade(white.model, white.root, 1 - change)
				if change >= 1 and once("white") then
					for _, d in ipairs(noise.model:GetDescendants()) do
						if d:IsA("ParticleEmitter") then d.Enabled = false end
					end
					for _, d in ipairs(white.model:GetDescendants()) do
						if d:IsA("ParticleEmitter") and d.Name == "NoiseStatic" then d.Enabled = true end
					end
				end
				circles[2].speed = spin
				circles[2].place(C1:Lerp(C2, u), open, dt, b90At)
			end
			b90.place(b90At)
			b90Point.CFrame = CFrame.new(b90At)

			-- Three pulls, both at once
			for i, pullAt in ipairs({ 6.2, 6.8, 7.4 }) do
				if t >= pullAt and once("pull" .. i) then
					oneShot(SLAM, root, { Volume = CONFIG.Volume * 0.45, PlaybackSpeed = 0.9 + i * 0.1 })
					blueFlash(0.15)
					b90.emitter("StopIcon", nil, 5)
					for _, circle in ipairs(circles) do circle.burst(3) end
				end
			end
			-- Down into their circles: a flash, the circles close, the TV goes dark
			if t >= 8.0 then
				if once("slam") then
					oneShot(SLAM, root, { Volume = CONFIG.Volume * 1.3 })
					blueFlash(0.8)
					shake(8)
					for _, circle in ipairs(circles) do circle.burst(15) end
					toNoise.Enabled, toB90.Enabled = false, false
					for _, d in ipairs(cross:GetDescendants()) do
						if d:IsA("BasePart") then TweenService:Create(d, TweenInfo.new(0.6), { Transparency = 1 }):Play() end
					end
					if picture then picture.Visible = true picture.Image = "" end
					for _, light in ipairs(screen and screen:GetDescendants() or {}) do
						if light:IsA("Light") then light.Enabled = false end
					end
					if hum then hum:Stop() end
				end
				fade(white.model, white.root, span(t, 8.0, 8.5))
				b90.grow(math.max(0.01, 1 - span(t, 8.0, 8.5)))
			end
			RunService.Heartbeat:Wait()
		end

		-- Gone, both
		noise.gone, white.gone = true, true
		for _, thing in ipairs({ noise.model, white.model, b90.model, cross, chest, b90Point, tip }) do thing:Destroy() end
		for _, circle in ipairs(circles) do circle.model:Destroy() end
		if current == noise then current = nil end
		state = "done"
	end
end

---====== RUN ======---

local function run()
	if CONFIG.Time > 0 then task.wait(CONFIG.Time) end
	local t0 = os.clock()
	while not filesReady and os.clock() - t0 < 20 do task.wait(0.1) end
	giveCrucifix()
	buildTV()
	if CONFIG.Hammer then
		hammer = makeHammer()
		hammer.Name = "NoiseHammer"
		hammerPrompt = make("ProximityPrompt", { Name = "ThrowPrompt", ActionText = "Throw at the TV", ObjectText = "Hammer",
			HoldDuration = 0.25, MaxActivationDistance = 9, RequiresLineOfSight = false }, hammer)
		if mainGame or LocalPlayer.PlayerGui:FindFirstChild("MainUI") then -- DOORS draws its own prompt: Roblox's would be a second one
			hammerPrompt.Style = Enum.ProximityPromptStyle.Custom
		end
		on(hammerPrompt.Triggered, function() task.spawn(throwHammer) end)
	end
	while alive and not placeTV() do task.wait(1) end
	placeHammer()
	hum = sound(files.static, { Looped = true, Volume = 0.15 * CONFIG.Volume, RollOffMaxDistance = 50 }, screen)
	if hum then hum:Play() end

	-- Waiting: static on the screen; stare at it and the world turns blue
	local seen, room, frame = 0, latestRoom(), 0
	while alive and state == "waiting" do
		local dt = RunService.RenderStepped:Wait()
		if CONFIG.FollowDoors and latestRoom() ~= room then -- a new room: the TV is above its door now
			room = latestRoom()
			placeTV()
			placeHammer()
			seen = 0
		end
		if files.sheets[1] then -- the tape's first second, static, over and over
			frame = (frame + dt * TAPE.fps) % 20
			sheetFrame(picture, math.floor(frame))
		end
		seen = if lookingAt(screen) then seen + dt else math.max(seen - dt * 0.5, 0)
		local p = math.clamp(seen / CONFIG.LookTime, 0, 1)
		if hum then hum.Volume = (0.15 + p * 0.85) * CONFIG.Volume end
		tint.TintColor = Color3.new(1 - p * 0.45, 1 - p * 0.3, 1)
		if seen >= CONFIG.LookTime then break end
	end
	if not alive or state ~= "waiting" then return end
	tint.TintColor = Color3.new(1, 1, 1)
	if playTape() and alive then emerge() end
end

local cleanup = function()
	alive = false
	pcall(function() RunService:UnbindFromRenderStep("NoiseCutscene") end)
	for _, c in ipairs(connections) do c:Disconnect() end
	if restoreCutscene then pcall(restoreCutscene) end
	for _, i in ipairs({ folder, overlay, tint, blur }) do i:Destroy() end
	local bars = hud:FindFirstChild("NoiseCutscene")
	if bars then bars:Destroy() end
end
if getgenv then getgenv().__NoiseCleanup = cleanup end

task.spawn(run)
