local function sheetFrame(label, frame)
	local index = math.clamp(frame, 0, TAPE.frames - 1)
	local perSheet = TAPE.columns * TAPE.rows
	local sheet = files.sheets[index // perSheet + 1]
	local inSheet = index % perSheet
	if sheet then label.Image = sheet end
	label.ImageRectOffset = Vector2.new((inSheet % TAPE.columns) * TAPE.width, (inSheet // TAPE.columns) * TAPE.height)
end

local function buildTV()
	tv, tvMain, screen = makeTV()
	tv.Name = "NoiseTV"
	local gui = screen:FindFirstChildWhichIsA("SurfaceGui")
	if gui then gui.Enabled = true end -- off in the kit: the game turns it on
	video = gui and gui:FindFirstChildWhichIsA("VideoFrame")
	if video then
		video.Visible = false
		if files.webm then pcall(function() video.Video = files.webm end) end -- it loads while you wait
	end
	picture = make("ImageLabel", { Name = "Picture", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0,
		ImageRectSize = Vector2.new(TAPE.width, TAPE.height) }, gui)
	for _, light in ipairs(screen:GetDescendants()) do
		if light:IsA("Light") then light.Color, light.Brightness = PALE, 0.4 end
	end
	-- A dark arm holds it to the wall
	for i, x in ipairs({ -0.8, 0.8 }) do
		make("Part", { Name = "Mount" .. i, Size = Vector3.new(0.25, 0.25, 1.4), Color = Color3.fromRGB(30, 30, 33), Anchored = true,
			CanCollide = false, CanQuery = false, CanTouch = false, CFrame = tvMain.CFrame * CFrame.new(x, 0, 1.6) }, tv)
	end
end

-- Above the way out of your room, facing into it; elsewhere in front of you
local function placeTV()
	local room = roomModel()
	local exit = room and (room:FindFirstChild("RoomExit") or (room:FindFirstChild("Door") and room.Door:FindFirstChild("Door")))
	local spot
	if exit and exit:IsA("BasePart") then
		local inward = exit.CFrame.LookVector
		local entrance = room:FindFirstChild("RoomEntrance")
		local inside = if entrance then entrance.Position else room:GetPivot().Position
		if (inside - exit.Position):Dot(inward) < 0 then inward = -inward end
		local position = exit.Position + Vector3.new(0, exit.Size.Y / 2 + 1.9, 0) + inward * 1.3
		spot = CFrame.lookAt(position, position + inward)
	else
		local _, _, root = body()
		if not root then return false end
		local position = (root.CFrame * CFrame.new(0, 3, -12)).Position
		spot = CFrame.lookAt(position, Vector3.new(root.Position.X, position.Y, root.Position.Z))
	end
	tv:PivotTo(spot)
	tv.Parent = folder
	return true
end

local hammer, hammerPrompt = nil, nil
local throwHammer -- below, with its cutscene

-- On the floor of the TV's room, lying flat, a few studs from the way in
local function placeHammer()
	if not CONFIG.Hammer or not hammer then return end
	local room = roomModel()
	local entrance = room and room:FindFirstChild("RoomEntrance")
	local guess
	if entrance and tvMain then
		local from, to = entrance.Position, tvMain.Position
		local side = (to - from):Cross(Vector3.new(0, 1, 0))
		side = if side.Magnitude > 0.01 then side.Unit else Vector3.new(1, 0, 0)
		guess = from:Lerp(to, 0.35) + side * (math.random() * 6 - 3)
	else
		local _, _, root = body()
		if not root then return end
		guess = (root.CFrame * CFrame.new(5, 0, -4)).Position
	end
	local floor = floorUnder(guess) or (guess - Vector3.new(0, 3, 0))
	hammer.CFrame = CFrame.new(floor + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0) * CFrame.Angles(-math.pi / 2, 0, 0)
	hammer.Parent = folder
end

local tint = make("ColorCorrectionEffect", { Name = "NoiseTint", TintColor = Color3.new(1, 1, 1), Enabled = true }, Lighting)
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function lookingAt(part)
	local camera = workspace.CurrentCamera
	local to = part.Position - camera.CFrame.Position
	local distance = to.Magnitude
	if distance > CONFIG.LookDistance or distance < 0.5 then return false end
	if camera.CFrame.LookVector:Dot(to.Unit) < math.cos(math.rad(CONFIG.LookAngle)) then return false end
	rayParams.FilterDescendantsInstances = { tv, LocalPlayer.Character }
	local hit = workspace:Raycast(camera.CFrame.Position, to, rayParams)
	return not hit or (hit.Position - camera.CFrame.Position).Magnitude > distance - 1.5
end

