-- Its body: a core and a cloud of cubes
local function cube(size, color)
	local p = make("Part", { Size = Vector3.one * size, Color = color, Material = Enum.Material.SmoothPlastic, Anchored = true, CanCollide = false,
		CanQuery = false, CanTouch = false, CastShadow = false }, folder)
	for _, face in ipairs({ "Front", "Back", "Left", "Right", "Top", "Bottom" }) do
		make("Texture", { Texture = GLITCH.texture, Face = Enum.NormalId[face], StudsPerTileU = 3, StudsPerTileV = 3, Color3 = PURPLE }, p)
	end
	return p
end
local core = cube(3, Color3.new(0, 0, 0))
make("PointLight", { Color = PURPLE, Range = 30, Brightness = 3, Shadows = false }, core)
make("ParticleEmitter", { Texture = GLITCH.cube, Color = ColorSequence.new(PURPLE), LightEmission = 0.6, Rate = 40, Lifetime = NumberRange.new(0.3, 0.8),
	Speed = NumberRange.new(4, 12), SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.8, 0), Rotation = NumberRange.new(0, 360) }, core)
local bits = {}
for i = 1, 12 do bits[i] = { part = cube(0.5 + math.random() * 1.1, if i % 3 == 0 then PURPLE else Color3.new(0.05, 0, 0.1)), offset = Vector3.zero } end

-- Its cubes over your screen
local glitchFrames = {}
for i = 1, 14 do
	glitchFrames[i] = make("ImageLabel", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Image = GLITCH.cube, ImageColor3 = PURPLE,
		ImageTransparency = 1, BorderSizePixel = 0, ZIndex = 3 }, screen)
end
local function glitchScreen(amount)
	for _, f in ipairs(glitchFrames) do
		local on = math.random() < amount
		f.ImageTransparency = if on then 0.1 else 1
		f.BackgroundTransparency = if on and math.random() < 0.4 then 0.2 else 1
		if on then
			local s = 0.05 + math.random() * 0.2
			f.Size = UDim2.fromScale(s, s * 1.6)
			f.Position = UDim2.fromScale(math.random(), math.random())
		end
	end
	FX.tint(PURPLE, amount * 0.6)
end

local map = W.map()
local pts = W.runway()
FX.once(GLITCH.sound, SoundService, { Volume = 1.5 * VOLUME })
FX.flicker(W.room(W.here()), 2.5)
wait(2.5)

local rumble = FX.loop(sfx("Rumble"), core, { Volume = 1.4 * VOLUME, RollOffMinDistance = 20, RollOffMaxDistance = 240, PlaybackSpeed = 1.3 })
local caught, lastRoom, bitsAt = 0, nil, 0
-- In jerks: a skip ahead, a stop, a skip again
local function jerky(t)
	local beat = t % 0.45
	return if beat < 0.06 then 420 elseif beat < 0.3 then 55 else 0
end
for pass = 1, 2 do
	if not alive then break end
	travel(pts, jerky, function(pos, dir, dt)
		local at = pos + Vector3.new(0, 3.5, 0)
		core.CFrame = CFrame.new(at) * CFrame.Angles(rnd(0.3), os.clock() * 3, rnd(0.3))
		if os.clock() >= bitsAt then -- (its cubes jump around it)
			bitsAt = os.clock() + 0.06
			for _, b in ipairs(bits) do b.offset = Vector3.new(rnd(3.5), rnd(3), rnd(3.5)) end
		end
		for _, b in ipairs(bits) do b.part.CFrame = CFrame.new(at + b.offset) * CFrame.Angles(rnd(3), rnd(3), rnd(3)) end
		local _, _, me = P.body()
		local d = if me then (me.Position - at).Magnitude else math.huge
		if os.clock() > caught then glitchScreen(if d < 80 then (1 - d / 80) * 0.6 else 0) end
		FX.near(pos, 90, 6)
		local n = W.at(map, pos)
		if n ~= lastRoom then
			lastRoom = n
			FX.flicker(W.room(n), 1.2)
		end
		if os.clock() > caught + 1 and exposed(at, REACH) then -- caught: its cubes all over your screen
			caught = os.clock() + 1.5
			FX.once(GLITCH.sound, SoundService, { Volume = 2 * VOLUME })
			glitchScreen(1)
			FX.shake(10)
			task.spawn(function()
				local t0 = os.clock()
				while alive and os.clock() - t0 < 1.4 do
					glitchScreen(0.9)
					task.wait(0.05)
				end
			end)
			task.spawn(HURT.damage, DAMAGE, "the Glitch Rush", HINTS, PURPLE, core, GLITCH.sound)
		end
		return false
	end)
	if pass == 1 and alive then -- glitched back to where it began
		FX.once(GLITCH.sound, core, { Volume = 2 * VOLUME, RollOffMinDistance = 30 })
		wait(1.2)
	end
end

-- It falls apart
if rumble then rumble:Stop() end
glitchScreen(0)
FX.once(GLITCH.sound, core, { Volume = 1.5 * VOLUME })
for _, b in ipairs(bits) do
	b.part.Anchored = false
	b.part.CanCollide = false
end
core.Transparency = 1
wait(1.5)
stop()
