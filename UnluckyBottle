-- The wardrobes gone for good: every one in the rooms now, every one in a room yet to come (for you; until you leave)
local function noWardrobes()
	if GENV.__BottleNoWardrobes then return end
	local function isWardrobe(d)
		return d:IsA("Model") and (d.Name:find("Wardrobe") ~= nil or d.Name:find("Locker") ~= nil)
	end
	local rooms = workspace:FindFirstChild("CurrentRooms")
	if not rooms then return end
	for _, d in ipairs(rooms:GetDescendants()) do
		if isWardrobe(d) then d:Destroy() end
	end
	GENV.__BottleNoWardrobes = rooms.DescendantAdded:Connect(function(d)
		if isWardrobe(d) then task.defer(function() if d.Parent then d:Destroy() end end) end
	end)
end

local function lucky()
	local humanoid = humanoidOf()
	local max = if humanoid then humanoid.MaxHealth else 100
	local s = { max = max, health = max, shield = 100, speed = 15 }
	local said = { "vita piena, scudo di stelle e più velocità" }
	local chosen = pick(LUCK, 2)
	for _, luck in ipairs(chosen) do
		if luck.item then
			local item = GOOD_ITEMS[math.random(1, #GOOD_ITEMS)]
			luck = { say = item[2], run = function() command("Give Items", { Players = ME, Items = { [item[1]] = item[1] } }) end }
		end
		table.insert(said, luck.say)
		if luck.stat then luck.stat(s) end
		if luck.run then luck.run() end
		if luck.after then -- (God Mode for a while, then off again: the rest as it is)
			task.delay(luck.after, function()
				local h = humanoidOf()
				s.god, s.health, s.shield = false, if h then math.max(h.Health, 1) else max, 0
				stats(s)
			end)
		end
	end
	stats(s)
	flash(Color3.fromRGB(150, 255, 160))
	caption("Fortuna! " .. table.concat(said, ", ") .. ".")
end
local function unlucky()
	local humanoid = humanoidOf()
	noWardrobes()
	stats({ max = if humanoid then humanoid.MaxHealth else 100, health = 1, shield = 0, speed = 0 })
	local said = { "niente più armadi", "1 di vita" }
	for _, curse in ipairs(pick(CURSE, 2)) do
		table.insert(said, curse.say)
		curse.run()
	end
	flash(Color3.fromRGB(255, 120, 120))
	caption("Sfortuna... " .. table.concat(said, ", ") .. ".")
end

local busy = false
local function drink()
	local track = held.tracks.open
	if track then track:Play(0.1) end
	task.delay(0.45, function() if drinkSound.Parent then drinkSound:Play() end end)
	local length = if track and track.Length > 0 then track.Length else 1.6
	task.wait(math.clamp(length, 0.8, 3))
	if LUCKY then lucky() else unlucky() end
	for _, e in ipairs(model:GetDescendants()) do -- (empty: a last burst of it, and it is gone)
		if e:IsA("ParticleEmitter") then pcall(function() e:Emit(20) end) end
	end
	task.wait(0.2)
	letGo()
	tool:Destroy()
end
tool.Activated:Connect(function()
	if busy or not held.joint then return end
	busy = true
	task.spawn(drink)
end)

tool.Parent = LocalPlayer:FindFirstChildOfClass("Backpack")
caption("Hai una " .. TITLE .. ": tienila in mano e clicca per berla.")
