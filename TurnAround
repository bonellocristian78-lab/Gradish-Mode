	atmosphere.Density, atmosphere.Color, atmosphere.Decay, atmosphere.Haze = 0.55, Color3.fromRGB(60, 110, 190), Color3.fromRGB(30, 60, 120), 2
else
	local was = { Lighting.FogStart, Lighting.FogEnd, Lighting.FogColor }
	later(function() Lighting.FogStart, Lighting.FogEnd, Lighting.FogColor = was[1], was[2], was[3] end)
	Lighting.FogStart, Lighting.FogEnd, Lighting.FogColor = 8, 110, Color3.fromRGB(50, 90, 160)
end
FX.tint(BLUE, 0.45)
local hum = FX.loop(sfx("Hum"), SoundService, { Volume = 0.8 * VOLUME })
local big = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4), Size = UDim2.fromScale(0.6, 0.12), BackgroundTransparency = 1,
	Text = "TURN AROUND", TextScaled = true, Font = Enum.Font.Oswald, TextColor3 = BLUE, TextStrokeTransparency = 0.3, TextTransparency = 1, ZIndex = 7 }, screen)

-- The ghost
local function glow(name, size, transparency, ball)
	local p = make("Part", { Name = name, Size = size, Color = BLUE, Material = Enum.Material.Neon, Transparency = transparency, Anchored = true,
		CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false }, folder)
	if ball then make("SpecialMesh", { MeshType = Enum.MeshType.Sphere }, p) end
	return p
end
local G = { torso = glow("Torso", Vector3.new(2.2, 2.8, 1.1), 0.35, true), head = glow("Head", Vector3.new(1.7, 1.9, 1.7), 0.3, true),
	armL = glow("Arm", Vector3.new(0.5, 2.8, 0.5), 0.4), armR = glow("Arm", Vector3.new(0.5, 2.8, 0.5), 0.4), tail = {} }
for i = 1, 4 do G.tail[i] = glow("Tail", Vector3.new(1.8 - i * 0.35, 1, 0.9 - i * 0.15), 0.4 + i * 0.13, true) end
local eyes = {}
for i = 1, 2 do
	eyes[i] = make("Part", { Size = Vector3.new(0.35, 0.5, 0.2), Color = Color3.fromRGB(5, 15, 40), Material = Enum.Material.SmoothPlastic, Anchored = true,
		CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false }, folder)
	make("SpecialMesh", { MeshType = Enum.MeshType.Sphere }, eyes[i])
end
make("PointLight", { Color = BLUE, Range = 22, Brightness = 2.5, Shadows = false }, G.torso)
make("ParticleEmitter", { Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = ColorSequence.new(BLUE), LightEmission = 1, Rate = 12,
	Lifetime = NumberRange.new(0.8, 1.6), Speed = NumberRange.new(0.5, 2), SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.4, 0) }, G.torso)
local function poseGhost(at, facing, t)
	local base = CFrame.lookAt(at, at + facing) * CFrame.new(0, math.sin(t * 2) * 0.3, 0)
	local torso = base * CFrame.new(0, 3.6, 0)
	G.torso.CFrame = torso
	G.head.CFrame = torso * CFrame.new(0, 2.3, -0.1) * CFrame.Angles(math.sin(t * 1.3) * 0.1, 0, math.sin(t * 0.9) * 0.15)
	eyes[1].CFrame = G.head.CFrame * CFrame.new(-0.4, 0.15, -0.75)
	eyes[2].CFrame = G.head.CFrame * CFrame.new(0.4, 0.15, -0.75)
	for i, arm in ipairs({ G.armL, G.armR }) do -- reaching out to you
		local side = if i == 1 then -1 else 1
		local shoulder = torso * CFrame.new(1.35 * side, 1.1, 0) * CFrame.Angles(1.35 + math.sin(t * 3 + i) * 0.12, 0, side * 0.1)
		arm.CFrame = shoulder * CFrame.new(0, -1.4, 0)
	end
	for i, piece in ipairs(G.tail) do -- (fading into the floor, swaying)
		piece.CFrame = torso * CFrame.new(math.sin(t * 2.5 - i) * 0.25 * i, -1.2 - i * 0.75, 0.15 * i)
	end
end

-- Along the room: its way from its entrance to its exit (outside DOORS: where you look)
local room = W.room(W.here())
local pts = if room then W.points(room) else {}
local axis = if #pts >= 2 then flat(pts[#pts] - pts[1]) else flat(workspace.CurrentCamera.CFrame.LookVector)
axis = if axis.Magnitude > 0.01 then axis.Unit else Vector3.new(0, 0, -1)
local _, _, me = P.body()
if not me then
	stop()
	return
end
local side = if flat(workspace.CurrentCamera.CFrame.LookVector):Dot(axis) >= 0 then 1 else -1 -- (first: ahead of you)
local pos = W.floor(me.Position + axis * side * 32)
local hitAt = 0
local function turn()
	side = -side
	local _, _, now = P.body()
	if now then pos = W.floor(now.Position + axis * side * 30) end
	big.TextTransparency = 0
	TweenService:Create(big, TweenInfo.new(1.6), { TextTransparency = 1 }):Play()
	FX.once(sfx("Whoosh"), SoundService, { Volume = 1.3 * VOLUME })
	FX.flash(BLUE, 0.35)
end
FX.flash(BLUE, 0.5)

local t0 = os.clock()
for n = 1, TURNS do
	local speed = 8 + n * 0.7
	local length = 4.5 + math.random() * 2.5
	local start = os.clock()
	while alive and os.clock() - start < length do
		local dt = RunService.Heartbeat:Wait()
		local _, _, you = P.body()
		if not you then break end
		local to = flat(you.Position - pos)
		if to.Magnitude > 0.5 then pos = W.floor(pos + to.Unit * math.min(speed * dt, to.Magnitude) + Vector3.new(0, 2, 0)) end
		poseGhost(pos, if to.Magnitude > 0.5 then to.Unit else axis, os.clock() - t0)
		FX.near(pos, 30, 3)
		if to.Magnitude < 4 and os.clock() > hitAt and not P.hiding() then
			hitAt = os.clock() + 1.5
			FX.once(sfx("Shriek"), SoundService, { Volume = VOLUME, PlaybackSpeed = 1.3 })
			if HURT.damage(DAMAGE, "Turn Around", HINTS, BLUE, G.head, sfx("Shriek")) then break end
			turn()
		end
	end
	if n < TURNS then turn() end
end

-- It fades; the colours come back
if hum then TweenService:Create(hum, TweenInfo.new(1.5), { Volume = 0 }):Play() end
for _, p in ipairs(folder:GetDescendants()) do
	if p:IsA("BasePart") then TweenService:Create(p, TweenInfo.new(1.5), { Transparency = 1 }):Play() end
end
wait(1.6)
stop()
