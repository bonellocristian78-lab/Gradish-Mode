end
local head = piece(Vector3.new(3, 3, 3), BLACK, nil, true)
local mouth = piece(Vector3.new(1.6, 1.4, 0.2), Color3.fromRGB(70, 0, 0), Enum.Material.SmoothPlastic, true)
local eyes = { piece(Vector3.new(0.45, 0.45, 0.2), Color3.new(1, 1, 1), Enum.Material.Neon, true), piece(Vector3.new(0.45, 0.45, 0.2), Color3.new(1, 1, 1), Enum.Material.Neon, true) }
local teeth = {}
for i = 1, 12 do teeth[i] = piece(Vector3.new(0.18, 0.45, 0.18), Color3.fromRGB(235, 230, 215)) end
local tendrils = {}
for i = 1, 5 do tendrils[i] = piece(Vector3.new(0.25, 0.25, 3 + math.random() * 2), BLACK) end
local all = { head, mouth, eyes[1], eyes[2] }
for _, t in ipairs(teeth) do table.insert(all, t) end
for _, t in ipairs(tendrils) do table.insert(all, t) end
make("PointLight", { Color = Color3.fromRGB(255, 240, 230), Range = 6, Brightness = 0.6, Shadows = false }, eyes[1])

local function poseHead(cf, open, t)
	head.CFrame = cf
	mouth.CFrame = cf * CFrame.new(0, -0.45, -1.42)
	mouth.Size = Vector3.new(1.4 + open * 0.6, 0.3 + open * 1.4, 0.2)
	eyes[1].CFrame = cf * CFrame.new(-0.6, 0.55, -1.3)
	eyes[2].CFrame = cf * CFrame.new(0.6, 0.55, -1.3)
	for i, tooth in ipairs(teeth) do -- (around its mouth, pointing in)
		local a = i / #teeth * math.pi * 2
		local rx, ry = 0.75 + open * 0.3, 0.2 + open * 0.7
		tooth.CFrame = cf * CFrame.new(math.cos(a) * rx, -0.45 + math.sin(a) * ry, -1.5) * CFrame.Angles(0, 0, a + math.pi / 2)
	end
	for i, tendril in ipairs(tendrils) do
		local a = i / #tendrils * math.pi * 2
		tendril.CFrame = cf * CFrame.Angles(math.sin(t * 2 + i) * 0.25 + math.cos(a) * 0.5, math.sin(a) * 0.5, 0) * CFrame.new(0, 0, 1.5 + tendril.Size.Z / 2)
	end
end
local function shown(on)
	for _, p in ipairs(all) do p.Parent = if on then folder else nil end
end

local room = W.room(W.here())
FX.dark(room)
FX.once("rbxassetid://8828938165", SoundService, { Volume = VOLUME }) -- (DOORS' bulb)
local psst, bite, shriek = sfx("Psst"), sfx("Bite"), sfx("Shriek")

for _ = 1, ATTACKS do
	if not wait(3 + math.random() * 3) then break end
	while alive and (P.hiding() or not P.body()) do task.wait(0.2) end -- (hidden, it does not come)
	if not alive then break end
	-- Behind you or over you, in the dark, inside the room
	local camera = workspace.CurrentCamera
	local from = camera.CFrame.Position
	local back = -flat(camera.CFrame.LookVector)
	back = if back.Magnitude > 0.01 then back.Unit else Vector3.new(0, 0, 1)
	local want = from + (back + camera.CFrame.RightVector * rnd(0.8)).Unit * (6 + math.random() * 3) + Vector3.new(0, 1 + math.random() * 2, 0)
	local hit = W.cast(from, want - from)
	local at = if hit then hit.Position - (want - from).Unit * 2 else want
	shown(true)
	FX.once(psst, head, { Volume = 2 * VOLUME, RollOffMinDistance = 8 })
	local t0, seen = os.clock(), false
	while alive and os.clock() - t0 < WINDOW do
		local t = os.clock() - t0
		local wobble = Vector3.new(math.sin(t * 3) * 0.3, math.sin(t * 2.2) * 0.25, 0)
		poseHead(CFrame.lookAt(at + wobble, camera.CFrame.Position), 0.2 + math.abs(math.sin(t * 5)) * 0.3, t)
		if P.looks(head.Position) > 0.8 then
			seen = true
			break
		end
		RunService.Heartbeat:Wait()
	end
	if not alive then break end
	if seen then -- it shrieks and flees
		FX.once(shriek, head, { Volume = 1.6 * VOLUME, RollOffMinDistance = 10 })
		local t1 = os.clock()
		local away = (at - camera.CFrame.Position).Unit
		while alive and os.clock() - t1 < 0.4 do
			local u = (os.clock() - t1) / 0.4
			poseHead(CFrame.lookAt(at + away * u * 8, camera.CFrame.Position), 1, os.clock())
			RunService.Heartbeat:Wait()
		end
	else -- it bites
		local t1 = os.clock()
		while alive and os.clock() - t1 < 0.25 do
			local u = (os.clock() - t1) / 0.25
			local target = camera.CFrame.Position + camera.CFrame.LookVector * 2.5
			poseHead(CFrame.lookAt(at:Lerp(target, u), camera.CFrame.Position), 1, os.clock())
			RunService.Heartbeat:Wait()
		end
		FX.once(bite, SoundService, { Volume = 2 * VOLUME })
		FX.shake(8)
		if HURT.damage(DAMAGE, "Psst", HINTS, Color3.fromRGB(120, 0, 0), head, shriek) then break end
	end
	shown(false)
end

wait(1)
stop()
