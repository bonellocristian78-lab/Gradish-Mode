-- Its head: black, two white eyes, a ring of teeth, tendrils
local function piece(size, color, material, ball)
	local p = make("Part", { Size = size, Color = color, Material = material or Enum.Material.SmoothPlastic, Anchored = true, CanCollide = false,
		CanQuery = false, CanTouch = false, CastShadow = false }, nil)
	if ball then make("SpecialMesh", { MeshType = Enum.MeshType.Sphere }, p) end
