local connections, undo = {}, {}
local function on(signal, fn) table.insert(connections, signal:Connect(fn)) end
local function idOf(text) return type(text) == "string" and text:match("%d+") or nil end

---====== SOUNDS ======---

local swapped, swaps = {}, 0 -- sound -> its old id; how many

local function swap(d)
	if not d:IsA("Sound") then return end
	local old = idOf(d.SoundId)
	local new = old and SOUNDS[old]
	if new then
		swapped[d] = d.SoundId
		swaps += 1
		d.SoundId = "rbxassetid://" .. new
	end
end
for _, root in ipairs({ workspace, ReplicatedStorage, LocalPlayer:FindFirstChildOfClass("PlayerGui"), SoundService }) do
	if root then
		for _, d in ipairs(root:GetDescendants()) do swap(d) end
		on(root.DescendantAdded, swap)
	end
end
table.insert(undo, function()
	for s, id in pairs(swapped) do pcall(function() s.SoundId = id end) end
end)

local stepsFound = {}
-- Footsteps: the Hotel-'s, by the floor's material (FootstepsClient is the copy its Footsteps script plays from)
for _, name in ipairs({ "FootstepsClient", "Footsteps" }) do
	local steps = ReplicatedStorage:FindFirstChild(name)
	if steps then
		table.insert(stepsFound, name)
		for material, list in pairs(STEPS) do
			local f = steps:FindFirstChild(material)
			local kept = {}
			if f then
				for _, s in ipairs(f:GetChildren()) do
					table.insert(kept, s)
					s.Parent = nil
				end
			else
				f = Instance.new("Folder")
				f.Name = material
				f.Parent = steps
			end
			for _, e in ipairs(list) do
				local s = Instance.new("Sound")
				s.Name, s.SoundId, s.Volume, s.PlaybackSpeed = "Sound", "rbxassetid://" .. e[1], e[2], e[3]
				s.Parent = f
			end
			table.insert(undo, function()
				f:ClearAllChildren()
				if #kept == 0 then f:Destroy() else for _, s in ipairs(kept) do s.Parent = f end end
			end)
		end
	end
end

---====== ANIMATIONS ======---

-- For one character: each old track it plays gets today's beside it; every frame (after the Hotel-'s Movement, which
-- sets the old one's weight) today's takes that weight, the old one none
local per = {} -- character -> its state
local function watch(character)
	if per[character] then return end
	local humanoid = character:WaitForChild("Humanoid", 10)
	local animator = humanoid and humanoid:WaitForChild("Animator", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not (animator and root) or per[character] then return end
	local state = { pairs = {}, loaded = {}, found = {}, moving = false, animator = animator }
	per[character] = state
	local function take(track)
		local old = idOf(track.Animation and track.Animation.AnimationId)
		local new = old and ANIMATIONS[old]
		if not new or state.pairs[track] then return end
		local fresh = state.loaded[old]
		if not fresh then
			local a = Instance.new("Animation")
			a.AnimationId = "rbxassetid://" .. new
			fresh = animator:LoadAnimation(a)
			state.loaded[old] = fresh
		end
		state.found[old] = true
		state.pairs[track] = { new = fresh, weight = math.max(track.WeightTarget, 0.01), forward = old == FORWARD }
	end
	for _, t in ipairs(animator:GetPlayingAnimationTracks()) do take(t) end
	state.played = animator.AnimationPlayed:Connect(take)
	state.humanoid, state.root = humanoid, root
end
local function forget(character)
	local state = per[character]
	if not state then return end
	per[character] = nil
	state.played:Disconnect()
	for old, p in pairs(state.pairs) do
		pcall(function()
			p.new:Stop(0.2)
			old:AdjustWeight(p.weight, 0.2)
		end)
	end
end
local name = "ModernHotel" .. math.random(1, 1e6)
RunService:BindToRenderStep(name, Enum.RenderPriority.Last.Value, function()
	for character, state in pairs(per) do
		if not character.Parent then
			forget(character)
		else
			-- How fast it goes (today's DOORS: each part of the velocity capped at what its keys ask for)
			local limit = state.humanoid.MoveDirection.Magnitude * state.humanoid.WalkSpeed
			local v = state.root.AssemblyLinearVelocity
			local speed = if limit > 0 then Vector3.new(math.clamp(v.X, -limit, limit), 0, math.clamp(v.Z, -limit, limit)).Magnitude
				else (v * Vector3.new(1, 0, 1)).Magnitude
			local moving = speed > 0.5
			local pace = math.clamp(speed, 0.02, 30) / 15
			for old, p in pairs(state.pairs) do
				local w = old.WeightTarget
				if w > 0.0005 then p.weight = w end -- (the Movement set it this frame; else it is as it was)
				if old.IsPlaying and p.new.Length > 0 then -- (only once today's is loaded: until then, and if never, the old one as it is)
					if not p.new.IsPlaying then
						p.new.Priority = old.Priority
						p.new:Play(0.2, p.weight, pace)
					end
					p.new:AdjustWeight(p.weight, 0.1)
					p.new:AdjustSpeed(pace)
					if p.forward and moving and not state.moving and p.new.Length > 0 then -- (a step starts on one foot or the other)
						p.new.TimePosition = if math.random(1, 2) == 1 then 0.15 else 0.55
					end
					old:AdjustWeight(0.0001, 0)
				elseif p.new.IsPlaying then
					p.new:Stop(0.2)
				end
			end
			state.moving = moving
		end
	end
end)
local function player(p)
	if p.Character then task.spawn(watch, p.Character) end
	on(p.CharacterAdded, function(c) task.spawn(watch, c) end)
	on(p.CharacterRemoving, forget)
end
for _, p in ipairs(Players:GetPlayers()) do player(p) end
on(Players.PlayerAdded, player)

GENV.__ModernHotel = function()
	for _, c in ipairs(connections) do c:Disconnect() end
	RunService:UnbindFromRenderStep(name)
	local all = {}
	for c in pairs(per) do table.insert(all, c) end
	for _, c in ipairs(all) do forget(c) end
	for i = #undo, 1, -1 do pcall(undo[i]) end
	GENV.__ModernHotel = nil
end
-- What it found and what it changed: in the console (F9), and in short on the screen
task.delay(6, function()
	local lines = { ("[ModernHotel] place %s"):format(tostring(game.PlaceId)) }
	local state = LocalPlayer.Character and per[LocalPlayer.Character]
	local summary = {}
	if not state then
		table.insert(lines, "  your character: no Animator found")
		table.insert(summary, "no animator")
	else
		for old, new in pairs(ANIMATIONS) do
			local label = if old == FORWARD then "walk" else "crouch"
			local track = state.loaded[old]
			if not state.found[old] then
				table.insert(lines, ("  %s: the Hotel-'s %s is not playing on you (not yet played, or another id)"):format(label, old))
			elseif track and track.Length > 0 then
				table.insert(lines, ("  %s: today's %s, loaded (%.2f s long)"):format(label, new, track.Length))
				table.insert(summary, label .. " ok")
			else
				table.insert(lines, ("  %s: today's %s could NOT be loaded here: the Hotel-'s kept"):format(label, new))
				table.insert(summary, label .. " not loadable")
			end
		end
		local ids = {}
		for _, t in ipairs(state.animator:GetPlayingAnimationTracks()) do
			table.insert(ids, (idOf(t.Animation and t.Animation.AnimationId) or "?") .. "@" .. string.format("%.2f", t.WeightTarget))
		end
		table.insert(lines, "  playing on you now: " .. table.concat(ids, ", "))
	end
	table.insert(lines, ("  sounds changed: %d"):format(swaps))
	table.insert(lines, "  footsteps folders: " .. (if #stepsFound > 0 then table.concat(stepsFound, ", ") else "none found"))
	print(table.concat(lines, "\n"))
	table.insert(summary, ("%d sounds"):format(swaps))
	pcall(function() StarterGui:SetCore("SendNotification", { Title = "ModernHotel", Text = table.concat(summary, ", "), Duration = 8 }) end)
end)
