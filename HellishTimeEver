local BASE_HEAT = 0.12 -- how red it is as soon as it starts

local colour = own(Instance.new("ColorCorrectionEffect"))
colour.Name = "HellishTimeEver"
colour.TintColor = Color3.new(1, 1, 1)
colour.Brightness = 0
colour.Contrast = 0
colour.Saturation = 0
colour.Parent = Lighting

-- In the group where DOORS keeps its own Sanity and Oxygen equalizers
local muffle = own(Instance.new("EqualizerSoundEffect"))
muffle.Name = "HellishEqualizer"
muffle.HighGain = 0
muffle.MidGain = 0
muffle.LowGain = 0
muffle.Parent = SoundService:FindFirstChild("Main")

local ambience = nil

local function setHeat(level, seconds)
	level = math.clamp(level, 0, 1)
	tween(colour, seconds, {
		TintColor  = Color3.new(1, 1, 1):Lerp(Color3.fromRGB(255, 118, 106), level),
		Brightness = -0.12 * level,
		Contrast   = 0.25 * level,
		Saturation = 0.15 * level,
	}, Enum.EasingStyle.Sine)
	if muffle.Parent then
		tween(muffle, seconds, { HighGain = -14 * level, MidGain = -4 * level, LowGain = 3 * level }, Enum.EasingStyle.Sine)
	end
	if ambience then
		tween(ambience, seconds, { Volume = 0.1 + 0.5 * level }, Enum.EasingStyle.Sine)
	end
end

