--[[ Read once and cleared, like every other script here, so the next
     loadstring without them goes back to the defaults. ]]
local function option(name, kind, default)
	local value = _G[name]
	_G[name] = nil
	if value == nil then return default end
	if type(value) ~= kind then
		warn(("[Hellish Time Ever] _G.%s must be a %s -- using %s"):format(name, kind, tostring(default)))
		return default
	end
	return value
end

local START_DELAY = math.max(option("Time", "number", 0), 0)
