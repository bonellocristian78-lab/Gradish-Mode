--[[ Every piece is cloned from DOORS while you play. If DOORS ever moves one,
     that one effect is skipped and everything else goes on. ]]

local MainUI = PlayerGui:WaitForChild("MainUI", 10)

local function find(root, path)
	local current = root
	for name in string.gmatch(path, "[^%.]+") do
		current = current and current:FindFirstChild(name)
	end
	return current
end

local MainGame = nil
pcall(function()
	MainGame = require(MainUI.Initiator.Main_Game)
end)

-- A copy of one of DOORS' GUI pieces, or nil
local function doorsPiece(path)
	local original = MainUI and find(MainUI, path)
	return if original then original:Clone() else nil
end

local SOUNDS = {
	Boom     = { MainUI, "Initiator.Main_Game.RemoteListener.Jumpscares.Dread.Boom" },
	Added    = { PlayerGui, "TopbarUI.Topbar.Modifiers.SoundIncrease" },
	Ambience = { MainUI, "Initiator.Main_Game.RemoteListener.Modules.Dread.Ambience" },
}

local function doorsSound(name, volume, speed, looped)
	local where = SOUNDS[name]
	local original = where[1] and find(where[1], where[2])
	if not (original and original:IsA("Sound")) then return nil end
	local sound = original:Clone()
	sound.Volume = volume or sound.Volume
	sound.PlaybackSpeed = speed or sound.PlaybackSpeed
	sound.Looped = looped == true
	sound.Parent = SoundService
	sound:Play()
	if not sound.Looped then
		Debris:AddItem(sound, 12)
	end
	return sound
end

-- DOORS' camera shake, the one its own entities use
local function shake(magnitude, roughness, fadeIn, fadeOut)
	if MainGame and MainGame.camShaker then
		pcall(function()
			MainGame.camShaker:ShakeOnce(magnitude, roughness, fadeIn, fadeOut)
		end)
	end
end

-- DOORS' red flash (MainUI.FlashFrame, Figure's jumpscare uses it), behind the HUD like DOORS'
local function flash(strength, seconds)
	local frame = doorsPiece("FlashFrame")
	if not frame then return end
	frame.Name = "HellishFlash"
	frame.Visible = true
	frame.BackgroundTransparency = 1 - strength
	frame.Parent = MainUI
	tween(frame, seconds, { BackgroundTransparency = 1 })
	Debris:AddItem(frame, seconds + 0.1)
end

---====== PRELOAD ======---
--[[ Everything is downloaded once, now, in the background. A model is kept
     and cloned for every summon; a script is kept as source and run fresh
     every time. Whatever cannot be loaded is marked broken and skipped. ]]

local loadModel = getgenv and getgenv().LoadCustomInstance -- Vynixu's, loaded with the spawner

local function preload(entry)
	entry.loading = true
	pcall(function()
		if entry.script then
			local source = game:HttpGet(entry.script)
			if loadstring(source) then
				entry.source = source
			end
		elseif loadModel then
			local model = loadModel(entry.asset)
			if typeof(model) == "Instance" and model:IsA("Model") then
				entry.template = model
			end
		end
	end)
	-- Without Vynixu's loader the spawner downloads the model itself, on every summon
	entry.broken = if entry.script then entry.source == nil else (loadModel ~= nil and entry.template == nil)
	entry.loading = false
	if entry.broken then
		warn("[Hellish Time Ever] " .. entry.name .. " could not be loaded: it will be skipped")
	end
end

for _, entry in ipairs(ENTITIES) do
	task.spawn(preload, entry)
end

---====== THE MODIFIER PANEL ======---

local banner = nil

local function showModifier()
	if stopped then return end
	local template = MainUI and MainUI:FindFirstChild("Modifiers")

	if not template then
		caption("Hellish Time Ever is active")
		return
	end

	if banner then pcall(function() banner:Destroy() end) end

	local panel = template:Clone()
	panel.Name = "HellishTimeEverMods"
	panel.Visible = true

	-- Only what a modifier row needs. The penalty labels, the big-list
	-- layout and the tip belong to DOORS' own modifiers.
	for _, name in ipairs({ "Tip", "NotFloor", "NoRift", "NoProgress", "RawHeat", "BigList" }) do
		local child = panel:FindFirstChild(name)
		if child then child.Visible = false end
	end

	local rowTemplate = panel:FindFirstChild("Template")
	local count = 0
	local firstRow = rowTemplate and rowTemplate.LayoutOrder or 0
	local knobs = 0

	-- DOORS' own active modifiers first, exactly as DOORS lays them out.
	local okMods, Modifiers = pcall(function()
		return require(ReplicatedStorage:WaitForChild("Modifiers", 5))
	end)

	if okMods and Modifiers and rowTemplate then
		pcall(function()
			for _, id in ipairs(Modifiers.getMods(false)) do
				local info = Modifiers.mods[id]
				if info then
					local row = rowTemplate:Clone()
					row.Visible = true
					row.Name = info.Name or id
					row.LayoutOrder = info.Sort + Modifiers.categories[info.Category].sort * 1000
					firstRow = math.min(firstRow, row.LayoutOrder)
					row.Text = info.Title
					row.BackgroundColor3 = info.Color
					row.TextColor3 = info.Color
					row.Parent = panel
					count += 1
				end
			end

			local percent = Modifiers.getPercs()
			if type(percent) == "number" then
				knobs = percent
			end
		end)
	end

	-- DOORS' own bonus plus ours: +0% becomes +666%
	local bonus = panel:FindFirstChild("KnobBonus")
	if bonus then
		local total = knobs + KNOB_BONUS
		bonus.Text = (if total < 0 then "-" else "+") .. math.abs(total) .. "%"
		bonus.Visible = true
	end

	-- Then ours, at the top.
	if rowTemplate then
		local row = rowTemplate:Clone()
		row.Visible = true
		row.Name = "HellishTimeEver"
		--[[ First among the modifiers, but no higher. The panel's header --
		     "N MODIFIERS ACTIVATED" -- sits in the same list, and its order
		     is not something the dump recorded, so a huge negative number
		     could put this row above the header. One less than the first
		     real row cannot. ]]
		row.LayoutOrder = firstRow - 1
		row.Text = "Hellish Time Ever"
		-- The gradient multiplies whatever colour is underneath, so both the
		-- text and the fill start white.
		row.BackgroundColor3 = Color3.new(1, 1, 1)
		row.TextColor3 = Color3.new(1, 1, 1)
		row.Parent = panel
		count += 1

		if Gradient then pcall(Gradient.apply, row) end
	end

	local desc = panel:FindFirstChild("Desc")
	if desc then
		desc.Text = if count == 1 then "1 MODIFIER ACTIVATED" else (count .. " MODIFIERS ACTIVATED")
	end

	-- In from the right, where DOORS puts it, then back out the way it goes.
	panel.Position = UDim2.new(1.3, 0, 0.5, 0)
	panel.Parent = MainUI
	banner = panel

	tween(panel, 0.8, { Position = UDim2.new(0.965, 0, 0.5, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	task.delay(BANNER_TIME, function()
		if banner ~= panel or not panel.Parent then return end
		tween(panel, 1, { Position = UDim2.new(1.3, 0, 0.5, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.wait(1)
		pcall(function() panel:Destroy() end)
	end)

	-- The number next to the modifier icon at the top of the screen.
	pcall(function()
		local counter = PlayerGui.TopbarUI.Topbar.Modifiers
		counter.Text = tostring(count)
		counter.Visible = true
	end)
end

