local running = false  -- started (after _G.Time)
local stopped = false  -- replaced or cleaned up
local connections = {}
local created = {}     -- destroyed on cleanup

local function own(instance)
	table.insert(created, instance)
	return instance
end

local function caption(text)
	print("[Hellish Time Ever] " .. text)
	pcall(function()
		require(PlayerGui.MainUI.Initiator.Main_Game).caption(text, true)
	end)
end

local function fetch(url)
	local ok, result = pcall(function()
		return loadstring(game:HttpGet(url))()
	end)
	if not ok then
		warn("[Hellish Time Ever] could not load " .. url .. ": " .. tostring(result))
		return nil
	end
	return result
end

local function tween(instance, seconds, goal, style, direction)
	local playing = TweenService:Create(instance,
		TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal)
	playing:Play()
	return playing
end

