-- The lights of the room you are in go red for a moment, then back to their own colour
local function redRoom()
	local room = Workspace.CurrentRooms:FindFirstChild(tostring(LocalPlayer:GetAttribute("CurrentRoom")))
	if not room then return end
	for _, light in ipairs(room:GetDescendants()) do
		if light:IsA("Light") then
			local original = lightColours[light] or light.Color
			lightColours[light] = original
			light.Color = Color3.fromRGB(255, 30, 30)
			TweenService:Create(light, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.25), {
				Color = original,
			}):Play()
		end
	end
end

local function hit(speed)
	flash(0.55, 0.6)
	shake(6, 10, 0, 0.8)
	doorsSound("Added", 0.6)
	doorsSound("Boom", 0.35, 0.45)
	redRoom()
	if counter then
		counter.Text = ("HELLISH x%d   SPEED %d"):format(summoned, speed)
		counter.Visible = true
		counterScale.Scale = 1.5
		tween(counterScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	setHeat(BASE_HEAT + (1 - BASE_HEAT) * math.min(summoned / HEAT_FULL, 1), 1.5)
end

---====== THE BAG ======---

local rng = Random.new()
local bag = {}
local lastDrawn = nil

-- One entity out of the bag. Empty: it fills up again, never starting with the last one
local function draw()
	for i = #bag, 1, -1 do
		if bag[i].broken then table.remove(bag, i) end
	end
	if #bag == 0 then
		for _, entry in ipairs(ENTITIES) do
			if not entry.broken then table.insert(bag, entry) end
		end
	end
	if #bag == 0 then return nil end
	local index = rng:NextInteger(1, #bag)
	if bag[index] == lastDrawn and #bag > 1 then
		index = index % #bag + 1
	end
	lastDrawn = bag[index]
	return table.remove(bag, index)
end

---====== SUMMONING ======---

--[[ Blitz turns around and changes voice when it does. The model carries both
     voices -- Footsteps/PlaySound going forward, Footsteps1/PlaySound1 on
     the way back -- and this swaps between them, the way Vynixu's own Blitz
     example switches its sounds on rebound. ]]
local function blitzVoice(entity)
	entity:SetCallback("OnRebounding", function(startOfRebound)
		local main = entity.Model and entity.Model.PrimaryPart
		if not main then return end

		local forward = { main:FindFirstChild("Footsteps"), main:FindFirstChild("PlaySound") }
		local back    = { main:FindFirstChild("Footsteps1"), main:FindFirstChild("PlaySound1") }

		for _, sound in ipairs(if startOfRebound then forward else back) do
			if sound then sound:Stop() end
		end
		for _, sound in ipairs(if startOfRebound then back else forward) do
			if sound then sound:Play() end
		end
	end)
end

local function summonModel(entry, speed)
	local rebound = entry.rebound

	local entity = Spawner:Create({
		Entity = {
			Name = entry.name,
			Asset = if entry.template then entry.template:Clone() else entry.asset,
			HeightOffset = 0,
		},
		Lights = {
			Flicker = { Enabled = true, Duration = 1 },
			Shatter = true,
			Repair = false,
		},
		Earthquake = { Enabled = true },
		CameraShake = {
			Enabled = true,
			Range = 100,
			Values = { 1.5, 20, 0.1, 1 },
		},
		Movement = {
			Speed = speed,
			Delay = WARNING,
			Reversed = false,
		},
		Rebounding = {
			Enabled = rebound ~= nil,
			Type = rebound and rebound.Type or "Ambush",
			Min = rebound and rebound.Min or 1,
			Max = rebound and rebound.Max or 1,
			Delay = rebound and rebound.Delay or 2,
		},
		Damage = { Enabled = true, Range = 40, Amount = 125 },
		Crucifixion = { Enabled = true, Range = 40, Resist = false, Break = true },
		Death = {
			Type = entry.death or "Guiding",
			Hints = entry.hints or { "You died to " .. entry.name .. "..." },
			Cause = entry.name,
		},
	})

	if not entity then
		warn("[Hellish Time Ever] " .. entry.name .. " could not be created")
		return
	end

	if entry.blitz then blitzVoice(entity) end

	if PASS_SECONDS then
		task.delay(PASS_SECONDS, function()
			pcall(function() entity:Despawn() end)
		end)
	end

	Spawner:Run(entity, false)
end

local function summonScript(entry, speed)
	local given = table.clone(entry.globals or {})
	if entry.speed then
		given.Speed = speed
		given.Delay = WARNING
	end
	for key, value in pairs(given) do
		_G[key] = value
	end
	-- It reads its _G values before it first waits. Whatever it did not read
	-- (it stopped early) is cleared, so it cannot reach the next script.
	task.spawn(loadstring(entry.source))
	for key in pairs(given) do
		_G[key] = nil
	end
end

local function summon()
	if not running then return end

	local speed = math.min(BASE_SPEED + summoned * SPEED_STEP, MAX_SPEED)
	summoned += 1
	hit(speed)

	task.spawn(function()
		-- One that turns out not to load, or cannot come now, gives its turn to the next
		for _ = 1, #ENTITIES do
			local entry = draw()
			if not entry then break end
			while entry.loading do
				task.wait(0.1)
			end
			local blocked = entry.notDuringSeek and Workspace:FindFirstChild("SeekMovingNewClone")
			if not entry.broken and not blocked then
				if ANNOUNCE then
					caption(("%s -- speed %d"):format(entry.name, speed))
				end
				print(("[Hellish Time Ever] %s at speed %d (%d left in the bag)"):format(entry.name, speed, #bag))
				local ok, err = pcall(if entry.script then summonScript else summonModel, entry, speed)
				if not ok then
					warn("[Hellish Time Ever] " .. entry.name .. " failed: " .. tostring(err))
				end
				return
			end
		end
		caption("Hellish Time Ever: no entity could be loaded")
	end)
end

---====== THE ENTRANCE ======---

local function entrance()
	local gui = own(Instance.new("ScreenGui"))
	gui.Name = "HellishTimeEverEntrance"
	gui.IgnoreGuiInset = true
	gui.ScreenInsets = Enum.ScreenInsets.None
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 100 -- over DOORS' HUD and topbar, for four seconds

	-- DOORS' flash frame, recoloured: the black, and the red that hits
	local function fullScreen(name, fill, layer)
		local frame = doorsPiece("FlashFrame") or Instance.new("Frame")
		frame.Name = name
		frame.Visible = true
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.Size = UDim2.fromScale(1, 1)
		frame.BorderSizePixel = 0
		frame.BackgroundColor3 = fill
		frame.BackgroundTransparency = 1
		frame.ZIndex = layer
		frame.Parent = gui
		return frame
	end
	local black = fullScreen("Black", Color3.new(0, 0, 0), 1)
	local red = fullScreen("Red", Color3.fromRGB(255, 0, 0), 2)

	-- Shade's jumpscare vignette, dark red
	local vignette = doorsPiece("Jumpscare.Jumpscare_Shade.Vignette")
	if vignette then
		vignette.Visible = true
		vignette.ZIndex = 3
		vignette.ImageColor3 = Color3.fromRGB(90, 0, 0)
		vignette.ImageTransparency = 1
		vignette.Parent = gui
	end

	local group = Instance.new("CanvasGroup")
	group.Name = "Title"
	group.BackgroundTransparency = 1
	group.Size = UDim2.fromScale(1, 1)
	group.GroupTransparency = 1
	group.ZIndex = 4
	group.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Scale = 1.35
	scale.Parent = group

	-- The "YOU ARE DEAD. NO BIG SURPRISE!" text of DOORS' jumpscares, with DOORS' font
	local title = doorsPiece("Jumpscare.Jumpscare_Rush.TextLabel") or doorsPiece("Modifiers.Desc")
	if title then
		title.Name = "HellishTimeEver"
		title.Text = "HELLISH TIME EVER"
		title.Visible = true
		title.TextScaled = true
		title.AnchorPoint = Vector2.new(0.5, 0.5)
		title.Position = UDim2.fromScale(0.5, 0.45)
		title.Size = UDim2.fromScale(0.86, 0.2)
		title.BackgroundTransparency = 1
		title.TextTransparency = 0
		title.ZIndex = 5
		title.Parent = group
		if Gradient then pcall(Gradient.apply, title) end
	end

	-- DOORS' knob badge from the modifier panel, under the title
	local knobs = doorsPiece("Modifiers.KnobBonus")
	if knobs then
		knobs.Text = "+" .. KNOB_BONUS .. "%"
		knobs.Visible = true
		knobs.AnchorPoint = Vector2.new(0.5, 0.5)
		knobs.Position = UDim2.fromScale(0.5, 0.62)
		knobs.Size = UDim2.fromScale(0.16, 0.065)
		knobs.ZIndex = 5
		knobs.Parent = group
	end

	gui.Parent = PlayerGui

	-- 0.0  the screen goes black
	tween(black, 0.6, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

	-- 0.6  the hit: red, Dread's boom, the camera, the title
	task.delay(0.6, function()
		if stopped then return end
		red.BackgroundTransparency = 0.1
		tween(red, 1.4, { BackgroundTransparency = 1 })
		doorsSound("Boom")
		shake(10, 4, 0, 2)
		if vignette then tween(vignette, 0.4, { ImageTransparency = 0.1 }) end
		tween(group, 0.25, { GroupTransparency = 0 })
		tween(scale, 0.7, { Scale = 1 }, Enum.EasingStyle.Back)
	end)

	-- 3.4  back to the game
	task.delay(3.4, function()
		if stopped then return end
		tween(group, 0.6, { GroupTransparency = 1 })
		tween(scale, 0.6, { Scale = 0.92 })
		tween(black, 1, { BackgroundTransparency = 1 })
		if vignette then tween(vignette, 1, { ImageTransparency = 1 }) end
	end)

	-- 3.9  DOORS' modifier panel
	task.delay(3.9, showModifier)
	task.delay(4.6, function()
		pcall(function() gui:Destroy() end)
	end)
end

---====== ON THEIR OWN (_G.Random) ======---

local function comeOnTheirOwn()
	while not stopped do
		task.wait(rng:NextNumber(AUTO_MIN, AUTO_MAX))
		-- Not while you are dead: the next one waits for you
		if not stopped and LocalPlayer:GetAttribute("Alive") ~= false then
			summon()
		end
	end
end

---====== NOTHING GIVEN AWAY ======---
--[[ The givers are stopped with their own cleanup, the one they use when
     they are run twice. Every badge of the mod goes through GradishCore's
     Achievements:Award, so muting that one function mutes them all; it is
     put back on cleanup. ]]

local GIVERS = { "__CrucifixGiverCleanup", "__CorrodedCrucifixCleanup", "__CrucifixAllCleanup" }
local muted = nil -- { achievements = ..., award = the original Award }

local function giveNothingAway()
	if not getgenv then return end
	local env = getgenv()
	for _, name in ipairs(GIVERS) do
		if type(env[name]) == "function" then
			pcall(env[name])
		end
	end
	local core = env.GradishCore
	local achievements = type(core) == "table" and core.Achievements
	if type(achievements) == "table" and type(achievements.Award) == "function" then
		muted = { achievements = achievements, award = achievements.Award }
		achievements.Award = function() end
	end
end

---====== START ======---

local function start()
	if stopped then return end
	running = true
	giveNothingAway()
	buildCounter()
	ambience = doorsSound("Ambience", 0, nil, true)
	if ambience then own(ambience) end
	setHeat(BASE_HEAT, 3)
	entrance()
	if AUTO then
		task.spawn(comeOnTheirOwn)
	end
end

table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == SPAWN_KEY then
		summon()
	end
end))

if getgenv then
	getgenv().__HellishTimeEverCleanup = function()
		stopped = true
		running = false
		for _, connection in ipairs(connections) do
			pcall(function() connection:Disconnect() end)
		end
		for _, instance in ipairs(created) do
			pcall(function() instance:Destroy() end)
		end
		for light, original in pairs(lightColours) do
			pcall(function() light.Color = original end)
		end
		if banner then pcall(function() banner:Destroy() end) end
		if muted then
			muted.achievements.Award = muted.award
			muted = nil
		end
	end
end

if START_DELAY > 0 then
	local left = math.max(START_DELAY - (os.clock() - LOADED_AT), 0)
	print(("[Hellish Time Ever] starts in %.0f seconds"):format(left))
	task.delay(left, start)
else
	start()
end

print(("[Hellish Time Ever] %d entities in the bag. K to summon%s."):format(
	#ENTITIES, if AUTO then ", and they also come on their own" else ""))
