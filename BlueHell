--[[
================================================================================

        B L U E   H E L L

        Rose Hell's brother. Weaker than her, and not in a way that makes him
        boring.

        WHERE HE IS EASIER
        ------------------
        Slower. One fewer trick. And the crucifix WORKS on him -- which is the
        real difference, because hers almost never does. She resists 85% of the
        time and the only reliable answer is a corroded crucifix you had to find
        in a drawer. He goes down to an ordinary one, first try, every time.

        So they occupy opposite ends of the same idea: she is the one you cannot
        banish, he is the one you can. Meeting him is where you learn what the
        crucifix is supposed to feel like, which is what makes her refusal land
        later.

        WHERE HE IS NOT
        ---------------
        The cold. Her tell is a warning; his tell has a grip on you. Inside his
        reach your walk speed drops the closer he gets, and it comes back as he
        leaves. You are not slowed because a number said so -- you are slowed
        because he is near, and the way out of it is distance.

        That flips the usual answer. Every other entity in the mod is survived
        by getting to a closet fast. Frostbite takes "fast" away and leaves you
        deciding whether you can still make it.

        The model ships named "Frostbite Remake new" rather than Blue Hell. The
        spawner names the ENTITY from the profile, not from the model, so the
        name here is what the achievements, the death cause and the registry
        all use. The model keeping its own name is harmless.

================================================================================
]]

local RunService = game:GetService("RunService")
local Players    = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

--[[ THE COLD.

     Applied as a multiplier off the walk speed he found, not as a fixed
     number: DOORS changes your speed itself (sprinting, stamina), and writing
     a raw value would fight it and win in the wrong direction. Restoring the
     ratio means whatever else adjusted your speed still holds. ]]
local Frost = {
	base    = nil,
	applied = 1,
}

local function chill(session)
	local profile = session.profile
	local settings = profile.Frost
	if not settings or not settings.Enabled then return end

	local reach   = settings.Reach or 55
	local hardest = settings.Slowest or 0.55

	session.janitor:Give(RunService.Heartbeat:Connect(function()
		if not session.active then return end

		local character = LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local model = session.entity and session.entity.Model

		if not humanoid or not root or not model or not model.Parent then return end

		local ok, pivot = pcall(function() return model:GetPivot().Position end)
		if not ok then return end

		local distance = (pivot - root.Position).Magnitude
		local closeness = math.clamp(1 - (distance / reach), 0, 1)

		-- Undo the last chill before measuring, so it never compounds.
		if Frost.applied ~= 1 and Frost.applied > 0 then
			humanoid.WalkSpeed = humanoid.WalkSpeed / Frost.applied
		end

		local factor = 1 - (1 - hardest) * closeness
		humanoid.WalkSpeed = humanoid.WalkSpeed * factor
		Frost.applied = factor
	end))

	-- And give it back when he goes, whatever your speed is by then.
	session.janitor:Give(function()
		local character = LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		if humanoid and Frost.applied ~= 1 and Frost.applied > 0 then
			pcall(function()
				humanoid.WalkSpeed = humanoid.WalkSpeed / Frost.applied
			end)
		end

		Frost.applied = 1
	end)

	print("[Gradish/Blue Hell] frost online -- you slow down as he closes")
end

