---====== ITS MODEL ======---

local function isModel(data) return type(data) == "string" and data:sub(1, 8) == "<roblox!" end
local function loadModel()
	local path = FOLDER .. "/" .. FILE
	pcall(function()
		if not isfolder(FOLDER) then makefolder(FOLDER) end
		if isfile(path) and isModel(readfile(path)) then return end
		for _, url in ipairs(URLS) do
			local ok, data = pcall(function() return game:HttpGet(url) end)
			if ok and isModel(data) then -- (never a "404: Not Found" page)
				writefile(path, data)
				return
			end
		end
	end)
	local ok, objects = pcall(function() return game:GetObjects(getcustomasset(path)) end)
	if ok and type(objects) == "table" and objects[1] then return objects[1] end
	return nil
end
local template = loadModel()
if not template then
	warn("[NewSeek] its model could not be loaded")
	return
end

---====== ITS OWN ANIMATIONS (when DOORS' joints are not its own): the KeyframeSequences of its AnimSaves ======---

local STYLE = { Linear = "Linear", Cubic = "Cubic", CubicV2 = "Cubic", Elastic = "Elastic", Bounce = "Bounce" }
local function prepare(kfs)
	local joints, length = {}, 0
	local frames = kfs:GetKeyframes()
	table.sort(frames, function(a, b) return a.Time < b.Time end)
	for _, frame in ipairs(frames) do
		length = math.max(length, frame.Time)
		for _, d in ipairs(frame:GetDescendants()) do
			if d:IsA("Pose") and d.Weight > 0 then
				joints[d.Name] = joints[d.Name] or {}
				table.insert(joints[d.Name], { t = frame.Time, cf = d.CFrame, style = d.EasingStyle.Name, dir = d.EasingDirection.Name })
			end
		end
	end
	return { joints = joints, length = length, looped = kfs.Loop }
end
local function poseOf(list, time)
	local a, b = list[1], nil
	for i = 2, #list do
		if list[i].t <= time then a = list[i] else b = list[i] break end
	end
	if not b or a.style == "Constant" or time <= a.t then return a.cf end
	local dir = a.dir -- the old styles have In and Out swapped, as in Roblox
	if a.style ~= "CubicV2" and a.style ~= "Linear" then dir = if dir == "In" then "Out" elseif dir == "Out" then "In" else dir end
	local alpha = TweenService:GetValue((time - a.t) / (b.t - a.t), Enum.EasingStyle[STYLE[a.style] or "Linear"], Enum.EasingDirection[dir])
	return a.cf:Lerp(b.cf, alpha)
end
local ANIMS = {}
local saves = template:FindFirstChild("AnimSaves", true)
if saves then
	for _, kfs in ipairs(saves:GetChildren()) do
		if kfs:IsA("KeyframeSequence") then ANIMS[kfs.Name:lower()] = prepare(kfs) end
	end
	saves:Destroy()
end

---====== THE TEMPLATE, ONCE: what every Seek will wear ======---

-- No DOORS module on it, nothing that moves it, touches or collides; no shadows; fewer goo particles
template.Name = "NewSeek"
template:SetAttribute("LoadModule", nil)
for _, d in ipairs(template:GetDescendants()) do
	if d:IsA("BodyMover") or d:IsA("BodyGyro") or d:IsA("BodyVelocity") or d:IsA("Animator") or d:IsA("AnimationController")
		or d:IsA("Animation") or d:IsA("LuaSourceContainer") or d.Name == "Hitbox" then
		d:Destroy()
	elseif d:IsA("BasePart") then
		d.Anchored, d.CanCollide, d.CanTouch, d.CanQuery, d.Massless, d.CastShadow = false, false, false, false, true, false
	elseif d:IsA("Light") then
		d.Shadows = false
	elseif d:IsA("ParticleEmitter") then
		d.Rate = math.min(d.Rate, MAX_RATE)
	end
end

local SIDES = { Enum.NormalId.Right, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Front } -- (Glitch's: its four sides)
local HANDS = { ["Left Hand"] = true, ["Right Hand"] = true, LeftHand = true, RightHand = true }
local function make(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do i[k] = v end
	i.Parent = parent
	return i
end
local function cubeEmitter(parent, rate)
	return make("ParticleEmitter", { Name = "GlitchCubes", Texture = G.cube, Color = G.cubes, Rate = rate, Lifetime = NumberRange.new(0.2, 0.3),
		Size = NumberSequence.new(2), Speed = NumberRange.new(0), Rotation = NumberRange.new(0, 180), ZOffset = -3, LightInfluence = 0,
		Brightness = 1.17 }, parent)
end

-- Glitch: the whole Seek made of DOORS' Glitch
if GLITCH then
	for _, d in ipairs(template:GetDescendants()) do
		if d:IsA("ParticleEmitter") then
			d.Enabled = false -- (its goo: Glitch's cubes instead, below)
		elseif d:IsA("Light") then
			d.Color = G.light
		elseif d:IsA("BasePart") and d.Transparency < 1 and d.Name ~= "Eye" and d.Name ~= "Black" and not HANDS[d.Name] then
			d.Color, d.Material = G.body, Enum.Material.Neon -- (it glows: it is seen in the dark, as DOORS' Glitch is)
			for _, side in ipairs(SIDES) do
				make("Texture", { Name = "GlitchTexture", Texture = G.texture, Color3 = G.black, StudsPerTileU = 3, StudsPerTileV = 3, Face = side }, d)
			end
			if d.Name:find("Torso") or d.Name:find("Upper") or d.Name == "Head" then cubeEmitter(d, 6) end
		end
	end
	-- Its eyes: glitched. Their faces swap between Seek's eye and Glitch's cube while it runs, and on each one a glowing
	-- cube of Glitch's (seen from anywhere, bigger than the eye) flickers pink, cyan and white
	for _, eye in ipairs(template:GetDescendants()) do
		if eye:IsA("BasePart") and eye.Name == "Eye" then
			eye.Color, eye.Material = G.cyan, Enum.Material.Neon
			for _, decal in ipairs(eye:GetChildren()) do
				if decal:IsA("Decal") then
					decal:SetAttribute("SeekEye", decal.Texture)
					decal.Color3 = G.light
				end
			end
			local size = math.max(eye.Size.X, eye.Size.Y) * 3 + 0.6
			local board = make("BillboardGui", { Name = "GlitchEye", Size = UDim2.fromScale(size, size), LightInfluence = 0, AlwaysOnTop = false,
				MaxDistance = 200 }, eye)
			make("ImageLabel", { Name = "Cube", Image = G.cube, ImageColor3 = G.light, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) }, board)
			cubeEmitter(eye, 4).Size = NumberSequence.new(0.8)
		end
	end
	-- Its hands: clusters of cubes on the hand (the hand itself unseen), each on its weld so it can jump about
	for _, hand in ipairs(template:GetDescendants()) do
		if hand:IsA("BasePart") and HANDS[hand.Name] then
			hand.Transparency = 1
			local reach = hand.Size * 0.6
			for i = 1, 8 do
				local s = 0.5 + math.random() * 0.5
				local cube = make("Part", { Name = "GlitchHandCube", Size = Vector3.new(s, s, s), Color = ({ G.body, G.cyan, G.light, G.body })[i % 4 + 1],
					Material = Enum.Material.Neon, Anchored = false, CanCollide = false, CanTouch = false, CanQuery = false, Massless = true,
					CastShadow = false }, hand)
				cube:SetAttribute("Reach", reach)
				make("Weld", { Name = "GlitchWeld", Part0 = hand, Part1 = cube, C0 = CFrame.new((math.random() - 0.5) * reach.X * 2,
					(math.random() - 0.5) * reach.Y * 2, (math.random() - 0.5) * reach.Z * 2) }, cube)
			end
		end
	end
end

---====== WEARING IT ======---

local folder = Instance.new("Folder")
folder.Name = "NewSeekSkins"
folder.Parent = workspace
local worn = {} -- DOORS' Seek -> what goes with it
local connections = {}

-- Its body's parts, by name: each of ours goes where DOORS' own of that name is, every frame
local BODY = { "UpperTorso", "LowerTorso", "Head", "LeftUpperArm", "LeftLowerArm", "RightUpperArm", "RightLowerArm", "LeftUpperLeg",
	"LeftLowerLeg", "RightUpperLeg", "RightLowerLeg", "Left Hand", "Right Hand", "LeftHand", "RightHand", "LeftFoot", "RightFoot" }
local function partsByName(model) -- (only the names there is one of)
	local found, count = {}, {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			count[d.Name] = (count[d.Name] or 0) + 1
			found[d.Name] = d
		end
	end
	for name, n in pairs(count) do
		if n > 1 then found[name] = nil end
	end
	return found
end
-- Its rig's Root (the one in SeekRig before any other)
local function rootPart(model)
	local any = nil
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == "Root" then
			if d.Parent and d.Parent.Name == "SeekRig" then return d end
			any = any or d
		end
	end
	return any
end
local function motorsOf(model)
	local list = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") then list[d.Name] = d end
	end
	return list
end

-- DOORS' own, out of sight (only for you), once: its parts and faces (nothing of the server touches that), its lights and
-- particles (switched back off if the server switches them on). Its sounds stay
local function hide(entry, d)
	if d:IsA("BasePart") or d:IsA("Decal") then
		table.insert(entry.hidden, { d, "LocalTransparencyModifier", d.LocalTransparencyModifier })
		d.LocalTransparencyModifier = 1
	elseif d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Beam") or d:IsA("Trail") or d:IsA("Fire") or d:IsA("Smoke") then
		table.insert(entry.hidden, { d, "Enabled", d.Enabled })
		d.Enabled = false
		table.insert(entry.watch, d:GetPropertyChangedSignal("Enabled"):Connect(function()
			if d.Enabled then d.Enabled = false end
		end))
	elseif d:IsA("Sound") then
		table.insert(entry.sounds, d)
	end
end

-- Glitch: the cubes that break off it, always the same few (hidden until used)
local POOL = 14
local function newPool(copy)
	local pool = {}
	for i = 1, POOL do
		pool[i] = { part = make("Part", { Name = "GlitchCube", Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
			CastShadow = false, Transparency = 1, Size = Vector3.new(1, 1, 1) }, copy), until_ = 0 }
	end
	return pool
end

-- What it found in DOORS' Seek and how it follows it, in the executor's folder (NewSeek/SeekStructure.txt) and the console:
-- if the new one is not where DOORS' is, that file says why
local function describe(original, entry)
	pcall(function()
		local top = original:GetFullName()
		local lines = { "NewSeek on " .. top .. (if os.date then " at " .. os.date("%Y-%m-%d %H:%M:%S") else ""), "mode: " .. entry.mode, "" }
		local pivot = original:GetPivot()
		for _, d in ipairs(original:GetDescendants()) do
			if #lines > 500 then break end
			local path = d:GetFullName():sub(#top + 2)
			if d:IsA("BasePart") then
				local at = pivot:PointToObjectSpace(d.Position)
				table.insert(lines, ("part  %s [%s] size %.2f %.2f %.2f at %.2f %.2f %.2f transparency %.2f anchored %s"):format(path, tostring(d.ClassName),
					d.Size.X, d.Size.Y, d.Size.Z, at.X, at.Y, at.Z, d.Transparency, tostring(d.Anchored)))
			elseif d:IsA("JointInstance") then
				table.insert(lines, ("joint %s [%s] %s -> %s"):format(path, tostring(d.ClassName), d.Part0 and d.Part0.Name or "-", d.Part1 and d.Part1.Name or "-"))
			elseif d:IsA("Bone") or d:IsA("AnimationController") or d:IsA("Humanoid") or d:IsA("Model") then
				table.insert(lines, ("%s  %s"):format(tostring(d.ClassName), path))
			end
		end
		if not isfolder(FOLDER) then makefolder(FOLDER) end
		writefile(FOLDER .. "/SeekStructure.txt", table.concat(lines, "\n"))
	end)
	print(("[NewSeek] %s: %s"):format(original.Name, entry.mode))
end

local function dress(original)
	if worn[original] or not original.Parent then return end
	local copy = template:Clone()
	local entry = { original = original, copy = copy, hidden = {}, watch = {}, sounds = {}, ours = motorsOf(copy), theirs = motorsOf(original) }
	-- Part by part: each of its body's parts on DOORS' own of the same name (its pose is DOORS', whatever its joints)
	local theirParts, ourParts = partsByName(original), partsByName(copy)
	entry.pairs = {}
	for _, name in ipairs(BODY) do
		if theirParts[name] and ourParts[name] then table.insert(entry.pairs, { ourParts[name], theirParts[name] }) end
	end
	if #entry.pairs >= 4 then
		entry.pose = true
		for _, pair in ipairs(entry.pairs) do pair[1].Anchored = true end
		entry.anchor = entry.pairs[1][1]
		entry.mode = ("part by part (%d parts)"):format(#entry.pairs)
	else
		-- Or else whole: our Root on their rig's Root, or our Figure on their PrimaryPart; its joints DOORS' or its own animations
		local theirRoot, ourRoot = rootPart(original), rootPart(copy)
		if theirRoot and ourRoot then
			entry.follow, entry.anchor = theirRoot, ourRoot
		else
			entry.follow, entry.anchor = original.PrimaryPart or original:FindFirstChildWhichIsA("BasePart", true), copy.PrimaryPart or ourRoot
		end
		if not (entry.follow and entry.anchor) then
			warn("[NewSeek] nothing in " .. original.Name .. " to follow: left as it is")
			copy:Destroy()
			return
		end
		entry.anchor.Anchored = true
		entry.mode = ("whole, on its %s"):format(entry.follow.Name)
	end
	-- Its joints: DOORS' own, if they are its own; or its own animations
	local same = 0
	for name in pairs(entry.ours) do
		if entry.theirs[name] then same += 1 end
	end
	entry.mirror = same >= 5
	if not entry.pose then entry.mode = entry.mode .. (if entry.mirror then (" (its %d joints)"):format(same) else " (its own animations)") end
	entry.byPart = {} -- (its own animations name the part a joint moves, not the joint)
	for _, motor in pairs(entry.ours) do
		if motor.Part1 then entry.byPart[motor.Part1.Name] = motor end
	end
	entry.time, entry.anim, entry.emerged = 0, nil, false
	if GLITCH then
		entry.body, entry.base, entry.eyes, entry.eyeCubes, entry.handCubes, entry.lights = {}, {}, {}, {}, {}, {}
		for _, d in ipairs(copy:GetDescendants()) do
			if d:IsA("BasePart") and d:FindFirstChild("GlitchTexture") then
				table.insert(entry.body, d)
				entry.base[d] = d.Color -- (what a flicker always goes back to)
			elseif d:IsA("Decal") and d:GetAttribute("SeekEye") then
				table.insert(entry.eyes, d)
			elseif d:IsA("Weld") and d.Name == "GlitchWeld" then
				table.insert(entry.handCubes, d)
			elseif d:IsA("ImageLabel") and d.Parent and d.Parent.Name == "GlitchEye" then
				table.insert(entry.eyeCubes, d)
			elseif d:IsA("Light") then
				table.insert(entry.lights, { d, d.Brightness })
			end
		end
		entry.pool, entry.flickered = newPool(copy), {}
		entry.sound = make("Sound", { Name = "Glitch", SoundId = G.sound, Volume = 0.6, RollOffMaxDistance = 120 }, entry.anchor)
		local now = os.clock()
		entry.nextFlicker, entry.nextBurst, entry.nextFreeze, entry.nextWarble, entry.nextEyes, entry.nextHands, entry.frozenUntil =
			now, now, now + 1, now, now, now, 0
	end
	if entry.pose then
		for _, pair in ipairs(entry.pairs) do pair[1].CFrame = pair[2].CFrame end
	else
		entry.anchor.CFrame = entry.follow.CFrame
	end
	copy.Parent = folder
	-- Only now, with the new one in its place: DOORS' own out of sight
	for _, d in ipairs(original:GetDescendants()) do hide(entry, d) end
	entry.added = original.DescendantAdded:Connect(function(d) hide(entry, d) end)
	worn[original] = entry
	describe(original, entry)
end

local function undress(original)
	local entry = worn[original]
	if not entry then return end
	worn[original] = nil
	entry.added:Disconnect()
	for _, c in ipairs(entry.watch) do c:Disconnect() end
	entry.copy:Destroy()
	if original.Parent then -- (taken off while it is still here: DOORS' own back)
		for _, h in ipairs(entry.hidden) do pcall(function() h[1][h[2]] = h[3] end) end
	end
end

---====== THE GLITCH ======---

-- Glitch's cubes flashing on your screen when it is close: always the same few labels
local screen = nil
local screenCubes = {}
if GLITCH then
	screen = make("ScreenGui", { Name = "NewSeekGlitch", IgnoreGuiInset = true, ResetOnSpawn = false, DisplayOrder = 50 },
		if gethui then gethui() else LocalPlayer:WaitForChild("PlayerGui"))
	for i = 1, 6 do
		screenCubes[i] = make("ImageLabel", { Name = "GlitchEffect", Image = G.cube, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromScale(0.12, 0.12), Visible = false }, screen)
	end
end
local screenUntil, nextScreen = 0, 0

local function rnd(a) return (math.random() * 2 - 1) * a end

local function glitch(entry, now)
	-- A part or two in a glitch colour for a moment (only those: the rest is never touched)
	if now >= entry.nextFlicker then
		entry.nextFlicker = now + 0.06 + math.random() * 0.12
		for _, p in ipairs(entry.flickered) do p.Color = entry.base[p] end
		table.clear(entry.flickered)
		for _ = 1, math.random(1, 2) do
			local p = entry.body[math.random(math.max(#entry.body, 1))]
			if p then
				table.insert(entry.flickered, p)
				p.Color = G.flicker[math.random(#G.flicker)]
			end
		end
		for _, l in ipairs(entry.lights) do l[1].Brightness = if math.random() < 0.2 then 0 else l[2] * (0.5 + math.random()) end
	end
	-- Its eyes: Seek's eye and Glitch's cube in turns, pink and cyan
	if now >= entry.nextEyes then
		entry.nextEyes = now + 0.08 + math.random() * 0.22
		for _, decal in ipairs(entry.eyes) do
			local cube = math.random() < 0.45
			decal.Texture = if cube then G.cube else decal:GetAttribute("SeekEye")
			decal.Color3 = if cube then G.cyan else G.light
		end
		for _, label in ipairs(entry.eyeCubes) do
			label.Visible = math.random() < 0.8
			label.ImageColor3 = ({ G.light, G.cyan, G.white })[math.random(1, 3)]
			label.Rotation = math.random(0, 1) * 180
			local s = 0.7 + math.random() * 0.6
			label.Size = UDim2.fromScale(s, s)
		end
	end
	-- Its hands: their cubes jump about
	if now >= entry.nextHands then
		entry.nextHands = now + 0.1
		for _ = 1, 4 do
			local weld = entry.handCubes[math.random(math.max(#entry.handCubes, 1))]
			local reach = weld and weld.Part1 and weld.Part1:GetAttribute("Reach")
			if reach then
				weld.C0 = CFrame.new(rnd(reach.X), rnd(reach.Y), rnd(reach.Z)) * CFrame.Angles(rnd(1), rnd(1), rnd(1))
				local s = 0.5 + math.random() * 0.5
				weld.Part1.Size = Vector3.new(s, s, s)
			end
		end
	end
	-- Cubes break off it
	if now >= entry.nextBurst then
		entry.nextBurst = now + 0.15 + math.random() * 0.2
		for _ = 1, math.random(2, 4) do
			local p = entry.body[math.random(math.max(#entry.body, 1))]
			for _, c in ipairs(entry.pool) do
				if p and now >= c.until_ then
					local s = 0.5 + math.random() * 1.6
					c.part.Size = Vector3.new(s, s, s)
					c.part.CFrame = p.CFrame * CFrame.new(rnd(p.Size.X), rnd(p.Size.Y), rnd(p.Size.Z)) * CFrame.Angles(rnd(1), rnd(1), rnd(1))
					local roll = math.random()
					c.part.Color = if roll < 0.55 then G.body elseif roll < 0.75 then G.black elseif roll < 0.9 then G.cyan else G.light
					c.part.Material = if roll >= 0.75 then Enum.Material.Neon else Enum.Material.SmoothPlastic
					c.part.Transparency = 0
					c.until_ = now + 0.08 + math.random() * 0.18
					break
				end
			end
		end
	end
	for _, c in ipairs(entry.pool) do
		if c.part.Transparency == 0 and now >= c.until_ then c.part.Transparency = 1 end
	end
	-- It hangs a moment, then snaps on
	if now >= entry.nextFreeze then
		entry.nextFreeze = now + 1 + math.random() * 2.5
		entry.frozenUntil = now + 0.08 + math.random() * 0.18
		entry.sound.PlaybackSpeed = 0.7 + math.random() * 0.8
		entry.sound:Play()
	end
	-- DOORS' Seek's own sounds warble
	if now >= entry.nextWarble then
		entry.nextWarble = now + 0.4 + math.random() * 0.8
		for _, s in ipairs(entry.sounds) do
			if s.Parent and s.IsPlaying then
				local speed = s.PlaybackSpeed
				s.PlaybackSpeed = speed * (0.75 + math.random() * 0.5)
				task.delay(0.08, function() if s.Parent then s.PlaybackSpeed = speed end end)
				break
			end
		end
	end
end

-- Close to it: Glitch's cubes on your screen for a moment
local function screenGlitch(now, nearest)
	if screenUntil > 0 and now >= screenUntil then
		screenUntil = 0
		for _, l in ipairs(screenCubes) do l.Visible = false end
	end
	if nearest > 35 or now < nextScreen then return end
	nextScreen = now + 0.6 + math.random() * 0.8 * (nearest / 35 + 0.3)
	screenUntil = now + 0.05 + math.random() * 0.1
	for i, l in ipairs(screenCubes) do
		l.Visible = i <= math.random(2, #screenCubes)
		l.Position = UDim2.fromScale(math.random(), math.random())
		l.Rotation = math.random(0, 1) * 180
		local s = 0.06 + math.random() * 0.12
		l.Size = UDim2.fromScale(s, s)
	end
end

---====== EVERY FRAME: on DOORS' Seek, part by part (or whole, joint by joint) ======---

local function animate(entry, dt)
	if entry.pose then -- each part on DOORS' own (Glitch: now and then one jumps off)
		for _, pair in ipairs(entry.pairs) do
			local cf = pair[2].CFrame
			if GLITCH and math.random() < 0.05 then cf = cf * CFrame.new(rnd(0.4), rnd(0.4), rnd(0.4)) * CFrame.Angles(rnd(0.5), rnd(0.5), 0) end
			pair[1].CFrame = cf
		end
		return
	end
	if entry.mirror then
		for name, motor in pairs(entry.ours) do
			local theirs = entry.theirs[name]
			if theirs then
				local t = theirs.Transform
				if GLITCH and math.random() < 0.06 then -- a limb jumps off its joint
					t = t * CFrame.new(rnd(0.4), rnd(0.4), rnd(0.4)) * CFrame.Angles(rnd(0.5), rnd(0.5), 0)
				end
				motor.Transform = t
			end
		end
		return
	end
	-- Its own: emerge once, then run while it moves, idle while it stands
	local at = entry.anchor.Position
	local pace = if entry.last then ((at - entry.last) * Vector3.new(1, 0, 1)).Magnitude / math.max(dt, 1e-3) else 0
	entry.last = at
	local want
	if not entry.emerged and ANIMS.emerge then
		want = ANIMS.emerge
	else
		want = if pace > 3 then ANIMS.run else (ANIMS.idle or ANIMS.run)
	end
	if not want then return end
	if entry.anim ~= want then entry.anim, entry.time = want, 0 end
	entry.time += dt
	if entry.time >= want.length then
		if want == ANIMS.emerge then entry.emerged = true end
		entry.time = if want.looped and want.length > 0 then entry.time % want.length else want.length
	end
	for name, list in pairs(want.joints) do
		local motor = entry.byPart[name]
		if motor then motor.Transform = poseOf(list, entry.time) end
	end
end

table.insert(connections, RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()
	local nearest = math.huge
	local character = LocalPlayer.Character
	local me = character and character:FindFirstChild("HumanoidRootPart")
	for original, entry in pairs(worn) do
		if not original:IsDescendantOf(workspace) then
			undress(original)
		else
			if GLITCH then glitch(entry, now) end
			if not (GLITCH and now < entry.frozenUntil) then
				if not entry.pose then entry.anchor.CFrame = entry.follow.CFrame end
				animate(entry, dt)
			end
			if me then nearest = math.min(nearest, (entry.anchor.Position - me.Position).Magnitude) end
		end
	end
	if GLITCH then screenGlitch(now, nearest) end
end))

-- DOORS' Seek, now and every time it comes
local function consider(d)
	if NAMES[d.Name] and d:IsA("Model") and not d:IsDescendantOf(folder) then
		task.delay(0.1, dress, d) -- (its pieces arrive with it)
	end
end
for _, d in ipairs(workspace:GetDescendants()) do consider(d) end
table.insert(connections, workspace.DescendantAdded:Connect(consider))

SESSION.__NewSeek = function()
	for _, c in ipairs(connections) do c:Disconnect() end
	for original in pairs(worn) do undress(original) end
	folder:Destroy()
	if screen then screen:Destroy() end
end
