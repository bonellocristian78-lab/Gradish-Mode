local function isCrucifix(tool)
	if not (tool and tool:IsA("Tool")) then return false end
	if tool.Name == "Crucifix" then return true end
	local ok, tagged = pcall(function() return tool:HasTag("Crucifix") end)
	return ok and tagged == true
end

-- Il crocifisso che hai IN MANO (quello nello zaino non conta, come per lo spawner)
function Ritual.Held()
	local character = LocalPlayer.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	if isCrucifix(tool) then return tool end
	return nil
end

function Ritual.IsOurs(tool)
	return tool ~= nil and tool:GetAttribute("GradishCrucifix") == true
end

--[[ Che rituale fa questo crocifisso su questa entità: il colore di partenza e
     se fallisce. Un crocifisso senza tipo (quello di Penguin, quello vero di
     DOORS) è un Guiding. ]]
function Ritual.Outcome(tool, resist)
	local kind = tool and tool:GetAttribute("CrucifixType")
	if kind == "Fail" then
		return "Guiding", true
	end
	if kind ~= "Curious" then
		kind = "Guiding"
	end
	return kind, resist == true
end

local template = nil
local fetching = false

local function toolsNow()
	local seen = {}
	for _, container in ipairs({ LocalPlayer:FindFirstChildOfClass("Backpack"), LocalPlayer.Character }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") then seen[child] = true end
			end
		end
	end
	return seen
end

local function newToolSince(seen)
	for tool in pairs(toolsNow()) do
		if not seen[tool] then return tool end
	end
	return nil
end

-- Due assi di legno: quando il loader di Penguin non risponde non resti a mani vuote
local function buildPlanks()
	local tool = Instance.new("Tool")
	tool.RequiresHandle = true

	local handle = newPart("Handle", Vector3.new(0.22, 1.7, 0.22), CFrame.identity, WOOD, Enum.Material.Wood, 0)
	handle.Anchored = false
	handle.Massless = true
	handle.Parent = tool

	local bar = newPart("Crossbar", Vector3.new(0.95, 0.22, 0.22), CFrame.new(0, 0.42, 0), WOOD, Enum.Material.Wood, 0)
	bar.Anchored = false
	bar.Massless = true
	bar.Parent = tool

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = bar
	weld.Parent = handle

	tool.Grip = CFrame.new(0, -0.45, 0) * CFrame.Angles(math.rad(-90), 0, 0)
	return tool
end

--[[ Il modello è quello di Penguin, il comportamento no.

     Il loader è offuscato e il suo tool ha una logica sua che non si può
     leggere. Quindi si esegue una volta sola, si copia quello che si vede
     (le parti, le saldature, la presa), si tolgono gli script e si distrugge
     l'originale: le sue connessioni muoiono con lui. La copia pulita resta
     come stampo per tutti i crocifissi successivi. ]]
local function penguinTemplate()
	while fetching do task.wait(0.1) end
	if template then return template end
	fetching = true

	local seen = toolsNow()
	_G.Uses = 1
	_G.Range = 30
	-- Se un altro script l'ha lasciato a true, il suo crocifisso vale su tutto
	_G.OnAnything = nil

	local ok, err = pcall(function()
		loadstring(game:HttpGet(PENGUIN_URL))()
	end)

	local original
	if ok then
		local deadline = os.clock() + 12
		repeat
			original = newToolSince(seen)
			if not original then task.wait(0.15) end
		until original or os.clock() > deadline
	else
		problem("il loader di Penguin non si è caricato: %s", tostring(err))
	end

	if original then
		for _, descendant in ipairs(original:GetDescendants()) do
			pcall(function() descendant.Archivable = true end)
		end
		original.Archivable = true

		local copy = original:Clone()
		pcall(function() original:Destroy() end)

		if copy then
			for _, descendant in ipairs(copy:GetDescendants()) do
				if descendant:IsA("LuaSourceContainer") then
					descendant:Destroy()
				end
			end
			template = copy
			log("stampo preso dal crocifisso di Penguin")
		end
	end

	if not template then
		problem("uso il crocifisso di riserva (due assi): il modello di Penguin non è arrivato")
		template = buildPlanks()
	end

	fetching = false
	return template
end

local armSpawner -- definita più giù, con lo spawner

--[[ Il crocifisso. Si chiama "Crucifix" e ha il tag, perché è quello che
     guardano lo spawner, Honcho e GradishCore; il tipo è un attributo, mai un
     nome diverso. Si consuma al primo utilizzo: il rituale lo distrugge. ]]
function Ritual.Give(kind, equip)
	if not PALETTES[kind] then kind = "Guiding" end

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		problem("niente crocifisso: non sei vivo")
		return nil
	end

	local tool = penguinTemplate():Clone()
	tool.Name = "Crucifix"
	tool.CanBeDropped = false
	tool.ToolTip = TOOLTIPS[kind]
	tool:SetAttribute("GradishCrucifix", true)
	tool:SetAttribute("CrucifixType", kind)
	pcall(function() CollectionService:AddTag(tool, "Crucifix") end)

	-- Il giallo si vede già in mano: una luce piccola, niente di più
	if kind == "Curious" then
		local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart", true)
		if handle then
			local glow = Instance.new("PointLight")
			glow.Name = "CuriousGlow"
			glow.Color = PALETTES.Curious.Main
			glow.Brightness = 1
			glow.Range = 8
			glow.Parent = handle
		end
	end

	tool.Equipped:Connect(function()
		armSpawner()
	end)

	tool.Parent = LocalPlayer:FindFirstChildOfClass("Backpack") or character

	if equip then
		pcall(function() humanoid:EquipTool(tool) end)
	end

	log("crocifisso %s dato", kind)
	return tool
end

-- Il tool esce dalla mano e diventa un modello che fluttua. Il tool si consuma
local function floatingCrucifix(tool, folder)
	local handle = tool and tool:FindFirstChild("Handle")
	local startCFrame = if handle and handle:IsA("BasePart")
		then handle.CFrame
		else workspace.CurrentCamera.CFrame * CFrame.new(0.8, -0.8, -2)

	local crucifix = Instance.new("Model")
	crucifix.Name = "RitualCrucifix"

	if tool then
		tool.Archivable = true
		for _, descendant in ipairs(tool:GetDescendants()) do
			pcall(function() descendant.Archivable = true end)
		end
		local copy = tool:Clone()
		tool:Destroy()
		if copy then
			for _, child in ipairs(copy:GetChildren()) do
				child.Parent = crucifix
			end
			copy:Destroy()
		end
	end

	for _, descendant in ipairs(crucifix:GetDescendants()) do
		if descendant:IsA("LuaSourceContainer") or descendant:IsA("TouchTransmitter") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end

	local primary = crucifix:FindFirstChild("Handle") or crucifix:FindFirstChildWhichIsA("BasePart", true)
	if not (primary and primary:IsA("BasePart")) then
		crucifix:ClearAllChildren()
		primary = newPart("Handle", Vector3.new(0.22, 1.7, 0.22), startCFrame, WOOD, Enum.Material.Wood, 0)
		primary.Parent = crucifix
		newPart("Crossbar", Vector3.new(0.95, 0.22, 0.22), startCFrame * CFrame.new(0, 0.42, 0), WOOD, Enum.Material.Wood, 0).Parent = crucifix
	end

	crucifix.PrimaryPart = primary
	crucifix:PivotTo(startCFrame)
	crucifix.Parent = folder
	return crucifix, startCFrame
end

---====== IL PALCO ======---
--[[ Tutto quello che il rituale crea vive qui: una cartella, un ciclo per
     frame, i colori legati alla tavolozza (così il passaggio al rosso del fail
     li cambia tutti insieme), gli emitter e gli anelli riusati, il FOV. ]]

local Stage = {}
Stage.__index = Stage

local function roleColour(palette, role)
	return palette[role] or palette.Main
end

local function applyBinding(entry, palette)
	local colour = roleColour(palette, entry.role)
	if entry.form == "sequence" then
		entry.instance[entry.property] = ColorSequence.new(colour)
	elseif entry.form == "whiteSequence" then
		entry.instance[entry.property] = ColorSequence.new(WHITE, colour)
	else
		entry.instance[entry.property] = colour
	end
end

function Stage.new(center, paletteName)
	local self = setmetatable({}, Stage)
	self.center = center
	self.palette = PALETTES[paletteName]
	self.fade = nil
	self.bound = {}
	self.bursts = setmetatable({}, { __mode = "k" })
	self.freeRings = {}
	self.kicks = {}
	self.cleanup = {}
	self.done = false

	self.folder = Instance.new("Folder")
	self.folder.Name = "CrucifixRitual"
	self.folder.Parent = workspace
	return self
end

function Stage:bind(instance, property, role, form)
	local entry = { instance = instance, property = property, role = role or "Main", form = form }
	table.insert(self.bound, entry)
	pcall(applyBinding, entry, self.palette)
	return instance
end

function Stage:setPalette(name, duration)
	local target = PALETTES[name]
	if not target or target == self.palette then return end
	self.fade = { from = self.palette, to = target, start = os.clock(), duration = duration or 0.5 }
	self.palette = target
end

-- Chiamata dal ciclo per frame: lavora solo durante un cambio di colore
function Stage:stepFade()
	local fade = self.fade
	if not fade then return end

	local alpha = math.clamp((os.clock() - fade.start) / fade.duration, 0, 1)
	local mixed = {}
	for key, colour in pairs(fade.from) do
		mixed[key] = colour:Lerp(fade.to[key], alpha)
	end
	for _, entry in ipairs(self.bound) do
		pcall(applyBinding, entry, mixed)
	end
	if alpha >= 1 then
		self.fade = nil
	end
end

-- Scintille rotonde: un emitter per parte, riusato a ogni scoppio
function Stage:burst(parent, count, speed)
	if not parent or not parent.Parent then return end
	local emitter = self.bursts[parent]
	if not emitter or not emitter.Parent then
		emitter = makeEmitter(parent, TEXTURES.Ball)
		emitter.Brightness = 3
		emitter.Lifetime = NumberRange.new(0.4, 1.8)
		emitter.Drag = 3
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = sequence({ { 0, 0.7 }, { 0.12, 0.35 }, { 0.4, 0.1 }, { 1, 0 } })
		emitter.Transparency = sequence({ { 0, 0 }, { 0.9, 0 }, { 1, 1 } })
		self:bind(emitter, "Color", "Main", "sequence")
		self.bursts[parent] = emitter
	end
	emitter.Speed = NumberRange.new(speed * 0.3, speed)
	emitter:Emit(count)
end

-- Un anello che si allarga sul pavimento e sparisce. Pochi, riusati
function Stage:ring(fromDiameter, toDiameter, duration, white)
	local ring = table.remove(self.freeRings)
	if not ring then
		local disc, image = glowDisc(self.folder, "RingWave", self.center + Vector3.new(0, 0.2, 0), fromDiameter, TEXTURES.Circle[1], WHITE, 256)
		ring = { disc = disc, image = image }
	end

	ring.disc.Size = Vector3.new(fromDiameter, 0.02, fromDiameter)
	ring.image.ImageColor3 = if white then WHITE else self.palette.Main
	ring.image.ImageTransparency = 0
	tween(ring.disc, duration, { Size = Vector3.new(toDiameter, 0.02, toDiameter) }, Enum.EasingStyle.Quart)
	tween(ring.image, duration, { ImageTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

	task.delay(duration + 0.05, function()
		if not self.done then
			table.insert(self.freeRings, ring)
		end
	end)
end

-- Una sfera di energia che si gonfia e svanisce
function Stage:sphere(position, toSize, duration, white)
	local ball = newPart("SphereWave", Vector3.one, CFrame.new(position), if white then WHITE else self.palette.Main, Enum.Material.ForceField, 0)
	ball.Shape = Enum.PartType.Ball
	ball.Parent = self.folder
	tween(ball, duration, { Size = Vector3.one * toSize, Transparency = 1 }, Enum.EasingStyle.Quart)
	task.delay(duration + 0.05, function()
		ball:Destroy()
	end)
end

-- Un lampo su tutto lo schermo. Una sola ScreenGui per rituale, riusata
function Stage:flash(colour, startTransparency, duration)
	if not self.flashFrame then
		local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if not playerGui then return end

		local gui = Instance.new("ScreenGui")
		gui.Name = "CrucifixFlash"
		gui.IgnoreGuiInset = true
		gui.ResetOnSpawn = false
		gui.DisplayOrder = 1000

		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BorderSizePixel = 0
		frame.BackgroundTransparency = 1
		frame.Parent = gui
		gui.Parent = playerGui

		self.flashGui = gui
		self.flashFrame = frame
	end

	self.flashFrame.BackgroundColor3 = colour
	self.flashFrame.BackgroundTransparency = startTransparency
	tween(self.flashFrame, duration, { BackgroundTransparency = 1 })
end

-- Un calcio al FOV. Si sommano tutti sopra lo stesso valore di base
function Stage:fovPunch(amount, duration)
	table.insert(self.kicks, { amount = amount, start = os.clock(), duration = duration })
end

function Stage:stepFov()
	local camera = workspace.CurrentCamera
	if not camera then return end

	local now = os.clock()
	local offset = 0
	for index = #self.kicks, 1, -1 do
		local kick = self.kicks[index]
		local progress = (now - kick.start) / kick.duration
		if progress >= 1 then
			table.remove(self.kicks, index)
		else
			offset += kick.amount * (1 - progress) ^ 3
		end
	end

	-- Se DOORS ha scritto il suo FOV da quando l'abbiamo toccato noi, quello
	-- è la nuova base. Se no, la base resta quella di prima
	local current = camera.FieldOfView
	if self.fovWritten == nil or math.abs(current - self.fovWritten) > 1e-3 then
		self.fovBase = current
	end

	if offset > 0 then
		local target = math.clamp(self.fovBase + offset, 1, 120)
		camera.FieldOfView = target
		self.fovWritten = target
	elseif self.fovWritten then
		camera.FieldOfView = self.fovBase
		self.fovWritten = nil
	end
end

-- Colore, contrasto e bloom solo sul tuo schermo, finché dura il rituale
function Stage:postEffects()
	local camera = workspace.CurrentCamera
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "CrucifixGrade"
	grade.Parent = camera

	local bloom = Instance.new("BloomEffect")
	bloom.Name = "CrucifixBloom"
	bloom.Intensity = 0
	bloom.Size = 30
	bloom.Threshold = 2
	bloom.Parent = camera

	table.insert(self.cleanup, grade)
	table.insert(self.cleanup, bloom)
	self.grade = grade
	self.bloom = bloom
	return grade, bloom
end

-- Polvere dai soffitti vicini: solo i più vicini, un colpo di particelle ciascuno
function Stage:ceilingDust(center)
	local ceilings = {}
	for _, ceiling in ipairs(CollectionService:GetTagged("PartCeiling")) do
		if ceiling:IsA("BasePart") then
			local distance = (ceiling.Position - center).Magnitude
			if distance < 90 then
				table.insert(ceilings, { part = ceiling, distance = distance })
			end
		end
	end
	table.sort(ceilings, function(a, b) return a.distance < b.distance end)

	for index = 1, math.min(#ceilings, 8) do
		local ceiling = ceilings[index].part
		local dust = makeEmitter(ceiling, TEXTURES.Dust, Color3.fromRGB(165, 160, 150))
		dust.LightEmission = 0
		dust.LightInfluence = 1
		dust.EmissionDirection = Enum.NormalId.Bottom
		dust.Acceleration = Vector3.new(0, -10, 0)
		dust.Lifetime = NumberRange.new(1, 3)
		dust.Speed = NumberRange.new(3, 12)
		dust.SpreadAngle = Vector2.new(60, 60)
		dust.Size = sequence({ { 0, 2.1 }, { 1, 1.3 } })
		dust.Transparency = sequence({ { 0, 1 }, { 0.23, 0.86 }, { 0.8, 0.89 }, { 1, 1 } })
		dust.RotSpeed = NumberRange.new(-35, 35)
		dust.Rotation = NumberRange.new(-360, 360)
		dust:Emit(math.clamp(math.floor(ceiling.Size.Magnitude * 0.07), 3, 12))
		task.delay(4, function()
			dust:Destroy()
		end)
	end
end

function Stage:destroy()
	if self.done then return end
	self.done = true

	if self.stepName then
		pcall(function() RunService:UnbindFromRenderStep(self.stepName) end)
	end
	if self.poseConnection then
		self.poseConnection:Disconnect()
	end

	-- Il FOV torna quello di DOORS, se l'ultimo a scriverlo siamo stati noi
	local camera = workspace.CurrentCamera
	if camera and self.fovWritten and math.abs(camera.FieldOfView - self.fovWritten) < 1e-3 then
		camera.FieldOfView = self.fovBase
	end

	for _, item in ipairs(self.cleanup) do
		pcall(function()
			if typeof(item) == "RBXScriptConnection" then
				item:Disconnect()
			elseif typeof(item) == "Instance" then
				item:Destroy()
			else
				item()
			end
		end)
	end
	table.clear(self.cleanup)

	if self.flashGui then self.flashGui:Destroy() end
	self.folder:Destroy()
	table.clear(self.bound)
end

---====== L'ENTITÀ GENERICA ======---
--[[ Per un modello qualsiasi: si muove tutto intero (alzato dalla luce,
     tirato giù dalle catene), e le catene prendono otto punti attorno al suo
     box, girato verso di te. Un'entità con un corpo suo (Honcho) passa il
     proprio Body e usa questo solo come esempio. ]]

local function nearestPart(model, point)
	local best, bestDistance = nil, math.huge
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local distance = (descendant.Position - point).Magnitude
			if distance < bestDistance then
				best, bestDistance = descendant, distance
			end
		end
	end
	return best
end

local function genericBody(model, opts)
	local pivot = model:GetPivot()
	local boxCFrame, boxSize = model:GetBoundingBox()
	if opts.BoxSize then
		boxCFrame, boxSize = CFrame.new(pivot.Position), opts.BoxSize
	end
	boxSize = Vector3.new(math.max(boxSize.X, 2), math.max(boxSize.Y, 3), math.max(boxSize.Z, 2))

	local scale = opts.Scale or math.clamp(boxSize.Y / 6, 0.6, 2)
	local bottom = boxCFrame.Position.Y - boxSize.Y / 2
	local floorY = floorBelow(boxCFrame.Position, model) or bottom
	local top = boxCFrame.Position.Y + boxSize.Y / 2

	local body = {
		Scale  = scale,
		Anchor = Vector3.new(pivot.Position.X, floorY, pivot.Position.Z),
		Radius = math.clamp(math.max(boxSize.X, boxSize.Z) / 2 + 4, 6, 16),
		-- Abbastanza giù da non vedere più niente di lui
		Depth  = (top - floorY) + (LIFT + 4) * scale,
		Generic = true,
	}

	function body.Chains(facing)
		local chains = {}
		local frame = CFrame.new(boxCFrame.Position) * facing
		local half = boxSize / 2
		for _, spec in ipairs(GENERIC_CHAINS) do
			local world = frame:PointToWorldSpace(spec.point * half)
			local part = nearestPart(model, world)
			if part then
				table.insert(chains, {
					part   = part,
					offset = part.CFrame:PointToObjectSpace(world),
					angle  = spec.angle,
					reach  = spec.reach,
					at     = spec.at,
				})
			end
		end
		return chains
	end

	function body.Place(yOffset, localOffset)
		model:PivotTo(CFrame.new(pivot.Position + Vector3.new(0, yOffset, 0)) * pivot.Rotation * localOffset)
	end

	-- I suoni dell'entità si spengono mentre affonda, come nel rituale di Vynixu
	local volumes = {}
	function body.Mute()
		for _, sound in ipairs(model:GetDescendants()) do
			if sound:IsA("Sound") then
				volumes[sound] = sound.Volume
				tween(sound, 3, { Volume = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			end
		end
	end

	function body.Vanish()
		if model.Parent then model:Destroy() end
	end

	function body.Recover()
		model:PivotTo(pivot)
		for sound, volume in pairs(volumes) do
			if sound.Parent then sound.Volume = volume end
		end
	end

	return body
end

---====== I TEMPI ======---

local function sinkWith(jolts, elapsed)
	local sunk = 0
	for _, jolt in ipairs(jolts) do
		if elapsed < jolt.time then break end
		local pull = math.clamp((elapsed - jolt.time) / JOLT_TIME, 0, 1)
		local climb = jolt.climb * math.clamp((elapsed - jolt.time - JOLT_TIME) / 0.5, 0, 1)
		sunk = sunk + (jolt.reach - sunk) * (1 - (1 - pull) ^ 3) - climb
	end
	return sunk
end

-- Da 0 a 1: quanto è sprofondato
local function sinkAt(elapsed, fail)
	if fail then
		local sunk = sinkWith(FAIL.Jolts, elapsed)
		-- Si pianta e risale: il buco non lo tiene più
		return sunk * (1 - smooth((elapsed - FAIL.Climb[1]) / (FAIL.Climb[2] - FAIL.Climb[1])))
	end

	local sunk = sinkWith(JOLTS, elapsed)
	if elapsed >= PLUNGE_AT then
		sunk += (1 - sunk) * backIn(math.clamp((elapsed - PLUNGE_AT) / (SLAM_AT - PLUNGE_AT), 0, 1))
	end
	return sunk
end

-- Quanto lo tiene su la luce, in stud per scala 1
local function baseLift(elapsed)
	local rise = math.clamp((elapsed - 0.55) / 0.45, 0, 1)
	local strain = math.clamp((elapsed - 1.3) / 1.2, 0, 1)
	local jerk = math.sin(math.pi * math.clamp((elapsed - 1.1) / 0.25, 0, 1))
	return 1.5 * (1 - (1 - rise) ^ 2) + 0.7 * (1 - math.cos(strain * math.pi)) / 2 - 0.45 * jerk
end

local function liftAt(elapsed, fail)
	if not fail or elapsed < FAIL.Climb[1] then
		return baseLift(elapsed)
	end

	-- Nel fail tira verso l'alto con tutte le forze, poi, libero, ricade
	local held = baseLift(FAIL.Climb[1]) + 1.1 * smooth((elapsed - FAIL.Climb[1]) / (FAIL.Break - FAIL.Climb[1]))
	if elapsed < FAIL.Fall[1] then
		return held
	end
	local fall = math.clamp((elapsed - FAIL.Fall[1]) / (FAIL.Fall[2] - FAIL.Fall[1]), 0, 1)
	return held * (1 - fall * fall)
end

-- Appeso alle catene oscilla e si gira; si ferma quando si pianta o si aggrappa
local function swayAt(elapsed, fail, scale)
	local stopAt = if fail then FAIL.Resist else 4.5
	local hold = math.clamp((elapsed - 1.1) / 0.4, 0, 1) * (1 - math.clamp((elapsed - stopAt) / 0.3, 0, 1))
	local yaw = (math.sin(elapsed * 5.3) * 14 + math.sin(elapsed * 13.1 + 1) * 5) * hold
	local side = math.sin(elapsed * 4.1) * 0.35 * hold * scale
	return CFrame.new(side, 0, 0) * CFrame.Angles(0, math.rad(yaw), 0)
end

