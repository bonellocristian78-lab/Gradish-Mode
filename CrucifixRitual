local function chainBeam(parent, from, to, width)
	local beam = Instance.new("Beam")
	beam.Attachment0 = from
	beam.Attachment1 = to
	beam.Texture = "rbxassetid://" .. TEXTURES.Chain
	beam.TextureMode = Enum.TextureMode.Static
	beam.TextureLength = 1
	beam.TextureSpeed = -2
	beam.FaceCamera = true
	beam.Width0 = 1.1 * width
	beam.Width1 = 0.85 * width
	beam.Brightness = 1
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Transparency = NumberSequence.new(0)
	beam.Segments = 1
	beam.Parent = parent
	return beam
end

local function attachmentAt(parent, worldPosition)
	local attachment = Instance.new("Attachment")
	attachment.Position = parent.CFrame:PointToObjectSpace(worldPosition)
	attachment.Parent = parent
	return attachment
end

--[[ Ritual.Run(opzioni) -- aspetta la fine del rituale

         Model    il modello dell'entità                      (obbligatorio)
         Tool     il crocifisso usato: si consuma
         Resist   true = l'entità resiste, il rituale fallisce
         Kind     "Guiding" / "Curious" / "Fail" invece di leggerlo dal tool
         Alive    function() -> false per interromperlo a metà
         BoxSize  Vector3: il box da usare se quello del modello mente
                  (un Part invisibile enorme, per dire)
         Body     il corpo di un'entità che si anima da sola (Honcho). Senza,
                  si usa quello generico qui sopra

     Il Body può avere: Scale, Anchor, Radius, Depth, Chains(facing),
     SnapFirst, SnapGroups, Place(y, offset), Pose(elapsed, fail),
     Start(stage), Step(stage, elapsed, dt), Jolt(stage, forza),
     Scream(stage, "hit"/"roar"), Mute(), Vanish(stage), After(stage),
     BreakFree(stage), Land(stage), Recover(stage), Lights, Emitters.

     Rende "Banished", "Failed" o "Aborted". ]]
function Ritual.Run(opts)
	local model = opts.Model
	if not (model and model.Parent) then return "Aborted" end
	if Ritual.Busy[model] then return "Aborted" end
	Ritual.Busy[model] = true

	local kind, fail = Ritual.Outcome(opts.Tool, opts.Resist)
	if opts.Kind == "Fail" then
		fail = true
	elseif opts.Kind == "Guiding" or opts.Kind == "Curious" then
		kind = opts.Kind
	end

	local alive = opts.Alive or function() return true end
	local body = opts.Body or genericBody(model, opts)
	local scale = body.Scale or 1
	local center = body.Anchor
	local floorY = center.Y
	local radius = body.Radius
	local diameter = radius * 2
	local depth = body.Depth

	local stage = Stage.new(center, kind)
	stage.model = model
	stage.body = body
	stage.fail = fail
	stage.kind = kind
	stage.floorY = floorY
	stage.radius = radius
	stage.scale = scale
	stage.startedAt = os.clock()

	log("rituale %s%s su %s", kind, fail and " (fallirà)" or "", model.Name)

	local character = LocalPlayer.Character
	local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
	local facing = CFrame.identity
	if playerRoot then
		local toPlayer = flatUnit(playerRoot.Position - center)
		if toPlayer then facing = CFrame.lookAt(Vector3.zero, toPlayer) end
	end
	stage.facing = facing

	local result = "Aborted"
	local function wrapUp()
		stage:destroy()
		Ritual.Busy[model] = nil
		return result
	end

	local function at(seconds)
		while true do
			if stage.done or not alive() then return false end
			local remaining = stage.startedAt + seconds - os.clock()
			if remaining <= 0 then return true end
			task.wait(math.min(remaining, 0.1))
		end
	end

	if body.Start then
		local ok, err = pcall(body.Start, stage)
		if not ok then problem("Body.Start: %s", tostring(err)) end
	end

	-- Cosa comanda il ciclo per frame
	local layers, layerSpeeds, guis = {}, { 24, -38, 55, -14 }, {}
	local chains, flights = {}, {}
	local spinBoost, pulse, shudder, crucifixSpin = 1, 0, 0, 1.6
	local swirl = nil
	local vanished = false

	---- 0. IL COLPO ----
	local grade, bloom = stage:postEffects()
	stage:flash(WHITE, 0.15, 0.35)
	stage:fovPunch(12, 0.6)
	shake(7, 10, 0, 0.8)
	local ritualSound = playSound(SOUND_IDS.Crucifix, 1, 1, stage.folder)
	flickerRoom(playerRoom(), 2)
	tween(grade, 0.4, { TintColor = stage.palette.Tint, Contrast = 0.25, Saturation = -0.35 })
	tween(bloom, 0.4, { Intensity = 1.2, Threshold = 0.9 })

	-- Diventa bianco per un attimo. Occluded: quando affonda il pavimento lo copre
	local glow = Instance.new("Highlight")
	glow.DepthMode = Enum.HighlightDepthMode.Occluded
	glow.FillColor = WHITE
	glow.FillTransparency = 0
	glow.OutlineTransparency = 0
	glow.Parent = model
	stage:bind(glow, "OutlineColor", "Main")
	table.insert(stage.cleanup, glow)
	tween(glow, 0.35, { FillTransparency = 0.85 })

	local crucifix, fromCFrame = floatingCrucifix(opts.Tool, stage.folder)
	local crucifixPart = crucifix.PrimaryPart

	local crucifixLight = Instance.new("PointLight")
	crucifixLight.Brightness = 0
	crucifixLight.Range = 16
	crucifixLight.Shadows = false
	crucifixLight.Parent = crucifixPart
	stage:bind(crucifixLight, "Color", "Main")
	tween(crucifixLight, 0.5, { Brightness = 4 })

	local crucifixGlow = Instance.new("Highlight")
	crucifixGlow.DepthMode = Enum.HighlightDepthMode.Occluded
	crucifixGlow.FillTransparency = 0.5
	crucifixGlow.OutlineColor = WHITE
	crucifixGlow.OutlineTransparency = 0
	crucifixGlow.Parent = crucifix
	stage:bind(crucifixGlow, "FillColor", "Main")

	local twinkles = makeEmitter(crucifixPart, TEXTURES.Twinkle)
	twinkles.Rate = 25
	twinkles.Lifetime = NumberRange.new(0.4, 1)
	twinkles.SpreadAngle = Vector2.new(180, 180)
	twinkles.Speed = NumberRange.new(1, 3)
	twinkles.Size = sequence({ { 0, 0.5 }, { 0.3, 1.8 }, { 0.35, 0.45 }, { 1, 0.3 } })
	twinkles.Transparency = sequence({ { 0, 0.3 }, { 1, 1 } })
	twinkles.RotSpeed = NumberRange.new(-10, 10)
	stage:bind(twinkles, "Color", "Main", "sequence")

	local floatAt = fromCFrame.Position + Vector3.new(0, 1.2, 0)
	if playerRoot then
		local toEntity = flatUnit(center - playerRoot.Position) or Vector3.new(0, 0, -1)
		floatAt = playerRoot.Position + toEntity * 3 + Vector3.new(0, 1.8, 0)
	end
	stage:sphere(floatAt, 14, 0.6, true)

	--[[ UN SOLO CICLO PER FRAME: crocifisso, cerchio, catene in volo, entità,
	     cambio di colore, FOV. Dopo la camera, così il FOV e la posizione
	     non vengono riscritti prima di arrivare sullo schermo. ]]
	local crucifixAngle = 0
	stage.stepName = "GradishCrucifixRitual" .. tostring(stage.startedAt)
	RunService:BindToRenderStep(stage.stepName, Enum.RenderPriority.Last.Value, function(deltaTime)
		local elapsed = os.clock() - stage.startedAt

		if crucifix.Parent then
			crucifixAngle += crucifixSpin * deltaTime
			local rise = 1 - (1 - math.clamp(elapsed / 0.6, 0, 1)) ^ 3
			local position = fromCFrame.Position:Lerp(floatAt, rise) + Vector3.new(0, math.sin(elapsed * 2.2) * 0.15 * rise, 0)
			crucifix:PivotTo(CFrame.new(position) * CFrame.Angles(0, crucifixAngle, 0) * fromCFrame.Rotation)
		end

		for index, image in ipairs(layers) do
			image.Rotation = (image.Rotation + layerSpeeds[index] * spinBoost * deltaTime) % 360
		end
		-- Il lampo del cerchio a ogni strattone: si scrive solo mentre si spegne
		if pulse > 0 then
			pulse = math.max(pulse - deltaTime * 2.5, 0)
			for _, gui in ipairs(guis) do
				gui.Brightness = 4 + 10 * pulse
			end
		end
		if swirl then
			swirl.Rotation = (swirl.Rotation - 150 * spinBoost * deltaTime) % 360
		end

		-- Le catene in volo, tutte qui invece di un Heartbeat per ognuna
		for index = #flights, 1, -1 do
			local flight = flights[index]
			local chain = flight.chain
			if not (chain.grip.Parent and flight.target.Parent and chain.beam.Parent) then
				table.remove(flights, index)
			else
				local progress = math.clamp((os.clock() - flight.shotAt) / CHAIN_FLIGHT, 0, 1)
				local gripWorld = flight.target.CFrame:PointToWorldSpace(chain.grip.Position)
				flight.tip.Position = flight.anchor.CFrame:PointToObjectSpace(flight.origin:Lerp(gripWorld, progress * progress))
				if progress >= 1 then
					table.remove(flights, index)
					chain.beam.Attachment1 = chain.grip
					flight.tip:Destroy()
					stage:burst(chain.grip, 16, 14)
					shake(1.5, 8, 0, 0.3)
				end
			end
		end

		if not vanished and model.Parent then
			shudder = math.max(shudder - deltaTime * 2.5, 0)
			local y = (liftAt(elapsed, fail) * scale) - depth * sinkAt(elapsed, fail)
			local j = (0.04 + 0.3 * shudder) * scale
			local offset = CFrame.new((math.random() - 0.5) * j, (math.random() - 0.5) * j * 0.5, (math.random() - 0.5) * j)
				* swayAt(elapsed, fail, scale)
			local ok, err = pcall(body.Place, y, offset)
			if not ok and not stage.placeWarned then
				stage.placeWarned = true
				problem("Body.Place: %s", tostring(err))
			end
			if body.Step then
				pcall(body.Step, stage, elapsed, deltaTime)
			end
		end

		stage:stepFade()
		stage:stepFov()
	end)

	-- La posa va nei giunti dopo l'Animator, altrimenti lui la rimette a zero
	if body.Pose then
		stage.poseConnection = RunService.PreSimulation:Connect(function()
			if not vanished and model.Parent then
				pcall(body.Pose, os.clock() - stage.startedAt, fail)
			end
		end)
	end

	---- 0.25 IL CERCHIO: i quattro anelli di DOORS si aprono sotto di lui ----
	if not at(0.25) then return wrapUp() end
	local circleParts = {}
	for index, textureId in ipairs(TEXTURES.Circle) do
		local disc, image = glowDisc(stage.folder, "CircleLayer", center + Vector3.new(0, 0.04 + index * 0.02, 0), 0.2, textureId, stage.palette.Main, 512)
		stage:bind(image, "ImageColor3", "Main")
		image.Rotation = math.random(0, 359)
		tween(disc, 0.8, { Size = Vector3.new(diameter, 0.02, diameter) }, Enum.EasingStyle.Back)
		tween(image, 0.5, { ImageTransparency = 0 })
		table.insert(layers, image)
		table.insert(guis, image.Parent)
		table.insert(circleParts, disc)
		task.wait(0.06)
	end

	local lamp = newPart("Lamp", Vector3.one * 0.2, CFrame.new(center + Vector3.new(0, 3, 0)), WHITE, Enum.Material.SmoothPlastic, 1)
	lamp.Parent = stage.folder
	local circleLight = Instance.new("PointLight")
	circleLight.Brightness = 0
	circleLight.Range = math.min(radius * 3.5, 60)
	circleLight.Shadows = false
	circleLight.Parent = lamp
	stage:bind(circleLight, "Color", "Main")
	tween(circleLight, 0.5, { Brightness = 5 })

	local emitterBase = newPart("CircleEmitters", Vector3.new(diameter * 0.9, 0.5, diameter * 0.9), CFrame.new(center + Vector3.new(0, 0.3, 0)), WHITE, Enum.Material.SmoothPlastic, 1)
	emitterBase.Parent = stage.folder

	local sparks = makeEmitter(emitterBase, TEXTURES.Spark)
	sparks.Rate = 45
	sparks.EmissionDirection = Enum.NormalId.Top
	sparks.Lifetime = NumberRange.new(0.6, 2.2)
	sparks.Speed = NumberRange.new(2, 9)
	sparks.Acceleration = Vector3.new(0, 6, 0)
	sparks.Drag = 1
	sparks.SpreadAngle = Vector2.new(12, 12)
	sparks.Size = sequence({ { 0, 1.4 }, { 1, 0.2 } })
	sparks.Transparency = sequence({ { 0, 1 }, { 0.2, 0.25 }, { 1, 1 } })
	sparks.RotSpeed = NumberRange.new(35, 100)
	stage:bind(sparks, "Color", "Main", "sequence")

	local lines = makeEmitter(emitterBase, TEXTURES.Lines)
	lines.Rate = 35
	lines.EmissionDirection = Enum.NormalId.Top
	lines.Orientation = Enum.ParticleOrientation.VelocityParallel
	lines.Lifetime = NumberRange.new(0.8, 1.2)
	lines.Speed = NumberRange.new(4, 10)
	lines.Acceleration = Vector3.new(0, 14, 0)
	lines.Size = sequence({ { 0, 1.5 }, { 1, 1.3 } })
	lines.Squash = sequence({ { 0, -1.2 }, { 1, 1 } })
	lines.Transparency = sequence({ { 0, 1 }, { 0.5, 0.35 }, { 1, 1 } })
	stage:bind(lines, "Color", "Main", "sequence")

	---- 0.55 LA LUCE LO SOLLEVA ----
	if not at(0.55) then return wrapUp() end
	stage:ring(diameter * 0.4, diameter * 1.8, 0.7, true)
	stage:burst(emitterBase, 50, 26)
	shake(4, 10, 0, 0.6)
	glow.FillTransparency = 0.3
	tween(glow, 0.4, { FillTransparency = 0.85 })

	---- 0.95 LE CATENE partono dal bordo del cerchio ----
	if not at(0.95) then return wrapUp() end
	local anchor = newPart("ChainAnchor", Vector3.one * 0.2, CFrame.new(center), WHITE, Enum.Material.SmoothPlastic, 1)
	anchor.Parent = stage.folder

	local chainSpecs = body.Chains and body.Chains(facing) or {}
	local function shootChain(spec)
		local target = spec.part
		if not (target and target.Parent) then return end

		local angle = math.rad(spec.angle)
		local direction = facing:VectorToWorldSpace(Vector3.new(math.cos(angle), 0, math.sin(angle)))
		local origin = center + direction * radius * spec.reach + Vector3.new(0, 0.2, 0)
		local from = attachmentAt(anchor, origin)
		local tip = attachmentAt(anchor, origin)

		local grip = Instance.new("Attachment")
		grip.Name = "CrucifixChainGrip"
		grip.Position = spec.offset or Vector3.zero
		grip.Parent = target
		table.insert(stage.cleanup, grip)

		local chain = { name = spec.name or target.Name, grip = grip, beam = chainBeam(stage.folder, from, tip, scale) }
		stage:bind(chain.beam, "Color", "Main", "sequence")
		table.insert(chains, chain)
		table.insert(flights, { chain = chain, target = target, tip = tip, anchor = anchor, origin = origin, shotAt = os.clock() })
	end

	task.spawn(function()
		for _, spec in ipairs(chainSpecs) do
			if not at(spec.at) then return end
			if model.Parent then shootChain(spec) end
		end
	end)

	---- 1.0 L'URLO: lo tengono, si divincola ----
	if not at(1.0) then return wrapUp() end
	if body.Scream then pcall(body.Scream, stage, "hit") end
	TweenService:Create(glow, TweenInfo.new(0.22, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { FillTransparency = 0.45 }):Play()
	for _, light in ipairs(body.Lights or {}) do
		stage:bind(light, "Color", "Main")
		tween(light, 0.4, { Brightness = 2 })
	end
	for _, emitter in ipairs(body.Emitters or {}) do
		stage:bind(emitter, "Color", "Main", "whiteSequence")
		if emitter.Name == "Triangles" then emitter.Enabled = true end
	end

	---- 2.5 GIÙ, A STRATTONI: al centro si apre il buco ----
	if not at(2.5) then return wrapUp() end
	playSound(SOUND_IDS.Earthquake, 0.9, 0.5, stage.folder)
	stage:ceilingDust(center)
	tween(bloom, 3.3, { Intensity = 2.2, Size = 40 })
	tween(grade, 3.3, { Contrast = 0.45, Saturation = -0.5 })
	tween(circleLight, 3.3, { Brightness = 9 })
	for _, emitter in ipairs(body.Emitters or {}) do
		emitter.Enabled = true
	end
	if not fail and body.Mute then pcall(body.Mute) end

	-- Il buco: un disco nero con il vortice e un bordo di luce
	local hole = newPart("Hole", Vector3.new(0.04, 0.1, 0.1), CFrame.new(center + Vector3.new(0, 0.14, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(4, 6, 12), Enum.Material.SmoothPlastic, 0)
	hole.Shape = Enum.PartType.Cylinder
	hole.Parent = stage.folder
	local swirlDisc, swirlImage = glowDisc(stage.folder, "HoleSwirl", center + Vector3.new(0, 0.16, 0), 0.1, TEXTURES.Circle[3], stage.palette.Deep, 256)
	local rimDisc, rimImage = glowDisc(stage.folder, "HoleRim", center + Vector3.new(0, 0.18, 0), 0.1, TEXTURES.Circle[1], WHITE, 256)
	stage:bind(swirlImage, "ImageColor3", "Deep")
	swirlImage.ImageTransparency = 0
	rimImage.ImageTransparency = 0
	swirl = swirlImage

	local holeSize = math.clamp(diameter * 0.35, 5, radius * 1.2)
	local function sizeHole(size, duration, direction)
		local style, way = Enum.EasingStyle.Back, direction or Enum.EasingDirection.Out
		size = math.max(size, 0.1)
		tween(hole, duration, { Size = Vector3.new(0.04, size, size) }, style, way)
		tween(swirlDisc, duration, { Size = Vector3.new(size * 1.05, 0.02, size * 1.05) }, style, way)
		tween(rimDisc, duration, { Size = Vector3.new(size * 1.3, 0.02, size * 1.3) }, style, way)
	end

	local quakeUntil = if fail then FAIL.Break else SLAM_AT
	task.spawn(function()
		while os.clock() - stage.startedAt < quakeUntil and not stage.done and alive() do
			local progress = math.clamp((os.clock() - stage.startedAt - 2.5) / 3.3, 0, 1)
			spinBoost = 1 + 3 * progress
			crucifixSpin = 1.6 + (if fail then 16 else 10) * progress
			shake(1.5 + 3 * progress, 10, 0.1, 0.5)
			task.wait(0.35)
		end
	end)

	local function jolt(strength)
		pulse = 1
		shudder = 1
		shake(3 + 5 * strength, 14, 0, 0.6)
		stage:fovPunch(3 + 5 * strength, 0.4)
		playSound(SOUND_IDS.Slam, 0.4 + 0.6 * strength, 1.4 - 0.3 * strength, stage.folder)
		stage:ring(diameter * 0.2, diameter * (0.9 + 0.5 * strength), 0.6, true)
		stage:burst(emitterBase, math.floor(20 + 40 * strength), 22)
		for _, chain in ipairs(chains) do
			if chain.beam.Parent then
				chain.beam.Brightness = 5
				tween(chain.beam, 0.35, { Brightness = 1 })
			end
		end
		for _, light in ipairs(body.Lights or {}) do
			light.Brightness = 3 + 5 * strength
			tween(light, 0.5, { Brightness = 2 + 2 * strength })
		end
		if body.Jolt then pcall(body.Jolt, stage, strength) end
	end

	-- Il crocifisso si spezza nelle schegge di DOORS, che cadono davvero
	local function shatterCrucifix(colour, speed)
		local position = crucifix:GetPivot().Position
		for _, descendant in ipairs(crucifix:GetDescendants()) do
			if descendant:IsA("BasePart") then descendant.Transparency = 1 end
		end
		for _, meshId in ipairs(SHARD_MESHES) do
			local spin = CFrame.Angles(math.random() * 6.28, math.random() * 6.28, math.random() * 6.28)
			local shard = newPart("Shard", Vector3.one * 0.3, CFrame.new(position + randomUnit() * 0.3) * spin, colour, Enum.Material.Wood, 0)
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.FileMesh
			mesh.MeshId = "rbxassetid://" .. meshId
			mesh.Parent = shard
			shard.Anchored = false
			shard.CanCollide = true
			shard.Parent = stage.folder
			shard.AssemblyLinearVelocity = randomUnit() * speed + Vector3.new(0, 12, 0)
			shard.AssemblyAngularVelocity = randomUnit() * 25
			task.delay(2.4, function()
				if shard.Parent then tween(shard, 0.6, { Transparency = 1 }) end
			end)
		end
	end

	-- La catena si spezza vicino alla parte: quella parte è libera
	local function snap(chain, strength)
		if not chain.beam.Parent then return end
		chain.beam:Destroy()
		if chain.grip.Parent then
			stage:burst(chain.grip, math.floor(30 + 25 * strength), 26)
		end
		if body.Snap then pcall(body.Snap, stage, chain) end
	end

	local function snapNamed(names, strength)
		for _, chain in ipairs(chains) do
			if table.find(names, chain.name) then
				snap(chain, strength)
			end
		end
	end

	if fail then
		---- IL FAIL ----
		for _, step in ipairs(FAIL.Jolts) do
			if not at(step.time) then return wrapUp() end
			sizeHole(holeSize * (0.3 + 0.2 * step.strength), 0.3)
			jolt(step.strength)
		end

		-- 3.36 resiste: il cerchio si fa rosso e il crocifisso si incrina
		if not at(FAIL.Resist) then return wrapUp() end
		stage:setPalette("Fail", 0.5)
		tween(grade, 0.5, { TintColor = PALETTES.Fail.Tint, Contrast = 0.5, Saturation = -0.2 })
		playSound(SOUND_IDS.Slam, 1.2, 0.6, stage.folder)
		stage:flash(PALETTES.Fail.Main, 0.7, 0.4)
		stage:burst(crucifixPart, 25, 12)
		shake(5, 18, 0, 0.8)
		crucifixLight.Brightness = 10
		tween(crucifixLight, 0.6, { Brightness = 3 })

		-- 3.62 il buco non lo tiene più e si richiude
		if not at(FAIL.Climb[1]) then return wrapUp() end
		sizeHole(0, FAIL.Climb[2] - FAIL.Climb[1], Enum.EasingDirection.In)

		-- Strappa le catene a coppie
		local groups = body.SnapGroups or { { 1, 2 }, { 3, 4 }, { 5, 6 } }
		for index, time in ipairs(FAIL.Snaps) do
			if not at(time) then return wrapUp() end
			local group = groups[index] or {}
			local strength = 0.5 + 0.15 * index
			for _, key in ipairs(group) do
				if type(key) == "number" then
					if chains[key] then snap(chains[key], strength) end
				else
					snapNamed({ key }, strength)
				end
			end
			shudder = 1
			pulse = 1
			shake(4 + 2 * index, 16, 0, 0.5)
			stage:fovPunch(4 + 2 * index, 0.4)
			playSound(SOUND_IDS.Slam, 0.8, 1.6 + 0.1 * index, stage.folder)
			stage:ring(diameter * 0.2, diameter * (0.7 + 0.2 * index), 0.5, false)
		end

		-- 4.9 SI LIBERA: saltano tutte le catene, il crocifisso esplode
		if not at(FAIL.Break) then return wrapUp() end
		for _, chain in ipairs(chains) do
			snap(chain, 1)
		end
		if body.Scream then pcall(body.Scream, stage, "roar") end
		if body.BreakFree then pcall(body.BreakFree, stage) end

		pcall(function()
			tween(ritualSound, 0.4, { Volume = 0 })
		end)
		playSound(SOUND_IDS.Slam, 2, 0.7, stage.folder)
		stage:flash(PALETTES.Fail.Main, 0.2, 0.8)
		stage:fovPunch(16, 0.8)
		shake(12, 16, 0, 1.6)
		stage:ceilingDust(center)
		stage:sphere(center + Vector3.new(0, 2, 0), radius * 3.2, 0.9, false)
		for index = 0, 2 do
			task.delay(index * 0.12, function()
				if not stage.done then
					stage:ring(diameter * 0.3, diameter * (3 - index * 0.6), 0.9, false)
				end
			end)
		end

		-- Il crocifisso si spezza, e le schegge sono rosse
		shatterCrucifix(PALETTES.Fail.Deep, 22)
		stage:burst(crucifixPart, 70, 28)
		tween(crucifixLight, 0.15, { Brightness = 14 })
		task.delay(0.2, function()
			if crucifixLight.Parent then tween(crucifixLight, 0.8, { Brightness = 0 }) end
		end)
		tween(crucifixGlow, 0.5, { FillTransparency = 1, OutlineTransparency = 1 })
		twinkles.Enabled = false

		-- Il cerchio si rompe: gli anelli volano via e si spengono
		sparks.Enabled = false
		lines.Enabled = false
		spinBoost = 6
		for index, disc in ipairs(circleParts) do
			tween(disc, 0.7, { Size = Vector3.new(diameter * (1.4 + 0.2 * index), 0.02, diameter * (1.4 + 0.2 * index)) }, Enum.EasingStyle.Quart)
			tween(layers[index], 0.7, { ImageTransparency = 1 })
		end
		tween(circleLight, 0.1, { Brightness = 14 })
		task.delay(0.15, function()
			if circleLight.Parent then tween(circleLight, 1.2, { Brightness = 0 }) end
		end)
		tween(glow, 0.8, { FillTransparency = 1, OutlineTransparency = 1 })

		-- 5.62 ricade e atterra
		if not at(FAIL.Fall[2]) then return wrapUp() end
		shake(6, 12, 0, 0.8)
		playSound(SOUND_IDS.Slam, 1, 0.8, stage.folder)
		stage:ring(diameter * 0.2, diameter * 1.1, 0.6, true)
		if body.Land then pcall(body.Land, stage) end

		-- 6.0 il mondo torna normale
		if not at(FAIL.Settle) then return wrapUp() end
		tween(grade, 1.2, { TintColor = WHITE, Contrast = 0, Saturation = 0 })
		tween(bloom, 1.2, { Intensity = 0 })

		if not at(FAIL.Done) then return wrapUp() end
		pcall(function() glow:Destroy() end)
		if body.Recover then
			local ok, err = pcall(body.Recover, stage)
			if not ok then problem("Body.Recover: %s", tostring(err)) end
		end
		result = "Failed"
		log("fallito: %s si è liberato", model.Name)
		return wrapUp()
	end

	---- IL RITUALE RIUSCITO ----
	for index, step in ipairs(JOLTS) do
		if not at(step.time) then return wrapUp() end
		sizeHole(holeSize * (0.45 + 0.55 * index / #JOLTS), 0.3)
		jolt(step.strength)
		if index == #JOLTS then
			local first = body.SnapFirst
			if type(first) == "string" then
				snapNamed({ first }, 0.8)
			elseif chains[1] then
				snap(chains[1], 0.8)
			end
			stage:flash(WHITE, 0.6, 0.25)
		end
	end

	---- 5.35 L'ULTIMA TIRATA ----
	if not at(PLUNGE_AT) then return wrapUp() end
	shake(6, 16, 0.3, 0.4)
	tween(circleLight, 0.45, { Brightness = 14 })
	for _, light in ipairs(body.Lights or {}) do
		tween(light, 0.45, { Brightness = 8 })
	end

	---- 5.8 IL COLPO FINALE: sparisce nel buco ----
	if not at(SLAM_AT) then return wrapUp() end
	vanished = true
	if body.Vanish then
		local ok, err = pcall(body.Vanish, stage)
		if not ok then problem("Body.Vanish: %s", tostring(err)) end
	end
	if model.Parent then model:Destroy() end
	if opts.OnVanish then task.spawn(opts.OnVanish) end

	playSound(SOUND_IDS.Slam, 2, 0.9, stage.folder)
	stage:flash(WHITE, 0.05, 1)
	stage:fovPunch(18, 0.8)
	shake(12, 16, 0, 1.6)
	stage:burst(emitterBase, 220, 45)
	stage:sphere(center + Vector3.new(0, 2, 0), radius * 3.2, 0.9, false)
	for index = 0, 2 do
		task.delay(index * 0.12, function()
			if not stage.done then
				stage:ring(diameter * 0.3, diameter * (3 - index * 0.6), 0.9, index == 0)
			end
		end)
	end
	sizeHole(0, 0.35, Enum.EasingDirection.In)
	shatterRoom(playerRoom())

	shatterCrucifix(WOOD, 16)
	stage:burst(crucifixPart, 60, 25)
	tween(crucifixLight, 0.15, { Brightness = 12 })
	for _, chain in ipairs(chains) do
		if chain.beam.Parent then chain.beam:Destroy() end
	end
	tween(bloom, 0.08, { Intensity = 3.5 })
	tween(circleLight, 0.08, { Brightness = 14 })
	sparks.Enabled = false
	lines.Enabled = false

	---- 6.0 IL CERCHIO SI RICHIUDE ----
	if not at(6.0) then return wrapUp() end
	spinBoost = 8
	for index, disc in ipairs(circleParts) do
		tween(disc, 0.6, { Size = Vector3.new(0.1, 0.02, 0.1) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		tween(layers[index], 0.6, { ImageTransparency = 1 })
	end
	tween(crucifixLight, 1, { Brightness = 0 })
	tween(crucifixGlow, 1, { FillTransparency = 1, OutlineTransparency = 1 })
	twinkles.Enabled = false
	tween(bloom, 1.5, { Intensity = 1 })

	---- 6.2 BRACI che scendono piano (e quello che l'entità aggiunge) ----
	if not at(6.2) then return wrapUp() end
	tween(circleLight, 1.5, { Brightness = 0 })
	local area = radius * 2.4
	local embersBase = newPart("Embers", Vector3.new(area * 2, 0.5, area * 2), CFrame.new(center + Vector3.new(0, 11, 0)), WHITE, Enum.Material.SmoothPlastic, 1)
	embersBase.Parent = stage.folder
	local embers = makeEmitter(embersBase, TEXTURES.Spark)
	embers.Rate = 30
	embers.EmissionDirection = Enum.NormalId.Bottom
	embers.Lifetime = NumberRange.new(3, 5)
	embers.Speed = NumberRange.new(0.5, 1.5)
	embers.Acceleration = Vector3.new(0, -1.5, 0)
	embers.SpreadAngle = Vector2.new(40, 40)
	embers.Size = sequence({ { 0, 0.45 }, { 1, 0 } })
	embers.Transparency = sequence({ { 0, 1 }, { 0.1, 0.2 }, { 1, 1 } })
	stage:bind(embers, "Color", "Main", "sequence")
	task.delay(2.5, function()
		embers.Enabled = false
	end)
	if body.After then
		local ok, err = pcall(body.After, stage)
		if not ok then problem("Body.After: %s", tostring(err)) end
	end

	---- 8.7 Il mondo torna normale ----
	if not at(8.7) then return wrapUp() end
	tween(grade, 2, { TintColor = WHITE, Contrast = 0, Saturation = 0 })
	tween(bloom, 2, { Intensity = 0 })
	if not at(10.8) then return wrapUp() end

	result = "Banished"
	log("esorcizzato: %s", model.Name)
	return wrapUp()
end

---====== LO SPAWNER DI VYNIXU ======---
--[[ Lo spawner guarda ogni frame se hai in mano un Tool che si chiama
     "Crucifix" e, se l'entità ha un CrucifixionOverwrite, chiama quello al
     posto del suo rituale. Il campo si scrive direttamente: SetCallback lo
     rifiuta, perché nella config di default vale nil.

     L'overwrite si mette solo mentre hai in mano QUESTO crocifisso, e solo
     dove non ce n'è già uno di qualcun altro. ]]

local armed = setmetatable({}, { __mode = "k" }) -- entità -> la nostra funzione

local function spawnerModule()
	local env = getgenv and getgenv()
	local spawner = env and env.VynixuEntitySpawnerV2
	if type(spawner) == "table" and type(spawner.ActiveEntities) == "table" then
		return spawner
	end
	return nil
end

local function overwriteFor(entity)
	local function overwrite()
		local model = entity.Model
		if not (model and model.Parent) or model:GetAttribute("BeingBanished") then return end

		local tool = Ritual.Held()
		if not Ritual.IsOurs(tool) then
			-- Non è il nostro: il prossimo frame lo spawner fa il suo rituale
			if entity.Debug and entity.Debug.CrucifixionOverwrite == overwrite then
				entity.Debug.CrucifixionOverwrite = nil
			end
			armed[entity] = nil
			return
		end

		-- Subito, così lo spawner non ci richiama al frame dopo
		model:SetAttribute("BeingBanished", true)
		model:SetAttribute("Paused", true)

		local crucifixion = entity.Config and entity.Config.Crucifixion or {}
		task.spawn(function()
			local ok, outcome = pcall(Ritual.Run, {
				Model  = model,
				Tool   = tool,
				Resist = crucifixion.Resist == true,
			})
			if not ok then
				problem("rituale su %s: %s", model.Name, tostring(outcome))
			end

			-- Fallito, o rotto a metà: l'entità non deve restare congelata
			if model.Parent and (not ok or outcome ~= "Banished") then
				model:SetAttribute("BeingBanished", false)
				model:SetAttribute("Paused", false)
			end
		end)
	end
	return overwrite
end

armSpawner = function()
	local spawner = spawnerModule()
	if not spawner then return end
	for _, entity in ipairs(spawner.ActiveEntities) do
		if type(entity) == "table" and type(entity.Debug) == "table" and armed[entity] == nil
			and entity.Debug.CrucifixionOverwrite == nil
			and not (entity.Config and entity.Config.Crucifixion and entity.Config.Crucifixion.Enabled == false)
		then
			local overwrite = overwriteFor(entity)
			entity.Debug.CrucifixionOverwrite = overwrite
			armed[entity] = overwrite
		end
	end
end

local function disarmSpawner()
	for entity, overwrite in pairs(armed) do
		if type(entity.Debug) == "table" and entity.Debug.CrucifixionOverwrite == overwrite then
			entity.Debug.CrucifixionOverwrite = nil
		end
	end
	table.clear(armed)
end

-- Leggero: guarda solo il tool in mano. Arma anche le entità arrivate dopo
RunService.Heartbeat:Connect(function()
	if Ritual.IsOurs(Ritual.Held()) then
		armSpawner()
	elseif next(armed) then
		disarmSpawner()
	end
end)

