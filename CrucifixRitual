-- La pelle del Glitch, invisibile finché non la si mostra. Su tutte e sei le facce, o solo su
-- quelle in faces: ogni Texture è un disegno in più per la scheda video
local function glitchSkin(part, studs, faces)
	local textures = {}
	for _, face in ipairs(faces or Enum.NormalId:GetEnumItems()) do
		local texture = Instance.new("Texture")
		texture.Name = "GlitchSkin"
		texture.Texture = "rbxassetid://" .. TEXTURES.GlitchSkin
		texture.Face = face
		texture.Color3 = Color3.new(0, 0, 0)
		texture.StudsPerTileU = studs
		texture.StudsPerTileV = studs
		texture.Transparency = 1
		texture.Parent = part
		table.insert(textures, texture)
	end
	return textures
end

-- I quadrati fermi che sfarfallano, come quelli del Glitch
local function glitchStatic(part, rate, size)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "GlitchStatic"
	emitter.Texture = "rbxassetid://" .. TEXTURES.GlitchBit
	emitter.Color = GLITCH_STATIC
	emitter.Brightness = 1.17
	emitter.LightEmission = 0
	emitter.Lifetime = NumberRange.new(0.2, 0.3)
	emitter.Speed = NumberRange.new(0, 0)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, size, size / 2),
		NumberSequenceKeypoint.new(1, size, size / 2),
	})
	emitter.Rate = rate
	emitter.Parent = part
	return emitter
end

-- I quadretti saltano: a ogni chiamata qualche texture si sposta di un pezzo di riquadro
local function crawlSkin(textures, count, studs)
	for _ = 1, math.min(count, #textures) do
		local texture = textures[math.random(#textures)]
		texture.OffsetStudsU = math.random(0, 3) * studs / 4
		texture.OffsetStudsV = math.random(0, 3) * studs / 4
	end
end

--[[ I CUBI. Blocchetti del Glitch (viola scuro con la sua pelle, qualcuno al neon rosso o
     ciano) mossi tutti insieme con un solo BulkMoveTo. Modi:
       shell     rivestono una forma: ognuno ha il suo posto, allineato, e ogni tanto uno salta
                 fuori di uno, due o tre passi e torna di colpo. Si muovono solo a scatti, per
                 passi interi: è quello che li fa sembrare pixel e non coriandoli
       ring      una corona: arrivano uno alla volta ai loro posti e poi girano a scatti, come la
                 lancetta di un orologio digitale
       orbit     girano attorno a un punto
       fly       volano via e rallentano; ogni tanto uno si blocca a mezz'aria
       shed      si staccano da un corpo (source() dà un punto) e salgono piano, poi rinascono
       converge  corrono tutti in un punto
     chaos (0..1) dice quanto, negli ultimi quattro modi, scattano di lato o spariscono per un
     attimo: di base poco, perché se tutto trema non si capisce niente. ]]
local Swarm = {}
Swarm.__index = Swarm

-- aligned = tutti della stessa misura e dritti (per shell e ring); neonEvery = uno ogni quanti è al neon
function Ritual.GlitchSwarm(parent, count, size, aligned, neonEvery)
	local self = setmetatable({
		cubes = {}, parts = {}, cframes = {}, mode = "orbit", radius = 1, visible = false,
		nextTick = 0, chaos = 0.3, grid = size, shift = Vector3.zero, shiftUntil = 0,
		ringAngle = 0, nextRingStep = 0,
	}, Swarm)
	for index = 1, count do
		local edge = if aligned then size else size * (0.6 + math.random() * 0.8)
		local neon = index % (neonEvery or 3) == 0
		local cube = newPart("GlitchCube", Vector3.one * edge, CFrame.new(0, 10000, 0),
			if neon then (if index % 2 == 0 then GLITCH_RED else GLITCH_CYAN) else GLITCH_BODY,
			if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic, 1)
		cube.Parent = parent
		table.insert(self.cubes, {
			part     = cube,
			-- Sotto i 3 decimi di stud i quadretti non si vedono: niente pelle, sei Texture in meno
			skin     = if neon or edge < 0.3 then {} else glitchSkin(cube, edge * 1.5),
			neon     = neon,
			angle    = math.random() * math.pi * 2,
			turn     = (1.2 + math.random() * 2.2) * (if math.random() < 0.5 then -1 else 1),
			lift     = math.random() * 2 - 1,
			reach    = 0.6 + math.random() * 0.5,
			position = Vector3.new(0, 10000, 0),
			velocity = Vector3.zero,
			jolt     = Vector3.zero,
			frozenUntil = 0,
			age = 0, life = 0,
			hidden   = false,
			tumble   = CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6),
			pop = 0, popUntil = 0,
		})
		self.parts[index] = cube
	end
	return self
end

local function showCube(cube, shown)
	cube.part.Transparency = if shown then (if cube.neon then 0.15 else 0) else 1
	for _, texture in ipairs(cube.skin) do
		texture.Transparency = if shown then 0 else 1
	end
end

function Swarm:setVisible(visible)
	if self.visible == visible then return end
	self.visible = visible
	for _, cube in ipairs(self.cubes) do
		cube.hidden = false
		showCube(cube, visible)
	end
end

function Swarm:orbit(radius)
	self.mode = "orbit"
	self.radius = radius
end

-- places: una lista di { cframe = posto relativo al centro, normal = verso dove salta fuori }
function Swarm:shell(places)
	self.mode = "shell"
	self.places = places
end

-- La corona: raggio e altezza rispetto al centro; gap = secondi tra l'arrivo di un cubo e il successivo
function Swarm:ring(radius, height, gap)
	self.mode = "ring"
	self.radius = radius
	self.ringHeight = height
	local now = os.clock()
	for index, cube in ipairs(self.cubes) do
		cube.from = cube.position
		cube.arriveAt = now + (index - 1) * (gap or 0.2) + 0.35
	end
end

-- Volano via: da origin, o da dove sono adesso se origin è nil
function Swarm:burst(origin, speed)
	self.mode = "fly"
	for _, cube in ipairs(self.cubes) do
		cube.position = if origin then origin + randomUnit() * 0.3 else cube.position
		cube.velocity = randomUnit() * speed * (0.4 + math.random() * 0.6) + Vector3.new(0, speed * 0.3, 0)
	end
	self:setVisible(true)
end

function Swarm:shed(source)
	self.mode = "shed"
	self.source = source
	for _, cube in ipairs(self.cubes) do
		cube.age, cube.life = 0, math.random() * 1.2
	end
end

-- Tutti i pixel saltano fuori insieme di steps passi, e tornano al loro posto dopo duration
function Swarm:pulse(steps, duration)
	local untilAt = os.clock() + duration
	for _, cube in ipairs(self.cubes) do
		cube.pop = steps
		cube.popUntil = untilAt
	end
end

function Swarm:converge(target, duration)
	self.mode = "converge"
	self.target = target
	self.convergeAt = os.clock()
	self.convergeTime = duration
	for _, cube in ipairs(self.cubes) do
		cube.from = cube.position
	end
end

-- center: il CFrame a cui si riferiscono shell, ring e orbit (per gli altri modi non serve)
function Swarm:step(deltaTime, center)
	if not self.visible then return end
	local now = os.clock()
	local tick = now >= self.nextTick
	if tick then self.nextTick = now + 0.08 end
	local pixel = self.mode == "shell" or self.mode == "ring"

	-- Tutta la forma salta di un passo di lato, per un attimo, ogni tanto
	if pixel and center then
		if now >= self.shiftUntil then
			self.shift = Vector3.zero
			if tick and math.random() < 0.015 then
				local side = if math.random() < 0.5 then center.RightVector else center.UpVector
				self.shift = side * self.grid * (if math.random() < 0.5 then -1 else 1)
				self.shiftUntil = now + 0.06 + math.random() * 0.05
			end
		end
	end
	if self.mode == "ring" and now >= self.nextRingStep then
		self.nextRingStep = now + 0.15
		self.ringAngle += math.pi / #self.cubes
	end

	for index, cube in ipairs(self.cubes) do
		if tick then
			if pixel then
				-- Un pixel salta fuori di qualche passo e resta lì un attimo; poi torna di colpo
				if now >= cube.popUntil then
					cube.pop = 0
					if math.random() < (if self.mode == "shell" then 0.06 else 0.03) then
						cube.pop = math.random(1, 3)
						cube.popUntil = now + 0.12 + math.random() * 0.3
					end
				end
				local hide = math.random() < 0.02
				if hide ~= cube.hidden then
					cube.hidden = hide
					showCube(cube, not hide)
				end
			else
				local roll = math.random()
				if roll < 0.1 * self.chaos then
					cube.jolt = randomUnit() * self.radius * 0.45
				elseif roll < 0.45 then
					cube.jolt = Vector3.zero
				end
				local hide = math.random() < 0.07 * self.chaos
				if hide ~= cube.hidden then
					cube.hidden = hide
					showCube(cube, not hide)
				end
				if math.random() < 0.03 * self.chaos then
					cube.frozenUntil = now + 0.15 + math.random() * 0.45
				end
			end
		end

		local moving = now >= cube.frozenUntil
		if self.mode == "shell" and center then
			local place = self.places and self.places[index]
			if place then
				local cframe = center * place.cframe
				cframe += center:VectorToWorldSpace(place.normal) * cube.pop * self.grid + self.shift
				cube.position = cframe.Position
				self.cframes[index] = cframe
			else
				self.cframes[index] = CFrame.new(0, 10000, 0)
			end
		elseif self.mode == "ring" and center then
			local angle = self.ringAngle + (index - 1) / #self.cubes * math.pi * 2
			local middle = center.Position + Vector3.new(0, self.ringHeight, 0)
			local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
			local slot = middle + out * (self.radius + cube.pop * self.grid)
			-- Chi non è ancora arrivato vola al suo posto; chi era lontanissimo scende dall'alto
			local from = cube.from or slot
			if (from - slot).Magnitude > 200 then
				from = slot + Vector3.new(0, 4, 0)
				cube.from = from
			end
			local arrive = math.clamp((now - (cube.arriveAt or 0) + 0.35) / 0.35, 0, 1)
			local position = from:Lerp(slot, arrive * arrive * (3 - 2 * arrive)) + self.shift
			cube.position = position
			self.cframes[index] = CFrame.lookAt(position, middle)
		elseif self.mode == "orbit" and center then
			if moving then cube.angle += cube.turn * deltaTime end
			local reach = self.radius * cube.reach
			cube.position = center.Position + Vector3.new(math.cos(cube.angle) * reach, cube.lift * self.radius * 0.6, math.sin(cube.angle) * reach)
		elseif self.mode == "fly" then
			if moving then
				cube.velocity *= math.exp(-2.5 * deltaTime)
				cube.position += cube.velocity * deltaTime
			end
		elseif self.mode == "shed" then
			cube.age += deltaTime
			if cube.age >= cube.life then
				local point = self.source and self.source()
				if point then
					cube.position = point
					cube.velocity = (randomUnit() + Vector3.new(0, 1.3, 0)).Unit * (1 + math.random() * 2.5)
					cube.age, cube.life = 0, 0.8 + math.random() * 1.4
				else
					-- Nessun posto da cui staccarsi: aspetta lontano, invece di volare via per sempre
					cube.position = Vector3.new(0, 10000, 0)
					cube.velocity = Vector3.zero
				end
			end
			if moving then cube.position += cube.velocity * deltaTime end
		elseif self.mode == "converge" then
			local t = math.clamp((now - self.convergeAt) / self.convergeTime, 0, 1)
			cube.position = (cube.from or cube.position):Lerp(self.target, t * t)
		end

		if not (pixel and center) then
			self.cframes[index] = CFrame.new(cube.position + cube.jolt) * cube.tumble * CFrame.Angles(now * cube.turn, now * cube.turn * 0.7, 0)
		end
	end
	workspace:BulkMoveTo(self.parts, self.cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

--[[ I posti dei pixel su un crocifisso, qualunque modello sia. Si guarda il box di tutte le sue
     parti visto dalla parte di riferimento (il manico): il lato più lungo è il palo, il secondo
     la traversa. L'alto è la parte lontana dalla mano (gripPosition, nello spazio del manico).
     Dentro quella forma a croce si mette una griglia, e si tengono solo i punti della metà alta:
     il Glitch lo sta mangiando dall'alto. Rende la lista per Swarm:shell, la misura di un pixel
     e la forma (centro, assi e misure, nello spazio del manico). ]]
function Ritual.CrossPixels(parts, reference, gripPosition, maxCount)
	local low, high = Vector3.one * math.huge, -Vector3.one * math.huge
	for _, part in ipairs(parts) do
		local relative = reference.CFrame:ToObjectSpace(part.CFrame)
		local half = part.Size / 2
		for _, x in ipairs({ -1, 1 }) do
			for _, y in ipairs({ -1, 1 }) do
				for _, z in ipairs({ -1, 1 }) do
					local corner = relative:PointToWorldSpace(half * Vector3.new(x, y, z))
					low = low:Min(corner)
					high = high:Max(corner)
				end
			end
		end
	end
	local size = high - low
	local middle = (high + low) / 2

	-- Gli assi del box, dal più lungo al più corto
	local axes = { { axis = Vector3.xAxis, length = size.X }, { axis = Vector3.yAxis, length = size.Y }, { axis = Vector3.zAxis, length = size.Z } }
	table.sort(axes, function(a, b) return a.length > b.length end)
	local up, across, depth = axes[1].axis, axes[2].axis, axes[3].axis
	local length, width, thickness = axes[1].length, axes[2].length, axes[3].length
	-- L'alto è dalla parte opposta alla mano
	if (gripPosition - middle):Dot(up) > 0 then
		up = -up
	end

	local grid = math.clamp(width * 0.16, 0.08, 0.3)
	local beam = math.max(width * 0.3, grid * 2)       -- quanto è largo il palo
	local barHeight = math.max(length * 0.2, grid * 2) -- quanto è alta la traversa
	local barAt = 0.2                                  -- la traversa, dal centro verso l'alto
	local places = {}
	local function add(u, a, d, normal)
		table.insert(places, {
			cframe = CFrame.new(middle + up * u + across * a + depth * d),
			normal = normal,
		})
	end
	local half = thickness / 2 + grid * 0.3
	for u = -length / 2, length / 2, grid do
		local onBar = math.abs(u - length * barAt) <= barHeight / 2
		local reach = if onBar then width / 2 else beam / 2
		-- Solo la metà alta, e un po' più rada verso il centro
		if u > -length * 0.05 then
			for a = -reach, reach, grid do
				if math.random() < 0.55 + 0.45 * (u / (length / 2)) then
					local side = if math.abs(a) > reach - grid then across * math.sign(a) else up
					add(u, a, half, depth + side * 0.3)
					add(u, a, -half, -depth + side * 0.3)
				end
			end
		end
	end

	-- Troppi: se ne tengono maxCount a caso
	while #places > (maxCount or 40) do
		table.remove(places, math.random(#places))
	end
	return places, grid, {
		middle = middle, up = up, across = across, depth = depth,
		length = length, width = width, thickness = thickness,
	}
end

function Swarm:destroy()
	for _, part in ipairs(self.parts) do
		part:Destroy()
	end
	table.clear(self.cubes)
	table.clear(self.parts)
end

--[[ Il Glitch vero di DOORS, preso da ReplicatedStorage: solo il corpo (senza la radice alta 21
     stud, luci, suoni e animazioni), ancorato e scalato all'altezza voluta. Resta sempre nella
     scena e per nasconderlo lo si porta in alto, lontano: è più leggero che toglierlo e rimetterlo.
     nil se in questa partita non c'è. ]]
local function glitchPhantom(parent, height)
	local entities = ReplicatedStorage:FindFirstChild("Entities")
	local source = entities and entities:FindFirstChild("Glitch")
	if not (source and source:IsA("Model")) then return nil end

	local ok, phantom = pcall(function()
		source.Archivable = true
		for _, descendant in ipairs(source:GetDescendants()) do
			descendant.Archivable = true
		end
		return source:Clone()
	end)
	if not ok or not phantom then return nil end

	for _, descendant in ipairs(phantom:GetDescendants()) do
		if descendant.Name == "Root" or descendant:IsA("Light") or descendant:IsA("Sound")
			or descendant:IsA("AnimationController") or descendant:IsA("Folder") or descendant:IsA("LuaSourceContainer")
		then
			descendant:Destroy()
		end
	end
	local parts = {}
	for _, part in ipairs(phantom:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			part.CastShadow = false
			table.insert(parts, part)
		end
	end
	if #parts == 0 then
		phantom:Destroy()
		return nil
	end
	phantom.PrimaryPart = phantom:FindFirstChild("Torso") or parts[1]

	local _, size = phantom:GetBoundingBox()
	pcall(function()
		phantom:ScaleTo(math.max(height / math.max(size.Y, 1), 0.1))
	end)
	local boxCFrame, box = phantom:GetBoundingBox()
	local footOffset = phantom:GetPivot().Position.Y - (boxCFrame.Position.Y - box.Y / 2)

	phantom:PivotTo(CFrame.new(0, 10000, 0))
	phantom.Parent = parent
	return {
		model = phantom,
		-- Lo mette in piedi su floor, girato verso facing (una direzione piatta)
		show = function(floor, facing)
			phantom:PivotTo(CFrame.lookAt(floor + Vector3.new(0, footOffset, 0), floor + Vector3.new(0, footOffset, 0) + facing))
		end,
		hide = function()
			phantom:PivotTo(CFrame.new(0, 10000, 0))
		end,
	}
end

