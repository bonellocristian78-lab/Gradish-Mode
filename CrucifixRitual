local moduleEventsCache
local function moduleEvents()
	if moduleEventsCache == nil then
		local ok, result = pcall(function()
			return require(ReplicatedStorage:WaitForChild("ModulesClient", 5):WaitForChild("Module_Events", 5))
		end)
		moduleEventsCache = if ok then result else false
	end
	return moduleEventsCache or nil
end

local function playerRoom()
	local rooms = workspace:FindFirstChild("CurrentRooms")
	local number = LocalPlayer:GetAttribute("CurrentRoom")
	return rooms and number and rooms:FindFirstChild(tostring(number)) or nil
end

local function flickerRoom(room, duration)
	local events = moduleEvents()
	if room and events and events.flicker then
		pcall(events.flicker, room, duration)
	end
end

local function shatterRoom(room)
	local events = moduleEvents()
	if room and events and events.shatter then
		pcall(events.shatter, room)
	end
end

local function makeEmitter(parent, textureId, colour)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxassetid://" .. textureId
	emitter.Color = ColorSequence.new(colour or WHITE)
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Rate = 0
	emitter.Parent = parent
	return emitter
end

--[[ Un disco piatto con un'immagine di DOORS che brilla da sola.

     La tela è FISSA (canvas pixels, non pixel per stud). Prima era 32 pixel
     per stud, e un'onda larga 96 stud diventava una tela di 3072x3072 da
     ridisegnare ogni frame. Un anello di luce sfocato non ha bisogno di più
     di 256 pixel, e non si vede la differenza. ]]
local function glowDisc(parent, name, position, diameter, textureId, colour, canvas)
	local disc = newPart(name, Vector3.new(diameter, 0.02, diameter), CFrame.new(position), colour, Enum.Material.SmoothPlastic, 1)
	disc.Parent = parent

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Top
	gui.LightInfluence = 0
	gui.Brightness = 4
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(canvas or 256, canvas or 256)
	gui.Parent = disc

	local image = Instance.new("ImageLabel")
	image.BackgroundTransparency = 1
	image.Size = UDim2.fromScale(1, 1)
	image.Image = "rbxassetid://" .. textureId
	image.ImageColor3 = colour
	image.ImageTransparency = 1
	image.Parent = gui

	return disc, image
end

local function characters()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	return list
end

-- Il pavimento sotto un punto, ignorando l'entità e i giocatori
local function floorBelow(point, model)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.RespectCanCollide = true
	local ignore = characters()
	table.insert(ignore, model)
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(point + Vector3.new(0, 1, 0), Vector3.new(0, -120, 0), params)
	return hit and hit.Position.Y or nil
end

-- Scarica prima texture e suoni del rituale, così quando serve appare tutto subito
function Ritual.Preload()
	local ids = {}
	for key, value in pairs(TEXTURES) do
		if key == "Circle" then
			for _, id in ipairs(value) do
				table.insert(ids, "rbxassetid://" .. id)
			end
		else
			table.insert(ids, "rbxassetid://" .. value)
		end
	end
	for _, id in pairs(SOUND_IDS) do
		table.insert(ids, "rbxassetid://" .. id)
	end
	pcall(function()
		game:GetService("ContentProvider"):PreloadAsync(ids)
	end)
end

