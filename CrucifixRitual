local function isCrucifix(tool)
	if not (tool and tool:IsA("Tool")) then return false end
	if tool.Name == "Crucifix" then return true end
	local ok, tagged = pcall(function() return tool:HasTag("Crucifix") end)
	return ok and tagged == true
end

-- Il crocifisso che hai IN MANO (quello nello zaino non conta, come per lo spawner)
function Ritual.Held()
	local character = LocalPlayer.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	if isCrucifix(tool) then return tool end
	return nil
end

function Ritual.IsOurs(tool)
	return tool ~= nil and tool:GetAttribute("GradishCrucifix") == true
end

--[[ Che rituale fa questo crocifisso su questa entità: il colore di partenza e
     se fallisce. Un crocifisso senza tipo (quello di Penguin, quello vero di
     DOORS) è un Guiding. ]]
function Ritual.Outcome(tool, resist)
	local kind = tool and tool:GetAttribute("CrucifixType")
	if kind == "Fail" then
		return "Guiding", true, false
	end
	-- Il Glitch si presenta come un Guiding, ma fallisce sempre
	if kind == "Glitch" then
		return "Guiding", true, true
	end
	if kind ~= "Curious" then
		kind = "Guiding"
	end
	return kind, resist == true, false
end

local template = nil
local fetching = false

local function toolsNow()
	local seen = {}
	for _, container in ipairs({ LocalPlayer:FindFirstChildOfClass("Backpack"), LocalPlayer.Character }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") then seen[child] = true end
			end
		end
	end
	return seen
end

local function newToolSince(seen)
	for tool in pairs(toolsNow()) do
		if not seen[tool] then return tool end
	end
	return nil
end

-- Due assi di legno: quando il loader di Penguin non risponde non resti a mani vuote
local function buildPlanks()
	local tool = Instance.new("Tool")
	tool.RequiresHandle = true

	local handle = newPart("Handle", Vector3.new(0.22, 1.7, 0.22), CFrame.identity, WOOD, Enum.Material.Wood, 0)
	handle.Anchored = false
	handle.Massless = true
	handle.Parent = tool

	local bar = newPart("Crossbar", Vector3.new(0.95, 0.22, 0.22), CFrame.new(0, 0.42, 0), WOOD, Enum.Material.Wood, 0)
	bar.Anchored = false
	bar.Massless = true
	bar.Parent = tool

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = bar
	weld.Parent = handle

	tool.Grip = CFrame.new(0, -0.45, 0) * CFrame.Angles(math.rad(-90), 0, 0)
	return tool
end

--[[ Il modello è quello di Penguin, il comportamento no.

     Il loader è offuscato e il suo tool ha una logica sua che non si può
     leggere. Quindi si esegue una volta sola, si copia quello che si vede
     (le parti, le saldature, la presa), si tolgono gli script e si distrugge
     l'originale: le sue connessioni muoiono con lui. La copia pulita resta
     come stampo per tutti i crocifissi successivi. ]]
local function penguinTemplate()
	while fetching do task.wait(0.1) end
	if template then return template end
	fetching = true

	local seen = toolsNow()
	_G.Uses = 1
	_G.Range = 30
	-- Se un altro script l'ha lasciato a true, il suo crocifisso vale su tutto
	_G.OnAnything = nil

	local ok, err = pcall(function()
		loadstring(game:HttpGet(PENGUIN_URL))()
	end)

	local original
	if ok then
		local deadline = os.clock() + 12
		repeat
			original = newToolSince(seen)
			if not original then task.wait(0.15) end
		until original or os.clock() > deadline
	else
		problem("il loader di Penguin non si è caricato: %s", tostring(err))
	end

	if original then
		for _, descendant in ipairs(original:GetDescendants()) do
			pcall(function() descendant.Archivable = true end)
		end
		original.Archivable = true

		local copy = original:Clone()
		pcall(function() original:Destroy() end)

		if copy then
			for _, descendant in ipairs(copy:GetDescendants()) do
				if descendant:IsA("LuaSourceContainer") then
					descendant:Destroy()
				end
			end
			template = copy
			log("stampo preso dal crocifisso di Penguin")
		end
	end

	if not template then
		problem("uso il crocifisso di riserva (due assi): il modello di Penguin non è arrivato")
		template = buildPlanks()
	end

	fetching = false
	return template
end

local armSpawner -- definita più giù, con lo spawner

--[[ IL CROCIFISSO GLITCH in mano. È il crocifisso di Penguin, e il Glitch di DOORS se lo sta
     mangiando dall'alto: la metà di sopra (la cima e la traversa) è coperta di pixel del Glitch,
     cubetti viola scuro con la sua pelle a quadretti, allineati al crocifisso come i pixel di
     un'immagine. Ogni tanto un pixel salta fuori di qualche passo e torna di colpo. Una riga di
     luce ciano lo scansiona dal basso in alto.

     Tutto il resto è tranquillo e arriva a colpi, ogni uno o due secondi e mezzo: un colpo è un
     decimo di secondo in cui la presa scatta, i colori si separano (un fantasma rosso e uno
     ciano), il contorno cambia colore e la luce sale. Poi di nuovo calmo. Se tremasse sempre non
     si capirebbe cosa hai in mano.

     Si anima solo mentre lo tieni in mano; nello zaino è fermo e non costa niente. ]]
local function animateGlitchTool(tool)
	local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart", true)
	if not (handle and handle:IsA("BasePart")) then return end
	local grip = tool.Grip

	-- La pelle del Glitch appena velata su tutto: si capisce che è infetto, ma resta un crocifisso
	local skins, visible = {}, {}
	for _, part in ipairs(tool:GetDescendants()) do
		if part:IsA("BasePart") and part.Transparency < 1 then
			table.insert(visible, part)
			for _, texture in ipairs(glitchSkin(part, 0.4)) do
				texture.Transparency = 0.55
				table.insert(skins, texture)
			end
		end
	end
	glitchStatic(handle, 4, 0.25)

	local aura = Instance.new("Highlight")
	aura.Name = "GlitchAura"
	aura.DepthMode = Enum.HighlightDepthMode.Occluded
	aura.FillTransparency = 1
	aura.OutlineColor = PALETTES.Glitch.Main
	aura.OutlineTransparency = 0.5
	aura.Enabled = false
	aura.Parent = tool

	local light = Instance.new("PointLight")
	light.Name = "GlitchGlow"
	light.Color = PALETTES.Glitch.Main
	light.Brightness = 1.2
	light.Range = 9
	light.Shadows = false
	light.Parent = handle

	-- Fantasmi, pixel e scansione: solo sul tuo schermo, dentro la camera, creati la prima volta
	-- che lo impugni (prima le parti non sono ancora al loro posto)
	local ghosts = {}
	local swarm, scan, shape = nil, nil, nil
	local function buildGhosts()
		for index, colour in ipairs({ GLITCH_RED, GLITCH_CYAN }) do
			local folder = Instance.new("Folder")
			folder.Name = "GlitchCrucifixGhost"
			local parts = {}
			for _, descendant in ipairs(tool:GetDescendants()) do
				if descendant:IsA("BasePart") and descendant.Transparency < 1 then
					descendant.Archivable = true
					local copy = descendant:Clone()
					if copy then
						copy:ClearAllChildren()
						copy.Anchored = true
						copy.CanCollide = false
						copy.CanTouch = false
						copy.CanQuery = false
						copy.CastShadow = false
						copy.Massless = true
						copy.Material = Enum.Material.Neon
						copy.Color = colour
						copy.Transparency = 1
						if copy:IsA("MeshPart") then copy.TextureID = "" end
						copy.Parent = folder
						table.insert(parts, { source = descendant, copy = copy })
					end
				end
			end
			folder.Parent = workspace.CurrentCamera
			ghosts[index] = { folder = folder, parts = parts, side = if index == 1 then -1 else 1 }
		end
		local places, grid
		places, grid, shape = Ritual.CrossPixels(visible, handle, grip.Position, 40)
		swarm = Ritual.GlitchSwarm(workspace.CurrentCamera, #places, grid * 0.95, true, 5)
		swarm:shell(places)
		scan = newPart("GlitchScan", Vector3.new(shape.width * 1.15, grid * 0.35, shape.thickness * 1.6), CFrame.identity,
			GLITCH_CYAN, Enum.Material.Neon, 1)
		scan.Parent = workspace.CurrentCamera

		-- Dalla cima mangiata sale piano una polvere di pixel, come se si stesse sfaldando. È sul
		-- manico, quindi resta anche sul crocifisso che fluttua nel rituale
		local top = Instance.new("Attachment")
		top.Name = "GlitchTop"
		top.Position = shape.middle + shape.up * (shape.length / 2)
		top.Parent = handle
		local dust = makeEmitter(top, TEXTURES.GlitchBit)
		dust.Name = "GlitchDust"
		dust.Color = ColorSequence.new(PALETTES.Glitch.Main, GLITCH_CYAN)
		dust.Rate = 6
		dust.Lifetime = NumberRange.new(0.8, 1.4)
		dust.Speed = NumberRange.new(0.2, 0.5)
		dust.SpreadAngle = Vector2.new(180, 180)
		dust.Acceleration = Vector3.new(0, 1.2, 0)
		dust.Size = sequence({ { 0, grid * 0.8 }, { 1, 0 } })
		dust.Transparency = sequence({ { 0, 0.2 }, { 1, 1 } })
	end

	local function hideGhosts()
		for _, ghost in ipairs(ghosts) do
			for _, entry in ipairs(ghost.parts) do
				entry.copy.Transparency = 1
			end
		end
	end

	local connection
	local nextBeat, beatUntil, nextCrawl = 0, 0, 0
	local function stop()
		if connection then
			connection:Disconnect()
			connection = nil
		end
		tool.Grip = grip
		aura.Enabled = false
		hideGhosts()
		if swarm then swarm:setVisible(false) end
		if scan then scan.Transparency = 1 end
	end

	tool.Equipped:Connect(function()
		if #ghosts == 0 then buildGhosts() end
		aura.Enabled = true
		swarm:setVisible(true)
		nextBeat = os.clock() + 0.6
		playSound(SOUND_IDS.Glitch, 0.35, 1.2 + math.random() * 0.2, handle)
		if connection then return end
		connection = RunService.RenderStepped:Connect(function(deltaTime)
			if not handle.Parent then return end
			local now = os.clock()
			swarm:step(deltaTime, handle.CFrame)

			-- La scansione: mezzo secondo dal basso in alto, poi niente fino alla prossima
			local sweep = (now % 1.8) / 0.5
			if sweep <= 1 then
				local along = (sweep - 0.5) * shape.length
				scan.CFrame = handle.CFrame * CFrame.fromMatrix(shape.middle + shape.up * along, shape.across, shape.up)
				scan.Transparency = 0.3 + 0.6 * math.abs(sweep - 0.5) * 2
			elseif scan.Transparency < 1 then
				scan.Transparency = 1
			end

			-- Luce viva ma calma: segue un rumore lento (durante un colpo resta alta)
			if beatUntil == 0 then
				light.Brightness = 1.1 + 0.4 * math.noise(now * 1.5, 0.3)
			end

			if now >= nextCrawl then
				nextCrawl = now + 0.25
				crawlSkin(skins, 2, 0.4)
			end

			-- IL COLPO: un decimo di secondo di glitch, poi di nuovo calmo
			if now >= nextBeat then
				nextBeat = now + 1 + math.random() * 1.6
				beatUntil = now + 0.07 + math.random() * 0.05
				tool.Grip = grip * CFrame.new((math.random() - 0.5) * 0.3, (math.random() - 0.5) * 0.2, 0)
					* CFrame.Angles(0, (math.random() - 0.5) * 0.5, (math.random() - 0.5) * 0.3)
				aura.OutlineColor = if math.random() < 0.5 then GLITCH_CYAN else GLITCH_RED
				aura.OutlineTransparency = 0.1
				light.Brightness = 3
				crawlSkin(skins, 8, 0.4)
				local split = 0.12 + math.random() * 0.2
				local right = workspace.CurrentCamera.CFrame.RightVector
				for _, ghost in ipairs(ghosts) do
					local offset = right * ghost.side * split
					for _, entry in ipairs(ghost.parts) do
						if entry.source.Parent then
							entry.copy.CFrame = entry.source.CFrame + offset
							entry.copy.Transparency = 0.5
						end
					end
				end
			elseif beatUntil > 0 and now >= beatUntil then
				beatUntil = 0
				tool.Grip = grip
				aura.OutlineColor = PALETTES.Glitch.Main
				aura.OutlineTransparency = 0.5
				hideGhosts()
			end
		end)
	end)
	tool.Unequipped:Connect(stop)

	tool.Destroying:Connect(function()
		stop()
		for _, ghost in ipairs(ghosts) do
			ghost.folder:Destroy()
		end
		table.clear(ghosts)
		if swarm then swarm:destroy() end
		if scan then scan:Destroy() end
	end)
end

--[[ Il crocifisso. Si chiama "Crucifix" e ha il tag, perché è quello che
     guardano lo spawner, Honcho e GradishCore; il tipo è un attributo, mai un
     nome diverso. Si consuma al primo utilizzo: il rituale lo distrugge. ]]
function Ritual.Give(kind, equip)
	if not TOOLTIPS[kind] then kind = "Guiding" end

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		problem("niente crocifisso: non sei vivo")
		return nil
	end

	local tool = penguinTemplate():Clone()
	tool.Name = "Crucifix"
	tool.CanBeDropped = false
	tool.ToolTip = TOOLTIPS[kind]
	tool:SetAttribute("GradishCrucifix", true)
	tool:SetAttribute("CrucifixType", kind)
	pcall(function() CollectionService:AddTag(tool, "Crucifix") end)

	-- Il giallo si vede già in mano: una luce piccola, niente di più
	if kind == "Curious" then
		local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart", true)
		if handle then
			local glow = Instance.new("PointLight")
			glow.Name = "CuriousGlow"
			glow.Color = PALETTES.Curious.Main
			glow.Brightness = 1
			glow.Range = 8
			glow.Parent = handle
		end
	end

	if kind == "Glitch" then
		animateGlitchTool(tool)
	end

	tool.Equipped:Connect(function()
		armSpawner()
	end)

	tool.Parent = LocalPlayer:FindFirstChildOfClass("Backpack") or character

	if equip then
		pcall(function() humanoid:EquipTool(tool) end)
	end

	log("crocifisso %s dato", kind)
	return tool
end

-- Il tool esce dalla mano e diventa un modello che fluttua. Il tool si consuma
local function floatingCrucifix(tool, folder)
	local handle = tool and tool:FindFirstChild("Handle")
	local startCFrame = if handle and handle:IsA("BasePart")
		then handle.CFrame
		else workspace.CurrentCamera.CFrame * CFrame.new(0.8, -0.8, -2)

	local crucifix = Instance.new("Model")
	crucifix.Name = "RitualCrucifix"

	if tool then
		tool.Archivable = true
		for _, descendant in ipairs(tool:GetDescendants()) do
			pcall(function() descendant.Archivable = true end)
		end
		local copy = tool:Clone()
		tool:Destroy()
		if copy then
			for _, child in ipairs(copy:GetChildren()) do
				child.Parent = crucifix
			end
			copy:Destroy()
		end
	end

	for _, descendant in ipairs(crucifix:GetDescendants()) do
		if descendant:IsA("LuaSourceContainer") or descendant:IsA("TouchTransmitter") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end

	local primary = crucifix:FindFirstChild("Handle") or crucifix:FindFirstChildWhichIsA("BasePart", true)
	if not (primary and primary:IsA("BasePart")) then
		crucifix:ClearAllChildren()
		primary = newPart("Handle", Vector3.new(0.22, 1.7, 0.22), startCFrame, WOOD, Enum.Material.Wood, 0)
		primary.Parent = crucifix
		newPart("Crossbar", Vector3.new(0.95, 0.22, 0.22), startCFrame * CFrame.new(0, 0.42, 0), WOOD, Enum.Material.Wood, 0).Parent = crucifix
	end

	crucifix.PrimaryPart = primary
	crucifix:PivotTo(startCFrame)
	crucifix.Parent = folder
	return crucifix, startCFrame
end

---====== IL PALCO ======---
--[[ Tutto quello che il rituale crea vive qui: una cartella, un ciclo per
     frame, i colori legati alla tavolozza (così il passaggio al rosso del fail
     li cambia tutti insieme), gli emitter e gli anelli riusati, il FOV. ]]

local Stage = {}
Stage.__index = Stage

local function roleColour(palette, role)
	return palette[role] or palette.Main
end

local function applyBinding(entry, palette)
	local colour = roleColour(palette, entry.role)
	if entry.form == "sequence" then
		entry.instance[entry.property] = ColorSequence.new(colour)
	elseif entry.form == "whiteSequence" then
		entry.instance[entry.property] = ColorSequence.new(WHITE, colour)
	else
		entry.instance[entry.property] = colour
	end
end

function Stage.new(center, paletteName)
	local self = setmetatable({}, Stage)
	self.center = center
	self.palette = PALETTES[paletteName]
	self.fade = nil
	self.bound = {}
	self.bursts = setmetatable({}, { __mode = "k" })
	self.freeRings = {}
	self.kicks = {}
	self.cleanup = {}
	self.done = false

	self.folder = Instance.new("Folder")
	self.folder.Name = "CrucifixRitual"
	self.folder.Parent = workspace
	return self
end

function Stage:bind(instance, property, role, form)
	local entry = { instance = instance, property = property, role = role or "Main", form = form }
	table.insert(self.bound, entry)
	pcall(applyBinding, entry, self.palette)
	return instance
end

function Stage:setPalette(name, duration)
	local target = PALETTES[name]
	if not target or target == self.palette then return end
	self.fade = { from = self.palette, to = target, start = os.clock(), duration = duration or 0.5 }
	self.palette = target
end

-- Chiamata dal ciclo per frame: lavora solo durante un cambio di colore
function Stage:stepFade()
	local fade = self.fade
	if not fade then return end

	local alpha = math.clamp((os.clock() - fade.start) / fade.duration, 0, 1)
	local mixed = {}
	for key, colour in pairs(fade.from) do
		mixed[key] = colour:Lerp(fade.to[key], alpha)
	end
	for _, entry in ipairs(self.bound) do
		pcall(applyBinding, entry, mixed)
	end
	if alpha >= 1 then
		self.fade = nil
	end
end

-- Scintille rotonde: un emitter per parte, riusato a ogni scoppio
function Stage:burst(parent, count, speed)
	if not parent or not parent.Parent then return end
	local emitter = self.bursts[parent]
	if not emitter or not emitter.Parent then
		emitter = makeEmitter(parent, TEXTURES.Ball)
		emitter.Brightness = 3
		emitter.Lifetime = NumberRange.new(0.4, 1.8)
		emitter.Drag = 3
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = sequence({ { 0, 0.7 }, { 0.12, 0.35 }, { 0.4, 0.1 }, { 1, 0 } })
		emitter.Transparency = sequence({ { 0, 0 }, { 0.9, 0 }, { 1, 1 } })
		self:bind(emitter, "Color", "Main", "sequence")
		self.bursts[parent] = emitter
	end
	emitter.Speed = NumberRange.new(speed * 0.3, speed)
	emitter:Emit(count)
end

-- Un anello che si allarga sul pavimento e sparisce. Pochi, riusati
function Stage:ring(fromDiameter, toDiameter, duration, white)
	local ring = table.remove(self.freeRings)
	if not ring then
		local disc, image = glowDisc(self.folder, "RingWave", self.center + Vector3.new(0, 0.2, 0), fromDiameter, TEXTURES.Circle[1], WHITE, 256)
		ring = { disc = disc, image = image }
	end

	ring.disc.Size = Vector3.new(fromDiameter, 0.02, fromDiameter)
	ring.image.ImageColor3 = if white then WHITE else self.palette.Main
	ring.image.ImageTransparency = 0
	tween(ring.disc, duration, { Size = Vector3.new(toDiameter, 0.02, toDiameter) }, Enum.EasingStyle.Quart)
	tween(ring.image, duration, { ImageTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

	task.delay(duration + 0.05, function()
		if not self.done then
			table.insert(self.freeRings, ring)
		end
	end)
end

-- Una sfera di energia che si gonfia e svanisce
function Stage:sphere(position, toSize, duration, white)
	local ball = newPart("SphereWave", Vector3.one, CFrame.new(position), if white then WHITE else self.palette.Main, Enum.Material.ForceField, 0)
	ball.Shape = Enum.PartType.Ball
	ball.Parent = self.folder
	tween(ball, duration, { Size = Vector3.one * toSize, Transparency = 1 }, Enum.EasingStyle.Quart)
	task.delay(duration + 0.05, function()
		ball:Destroy()
	end)
end

-- Un lampo su tutto lo schermo. Una sola ScreenGui per rituale, riusata
function Stage:flash(colour, startTransparency, duration)
	if not self.flashFrame then
		local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if not playerGui then return end

		local gui = Instance.new("ScreenGui")
		gui.Name = "CrucifixFlash"
		gui.IgnoreGuiInset = true
		gui.ResetOnSpawn = false
		gui.DisplayOrder = 1000

		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BorderSizePixel = 0
		frame.BackgroundTransparency = 1
		frame.Parent = gui
		gui.Parent = playerGui

		self.flashGui = gui
		self.flashFrame = frame
	end

	self.flashFrame.BackgroundColor3 = colour
	self.flashFrame.BackgroundTransparency = startTransparency
	tween(self.flashFrame, duration, { BackgroundTransparency = 1 })
end

-- Un calcio al FOV. Si sommano tutti sopra lo stesso valore di base
function Stage:fovPunch(amount, duration)
	table.insert(self.kicks, { amount = amount, start = os.clock(), duration = duration })
end

function Stage:stepFov()
	local camera = workspace.CurrentCamera
	if not camera then return end

	local now = os.clock()
	local offset = 0
	for index = #self.kicks, 1, -1 do
		local kick = self.kicks[index]
		local progress = (now - kick.start) / kick.duration
		if progress >= 1 then
			table.remove(self.kicks, index)
		else
			offset += kick.amount * (1 - progress) ^ 3
		end
	end

	-- Se DOORS ha scritto il suo FOV da quando l'abbiamo toccato noi, quello
	-- è la nuova base. Se no, la base resta quella di prima
	local current = camera.FieldOfView
	if self.fovWritten == nil or math.abs(current - self.fovWritten) > 1e-3 then
		self.fovBase = current
	end

	if offset > 0 then
		local target = math.clamp(self.fovBase + offset, 1, 120)
		camera.FieldOfView = target
		self.fovWritten = target
	elseif self.fovWritten then
		camera.FieldOfView = self.fovBase
		self.fovWritten = nil
	end
end

-- Colore, contrasto e bloom solo sul tuo schermo, finché dura il rituale
function Stage:postEffects()
	local camera = workspace.CurrentCamera
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "CrucifixGrade"
	grade.Parent = camera

	local bloom = Instance.new("BloomEffect")
	bloom.Name = "CrucifixBloom"
	bloom.Intensity = 0
	bloom.Size = 30
	bloom.Threshold = 2
	bloom.Parent = camera

	table.insert(self.cleanup, grade)
	table.insert(self.cleanup, bloom)
	self.grade = grade
	self.bloom = bloom
	return grade, bloom
end

--[[ IL GLITCH SULLO SCHERMO. Una ScreenGui sola: l'immagine del Glitch di DOORS, due sue
     copie rossa e ciano spostate di lato (i colori che si separano) e qualche striscia
     orizzontale che strappa lo schermo. Si usa solo nei momenti che contano, non di continuo:
     se lo schermo si strappa sempre, non si capisce più niente. ]]
local GLITCH_BARS = 4

function Stage:glitchGuiNow()
	if self.glitchGui then return self.glitchGui end
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then return nil end

	local gui = Instance.new("ScreenGui")
	gui.Name = "CrucifixGlitch"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 999
	gui.Enabled = false

	local images = {}
	for index, colour in ipairs({ GLITCH_RED, GLITCH_CYAN, WHITE }) do
		local image = Instance.new("ImageLabel")
		image.BackgroundTransparency = 1
		image.AnchorPoint = Vector2.new(0.5, 0.5)
		image.Position = UDim2.fromScale(0.5, 0.5)
		image.Size = UDim2.fromScale(1.1, 1.1)
		image.Image = "rbxassetid://" .. TEXTURES.GlitchScreen
		image.ImageColor3 = colour
		image.ImageTransparency = 1
		image.ScaleType = Enum.ScaleType.Crop
		image.ZIndex = index
		image.Parent = gui
		images[index] = image
	end

	local bars = {}
	for index = 1, GLITCH_BARS do
		local bar = Instance.new("Frame")
		bar.BorderSizePixel = 0
		bar.BackgroundTransparency = 1
		bar.ZIndex = 4
		bar.Parent = gui
		bars[index] = bar
	end

	gui.Parent = playerGui
	table.insert(self.cleanup, gui)
	self.glitchGui = gui
	self.glitchImages = images
	self.glitchBars = bars
	return gui
end

-- Un colpo di glitch sullo schermo: quanto dura e quanto è forte (0..1). Si sommano
function Stage:glitchScreen(duration, intensity)
	if not self:glitchGuiNow() then return end
	local now = os.clock()
	local active = self.glitchUntil ~= nil and self.glitchUntil > now
	self.glitchPower = if active then math.max(self.glitchPower, intensity) else intensity
	self.glitchUntil = math.max(if active then self.glitchUntil else 0, now + duration)
	self.glitchSpan = self.glitchUntil - now
	self.nextGlitchFrame = 0
end

-- Un fulmine di glitch tra due punti: una Beam a zig-zag che si ridisegna a scatti
function Stage:glitchBolt(from, to, duration)
	local anchor = newPart("GlitchBolt", Vector3.one * 0.1, CFrame.new(from), WHITE, Enum.Material.SmoothPlastic, 1)
	anchor.Parent = self.folder
	local a0 = Instance.new("Attachment")
	a0.Parent = anchor
	local a1 = Instance.new("Attachment")
	a1.Position = anchor.CFrame:PointToObjectSpace(to)
	a1.Parent = anchor

	local beams = {}
	for index, colour in ipairs({ PALETTES.Glitch.Main, PALETTES.GlitchAlt.Main }) do
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Texture = "rbxassetid://" .. TEXTURES.GlitchBit
		beam.TextureMode = Enum.TextureMode.Wrap
		beam.TextureLength = 2
		beam.TextureSpeed = 6 * index
		beam.FaceCamera = true
		beam.Width0 = 1.6 / index
		beam.Width1 = 2.4 / index
		beam.Segments = 12
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Brightness = 4
		beam.Color = ColorSequence.new(colour)
		beam.Parent = anchor
		beams[index] = beam
	end

	task.spawn(function()
		local stop = os.clock() + duration
		while os.clock() < stop and not self.done do
			local left = (stop - os.clock()) / duration
			for _, beam in ipairs(beams) do
				beam.CurveSize0 = (math.random() - 0.5) * 8
				beam.CurveSize1 = (math.random() - 0.5) * 8
				beam.Transparency = NumberSequence.new(1 - left)
			end
			task.wait(0.03)
		end
		anchor:Destroy()
	end)
end

-- I colori del rituale sfarfallano tra viola e ciano, poi si fermano su `settle`
-- (o sul colore che c'era prima)
function Stage:glitchFlicker(duration, settle)
	if not self.flickerUntil then
		self.flickerBack = self.palette
	end
	if settle then
		self.flickerBack = PALETTES[settle] or self.flickerBack
	end
	self.flickerUntil = math.max(self.flickerUntil or 0, os.clock() + duration)
	self.nextFlicker = 0
end

function Stage:applyPalette(palette)
	self.fade = nil
	self.palette = palette
	for _, entry in ipairs(self.bound) do
		pcall(applyBinding, entry, palette)
	end
end

-- Dal ciclo per frame. Senza glitch in corso esce subito
function Stage:stepGlitch(now)
	if self.flickerUntil then
		if now >= self.flickerUntil then
			self.flickerUntil = nil
			self:applyPalette(self.flickerBack or self.palette)
		elseif now >= self.nextFlicker then
			self.nextFlicker = now + 0.035 + math.random() * 0.08
			local roll = math.random()
			self:applyPalette(if roll < 0.45 then PALETTES.Glitch elseif roll < 0.8 then PALETTES.GlitchAlt else self.flickerBack or self.palette)
		end
	end

	local gui = self.glitchGui
	if not gui then return end
	if not self.glitchUntil or now >= self.glitchUntil then
		if gui.Enabled then gui.Enabled = false end
		self.glitchUntil = nil
		return
	end
	if now < self.nextGlitchFrame then return end
	self.nextGlitchFrame = now + 0.03 + math.random() * 0.05

	-- Più forte all'inizio del colpo, poi cala. Mai coprente: sotto si deve vedere la scena
	local left = math.clamp((self.glitchUntil - now) / math.max(self.glitchSpan, 0.05), 0, 1)
	local power = self.glitchPower * (0.35 + 0.65 * left)
	gui.Enabled = true

	local split = 0.003 + 0.018 * power
	local images = self.glitchImages
	for index, image in ipairs(images) do
		local side = if index == 1 then -1 elseif index == 2 then 1 else 0
		image.Position = UDim2.fromScale(0.5 + side * split * (0.5 + math.random()), 0.5 + (math.random() - 0.5) * 0.01 * power)
		image.ImageTransparency = if index == 3 then 1 - 0.2 * power * math.random() else 1 - 0.35 * power * (0.5 + 0.5 * math.random())
	end

	for index, bar in ipairs(self.glitchBars) do
		if math.random() < 0.2 + 0.5 * power then
			local height = 0.004 + math.random() * 0.03 * (0.3 + power)
			bar.Size = UDim2.fromScale(1.2, height)
			bar.Position = UDim2.fromScale(-0.1 + (math.random() - 0.5) * 0.08 * power, math.random())
			local roll = (index + math.floor(now * 30)) % 3
			bar.BackgroundColor3 = if roll == 0 then GLITCH_CYAN elseif roll == 1 then GLITCH_RED else Color3.new(0, 0, 0)
			bar.BackgroundTransparency = 0.45 + 0.4 * math.random()
		else
			bar.BackgroundTransparency = 1
		end
	end
end

--[[ LE LUCI DELLA STANZA per il glitch. Si leggono una volta, e alla fine del rituale (anche se
     si interrompe) tornano come erano. Due comandi soli, per i momenti forti:
       roomBurst(durata)   per quel tempo saltano di colore e d'intensità, poi tornano
       roomDim(quanto, t)  calano piano fino a (1 - quanto); roomDim(0, t) le rialza ]]
function Stage:roomLights()
	if self.lights then return self.lights end
	self.lights = {}
	self.dimAmount = 0
	local room = playerRoom()
	if room then
		for _, light in ipairs(room:GetDescendants()) do
			if light:IsA("Light") then
				table.insert(self.lights, { light = light, colour = light.Color, brightness = light.Brightness })
			end
		end
	end
	table.insert(self.cleanup, function()
		for _, entry in ipairs(self.lights) do
			if entry.light.Parent then
				entry.light.Color = entry.colour
				entry.light.Brightness = entry.brightness
			end
		end
	end)
	return self.lights
end

function Stage:roomDim(amount, duration)
	self.dimAmount = amount
	for _, entry in ipairs(self:roomLights()) do
		if entry.light.Parent then
			tween(entry.light, duration, { Brightness = entry.brightness * (1 - amount), Color = entry.colour })
		end
	end
end

function Stage:roomBurst(duration)
	local lights = self:roomLights()
	if #lights == 0 then return end
	local colours = { PALETTES.Glitch.Main, GLITCH_RED, GLITCH_CYAN }
	task.spawn(function()
		local stop = os.clock() + duration
		while os.clock() < stop and not self.done do
			for _, entry in ipairs(lights) do
				if entry.light.Parent then
					entry.light.Color = colours[math.random(#colours)]
					entry.light.Brightness = if math.random() < 0.4 then 0 else entry.brightness * (1 + 2 * math.random())
				end
			end
			task.wait(0.05)
		end
		if not self.done then
			self:roomDim(self.dimAmount, 0.15)
		end
	end)
end

-- Polvere dai soffitti vicini: solo i più vicini, un colpo di particelle ciascuno
function Stage:ceilingDust(center)
	local ceilings = {}
	for _, ceiling in ipairs(CollectionService:GetTagged("PartCeiling")) do
		if ceiling:IsA("BasePart") then
			local distance = (ceiling.Position - center).Magnitude
			if distance < 90 then
				table.insert(ceilings, { part = ceiling, distance = distance })
			end
		end
	end
	table.sort(ceilings, function(a, b) return a.distance < b.distance end)

	for index = 1, math.min(#ceilings, 8) do
		local ceiling = ceilings[index].part
		local dust = makeEmitter(ceiling, TEXTURES.Dust, Color3.fromRGB(165, 160, 150))
		dust.LightEmission = 0
		dust.LightInfluence = 1
		dust.EmissionDirection = Enum.NormalId.Bottom
		dust.Acceleration = Vector3.new(0, -10, 0)
		dust.Lifetime = NumberRange.new(1, 3)
		dust.Speed = NumberRange.new(3, 12)
		dust.SpreadAngle = Vector2.new(60, 60)
		dust.Size = sequence({ { 0, 2.1 }, { 1, 1.3 } })
		dust.Transparency = sequence({ { 0, 1 }, { 0.23, 0.86 }, { 0.8, 0.89 }, { 1, 1 } })
		dust.RotSpeed = NumberRange.new(-35, 35)
		dust.Rotation = NumberRange.new(-360, 360)
		dust:Emit(math.clamp(math.floor(ceiling.Size.Magnitude * 0.07), 3, 12))
		task.delay(4, function()
			dust:Destroy()
		end)
	end
end

function Stage:destroy()
	if self.done then return end
	self.done = true

	if self.stepName then
		pcall(function() RunService:UnbindFromRenderStep(self.stepName) end)
	end
	if self.poseConnection then
		self.poseConnection:Disconnect()
	end

	-- Il FOV torna quello di DOORS, se l'ultimo a scriverlo siamo stati noi
	local camera = workspace.CurrentCamera
	if camera and self.fovWritten and math.abs(camera.FieldOfView - self.fovWritten) < 1e-3 then
		camera.FieldOfView = self.fovBase
	end

	for _, item in ipairs(self.cleanup) do
		pcall(function()
			if typeof(item) == "RBXScriptConnection" then
				item:Disconnect()
			elseif typeof(item) == "Instance" then
				item:Destroy()
			else
				item()
			end
		end)
	end
	table.clear(self.cleanup)

	if self.flashGui then self.flashGui:Destroy() end
	self.folder:Destroy()
	table.clear(self.bound)
end

---====== L'ENTITÀ GENERICA ======---
--[[ Per un modello qualsiasi: si muove tutto intero (alzato dalla luce,
     tirato giù dalle catene), e le catene prendono otto punti attorno al suo
     box, girato verso di te. Un'entità con un corpo suo (Honcho) passa il
     proprio Body e usa questo solo come esempio. ]]

local function nearestPart(model, point)
	local best, bestDistance = nil, math.huge
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local distance = (descendant.Position - point).Magnitude
			if distance < bestDistance then
				best, bestDistance = descendant, distance
			end
		end
	end
	return best
end

local function genericBody(model, opts)
	local pivot = model:GetPivot()
	local boxCFrame, boxSize = model:GetBoundingBox()
	if opts.BoxSize then
		boxCFrame, boxSize = CFrame.new(pivot.Position), opts.BoxSize
	end
	boxSize = Vector3.new(math.max(boxSize.X, 2), math.max(boxSize.Y, 3), math.max(boxSize.Z, 2))

	local scale = opts.Scale or math.clamp(boxSize.Y / 6, 0.6, 2)
	local bottom = boxCFrame.Position.Y - boxSize.Y / 2
	local floorY = floorBelow(boxCFrame.Position, model) or bottom
	local top = boxCFrame.Position.Y + boxSize.Y / 2

	local body = {
		Scale  = scale,
		Anchor = Vector3.new(pivot.Position.X, floorY, pivot.Position.Z),
		Radius = math.clamp(math.max(boxSize.X, boxSize.Z) / 2 + 4, 6, 16),
		-- Abbastanza giù da non vedere più niente di lui
		Depth  = (top - floorY) + (LIFT + 4) * scale,
		Generic = true,
	}

	function body.Chains(facing)
		local chains = {}
		local frame = CFrame.new(boxCFrame.Position) * facing
		local half = boxSize / 2
		for _, spec in ipairs(GENERIC_CHAINS) do
			local world = frame:PointToWorldSpace(spec.point * half)
			local part = nearestPart(model, world)
			if part then
				table.insert(chains, {
					part   = part,
					offset = part.CFrame:PointToObjectSpace(world),
					angle  = spec.angle,
					reach  = spec.reach,
					at     = spec.at,
				})
			end
		end
		return chains
	end

	function body.Place(yOffset, localOffset)
		model:PivotTo(CFrame.new(pivot.Position + Vector3.new(0, yOffset, 0)) * pivot.Rotation * localOffset)
	end

	-- I suoni dell'entità si spengono mentre affonda, come nel rituale di Vynixu
	local volumes = {}
	function body.Mute()
		for _, sound in ipairs(model:GetDescendants()) do
			if sound:IsA("Sound") then
				volumes[sound] = sound.Volume
				tween(sound, 3, { Volume = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			end
		end
	end

	function body.Vanish()
		if model.Parent then model:Destroy() end
	end

	function body.Recover()
		model:PivotTo(pivot)
		for sound, volume in pairs(volumes) do
			if sound.Parent then sound.Volume = volume end
		end
	end

	return body
end

---====== I TEMPI ======---
--[[ Tutte leggono il copione T. Con V1 danno esattamente i numeri di prima: in V1 i vecchi
     1.1, 0.55, 0.45, 1.3, 1.2 e 4.5 sono T.Jerk, T.Rise, T.Strain e T.Sway. ]]

local function sinkWith(jolts, elapsed, joltTime)
	local sunk = 0
	for _, jolt in ipairs(jolts) do
		if elapsed < jolt.time then break end
		local pull = math.clamp((elapsed - jolt.time) / joltTime, 0, 1)
		local climb = jolt.climb * math.clamp((elapsed - jolt.time - joltTime) / 0.5, 0, 1)
		sunk = sunk + (jolt.reach - sunk) * (1 - (1 - pull) ^ 3) - climb
	end
	return sunk
end

-- Da 0 a 1: quanto è sprofondato
local function sinkAt(elapsed, fail, T)
	if fail then
		local F = T.Fail
		local sunk = sinkWith(F.Jolts, elapsed, T.JoltTime)
		-- Si pianta e risale: il buco non lo tiene più
		return sunk * (1 - smooth((elapsed - F.Climb[1]) / (F.Climb[2] - F.Climb[1])))
	end

	local sunk = sinkWith(T.Jolts, elapsed, T.JoltTime)
	if T.Hope then
		-- Aggrappato al bordo si tira su, e per un attimo ci riesce
		sunk -= T.Hope.amount * smooth((elapsed - T.Hope.at) / T.Hope.time)
	end
	if elapsed >= T.Plunge then
		sunk += (1 - sunk) * backIn(math.clamp((elapsed - T.Plunge) / (T.Slam - T.Plunge), 0, 1))
	end
	return sunk
end

-- Quanto lo tiene su la luce, in stud per scala 1
local function baseLift(elapsed, T)
	local rise = math.clamp((elapsed - T.Rise[1]) / T.Rise[2], 0, 1)
	local strain = math.clamp((elapsed - T.Strain[1]) / T.Strain[2], 0, 1)
	local jerk = math.sin(math.pi * math.clamp((elapsed - T.Jerk) / 0.25, 0, 1))
	return 1.5 * (1 - (1 - rise) ^ 2) + 0.7 * (1 - math.cos(strain * math.pi)) / 2 - 0.45 * jerk
end

local function liftAt(elapsed, fail, T)
	local F = T.Fail
	if not fail or elapsed < F.Climb[1] then
		return baseLift(elapsed, T)
	end

	-- Nel fail tira verso l'alto con tutte le forze, poi, libero, ricade
	local held = baseLift(F.Climb[1], T) + 1.1 * smooth((elapsed - F.Climb[1]) / (F.Break - F.Climb[1]))
	if elapsed < F.Fall[1] then
		return held
	end
	local fall = math.clamp((elapsed - F.Fall[1]) / (F.Fall[2] - F.Fall[1]), 0, 1)
	return held * (1 - fall * fall)
end

-- Appeso alle catene oscilla e si gira; si ferma quando si pianta o si aggrappa
local function swayAt(elapsed, fail, scale, T)
	local stopAt = if fail then T.Fail.Resist else T.Sway[2]
	local hold = math.clamp((elapsed - T.Sway[1]) / 0.4, 0, 1) * (1 - math.clamp((elapsed - stopAt) / 0.3, 0, 1))
	local yaw = (math.sin(elapsed * 5.3) * 14 + math.sin(elapsed * 13.1 + 1) * 5) * hold
	local side = math.sin(elapsed * 4.1) * 0.35 * hold * scale
	return CFrame.new(side, 0, 0) * CFrame.Angles(0, math.rad(yaw), 0)
end

