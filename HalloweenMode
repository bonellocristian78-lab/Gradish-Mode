---====== FIGURE: its head, a jack o' lantern ======---

local JACK = nil -- { model, head } : the head to put on, and where it sits on a head
local function jackOf()
	local figure = KIT.FigureHalloween and KIT.FigureHalloween[1]
	local head = figure and figure:FindFirstChild("Head")
	local kitJack = head and head:FindFirstChild("Jack O' Lantern")
	if kitJack and OK[kitJack] then return { model = kitJack, head = head.CFrame } end
	-- Else: the kit's lit pumpkin (if it loads) or one made here, as big as a head, its face to the front
	local front = Vector3.new(0, 0, -1)
	local teeth = head and head:FindFirstChild("Teeth", true)
	if teeth then
		local v = head.CFrame:VectorToObjectSpace(teeth.Position - head.Position) * Vector3.new(1, 0, 1)
		if v.Magnitude > 0.05 then front = v.Unit end
	end
	local pumpkin = one("Small_Pumpkin_On")
	local model
	if pumpkin and OK[pumpkin] then
		model = pumpkin:Clone()
		local _, size = footprint(model)
		pcall(function() model:ScaleTo(2.1 / math.max(size.X, size.Z)) end)
	else
		model = make("Model", { Name = "Jack O' Lantern" }, nil)
		local ball = make("Part", { Name = "PumpkinBase", Size = Vector3.new(2.1, 1.7, 2.1), Color = Color3.fromRGB(230, 110, 20), Material = Enum.Material.SmoothPlastic }, model)
		make("SpecialMesh", { MeshType = Enum.MeshType.Sphere }, ball)
		make("Decal", { Name = "Face", Face = Enum.NormalId.Front, Texture = asset(file("JackFace.png", "\137PNG")) or "" }, ball)
		make("PointLight", { Color = ORANGE, Range = 6, Brightness = 2 }, ball)
		make("Part", { Name = "Stem", Size = Vector3.new(0.3, 0.45, 0.3), Color = Color3.fromRGB(70, 90, 40), CFrame = CFrame.new(0, 0.95, 0) }, model)
		local face = make("Part", { Name = "Part", Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, CFrame = CFrame.new(0, 0, -1) }, model)
		face.Name = "Part"
	end
	-- Placed as the head is: its middle on the head's, its face (the side its glowing face part is on) to the head's front
	local base, size = footprint(model)
	local middle = base + Vector3.new(0, size.Y / 2, 0)
	local facePart, body = model:FindFirstChild("Part"), model:FindFirstChild("PumpkinBase")
	local f = if facePart and body then (facePart.Position - body.Position) * Vector3.new(1, 0, 1) else Vector3.new(0, 0, -1)
	if f.Magnitude < 0.05 then f = Vector3.new(0, 0, -1) end
	local yaw = yawOf(front) - yawOf(f.Unit)
	model:PivotTo(CFrame.Angles(0, yaw, 0) * CFrame.new(-middle) * model:GetPivot())
	return { model = model, head = ID }
end
local function dressFigure(head)
	if H.heads[head] or not JACK or head:IsDescendantOf(H.folder) then return end
	local fake = head:FindFirstChild("FakeHead")
	local copy = prepare(JACK.model:Clone())
	local entry = { head = head, copy = copy, parts = {} }
	for _, p in ipairs(copy:GetDescendants()) do
		if p:IsA("BasePart") then table.insert(entry.parts, { p, JACK.head:Inverse() * p.CFrame }) end
	end
	for _, d in ipairs(fake and fake:GetDescendants() or {}) do
		if d:IsA("BasePart") or d:IsA("Decal") then set(d, "LocalTransparencyModifier", 1) end
	end
	if fake then set(fake, "LocalTransparencyModifier", 1) end
	copy.Parent = H.folder
	H.heads[head] = entry
end

