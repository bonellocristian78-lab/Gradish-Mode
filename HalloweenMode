task.spawn(function()
	local checks, pending = {}, 0
	for name, list in pairs(KIT) do
		if name ~= "SeekHalloween" and name ~= "FigureHalloween" then
			for _, m in ipairs(list) do table.insert(checks, m) end
		end
	end
	local figure = KIT.FigureHalloween and KIT.FigureHalloween[1]
	local kitJack = figure and figure:FindFirstChild("Jack O' Lantern", true)
	if kitJack then table.insert(checks, kitJack) end
	local seek = KIT.SeekHalloween and KIT.SeekHalloween[1]
	if seek then table.insert(checks, seek) end
	for _, m in ipairs(checks) do
		pending += 1
		task.spawn(function()
			OK[m] = loads(visuals(m))
			pending -= 1
		end)
	end
	local waited = 0
	while pending > 0 and waited < 20 do
		waited += task.wait(0.1)
	end
	if not H.alive then return end
	if seek and OK[seek] then
		local ok, s = pcall(prepareSeek, seek)
		if ok and s then SEEK = s else warn("[HalloweenMode] the kit's Seek could not be made ready: DOORS' own dressed instead", s) end
	end
	local okJack, jack = pcall(jackOf)
	if okJack then JACK = jack end
	H.ready = true
	for head in pairs(H.pendingHeads or {}) do dressFigure(head) end
	H.pendingHeads = nil
end)

local function consider(d)
	if not H.alive or d:IsDescendantOf(H.folder) then return end
	if SEEKS[d.Name] and d:IsA("Model") then
		task.delay(0.1, dressSeek, d) -- (its pieces arrive with it)
	elseif d.Name == "Seek_Arm" and d:IsA("Model") then
		task.delay(0.1, themeHand, d)
	elseif d.Name == "FakeHead" and d:IsA("BasePart") and d.Parent and d.Parent:IsA("BasePart") then
		if H.ready then
			task.defer(dressFigure, d.Parent)
		else
			H.pendingHeads = H.pendingHeads or {}
			H.pendingHeads[d.Parent] = true
		end
	end
end
for _, d in ipairs(workspace:GetDescendants()) do consider(d) end
connect(workspace.DescendantAdded, consider)
