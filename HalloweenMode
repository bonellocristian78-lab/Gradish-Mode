---====== SEEK ======---

local function posesOf(frame)
	local T = {}
	for _, d in ipairs(frame:GetDescendants()) do
		if d:IsA("Pose") and d.Weight > 0 then T[d.Name] = d.CFrame end
	end
	return T
end
local function poseAt(list, time) -- (all its keyframes are linear)
	local a, b = list[1], nil
	for i = 2, #list do
		if list[i].t <= time then a = list[i] else b = list[i] break end
	end
	if not b or time <= a.t then return a.cf end
	return a.cf:Lerp(b.cf, (time - a.t) / (b.t - a.t))
end
local function seekFire(model) -- its fire, purple; its lights, purple
	local fires = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("ParticleEmitter") and fiery(d) then
			d.Color = purpleSequence(d.Color)
			d.Rate = math.min(d.Rate, MAX_RATE)
			table.insert(fires, d)
		elseif d:IsA("Light") then
			d.Color = PURPLE
			d.Shadows = false
		end
	end
	return fires
end
local function embers(part, from)
	local e = if from then from:Clone() else make("ParticleEmitter", { Texture = "rbxassetid://2286297003", Speed = NumberRange.new(1, 3),
		Lifetime = NumberRange.new(1, 2), Size = NumberSequence.new(0.08), LightEmission = 1, Acceleration = Vector3.new(0, 2, 0),
		SpreadAngle = Vector2.new(30, 30) }, nil)
	e.Name, e.Enabled, e.Rate = "HalloweenEmbers", true, 12
	e.Color = ColorSequence.new(PURPLE, Color3.fromRGB(255, 120, 40))
	e.Parent = part
	return e
end

-- The kit's Seek, ready to wear: its parts (by their place in it), its joints, its animations, its floor
local SEEK = nil
local function prepareSeek(template)
	local saves = template:FindFirstChild("AnimSaves")
	local model = template:Clone()
	local s = { model = model, anims = {}, joints = {}, rest = {} }
	local root = model:FindFirstChild("Root")
	if not root then return nil end
	if saves then
		local wanted = { emerge = "rise wit no camera", run = "run new", cruxstart = "cruxstart", cruxloop = "cruxloop", cruxend = "cruxend" }
		for key, name in pairs(wanted) do
			local kfs = saves:FindFirstChild(name) or (key == "run" and saves:FindFirstChild("run")) or nil
			if kfs and kfs:IsA("KeyframeSequence") then
				local anim = { joints = {}, length = 0, looped = key == "run" or key == "cruxloop" }
				local frames = kfs:GetKeyframes()
				table.sort(frames, function(a, b) return a.Time < b.Time end)
				for _, frame in ipairs(frames) do
					anim.length = math.max(anim.length, frame.Time)
					for name2, cf in pairs(posesOf(frame)) do
						anim.joints[name2] = anim.joints[name2] or {}
						table.insert(anim.joints[name2], { t = frame.Time, cf = cf })
					end
				end
				s.anims[key] = anim
			end
		end
	end
	local saved = model:FindFirstChild("AnimSaves")
	if saved then saved:Destroy() end
	-- Its joints (Part0 to Part1), parents first from its Root; every other part rigid on the Root
	local edges = {}
	for _, d in ipairs(model:GetDescendants()) do
		if (d:IsA("Motor6D") or d:IsA("Weld") or d:IsA("ManualWeld")) and d.Part0 and d.Part1 then
			edges[d.Part0] = edges[d.Part0] or {}
			table.insert(edges[d.Part0], { part = d.Part1, c0 = d.C0, c1inv = d.C1:Inverse(), pose = if d:IsA("Motor6D") then d.Part1.Name else nil })
		end
	end
	local queue, seen = { root }, { [root] = true }
	while #queue > 0 do
		local p = table.remove(queue, 1)
		for _, e in ipairs(edges[p] or {}) do
			if not seen[e.part] then
				seen[e.part] = true
				e.parent = p
				table.insert(s.joints, e)
				table.insert(queue, e.part)
			end
		end
	end
	local all = model:GetDescendants()
	for _, d in ipairs(all) do
		if d:IsA("BasePart") and not seen[d] then s.rest[d] = root.CFrame:Inverse() * d.CFrame end
	end
	-- Clean: nothing collides, nothing of DOORS' runs it, its sounds but its fire's
	for _, d in ipairs(all) do
		for _, tag in ipairs(CollectionService:GetTags(d)) do CollectionService:RemoveTag(d, tag) end
		if d:IsA("BasePart") then
			d.Anchored, d.CanCollide, d.CanTouch, d.CanQuery, d.CastShadow, d.Massless = true, false, false, false, false, true
		elseif d:IsA("Humanoid") or d:IsA("Animation") or d:IsA("AnimationController") or d:IsA("JointInstance") then
			d:Destroy()
		elseif d:IsA("Sound") and d.Name ~= "FireIgnite" then
			d:Destroy()
		elseif d:IsA("Decal") and d.Parent and d.Parent.Name == "Eye" and EYE then
			d.Texture = EYE -- (its Halloween eyes)
		end
	end
	s.fires = seekFire(model)
	local ember = nil
	for _, f in ipairs(s.fires) do
		if f.Name == "Embers" then ember = f end
	end
	for _, name in ipairs({ "hand", "Hook" }) do -- its hand and its hook: purple, purple embers
		local p = model:FindFirstChild(name)
		if p then
			p.Color = DARK_PURPLE
			embers(p, ember)
		end
	end
	local head = model:FindFirstChild("Head")
	if head then make("PointLight", { Name = "EyeGlow", Color = ORANGE, Range = 8, Brightness = 1.5, Shadows = false }, head) end
	-- Its floor: the lowest point of its feet in its run
	local low = math.huge
	local run = s.anims.run
	for _, frame in ipairs(run and run.joints.LeftFoot or { { t = 0 } }) do
		local T = {}
		if run then
			for name, list in pairs(run.joints) do T[name] = poseAt(list, frame.t) end
		end
		local w = { [root] = ID }
		for _, j in ipairs(s.joints) do
			w[j.part] = w[j.parent] * j.c0 * (j.pose and T[j.pose] or ID) * j.c1inv
		end
		for _, name in ipairs({ "LeftFoot", "RightFoot" }) do
			local foot = model:FindFirstChild(name)
			if foot and w[foot] then
				for _, c in ipairs(CORNERS) do low = math.min(low, w[foot]:PointToWorldSpace(foot.Size * c).Y) end
			end
		end
	end
	s.floor = if low < math.huge then low else -4.5
	s.index = {} -- (where each part is in it, now that it is clean: its clones have them in the same order)
	for i, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then s.index[d] = i end
	end
	return s
end

local function rootOf(model) -- its rig's Root (the one in SeekRig first), or its PrimaryPart
	local any = nil
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == "Root" then
			if d.Parent and d.Parent.Name == "SeekRig" then return d end
			any = any or d
		end
	end
	return any or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end
-- DOORS' own, out of sight (only for you); switched back off if the server switches it on
local function hide(entry, d)
	if d:IsA("BasePart") or d:IsA("Decal") then
		set(d, "LocalTransparencyModifier", 1)
	elseif d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Beam") or d:IsA("Trail") or d:IsA("Fire") or d:IsA("Smoke") then
		set(d, "Enabled", false)
		table.insert(entry.watch, d:GetPropertyChangedSignal("Enabled"):Connect(function() if d.Enabled and H.alive then d.Enabled = false end end))
	end
end
local function floorUnder(entry, at)
	local character = LocalPlayer.Character
	local me = character and character:FindFirstChild("HumanoidRootPart")
	local from = if me and math.abs(me.Position.Y - at.Y) < 20 then me.Position.Y + 3 else at.Y + 2
	local hit = nil
	pcall(function()
		probe.FilterDescendantsInstances = { H.folder, entry.original, character }
		hit = workspace:Raycast(Vector3.new(at.X, from, at.Z), Vector3.new(0, -30, 0), probe)
	end)
	if hit then entry.floor = hit.Position.Y end
	return entry.floor or (at.Y - 5.8)
end

-- If the kit's Seek will not load here: DOORS' own Seek dressed for Halloween
local function themeSeek(original)
	local ember = nil
	for _, d in ipairs(original:GetDescendants()) do
		if d:IsA("ParticleEmitter") then
			set(d, "Color", purpleSequence(d.Color))
		elseif d:IsA("Light") then
			set(d, "Color", PURPLE)
		elseif d:IsA("Decal") and d.Parent and d.Parent.Name == "Eye" and EYE then
			set(d, "Texture", EYE)
		elseif d:IsA("BasePart") and d.Name:find("Hand") then
			set(d, "Color", DARK_PURPLE)
			made(embers(d, nil))
		end
	end
	local torso = original:FindFirstChild("UpperTorso", true) or original:FindFirstChild("Torso", true) or rootOf(original)
	local template = SEEK and SEEK.model or (KIT.SeekHalloween and KIT.SeekHalloween[1])
	if torso and template then
		for _, f in ipairs(template:GetDescendants()) do
			if f:IsA("ParticleEmitter") and fiery(f) then
				local copy = f:Clone()
				copy.Color, copy.Enabled = purpleSequence(f.Color), true
				copy.Rate = math.min(copy.Rate, MAX_RATE)
				copy.Parent = torso
				made(copy)
			end
		end
	end
	if not torso or not template then
		made(make("Fire", { Name = "HalloweenFire", Color = PURPLE, SecondaryColor = Color3.fromRGB(90, 0, 160), Size = 6, Heat = 6 },
			torso or rootOf(original)))
	end
end

local function dressSeek(original)
	if H.seeks[original] or not original:IsDescendantOf(workspace) or original:IsDescendantOf(H.folder) then return end
	while H.alive and not H.ready do task.wait(0.25) end
	if not H.alive or H.seeks[original] or not original:IsDescendantOf(workspace) then return end
	local follow = rootOf(original)
	if not (SEEK and follow) then
		H.seeks[original] = { themed = true }
		themeSeek(original)
		return
	end
	local copy = SEEK.model:Clone()
	local all = copy:GetDescendants()
	local entry = { original = original, copy = copy, follow = follow, watch = {}, state = "emerge", time = 0, born = os.clock(),
		running = 0, seen = {}, parts = {}, fires = {} }
	for template, i in pairs(SEEK.index) do entry.parts[template] = all[i] end
	entry.root = copy:FindFirstChild("Root")
	for _, d in ipairs(all) do
		if d:IsA("ParticleEmitter") and fiery(d) and d.Name ~= "HalloweenEmbers" then
			d.Enabled = false
			table.insert(entry.fires, d)
		elseif d:IsA("Light") and d.Name ~= "EyeGlow" then
			d.Enabled = false
			table.insert(entry.fires, d)
		end
	end
	entry.ignite = copy:FindFirstChild("FireIgnite", true)
	-- What DOORS plays on it: the animations of its first seconds are its rise and its run; one after those, with it
	-- standing still, is the crucifix
	local animator = original:FindFirstChildWhichIsA("Animator", true)
	if animator then
		table.insert(entry.watch, animator.AnimationPlayed:Connect(function(track)
			local id = track.Animation and track.Animation.AnimationId or ""
			if os.clock() - entry.born < 4 then
				entry.seen[id] = true
			elseif not entry.seen[id] and entry.state ~= "crux" and entry.state ~= "cruxend" and (entry.pace or 0) < 3 then
				entry.state, entry.time = "crux", 0
				table.insert(entry.watch, track.Stopped:Connect(function()
					if entry.state == "crux" then entry.state, entry.time = "cruxend", 0 end
				end))
			end
		end))
	end
	copy.Parent = H.folder
	for _, d in ipairs(original:GetDescendants()) do hide(entry, d) end
	table.insert(entry.watch, original.DescendantAdded:Connect(function(d) hide(entry, d) end))
	H.seeks[original] = entry
end
local function burn(entry, on)
	if entry.burning == on then return end
	entry.burning = on
	for _, f in ipairs(entry.fires) do f.Enabled = on end
	if on and entry.ignite then entry.ignite:Play() end
end
local function stepSeek(entry, dt)
	if not entry.leaving then
		-- Where: DOORS' Seek's place, on the floor under it, turned the way it goes
		local at = entry.follow.Position
		local flat = (at - (entry.last or at)) * Vector3.new(1, 0, 1)
		entry.pace = flat.Magnitude / math.max(dt, 1e-3)
		entry.last = at
		local look = if entry.pace > 2 then flat.Unit else entry.follow.CFrame.LookVector * Vector3.new(1, 0, 1)
		if look.Magnitude > 1e-3 then entry.look = (entry.look or look.Unit):Lerp(look.Unit, math.min(dt * 10, 1)) end
		local pos = Vector3.new(at.X, floorUnder(entry, at) - SEEK.floor, at.Z)
		entry.root.CFrame = CFrame.lookAt(pos, pos + (entry.look or Vector3.new(0, 0, -1)))
	end
	-- Which: out of the floor (until it really runs), its run (as fast as it goes), the crucifix
	entry.running = if (entry.pace or 0) > 8 and (entry.pace or 0) < 200 then entry.running + dt else 0
	if entry.state == "emerge" and (entry.running > 0.25 or not SEEK.anims.emerge or entry.time >= SEEK.anims.emerge.length) then
		entry.state, entry.time = "run", 0
	end
	local anim, speed = nil, 1
	if entry.state == "emerge" then
		anim = SEEK.anims.emerge
	elseif entry.state == "run" then
		anim = SEEK.anims.run
		speed = math.clamp((entry.pace or 0) / 20, 0.35, 1.6)
	elseif entry.state == "crux" then
		anim = if SEEK.anims.cruxstart and entry.time < SEEK.anims.cruxstart.length then SEEK.anims.cruxstart else SEEK.anims.cruxloop
	elseif entry.state == "cruxend" then
		anim = SEEK.anims.cruxend
	end
	burn(entry, entry.state ~= "emerge")
	entry.time += dt * speed
	local T = {}
	if anim then
		local t = entry.time
		if anim == SEEK.anims.cruxloop and SEEK.anims.cruxstart then t -= SEEK.anims.cruxstart.length end
		t = if anim.looped and anim.length > 0 then t % anim.length else math.min(t, anim.length)
		for name, list in pairs(anim.joints) do T[name] = poseAt(list, t) end
	end
	local rootCF = entry.root.CFrame
	local w = { [SEEK.model.Root] = ID }
	for _, j in ipairs(SEEK.joints) do
		local cf = w[j.parent] * j.c0 * (j.pose and T[j.pose] or ID) * j.c1inv
		w[j.part] = cf
		local mine = entry.parts[j.part]
		if mine then mine.CFrame = rootCF * cf end
	end
	for template, rel in pairs(SEEK.rest) do
		local mine = entry.parts[template]
		if mine and mine ~= entry.root then mine.CFrame = rootCF * rel end
	end
end
local function undressSeek(original, gone)
	local entry = H.seeks[original]
	if not entry then return end
	H.seeks[original] = nil
	if entry.themed then return end
	for _, c in ipairs(entry.watch) do c:Disconnect() end
	if gone and entry.state == "crux" and SEEK.anims.cruxend then -- taken by the crucifix: it goes down before it goes
		entry.state, entry.time, entry.leaving = "cruxend", 0, true
		H.seeks[{}] = entry
		task.delay(SEEK.anims.cruxend.length + 0.2, function() entry.copy:Destroy() end)
		return
	end
	entry.copy:Destroy()
end

