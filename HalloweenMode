local function decorate(room, entry)
	while H.alive and not H.ready do task.wait(0.25) end
	if not (H.alive and H.rooms[room] == entry and room.Parent) then return end
	local info = measure(room)
	if not info then return end
	entry.info = info
	pcall(fog, info, entry.folder)
	pcall(floorDecorations, info, entry.folder)
	pcall(topDecorations, info, entry.folder)
	pcall(ceilingDecorations, info, entry.folder)
