local function dressRoom(room)
	if H.rooms[room] or not room:IsA("Model") then return end
	local entry = { folder = make("Folder", { Name = room.Name }, H.folder) }
	H.rooms[room] = entry
	for _, d in ipairs(room:GetDescendants()) do touch(d) end
	entry.watch = connect(room.DescendantAdded, function(d) task.defer(touch, d) end)
