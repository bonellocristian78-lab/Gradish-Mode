connect(RunService.RenderStepped, function(dt)
	local gone = {}
	for original, entry in pairs(H.seeks) do
		if not entry.themed then
			if entry.leaving then
				if entry.copy.Parent then stepSeek(entry, dt) else table.insert(gone, original) end
			elseif not original:IsDescendantOf(workspace) then
				table.insert(gone, original)
			else
				stepSeek(entry, dt)
			end
		elseif not original:IsDescendantOf(workspace) then
			table.insert(gone, original)
		end
	end
	for _, original in ipairs(gone) do -- (after the loop: the table is not changed while it is gone through)
		if H.seeks[original] and H.seeks[original].leaving then H.seeks[original] = nil else undressSeek(original, true) end
	end
	for head, entry in pairs(H.heads) do
		if not head:IsDescendantOf(workspace) then
			entry.copy:Destroy()
			H.heads[head] = nil
		else
			local cf = head.CFrame
			for _, pair in ipairs(entry.parts) do pair[1].CFrame = cf * pair[2] end
		end
	end
end)

GENV.__HalloweenMode = function()
	H.alive = false
	for _, c in ipairs(H.connections) do c:Disconnect() end
	for _, entry in pairs(H.seeks) do
		for _, c in ipairs(entry.watch or {}) do c:Disconnect() end
	end
	for inst, props in pairs(H.changed) do
		for prop, old in pairs(props) do pcall(function() inst[prop] = old[1] end) end
	end
	for _, i in ipairs(H.made) do pcall(function() i:Destroy() end) end
	H.folder:Destroy()
	H.music:Destroy()
	H.grade:Destroy()
	GENV.__HalloweenMode = nil
end
