local LOADED = { mesh = nil, eyes = nil } -- (its creator's mesh and eyes, here: true, false, or not known)
-- Its tape (MONOCHROME's video): 350 pictures at 15 a second, 15 to a sheet (3 by 5, 320 by 192 each); its sound 25 s long
local TAPE = { frames = 350, fps = 15, sheets = 24, columns = 3, rows = 5, width = 320, height = 192, length = 25.08 }
do
	local MAGIC = { mp3 = { "ID3", "\255\251", "\255\243", "\255\242" }, png = { "\137PNG" }, jpg = { "\255\216" }, rbxm = { "<roblox!" }, lua = { "-- VER's" } }
	local function valid(name, data)
		if type(data) ~= "string" or #data < 16 then return false end
		for _, start in ipairs(MAGIC[name:match("%.(%w+)$")] or {}) do
			if data:sub(1, #start) == start then return true end
		end
		return false
	end
	-- A file of the repository, kept in the executor's folder Monochrome (fetched once): its path there, or nil
	local function file(path, name)
		local here = "Monochrome/" .. name
		pcall(function()
			if not isfolder("Monochrome") then makefolder("Monochrome") end
			if isfile(here) and valid(name, readfile(here)) then return end
			local data = game:HttpGet(REPO .. path .. name)
			if valid(name, data) then writefile(here, data) end
		end)
		local ok, there = pcall(isfile, here)
		return if ok and there then here else nil
	end
	local names = { "Drone.mp3", "Scream.mp3", "Click.mp3", "Ping.mp3", "Grain1.png", "Grain2.png", "Grain3.png", "Grain4.png", "Eyes.png" }
	if VARIANT == "Noise" then
		table.insert(names, "Tape.mp3")
		for i = 1, TAPE.sheets do table.insert(names, ("Tape_%02d.jpg"):format(i)) end
	end
	local k = {}
	-- (VER's model as a public asset, if its creator puts it on Roblox for all: _G.VERModel = its id. Else ours, out of its place)
	local public = tostring(_G.VERModel or GENV.VERModel or ""):match("%d+")
	local jobs = { function() -- (the kit: VER)
		pcall(function()
			local list = if public then game:GetObjects("rbxassetid://" .. public) else game:GetObjects(getcustomasset(file("", "Monochrome.rbxm")))
			for _, m in ipairs(list) do
				local found = if m.Name == "VER" then m else m:FindFirstChild("VER", true)
				if found and found:IsA("Model") then k.ver = found end
			end
		end)
	end }
	table.insert(jobs, function() -- (its own shape, out of its saved place: for where its creator's mesh will not load)
		local path = file("assets/monochrome/", "VERBody.lua")
		pcall(function() k.body = loadstring(readfile(path))() end)
	end)
	if VARIANT == "Noise" then
		table.insert(jobs, function() -- (the TV, on its feet, out of Noise's kit)
			local path = file("", "MonochromeTV.rbxm")
			pcall(function() k.tv = game:GetObjects(getcustomasset(path))[1] end)
		end)
		table.insert(jobs, function() -- (Noise's Emerge, made VER's)
			local path = file("assets/monochrome/", "Emerge.lua")
			pcall(function() k.emerge = loadstring(readfile(path))() end)
		end)
	end
	for _, name in ipairs(names) do
		table.insert(jobs, function()
			local path = file("assets/monochrome/", name)
			if path then
				local ok, id = pcall(getcustomasset, path)
				if ok and type(id) == "string" then LOCAL[name:match("^(.-)%.")] = id end
			end
		end)
	end
	local left = #jobs
	for _, job in ipairs(jobs) do
		task.spawn(function()
			job()
			left -= 1
		end)
	end
	local t0 = os.clock()
	while left > 0 and os.clock() - t0 < 30 do task.wait(0.05) end
	kit = k
	-- Its creator's mesh and eyes: do they load here? (outside its game they may not; then it is made of its bones, with
	-- eyes of ours: never an invisible VER)
	local function loads(content, holder)
		local ok, status = pcall(function()
			ContentProvider:PreloadAsync({ holder or content })
			return ContentProvider:GetAssetFetchStatus(content)
		end)
		if not ok then return nil end
		return status ~= Enum.AssetFetchStatus.Failure and status ~= Enum.AssetFetchStatus.TimedOut
	end
	local body = kit.ver and kit.ver:FindFirstChild("LowPolyHuman")
	if body then
		LOADED.mesh = loads(body.MeshId, body)
		if LOADED.mesh == false then kit.ver = nil end
	end
	LOADED.eyes = loads("rbxassetid://92865588300030")
end

