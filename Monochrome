local GENV = if getgenv then getgenv() else _G
if GENV.__Monochrome then pcall(GENV.__Monochrome) end
GENV.__MonochromeFiles = GENV.__MonochromeFiles or {}

local function make(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do i[k] = v end
	i.Parent = parent
	return i
end
local function flat(v) return v * Vector3.new(1, 0, 1) end
local up = Vector3.new(0, 1, 0)

local folder = make("Folder", { Name = "Monochrome" }, workspace)
local screen = make("ScreenGui", { Name = "Monochrome", IgnoreGuiInset = true, DisplayOrder = 100004, ResetOnSpawn = false },
	if gethui then gethui() else LocalPlayer:WaitForChild("PlayerGui"))

local alive = true
local connections, cleanups = {}, {}
local function on(signal, fn)
	local c = signal:Connect(fn)
	table.insert(connections, c)
	return c
end
local function later(fn) table.insert(cleanups, fn) end
local function stop()
	if not alive then return end
	alive = false
	for _, c in ipairs(connections) do c:Disconnect() end
	for i = #cleanups, 1, -1 do pcall(cleanups[i]) end
	folder:Destroy()
	screen:Destroy()
	if GENV.__Monochrome == stop then GENV.__Monochrome = nil end
end
GENV.__Monochrome = stop
local function wait(seconds)
	local t0 = os.clock()
	repeat RunService.Heartbeat:Wait() until not alive or os.clock() - t0 >= seconds
	return alive
end
local function approach(a, b, rate, dt) return a + (b - a) * (1 - math.exp(-rate * dt)) end
local function smoothstep(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

---====== FILES: VER's kit (out of its place), and its stand-ins (for any of its game's own files that will not load here) ======---

local REPO = "https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/claude/sei-qui-con-noi-ye4k62/"
local LOCAL = {} -- name -> a content ID of ours
local kit = nil -- { ver = VER, radar = its radar }
do
	local MAGIC = { mp3 = { "ID3", "\255\251", "\255\243", "\255\242" }, png = { "\137PNG" }, rbxm = { "<roblox!" } }
	local function valid(name, data)
		if type(data) ~= "string" or #data < 16 then return false end
		for _, start in ipairs(MAGIC[name:match("%.(%w+)$")] or {}) do
			if data:sub(1, #start) == start then return true end
		end
		return false
	end
	-- A file of the repository, kept in the executor's folder Monochrome (fetched once): its path there, or nil
	local function file(path, name)
		local here = "Monochrome/" .. name
		pcall(function()
			if not isfolder("Monochrome") then makefolder("Monochrome") end
			if isfile(here) and valid(name, readfile(here)) then return end
			local data = game:HttpGet(REPO .. path .. name)
			if valid(name, data) then writefile(here, data) end
		end)
		local ok, there = pcall(isfile, here)
		return if ok and there then here else nil
	end
	local names = { "Drone.mp3", "Scream.mp3", "Click.mp3", "Ping.mp3", "Grain1.png", "Grain2.png", "Grain3.png", "Grain4.png" }
	local left = #names + 1
	task.spawn(function() -- (the kit: VER and its radar, as two models)
		local path = file("", "Monochrome.rbxm")
		pcall(function()
			local got = game:GetObjects(getcustomasset(path))
			local k = {}
			for _, m in ipairs(got) do
				if m.Name == "VER" then k.ver = m elseif m.Name == "radar" then k.radar = m end
			end
			if k.ver then kit = k end
		end)
		left -= 1
	end)
	for _, name in ipairs(names) do
		task.spawn(function()
			local path = file("assets/monochrome/", name)
			if path then
				local ok, id = pcall(getcustomasset, path)
				if ok and type(id) == "string" then LOCAL[name:match("^(.-)%.")] = id end
			end
			left -= 1
		end)
	end
	local t0 = os.clock()
	while left > 0 and os.clock() - t0 < 25 do task.wait(0.05) end
end

