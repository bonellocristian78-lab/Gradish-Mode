		local scale = height / main.Size.Y
		pcall(function() unit:ScaleTo(scale) end)
		if math.abs(main.Size.Y - height) > 1e-3 then main.Size *= scale end -- (where models cannot be scaled)
		local size = main.Size
		local w, h = size.Z * 0.85, size.Y * 0.771
		glass = make("Part", { Name = "Glass", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Transparency = 1,
			Size = Vector3.new(w, h, 0.05) }, unit)
		dialAt = CFrame.fromMatrix(Vector3.new(-size.X * 0.5 + size.X * 0.1016 + 0.025, size.Y * -0.04334, 0), Vector3.new(0, 0, -1), up)
		Radar.pixels = 460 / math.min(w, h)
