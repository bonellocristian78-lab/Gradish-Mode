	local dial = make("SurfaceGui", { Name = "Dial", Enabled = false, Face = Enum.NormalId.Front, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = Radar.pixels or 400, LightInfluence = 0, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, glass)
	local face = make("Frame", { Name = "Face", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(368, 368),
		BackgroundTransparency = 1 }, dial)
	local function ring(scale, thickness, transparency)
		local f = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(scale, scale), BackgroundTransparency = 1 }, face)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, f)
		make("UIStroke", { Thickness = thickness, Color = WHITE, Transparency = transparency }, f)
	end
	local function bar(w, h, x, y, rotation, transparency, parent)
