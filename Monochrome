local function body()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then return character, humanoid, root end
	return nil, nil, nil
end
local function hiding()
	local character = LocalPlayer.Character
	return character ~= nil and character:GetAttribute("Hiding") == true
end
local LIGHTS = { "Flashlight", "Lighter", "Lantern", "Candle", "Bulklight", "Torch", "Glowstick", "Gummy" }
local function holdingLight() -- (a light in your hand: it sees you in the dark)
	local character = LocalPlayer.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	if not tool then return false end
	for _, word in ipairs(LIGHTS) do
		if tool.Name:find(word) then return true end
	end
	return false
end

local W = {}
do
	local probe = RaycastParams.new()
	probe.FilterType = Enum.RaycastFilterType.Exclude
	probe.RespectCanCollide = true
	function W.cast(from, direction, also)
		probe.FilterDescendantsInstances = { folder, LocalPlayer.Character, also or folder }
		return workspace:Raycast(from, direction, probe)
	end
	-- The floor under a point (else the point)
	function W.floor(p)
		local hit = W.cast(p + up * 3, Vector3.new(0, -40, 0))
		return if hit then hit.Position else p
	end
	function W.rooms()
		local all = workspace:FindFirstChild("CurrentRooms")
		if not all then return {} end
		local list = {}
		for _, r in ipairs(all:GetChildren()) do
			if tonumber(r.Name) then table.insert(list, r) end
		end
		table.sort(list, function(a, b) return tonumber(a.Name) < tonumber(b.Name) end)
		return list
	end
	function W.room(n)
		local all = workspace:FindFirstChild("CurrentRooms")
		return all and all:FindFirstChild(tostring(n)) or nil
	end
	-- The room you are in (DOORS' own count of it)
	function W.here()
		local n = tonumber(LocalPlayer:GetAttribute("CurrentRoom"))
		if n then return n end
		local data = ReplicatedStorage:FindFirstChild("GameData")
		local latest = data and data:FindFirstChild("LatestRoom")
		return latest and tonumber(latest.Value) or nil
	end
	local function part(room, names)
		for _, name in ipairs(names) do
			local p = room:FindFirstChild(name)
			if p and p:IsA("BasePart") then return p end
		end
		return nil
	end
	-- A room's way in and way out (DOORS': RoomEntrance / RoomExit; the Hotel-: RoomStart / RoomEnd), its way through (its
	-- nodes), the way it goes (from its way in to its way out)
	function W.ends(room)
		return part(room, { "RoomEntrance", "RoomStart" }), part(room, { "RoomExit", "RoomEnd" })
	end
	function W.forward(room)
		local entrance, exit = W.ends(room)
		if not exit then return nil end
		local d = flat(exit.Position - (if entrance then entrance.Position else room:GetPivot().Position))
		return if d.Magnitude > 0.5 then d.Unit else flat(exit.CFrame.LookVector).Unit
	end
	function W.points(room)
		local pts = {}
		local entrance, exit = W.ends(room)
		if entrance then table.insert(pts, entrance.Position) end
		local nodes = room:FindFirstChild("PathfindNodes") or room:FindFirstChild("Nodes")
		if nodes then
			local list = {}
			for _, n in ipairs(nodes:GetChildren()) do
				if n:IsA("BasePart") then table.insert(list, n) end
			end
			table.sort(list, function(a, b) return (tonumber(a.Name) or 0) < (tonumber(b.Name) or 0) end)
			for _, n in ipairs(list) do table.insert(pts, n.Position) end
		end
		if exit then table.insert(pts, exit.Position) end
		if #pts == 0 then table.insert(pts, room:GetPivot().Position) end
		for i, p in ipairs(pts) do pts[i] = W.floor(p) end
		return pts
	end
	-- The room a point is in: the one whose way through (from its way in to its way out) passes nearest it
	function W.roomOf(p)
		local best, bestDistance = nil, math.huge
		for _, room in ipairs(W.rooms()) do
			local entrance, exit = W.ends(room)
			local d
			if entrance and exit then
				local a, b = flat(entrance.Position), flat(exit.Position)
				local ab = b - a
				local k = if ab.Magnitude > 0.01 then math.clamp((flat(p) - a):Dot(ab) / ab:Dot(ab), 0, 1) else 0
				d = (flat(p) - (a + ab * k)).Magnitude + math.abs(p.Y - exit.Position.Y) * 0.5
			else
				d = (room:GetPivot().Position - p).Magnitude
			end
			if d < bestDistance then best, bestDistance = room, d end
		end
		return best and tonumber(best.Name)
	end
	-- Nothing solid between two points
	function W.clear(a, b, also)
		return W.cast(a, b - a, also) == nil
	end
	-- DOORS' wardrobes (and the rest it hides you in): the one you are in
	function W.hidingSpot(near)
		local best, bestDistance = nil, 9
		for _, room in ipairs(W.rooms()) do
			for _, d in ipairs(room:GetDescendants()) do
				if d:IsA("ProximityPrompt") and (d.Name == "HidePrompt" or d.ActionText == "Hide") then
					local m = d:FindFirstAncestorWhichIsA("Model")
					local at = m and m:GetPivot().Position
					if at and (at - near).Magnitude < bestDistance then best, bestDistance = m, (at - near).Magnitude end
				end
			end
		end
		return best
	end
end

---====== THE LIGHTS: ITS (it has full control over them): its blackouts, their flicker as it passes ======---

-- As its game's MapLightFlicker: a blackout cuts the lamps down one by one, each flickering and clicking, then they stay low
-- (dim, not out: the room is still seen); they come back the same way; near it they burst into flickers. White VER's is a
-- whiteout: its lamps flare white instead. DOORS' lamps: each model with lights in a room
local Lamps = { list = {}, byModel = {}, seen = {}, state = "on", clock = 0, ends = 0, scanned = -10 }
do
	local rng = Random.new()
	local DIM = if VARIANT == "White" then 2.4 else 0.5 -- (a lamp cut down: this much of its light left; White's: flared)
	local WHITE = Color3.new(1, 1, 1)
	local function set(lamp, lit)
		if lamp.on == lit then return end
		lamp.on = lit
		for i, l in ipairs(lamp.lights) do
			pcall(function()
				l.Brightness = if lit then lamp.was[i] else lamp.was[i] * DIM
				if VARIANT == "White" then l.Color = if lit then lamp.tint[i] else WHITE end
			end)
		end
		for _, n in ipairs(lamp.neon) do
			pcall(function() n[1].Color = if lit then n[3] elseif VARIANT == "White" then n[3]:Lerp(WHITE, 0.85) else n[3]:Lerp(Color3.new(0, 0, 0), 0.55) end)
		end
	end
	Lamps.set = set
	local function click(lamp, volume)
		local camera = workspace.CurrentCamera
		if camera and (lamp.pos - camera.CFrame.Position).Magnitude > 60 then return end
		if not lamp.sound then
			lamp.sound = sound("lamp", { Volume = 0.5, RollOffMode = Enum.RollOffMode.InverseTapered, RollOffMinDistance = 5, RollOffMaxDistance = 60 }, lamp.part)
		end
		pcall(function()
			lamp.sound.Volume = volume
			lamp.sound.PlaybackSpeed = rng:NextNumber(0.86, 1.18)
			lamp.sound.TimePosition = 0
			lamp.sound:Play()
		end)
	end
	-- The lamps of the rooms loaded (each model with lights in it, once; each room once)
	function Lamps.scan()
		for _, room in ipairs(W.rooms()) do
			if Lamps.seen[room] then continue end
			Lamps.seen[room] = true
			for _, d in ipairs(room:GetDescendants()) do
				if d:IsA("Light") then
					local model = d:FindFirstAncestorWhichIsA("Model")
					if model == room then model = d.Parent end
					local lamp = model and Lamps.byModel[model]
					if model and not lamp then
						local holder = d:FindFirstAncestorWhichIsA("BasePart")
						lamp = { model = model, lights = {}, was = {}, tint = {}, neon = {}, on = true, part = holder or room.PrimaryPart, nextEvent = rng:NextNumber(1, 6),
							bursting = false, burstEnd = 0, nextToggle = 0, eventAt = 0, eventEnd = 0 }
						lamp.pos = if holder then holder.Position else model:GetPivot().Position
						for _, p in ipairs(model:GetDescendants()) do
							if p:IsA("BasePart") and p.Material == Enum.Material.Neon then table.insert(lamp.neon, { p, p.Material, p.Color }) end
						end
						if model:IsA("BasePart") and model.Material == Enum.Material.Neon then table.insert(lamp.neon, { model, model.Material, model.Color }) end
						Lamps.byModel[model] = lamp
						table.insert(Lamps.list, lamp)
						if Lamps.state == "out" then set(lamp, false) end
					end
					if lamp and not table.find(lamp.lights, d) then
						table.insert(lamp.lights, d)
						table.insert(lamp.was, d.Brightness)
						table.insert(lamp.tint, d.Color)
						if not lamp.on then
							d.Brightness *= DIM
							if VARIANT == "White" then d.Color = WHITE end
						end
					end
				end
			end
		end
	end
	-- The lamps near a point (`range`)
	local function near(p, range)
		local out = {}
		for _, lamp in ipairs(Lamps.list) do
			if lamp.model.Parent and (lamp.pos - p).Magnitude < range then table.insert(out, lamp) end
		end
		return out
	end
	local function schedule(lamps, spread, short, long)
		Lamps.ends = 0
		for _, lamp in ipairs(lamps) do
			lamp.eventAt = Lamps.clock + rng:NextNumber(0, spread)
			lamp.eventEnd = lamp.eventAt + rng:NextNumber(short, long)
			lamp.nextToggle, lamp.bursting = 0, false
			Lamps.ends = math.max(Lamps.ends, lamp.eventEnd)
		end
		Lamps.circuit = lamps
	end
	-- Its blackout: the lamps around `p` cut out (as its game: over 1.8 s, each flickering 0.12-0.55 s), stay out `seconds`,
	-- then wake (over 2.6 s, each 0.3-1.1 s)
	function Lamps.blackout(p, seconds)
		if Lamps.state ~= "on" then return false end
		Lamps.scan()
		Lamps.state = "cutting"
		schedule(near(p, 140), 1.8, 0.12, 0.55)
		Lamps.until_ = Lamps.clock + 1.9 + seconds
		return true
	end
	function Lamps.wake()
		if Lamps.state == "on" or Lamps.state == "waking" then return end
		Lamps.state = "waking"
		schedule(Lamps.circuit or {}, 2.6, 0.3, 1.1)
	end
	function Lamps.step(dt, verAt)
		Lamps.clock += dt
		local t = Lamps.clock
		if t - Lamps.scanned > 2 then
			Lamps.scanned = t
			Lamps.scan()
		end
		if Lamps.state == "cutting" or Lamps.state == "waking" then
			local cutting = Lamps.state == "cutting"
			for _, lamp in ipairs(Lamps.circuit or {}) do
				if t >= lamp.eventAt then
					if t < lamp.eventEnd then
						if lamp.nextToggle <= t then
							local lit = rng:NextNumber() < (if cutting then 0.34 else 0.62)
							local changed = lamp.on ~= lit
							set(lamp, lit)
							if lit and changed then click(lamp, 0.26) end
							lamp.nextToggle = t + rng:NextNumber(0.02, 0.09)
						end
					else
						set(lamp, not cutting)
					end
				end
			end
			if t >= Lamps.ends then
				for _, lamp in ipairs(Lamps.circuit or {}) do set(lamp, not cutting) end
				Lamps.state = if cutting then "out" else "on"
			end
		elseif Lamps.state == "out" and Lamps.until_ and t >= Lamps.until_ then
			Lamps.wake()
		end
		-- As it passes: the lamps near it burst into flickers (0.12-0.9 s, clicking), every few seconds
		if verAt and Lamps.state == "on" then
			for _, lamp in ipairs(Lamps.list) do
				if (lamp.pos - verAt).Magnitude < 24 and lamp.model.Parent then
					if lamp.bursting then
						if t >= lamp.burstEnd then
							lamp.bursting = false
							set(lamp, true)
							lamp.nextEvent = t + rng:NextNumber(1.5, 6)
						elseif lamp.nextToggle <= t then
							local lit = rng:NextNumber() < 0.38
							local changed = lamp.on ~= lit
							set(lamp, lit)
							if lit and changed then click(lamp, 0.5) end
							lamp.nextToggle = t + rng:NextNumber(0.02, 0.1)
						end
					elseif t >= lamp.nextEvent then
						lamp.bursting, lamp.nextToggle, lamp.burstEnd = true, 0, t + rng:NextNumber(0.12, 0.9)
					end
				elseif lamp.bursting then
					lamp.bursting = false
					set(lamp, true)
				end
			end
		end
	end
	later(function()
		for _, lamp in ipairs(Lamps.list) do
			pcall(set, lamp, true)
			if lamp.sound then pcall(function() lamp.sound:Destroy() end) end
		end
	end)
end

