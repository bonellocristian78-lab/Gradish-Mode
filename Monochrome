---====== ITS ANIMATOR: its game's MonsterAnimator (it follows where it is going, turns, steps its gait; its horns on its head) ======---

local gait = nil
local SFXP = {} -- its sounds (below)
do
	local model, root = VER.model, VER.root
	local function setup()
		gait = Gait.new(model)
		-- Its horns go with its head (their joints, as its game moves them); its eyes on its head
		VER.cones = {}
		local head = gait:posedCFrame(Gait.HEAD_CHAIN)
		for _, name in ipairs({ "Cone", "Cone.001" }) do
			local cone = model:FindFirstChild(name)
			local motor = cone and cone:FindFirstChildWhichIsA("Motor6D")
			if motor then
				table.insert(VER.cones, { part = cone, motor = motor, offset = head:ToObjectSpace(root.CFrame * motor.C0 * motor.C1:Inverse()) })
			elseif cone then -- (ours: on its head)
				table.insert(VER.cones, { part = cone, offset = CFrame.new((if name == "Cone" then -0.42 else 0.42), 0.95, 0) * CFrame.Angles(0, 0, (if name == "Cone" then 0.5 else -0.5)) })
			end
		end
		local anchor = VER.eyes and VER.eyes:FindFirstChild("EyesAnchor")
		VER.eyesOffset = if anchor then anchor.CFrame:Inverse() else CFrame.new(0, 0.5, -0.45)
		if VER.eyes then -- (held on its posed head each frame: its game's constraint holds them to its head at rest, unposed, here)
			VER.eyes.Anchored = true
			for _, rig in ipairs(VER.eyes:GetChildren()) do
				if rig:IsA("Constraint") then rig.Enabled = false end
			end
		end
	end
	-- Where its head is, its eyes, its horns (as they would be: its posed bones)
	function VER.head() return gait:posedCFrame(Gait.HEAD_CHAIN) end
	local function approachDir(a, b, k)
		local angle = math.acos(math.clamp(a:Dot(b), -1, 1))
		if angle < 0.001 then return b end
		local axis = a:Cross(b)
		return CFrame.fromAxisAngle(if axis.Magnitude > 1e-5 then axis.Unit else up, angle * k):VectorToWorldSpace(a)
	end
	local function stepDir(a, b, most)
		local angle = math.acos(math.clamp(a:Dot(b), -1, 1))
		if angle <= most then return b end
		local axis = a:Cross(b)
		return CFrame.fromAxisAngle(if axis.Magnitude > 1e-5 then axis.Unit else up, most):VectorToWorldSpace(a)
	end
	local smooth, d1, d2, d3 = nil, nil, nil, nil
	local speed, acc, interval, turnRate = 0, 0, 0, 0
	function VER.place(at, look) -- (straight there: its spawn)
		VER.at, VER.look = at, look
		smooth, d1, d2, d3 = at, look, look, look
		model:PivotTo(CFrame.lookAt(at, at + look))
		if not gait then
			model.Parent = folder
			setup()
		end
	end
	function VER.animate(dt)
		if not (gait and model.Parent and root.Parent) then return end
		local target, look = VER.at, VER.look
		if not smooth or VER.snap or (target - smooth).Magnitude > 12 then
			smooth, d1, d2, d3 = target, look, look, look
			VER.snap = nil
		else
			smooth = smooth:Lerp(target, 1 - math.exp(-26 * dt))
			d1 = approachDir(d1, look, 1 - math.exp(-12 * dt))
			d2 = approachDir(d2, d1, 1 - math.exp(-12 * dt))
		end
		speed += (VER.speed - speed) * (1 - math.exp(-9 * dt))
		local state = VER.state
		if VER.grabAt then -- (its grab: crouched over you, its head rolling, the strobe at 1.95 s)
			local t = os.clock() - VER.grabAt
			gait:SetGrab((t - 0.15) / 1.7)
			gait:SetStrobe(if t >= 1.95 and t < 3 then 1 else 0)
			state = "grab"
		else
			gait:SetStrobe(VER.strobe)
		end
		gait:SetState(state)
		acc += dt
		if acc < interval then return end
		local lookNow = root.CFrame.LookVector
		local step = math.max(acc, 1 / 240)
		d3 = stepDir(d3 or lookNow, d2, step * 4.537856055185257) -- (it turns at most 260 degrees a second)
		root.CFrame = CFrame.lookAt(smooth, smooth + d3, up)
		local yaw = math.atan2(lookNow:Cross(d3).Y, math.clamp(lookNow:Dot(d3), -1, 1)) / step
		turnRate += (math.clamp(yaw, -5, 5) - turnRate) * (1 - math.exp(-step * 3.5))
		if VER.override then -- (a pose not of its gait: out of the TV, Noise's Emerge)
			VER.override(gait.bones)
		else
			gait:Step(acc, VER.prey and VER.prey(), speed, turnRate)
			local blend = VER.blend
			if blend then -- (from that pose into its walk)
				local u = smoothstep((os.clock() - blend.at) / blend.time)
				for name, cf in pairs(blend.from) do
					local bone = gait.bones[name]
					if bone then bone.Transform = cf:Lerp(bone.Transform, u) end
				end
				if u >= 1 then VER.blend = nil end
			end
		end
		local head = gait:posedCFrame(Gait.HEAD_CHAIN)
		local rootAt = root.CFrame
		for _, c in ipairs(VER.cones) do
			if c.motor then
				c.motor.Transform = c.motor.C0:Inverse() * rootAt:Inverse() * (head * c.offset) * c.motor.C1
			else
				c.part.CFrame = head * c.offset
			end
		end
		if VER.limbs then VER.poseLimbs(model, gait) end
		if VER.hull then VER.poseHull(model, gait, VER.hull) end
		if VER.eyes and VER.eyes.Anchored then VER.eyes.CFrame = head * VER.eyesOffset end
		for _, e in ipairs(gait:DrainEvents()) do SFXP.event(e) end
		acc = 0
		-- (stop-motion while it grabs; jerky once it holds its bait pose)
		interval = if VER.grabAt then 0.06 + math.random() * 0.04 elseif state == "bait" and gait.baitTimer >= Gait.CONFIG.baitComposeTime + 0.1 then 0.25 else 0
	end
end

---====== ITS SOUNDS: its game's MonsterSFX (its double footsteps, its presence, its grab) ======---

do
	local pools = {}
	local LIMIT = { Footstep1 = 4, Footstep2 = 4, Footstep3 = 4, Footstep4 = 4 }
	-- One of its sounds on it (a few of each at once at most), its pitch a little different each time
	function SFXP.play(name, jitter, volume, speed)
		local spec = SFX[name]
		if not (spec and VER.root.Parent) then return end
		local pool = pools[name] or {}
		pools[name] = pool
		local s = nil
		for _, one in ipairs(pool) do
			if not one.IsPlaying then s = one break end
		end
		if not s then
			if #pool >= (LIMIT[name] or 3) then return end
			s = make("Sound", { Name = name, SoundId = spec[1], RollOffMode = Enum.RollOffMode.LinearSquare, RollOffMinDistance = spec[4], RollOffMaxDistance = spec[5] }, VER.root)
			table.insert(pool, s)
		end
		s.PlaybackSpeed = spec[3] * (speed or 1) * (1 + (math.random() - 0.5) * 2 * (jitter or 0))
		s.Volume = spec[2] * (volume or 1)
		s:Play()
	end
	function SFXP.stopAll()
		for _, pool in pairs(pools) do
			for _, s in ipairs(pool) do s:Stop() end
		end
	end
	local recent = {}
	local STEPS = { "Footstep1", "Footstep2", "Footstep3", "Footstep4" }
	local function nextStep() -- (not one of the last two)
		local i = math.random(1, #STEPS)
		local tries = 0
		while (i == recent[1] or i == recent[2]) and tries < #STEPS do
			i = i % #STEPS + 1
			tries += 1
		end
		table.insert(recent, 1, i)
		recent[3] = nil
		return STEPS[i]
	end
	local function footstep(run) -- (its heel, then its toes)
		local volume = if run then 1 else 0.68
		SFXP.play(nextStep(), 0.07, volume)
		local second = nextStep()
		task.delay(0.085, function() SFXP.play(second, 0.07, volume * 0.34, 1.28) end)
	end
	-- Its presence: louder the nearer it is (82.5 to 6 studs, squared), silent as a bait
	local loop = sound("loop", { Looped = true, Volume = 0, RollOffMode = Enum.RollOffMode.Linear, RollOffMinDistance = 260, RollOffMaxDistance = 280 }, VER.root)
	SFXP.loop = loop
	local near, live = 0, 1
	function SFXP.presence(dt, distance)
		dt = math.clamp(dt, 0.001, 0.25)
		local bait = VER.state == "bait"
		live = approach(live, if bait then 0 else 1, if bait then 14 else 3.2, dt)
		local k = if distance then math.clamp((82.5 - distance) / 76.5, 0, 1) else 0
		near = approach(near, k * k, 6, dt)
		loop.Volume = 0.9 * near * live
		if not loop.IsPlaying and VER.model.Parent then loop:Play() end
	end
	function SFXP.event(e)
		if e.type == "footfall" then
			footstep(e.run)
		elseif e.type == "hitch" then
			SFXP.play("HitchTick", 0.15, if e.run then 0.5 else 1)
		elseif e.type == "twitch" then
			if math.random() < 0.4 then SFXP.play("HitchTick", 0.25, 0.22) end
		elseif e.type == "detonate" then
			live = 1
			SFXP.play("Detonate", 0.05, 1)
		elseif e.type == "grabStart" then
			SFXP.play("GrabCrack", 0.05, 1)
		end
	end
	-- Its grab, as its game times it: a crack at once and at 1.85 s, its strobe's static at 1.95 s, all of it cut at 2.7 s
	function SFXP.grab()
		local t0 = os.clock()
		local function at(t)
			while alive and os.clock() - t0 < t do task.wait() end
			return alive and VER.grabAt ~= nil
		end
		task.spawn(function()
			if not at(0.3) then return end
			SFXP.play("JointPopLong", 0.05, 1)
			if not at(1.85) then return end
			SFXP.play("GrabCrack", 0.05, 1)
			if not at(1.95) then return end
			SFXP.play("StrobeStatic", 0, 1)
			if not at(2.7) then return end
			SFXP.stopAll()
		end)
	end
end

---====== YOU FEEL IT: its game's MonsterProximityShake (from 20 studs, strongest at 6); its film grain; its grade ======---

local Feel = { distance = nil, on = false }
do
	local t, k, applied, after = 0, 0, CFrame.identity, nil
	local REMOVE, APPLY = "MonochromeShakeRemove", "MonochromeShakeApply"
	RunService:BindToRenderStep(REMOVE, Enum.RenderPriority.Input.Value - 2, function()
		local camera = workspace.CurrentCamera
		if not camera or applied == CFrame.identity then return end
		if after and (camera.CFrame.Position - after.Position).Magnitude < 1e-4 and math.abs(camera.CFrame.LookVector:Dot(after.LookVector) - 1) < 1e-6 then
			camera.CFrame *= applied:Inverse() -- (nothing moved it since: take ours back off)
		end
		applied, after = CFrame.identity, nil
	end)
	RunService:BindToRenderStep(APPLY, Enum.RenderPriority.Last.Value + 1, function(dt)
		local camera = workspace.CurrentCamera
		-- (Roblox's camera, or DOORS' own: it sets it itself, Scriptable, every frame before this)
		if not (camera and (camera.CameraType == Enum.CameraType.Custom or camera.CameraType == Enum.CameraType.Scriptable)) then return end
		dt = math.clamp(dt, 0.001, 0.25)
		t += dt
		local want = 0
		if Feel.on and Feel.distance and not VER.grabAt then
			local s = smoothstep((20 - Feel.distance) / 14)
			want = s * s * (if VER.state == "run" then 1.45 elseif VER.state == "bait" then 0.25 else 1)
		end
		k = approach(k, want, 6, dt)
		if k < 0.0015 then
			k, applied, after = 0, CFrame.identity, nil
			return
		end
		local slow, fast = (k * 0.35 + 1) * 6.5, (k * 0.35 + 1) * 16
		local function wobble(seed) return math.noise(t * slow, seed) * 0.72 + math.noise(t * fast, seed + 31.7) * 0.28 end
		local deg = math.pi / 180
		local shake = CFrame.new(wobble(41.3) * 0.012 * k, wobble(57.7) * 0.012 * k, 0)
			* CFrame.Angles(wobble(1.3) * 0.3 * deg * k, wobble(7.9) * 0.3 * deg * k, wobble(19.1) * 0.2 * deg * k)
		camera.CFrame *= shake
		applied, after = shake, camera.CFrame
	end)
	later(function()
		RunService:UnbindFromRenderStep(REMOVE)
		RunService:UnbindFromRenderStep(APPLY)
	end)
	-- Its film grain (its game's PixelStatic: grey pixels over everything, 7.5-14%, a new field each frame)
	local grainGui = make("ScreenGui", { Name = "MonochromeGrain", IgnoreGuiInset = true, DisplayOrder = 9100, ResetOnSpawn = false }, screen.Parent)
	later(function() grainGui:Destroy() end)
	local grain = make("ImageLabel", { Name = "Grain", BackgroundTransparency = 1, ImageTransparency = 1, ScaleType = Enum.ScaleType.Tile,
		ResampleMode = Enum.ResamplerMode.Pixelated, TileSize = UDim2.fromOffset(256, 256), Size = UDim2.new(1, 64, 1, 64) }, grainGui)
	local fields = {}
	for i = 1, 4 do
		if LOCAL["Grain" .. i] then table.insert(fields, LOCAL["Grain" .. i]) end
	end
	if #fields == 0 then -- (else its game's own sheet)
		fields = { "rbxassetid://125361618996572" }
		grain.TileSize = UDim2.fromOffset(1024, 1024)
	end
	local show, last = 0, 0
	-- And its game's grade (its HorrorGrade): colder, less colour, more contrast (a little lighter here)
	local grade = make("ColorCorrectionEffect", { Name = "MonochromeGrade", Brightness = 0, Contrast = 0, Saturation = 0, TintColor = Color3.new(1, 1, 1) }, Lighting)
	later(function() grade:Destroy() end)
	local graded = 0
	-- (White's: paler, greyer; Glitch's: a little purple)
	local GRADE = if VARIANT == "White" then { 0.06, 0.1, -0.7, Color3.fromRGB(236, 236, 240) }
		elseif VARIANT == "Glitch" then { 0.02, 0.08, -0.15, Color3.fromRGB(222, 206, 236) } else { 0.03, 0.06, -0.28, Color3.fromRGB(206, 216, 232) }
	function Feel.step(dt)
		show = approach(show, if Feel.on then 1 else 0, 2, dt)
		if show < 0.01 then
			grain.ImageTransparency = 1
		else
			local i = math.random(1, #fields)
			if #fields > 1 and i == last then i = i % #fields + 1 end
			last = i
			grain.Image = fields[i]
			grain.Position = UDim2.fromOffset(-math.random(0, 64), -math.random(0, 64))
			grain.ImageTransparency = 1 - (0.075 + 0.065 * (0.5 + 0.5 * math.noise(t * 0.27, 0.5))) * show
		end
		graded = approach(graded, if Feel.on then 1 else 0, 1.2, dt)
		grade.Brightness, grade.Contrast, grade.Saturation = GRADE[1] * graded, GRADE[2] * graded, GRADE[3] * graded -- (its game's, a little lighter)
		grade.TintColor = Color3.new(1, 1, 1):Lerp(GRADE[4], graded)
	end
end

---====== ITS KILL: its game's MonsterKillCut (its face filling your screen, every other sound gone, its scream, the snap) ======---

local Scare = {}
do
	local scream = sound("scare", { Name = "MonsterKillScare1", Volume = 2.4, RollOffMode = Enum.RollOffMode.Linear }, SoundService)
	local snap = sound("snap", { Name = "MonsterKillSnap", Volume = 3.2, RollOffMode = Enum.RollOffMode.Linear }, SoundService)
	local ours = { [scream] = true, [snap] = true }
	task.spawn(function() pcall(function() ContentProvider:PreloadAsync({ scream, snap }) end) end)
	-- Every other sound silent (and those that start), each back to its own volume after
	local roots = { workspace, SoundService, ReplicatedStorage, LocalPlayer }
	local muted, hooks, ticker = {}, {}, nil
	local function silence(s)
		if ours[s] or not (s:IsA("Sound") or s:IsA("SoundGroup")) then return end
		if muted[s] == nil then muted[s] = s.Volume end
		if s.Volume ~= 0 then s.Volume = 0 end
	end
	function Scare.hush()
		table.clear(muted)
		for _, r in ipairs(roots) do
			for _, d in ipairs(r:GetDescendants()) do silence(d) end
			table.insert(hooks, r.DescendantAdded:Connect(silence))
		end
		local acc = 0
		ticker = RunService.Heartbeat:Connect(function(dt)
			acc += dt
			if acc < 0.1 then return end
			acc = 0
			for s in pairs(muted) do
				if s.Parent then silence(s) end
			end
		end)
	end
	function Scare.unhush()
		if ticker then ticker:Disconnect() end
		ticker = nil
		for _, c in ipairs(hooks) do c:Disconnect() end
		table.clear(hooks)
		for s, volume in pairs(muted) do
			if s.Parent then pcall(function() s.Volume = volume end) end
		end
		table.clear(muted)
	end
	later(Scare.unhush)
	-- Its face: a copy of it in a viewport, crouched in its grab pose, its eyes on you
	local gui, camera, eye, dir = nil, nil, nil, nil
	local function build()
		if gui then return true end
		local ok = pcall(function()
			local head = VER.head()
			local offsets = {}
			for _, name in ipairs({ "Eyes", "Cone", "Cone.001" }) do
				local p = VER.model:FindFirstChild(name)
				if p then
					offsets[name] = head:ToObjectSpace(p.CFrame)
					if name ~= "Eyes" then offsets[name] = CFrame.new(0, 0.025, 0) * offsets[name] end
				end
			end
			if VER.eyes and not VER.eyes.Anchored then offsets.Eyes = VER.eyesOffset end -- (its eyes as its head holds them)
			local g = make("ScreenGui", { Name = "MonsterKillScareView", IgnoreGuiInset = true, DisplayOrder = 100006, ResetOnSpawn = false, Enabled = false }, screen.Parent)
			local back = if VARIANT == "White" then Color3.fromRGB(236, 236, 236) elseif VARIANT == "Glitch" then Color3.fromRGB(20, 14, 38) else Color3.fromRGB(10, 10, 12)
			local view = make("ViewportFrame", { Name = "Scare", Size = UDim2.fromScale(1, 1), BackgroundColor3 = back, BorderSizePixel = 0,
				Ambient = Color3.new(1, 1, 1), LightColor = Color3.new(1, 1, 1), LightDirection = Vector3.new(0, -0.3, -1) }, g)
			local copy = VER.model:Clone()
			for _, d in ipairs(copy:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = true
					-- (black on black would leave only its eyes: a dark grey, lit, so its shape is seen round them)
					if VARIANT ~= "White" and VARIANT ~= "Glitch" and d.Transparency < 0.99 then d.Material, d.Color = Enum.Material.SmoothPlastic, Color3.fromRGB(40, 40, 46) end
				end
			end
			copy.Parent = view
			local cam = make("Camera", { FieldOfView = 70 }, view)
			view.CurrentCamera = cam
			local eyes = copy:FindFirstChild("Eyes")
			local face = eyes and eyes:FindFirstChildWhichIsA("SurfaceGui")
			local pair = face and face:FindFirstChildWhichIsA("ImageLabel")
			local image = if pair then pair.Image else "rbxassetid://92865588300030"
			if face then face:Destroy() end
			eyes.Transparency = 1
			make("Decal", { Name = "EyeDecal", Texture = image, Face = Enum.NormalId.Front, Color3 = if pair then pair.ImageColor3 else Color3.new(1, 1, 1) }, eyes)
			local g2 = Gait.new(copy)
			g2:SetState("grab")
			g2:SetGrab(0)
			local target = (copy:FindFirstChild("RootPart").CFrame * CFrame.new(0, g2.rest.Head.Position.Y, -12)).Position
			for i = 1, 120 do
				g2:Step(1 / 60, target, 0, 0)
				if i % 12 == 0 then RunService.Heartbeat:Wait() end
			end
			local posed = g2:posedCFrame(Gait.HEAD_CHAIN)
			for name, offset in pairs(offsets) do
				local p = copy:FindFirstChild(name)
				if p then p.CFrame = posed * offset end
			end
			if VER.limbs then VER.poseLimbs(copy, g2) end -- (ours: its limbs where its bones are, in its grab)
			if VER.hull then VER.poseHull(copy, g2) end -- (its shape, in its grab)
			local at = eyes.CFrame
			eye = at.Position + Vector3.new(0, 0.14, 0)
			local look = flat(at.LookVector)
			dir = (if look.Magnitude > 0.001 then look.Unit else Vector3.new(0, 0, -1))
			eyes.CFrame = CFrame.lookAt(at.Position, at.Position + dir, up) + Vector3.new(0, 0.06, 0)
			eyes.Size = Vector3.new(eyes.Size.X * 0.45, eyes.Size.Y * 0.68, eyes.Size.Z)
			gui, camera = g, cam
		end)
		return ok and gui ~= nil
	end
	Scare.build = build
	later(function() if gui then gui:Destroy() end end)
	-- (if its face cannot be made: its eyes alone, rushing at you out of the black, filling the screen)
	local function flat2D()
		local g = make("ScreenGui", { Name = "MonsterKillScareView", IgnoreGuiInset = true, DisplayOrder = 100006, ResetOnSpawn = false }, screen.Parent)
		local black = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(10, 10, 12), BorderSizePixel = 0 }, g)
		local eyes = make("ImageLabel", { Name = "Eyes", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), BackgroundTransparency = 1,
			Image = if VER.pair then VER.pair.Image else (LOCAL.Eyes or "rbxassetid://92865588300030"), ImageColor3 = if VER.pair then VER.pair.ImageColor3 else Color3.new(1, 1, 1),
			ScaleType = Enum.ScaleType.Fit }, black)
		local t0 = os.clock()
		local c = RunService.RenderStepped:Connect(function()
			local t = os.clock() - t0
			local k = if t < 0.12 then 0.15 + 0.85 * (1 - (1 - t / 0.12) ^ 3) else 1
			eyes.Size = UDim2.fromScale(1.1 * k, 0.55 * k)
			eyes.Position = UDim2.new(0.5, math.noise(t * 6, 1.3) * 8, 0.45, math.noise(t * 6, 7.7) * 8)
		end)
		return function()
			c:Disconnect()
			g:Destroy()
		end
	end
	-- The shot: it rushes at you (5 to 1.4 studs in 0.12 s), and stays, breathing on you. Returns its end
	function Scare.face()
		if not build() then return flat2D() end
		local t0 = os.clock()
		local function frame()
			local t = os.clock() - t0
			local dist = if t < 0.12 then 5 - 3.6 * (1 - (1 - t / 0.12) ^ 3) else 1.4
			local function wobble(seed) return math.noise(t * 0.85, seed) end
			local deg = math.pi / 180
			camera.CFrame = CFrame.lookAt(eye + dir * dist, eye, up) * CFrame.new(wobble(1.7) * 0.0025, wobble(9.3) * 0.0025, 0)
				* CFrame.Angles(wobble(21.1) * 0.3 * deg, wobble(37.9) * 0.3 * deg, wobble(53.3) * 0.18 * deg)
		end
		frame()
		gui.Enabled = true
		local c = RunService.RenderStepped:Connect(frame)
		local ended = false
		return function()
			if ended then return end
			ended = true
			c:Disconnect()
			gui.Enabled = false
		end
	end
	-- Its scream (its own, else ours: loaded or not, it plays)
	function Scare.scream()
		pcall(function()
			scream.TimePosition = 0
			scream.Volume = 2.4
			scream:Play()
		end)
		return if scream.TimeLength > 0 then scream.TimeLength else 1.76
	end
	function Scare.snap()
		pcall(function()
			snap.TimePosition = 0
			snap.Volume = 3.2
			snap:Play()
		end)
	end
	function Scare.quiet() scream:Stop() end
	-- A phantom: its face for a second, its scream, and it is gone (it never touched you)
	local phantom = false
	function Scare.phantom()
		if phantom or VER.grabAt then return end
		phantom = true
		task.spawn(function()
			local close = Scare.face()
			Scare.hush()
			Scare.scream()
			wait(1)
			Scare.quiet()
			Scare.unhush()
			close()
			SFXP.play("StrobeStaticShort", 0.05, 0.6)
			phantom = false
		end)
	end
end

---====== THE RADAR: its game's dial (rings, ticks, the sweep and its tail, the blip), a real radar on your screen ======---

-- In DOORS' hotbar (hold it) or on R: the dial, heading up (ahead of you is up), 75 studs across its rings (25, 50, 75).
-- The sweep goes round (120 degrees a second, as its game's); where it passes VER a blip lights up and fades, with a ping
-- (higher, nearer) and its distance; past 75 studs a mark on the rim shows which way it is.
local Radar = { open = false }
do
	local WHITE, GLASS = Color3.fromRGB(233, 231, 224), Color3.fromRGB(12, 13, 14)
	local RANGE, SIZE = 75, 368 -- (studs to the rim; the dial's pixels, as its game draws it)
	local ping = sound("ping", { Name = "RadarPing", Volume = 0.55 }, SoundService)
	local gui = make("ScreenGui", { Name = "MonochromeRadar", IgnoreGuiInset = true, DisplayOrder = 9150, ResetOnSpawn = false, Enabled = false }, screen.Parent)
	later(function() gui:Destroy() end)
	-- The device: a dark case round its glass, bottom right
	local case = make("Frame", { Name = "Case", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, 40), Size = UDim2.fromOffset(SIZE + 36, SIZE + 70),
		BackgroundColor3 = Color3.fromRGB(30, 31, 30), BorderSizePixel = 0 }, gui)
	make("UICorner", { CornerRadius = UDim.new(0, 22) }, case)
	make("UIStroke", { Thickness = 3, Color = Color3.fromRGB(70, 72, 70) }, case)
	make("UIScale", { Scale = 0.62 }, case)
	local label = make("TextLabel", { Name = "Readout", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, SIZE + 26), Size = UDim2.fromOffset(SIZE, 30),
		BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 26, TextColor3 = WHITE, Text = "VER  --" }, case)
	local glass = make("Frame", { Name = "Glass", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 18), Size = UDim2.fromOffset(SIZE, SIZE),
		BackgroundColor3 = GLASS, BorderSizePixel = 0, ClipsDescendants = false }, case)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, glass)
	local face = make("Frame", { Name = "Face", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(SIZE, SIZE),
		BackgroundTransparency = 1 }, glass)
	local function ring(scale, thickness, transparency)
		local f = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(scale, scale), BackgroundTransparency = 1 }, face)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, f)
		make("UIStroke", { Thickness = thickness, Color = WHITE, Transparency = transparency }, f)
	end
	local function bar(w, h, x, y, rotation, transparency, parent)
		return make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, x, 0.5, y), Size = UDim2.fromOffset(w, h), BackgroundColor3 = WHITE,
			BackgroundTransparency = transparency, BorderSizePixel = 0, Rotation = rotation }, parent or face)
	end
	ring(1, 2, 0.02)
	ring(0.66, 1, 0.55)
	ring(0.34, 1, 0.55)
	bar(1, SIZE, 0, 0, 0, 0.72)
	bar(SIZE, 1, 0, 0, 0, 0.72)
	for i = 1, 11 do
		local a = math.rad(i * 30)
		bar(2, 20, math.sin(a) * 165.6, -math.cos(a) * 165.6, i * 30, 0.45)
	end
	bar(2, 184, 0, -92, 0, 0.25)
	for k, studs in ipairs({ 25, 50, 75 }) do -- (its rings' distances)
		make("TextLabel", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.5, 4, 0.5, -SIZE / 2 * (k / 3) + 10), Size = UDim2.fromOffset(40, 16),
			BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 14, TextColor3 = WHITE, TextTransparency = 0.45, Text = tostring(studs), TextXAlignment = Enum.TextXAlignment.Left }, face)
	end
	local sweep = make("Frame", { Name = "Sweep", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1 }, face)
	bar(3, 184, 0, -92, 0, 0, sweep)
	local tail = sweep
	for i = 1, 9 do -- (its fading tail)
		local f = make("Frame", { Name = ("Tail%02d"):format(i), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1, Rotation = -4.5 }, tail)
		bar(3, 184, 0, -92, 0, (i / 9) ^ 0.8 * 0.7 + 0.3, f)
		tail = f
	end
	local hub = bar(7, 7, 0, 0, 0, 0)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, hub)
	local contact = bar(15, 15, 0, 0, 0, 1)
	contact.Name = "Contact"
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, contact)
	local rim = bar(10, 16, 0, 0, 0, 1) -- (the mark on its rim: farther than 75)
	rim.Name = "Rim"
	Radar.gui, Radar.contact, Radar.rim, Radar.readout = gui, contact, rim, label
	local angle, blipAt, blipX, blipY, blipHigh = 0, -math.huge, 0, 0, false
	local shown = 0
	local function setOpen(open)
		Radar.open = open
		if open then gui.Enabled = true end
	end
	-- In DOORS' hotbar: holding it shows it
	local tool = make("Tool", { Name = "Radar", TextureId = "rbxassetid://96656899828988", RequiresHandle = true, CanBeDropped = false,
		ToolTip = "Radar: VER, when it is near" }, nil)
	make("Folder", { Name = "Animations" }, tool) -- (DOORS' inventory loads an item's animations from it)
	make("Part", { Name = "Handle", Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, CanCollide = false, Massless = true }, tool)
	tool.Parent = LocalPlayer:FindFirstChildOfClass("Backpack")
	later(function() tool:Destroy() end)
	on(tool.Equipped, function() setOpen(true) end)
	on(tool.Unequipped, function() setOpen(false) end)
	-- R: on and off (in your hand or not)
	pcall(function()
		ContextActionService:BindAction("MonochromeRadar", function(_, state)
			if state ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
			setOpen(not Radar.open)
			return Enum.ContextActionResult.Pass
		end, false, Enum.KeyCode.R, Enum.KeyCode.ButtonL1)
	end)
	later(function() pcall(function() ContextActionService:UnbindAction("MonochromeRadar") end) end)
	on(RunService.RenderStepped, function(dt)
		dt = math.clamp(dt, 0.001, 0.25)
		shown = math.clamp(shown + (if Radar.open then dt else -dt) / 0.3, 0, 1)
		case.Position = UDim2.new(1, -24, 1, 40 + (1 - smoothstep(shown)) * (SIZE + 120))
		if shown <= 0 then
			gui.Enabled = false
			return
		end
		gui.Enabled = true
		local cam = workspace.CurrentCamera
		local _, _, me = body()
		if not (cam and me) then return end
		local before = angle
		angle = (angle + dt * 120) % 360
		sweep.Rotation = angle
		local look = flat(cam.CFrame.LookVector)
		look = if look.Magnitude > 0.001 then look.Unit else Vector3.new(0, 0, -1)
		local here = VER.model.Parent and VER.root
		rim.BackgroundTransparency = 1
		if here then
			local offset = VER.root.Position - me.Position
			local planar = flat(offset)
			local ahead, right = planar:Dot(look), planar:Dot(look:Cross(up))
			local bearing = math.deg(math.atan2(right, ahead)) % 360
			local passed = if before <= angle then before < bearing and bearing <= angle else bearing > before or bearing <= angle
			if planar.Magnitude <= RANGE then
				if passed then
					local x, y = right / RANGE, ahead / RANGE
					blipX, blipY, blipHigh, blipAt = x * SIZE / 2, -y * SIZE / 2, math.abs(offset.Y) > 10, os.clock()
					label.Text = ("VER  %d studs%s"):format(math.floor(planar.Magnitude + 0.5), if blipHigh then (if offset.Y > 0 then "  ABOVE" else "  BELOW") else "")
					pcall(function()
						ping.PlaybackSpeed = 1.75 ^ (1 - math.clamp(planar.Magnitude / RANGE, 0, 1)) * 0.8
						ping.TimePosition = 0
						ping:Play()
					end)
				end
			else
				local r = math.rad(bearing)
				rim.Position = UDim2.new(0.5, math.sin(r) * (SIZE / 2 - 6), 0.5, -math.cos(r) * (SIZE / 2 - 6))
				rim.Rotation = bearing
				rim.BackgroundTransparency = 0.35
				if passed then label.Text = ("VER  %d studs  (out of range)"):format(math.floor(planar.Magnitude + 0.5)) end
			end
		elseif os.clock() - blipAt > 3 then
			label.Text = "VER  --"
		end
		local fade = 1 - math.clamp((os.clock() - blipAt) / 3, 0, 1)
		fade *= fade
		if fade <= 0.01 then
			contact.BackgroundTransparency = 1
		else
			contact.BackgroundTransparency = 1 - fade * (if blipHigh then 0.42 else 0.98)
			contact.Position = UDim2.new(0.5, blipX, 0.5, blipY)
		end
	end)
end

---====== WHERE IT GOES: DOORS' rooms (its paths through them, else the rooms' own nodes, as DOORS' entities go) ======---

local Nav = { points = nil, index = 1, goal = nil, plannedAt = -100, planning = false }
do
	local function reverse(list)
		local out = {}
		for i = #list, 1, -1 do table.insert(out, list[i]) end
		return out
	end
	-- Through the rooms' nodes, from the room it is in to the room of `to`, then to it
	local function route(from, to)
		local a, b = W.roomOf(from), W.roomOf(to)
		local pts = {}
		if a and b and a ~= b then
			local step = if a < b then 1 else -1
			for n = a, b, step do
				local room = W.room(n)
				if room then
					local list = W.points(room)
					if step < 0 then list = reverse(list) end
					if n == a then -- (from the node nearest it on, not back to where its room starts)
						local nearest, best = 1, math.huge
						for i, p in ipairs(list) do
							if (p - from).Magnitude < best then nearest, best = i, (p - from).Magnitude end
						end
						if list[nearest + 1] and (from - list[nearest + 1]).Magnitude < (list[nearest] - list[nearest + 1]).Magnitude then nearest += 1 end
						for i = nearest, #list do table.insert(pts, list[i]) end
					else
						for _, p in ipairs(list) do table.insert(pts, p) end
					end
				end
			end
		end
		table.insert(pts, to)
		return pts
	end
	local agent = { AgentRadius = 2, AgentHeight = 6.5, AgentCanJump = false, AgentCanClimb = false, WaypointSpacing = 4 }
	local function plan(from, to)
		local ok, pts = pcall(function()
			local path = PathfindingService:CreatePath(agent)
			path:ComputeAsync(from + up * 2.5, to + up * 2.5)
			if path.Status ~= Enum.PathStatus.Success then return nil end
			local out = {}
			for _, w in ipairs(path:GetWaypoints()) do table.insert(out, w.Position) end
			return if #out > 0 then out else nil
		end)
		return if ok and pts then pts else route(from, to)
	end
	-- Go to `to` (its path planned again when `to` moves, at most every `every` seconds)
	function Nav.go(to, every)
		if Nav.planning then return end
		local stale = os.clock() - Nav.plannedAt > (every or 2)
		if Nav.goal and (Nav.goal - to).Magnitude < 3 and Nav.points and not stale then return end
		Nav.planning = true
		Nav.goal = to
		task.spawn(function()
			local pts = plan(VER.at, to)
			Nav.points, Nav.index, Nav.plannedAt, Nav.planning = pts, 1, os.clock(), false
		end)
	end
	-- Straight at it (nothing in the way, near enough): no path
	function Nav.direct(to)
		Nav.points, Nav.index, Nav.goal, Nav.plannedAt = { to }, 1, to, os.clock()
	end
	function Nav.stop() Nav.points, Nav.goal = nil, nil end
	-- Along its path, `speed` studs a second: true when it is there
	function Nav.step(dt, speed)
		local pts = Nav.points
		if not pts then return true end
		local left = speed * dt
		while left > 0 and Nav.index <= #pts do
			local target = pts[Nav.index]
			local d = flat(target - VER.at)
			if d.Magnitude <= left then
				VER.at = Vector3.new(target.X, VER.at.Y, target.Z)
				left -= d.Magnitude
				Nav.index += 1
			else
				VER.at += d.Unit * left
				VER.look = d.Unit
				left = 0
			end
			if d.Magnitude > 0.05 then VER.look = d.Unit end
		end
		-- On the floor under it
		local floor = W.floor(VER.at + up * 2)
		if math.abs(floor.Y - VER.at.Y) < 3 then VER.at = Vector3.new(VER.at.X, approach(VER.at.Y, floor.Y, 14, dt), VER.at.Z) end
		return Nav.index > #pts
	end
end

---====== WHERE IT COMES OUT: THE NEXT DOOR (in its doorway, on your side, facing you; far enough from you) ======---

local function nextDoor(minimum)
	local _, _, me = body()
	if not me then return nil end
	local here = W.here() or W.roomOf(me.Position)
	if here then
		local best = nil
		for n = here, here + 3 do
			local room = W.room(n)
			local exit = room and select(2, W.ends(room))
			local forward = room and W.forward(room)
			if exit and forward then
				local at = W.floor(exit.Position - forward * 3.5 + up * 2)
				best = { at = at, look = -forward, room = n }
				if flat(at - me.Position).Magnitude >= (minimum or 24) then return best end
			end
		end
		if best then return best end
	end
	-- (no rooms: 30 studs ahead of you, facing you)
	local camera = workspace.CurrentCamera
	local look = flat(camera.CFrame.LookVector)
	look = if look.Magnitude > 0.1 then look.Unit else Vector3.new(0, 0, -1)
	local at = W.floor(me.Position + look * 30 + up * 2)
	return { at = at, look = -look }
end

---====== ITS MIND (its game's server is not saved; this is it as its game and its briefing tell it) ======---

-- How fast it goes (studs a second): it walks slowly (its gait's own walk is 6.6); it runs a little slower than you
local SPEED = { hunt = 6, search = 5.5, patrol = 5, check = 6.5, leave = 6, chaseBelow = 1.5, chaseMin = 10, chaseMax = 13.5 }
local Brain = { mode = "wake", since = os.clock(), born = os.clock(), lastSeen = -100, known = nil, baited = -100, relocations = 0, contact = os.clock() }
local function toward(p) -- (its way to a point, flat; as it was, if it is on it)
	local d = flat(p - VER.at)
	return if d.Magnitude > 0.1 then d.Unit else VER.look
end
do
	local rng = Random.new()
	local function setMode(mode)
		Brain.mode, Brain.since = mode, os.clock()
		Nav.stop()
	end
	Brain.set = setMode
	function VER.prey() -- (its head on you when it knows where you are)
		local m = Brain.mode
		if m == "chase" or m == "bait" or m == "grab" or m == "check" or (Brain.sees and m ~= "leave") then
			local character = LocalPlayer.Character
			local head = character and character:FindFirstChild("Head")
			return head and head.Position
		end
		return nil
	end
	-- Its eyes and ears
	local function perceive(me)
		local character = LocalPlayer.Character
		local headAt = VER.head().Position
		local mine = (character and character:FindFirstChild("Head") or me).Position
		local d = (mine - headAt).Magnitude
		local dark = Lamps.state ~= "on"
		local range = if dark and not holdingLight() then 55 else 110
		local toMe = flat(mine - headAt)
		local facing = d < 14 or (toMe.Magnitude > 0.1 and toMe.Unit:Dot(VER.look) > -0.15)
		local sees = not hiding() and d < range and facing and W.clear(headAt, mine)
		local hears = false
		local moving = flat(me.AssemblyLinearVelocity).Magnitude
		if not hiding() and moving > 3 then
			hears = (me.Position - VER.at).Magnitude < 34 * math.clamp(moving / 15, 0.35, 1.3) * (if dark then 1.15 else 1)
		end
		return sees, hears, d
	end
	local function twitch(seconds) -- (its joints: a hitch, a pop, its upper body jerking)
		task.spawn(function()
			local t0 = os.clock()
			SFXP.play("JointPopLong", 0.05, 0.9)
			while alive and os.clock() - t0 < seconds do
				SFXP.play("HitchTick", 0.15, 1)
				if rng:NextNumber() < 0.5 then SFXP.play("JointPopShort", 0.1, 0.7) end
				VER.strobe = 0.6
				task.wait(rng:NextNumber(0.08, 0.16))
				VER.strobe = 0
				task.wait(rng:NextNumber(0.25, 0.7))
			end
			VER.strobe = 0
		end)
	end
	Brain.twitch = twitch
	-- It saw you: as a bait (far, not lately: still and silent, then it bursts), else it runs at once
	local function spot(d)
		if Brain.mode == "chase" or Brain.mode == "bait" then return end
		Brain.contact = os.clock()
		if d > 26 and os.clock() - Brain.baited > 25 and rng:NextNumber() < 0.6 then
			Brain.baited = os.clock()
			setMode("bait")
			Brain.baitFor = rng:NextNumber(1.2, 2.8)
		else
			setMode("chase")
		end
	end
	local function wander(around, radius) -- (a point of the rooms near `around`)
		local pts = {}
		for _, room in ipairs(W.rooms()) do
			for _, p in ipairs(W.points(room)) do
				if (p - around).Magnitude < radius then table.insert(pts, p) end
			end
		end
		if #pts == 0 then return W.floor(around + Vector3.new(rng:NextNumber(-8, 8), 2, rng:NextNumber(-8, 8))) end
		return pts[rng:NextInteger(1, #pts)]
	end
	local function farthest(from) -- (the point of the rooms farthest from you: where it goes when it gives up)
		local best, far = nil, -1
		for _, room in ipairs(W.rooms()) do
			for _, p in ipairs(W.points(room)) do
				if (p - from).Magnitude > far then best, far = p, (p - from).Magnitude end
			end
		end
		return best
	end
	local hidingSince, spotted = nil, false
	-- One look at the world (every 0.1 s): what it does now
	function Brain.think(me)
		local now = os.clock()
		local m = Brain.mode
		local sees, hears, d = perceive(me)
		Brain.sees, Brain.d = sees, d
		if sees then
			Brain.lastSeen = now
			Brain.known = me.Position
		end
		-- You hid: did it see you go in?
		if hiding() then
			if not hidingSince then
				hidingSince = now
				spotted = now - Brain.lastSeen < 1.5 and m ~= "leave" and m ~= "wake"
				if spotted then
					Brain.closet = W.hidingSpot(me.Position)
					setMode("check")
				elseif m == "chase" or m == "bait" then
					setMode("search")
				end
			end
		else
			hidingSince = nil
		end
		m = Brain.mode
		if m == "wake" then
			VER.state, VER.speed = "idle", 0
			VER.look = toward(me.Position)
			if now - Brain.since > (Brain.wakeFor or 3.4) then
				VER.model:SetAttribute("Awake", true)
				Brain.known = me.Position -- (it heard you: it knows that somebody is down here)
				setMode("hunt")
			end
		elseif m == "hunt" then
			VER.state, VER.speed = "walk", SPEED.hunt
			if sees then return spot(d) end
			if hears then Brain.known = me.Position + Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4)) end
			Nav.go(Brain.known or me.Position, 3)
			if Nav.goal and Nav.index > #(Nav.points or {}) and flat(VER.at - Nav.goal).Magnitude < 3 then setMode("search") end
		elseif m == "bait" then
			VER.state, VER.speed = "bait", 0
			VER.look = toward(me.Position)
			if now - Brain.since > Brain.baitFor then setMode("chase") end
		elseif m == "chase" then
			VER.state = "run"
			local _, humanoid = body()
			VER.speed = math.clamp((humanoid and humanoid.WalkSpeed or 15) - SPEED.chaseBelow, SPEED.chaseMin, SPEED.chaseMax)
			local target = if sees then me.Position else Brain.known
			if sees and d < 30 and W.clear(VER.at + up * 2.5, me.Position) then Nav.direct(me.Position) else Nav.go(target, 0.4) end
			if now - Brain.lastSeen > 5 then setMode("search") end
		elseif m == "search" then
			VER.state, VER.speed = "walk", SPEED.search
			if sees then
				Brain.baited = now -- (no bait now: it knows you are here)
				return spot(0)
			end
			if hears then Brain.known = me.Position end
			if not Nav.points or Nav.index > #Nav.points then Nav.go(wander(Brain.known or VER.at, 22), 99) end
			if now - Brain.since > 11 then setMode("patrol") end
		elseif m == "patrol" then
			VER.state, VER.speed = "walk", SPEED.patrol
			if sees then return spot(d) end
			if hears then
				Brain.known = me.Position
				return setMode("hunt")
			end
			if not Nav.points or Nav.index > #Nav.points then Nav.go(wander(me.Position, 60), 99) end
			if now - Brain.contact > 45 then setMode("leave") end
		elseif m == "check" then -- (to the wardrobe you went into; it stands there, listening)
			local closet = Brain.closet
			local at = if closet then closet:GetPivot().Position else Brain.known or me.Position
			local front = W.floor(at - toward(at) * 3.6 + up * 2)
			if not Brain.arrived then
				VER.state, VER.speed = "walk", SPEED.check
				Nav.go(front, 1)
				if (flat(VER.at - front)).Magnitude < 2 then
					Brain.arrived = now
					twitch(1.2)
				end
			else
				VER.state, VER.speed = "idle", 0
				Nav.stop()
				VER.look = toward(at)
				if now - Brain.arrived > 1.6 then
					Brain.arrived = nil
					if hiding() and rng:NextNumber() < 0.35 then return Brain.grab(me) end -- (it found you)
					if hiding() and rng:NextNumber() < 0.5 then Scare.phantom() end -- (it threw it off: it was only looking)
					Brain.known = wander(VER.at, 40)
					setMode("search")
				end
			end
			if not hiding() and sees then
				Brain.arrived = nil
				setMode("chase")
			end
		elseif m == "leave" then -- (it gives up: away from you, into the dark, gone)
			VER.state, VER.speed = "walk", SPEED.leave
			if not Brain.away then Brain.away = farthest(me.Position) or VER.at end
			Nav.go(Brain.away, 99)
			local outOfSight = not sees and d > 40
			if (now - Brain.since > 6 and outOfSight) or now - Brain.since > 14 then Brain.gone() end
			if sees and d < 10 then
				Brain.away = nil
				setMode("chase")
			end
		end
		-- Caught: near, nothing between, you not hidden (and not in its first seconds)
		if m ~= "wake" and m ~= "leave" and m ~= "grab" and not hiding() and now - Brain.born > 6 then
			local gap = flat(me.Position - VER.at).Magnitude
			if gap < 4.8 and math.abs(me.Position.Y - VER.at.Y) < 6.5 and W.clear(VER.at + up * 3, me.Position) then return Brain.grab(me) end
		end
		-- You got ahead of it: it comes back out of the dark at the next door
		if (m == "patrol" or m == "search" or m == "hunt") and Brain.relocations < 4 then
			local mine, its = W.roomOf(me.Position), W.roomOf(VER.at)
			if (mine and its and mine >= its + 2) or d > 150 then Brain.relocate() end
		end
		-- Now and then it cuts the lights down where you are (short)
		if now >= (Brain.nextDim or now + 1) and m ~= "leave" and m ~= "wake" then
			Lamps.blackout(me.Position, rng:NextNumber(4, 7))
			Brain.nextDim = now + rng:NextNumber(60, 95)
		end
		Brain.nextDim = Brain.nextDim or now + rng:NextNumber(45, 70)
		-- It hunts long enough, then it goes
		if now - Brain.born > 300 and m ~= "leave" and m ~= "grab" and m ~= "chase" then setMode("leave") end
	end
end

