do
	local model = kit and kit.radar
	local WHITE = Color3.fromRGB(233, 231, 224)
	local ping = sound("ping", { Name = "RadarPing", Volume = 0.55 }, SoundService)
	local camera = workspace.CurrentCamera
	local height = math.tan(math.rad(camera.FieldOfView) / 2) * 0.372 -- (how big it is: as its game holds it, at 0.6 in front of you)
	local unit, main, glass, dialAt
	pcall(function()
		if not model then -- (no kit: one like it)
			model = make("Model", { Name = "radar" }, nil)
			make("Part", { Name = "Cube", Size = Vector3.new(0.5591, 2.1921, 2.00001), Color = Color3.fromRGB(46, 48, 44), Material = Enum.Material.Metal }, model)
		end
		unit = model
		unit.Name = "RadarUnit"
		for _, d in ipairs(unit:GetDescendants()) do
