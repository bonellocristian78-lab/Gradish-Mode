			return
		end
		local low = bar.CFrame:PointToWorldSpace(Vector3.new(0, -bar.Size.Y / 2, 0))
		local high = bar.CFrame:PointToWorldSpace(Vector3.new(0, bar.Size.Y / 2, 0)) + Vector3.new(0, gap, 0)
		base.CFrame = cf + Vector3.new(0, gap, 0)
		local along = (high - low).Unit
		local right = bar.CFrame.RightVector
		right = (right - along * right:Dot(along)).Unit
		bar.Size = Vector3.new(bar.Size.X, (high - low).Magnitude, bar.Size.Z)
		bar.CFrame = CFrame.fromMatrix((high + low) / 2, right, along)
	end
	-- Above the next door, facing into the room (its arm clear of the wall); with no door, above the way ahead of you
	local function place(spot)
		local room = spot.room and W.room(spot.room)
		local exit = room and select(2, W.ends(room))
		local box, size = tv:GetBoundingBox()
		local back = main.CFrame:PointToObjectSpace(box.Position).Z + size.Z / 2
		local at = if exit then exit.Position + up * (exit.Size.Y / 2 + 1.9) + spot.look * (back + 1.1) else spot.at + up * 9.5
		tv:PivotTo(CFrame.lookAt(at, at + spot.look))
		hang()
		tv.Parent = folder
	end
	-- Its screen: the kit's (on; its own video off: it is another), our picture on it, its lights; static on it
	local function dress()
		gui = glass:FindFirstChildWhichIsA("SurfaceGui") or make("SurfaceGui", { Name = "VideoGui", Face = Enum.NormalId.Front }, glass)
		gui.Enabled, gui.LightInfluence = true, 0
		for _, video in ipairs(gui:GetChildren()) do
			if video:IsA("VideoFrame") then video:Destroy() end
		end
		picture = make("ImageLabel", { Name = "Tape", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 2 }, gui)
		for _, light in ipairs(glass:GetDescendants()) do
			if light:IsA("Light") then
				light.Enabled, light.Color, light.Brightness = true, Color3.fromRGB(220, 224, 232), 0.35
				table.insert(lights, light)
			end
		end
		for i = 1, 4 do
			if LOCAL["Grain" .. i] then table.insert(fields, LOCAL["Grain" .. i]) end
		end
		if #fields == 0 then fields = { "rbxassetid://125361618996572" } end -- (its game's static)
		local ids = {}
		for i = 1, TAPE.sheets do table.insert(ids, LOCAL[("Tape_%02d"):format(i)]) end
		task.spawn(function() pcall(function() ContentProvider:PreloadAsync(ids) end) end) -- (its tape ready before it plays)
	end
	local function glow(k)
		for _, light in ipairs(lights) do light.Brightness = k end
	end
	local function static(k) -- (a field of static, `k` bright)
		picture.Image = fields[math.random(1, #fields)]
		picture.ImageRectSize = Vector2.new(160, 96)
		picture.ImageRectOffset = Vector2.new(math.random(0, 90), math.random(0, 150))
		picture.ImageColor3 = Color3.new(k, k, k)
		glow(0.2 + 0.15 * k * math.random())
	end
	local function sheetFrame(index) -- (a picture of the tape, out of its sheets)
		local per = TAPE.columns * TAPE.rows
		local inSheet = index % per
		picture.Image = LOCAL[("Tape_%02d"):format(math.floor(index / per) + 1)] or ""
		picture.ImageRectSize = Vector2.new(TAPE.width, TAPE.height)
		picture.ImageRectOffset = Vector2.new((inSheet % TAPE.columns) * TAPE.width, math.floor(inSheet / TAPE.columns) * TAPE.height)
		picture.ImageColor3 = Color3.new(1, 1, 1)
	end
	-- Its tape, start to end: picture by picture out of its sheets, with its sound
	local function play()
		local audio = nil
		if LOCAL.Tape then
			audio = make("Sound", { Name = "Tape", SoundId = LOCAL.Tape, Volume = 1.3, RollOffMinDistance = 14, RollOffMaxDistance = 140 }, glass)
			audio:Play()
		end
		local sheets = LOCAL.Tape_01 ~= nil
		local t0 = os.clock()
		while alive and os.clock() - t0 < TAPE.length do
			local frame = math.floor((os.clock() - t0) * TAPE.fps)
			if not sheets then
				static(0.8)
			elseif frame < TAPE.frames then
				sheetFrame(frame)
				glow(0.45 + 0.05 * math.random())
			else -- (its last seconds: black, its sound still on)
				picture.Image = ""
				glow(0.05)
			end
			RunService.Heartbeat:Wait()
		end
		if audio then audio:Destroy() end
		picture.Image = ""
	end
	-- The screen bursts: static, a flash, its glass broken; the lamps round it go down
	local function burst()
		glow(0)
		wait(0.6)
		make("Sound", { Name = "Burst", SoundId = SFX.StrobeStatic[1], Volume = 1, RollOffMinDistance = 10, RollOffMaxDistance = 120 }, glass):Play()
		local t0 = os.clock()
		while alive and os.clock() - t0 < 0.55 do
			static(1)
			glow(1.5 + math.random() * 2)
			RunService.Heartbeat:Wait()
		end
		Lamps.blackout(glass.Position, 6)
		Feel.on = true
		gui.Enabled = false
		glow(0)
		glass.Color = Color3.fromRGB(10, 10, 12)
		local broken = main:FindFirstChild("BrokenScreen")
		if broken then
			broken.Transparency = 0
			for _, decal in ipairs(broken:GetDescendants()) do
				if decal:IsA("Decal") then decal.Transparency = 0 end
			end
		end
	end
	-- Out of the screen: Noise's Emerge on VER's bones (its body lying in the screen, crawling out, dropping to the floor in
	-- front, getting up); its root as high as the screen asks, coming down as its body falls (as Noise90's); then into its walk
	local function emerge(spot)
		local look = spot.look
		local ahead = flat(glass.Position) + look * 4.8 -- (Noise's root is 4 studs before its screen; VER is 1.2 Noise)
		local floorY = W.floor(Vector3.new(ahead.X, spot.at.Y + 2, ahead.Z)).Y
		ahead = Vector3.new(ahead.X, floorY, ahead.Z)
		local E = kit and kit.emerge
		local bones = {}
		for _, d in ipairs(VER.model:GetDescendants()) do
			if d:IsA("Bone") then bones[d.Name] = d end
		end
		local rootBone = VER.root:FindFirstChildWhichIsA("Bone")
		local poses, pelvis = {}, {}
		if type(E) == "table" and type(E.frames) == "table" and rootBone and bones.Hips then
			for i, f in ipairs(E.frames) do
				local pose = {}
				for b, name in ipairs(E.bones) do
					local k = 4 + (b - 1) * 4
					pose[name] = CFrame.new(if b == 1 then f[1] else 0, if b == 1 then f[2] else 0, if b == 1 then f[3] else 0, f[k + 1], f[k + 2], f[k + 3], f[k])
				end
				poses[i] = pose
				pelvis[i] = (rootBone.CFrame * bones.Hips.CFrame * pose.Hips).Position.Y
			end
		end
		local top, low = pelvis[1] or 7.5, pelvis[1] or 7.5
		for _, y in ipairs(pelvis) do low = math.min(low, y) end
		local startY = math.max(glass.Position.Y - top, floorY)
		VER.place(ahead + up * (startY - floorY), look)
		SFXP.play("Detonate", 0.05, 0.8)
		Brain.twitch(5)
		if #poses > 1 then
			for _, bone in pairs(bones) do bone.Transform = CFrame.identity end
			local speed, t0, fallen = 1.4, os.clock(), 0 -- (as fast as Noise90's: 8.5 s of it in 6)
			VER.override = function(b)
				local x = math.clamp((os.clock() - t0) * speed * E.fps, 0, #poses - 1)
				local i = math.floor(x)
				local u, j = x - i, math.min(i + 2, #poses)
				for name, cf in pairs(poses[i + 1]) do
					if b[name] then b[name].Transform = cf:Lerp(poses[j][name], u) end
				end
				local y = pelvis[i + 1] + (pelvis[j] - pelvis[i + 1]) * u
				fallen = if top > low then math.max(fallen, math.clamp((top - y) / (top - low), 0, 1)) else 1
				VER.at = ahead + up * ((startY - floorY) * (1 - fallen))
			end
			wait((#poses - 1) / E.fps / speed)
			local from = {}
			for name, bone in pairs(bones) do from[name] = bone.Transform end
			VER.override = nil
			VER.blend = { from = from, at = os.clock(), time = 0.45 }
		else -- (without it: it drops out of the screen)
			local t0 = os.clock()
			while alive and os.clock() - t0 < 0.45 do
				local u = (os.clock() - t0) / 0.45
				VER.at = ahead + up * ((startY - floorY) * (1 - u * u))
				RunService.Heartbeat:Wait()
			end
			wait(0.6)
		end
		VER.at = ahead
		SFXP.play("Footstep1", 0.05, 1)
	end
	function TV.run(spot)
		build()
		place(spot)
		dress()
		local hiss = make("Sound", { Name = "Hiss", SoundId = SFX.StrobeStatic[1], Looped = true, Volume = 0.07, RollOffMinDistance = 4, RollOffMaxDistance = 40 }, glass)
		hiss:Play()
		local prompt = make("ProximityPrompt", { Name = "MonochromeTV", ActionText = "Play", ObjectText = "TV", HoldDuration = 1.5, MaxActivationDistance = 14,
			RequiresLineOfSight = false }, main)
		local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
		if playerGui and playerGui:FindFirstChild("MainUI") then prompt.Style = Enum.ProximityPromptStyle.Custom end -- (DOORS draws its own)
		local pressed = false
		on(prompt.Triggered, function() pressed = true end)
		while alive and not pressed do
			static(0.55)
			task.wait(1 / 15)
		end
		if not alive then return end
		prompt:Destroy()
		hiss:Destroy()
		play()
		if not alive then return end
		burst()
		if not alive then return end
		emerge(spot)
		if not alive then return end
		Brain.born, Brain.contact, Brain.wakeFor = os.clock(), os.clock(), 1
		Brain.set("wake")
	end
end

---====== IT COMES ======---

do
	-- What loaded here, in the console (F9): what to look at if something of it is not seen
	local sheets = 0
	for i = 1, TAPE.sheets do
		if LOCAL[("Tape_%02d"):format(i)] then sheets += 1 end
	end
	local function said(v) return if v == nil then "?" elseif v then "ok" else "NOT LOADED (ours instead)" end
	print(("[Monochrome] %s | VER: %s | its mesh: %s | its eyes: %s%s"):format(VARIANT, if VER.hull then "its own shape (from its place)" elseif not VER.fromKit then "made of its bones" elseif _G.VERModel or GENV.VERModel then "its public model" else "its kit",
		said(LOADED.mesh), said(LOADED.eyes), if VARIANT ~= "Noise" then "" else (" | TV: %s | Emerge: %s | tape: %d/%d sheets, sound %s"):format(
		if kit.tv then "its kit" else "ours", if kit.emerge then "ok" else "NOT LOADED", sheets, TAPE.sheets, if LOCAL.Tape then "ok" else "NOT LOADED")))
	local spot = nextDoor(24)
	if not spot then
		stop()
		return
	end
	if VARIANT == "Noise" then -- (out of its TV, once you play it)
		Brain.mode = "tv"
		task.spawn(TV.run, spot)
	else
		VER.place(spot.at, spot.look)
		Feel.on = true
		Lamps.blackout(spot.at, 5)
		Brain.wakeFor = 3.4
		Brain.twitch(3)
	end
	task.spawn(Scare.build) -- (its face ready before it is needed)
	local thought = 0
	on(RunService.Heartbeat, function(dt)
		if not alive then return end
		local _, _, me = body()
		Lamps.step(dt, if VER.model.Parent then VER.at else nil)
		Feel.step(dt)
		if not VER.model.Parent then return end
		if me then
			Feel.distance = (me.Position - VER.at).Magnitude * (if Brain.sees then 1 else 1.25)
			SFXP.presence(dt, Feel.distance)
			if Glitch.step and Brain.mode ~= "grab" then Glitch.step(Feel.distance) end
			thought += dt
			if thought >= 0.1 and Brain.mode ~= "grab" and Brain.mode ~= "gone" and Brain.mode ~= "tv" then
				thought = 0
				Brain.think(me)
			end
		end
		if Brain.mode ~= "grab" and Brain.mode ~= "gone" and VER.speed > 0 then Nav.step(dt, VER.speed) end
	end)
	on(RunService.RenderStepped, function(dt) VER.animate(dt) end)
	-- Dead (else than by it): it all goes
	local _, humanoid = body()
	if humanoid then on(humanoid.Died, function() task.delay(3, stop) end) end
	later(function()
		local _, _, root = body()
		if root and root.Anchored and VER.grabAt then root.Anchored = false end
	end)
end
