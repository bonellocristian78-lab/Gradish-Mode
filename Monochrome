-- A sound of its game's: its own file, else (if it will not load here) our stand-in for it
local function sound(key, props, parent)
	local spec = SOUND[key]
	local s = make("Sound", { Name = key, SoundId = spec[1] }, parent or SoundService)
	for k, v in pairs(props or {}) do s[k] = v end
	if spec[2] and LOCAL[spec[2]] then
		task.spawn(function() -- (not loaded in a while, or empty: ours)
			local t0 = os.clock()
			while alive and s.Parent and not s.IsLoaded and os.clock() - t0 < 6 do task.wait(0.25) end
			if s.Parent and (not s.IsLoaded or s.TimeLength <= 0) then
				local playing = s.IsPlaying
				s.SoundId = LOCAL[spec[2]]
				if playing then s:Play() end
			end
		end)
	end
	return s
end

---====== ITS WALK: its game's MonsterGait (its own procedural gait on its bones), as it is ======---

local Gait = {}
Gait.__index = Gait
do
	local WALK = { stance = 0.6, step = 1.15, lift = 0.16, crouch = 0.15, bob = 0.04, sway = 0.004, lean = 0.08, jolt = 0.012, pelvisYaw = 0.045,
		pelvisRoll = 0.016, chestYaw = 0.055, shoulderDrop = 0, armSwing = 0.3, armElbow = 0.5, armElbowSwing = 0.28, shoulderDrive = 0.16,
		shoulderLift = 0.03, headLevel = 0.93, footRoll = 0.34, twitch = 0 }
	local RUN = { stance = 0.3, step = 1.85, lift = 0.5, crouch = 0.18, bob = 0.075, sway = 0.004, lean = 0.45, jolt = 0.045, pelvisYaw = 0.08,
		pelvisRoll = 0.045, chestYaw = 0.11, shoulderDrop = 0, armSwing = 0.4, armElbow = 1, armElbowSwing = 0.45, shoulderDrive = 0.35,
		shoulderLift = 0.14, headLevel = 0.9, footRoll = 0.4, twitch = 0 }
	local CONFIG = { walkPace = 1.14, runPace = 3.3, snap = 1.35, armPlumb = 1.05, idleCutoff = 0.3, standSpeed = 0.55, speedResponse = 12,
		shapeResponse = 13, standResponse = 9, blendResponse = 6, armResponse = 32, bankPerRad = 0.03, bankMax = 0.075, bankResponse = 5,
		glanceTurn = 1.5, breathRate = 0.28, breathDepth = 0.014, idleSwayRate = 0.17, idleSway = 0.02, headYawLimit = 1.25, headPitchLimit = 0.8,
		lookResponse = 14, lockResponse = 18, baitComposeTime = 0.3, baitSwingPhase = 0.45, baitPhaseResponse = 14, grabCrouch = 0.3,
		grabLean = 0.55, grabRoll = 0.55, grabRollResponse = 2.6, strobeAngle = 0.55 }
	local STATES = { idle = true, walk = true, bait = true, run = true, grab = true }
	local BONES = { "Hips", "Spine", "Chest", "Neck", "Head", "Shoulder.R", "UpperArm.R", "LowerArm.R", "Hand.R", "Shoulder.L", "UpperArm.L",
		"LowerArm.L", "Hand.L", "Thigh.R", "Shin.R", "Foot.R", "Toe.R", "Thigh.L", "Shin.L", "Foot.L", "Toe.L" }
	Gait.CONFIG = CONFIG
	Gait.HEAD_CHAIN = { "Hips", "Spine", "Chest", "Neck", "Head" }
	local function blend(a, b, k)
		local out = {}
		for key, v in pairs(a) do out[key] = v + (b[key] - v) * k end
		return out
	end
	function Gait.new(model)
		local root = model:FindFirstChild("RootPart")
		if not (root and root:IsA("BasePart")) then return nil, "RootPart missing" end
		local bones = {}
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("Bone") then bones[d.Name] = d end
		end
		for _, name in ipairs(BONES) do
			if not bones[name] then return nil, "bone missing: " .. name end
		end
		local rootBone = root:FindFirstChildWhichIsA("Bone")
		if not rootBone then return nil, "root bone missing under RootPart" end
		local g = setmetatable({ model = model, root = root, rootBone = rootBone, bones = bones, rest = {}, axes = {} }, Gait)
		for name, bone in pairs(bones) do
			local rest = root.CFrame:ToObjectSpace(bone.WorldCFrame)
			g.rest[name] = rest
			g.axes[name] = { lat = rest:VectorToObjectSpace(Vector3.new(1, 0, 0)), up = rest:VectorToObjectSpace(Vector3.new(0, 1, 0)),
				fwd = rest:VectorToObjectSpace(Vector3.new(0, 0, -1)) }
		end
		local hipR, shinR, footR = g.rest["Thigh.R"].Position, g.rest["Shin.R"].Position, g.rest["Foot.R"].Position
		g.thighLen, g.shinLen = (shinR - hipR).Magnitude, (footR - shinR).Magnitude
		g.legLen = g.thighLen + g.shinLen
		g.hip = { R = hipR, L = g.rest["Thigh.L"].Position }
		g.ankleRest = footR.Y
		g.height = math.max(g.rest.Head.Position.Y, g.legLen * 1.8)
		g.footFlat = (g.rest["Toe.R"].Position - footR).Unit
		local arm = g.rest["LowerArm.R"].Position - g.rest["UpperArm.R"].Position
		g.armHang = (if arm.Magnitude > 1e-4 then math.acos(math.clamp(arm.Unit:Dot(Vector3.new(0, -1, 0)), -1, 1)) else 1.047) * 0.93
		g.p = blend(WALK, WALK, 0)
		g.blend, g.phase, g.speed, g.stand = 0, 0, 0, 1
		g.lastPos = root.Position
		g.armState = { R = { angle = 0 }, L = { angle = 0 } }
		g.headYaw, g.headPitch, g.headRoll = 0, 0, 0
		g.prevPlantR, g.prevPlantL = 1, 1
		g.baitTimer, g.bank, g.grabPhase, g.strobe = 0, 0, 0, 0
		g.state, g.clock, g.events = "walk", 0, {}
		return g
	end
	local function aimY(v) -- (turns +Y onto v)
		local u = v.Unit
		local d = math.clamp(up:Dot(u), -1, 1)
		local axis = up:Cross(u)
		if axis.Magnitude < 1e-6 then return if d > 0 then CFrame.identity else CFrame.fromAxisAngle(Vector3.new(1, 0, 0), math.pi) end
		return CFrame.fromAxisAngle(axis.Unit, math.acos(d))
	end
	function Gait:solveLeg(hip, target, pole)
		local a, b = self.thighLen, self.shinLen
		local origin = hip.Position
		local to = target - origin
		local reach = math.clamp(to.Magnitude, math.abs(a - b) + 0.05, a + b - 0.03)
		local dir = if to.Magnitude > 1e-5 then to.Unit else Vector3.new(0, -1, 0)
		local along = (a * a - b * b + reach * reach) / (2 * reach)
		local out = math.sqrt(math.max(a * a - along * along, 0))
		local bend = pole - dir * pole:Dot(dir)
		if bend.Magnitude < 1e-5 then bend = Vector3.new(0, 0, -1) - dir * dir.Z * -1 end
		local knee = origin + dir * along + bend.Unit * out
		return (knee - origin).Unit, (origin + dir * reach - knee).Unit
	end
	function Gait:poseLeg(side, base, target, plant, k, roll)
		local thigh, shin, foot, toe = self.bones["Thigh." .. side], self.bones["Shin." .. side], self.bones["Foot." .. side], self.bones["Toe." .. side]
		local thighAt = base * thigh.CFrame
		local upper, lower = self:solveLeg(thighAt, target, Vector3.new(0, 0, -1))
		thigh.Transform = aimY(thighAt:VectorToObjectSpace(upper))
		local shinAt = thighAt * thigh.Transform * shin.CFrame
		shin.Transform = aimY(shinAt:VectorToObjectSpace(lower))
		local footAt = shinAt * shin.Transform * foot.CFrame
		local want = self.footFlat:Lerp(lower:Lerp(self.footFlat, 0.55).Unit, (1 - plant) * 0.3)
		foot.Transform = aimY(footAt:VectorToObjectSpace(want.Unit)) * CFrame.fromAxisAngle(self.axes["Foot." .. side].lat, roll * k)
		toe.Transform = CFrame.fromAxisAngle(self.axes["Toe." .. side].lat, k * (plant * math.max(-roll, 0) * 0.9 - (1 - plant) * 0.18))
	end
	-- A foot along its step: how far ahead, how high, how planted, where in its stance (-1: in the air)
	function Gait:footPath(phase, lift, stance, stride)
		local len = stance * stride
		local u = phase % 1
		if u < stance then
			local s = u / stance
			return len * (0.5 - s), 0, 1 - math.clamp((s - 0.88) / 0.12, 0, 1), s
		end
		local s = (u - stance) / (1 - stance)
		return len * (0.5 - math.cos(math.pi * s ^ CONFIG.snap) * 0.5 - 0.5), lift * math.sin(math.pi * s) ^ 0.8, math.clamp((s - 0.85) / 0.15, 0, 1), -1
	end
	function Gait:setBone(name, lat, upAngle, fwd, offset)
		local axes = self.axes[name]
		local cf = CFrame.identity
		if offset then cf = CFrame.new(self.rest[name]:VectorToObjectSpace(offset)) end
		if lat ~= 0 then cf *= CFrame.fromAxisAngle(axes.lat, lat) end
		if fwd ~= 0 then cf *= CFrame.fromAxisAngle(axes.fwd, fwd) end
		if upAngle ~= 0 then cf *= CFrame.fromAxisAngle(axes.up, upAngle) end
		self.bones[name].Transform = cf
	end
	local MIN = 0.005179103691506845
	local function impact(x) -- (a footfall's jolt through the body)
		x %= 1
		if x > 0.91 then return MIN + (1 - MIN) * smoothstep((x - 0.91) / 0.09) end
		return math.exp(-x * 5.5) * (1 - x * 0.25)
	end
	-- One step of it: `prey` where it looks (or nil), `speedIn` how fast it goes, `turn` how fast it turns
	function Gait:Step(dt, prey, speedIn, turn)
		if dt <= 0 or dt > 0.5 then dt = math.min(math.max(dt, 1 / 240), 0.5) end
		self.clock += dt
		turn = turn or 0
		local composing = false
		if self.state == "bait" then -- (it settles into its bait pose, then holds it, still)
			local was = self.baitTimer < CONFIG.baitComposeTime
			self.baitTimer += dt
			if self.baitTimer >= CONFIG.baitComposeTime then
				if was then table.insert(self.events, { type = "baitHold" }) end
				return nil
			end
			composing = true
		end
		local rootAt = self.root.CFrame
		local pos = rootAt.Position
		local moved = flat(pos - self.lastPos).Magnitude
		self.lastPos = pos
		local target = math.max(speedIn or 0, 0)
		local travel = math.min(moved, target * dt * 1.8 + 0.03)
		self.speed = approach(self.speed, target, CONFIG.speedResponse, dt)
		local runK = smoothstep((self.speed / math.max(self.height, 0.1) - CONFIG.walkPace) / (CONFIG.runPace - CONFIG.walkPace))
		if self.state == "run" then runK = 1 end
		self.blend = approach(self.blend, runK, CONFIG.blendResponse, dt)
		local shape = blend(WALK, RUN, self.blend)
		if self.state == "grab" then
			shape.crouch, shape.lean, shape.armSwing, shape.armElbow, shape.lift = CONFIG.grabCrouch, CONFIG.grabLean, 0, 1.15, 0
			shape.bob, shape.pelvisYaw, shape.chestYaw, shape.footRoll, shape.jolt = 0, 0, 0, 0, 0
		end
		local p = self.p
		for key, v in pairs(shape) do p[key] = approach(p[key], v, CONFIG.shapeResponse, dt) end
		local moveK = if composing then 1 else smoothstep((self.speed - CONFIG.idleCutoff) / (self.height * CONFIG.walkPace - CONFIG.idleCutoff))
		local crouch = p.crouch * self.legLen
		local hipHeight = math.max(self.hip.R.Y - crouch - self.ankleRest, 0.05)
		local stride = math.min(p.step * self.legLen / p.stance, math.sqrt(math.max(self.legLen * self.legLen - hipHeight * hipHeight, 0.01)) * 2 * 0.96 / p.stance)
		local stance = p.stance
		self.stand = approach(self.stand, if self.speed < CONFIG.standSpeed and not composing then 1 else 0, CONFIG.standResponse, dt)
		local gaitK
		if composing then
			local diff = ((stance + (1 - stance) * CONFIG.baitSwingPhase) % 1 - self.phase + 0.5) % 1 - 0.5
			self.phase = (self.phase + diff * (1 - math.exp(-CONFIG.baitPhaseResponse * dt))) % 1
			gaitK = 1
		else
			if self.stand < 0.5 then self.phase = (self.phase + travel / stride) % 1 end
			gaitK = 1 - self.stand
		end
		local lift = p.lift * self.legLen * moveK
		local fR, lR, plantR, sR = self:footPath(self.phase, lift, stance, stride)
		local fL, lL, plantL, sL = self:footPath(self.phase + 0.5, lift, stance, stride)
		local function ankleRoll(s) return if s < 0 then p.footRoll * 0.35 else -p.footRoll * (s * 2 - 1) end
		if gaitK > 0.4 and moveK > 0.25 then
			if plantR >= 0.5 and self.prevPlantR < 0.5 then table.insert(self.events, { type = "footfall", side = "R", run = self.blend > 0.5 }) end
			if plantL >= 0.5 and self.prevPlantL < 0.5 then table.insert(self.events, { type = "footfall", side = "L", run = self.blend > 0.5 }) end
		end
		self.prevPlantR, self.prevPlantL = plantR, plantL
		local bob = -(p.bob * self.legLen) * moveK * (impact(self.phase) + impact(self.phase - 0.5))
		local hipY = -crouch + bob * gaitK + self.stand * math.sin(self.clock * math.pi * 2 * CONFIG.breathRate) * CONFIG.breathDepth * self.legLen
		self.bank = approach(self.bank, math.clamp(turn * CONFIG.bankPerRad, -CONFIG.bankMax, CONFIG.bankMax), CONFIG.bankResponse, dt)
		local bank = self.bank * moveK
		local swing = math.sin(math.pi * 2 * self.phase)
		local swayX = swing * p.sway * self.legLen * moveK * gaitK + self.stand * math.sin(self.clock * math.pi * 2 * CONFIG.idleSwayRate) * CONFIG.idleSway * self.legLen
		self:setBone("Hips", 0, p.pelvisYaw * swing * moveK * gaitK + bank * 0.5, p.pelvisRoll * swing * moveK * gaitK + bank, Vector3.new(swayX, hipY, 0))
		local bones, rootBone = self.bones, self.rootBone
		local hips = rootBone.CFrame * rootBone.Transform * bones.Hips.CFrame * bones.Hips.Transform
		for _, leg in ipairs({ { "R", fR, lR, plantR, ankleRoll(sR) }, { "L", fL, lL, plantL, ankleRoll(sL) } }) do
			local hip = self.hip[leg[1]]
			self:poseLeg(leg[1], hips, Vector3.new(hip.X, self.ankleRest + leg[3] * gaitK, hip.Z - leg[2] * gaitK), leg[4], moveK, leg[5])
		end
		local lean = p.lean
		local jolt = (impact(self.phase) + impact(self.phase - 0.5)) * p.jolt * moveK * gaitK
		self:setBone("Spine", -(lean * 0.6 + jolt * 0.55), 0, bank * 0.5)
		self:setBone("Chest", -(lean * 0.34 + jolt), -p.chestYaw * math.sin(math.pi * 2 * self.phase + math.pi) * moveK * gaitK, bank * 0.4)
		local chest = hips * bones.Spine.CFrame * bones.Spine.Transform * bones.Chest.CFrame * bones.Chest.Transform
		-- Its head: on you (its prey), else glancing where it turns
		local yaw, pitch
		if prey then
			local l = rootAt:PointToObjectSpace(prey)
			yaw = math.atan2(l.X, -l.Z)
			pitch = math.atan2(l.Y - (self.rest.Head.Position.Y + hipY), math.max(math.sqrt(l.X * l.X + l.Z * l.Z), 0.1))
		else
			yaw = (if turn >= 0 then 1 else -1) * 0.35 * math.clamp(math.abs(turn) / CONFIG.glanceTurn, 0, 1) * moveK
			pitch = 0
		end
		yaw = math.clamp(yaw, -CONFIG.headYawLimit, CONFIG.headYawLimit)
		pitch = math.clamp(pitch, -CONFIG.headPitchLimit, CONFIG.headPitchLimit)
		local rate = if self.state == "run" or self.state == "grab" then CONFIG.lockResponse else CONFIG.lookResponse
		self.headYaw = approach(self.headYaw, yaw, rate, dt)
		self.headPitch = approach(self.headPitch, pitch, rate, dt)
		self.headRoll = approach(self.headRoll, if self.state == "grab" then CONFIG.grabRoll * self.grabPhase else 0, CONFIG.grabRollResponse, dt)
		self:setBone("Neck", lean * 0.55, -self.headYaw * 0.3, 0)
		local head = chest * bones.Neck.CFrame * bones.Neck.Transform * bones.Head.CFrame
		local want = CFrame.Angles(0, -self.headYaw, 0) * CFrame.Angles(-self.headPitch, 0, 0) * CFrame.Angles(0, 0, self.headRoll) * self.rest.Head.Rotation
		bones.Head.Transform = CFrame.identity:Lerp(head.Rotation:Inverse() * want, if self.state == "grab" then 1 else p.headLevel)
		-- Its arms
		local armSwing, elbow = p.armSwing, p.armElbow
		for _, side in ipairs({ "R", "L" }) do
			local arm = self.armState[side]
			local to = -math.sin(math.pi * 2 * (self.phase + (if side == "R" then 0.5 else 0))) * armSwing * moveK * gaitK
			arm.angle = math.clamp(approach(arm.angle, to, CONFIG.armResponse, dt), -1.8, 1.8)
			local drive = arm.angle * p.shoulderDrive
			self:setBone("Shoulder." .. side, -lean * 0.12 + drive, 0, (if side == "R" then 1 else -1) * -drive * p.shoulderLift + (if side == "L" then p.shoulderDrop else 0))
			local hang = if side == "R" then 1 else -1
			local axes = self.axes["UpperArm." .. side]
			bones["UpperArm." .. side].Transform = CFrame.fromAxisAngle(axes.lat, arm.angle + lean * CONFIG.armPlumb) * CFrame.fromAxisAngle(axes.fwd, -hang * self.armHang)
			local swingK = if armSwing > 1e-4 then math.clamp(arm.angle / armSwing, -1, 1) else 0
			for _, joint in ipairs({ { "LowerArm." .. side, math.clamp(elbow + swingK * p.armElbowSwing, 0, 2) }, { "Hand." .. side, 0.14 } }) do
				local a = self.axes[joint[1]]
				local h = CFrame.fromAxisAngle(a.fwd, -hang * self.armHang)
				bones[joint[1]].Transform = h:Inverse() * CFrame.fromAxisAngle(a.lat, joint[2]) * h
			end
		end
		if self.strobe > 0.01 then -- (its strobe: its upper body twitching)
			for _, name in ipairs({ "Chest", "Neck", "Head", "UpperArm.R", "UpperArm.L" }) do
				local a, b = self.axes[name], bones[name]
				b.Transform = b.Transform * CFrame.fromAxisAngle(a.lat, (math.random() - 0.5) * CONFIG.strobeAngle * self.strobe)
					* CFrame.fromAxisAngle(a.fwd, (math.random() - 0.5) * CONFIG.strobeAngle * 0.7 * self.strobe)
			end
		end
		return moveK
	end
	function Gait:posedCFrame(chain)
		local cf = self.root.CFrame * self.rootBone.CFrame * self.rootBone.Transform
		for _, name in ipairs(chain) do
			local bone = self.bones[name]
			cf = cf * bone.CFrame * bone.Transform
		end
		return cf
	end
	function Gait:SetState(state)
		if not STATES[state] or state == self.state then return end
		local was = self.state
		self.state = state
		if state == "bait" then
			self.baitTimer = 0
			table.insert(self.events, { type = "baitFreeze" })
		elseif state == "run" then
			table.insert(self.events, { type = "detonate", fromBait = was == "bait" })
		elseif state == "grab" then
			self.grabPhase = 0
			table.insert(self.events, { type = "grabStart" })
		end
	end
	function Gait:SetGrab(x) self.grabPhase = math.clamp(x, 0, 1) end
	function Gait:SetStrobe(x) self.strobe = math.clamp(x, 0, 1) end
	function Gait:DrainEvents()
		local events = self.events
		self.events = {}
		return events
	end
end

