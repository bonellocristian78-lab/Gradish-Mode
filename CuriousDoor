---====== WHERE THE DOOR GOES: a plain wall of the room, nothing before it, room behind it for the little room ======---

-- The door as the Infirmary has it: its frame (the hole it needs in the wall: 6 wide, 8.45 high), the passage behind it
-- (3.13 deep) and the little room behind that
local DOOR = { half = 3.0, high = 8.45, passage = 3.13, width = 14, depth = 12 }
-- The Infirmary's own frame: its wall's face at its floor, the door's middle; -z into the wall
local KFRAME = CFrame.lookAt(Vector3.new(919.28, 18.79, -250.89), Vector3.new(919.28, 18.79, -249.89))
local function square(p, E) -- its sides square with the wall (it can be cut round the door)
	local ok = { false, false }
	for _, a in ipairs({ Vector3.new(1, 0, 0), Vector3.new(0, 1, 0), Vector3.new(0, 0, 1) }) do
		local w = p.CFrame:VectorToWorldSpace(a)
		if math.abs(w:Dot(E.RightVector)) > 0.99 then ok[1] = true end
		if math.abs(w:Dot(E.UpVector)) > 0.99 then ok[2] = true end
	end
	return ok[1] and ok[2]
end
local function depthOf(p, E) -- how far behind the wall's face it goes
	local deepest = -math.huge
	for _, c in ipairs(CORNERS) do
		deepest = math.max(deepest, -E:PointToObjectSpace(p.CFrame:PointToWorldSpace(p.Size * c)).Z)
	end
	return deepest
end
-- Its box in E's space (lowest, highest)
local function boxIn(p, E)
	local lo, hi = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, c in ipairs(CORNERS) do
		local v = E:PointToObjectSpace(p.CFrame:PointToWorldSpace(p.Size * c))
		lo = Vector3.new(math.min(lo.X, v.X), math.min(lo.Y, v.Y), math.min(lo.Z, v.Z))
		hi = Vector3.new(math.max(hi.X, v.X), math.max(hi.Y, v.Y), math.max(hi.Z, v.Z))
	end
	return lo, hi
end
-- What is seen of the room (every part of it, even those rays and boxes do not find: DOORS' lamps, its strips)
local seenParts = {}
for _, p in ipairs(room:GetDescendants()) do
	if p:IsA("BasePart") and p.Transparency < 0.95 then table.insert(seenParts, p) end
end
-- Round the door's place on the wall, up to over its frame: nothing hung there (a lamp, a picture), nothing standing
-- before it; only the wall's own strips (cut round the door with it). The strips, or nil
local function clearRound(E)
	local reach = math.min(info.height - 0.25, DOOR.high + 2.4)
	local strips = {}
	for _, p in ipairs(seenParts) do
		if (p.Position - E.Position).Magnitude < 30 then
			local lo, hi = boxIn(p, E)
			if hi.X > -DOOR.half - 0.9 and lo.X < DOOR.half + 0.9 and hi.Y > 0.15 and lo.Y < reach and hi.Z > 0.06 and lo.Z < 5.6 then
				-- (on the wall, a little out of it: its strips, its panels; square with it, to be cut)
				local strip = lo.Z < 0.25 and hi.Z < 1.1 and p:IsA("Part") and p.Shape == Enum.PartType.Block and square(p, E)
				if not strip then return nil end
				table.insert(strips, p)
			end
		end
	end
	return strips
end
-- A wall hit by a ray from the room: a place for the door there, or nil
local function wallSpot(hit)
	local n = Vector3.new(hit.Normal.X, 0, hit.Normal.Z)
	if n.Magnitude < 0.9 then return nil end
	n = n.Unit
	local base = Vector3.new(hit.Position.X, info.floor, hit.Position.Z)
	local E = CFrame.lookAt(base, base - n)
	for _, x in ipairs({ -DOOR.half + 0.3, 0, DOOR.half - 0.3 }) do -- flat where the door goes
		for _, y in ipairs({ 1.2, 4.5, DOOR.high - 0.4 }) do
			local from = E:PointToWorldSpace(Vector3.new(x, y, 1.5))
			local h = ray(from, -n * 3)
			if not h or math.abs((from - h.Position):Dot(n) - 1.5) > 0.3 then return nil end
		end
	end
	if not empty(E * CFrame.new(0, 4.8, 3), Vector3.new(DOOR.half * 2 + 1, 8, 5.2)) then return nil end -- nothing before it
	local strips = clearRound(E) -- (nor hung round it)
	if not strips then return nil end
	for _, d in ipairs(info.doors) do -- not by the room's doors
		if (Vector3.new(d.X, base.Y, d.Z) - base).Magnitude < 9 then return nil end
	end
	local wall, thick = {}, 0 -- the wall: plain parts square with it, not too thick
	for _, p in ipairs(partsIn(E * CFrame.new(0, DOOR.high / 2, -1.6), Vector3.new(DOOR.half * 2 - 0.1, DOOR.high - 0.2, 3.6))) do
		if there(p) then
			if not (p:IsDescendantOf(room) and p:IsA("Part") and p.Shape == Enum.PartType.Block and square(p, E)) then return nil end -- (not another room's)
			table.insert(wall, p)
			thick = math.max(thick, depthOf(p, E))
		end
	end
	if #wall == 0 or thick > 4 then return nil end
	local front = math.max(thick, DOOR.passage - 0.38) -- (the little room's front: behind the wall, or at the passage's end)
	local back = front + DOOR.depth + 0.6
	local high = info.height + 0.65
	if not empty(E * CFrame.new(0, 0.15 + high / 2, -(thick + 0.1 + back) / 2), Vector3.new(DOOR.width + 1.2, high, back - thick - 0.1)) then return nil end
	for _, p in ipairs(wall) do
		local i = table.find(strips, p)
		if i then table.remove(strips, i) end
	end
	return { E = E, wall = wall, thick = thick, front = front, strips = strips }
end
local function findSpot()
	local path = if #info.doors >= 2 then flat(info.doors[2] - info.doors[1]) else info.cf.LookVector
	local middle = info.cf.Position
	local reach = math.max(info.size.X, info.size.Z)
	local best, bestScore = nil, -math.huge
	for i = -2, 2 do
		for j = -2, 2 do
			local p = info.cf:PointToWorldSpace(Vector3.new(i * info.size.X / 6, 0, j * info.size.Z / 6))
			local from = Vector3.new(p.X, info.floor + 4, p.Z)
			for _, dir in ipairs(HORIZONTAL) do
				local hit = ray(from, info.cf:VectorToWorldSpace(dir) * reach)
				if hit and hit.Instance:IsDescendantOf(room) then
					local spot = wallSpot(hit)
					if spot then -- (better: on a side wall, toward the middle of the room)
						local side = 1 - math.abs(spot.E.LookVector:Dot(path))
						local score = side * 3 - math.abs((spot.E.Position - middle):Dot(path)) / reach + math.random() * 0.3
						if score > bestScore then best, bestScore = spot, score end
					end
				end
			end
		end
	end
	return best
end
-- No wall will do: the door on a wall all the same (flat, nothing before it), a doorway of light; its room far below
local function portalSpot()
	local list = {}
	for i = -2, 2 do
		for j = -2, 2 do
			local p = info.cf:PointToWorldSpace(Vector3.new(i * info.size.X / 6, 0, j * info.size.Z / 6))
			for _, dir in ipairs(HORIZONTAL) do
				local hit = ray(Vector3.new(p.X, info.floor + 4, p.Z), info.cf:VectorToWorldSpace(dir) * math.max(info.size.X, info.size.Z))
				if hit and math.abs(hit.Normal.Y) < 0.1 then table.insert(list, hit) end
			end
		end
	end
	for _, hit in ipairs(list) do
		local n = flat(hit.Normal)
		local base = Vector3.new(hit.Position.X, info.floor, hit.Position.Z)
		local E = CFrame.lookAt(base, base - n)
		local near = false
		for _, d in ipairs(info.doors) do
			if (Vector3.new(d.X, base.Y, d.Z) - base).Magnitude < 9 then near = true end
		end
		if not near and empty(E * CFrame.new(0, 4.8, 3), Vector3.new(DOOR.half * 2 + 1, 8, 5.2)) and clearRound(E) then
			return { E = E * CFrame.new(0, 0, 0.65), portal = true }
		end
	end
	local E = CFrame.lookAt(Vector3.new(info.cf.X, info.floor, info.cf.Z), Vector3.new(info.cf.X, info.floor, info.cf.Z) + info.cf.LookVector)
	return { E = E * CFrame.new(0, 0, 0.65), portal = true }
end
