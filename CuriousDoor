-- A padlock on a chest's lock (DOORS' own, the stairwell's): the lockpicks break it
local function padlock(chest)
	local m = KIT.Padlock:Clone()
	local base = m:FindFirstChild("LockBase")
	local lockAt = if chest.lock then chest.lock.Position else chest.main.Position + chest.front * (chest.main.Size.Z / 2)
	local T = CFrame.lookAt(lockAt + chest.front * 0.18 - UP * 0.3, lockAt + chest.front * 1.18 - UP * 0.3)
	local to = T * base.CFrame.Rotation:Inverse() * CFrame.new(-base.Position)
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CFrame = to * p.CFrame
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		elseif p:IsA("JointInstance") then
			p:Destroy()
		end
	end
	m.Parent = chest.model
	chest.padlock = m
	return base
end
