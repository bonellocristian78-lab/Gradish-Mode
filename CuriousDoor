-- The Curious Light on you: a shell of light over your body (as it shines on whoever it revives), a flash, sparkles round you
local function bless()
	local character = LocalPlayer.Character
	if not character then return end
	local shells = {}
	for _, p in ipairs(character:GetDescendants()) do
		if p:IsA("BasePart") and p.Transparency < 0.5 and p.Name ~= "HumanoidRootPart" then
			local ok, c = pcall(function() return p:Clone() end)
			if ok and c then
				for _, k in ipairs(c:GetChildren()) do
					if not k:IsA("SpecialMesh") then k:Destroy() end
				end
				c.Anchored, c.CanCollide, c.CanQuery, c.CanTouch, c.Massless = true, false, false, false, true
				c.Material, c.Color, c.Transparency = Enum.Material.ForceField, BLESS, 0
				c.Size = p.Size + Vector3.new(0.05, 0.05, 0.05)
				c.CFrame = p.CFrame
				c.Parent = folder
				table.insert(shells, { p, c })
			end
		end
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		local rise = make("ParticleEmitter", { Name = "Blessing", Texture = ID.sparkle, Color = ColorSequence.new(YELLOW), LightEmission = 1,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) }), Lifetime = NumberRange.new(1.2, 2.2),
			Speed = NumberRange.new(1.5, 3), SpreadAngle = Vector2.new(30, 30), Acceleration = UP * 2, Rate = 40, EmissionDirection = Enum.NormalId.Top }, root)
		local shine = make("PointLight", { Name = "Blessing", Color = BLESS, Brightness = 3, Range = 14, Shadows = false }, root)
		tween(shine, 3, { Brightness = 0 })
		task.delay(2.2, function() rise.Rate = 0 end)
		task.delay(5, function()
			rise:Destroy()
			shine:Destroy()
		end)
	end
	sfx(ID.shimmer, treasure.main, 0.8)
	grade.TintColor, grade.Brightness = BLESS, 0.35
	tween(grade, 2.4, { TintColor = Color3.new(1, 1, 1), Brightness = 0 })
	bloom.Intensity = 1.2
	tween(bloom, 2.4, { Intensity = 0 })
	local start = os.clock()
	local follow
	follow = on(RunService.RenderStepped, function()
		local u = (os.clock() - start) / 2.6
		for _, s in ipairs(shells) do
			if s[1].Parent then s[2].CFrame = s[1].CFrame end
			s[2].Transparency = math.clamp(u, 0, 1)
		end
		if u >= 1 then
			follow:Disconnect()
			for _, s in ipairs(shells) do s[2]:Destroy() end
		end
	end)
end

-- Run one of this repository's scripts (the Shake Light's, the scanners')
