-- A chest standing at `at` (its bottom), its front (its lock) toward `facing`, `scale` times its size
local function newChest(at, facing, scale)
	local m = KIT.Chest:Clone()
	local main = m:FindFirstChild("Main")
	pcall(function() m.PrimaryPart = main end)
	if scale and scale ~= 1 then pcall(function() m:ScaleTo(scale) end) end
	local to = CFrame.lookAt(at + UP * (main.Size.Y / 2), at + UP * (main.Size.Y / 2) + facing) * main.CFrame:Inverse()
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then p.CFrame = to * p.CFrame end
	end
	m.Parent = folder
	local chest = { model = m, main = main, lid = m:FindFirstChild("Lid"), front = facing, tracks = {} }
	chest.lock = chest.lid and chest.lid:FindFirstChild("Lock", true)
	local controller = m:FindFirstChildOfClass("AnimationController")
	chest.animator = controller and controller:FindFirstChildOfClass("Animator")
	-- The Curious Light in it: its glow through the lid's seam, its sparkles over it
	local top = main.Position + UP * (main.Size.Y / 2)
	chest.seam = make("Part", { Name = "Seam", Size = Vector3.new(0.05, main.Size.X * 1.02, main.Size.Z * 1.02), Shape = Enum.PartType.Block,
		CFrame = main.CFrame.Rotation * CFrame.Angles(0, 0, math.pi / 2) + top, Material = Enum.Material.Neon, Color = YELLOW, Transparency = 0.35,
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false }, m)
	local glow = (KIT.CuriousLight and KIT.CuriousLight:Clone()) or make("Part", { Name = "CuriousLight", Size = Vector3.new(4, 1, 2) }, nil)
	glow.CFrame = CFrame.new(top + UP * 0.4)
	glow.Transparency, glow.Anchored, glow.CanCollide, glow.CanQuery, glow.CanTouch = 1, true, false, false, false
	local emitters = 0
	for _, e in ipairs(glow:GetChildren()) do
		if e:IsA("ParticleEmitter") then
			emitters += 1
			if emitters > 2 then e:Destroy() else e.Rate = 6 end
		elseif e:IsA("PointLight") then
			e.Color, e.Brightness, e.Range, e.Shadows = LIGHT, 1.1, 12, false
			chest.light = e
		end
	end
	if not chest.light then chest.light = make("PointLight", { Name = "PointLight", Color = LIGHT, Brightness = 1.1, Range = 12, Shadows = false }, glow) end
	glow.Parent = m
	chest.glow = glow
	return chest
end
local function playChest(chest, name, fade)
	if not chest.animator then return end
	local anim = chest.model:FindFirstChild("Animations") and chest.model.Animations:FindFirstChild(name)
	if not anim then return end
	local t = chest.tracks[name]
	if not t then
		local ok, track = pcall(function() return chest.animator:LoadAnimation(anim) end)
		if not ok then return end
		t = track
		chest.tracks[name] = t
	end
	pcall(function() t:Play(fade or 0.1) end)
end
local function openChest(chest)
	playChest(chest, "open")
	task.delay(0.75, function() playChest(chest, "openidle", 0.2) end)
	local s = chest.main:FindFirstChild("Open")
	if s then pcall(function() s:Play() end) else sfx(ID.chestOpen, chest.main, 0.55) end
	chest.seam.Transparency = 1
	chest.light.Brightness = 3
	tween(chest.light, 1.5, { Brightness = 1.4 })
	for _, e in ipairs(chest.glow:GetChildren()) do
		if e:IsA("ParticleEmitter") then pcall(function() e:Emit(20) end) end
	end
end
