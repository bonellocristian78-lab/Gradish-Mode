local stream = make("ParticleEmitter", { Name = "Stream", Texture = ID.sparkle, Color = ColorSequence.new(BLESS, YELLOW), LightEmission = 1, Rate = 0,
	Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(0.3, 0.22), NumberSequenceKeypoint.new(1, 0) }),
	Lifetime = NumberRange.new(1.2, 2.4), Speed = NumberRange.new(3, 7), SpreadAngle = Vector2.new(28, 22), EmissionDirection = Enum.NormalId.Back,
	Drag = 1.2 }, veil)
pcall(function() stream.Shape = Enum.ParticleEmitterShape.Box end)
-- How bright the light through the door is (0 none, 1 full): its slits while shut, its rays once open
local function lightThrough(slits, rayK)
	for _, l in ipairs(leaks) do l.Transparency = 1 - slits * 0.85 end
	for _, r in ipairs(rays) do r.Transparency = NumberSequence.new(1 - rayK * 0.3, 1 - rayK * 0.02) end
end
-- A pulse of light: a flat disc that grows and fades
local function pulse(cf, from, to, seconds)
	local disc = make("Part", { Name = "Pulse", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.04, from, from), CFrame = cf * CFrame.Angles(0, math.pi / 2, 0),
		Material = Enum.Material.Neon, Color = BLESS, Transparency = 0.25, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		CastShadow = false }, folder)
	tween(disc, seconds, { Size = Vector3.new(0.04, to, to), Transparency = 1 }, Enum.EasingStyle.Quart)
	task.delay(seconds + 0.1, function() disc:Destroy() end)
end
local function easeOut(u) return 1 - (1 - u) ^ 3 end

-- The film of the door, t seconds after the key leaves your hand:
--  0.0  the golden key flies out of your hand (a trail of light behind it), over your shoulder, into the skull
--  1.6  it turns: a click, the skull's eyes lit, a pulse of light; light round the door's edges
--  2.3  the skull falls; from the floor, the door: it shakes, light through its edges
--  3.6  it bursts open: the Curious Light pours out (rays, sparkles, a flash, the music); you shield your eyes
--  5.0  your face in its light, looking into it
--  6.6  behind you, two steps toward the doorway of light; 9.8 back to your eyes
local DOOR_POSES = {
	{ t = 0, pose = {} },
	{ t = 0.35, pose = { rS = { 72, 4, 0 }, neck = { -6, 0, 0 } } },
	{ t = 1.2, pose = { rS = { 80, 4, 0 }, rE = { 10, 0, 0 }, neck = { -4, 0, 0 } } },
	{ t = 1.7, pose = { rS = { 82, 6, 10 }, rE = { 12, 0, 0 }, neck = { -2, 0, 0 } } },
	{ t = 2.5, pose = { rS = { 10, 0, 0 }, neck = { 6, 0, 0 } } },
	{ t = 3.55, pose = { rS = { 8, 0, 0 }, neck = { 8, 0, 0 }, waist = { -2, 0, 0 } } },
	{ t = 3.95, pose = { neck = { -12, 10, 0 }, waist = { -9, 0, 0 }, rS = { 128, -8, -26 }, rE = { 74, 0, 0 }, lS = { 22, 0, -10 }, lE = { 20, 0, 0 } } },
	{ t = 5.2, pose = { neck = { -6, 6, 0 }, waist = { -6, 0, 0 }, rS = { 116, -8, -22 }, rE = { 64, 0, 0 }, lS = { 18, 0, -10 } } },
	{ t = 6.4, pose = { neck = { 12, 0, 0 }, waist = { -3, 0, 0 }, rS = { 26, 0, 18 }, lS = { 26, 0, -18 }, rE = { 18, 0, 0 }, lE = { 18, 0, 0 } } },
	{ t = 9.4, pose = { neck = { 6, 0, 0 }, rS = { 12, 0, 6 }, lS = { 12, 0, -6 } } },
}
-- Its camera: where it is, what it looks at, its field of view
local function doorShot(t, stand, face, right, head)
	local lockAt, middle = door.lockAt.Position, E:PointToWorldSpace(Vector3.new(0, DOOR.high / 2, 0))
	if t < 2.3 then -- over your shoulder, drawing in to the skull
		local u = ease(math.clamp(t / 2.3, 0, 1))
		local from = stand + UP * 1.75 + right * 1.0 - face * 0.7
		local to = lockAt + face * 1.6 + right * 0.55 - UP * 0.1
		return CFrame.lookAt(from:Lerp(to, u * 0.6), lockAt), 50 - u * 12
	elseif t < 3.6 then -- from the floor by the door: the door, its edges of light
		local u = ease(math.clamp((t - 2.3) / 1.3, 0, 1))
		local eye = E:PointToWorldSpace(Vector3.new(2.9 - u * 0.4, 0.45, 3.6 - u * 0.5))
		return CFrame.lookAt(eye, middle + UP * 0.6), 64 - u * 6
	elseif t < 5.0 then -- from the side, wide: the door bursting open, you in its light
		local u = ease(math.clamp((t - 3.6) / 1.4, 0, 1))
		local mid = (head + middle) / 2
		return CFrame.lookAt(mid + right * (4.8 - u * 0.6) + UP * 0.4 - face * 0.6, mid), 60
	elseif t < 6.6 then -- your face in the light
		local u = ease(math.clamp((t - 5.0) / 1.6, 0, 1))
		return CFrame.lookAt(head + face * (1.9 - u * 0.25) + right * (0.7 - u * 0.25) + UP * 0.1, head + UP * 0.05), 40 - u * 6
	end
	local u = ease(math.clamp((t - 6.6) / 3.2, 0, 1)) -- behind you, toward the doorway of light
	return CFrame.lookAt(head - face * (3.4 - u * 1.5) + right * 0.8 + UP * (0.45 + u * 0.25), E:PointToWorldSpace(Vector3.new(0, 4, -3))), 60 - u * 8
end

local function openDoor(tool)
	if door.opened then return end
	door.opened = true
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		door.opened = false
		return
	end
	local face = flat(E.LookVector) -- (toward the door)
	local right = face:Cross(UP)
	local mark = E:PointToWorldSpace(Vector3.new(0.6, 0, 4.2))
	local stand = Vector3.new(mark.X, root.Position.Y, mark.Z)
	local film = newFilm(character, root)
	film.facing = face
	if tool then
		for _, d in ipairs(tool:GetDescendants()) do
			if d:IsA("BasePart") then film.hide[d] = true end
		end
	end
	-- The key: out of your hand, into the skull, turned (a trail of light behind it)
	local prop = KIT.SkeletonKey:Clone()
	local propMain = prop:FindFirstChild("Main")
	if propMain then propMain:Destroy() end
	local propHandle = prop:FindFirstChild("Handle")
	gild(prop)
	local propParts = {}
	for _, p in ipairs(prop:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored, p.CanCollide, p.CanQuery = true, false, false
			table.insert(propParts, { p, propHandle.CFrame:ToObjectSpace(p.CFrame) })
		end
	end
	local tail0 = make("Attachment", { Name = "TrailA", Position = Vector3.new(0, 0.12, 0) }, propHandle)
	local tail1 = make("Attachment", { Name = "TrailB", Position = Vector3.new(0, -0.12, 0) }, propHandle)
	local trail = make("Trail", { Name = "CuriousTrail", Attachment0 = tail0, Attachment1 = tail1, Color = ColorSequence.new(BLESS, YELLOW), LightEmission = 1,
		Lifetime = 0.35, Transparency = NumberSequence.new(0.2, 1), FaceCamera = true }, propHandle)
	prop.Parent = folder
	door.lockAt = door.lock.CFrame
	local lockFront = door.lock.Position - face * 0.24
	local inLock = CFrame.fromMatrix(lockFront - face * 0.3, -face, UP) -- (its shaft in, its skull out)
	local t0 = os.clock()
	local fromHand = film.hand.CFrame
	local function propAt(cf)
		for _, e in ipairs(propParts) do e[1].CFrame = cf * e[2] end
	end
	film.bodyAt = function(now)
		local t = now - t0
		local pushed = ease(math.clamp((t - 3.6) / 0.6, 0, 1)) * 0.5 - ease(math.clamp((t - 6.8) / 2.7, 0, 1)) * 1.4
		return poseAt(DOOR_POSES, t), stand - face * pushed, face
	end
	local function headNow() return stand + UP * 1.5 - face * (ease(math.clamp((os.clock() - t0 - 3.6) / 0.6, 0, 1)) * 0.5) end
	film.shot = function(now) return doorShot(now - t0, stand, face, right, headNow()) end
	local fired = {}
	local function once(name, at, fn)
		if not fired[name] and os.clock() - t0 >= at then
			fired[name] = true
			fn()
		end
	end
	film.every = function(now)
		local t = now - t0
		if t < 0.9 then -- (out of your hand, in an arc, before the skull)
			local u = ease(t / 0.9)
			local cf = fromHand:Lerp(inLock * CFrame.new(0.7, 0, 0), u)
			propAt(cf + UP * math.sin(u * math.pi) * 0.6)
		elseif t < 1.15 then -- (in)
			propAt((inLock * CFrame.new(0.7, 0, 0)):Lerp(inLock, ease((t - 0.9) / 0.25)))
		elseif t < 1.65 then -- (turned)
			propAt(inLock * CFrame.Angles(math.rad(90) * ease((t - 1.15) / 0.5), 0, 0))
		elseif t < 2.3 then -- (the skull trembles)
			local k = (2.3 - t) * 0.05
			door.lock.CFrame = door.lockAt * CFrame.Angles((math.random() - 0.5) * k, (math.random() - 0.5) * k, (math.random() - 0.5) * k)
			propAt(door.lock.CFrame * door.lockAt:ToObjectSpace(inLock * CFrame.Angles(math.rad(90), 0, 0)))
		end
		if t >= 1.65 and t < 3.6 then lightThrough(math.clamp((t - 1.65) / 1.2, 0, 1) * (0.55 + 0.45 * math.clamp((t - 2.3) / 1.3, 0, 1)), 0) end
		if t >= 2.5 and t < 3.6 then swing(math.sin(t * 40) * 0.006 * math.clamp((t - 2.5) / 1.1, 0, 1)) end -- (it shakes on its hinges)
		if t >= 3.6 and t < 5.6 then
			local u = easeOut(math.clamp((t - 3.6) / 1.9, 0, 1))
			swing(u)
			lightThrough(1 - u, math.clamp((t - 3.6) / 0.8, 0, 1))
		end
		once("click", 1.15, function() sfx(ID.unlock, door.lock, 0.35, 1.3) end)
		once("turned", 1.6, function() -- the skull: its sound, its eyes lit, its sparkles, a pulse of light
			sfx(ID.skull, door.lock, 0.8)
			door.glow.Brightness, door.glow.Range = 4, 12
			for _, e in ipairs(door.model:GetDescendants()) do
				if e:IsA("ParticleEmitter") then pcall(function() e:Emit(35) end) end
			end
			pulse(CFrame.lookAt(door.lock.Position, door.lock.Position + face), 0.4, 6, 0.7)
			film.jolt(0.5)
		end)
		once("fall", 2.3, function() -- it falls, the key in it
			sfx(ID.fall, door.lock, 0.4)
			for _, e in ipairs(propParts) do
				e[1].Anchored, e[1].CanCollide = false, false
				make("WeldConstraint", { Part0 = door.lock, Part1 = e[1] }, e[1])
			end
			trail.Enabled = false
			door.lock.Anchored, door.lock.CanCollide = false, true
			pcall(function() door.lock.AssemblyLinearVelocity = -face * 2 + UP * 1.5 end)
			tween(door.glow, 1.5, { Brightness = 0 })
			tween(flood, 1.2, { Brightness = 0.8 })
			task.delay(5, function()
				pcall(function() prop:Destroy() end)
				pcall(function() door.lock:Destroy() end)
			end)
		end)
		once("open", 3.6, function() -- it bursts open: the Curious Light pours out
			sfx(ID.creak, door.leaf, 0.7, 0.85)
			sfx(ID.shimmer, door.leaf, 0.7)
			startMusic()
			film.jolt(1)
			flood.Brightness = 7
			tween(flood, 2.6, { Brightness = 5 })
			tween(veil, 1.4, { Transparency = if spot.portal then 0.15 else 0.55 })
			tween(closet.lamp, 2.5, { Brightness = 1.2 })
			closet.dust.Rate = 14
			for _, b in ipairs(closet.beams) do b.Transparency = NumberSequence.new(0.78, 0.97) end
			stream.Rate = 45
			pcall(function() stream:Emit(60) end)
			grade.TintColor, grade.Brightness = BLESS, 0.45
			tween(grade, 2.4, { TintColor = Color3.fromRGB(255, 240, 200), Brightness = 0.08 })
			bloom.Intensity = 1.6
			tween(bloom, 2.4, { Intensity = 0.7 })
			pulse(E * CFrame.new(0, DOOR.high / 2, 0.4), 1, 14, 1.1)
		end)
		once("calm", 6.4, function()
			stream.Rate = 8
			tween(flood, 3, { Brightness = 1.4 })
			if not spot.portal then tween(veil, 3, { Transparency = 0.94 }) end
			tween(grade, 3, { TintColor = Color3.new(1, 1, 1), Brightness = 0 })
			tween(bloom, 3, { Intensity = 0 })
		end)
		once("home", 9.8, function()
			task.spawn(function()
				swing(1)
				lightThrough(0, 0.35)
				film.home(stand + face * 0.9, 1.4)
				pcall(function() character.Humanoid:UnequipTools() end)
				caption("La Curious Light ti chiama.")
			end)
		end)
	end
end
