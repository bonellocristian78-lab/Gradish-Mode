---====== A FILM: black bars, your camera and your body for a cutscene (you seen from outside, your head too), all given back ======---

local grade = make("ColorCorrectionEffect", { Name = "CuriousGrade", Enabled = true }, Lighting)
local bloom = make("BloomEffect", { Name = "CuriousBloom", Intensity = 0, Size = 30, Threshold = 0.9 }, Lighting)
C.effects = { grade, bloom }
local mainGame = nil
pcall(function() mainGame = require(LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game) end)
local JOINTS = { root = { "Root", "RootJoint" }, waist = { "Waist" }, neck = { "Neck" }, rS = { "RightShoulder", "Right Shoulder" },
	rE = { "RightElbow" }, lS = { "LeftShoulder", "Left Shoulder" }, lE = { "LeftElbow" } }
local ZERO = { 0, 0, 0 }
-- A pose between two of a list { t, pose = { joint = { pitch, yaw, roll } } } (degrees: pitch > 0 lifts an arm forward)
local function poseAt(list, t)
	local a, b = list[#list], list[#list]
	for i = 2, #list do
		if list[i].t > t then
			a, b = list[i - 1], list[i]
			break
		end
	end
	local u = if b.t > a.t then ease(math.clamp((t - a.t) / (b.t - a.t), 0, 1)) else 1
	local out = {}
	for name in pairs(JOINTS) do
		local p, q = a.pose[name] or ZERO, b.pose[name] or ZERO
		out[name] = { lerp(p[1], q[1], u), lerp(p[2], q[2], u), lerp(p[3], q[3], u) }
	end
	return out
end
local function newFilm(character, root)
	local camera = workspace.CurrentCamera
	local film = { done = false, saved = { type = camera.CameraType, fov = camera.FieldOfView, cframe = camera.CFrame, anchored = root.Anchored,
		stopcam = mainGame and mainGame.stopcam, incutscene = mainGame and mainGame.incutscene, seen = {} }, hide = {} }
	for _, d in ipairs(character:GetDescendants()) do -- (how DOORS shows your body in first person: given back at the end)
		if d:IsA("BasePart") or d:IsA("Decal") then film.saved.seen[d] = d.LocalTransparencyModifier end
	end
	if mainGame then mainGame.stopcam, mainGame.incutscene = true, true end
	pcall(function() mainGame.update() end) -- (its hotbar and its cursor away)
	root.Anchored = true
	camera.CameraType = Enum.CameraType.Scriptable
	local bars = make("ScreenGui", { Name = "CuriousFilm", IgnoreGuiInset = true, DisplayOrder = 99998, ResetOnSpawn = false }, playerGui)
	local top = make("Frame", { Size = UDim2.fromScale(1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, bars)
	local bottom = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, bars)
	local function barsTo(height, seconds)
		for _, bar in ipairs({ top, bottom }) do tween(bar, seconds, { Size = UDim2.fromScale(1, height) }) end
	end
	barsTo(0.11, 0.35)
	local joints = {}
	for name, names in pairs(JOINTS) do
		for _, n in ipairs(names) do
			local m = character:FindFirstChild(n, true)
			if m and m:IsA("Motor6D") then
				local q = m.C0.Rotation
				joints[name] = { motor = m, q = q, qi = q:Inverse() }
				break
			end
		end
	end
	film.hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm") or root
	-- The body, after Roblox's animations
	local writer = on(RunService.PreSimulation or RunService.Stepped, function()
		if not film.bodyAt then return end
		local pose, at, face = film.bodyAt(os.clock())
		for name, j in pairs(joints) do
			local a = pose[name] or ZERO
			j.motor.Transform = j.qi * CFrame.fromEulerAnglesYXZ(math.rad(a[1]), math.rad(a[2]), math.rad(a[3])) * j.q
		end
		root.CFrame = CFrame.lookAt(at, at + face)
	end)
	-- The picture
	RunService:BindToRenderStep("CuriousFilm", Enum.RenderPriority.Last.Value + 2, function()
		local now = os.clock()
		for _, d in ipairs(character:GetDescendants()) do -- seen from outside, even in first person
			if d:IsA("BasePart") or d:IsA("Decal") then d.LocalTransparencyModifier = if film.hide[d] then 1 else 0 end
		end
		if film.every then film.every(now) end
		if film.shot then
			local cf, fov = film.shot(now)
			if film.shaking > 0.002 then -- (a jolt: the camera shakes, and settles)
				local k = film.shaking
				cf = cf * CFrame.Angles(math.noise(now * 22, 1) * 0.05 * k, math.noise(now * 22, 2) * 0.05 * k, math.noise(now * 22, 3) * 0.03 * k)
				film.shaking *= 0.9
			end
			camera.CFrame, camera.FieldOfView = cf, fov
		end
	end)
	film.shaking = 0
	function film.jolt(k) film.shaking = math.max(film.shaking, k) end
	function film.finish()
		if film.done then return end
		film.done = true
		C.film = nil
		RunService:UnbindFromRenderStep("CuriousFilm")
		writer:Disconnect()
		for _, j in pairs(joints) do j.motor.Transform = CFrame.new() end
		camera.CameraType = film.saved.type
		camera.FieldOfView = film.saved.fov
		if mainGame then mainGame.stopcam, mainGame.incutscene = film.saved.stopcam, film.saved.incutscene end
		if root.Parent then root.Anchored = film.saved.anchored end
		bars:Destroy()
		for d, was in pairs(film.saved.seen) do -- your body as DOORS showed it (your head and your clothes not in your eyes)
			if d.Parent then d.LocalTransparencyModifier = was end
		end
		pcall(function() mainGame.update() end)
	end
	-- Back to you, wherever you are now, and the bars go
	function film.home(at, seconds)
		local leaving, fov, from = camera.CFrame, camera.FieldOfView, os.clock()
		local home = CFrame.lookAt(at + UP * 1.5, at + UP * 1.5 + film.facing)
		film.shot = function(now)
			local u = ease(math.clamp((now - from) / seconds, 0, 1))
			return leaving:Lerp(home, u), lerp(fov, film.saved.fov, u)
		end
		barsTo(0, seconds * 0.85)
		task.wait(seconds + 0.05)
		film.finish()
	end
	C.film = film
	return film
end

