---====== THE WALL CUT ROUND THE DOOR (only for you: copies of it round the hole, the wall itself hidden) ======---

local function hideLocally(p)
	if C.hidden[p] then return end
	C.hidden[p] = { p.LocalTransparencyModifier, p.CanCollide }
	p.LocalTransparencyModifier, p.CanCollide = 1, false
	for _, d in ipairs(p:GetChildren()) do
		if d:IsA("Decal") or d:IsA("Texture") then
			C.hidden[d] = { d.LocalTransparencyModifier }
			d.LocalTransparencyModifier = 1
		end
	end
end
local RIGHTOF = { Front = Vector3.new(-1, 0, 0), Back = Vector3.new(1, 0, 0), Right = Vector3.new(0, 0, -1), Left = Vector3.new(0, 0, 1) }
local function cut(p, x0, x1, y0, y1) -- up to four copies of it round the hole (x0..x1, y0..y1 in E, through it)
	local ax, ay = nil, nil
	for i, a in ipairs({ Vector3.new(1, 0, 0), Vector3.new(0, 1, 0), Vector3.new(0, 0, 1) }) do
		local w = p.CFrame:VectorToWorldSpace(a)
		if math.abs(w:Dot(E.RightVector)) > 0.99 then ax = i end
		if math.abs(w:Dot(E.UpVector)) > 0.99 then ay = i end
	end
	local lo, hi = { math.huge, math.huge, math.huge }, { -math.huge, -math.huge, -math.huge }
	for _, c in ipairs({ { x0, y0 }, { x0, y1 }, { x1, y0 }, { x1, y1 } }) do
		local l = p.CFrame:PointToObjectSpace(E:PointToWorldSpace(Vector3.new(c[1], c[2], 0)))
		local v = { l.X, l.Y, l.Z }
		for k = 1, 3 do lo[k], hi[k] = math.min(lo[k], v[k]), math.max(hi[k], v[k]) end
	end
	local half = { p.Size.X / 2, p.Size.Y / 2, p.Size.Z / 2 }
	local u0, u1 = math.clamp(lo[ax], -half[ax], half[ax]), math.clamp(hi[ax], -half[ax], half[ax])
	local v0, v1 = math.clamp(lo[ay], -half[ay], half[ay]), math.clamp(hi[ay], -half[ay], half[ay])
	if u1 - u0 < 0.01 or v1 - v0 < 0.01 then return end -- (not in the way)
	for _, r in ipairs({ { -half[ax], u0, -half[ay], half[ay] }, { u1, half[ax], -half[ay], half[ay] }, { u0, u1, -half[ay], v0 }, { u0, u1, v1, half[ay] } }) do
		if r[2] - r[1] > 0.02 and r[4] - r[3] > 0.02 then
			local ok, piece = pcall(function() return p:Clone() end)
			if not (ok and piece) then piece = make("Part", { Color = p.Color, Material = p.Material, Transparency = p.Transparency }, nil) end
			for _, d in ipairs(piece:GetChildren()) do
				if not (d:IsA("Texture") or d:IsA("Decal")) then d:Destroy() end
			end
			for _, tag in ipairs(piece:GetTags()) do piece:RemoveTag(tag) end
			piece.Anchored = true
			local size, offset = { p.Size.X, p.Size.Y, p.Size.Z }, { 0, 0, 0 }
			size[ax], offset[ax] = r[2] - r[1], (r[1] + r[2]) / 2
			size[ay], offset[ay] = r[4] - r[3], (r[3] + r[4]) / 2
			local o = Vector3.new(offset[1], offset[2], offset[3])
			piece.Size = Vector3.new(size[1], size[2], size[3])
			piece.CFrame = p.CFrame * CFrame.new(o)
			for _, t in ipairs(piece:GetChildren()) do -- (its wallpaper where it was)
				local right = t:IsA("Texture") and RIGHTOF[tostring(t.Face):match("(%a+)$")]
				if right then
					local axis = ({ "X", "Y", "Z" })[math.abs(right.X) * 1 + math.abs(right.Y) * 2 + math.abs(right.Z) * 3]
					t.OffsetStudsU -= p.Size[axis] / 2 - piece.Size[axis] / 2 + o:Dot(right)
					t.OffsetStudsV -= p.Size.Y / 2 - piece.Size.Y / 2 - o.Y
				end
			end
			piece.Parent = folder
		end
	end
	hideLocally(p)
end
