-- The tool the Admin Panel is about to give you: the first new one named for it (or, failing that, any new one)
local function arriving(stem)
	local known = {}
	local function places()
		local out = { LocalPlayer:FindFirstChildOfClass("Backpack") }
		if LocalPlayer.Character then table.insert(out, LocalPlayer.Character) end
		return out
	end
	for _, place in ipairs(places()) do
		for _, t in ipairs(place:GetChildren()) do known[t] = true end
	end
	local since = os.clock()
	return function()
		local other = nil
		for _, place in ipairs(places()) do
			for _, t in ipairs(place:GetChildren()) do
				if t:IsA("Tool") and not known[t] then
					if t.Name:lower():find(stem, 1, true) then return t end
					other = other or t
				end
			end
		end
		return if os.clock() - since > 3 then other else nil
	end
end
local function give(item, stem)
	if LOCAL then return localItem(item) end
	local poll = arriving(stem)
	command("Give Items", { Players = ME, Items = { [item] = item } })
	local deadline = os.clock() + 10
	while os.clock() < deadline and C.alive do
		task.wait(0.1)
		local tool = poll()
		if tool then return tool end
	end
	return nil
end
-- Gold: its metal gold and shining, what glows yellow, a soft yellow glow and sparkles round it
local function gild(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 1 then
			if d:IsA("MeshPart") then pcall(function() d.TextureID = "" end) end
			if d.Material == Enum.Material.Neon or d.Name == "Eyeholes" then
				d.Material, d.Color = Enum.Material.Neon, YELLOW
			else
				local _, s, v = d.Color:ToHSV() -- (its own light and dark, in a deep gold: metal, not paint)
				d.Color = Color3.fromHSV(0.115, math.clamp(0.66 + s * 0.2, 0, 1), math.clamp(0.42 + v * 0.45, 0, 1))
				d.Material, d.Reflectance = Enum.Material.Metal, 0.18
			end
		elseif d:IsA("SurfaceAppearance") then
			d:Destroy()
		elseif d:IsA("Light") then
			d.Color = LIGHT
		elseif d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") then
			d.Color = ColorSequence.new(YELLOW)
		end
	end
	local handle = model:FindFirstChild("Handle") or model:FindFirstChildWhichIsA("BasePart", true)
	if handle then
		make("PointLight", { Name = "CuriousGlow", Color = LIGHT, Brightness = 0.8, Range = 6, Shadows = false }, handle)
		make("ParticleEmitter", { Name = "CuriousSparkles", Texture = ID.sparkle, Color = ColorSequence.new(YELLOW), LightEmission = 1,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12), NumberSequenceKeypoint.new(1, 0) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
			Lifetime = NumberRange.new(0.6, 1.2), Rate = 6, Speed = NumberRange.new(0.2, 0.6), SpreadAngle = Vector2.new(180, 180) }, handle)
