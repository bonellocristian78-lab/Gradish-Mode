-- What floats over the open chest: turning, glowing; take it. While `item.path` is set (in its film), it goes where that
-- says; its prompt only once it is free
local function floating(model, at, label, onTake)
	local parts, pivot = {}, nil
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
			pivot = pivot or p
			table.insert(parts, p)
		end
	end
	if not pivot then return nil end
	local rel = {}
	for _, p in ipairs(parts) do rel[p] = pivot.CFrame:ToObjectSpace(p.CFrame) end
	model.Parent = folder
	local item = { at = at, born = os.clock(), offset = math.random() * 6 }
	function item.rest(now) -- (where it floats on its own)
		local t = now - item.born
		return CFrame.new(at + UP * (math.min(t / 1.2, 1) * 1.6 + math.sin(t * 1.8 + item.offset) * 0.12)) * CFrame.Angles(0, t * 0.9 + item.offset, 0)
	end
	local spin = on(RunService.RenderStepped, function()
		local now = os.clock()
		local cf = if item.path then item.path(now) else item.rest(now)
		for _, p in ipairs(parts) do p.CFrame = cf * rel[p] end
	end)
	make("PointLight", { Name = "Glow", Color = LIGHT, Brightness = 1, Range = 7, Shadows = false }, pivot)
	make("ParticleEmitter", { Name = "Glitter", Texture = ID.sparkle, Color = ColorSequence.new(YELLOW), LightEmission = 1, Rate = 5,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 0) }), Lifetime = NumberRange.new(0.5, 1),
		Speed = NumberRange.new(0.2, 0.5), SpreadAngle = Vector2.new(180, 180) }, pivot)
	local take = prompt(pivot, "Take", label, 0, 9)
	item.take = take
	on(take.Triggered, function()
		take:Destroy()
		spin:Disconnect()
		model:Destroy()
		sfx(ID.shimmer, treasure.main, 0.5, 1.2)
		onTake()
	end)
	return item
end
-- The Curious Shake Light, as it floats: DOORS' flashlight (the kit's) of yellow glass, its light lit (or one of parts)
local function shakeLightModel()
	local m = make("Model", { Name = "CuriousShakeLight" }, nil)
	if KIT.Flashlight then
		for _, p in ipairs(KIT.Flashlight:Clone():GetDescendants()) do
			if p:IsA("BasePart") and p.Name == "Neon" then p.Transparency = 0 end -- (its light lit)
			if p:IsA("BasePart") and p.Transparency < 1 then
				for _, k in ipairs(p:GetChildren()) do
					if not (k:IsA("Decal") or k:IsA("Texture") or k:IsA("SpecialMesh")) then k:Destroy() end
				end
				pcall(function() p.TextureID = "" end)
				if p.Material == Enum.Material.Neon then
					p.Color = BLESS
				elseif p.Material == Enum.Material.Glass or p.Transparency > 0.2 then
					p.Color = Color3.fromRGB(255, 226, 70)
				else
					local _, s, v = p.Color:ToHSV()
					p.Color = Color3.fromHSV(0.11, math.clamp(0.75 + s * 0.25, 0, 1), math.clamp(0.35 + v * 0.65, 0, 1))
				end
				p.Parent = m
			end
		end
		if #m:GetChildren() > 0 then return m end
	end
	local body = make("Part", { Name = "Body", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.3, 0.5, 0.5), Material = Enum.Material.Glass,
		Color = Color3.fromRGB(255, 226, 70), Transparency = 0.25 }, m)
	make("Part", { Name = "Core", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.1, 0.28, 0.28), Material = Enum.Material.Neon, Color = BLESS,
		CFrame = body.CFrame }, m)
	make("Part", { Name = "Head", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.35, 0.66, 0.66), Material = Enum.Material.Metal,
		Color = Color3.fromRGB(226, 150, 30), CFrame = body.CFrame * CFrame.new(0.8, 0, 0) }, m)
	make("Part", { Name = "Lens", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.05, 0.56, 0.56), Material = Enum.Material.Neon, Color = BLESS,
		CFrame = body.CFrame * CFrame.new(1.0, 0, 0) }, m)
	return m
end
-- The Golden Tablet, as it floats: the tablet's own model, its body gold, its screen lit (or a tablet of parts)
local function tabletModel()
	local ok, tool = pcall(function() return game:GetObjects(ID.tablet)[1] end)
	local m = make("Model", { Name = "GoldenTablet" }, nil)
	if ok and typeof(tool) == "Instance" and tool:FindFirstChild("Handle") then
		local handle = tool.Handle
		handle.Parent = m
		for _, d in ipairs(handle:GetDescendants()) do
			if d:IsA("Sound") or d:IsA("LuaSourceContainer") then d:Destroy() end
		end
		gild(m)
		local screen = handle:FindFirstChild("Screen")
		if screen then screen.Material, screen.Color, screen.Transparency = Enum.Material.Neon, Color3.fromRGB(255, 208, 70), 0 end
		handle.Transparency = 1
		return m
	end
	make("Part", { Name = "Body", Size = Vector3.new(1.3, 0.9, 0.12), Material = Enum.Material.Metal, Color = Color3.fromRGB(214, 160, 52) }, m)
	make("Part", { Name = "Screen", Size = Vector3.new(1.05, 0.7, 0.02), CFrame = CFrame.new(0, 0, -0.07), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 208, 70) }, m)
	return m
end
-- The two of them over the chest (their models made beforehand, if they were)
local function giveItems(models)
	local inside = treasure.main.Position + UP * 0.6
	local side = closet.R:VectorToWorldSpace(Vector3.new(1, 0, 0))
	return floating(models.shake or shakeLightModel(), inside - side * 0.8, "Curious Shake Light", function() run("CuriousShakeLight") end),
		floating(models.tablet or tabletModel(), inside + side * 0.8, "Golden Tablet", function() run("ObjectScanner", { Type = "Tablet", Variant = "Golden" }) end)
end

-- The film of the treasure, t seconds after you open it:
--  0.0  close to the chest, low: its lid lifts, slowly, light through it
--  2.2  a burst: a pillar of the Curious Light from the chest to the ceiling, a flash, a pulse over the floor; you are lifted
--       in it, your arms open, its shell of light on you, motes of light circling you, rising
--  5.0  the Curious Shake Light and the Golden Tablet rise out of it and circle you; round you it goes
--  7.8  they settle over the chest, you come down, its light dies down; 9.0 back to your eyes: take them
local TREASURE_POSES = {
	{ t = 0, pose = {} },
	{ t = 0.6, pose = { waist = { 10, 0, 0 }, neck = { 8, 0, 0 }, rS = { 50, 0, 6 }, lS = { 50, 0, -6 }, rE = { 30, 0, 0 }, lE = { 30, 0, 0 } } },
	{ t = 2.0, pose = { waist = { 12, 0, 0 }, neck = { 10, 0, 0 }, rS = { 56, 0, 8 }, lS = { 56, 0, -8 }, rE = { 34, 0, 0 }, lE = { 34, 0, 0 } } },
	{ t = 2.5, pose = { waist = { -10, 0, 0 }, neck = { -16, 0, 0 }, rS = { 20, 0, 60 }, lS = { 20, 0, -60 }, rE = { 10, 0, 0 }, lE = { 10, 0, 0 } } },
	{ t = 4.6, pose = { waist = { -8, 0, 0 }, neck = { -22, 0, 0 }, rS = { 30, 0, 78 }, lS = { 30, 0, -78 }, rE = { 6, 0, 0 }, lE = { 6, 0, 0 } } },
	{ t = 7.4, pose = { waist = { -4, 0, 0 }, neck = { -8, 0, 0 }, rS = { 26, 0, 50 }, lS = { 26, 0, -50 } } },
	{ t = 8.8, pose = { neck = { 4, 0, 0 }, rS = { 6, 0, 4 }, lS = { 6, 0, -4 } } },
}
local function treasureShot(t, chestAt, stand, face, right, a0)
	local head = stand + UP * 1.5
	if t < 2.2 then -- close to the chest, low, round it a little
		local u = ease(math.clamp(t / 2.2, 0, 1))
		local eye = chestAt - face * 2.4 + right * (1.6 - u * 0.9) + UP * (0.2 + u * 0.3)
		return CFrame.lookAt(eye, chestAt + UP * 0.6), 52 - u * 8
	elseif t < 5.0 then -- from beside you, low, pulling back and up: you lifted, the pillar of light before you
		local u = ease(math.clamp((t - 2.2) / 2.8, 0, 1))
		local eye = head + right * 3.6 - face * (1.6 + u * 1.2) + UP * (-0.5 + u * 1.3)
		return CFrame.lookAt(eye, head + face * 0.8 + UP * (0.3 + u * 0.4)), 60
	elseif t < 7.8 then -- round you, the two of them circling
		local u = ease(math.clamp((t - 5.0) / 2.8, 0, 1))
		local a = a0 + u * math.pi * 0.85
		return CFrame.lookAt(head + Vector3.new(math.cos(a), 0, math.sin(a)) * 4 + UP * 1.2, head + UP * 0.6), 58
	end
	local u = ease(math.clamp((t - 7.8) / 1.2, 0, 1)) -- the chest, the two of them over it
	local a = a0 + math.pi * 0.85
	local from = head + Vector3.new(math.cos(a), 0, math.sin(a)) * 4 + UP * 1.2
	return CFrame.lookAt(from:Lerp(head - face * 2.2 + UP * 0.5 + right * 0.6, u), (head + UP * 0.6):Lerp(chestAt + UP * 1.6, u)), 54 - u * 4
end
-- Its light: the pillar, the pulse, the motes round you; fn(t) sets them, gone(): all of it away
local function treasureLights(chestAt, stand)
	local L = { motes = {} }
	L.pillar = make("Part", { Name = "Pillar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(info.height + 1, 0.1, 0.1),
		CFrame = CFrame.new(chestAt + UP * (info.height / 2)) * CFrame.Angles(0, 0, math.pi / 2), Material = Enum.Material.Neon, Color = BLESS,
		Transparency = 1, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false }, folder)
	L.core = make("PointLight", { Name = "Core", Color = BLESS, Brightness = 0, Range = 22, Shadows = false }, L.pillar)
	L.rise = make("ParticleEmitter", { Name = "Rise", Texture = ID.sparkle, Color = ColorSequence.new(BLESS, YELLOW), LightEmission = 1, Rate = 0,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) }), Lifetime = NumberRange.new(1, 2),
		Speed = NumberRange.new(2, 5), SpreadAngle = Vector2.new(12, 12), EmissionDirection = Enum.NormalId.Right }, L.pillar)
	for i = 1, 14 do
		table.insert(L.motes, make("Part", { Name = "Mote", Shape = Enum.PartType.Ball, Size = Vector3.new(0.18, 0.18, 0.18), Material = Enum.Material.Neon,
			Color = if i % 2 == 0 then BLESS else YELLOW, Transparency = 1, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
			CastShadow = false, CFrame = CFrame.new(stand) }, folder))
	end
	function L.at(t, center)
		local open = math.clamp((t - 0.4) / 1.8, 0, 1) -- (through the lid)
		local burst = math.clamp((t - 2.2) / 0.35, 0, 1) * (1 - math.clamp((t - 6.8) / 2, 0, 1))
		if t < 7.6 then treasure.light.Brightness = 1.2 + open * 3 + burst * 2 end
		L.core.Brightness = burst * 4
		local w = 0.1 + burst * (2.2 + math.sin(t * 9) * 0.15)
		L.pillar.Size = Vector3.new(info.height + 1, w, w)
		L.pillar.Transparency = 1 - burst * 0.55
		L.rise.Rate = burst * 40
		for i, m in ipairs(L.motes) do -- (round you, rising and falling)
			local a = t * 1.6 + i / #L.motes * math.pi * 2
			local r = 1.6 + math.sin(t * 2 + i) * 0.25
			m.CFrame = CFrame.new(center + Vector3.new(math.cos(a) * r, (i % 7) * 0.45 - 0.9 + math.sin(t * 1.3 + i) * 0.4, math.sin(a) * r))
			m.Transparency = 1 - burst * 0.9
		end
	end
	function L.gone()
		L.pillar:Destroy()
		for _, m in ipairs(L.motes) do m:Destroy() end
	end
	return L
end
local function openTreasure()
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then -- (no film: the chest, its blessing, the two of them)
		interact()
		openChest(treasure)
		bless()
		task.delay(0.8, function() giveItems({}) end)
		return
	end
	local chestAt = treasure.main.Position
	local face = flat(closet.R.LookVector) -- (toward the back of the little room: the chest)
	local right = face:Cross(UP)
	local base = chestAt - face * 3.4
	local stand = Vector3.new(base.X, root.Position.Y, base.Z)
	local film = newFilm(character, root)
	film.facing = face
	local t0 = os.clock()
	local a0 = math.atan2(face.Z, face.X) + math.pi * 0.25
	local L = treasureLights(chestAt, stand)
	local shake, tablet = nil, nil
	local models = {}
	task.spawn(function() -- (made now: the tablet's model is fetched)
		models.shake = shakeLightModel()
		models.tablet = tabletModel()
		models.ready = true
	end)
	film.bodyAt = function(now)
		local t = now - t0
		local lift = ease(math.clamp((t - 2.3) / 1.6, 0, 1)) * 0.7 * (1 - ease(math.clamp((t - 7.6) / 1.1, 0, 1)))
		return poseAt(TREASURE_POSES, t), stand + UP * (lift + math.sin(t * 2.2) * 0.05 * lift), face
	end
	film.shot = function(now) return treasureShot(now - t0, chestAt, stand, face, right, a0) end
	local fired = {}
	local function once(name, at, fn)
		if not fired[name] and os.clock() - t0 >= at then
			fired[name] = true
			fn()
		end
	end
	-- The two of them: out of the chest, round you, then over the chest
	local function circling(item, phase)
		local from = os.clock()
		item.take.Enabled = false
		item.path = function(now)
			local t = now - t0
			local center = stand + UP * (1.9 + ease(math.clamp((t - 2.3) / 1.6, 0, 1)) * 0.7)
			local a = (now - from) * 2.1 + phase
			local orbit = CFrame.new(center + Vector3.new(math.cos(a), math.sin(a * 0.5) * 0.25, math.sin(a)) * 2.3) * CFrame.Angles(0.3, a * 1.5, 0.2)
			local out = math.clamp((now - from) / 1.2, 0, 1) -- (out of the chest)
			local cf = (CFrame.new(chestAt + UP * 0.4)):Lerp(orbit, ease(out))
			local settle = math.clamp((t - 7.8) / 1.2, 0, 1) -- (to its place over the chest)
			return cf:Lerp(item.rest(now), ease(settle))
		end
	end
	film.every = function(now)
		local t = now - t0
		L.at(t, stand + UP * (1.6 + ease(math.clamp((t - 2.3) / 1.6, 0, 1)) * 0.7))
		once("open", 0.3, function()
			interact()
			openChest(treasure)
			film.jolt(0.25)
		end)
		once("burst", 2.2, function()
			sfx(ID.shimmer, treasure.main, 0.9)
			sfx(ID.chestOpen, treasure.main, 0.4, 0.7)
			film.jolt(0.9)
			bless()
			grade.TintColor, grade.Brightness = BLESS, 0.55
			tween(grade, 3, { TintColor = Color3.fromRGB(255, 244, 214), Brightness = 0.08 })
			bloom.Intensity = 1.8
			tween(bloom, 3, { Intensity = 0.6 })
			pulse(CFrame.lookAt(chestAt + UP * 0.05, chestAt + UP * 1.05), 1, 18, 1.4)
			caption("La Curious Light ti benedice.")
		end)
		if models.ready then
			once("items", 4.8, function()
				shake, tablet = giveItems(models)
				if shake then circling(shake, 0) end
				if tablet then circling(tablet, math.pi) end
			end)
		end
		once("calm", 7.6, function()
			tween(grade, 2, { TintColor = Color3.new(1, 1, 1), Brightness = 0 })
			tween(bloom, 2, { Intensity = 0 })
			tween(treasure.light, 2, { Brightness = 1.4 })
		end)
		once("home", 9.0, function()
			task.spawn(function()
				if not fired.items then -- (its models came late: the two of them over the chest now)
					fired.items = true
					while not models.ready do task.wait(0.1) end
					shake, tablet = giveItems(models)
				end
				for _, item in ipairs({ shake, tablet }) do
					if item then
						item.path = nil
						item.take.Enabled = true
					end
				end
				L.gone()
				film.home(stand, 1.3)
				caption("Prendi la Curious Shake Light e il Golden Tablet.")
			end)
		end)
	end
end
local treasurePrompt = prompt(treasure.main, "Open", "Chest", 1, 8)
on(treasurePrompt.Triggered, function()
	treasurePrompt:Destroy()
	openTreasure()
end)

---====== STOP: everything taken away, the room as it was ======---

GENV.__CuriousDoorStop = function()
	C.alive = false
	if C.film then pcall(C.film.finish) end
	pcall(function() RunService:UnbindFromRenderStep("CuriousFilm") end)
	for _, c in ipairs(C.connections) do c:Disconnect() end
	for inst, was in pairs(C.hidden) do
		pcall(function()
			inst.LocalTransparencyModifier = was[1]
			if was[2] ~= nil then inst.CanCollide = was[2] end
		end)
	end
	pcall(function() music:Destroy() end)
	for _, e in ipairs(C.effects) do pcall(function() e:Destroy() end) end
	for _, t in ipairs(C.made) do pcall(function() t:Destroy() end) end
	pcall(function() folder:Destroy() end)
end
