-- The light behind the shut door: through its edges (four slits of light round its leaf), and, once it is open, rays of
-- it into the room and its sparkles streaming out
local leaks = {}
for _, s in ipairs({ { 0, DOOR.high - 0.1, DOOR.half * 2 - 0.45, 0.07 }, { -DOOR.half + 0.24, DOOR.high / 2, 0.07, DOOR.high - 0.3 },
