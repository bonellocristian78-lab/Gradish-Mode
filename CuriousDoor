local function chestSpots(count)
	local found, tries = {}, {}
	local step = 2
	for x = -info.size.X / 2 + 2.5, info.size.X / 2 - 2.5, step do
		for z = -info.size.Z / 2 + 2.5, info.size.Z / 2 - 2.5, step do table.insert(tries, Vector3.new(x, 0, z)) end
	end
	for i = #tries, 2, -1 do -- (in no order)
		local j = math.random(1, i)
		tries[i], tries[j] = tries[j], tries[i]
	end
	local center = info.cf.Position
	for pass = 1, 2 do
		for _, t in ipairs(tries) do
			if #found >= count then break end
			local p = info.cf:PointToWorldSpace(t)
			local hit = ray(Vector3.new(p.X, info.floor + 2.5, p.Z), Vector3.new(0, -4, 0))
			local at = Vector3.new(p.X, info.floor, p.Z)
			local ok = hit ~= nil and math.abs(hit.Position.Y - info.floor) < 0.6 and hit.Normal.Y > 0.9
			if ok and pass == 1 then -- (first: by a wall)
				local near = false
				for _, dir in ipairs(HORIZONTAL) do
					if ray(at + UP * 1.2, info.cf:VectorToWorldSpace(dir) * 4.2) then near = true end
				end
				ok = near
			end
			for _, d in ipairs(info.doors) do
				if ok and (Vector3.new(d.X, at.Y, d.Z) - at).Magnitude < 8 then ok = false end
			end
			if ok and (E:PointToWorldSpace(Vector3.new(0, 0, 2.5)) - at).Magnitude < 8 then ok = false end
			for _, f in ipairs(found) do
				if ok and (f.at - at).Magnitude < 7 then ok = false end
			end
			if ok and empty(CFrame.new(at + UP * 1.6), Vector3.new(4.6, 2.9, 4.6)) then
				table.insert(found, { at = at, facing = flat(center - at) })
			end
		end
	end
	return found
end
