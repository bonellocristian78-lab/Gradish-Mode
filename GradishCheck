--[[
================================================================================

        G R A D I S H   C H E C K

        Run this once and it tells you, badge by badge and file by file, what
        the mod is actually going to do -- before you go looking for an entity
        to test it on.

        It answers the question that has cost the most time in this project:
        "I put the image in, why is the badge showing something else?" There
        are five places an image can come from and they override each other in
        a fixed order. This prints the winner for every badge, by name, and
        says where it came from.

        It also catches the things that fail silently:

          - two badges sharing one Identifier. The save file stores
            identifiers, so the second badge is marked owned the moment the
            first is granted and its popup never appears again. Nothing warns
            you; it just quietly stops working after the first run.

          - a model URL that 404s. The entity script loads, the spawner gets
            nothing, and you get an empty corridor with no error.

          - an ImagesA file that returns a number where a string was meant, or
            a URL the executor cannot download.

          - a badge switched off that you thought was on.

        Nothing here changes anything. It reads, it reports, and it stops.
        Everything printed also lands in gradish_log.txt, so you can read the
        result outside the game instead of screenshotting the console.

            loadstring(game:HttpGet("https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/main/GradishCheck"))()

================================================================================
]]

local Core = loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/main/GradishCore"
))()

local BASE = "https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/main/"

local problems = 0
local warnings = 0

local function line(format, ...)
	local text = select("#", ...) > 0 and format:format(...) or format
	print(text)
	pcall(Core.Log, "Check", "%s", text)
end

local function head(title)
	line("")
	line("== %s " .. ("="):rep(math.max(0, 58 - #title)), title)
end

local function bad(format, ...)
	problems += 1
	line("  [X] " .. format, ...)
end

local function warn(format, ...)
	warnings += 1
	line("  [!] " .. format, ...)
end

local function good(format, ...)
	line("  [ok] " .. format, ...)
end

---====== IS ANYTHING REACHABLE AT ALL ======---

local function reachable(url)
	local ok, body = pcall(game.HttpGet, game, url)
	if not ok then return false, tostring(body) end
	if type(body) ~= "string" or #body == 0 then return false, "empty" end

	-- GitHub serves a plain "404: Not Found" body with a 404 status, and some
	-- executors hand that back as a success rather than raising.
	if body:sub(1, 3) == "404" then return false, "404" end

	return true, #body
end

head("THE REPOSITORY")

do
	local ok, size = reachable(BASE .. "GradishCore")
	if ok then
		good("GradishCore reachable, %d bytes", size)
	else
		bad("GradishCore is NOT reachable (%s) -- nothing will work", tostring(size))
	end

	local configOk, configSize = reachable(BASE .. "AchievementConfig")
	if configOk then
		good("AchievementConfig reachable, %d bytes", configSize)
	else
		warn("AchievementConfig unreachable (%s) -- every badge falls back to its", tostring(configSize))
		line("       generated wording, which still works but ignores your edits")
	end
end

---====== THE EXECUTOR ======---
--[[ Half the "it does not work on my executor" reports come down to one of
     these four functions being missing. Better to say so by name. ]]

head("YOUR EXECUTOR")

do
	local needed = {
		{ name = "writefile",      fn = writefile,      why = "the disk log, and url images" },
		{ name = "readfile",       fn = readfile,       why = "reading which badges you own" },
		{ name = "getcustomasset", fn = getcustomasset, why = "url and local-file images" },
		{ name = "isfile",         fn = isfile,         why = "not re-downloading images" },
	}

	for _, item in ipairs(needed) do
		if item.fn then
			good("%s", item.name)
		else
			warn("no %s -- affects: %s", item.name, item.why)
		end
	end

	if not getcustomasset then
		line("       Without getcustomasset only plain Roblox asset IDs can be used")
		line("       for badge art. Put IDs in ImagesA and everything still works.")
	end
end

