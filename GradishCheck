head("ENTITY MODELS")

do
	local models = {
		{ entity = "Retter",              file = "retterbetter.rbxm" },
		{ entity = "Rose Hell",           file = "roseHell.rbxm" },
		{ entity = "Yeller",              file = "Yeller.rbxm" },
		{ entity = "Rebound",             file = "ReboundGradishVer.rbxm" },
		{ entity = "Corrode",             file = "corrodeV3butmadebyMyFriend.rbxm" },
		{ entity = "Rude",                file = "Rude.rbxm" },
		{ entity = "Silence",             file = "Silence.rbxm" },
		{ entity = "Speedster Purpleist", file = "SpeedsterPurpleist.rbxm" },
		{ entity = "Blue Hell",           file = "BlueHell.rbxm" },
		{ entity = "Mischievous Light",   file = "MischievousLight.rbxm" },
