--[[
================================================================================

        R U D E

        He does not chase you. He arrives while something else already is, he
        parks himself in the middle of your room like Eyes, and for as long as
        he is there the two things you normally do to survive will kill you:

            hiding in a closet
            opening a drawer

        That is the whole design. Every other entity in Gradish mode teaches
        you to get in a closet. Rude turns that reflex into the trap. Yeller
        starts rebounding, you run for the closet like you have learned to,
        and Rude is standing in the room watching you do it.

        HOW HE ARRIVES
        --------------
        He is not on the room schedule. He waits for another Gradish entity to
        spawn, rolls TriggerChance, and if it hits he turns up TriggerDelay
        seconds later -- long enough that you have already committed to dealing
        with the first one.

        HOW HE LEAVES
        -------------
        A timer, or a crucifix. There is an achievement for the crucifix.

        WHY THIS IS NOT BUILT ON THE ENTITY SPAWNER
        ------------------------------------------
        Spawner:Create exists to move something along a path from room to room.
        Rude does not move along a path -- he stands still and changes the
        rules. Everything the spawner would have given him (the ritual, the
        damage loop, the pathfinding) is either unused or actively wrong here,
        so this file implements the parts he actually needs: placement, the
        rules, the crucifix, the death.

        THE DRAWER PROBLEM, STATED HONESTLY
        -----------------------------------
        I do not know how DOORS opens drawers. The screenshots of Dresser and
        Table show an Event and a Constraint inside each DrawerContainer and no
        ProximityPrompt that I can see. So rather than pick one and hope, Rude
        arms four detectors at once and kills you on whichever fires first. It
        also prints which one it was, so after one death we will know for
        certain, and CrucifixSpawner can be rewritten around the real answer.

================================================================================
]]

---====== CONFIG ======---

local Config = {
	Name     = "Rude",
	ModelUrl = "https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/main/Rude.rbxm",

	--[[ ARRIVAL ]]
	-- "Most of the time" when another entity is out. Not always, or he stops
	-- being a surprise and becomes a tax.
	TriggerChance = 0.7,
	TriggerDelay  = 20,   -- seconds after the other entity spawned
	MinRoom       = 10,   -- never in the opening rooms

	-- Seconds he stays before leaving on his own.
	Duration = { 35, 55 },

	-- He relocates to the middle of whatever room you walk into. Set false and
	-- he stays in the room he arrived in, which makes running away a valid
	-- answer and the whole thing much softer.
	FollowPlayer = true,

	-- Studs above the room floor. Eyes-height, not floor-height.
	Height = 6,

	--[[ THE RULES ]]
	HideKills   = true,
	DrawerKills = true,

	-- You get this long after he appears before the rules bite, so that
	-- arriving while you are ALREADY in a closet is survivable if you move.
	Grace = 3,

	--[[ CRUCIFIX ]]
	Crucifix = {
		Enabled      = true,
		Range        = 40,
		RequireSight = true,  -- you have to be looking at him
		ConsumeTool  = true,  -- the crucifix is spent, as it is everywhere else
		RitualTime   = 4,
	},

	--[[ PRESENTATION ]]
	-- His own jumpscare frame, which ships inside the model. Off makes his
	-- kill silent and instant.
	Jumpscare = true,

	-- Distance in studs at which the close sounds take over from the far one.
	CloseDistance = 35,

	Debug = true,
}

