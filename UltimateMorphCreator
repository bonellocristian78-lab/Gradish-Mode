---====== ITS STATE: the morph you work on, the one you take a piece from, the piece ======---

local S = { target = nil, targetName = "", source = nil, sourceName = "", asset = nil, assetName = "", picked = nil, morphs = {}, analysis = nil,
	analysedAt = 0, nextLoose = 0, pieces = {}, fx = {}, palette = {}, map = {}, fov = nil, orbiting = false }
local MINE = "Il mio personaggio"
-- A morph's name (the morphs on the map are a "Character" in a model named after them)
local function nameOf(m)
	if m.Name == "Character" and m.Parent and m.Parent ~= workspace then return m.Parent.Name end
	return m.Name
end
local function morphValues(withMine)
	local morphs, names = Find.morphs()
	S.morphs = morphs
	local values = {}
	if withMine then table.insert(values, MINE) end
	if S.picked and S.picked.Parent then table.insert(values, "Toccato: " .. nameOf(S.picked)) end
	for _, n in ipairs(names) do table.insert(values, "Morph: " .. n) end
	return values
end
local function resolveMorph(label)
	if label == MINE then return U.character() end
	if type(label) ~= "string" then return nil end
	if S.picked and label == "Toccato: " .. nameOf(S.picked) then return S.picked end
	local name = label:match("^Morph: (.+)$")
	return if name then S.morphs[name] else nil
end
local Guide = { labels = {} }
-- A choice's name as it is shown ("Morph: UTC" -> "UTC")
local function display(label) return (label:gsub("^Morph: ", ""):gsub("^Toccato: ", "")) end
local function setTarget(model, label)
	S.target, S.targetName, S.analysis, S.nextLoose = model, if label then display(label) elseif model then nameOf(model) else "", nil, 0
	Mark.clear("target")
	if model then
		Mark.glow("target", model, BLUE)
		task.delay(2.5, function() Mark.clear("target") end)
	end
	Guide.refresh()
end
local function setAsset(inst, label)
	S.asset, S.assetName = inst, label or (if inst then inst.Name else "")
	Mark.clear("asset")
	if inst then Mark.glow("asset", inst, YELLOW) end
	Guide.refresh()
end
local function setSource(model, label)
	S.source, S.sourceName = model, label or ""
	S.pieces = if model then Find.pieces(model) else {}
	local labels = {}
	for _, p in ipairs(S.pieces) do table.insert(labels, p.label) end
	if Options.UMC_Piece then Options.UMC_Piece:SetValues(labels) end
end
-- Its body's analysis (every so often, or now)
local function analysis(now)
	if not (S.target and S.target.Parent) then return nil end
	if now or not S.analysis or os.clock() - S.analysedAt > 1 then
		S.analysis = Welds.analyze(S.target)
		S.analysedAt = os.clock()
	end
	return S.analysis
end
-- Somewhere near it (yours: your private server)
local function goTo(thing)
	if not U.privateOwner() then
		U.notify(TITLE, "Solo nel tuo server privato.", 4)
		return
	end
	local at, character = U.where(thing), U.character()
	if not (at and character) then return end
	local look = flat(workspace.CurrentCamera.CFrame.LookVector)
	local from = at - look * 7 + Vector3.new(0, 3, 0)
	pcall(function() character:PivotTo(CFrame.lookAt(from, Vector3.new(at.X, from.Y, at.Z))) end)
end
local function orbit(thing)
	View.orbit(thing)
	S.orbiting = thing ~= nil
end
local function mark(ok) return if ok then GOOD else BAD end

---====== THE GUIDE: the way the game's morphs are made, step by step, each step checked ======---

function Guide.status()
	local out = {}
	local build, save = U.buildTool(), U.saveTool()
	out[1] = string.format("Fork3x/BTools %s · SaveMorphTool %s · server privato %s", mark(build ~= nil), mark(save ~= nil), mark(U.privateOwner()))
	local a = analysis(false)
	if S.target and S.target.Parent then
		out[2] = string.format("%s · ancorato %s · %d pezzi", S.targetName, mark(a and a.anchored), a and a.parts or 0)
	else
		out[2] = "Scegli il morph su cui lavori."
	end
	if S.asset and S.asset.Parent then
		out[3] = "Pezzo: " .. S.assetName .. (if S.sourceName ~= "" then " (da " .. S.sourceName .. ")" else "")
		local inside = S.target ~= nil and S.asset:IsDescendantOf(S.target)
		local best = nil
		if a then
			for _, p in ipairs(U.partsOf(S.asset)) do
				for b in pairs(a.heldSet) do
					if b == S.asset or b:IsDescendantOf(S.asset) then continue end
					local d = U.boxDistance(b, p.Position)
					if not best or d < best then best = d end
				end
			end
		end
		out[4] = if best then string.format("A %.1f stud dal corpo del morph.", best) else "Avvicinalo al morph."
		out[5] = "Dentro il morph: " .. mark(inside)
		if a and inside then
			local group = Welds.groupOf(a, S.asset)
			out[6] = if Welds.holds(a, S.asset) then "Saldato al corpo " .. GOOD
				elseif group and group.to then string.format("Da saldare a %s (a %.1f stud) %s", group.to.Name, group.distance, WARN)
				else "Da saldare " .. WARN
		else
			out[6] = "Prima mettilo dentro il morph."
		end
	else
		out[3], out[4], out[5], out[6] = "Scegli il pezzo da prendere.", "—", "—", "—"
	end
	out[7] = if a then (if #a.loose == 0 then "Niente cadrebbe " .. GOOD else string.format("%d gruppi di pezzi cadrebbero %s (scheda Saldature)", #a.loose, WARN)) else "—"
	out[8] = "SaveMorphTool " .. mark(save ~= nil) .. (if save and save.Parent == U.character() then " (in mano)" else "")
	return out
end
function Guide.refresh()
	local ok, out = pcall(Guide.status)
	if not ok then return end
	for i, label in pairs(Guide.labels) do
		if out[i] and label.Text ~= out[i] then pcall(function() label:SetText(out[i]) end) end
	end
end

