local S = { target = nil, targetIsMe = false, asset = nil, assetName = "", sourceName = "", analysis = nil, analysedAt = 0, glow = nil,
	colorParts = {}, colorScope = nil, fx = {}, fxKey = nil, menuWasOpen = false, loose = nil }
local UI = { labels = {}, ready = false }
local function mark(ok) return if ok then GOOD else BAD end
-- Its body's analysis (every second, or now)
local function analysis(now)
	if not (S.target and S.target.Parent) then return nil end
	if now or not S.analysis or os.clock() - S.analysedAt > 1 then
		S.analysis = Welds.analyze(S.target)
		S.analysedAt = os.clock()
	end
	return S.analysis
end
local function setTarget(model, isMe)
	S.target, S.targetIsMe, S.analysis, S.fxKey = model, isMe == true, nil, nil
	Mark.clear("target")
	if model then
		local glow = {}
		S.glow = glow
		Mark.glow("target", model, BLUE)
