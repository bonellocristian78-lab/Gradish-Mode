---====== THE MAP: the morphs on it, their pieces, their bodies ======---

local Find = {}
local BODY = {}
for _, n in ipairs({ "Head", "Torso", "UpperTorso", "LowerTorso", "HumanoidRootPart", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "LeftUpperArm",
	"LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg",
	"RightFoot" }) do BODY[n] = true end
Find.BODY = BODY
-- The morphs' models on the map (Workspace.Morphs: each its pad and its Character): name -> its Character
function Find.morphs()
	local out, names = {}, {}
	local folder = workspace:FindFirstChild("Morphs")
	if folder then
		for _, m in ipairs(folder:GetChildren()) do
			local character = m:FindFirstChild("Character")
			if character and character:IsA("Model") and not out[m.Name] then
				out[m.Name] = character
				table.insert(names, m.Name)
			end
		end
	end
	table.sort(names, function(a, b) return a:lower() < b:lower() end)
	return out, names
end
-- The morph (a model with a Humanoid, or a morph's Character) something is in
function Find.characterOf(i)
	local m = i:FindFirstAncestorWhichIsA("Model")
	if i:IsA("Model") then m = i end
	while m do
		if m:FindFirstChildOfClass("Humanoid") or m.Name == "Character" then return m end
		m = m:FindFirstAncestorWhichIsA("Model")
	end
	return nil
end
-- The piece of a model something belongs to: what it is in right under the model
function Find.pieceOf(i, model)
	local p = i
	while p.Parent and p.Parent ~= model do p = p.Parent end
	return if p.Parent == model then p else i
end
-- Its pieces: what is right under it (parts, models, accessories), named, its body parts marked
function Find.pieces(model)
	local list, count = {}, {}
	for _, c in ipairs(model:GetChildren()) do
		if c:IsA("BasePart") or c:IsA("Model") or c:IsA("Accessory") or c:IsA("Folder") then
			count[c.Name] = (count[c.Name] or 0) + 1
			local label = c.Name .. (if count[c.Name] > 1 then " #" .. count[c.Name] else "")
			if BODY[c.Name] then label = label .. " (corpo)" end
			table.insert(list, { label = label, inst = c })
		end
	end
	table.sort(list, function(a, b) return a.label:lower() < b.label:lower() end)
	return list
end

