function UI.saldature()
	local tab = Tabs.Saldature
	local box = tab:AddLeftGroupbox("Cosa cadrebbe nel vuoto", "triangle-alert")
	local summary = box:AddLabel({ Text = "Scegli un morph e controllalo.", DoesWrap = true })
	local list = box:AddLabel({ Text = "", DoesWrap = true })
	local function show()
		local a = analysis(true)
		Mark.clear("loose")
		if not a then
			summary:SetText("Scegli un morph (Crea, passo 2) o controlla te stesso.")
			list:SetText("")
			return
		end
		local count = 0
		for _, g in ipairs(a.loose) do count += #g.parts end
		summary:SetText(string.format("%s: %d pezzi · %d saldati al corpo · %d staccati in %d gruppi%s", S.targetName, a.parts, a.held, count, #a.loose,
			if #a.loose == 0 then " " .. GOOD else ""))
		local lines = {}
		for i, g in ipairs(a.loose) do
			if i > 12 then
				table.insert(lines, "… e altri " .. (#a.loose - 12))
				break
			end
			table.insert(lines, "• " .. Welds.line(g))
		end
		list:SetText(table.concat(lines, "\n"))
		if Toggles.UMC_ShowLoose and Toggles.UMC_ShowLoose.Value then
			local boxes = 0
			for _, g in ipairs(a.loose) do
				for _, p in ipairs(g.parts) do
					boxes += 1
					if boxes <= 400 then Mark.box("loose", p, RED) end
				end
			end
		end
	end
	box:AddButton({ Text = "Controlla il morph scelto", Func = show }):AddButton({ Text = "Controlla me", Func = function()
		Options.UMC_Target:SetValue(MINE)
		show()
	end })
	box:AddToggle("UMC_ShowLoose", { Text = "Evidenzia in rosso i pezzi staccati", Default = true, Callback = function() show() end })
	box:AddButton({ Text = "Prossimo pezzo staccato", Func = function()
		local a = analysis(true)
		if not a or #a.loose == 0 then return U.notify(TITLE, "Niente da saldare.", 3) end
		S.nextLoose = S.nextLoose % #a.loose + 1
		local g = a.loose[S.nextLoose]
		Mark.clear("weld")
		Mark.glow("weld", g.piece, YELLOW)
		if g.to then Mark.glow("weld", g.to, GREEN) end
		orbit(g.main)
		U.notify(string.format("Pezzo %d di %d", S.nextLoose, #a.loose), Welds.line(g), 6)
	end }):AddButton({ Text = "Copia l'elenco", Func = function()
		local a = analysis(true)
		if not a then return end
		local lines = {}
		for _, g in ipairs(a.loose) do table.insert(lines, Welds.line(g)) end
		U.copy(if #lines > 0 then table.concat(lines, "\n") else "Niente da saldare")
	end })
	local help = tab:AddRightGroupbox("Come leggerlo", "info")
	text(help, "In rosso: i pezzi non saldati al corpo del morph. Quando lo usi e scrivi ;thaw si sganciano e cadono. Per ognuno ti dico la parte del corpo più vicina a cui saldarlo. Più pezzi già saldati tra loro sono un gruppo: basta una saldatura.")
	text(help, "Giallo: il pezzo. Verde: dove saldarlo. Seleziona prima il giallo, poi con Ctrl il verde, poi Salda (F).")
	help:AddButton({ Text = "Torna alla tua telecamera", Func = function() orbit(nil) end })
end

