	return U.tool(function(n) return n:find("fork3x", 1, true) ~= nil or n:find("f3x", 1, true) ~= nil or n:find("btool", 1, true) ~= nil or n:find("building", 1, true) ~= nil end)
end
function U.saveTool() return U.tool(function(n) return n:find("savemorph", 1, true) ~= nil end) end
function U.equip(tool)
	local humanoid = U.humanoid()
	if tool and humanoid then pcall(function() humanoid:EquipTool(tool) end) end
