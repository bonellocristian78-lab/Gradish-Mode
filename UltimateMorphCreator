local function setTarget(model, isMe)
	S.target, S.targetIsMe, S.analysis, S.fxKey = model, isMe == true, nil, nil
	Mark.clear("target")
	if model then
		local glow = {}
		S.glow = glow
		Mark.glow("target", model, BLUE)
		task.delay(2, function()
			if S.glow == glow then Mark.clear("target") end
		end)
	end
