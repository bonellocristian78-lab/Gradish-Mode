function UI.set(name, text)
	local label = UI.labels[name]
	if label and label.Text ~= text then pcall(function() label:SetText(text) end) end
end
function UI.refresh()
	if not UI.ready then return end
	local t = if S.target and S.target.Parent then S.target else nil
	local a = analysis(false)
	UI.set("morph", if t then string.format("%s · %d parts · anchored %s", Find.nameOf(t), a and a.parts or 0, mark(a and a.anchored)) else "No morph yet. Tap Morph, then tap it.")
	if S.asset and S.asset.Parent then
		local inside = t ~= nil and S.asset:IsDescendantOf(t)
		UI.set("piece", string.format("%s · inside %s · welded %s", S.assetName, mark(inside), mark(inside and a ~= nil and Welds.holds(a, S.asset))))
	else
		UI.set("piece", "No piece yet.")
	end
	if not a then
		UI.set("weld", "Pick your morph first.")
	elseif #a.loose == 0 then
		UI.set("weld", "Nothing will fall " .. GOOD)
	else
		UI.set("weld", string.format("%d %s will fall %s", #a.loose, if #a.loose == 1 then "piece" else "pieces", BAD))
	end
	UI.set("tools", string.format("Fork3x %s · Save Tool %s · Private server %s", mark(U.buildTool() ~= nil), mark(U.saveTool() ~= nil), mark(U.privateOwner())))
	-- its effects, listed again when they change
	local fx = if t then Fx.list(t) else {}
	local labels = {}
	for _, f in ipairs(fx) do table.insert(labels, f.label) end
	local key = table.concat(labels, "\n")
	if key ~= S.fxKey then
		S.fxKey, S.fx = key, fx
		pcall(function() Options.UMC_Fx:SetValues(labels) end)
		UI.set("fx", if not t then "Pick your morph first." elseif #fx == 0 then "No effects on " .. Find.nameOf(t) .. "." else #fx .. " effects. Pick one.")
	end
	-- its loose parts in red (drawn again only when they change)
	local show = Toggles.UMC_ShowLoose ~= nil and Toggles.UMC_ShowLoose.Value == true and a ~= nil
	local parts = {}
	if show then
		for _, g in ipairs(a.loose) do
			for _, p in ipairs(g.parts) do table.insert(parts, p) end
		end
	end
	local same = S.loose ~= nil and #S.loose == #parts
	if same then
		for i, p in ipairs(parts) do
			if S.loose[i] ~= p then same = false end
		end
	end
	if not same then
		S.loose = parts
		Mark.clear("loose")
		for i, p in ipairs(parts) do
			if i <= 80 then Mark.box("loose", p, RED) end
		end
	end
end

