local function stop()
	if not C.alive then return end
	C.alive = false
	Pick.cb = nil
	Keys.releaseAll()
	for _, c in ipairs(C.connections) do pcall(function() c:Disconnect() end) end
	Paint.restore()
	View.mirror(nil)
	Cat.takeOff()
	if S.orbiting then pcall(function() workspace.CurrentCamera.CameraSubject = U.humanoid() end) end
	if S.fov then pcall(function() workspace.CurrentCamera.FieldOfView = S.fov end) end
	for group in pairs(Mark.groups) do Mark.clear(group) end
	if Pad.gui then pcall(function() Pad.gui:Destroy() end) end
	for _, m in ipairs(C.made) do pcall(function() m:Destroy() end) end
	if not Library.Unloaded then pcall(function() Library:Unload() end) end
end
pcall(function() Library:OnUnload(stop) end)
GENV.__UMCStop = stop
U.notify(TITLE, if U.privateOwner() then "Pronto. Segui la guida nella scheda Crea." else "Pronto. Fork3x e SaveMorphTool li hai nel tuo server privato.", 6)
