local HOTKEYS = {
	[Enum.KeyCode.F2] = function() Flow.run(Flows.add) end,
	[Enum.KeyCode.F3] = function() Flow.run(function() Flows.weld(nil) end) end,
	[Enum.KeyCode.F4] = function() Flow.run(Flows.test) end,
	[Enum.KeyCode.F5] = function() Flow.run(Flows.pickMorph) end,
	[Enum.KeyCode.F6] = function() Flow.run(Flows.color) end,
	[Enum.KeyCode.F7] = function() Flow.run(Flows.undo) end,
	[Enum.KeyCode.F8] = goBack,
}
on(UserInputService.InputBegan, function(input, processed)
	if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local action = HOTKEYS[input.KeyCode]
	if action then action() end
end)

