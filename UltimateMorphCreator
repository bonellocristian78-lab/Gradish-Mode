	prev:AddButton({ Text = "Copia MeshId", Func = function()
		local mesh = Cat.meshOf(Cat.loaded)
		if mesh then U.copy(tostring(mesh)) else U.notify(TITLE, "Non ha una mesh (o non è ancora caricato).", 3) end
	end }):AddButton({ Text = "Copia TextureId", Func = function()
		local _, texture = Cat.meshOf(Cat.loaded)
		if texture then U.copy(tostring(texture)) else U.notify(TITLE, "Non ha una texture.", 3) end
	end })
	prev:AddButton({ Text = "Prova addosso (solo tu)", Func = function()
		if not Cat.loaded then return U.notify(TITLE, "Scegli un risultato e aspetta che si carichi.", 3) end
		if not Cat.tryOn(Cat.loaded) then U.notify(TITLE, "Non riesco a mostrarlo.", 3) end
	end }):AddButton({ Text = "Togli", Func = Cat.takeOff })
	prev:AddButton({ Text = "Copia ID", Func = function()
		local r = current()
		if r then U.copy(tostring(r.id)) end
	end })
	text(prev, "Nello strumento Mesh (H) del Fork3x incolla MeshId e TextureId (o l'ID dell'UGC): così il pezzo lo vedono tutti.")
