function U.volume(p) return p.Size.X * p.Size.Y * p.Size.Z end
-- How far a point is from a part (from its box: 0 inside it)
function U.boxDistance(part, point)
	local l = part.CFrame:PointToObjectSpace(point)
	local h = part.Size / 2
	local c = Vector3.new(math.clamp(l.X, -h.X, h.X), math.clamp(l.Y, -h.Y, h.Y), math.clamp(l.Z, -h.Z, h.Z))
	return (l - c).Magnitude
end
