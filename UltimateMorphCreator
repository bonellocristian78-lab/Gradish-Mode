	if requestFn then
		local ok, res = pcall(requestFn, { Url = url, Method = "GET" })
		if ok and type(res) == "table" and type(res.Body) == "string" and (tonumber(res.StatusCode) or 200) < 400 then return res.Body end
	end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	return if ok and type(body) == "string" then body else nil
end
