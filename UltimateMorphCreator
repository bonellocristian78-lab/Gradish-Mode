local Find = {}
local BODY = {}
for _, n in ipairs({ "Head", "Torso", "UpperTorso", "LowerTorso", "HumanoidRootPart", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "LeftUpperArm",
	"LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg",
	"RightFoot" }) do BODY[n] = true end
-- The morph (a model with a Humanoid, or a morph's Character) something is in
function Find.characterOf(i)
	local m = i:FindFirstAncestorWhichIsA("Model")
	if i:IsA("Model") then m = i end
	while m do
		if m:FindFirstChildOfClass("Humanoid") or m.Name == "Character" then return m end
		m = m:FindFirstAncestorWhichIsA("Model")
	end
	return nil
end
-- The piece of a model something belongs to: what it is in right under the model
function Find.pieceOf(i, model)
	local p = i
	while p.Parent and p.Parent ~= model do p = p.Parent end
	return if p.Parent == model then p else i
end
-- A morph's name (the morphs on the map are a "Character" in a model named after them)
function Find.nameOf(m)
	if m.Name == "Character" and m.Parent and m.Parent ~= workspace then return m.Parent.Name end
	return m.Name
end

