---====== WELDS: what holds to a morph's body, what would fall (its parts not joined to its root) ======---

local Welds = {}
-- { root, parts, held, loose = { { parts, main, piece, to, distance } (biggest first) }, anchored, heldSet }
function Welds.analyze(model)
	local parts, inModel = {}, {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(parts, d)
			inModel[d] = true
		end
	end
	local links, rig = {}, {}
	local function link(a, b, motor)
		if not (a and b and inModel[a] and inModel[b]) or a == b then return end
		links[a] = links[a] or {}
		links[b] = links[b] or {}
		table.insert(links[a], b)
		table.insert(links[b], a)
		if motor then rig[a], rig[b] = true, true end
	end
	for _, d in ipairs(model:GetDescendants()) do -- (welds, motors, weld constraints, rigid constraints: what joins)
		if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
			if d.Enabled ~= false then link(d.Part0, d.Part1, d:IsA("Motor6D")) end
		elseif d:IsA("RigidConstraint") then
			local a0, a1 = d.Attachment0, d.Attachment1
			if d.Enabled ~= false and a0 and a1 then link(a0.Parent, a1.Parent) end
		end
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then root = model.PrimaryPart end
	if not root then
		for _, p in ipairs(parts) do
			if not root or U.volume(p) > U.volume(root) then root = p end
		end
	end
	local held, heldCount = {}, 0
	if root then
		local queue, i = { root }, 1
		held[root] = true
		while queue[i] do
			for _, n in ipairs(links[queue[i]] or {}) do
				if not held[n] then
					held[n] = true
					table.insert(queue, n)
				end
			end
			i += 1
		end
	end
	local body = {} -- (its body: the rig's parts, else all that holds)
	for p in pairs(held) do
		heldCount += 1
		if rig[p] or p == root or BODY[p.Name] then table.insert(body, p) end
	end
	if #body == 0 then
		for p in pairs(held) do table.insert(body, p) end
	end
	local loose, seen = {}, {}
	for _, p in ipairs(parts) do
		if not held[p] and not seen[p] then -- (a group of loose parts joined to each other: one weld holds them all)
			local group, queue, k = {}, { p }, 1
			seen[p] = true
			while queue[k] do
				local q = queue[k]
				table.insert(group, q)
				for _, n in ipairs(links[q] or {}) do
					if not seen[n] and not held[n] then
						seen[n] = true
						table.insert(queue, n)
					end
				end
				k += 1
			end
			local main = group[1]
			for _, q in ipairs(group) do
				if U.volume(q) > U.volume(main) then main = q end
			end
			local best, bestD = nil, math.huge
			for _, b in ipairs(body) do
				for _, q in ipairs(group) do
					local d = U.boxDistance(b, q.Position)
					if d < bestD then best, bestD = b, d end
				end
			end
			table.insert(loose, { parts = group, main = main, piece = Find.pieceOf(main, model), to = best, distance = bestD })
		end
	end
	table.sort(loose, function(a, b) return #a.parts > #b.parts end)
	return { model = model, root = root, parts = #parts, held = heldCount, loose = loose, heldSet = held,
		anchored = root ~= nil and root.Anchored == true }
end
-- Is all of it held to the morph's body?
function Welds.holds(analysis, thing)
	for _, p in ipairs(U.partsOf(thing)) do
		if not analysis.heldSet[p] then return false end
	end
	return true
end
-- The loose group a thing is in, if any
function Welds.groupOf(analysis, thing)
	local mine = {}
	for _, p in ipairs(U.partsOf(thing)) do mine[p] = true end
	for _, g in ipairs(analysis.loose) do
		for _, p in ipairs(g.parts) do
			if mine[p] then return g end
		end
	end
	return nil
end
function Welds.line(g)
	return string.format("%s%s → %s (%.1f st)", g.piece.Name, if #g.parts > 1 then " (" .. #g.parts .. " pezzi)" else "",
		if g.to then g.to.Name else "?", math.min(g.distance, 999))
end

---====== COLOURS: a morph's palette, recoloured first only for you, the codes to paint it with ======---

local Paint = {}
local function key3(c) return string.format("%02X%02X%02X", byte(c.R), byte(c.G), byte(c.B)) end
-- Its colours: { key, color, parts } (the most used first)
function Paint.palette(model)
	local map, list = {}, {}
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p.Transparency < 1 then
			local k = key3(p.Color)
			local e = map[k]
			if not e then
				e = { key = k, color = p.Color, parts = {} }
				map[k] = e
				table.insert(list, e)
			end
			table.insert(e.parts, p)
		end
	end
	table.sort(list, function(a, b) return #a.parts > #b.parts end)
	return list
end
function Paint.label(e) return "#" .. e.key .. " · " .. #e.parts .. (if #e.parts == 1 then " pezzo" else " pezzi") end
-- Changed only on your screen, its own value kept to put back
function Paint.set(inst, prop, value)
	local r = C.restore[inst]
	if not r then
		r = {}
		C.restore[inst] = r
	end
	if r[prop] == nil then r[prop] = { inst[prop] } end
	inst[prop] = value
end
-- Puts back what was changed (all of it, or only in `within`)
function Paint.restore(within)
	for inst, props in pairs(C.restore) do
		if not within or inst == within or inst:IsDescendantOf(within) then
			for prop, box in pairs(props) do pcall(function() inst[prop] = box[1] end) end
			C.restore[inst] = nil
		end
	end
end
-- Ramps: from its dark to its light, { at, r, g, b }
Paint.PRESETS = {
	{ "Oro", { { 0, 60, 38, 6 }, { 0.45, 190, 140, 30 }, { 0.8, 255, 214, 90 }, { 1, 255, 246, 200 } } },
	{ "Ombra", { { 0, 8, 6, 14 }, { 0.5, 46, 20, 72 }, { 1, 150, 90, 220 } } },
	{ "Neon blu", { { 0, 4, 10, 40 }, { 0.5, 20, 90, 220 }, { 1, 140, 240, 255 } } },
	{ "Rosso sangue", { { 0, 16, 0, 0 }, { 0.5, 120, 10, 14 }, { 1, 255, 80, 70 } } },
	{ "Titanio", { { 0, 40, 44, 50 }, { 0.5, 130, 136, 146 }, { 1, 236, 240, 246 } } },
	{ "Smeraldo", { { 0, 2, 26, 12 }, { 0.5, 20, 130, 70 }, { 1, 150, 255, 180 } } },
	{ "Fuoco", { { 0, 30, 4, 0 }, { 0.4, 200, 50, 0 }, { 0.75, 255, 160, 20 }, { 1, 255, 240, 160 } } },
	{ "Ghiaccio", { { 0, 20, 40, 70 }, { 0.5, 110, 180, 230 }, { 1, 240, 252, 255 } } },
	{ "Inverti", "invert" },
	{ "Arcobaleno", "rainbow" },
}
function Paint.luma(c) return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B end
function Paint.ramp(stops, l)
	for i = 2, #stops do
		local a, b = stops[i - 1], stops[i]
		if l <= b[1] then
			local u = (l - a[1]) / math.max(b[1] - a[1], 1e-6)
			return Color3.fromRGB(a[2] + (b[2] - a[2]) * u, a[3] + (b[3] - a[3]) * u, a[4] + (b[4] - a[4]) * u)
		end
	end
	local last = stops[#stops]
	return Color3.fromRGB(last[2], last[3], last[4])
end
-- Its palette in a preset's colours, on your screen: the list of { from, to, count } to paint with
function Paint.preset(model, name)
	local stops = nil
	for _, p in ipairs(Paint.PRESETS) do
		if p[1] == name then stops = p[2] end
	end
	if not stops then return {} end
	local out = {}
	for i, e in ipairs(Paint.palette(model)) do
		local to
		if stops == "invert" then
			to = Color3.new(1 - e.color.R, 1 - e.color.G, 1 - e.color.B)
		elseif stops == "rainbow" then
			to = Color3.fromHSV(((i - 1) * 0.13) % 1, 0.85, 0.35 + Paint.luma(e.color) * 0.65)
		else
			to = Paint.ramp(stops, Paint.luma(e.color))
		end
		for _, p in ipairs(e.parts) do Paint.set(p, "Color", to) end
		table.insert(out, { from = e.color, to = to, count = #e.parts })
	end
	return out
end
function Paint.mapText(map)
	local lines = {}
	for _, m in ipairs(map) do
		table.insert(lines, string.format("%s → %s (%s) · %d", U.hex(m.from), U.hex(m.to), U.rgb(m.to), m.count))
	end
	return table.concat(lines, "\n")
end

---====== EFFECTS: a morph's particles, fire, smoke, sparkles, beams, trails, lights: their colours ======---

local Fx = {}
local FX = { ParticleEmitter = true, Fire = true, Smoke = true, Sparkles = true, Beam = true, Trail = true, PointLight = true, SpotLight = true, SurfaceLight = true }
function Fx.list(model)
	local list, count = {}, {}
	for _, d in ipairs(model:GetDescendants()) do
		if FX[d.ClassName] then
			local base = d.ClassName .. " «" .. d.Name .. "» su " .. (if d.Parent then d.Parent.Name else "?")
			count[base] = (count[base] or 0) + 1
			table.insert(list, { label = base .. (if count[base] > 1 then " #" .. count[base] else ""), inst = d })
		end
	end
	return list
end
function Fx.colorOf(i)
	local ok, c = pcall(function()
		if i:IsA("ParticleEmitter") or i:IsA("Beam") or i:IsA("Trail") then return i.Color.Keypoints[1].Value end
		if i:IsA("Sparkles") then return i.SparkleColor end
		return i.Color
	end)
	return if ok and c then c else Color3.new(1, 1, 1)
end
-- Its colour on your screen (from one colour to another, where it has two)
function Fx.preview(i, a, b)
	if i:IsA("ParticleEmitter") or i:IsA("Beam") or i:IsA("Trail") then
		Paint.set(i, "Color", ColorSequence.new(a, b or a))
	elseif i:IsA("Fire") then
		Paint.set(i, "Color", a)
		Paint.set(i, "SecondaryColor", b or a)
	elseif i:IsA("Sparkles") then
		Paint.set(i, "SparkleColor", a)
	else
		Paint.set(i, "Color", a)
	end
end
-- Which of the building tools changes it (the Decorate tool: fire, smoke, sparkles; Lighting: lights)
function Fx.toolFor(i)
	if i:IsA("Fire") or i:IsA("Smoke") or i:IsA("Sparkles") then return "Decora (P)" end
	if i:IsA("Light") then return "Luci (U)" end
	return nil
end

---====== KEYS: the building tools' shortcuts pressed for you (their own keys: as if you pressed them) ======---

local Keys = { held = {} }
pcall(function() Keys.vim = game:GetService("VirtualInputManager") end)
function Keys.send(name, down)
	if not Keys.vim then return false end
	return pcall(function() Keys.vim:SendKeyEvent(down, Enum.KeyCode[name], false, game) end)
end
-- A shortcut: its modifiers held (unless you already hold them), its key tapped; the other keys you hold let go meanwhile (Ctrl+Z is not Z)
function Keys.tap(mods, key, times)
	task.spawn(function()
		while Keys.busy do task.wait(0.05) end -- (one shortcut after the other: never two mixed)
		Keys.busy = true
		local ok, lifted = true, {}
		for m in pairs(Keys.held) do
			if not table.find(mods, m) then
				Keys.send(m, false)
				table.insert(lifted, m)
			end
		end
		for _ = 1, times or 1 do
			for _, m in ipairs(mods) do
				if not Keys.held[m] then Keys.send(m, true) end
			end
			task.wait(0.03)
			ok = Keys.send(key, true) and ok
			task.wait(0.05)
			Keys.send(key, false)
			task.wait(0.03)
			for i = #mods, 1, -1 do
				if not Keys.held[mods[i]] then Keys.send(mods[i], false) end
			end
			task.wait(0.2)
		end
		for _, m in ipairs(lifted) do
			if Keys.held[m] then Keys.send(m, true) end
		end
		Keys.busy = false
		if not ok then U.notify(TITLE, "Il tuo executor non permette i tasti virtuali: usa la tastiera o i pulsanti del Fork3x.", 6) end
	end)
end
-- A modifier held down (Ctrl: to pick more parts), or let go
function Keys.hold(name, down)
	Keys.held[name] = if down then true else nil
	Keys.send(name, down)
end
function Keys.releaseAll()
	for name in pairs(Keys.held) do Keys.send(name, false) end
	table.clear(Keys.held)
end
