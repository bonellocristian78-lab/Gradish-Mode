---====== TAPS: the next tap on the world (a tap, not a drag that turns the camera; not on a button) ======---

local Tap = { cb = nil, down = {} }
function Tap.wait(cb) Tap.cb = cb end
function Tap.cancel()
	Tap.cb = nil
	table.clear(Tap.down)
end
local function tapKey(input) return if input.UserInputType == Enum.UserInputType.MouseButton1 then "mouse" else input end
on(UserInputService.InputBegan, function(input, processed)
	if processed or not Tap.cb then return end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
	Tap.down[tapKey(input)] = { at = input.Position, t = os.clock() }
end)
on(UserInputService.InputEnded, function(input)
	local key = tapKey(input)
	local d = Tap.down[key]
	if not d then return end
	Tap.down[key] = nil
	if not Tap.cb or (input.Position - d.at).Magnitude > 16 or os.clock() - d.t > 0.7 then return end
	local camera = workspace.CurrentCamera
	local ray = camera:ScreenPointToRay(input.Position.X, input.Position.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { helpers }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 1500, params)
	if not (hit and hit.Instance) then
		U.notify(TITLE, "Nothing there. " .. TAP .. " again.", 2)
		return
	end
	local cb = Tap.cb
	Tap.cb = nil
	cb(hit.Instance, hit.Position)
end)

---====== THE CATALOG AND THE TOOLBOX: found, seen, their ids for Fork3x ======---

local Cat = { results = {}, loaded = nil, tried = nil }
-- Searched: "ugc" (the catalog's accessories: their meshes for the Mesh tool) or "toolbox" (models)
function Cat.search(source, keyword)
	local out = {}
	local q = HttpService:UrlEncode(keyword)
	if source == "ugc" then
		local data = U.json(U.get("https://catalog.roblox.com/v1/search/items/details?Category=11&Limit=30&Keyword=" .. q))
		for _, item in ipairs(data and data.data or {}) do
			if item.id and (item.itemType == nil or item.itemType == "Asset") then
				table.insert(out, { id = item.id, name = tostring(item.name), creator = tostring(item.creatorName or "?"), kind = "Accessory" })
			end
		end
	else
		local data = U.json(U.get("https://apis.roblox.com/toolbox-service/v1/marketplace/10?num=30&keyword=" .. q))
		local ids = {}
		for _, item in ipairs(data and data.data or {}) do
			if item.id then table.insert(ids, tostring(item.id)) end
		end
		local details = if #ids > 0 then U.json(U.get("https://apis.roblox.com/toolbox-service/v1/items/details?assetIds=" .. table.concat(ids, ","))) else nil
		for _, d in ipairs(details and details.data or {}) do
			local a = d.asset or {}
			local counts = a.modelTechnicalDetails and a.modelTechnicalDetails.instanceCounts
			if a.id then
				table.insert(out, { id = a.id, name = tostring(a.name), creator = tostring(d.creator and d.creator.name or "?"), kind = "Model",
					scripts = counts and counts.script or 0 })
			end
		end
	end
	Cat.results = out
	return out
end
-- Its line in the list (short: it has to fit)
function Cat.label(r)
	local name = if #r.name > 24 then r.name:sub(1, 22) .. "…" else r.name
	return name .. " · " .. tostring(r.id)
end
-- Loaded here (only for you), without its scripts
function Cat.load(id)
	local ok, obj = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(id))[1] end)
	if not (ok and typeof(obj) == "Instance") then return nil end
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then d:Destroy() end
	end
	return obj
end
-- Its mesh and its texture (what the Mesh tool asks for)
function Cat.meshOf(obj)
	if not obj then return nil, nil end
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("SpecialMesh") or d:IsA("FileMesh") then return d.MeshId, d.TextureId end
		if d:IsA("MeshPart") then return d.MeshId, d.TextureID end
	end
	if obj:IsA("MeshPart") then return obj.MeshId, obj.TextureID end
	return nil, nil
end
-- What can be shown of it (a part or a model)
function Cat.viewable(obj)
	if not obj then return nil end
	if obj:IsA("Model") or obj:IsA("BasePart") then return obj end
	local m = Instance.new("Model")
	m.Name = obj.Name
	for _, c in ipairs(obj:GetChildren()) do c:Clone().Parent = m end
	return m
end
-- Tried on: an accessory on you, a model before you (only on your screen)
function Cat.tryOn(obj)
	Cat.takeOff()
	if not obj then return false end
	local copy = obj:Clone()
	local humanoid, root = U.humanoid(), U.root()
	if copy:IsA("Accessory") and humanoid then
		local ok = pcall(function() humanoid:AddAccessory(copy) end)
		if ok then
			Cat.tried = copy
			return true
		end
	end
	if not root then return false end
	local model = Cat.viewable(copy)
	for _, p in ipairs(U.partsOf(model)) do p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false end
	model.Parent = helpers
	local size = if model:IsA("Model") then select(2, model:GetBoundingBox()) else model.Size
	local look = flat(workspace.CurrentCamera.CFrame.LookVector)
	pcall(function() model:PivotTo(CFrame.new(root.Position + look * (math.max(size.X, size.Z) / 2 + 5))) end)
	Cat.tried = model
	return true
end
function Cat.takeOff()
	if Cat.tried then pcall(function() Cat.tried:Destroy() end) end
	Cat.tried = nil
end

