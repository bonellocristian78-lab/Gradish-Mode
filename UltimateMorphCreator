function UI.current()
	local v = Options.UMC_Results and Options.UMC_Results.Value
	for _, r in ipairs(Cat.results) do
		if Cat.label(r) == v then return r end
	end
	return nil
end
function UI.pick()
	local r = UI.current()
	if not r then return end
	pcall(function() Options.UMC_Thumb:SetImage("rbxthumb://type=Asset&id=" .. tostring(r.id) .. "&w=150&h=150") end)
	local info = string.format("%s by %s%s", r.kind, r.creator, if (r.scripts or 0) > 0 then " · has scripts" else "")
	UI.set("search", info .. " · loading…")
	Cat.loaded = nil
	task.spawn(function()
		local obj = Cat.load(r.id)
		if UI.current() ~= r then return end
		Cat.loaded = obj
		local mesh = Cat.meshOf(obj)
		UI.set("search", info .. (if not obj then " · can't load it" elseif mesh then " · has a mesh " .. GOOD else ""))
	end)
end
function UI.search()
	local tab = Tabs.Search
	local b1 = tab:AddLeftGroupbox("Find", "search")
	b1:AddInput("UMC_Keyword", { Text = "Search for", Default = "skibidi toilet", Placeholder = "skibidi toilet", ClearTextOnFocus = false, Finished = true })
	b1:AddDropdown("UMC_Where", { Values = { "Accessories", "Models" }, Default = 1, Text = "Type" })
	b1:AddButton({ Text = "Search", Func = function()
		UI.set("search", "Searching…")
		task.spawn(function()
			local word = Options.UMC_Keyword.Value
			local results = Cat.search(if Options.UMC_Where.Value == "Models" then "toolbox" else "ugc", if word ~= "" then word else "skibidi toilet")
			local labels = {}
			for _, r in ipairs(results) do table.insert(labels, Cat.label(r)) end
			Options.UMC_Results:SetValues(labels)
			UI.set("search", if #results > 0 then #results .. " results. Pick one." else "Nothing found (or your executor can't read the web).")
		end)
	end })
	b1:AddDropdown("UMC_Results", { Values = {}, Text = "Results", Callback = function() UI.pick() end })
	UI.labels.search = label(b1, "Accessories: their mesh goes in Fork3x's Mesh tool.")

	local b2 = tab:AddRightGroupbox("Item", "box")
	b2:AddImage("UMC_Thumb", { Image = "rbxasset://textures/ui/GuiImagePlaceholder.png", Height = 120 })
	b2:AddButton({ Text = "Copy ID", Func = function()
		local r = UI.current()
		if r then U.copy(tostring(r.id)) else U.notify(TITLE, "Pick a result first.", 3) end
	end }):AddButton({ Text = "Try On", Func = function()
		if not Cat.loaded then return U.notify(TITLE, "Pick a result and wait a moment.", 3) end
		if not Cat.tryOn(Cat.loaded) then U.notify(TITLE, "Can't show it.", 3) end
	end })
	b2:AddButton({ Text = "Mesh ID", Func = function()
		local mesh = Cat.meshOf(Cat.loaded)
		if mesh then U.copy(tostring(mesh)) else U.notify(TITLE, "No mesh (or not loaded yet).", 3) end
	end }):AddButton({ Text = "Texture ID", Func = function()
		local _, texture = Cat.meshOf(Cat.loaded)
		if texture and texture ~= "" then U.copy(tostring(texture)) else U.notify(TITLE, "No texture.", 3) end
	end })
	b2:AddButton({ Text = "Take Off", Func = Cat.takeOff })
	label(b2, "Paste Mesh ID and Texture ID in Fork3x's Mesh tool (H). Try On: only you see it.")
end

