---====== STOP: all of it gone, all it showed put back ======---

local function stop()
	if not C.alive then return end
	C.alive, UI.ready = false, false
	Flow.cancel()
	Auto.restore()
	Tap.cancel()
	Keys.releaseAll()
	for _, c in ipairs(C.connections) do pcall(function() c:Disconnect() end) end
	Paint.restore()
	Cat.takeOff()
	for group in pairs(Mark.groups) do Mark.clear(group) end
	for _, m in ipairs(C.made) do pcall(function() m:Destroy() end) end
	if not Library.Unloaded then pcall(function() Library:Unload() end) end
end
pcall(function() Library:OnUnload(stop) end)
GENV.__UMCStop = stop
U.notify(TITLE, if U.privateOwner() then "Ready! Start in the Build tab." else "Ready! Fork3x and the Save Morph Tool are in your private server.", 6)
