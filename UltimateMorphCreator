	UI.refresh()
end
function Flow.cancel()
	local thread, waiting = Flow.thread, Flow.waiting
	if not thread then return end
	Flow.done()
	if waiting then task.spawn(thread, nil) end -- (let it end where it waits)
end
-- On the bar: what to do; waits for one of its buttons: its name (nil: cancelled). `update()`: its words again, every half second
function Flow.ask(text, buttons, update)
	if not Flow.live() then return nil end
	Gui.ask(text, buttons, Flow.resume, Flow.cancel)
	Flow.waiting = true
	if update then
		local thread = Flow.thread
		task.spawn(function()
			while Flow.thread == thread and Flow.waiting do
				task.wait(0.5)
				if Flow.thread == thread and Flow.waiting then Gui.say(update()) end
			end
		end)
	end
	local r = coroutine.yield()
	return if Flow.live() then r else nil
end
-- On the bar: what to tap; waits for a tap on the world that `accept` takes (else says why, and waits again): the part (nil: cancelled)
function Flow.tap(text, accept)
	while Flow.live() do
		Gui.ask(text, {}, Flow.resume, Flow.cancel)
		Tap.wait(function(part) Flow.resume(part) end)
		Flow.waiting = true
		local part = coroutine.yield()
		Tap.cancel()
		if not Flow.live() or typeof(part) ~= "Instance" then return nil end
		local ok, why = accept(part)
		if ok then return part end
		U.notify(TITLE, why or ("Not that one. " .. TAP .. " again."), 3)
	end
	return nil
end
-- On the bar while it works (only Cancel)
function Flow.say(text)
	if Flow.live() then Gui.ask(text, {}, nil, Flow.cancel) end
end
-- Waits (a few seconds at most) for it to be done: true if it is
function Flow.waitFor(done, seconds)
	local start = os.clock()
	while Flow.live() and not done() and os.clock() - start < (seconds or 3) do task.wait(0.1) end
	return Flow.live() and done()
end
function Flow.run(fn)
	if Flow.thread then Flow.cancel() end
	S.menuWasOpen = Library.Toggled ~= false
	showMenu(false)
	local thread
	thread = coroutine.create(function()
		local ok, err = pcall(fn)
		if not ok then warn("[" .. TITLE .. "] " .. tostring(err)) end
		if Flow.thread == thread then Flow.done() end
	end)
	Flow.thread = thread
	task.spawn(thread)
end

local Flows = {}
-- Fork3x in your hand (if you have it)
local function holdFork()
	local tool = U.buildTool()
	if not tool then
		U.notify(TITLE, "Fork3x not found. Take it in your private server first.", 5)
		return
	end
	if tool.Parent ~= U.character() then U.equip(tool) end
end
function Flows.pickMorph()
	local part = Flow.tap(TAP .. " the morph you are making.", function(p) return Find.characterOf(p) ~= nil, "That's not a morph. " .. TAP .. " its body." end)
	if not part then return end
	local m = Find.characterOf(part)
	setTarget(m, m == U.character())
end
local function haveMorph()
	if not (S.target and S.target.Parent) then Flows.pickMorph() end
	return Flow.live() and S.target ~= nil and S.target.Parent ~= nil
end
-- A tap with Ctrl held (Fork3x adds what you tap to what it has). A wrong one is in Fork3x's selection too: then Ctrl is let go,
-- the first thing is tapped again (`again`), and Ctrl is held once more
local function ctrlTap(text, accept, againText, again)
	while Flow.live() do
		Keys.hold("LeftControl", true)
		local part = Flow.tap(text, function() return true end)
		if not part then return nil end
		task.wait(0.3) -- (Fork3x takes the tap while Ctrl is still down)
		Keys.hold("LeftControl", false)
		if not Flow.live() then return nil end
		if accept(part) then return part end
		U.notify(TITLE, "Not that one. Let's pick again.", 3)
		if not Flow.tap(againText, again) then return nil end
	end
	return nil
end
-- A part of a morph's body to click, one the camera can see (any part right in the morph counts: its root, its torso...)
local function bodyPart(model)
	local function direct(i) return i.Parent == model and i:IsA("BasePart") end
	for _, n in ipairs({ "UpperTorso", "Torso", "LowerTorso", "Head" }) do
		local p = model:FindFirstChild(n)
		if p and p:IsA("BasePart") and Auto.view(p, direct) then return p, direct end
	end
	for _, p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") and BODY[p.Name] and Auto.view(p, direct) then return p, direct end
	end
	return nil
end
-- With Ctrl held, clicks `part` for you: true if it could, and what it clicked
local function ctrlClick(part, ok)
	Keys.hold("LeftControl", true)
	local done, what = Auto.click(part, ok)
	task.wait(0.15)
	Keys.hold("LeftControl", false)
	return done, what
end

-- Add a Piece: you pick it and move it onto your morph; then it is grouped five times, your morph clicked with Ctrl held,
-- grouped and ungrouped (inside it), and welded, for you
function Flows.add()
	S.undo = 0
	holdFork()
	if not haveMorph() then return end
	local part = Flow.tap(TAP .. " the piece you want to add.", function() return true end)
	if not part then return end
	setAsset(part)
	local piece = Find.pieceOf(part, Find.characterOf(part) or part)
	local function isPiece(p) return p == part or p:IsDescendantOf(piece), TAP .. " " .. S.assetName .. "." end
	if part:IsDescendantOf(S.target) then
		if Flow.ask(S.assetName .. " is already in your morph.", { "Weld It" }) == "Weld It" then Flows.weld(part, true) end
		return
	end
	local function moveText()
		local d = distance(piece, S.target)
		return string.format("Move %s onto your morph with Fork3x (%s), then Next.", S.assetName,
			if d < 1 then "on it " .. GOOD else string.format("%d studs away", math.floor(d + 0.5)))
	end
	if Flow.ask(moveText(), { "Next" }, moveText) ~= "Next" then return end
	-- Grouped five times: each time one more group round it in its morph (not round the whole morph); Fork3x asks the server
	-- each time: it is waited for
	local home = piece.Parent
	local function depth()
		local n, o = 0, part
		while o.Parent and o.Parent ~= home do
			n += 1
			o = o.Parent
		end
		return n
	end
	local grouped = 0
	while grouped < 5 and Flow.live() do
		Flow.say(string.format("Grouping %s… %d/5", S.assetName, grouped + 1))
		local before = depth()
		if not Keys.press({ "LeftShift" }, "J") then
			Flow.ask("Your executor can't press keys, so this guide can't work here.", { "OK" })
			return
		end
		if Flow.waitFor(function() return depth() > before end, 3) then
			grouped += 1
			S.undo += 1
		elseif Flow.ask("Fork3x didn't group " .. S.assetName .. ". Undo, select only " .. S.assetName .. ", then Retry.", { "Retry" }) ~= "Retry" then
			return
		end
	end
	-- Inside your morph: your morph clicked with Ctrl held (for you, or by you), grouped, ungrouped
	local tries = 0
	while Flow.live() do
		tries += 1
		local body = nil
		if tries == 1 and useAuto() then
			Flow.say("Putting " .. S.assetName .. " inside your morph…")
			local target, direct = bodyPart(S.target)
			if target then
				local done, what = ctrlClick(target, direct)
				if done then body = what end
			end
		end
		if not body then
			Auto.restore()
			Mark.glow("flow", S.target, GREEN)
			body = ctrlTap("Ctrl is held. Now " .. TAP:lower() .. " your morph (green).", function(p) return p:IsDescendantOf(S.target) end,
				TAP .. " " .. S.assetName .. " again.", isPiece)
			Mark.clear("flow")
		end
		if not body then return end
		Flow.say("Putting " .. S.assetName .. " inside your morph…")
		local bodyHome, before = body.Parent, depth()
		Keys.press({ "LeftShift" }, "J")
		-- grouped (with your morph, or with something else): ungrouped at once
		if Flow.waitFor(function() return part:IsDescendantOf(S.target) or body.Parent ~= bodyHome or depth() ~= before end, 3) then
			Keys.press({ "LeftShift" }, "U")
			S.undo += 2
			Flow.waitFor(function() return body.Parent == bodyHome end, 3)
		end
		if not Flow.live() then return end
		UI.refresh()
		if part:IsDescendantOf(S.target) then
			Flow.say("Inside " .. GOOD .. "  Welding it…")
			Flows.weld(part, true)
			return
		end
		if Flow.ask("Not inside yet " .. BAD .. "  Let's try again: you " .. TAP:lower() .. " this time.", { "Retry" }) ~= "Retry" then return end
		if not Flow.tap(TAP .. " " .. S.assetName .. " again.", isPiece) then return end
		tries = 1
	end
end

-- One group welded to the body part it belongs to: clicked for you if it can (else you tap); Weld in Fork3x's panel pressed for
-- you when Fork3x's outlines show the right two (else you check it and press it). true: welded; false: not; nil: cancelled
local function weldGroup(g, a)
	local to = g.to or a.root
	local name = g.piece.Name
	Mark.clear("flow")
	Mark.glow("flow", g.piece, YELLOW)
	if to then Mark.glow("flow", to, GREEN) end
	if Keys.held.LeftControl then Keys.hold("LeftControl", false) end
	local function yellow(q) return Welds.inGroup(g, q), "That's not the yellow one." end
	local clicked = false
	if useAuto() and to then
		Flow.say("Welding " .. name .. " to " .. to.Name .. "…")
		local parts = table.clone(g.parts)
		table.sort(parts, function(x, y) return U.volume(x) > U.volume(y) end)
		for i, p in ipairs(parts) do
			if i > 5 then break end
			if Auto.click(p, function(q) return Welds.inGroup(g, q) end) then
				clicked = ctrlClick(to, function(q) return q == to end)
				break
			end
		end
	end
	if not Flow.live() then return nil end
	if not clicked then
		Auto.restore()
		if not Flow.tap(TAP .. " the yellow piece (" .. name .. ").", yellow) then return nil end
		if not ctrlTap("Ctrl is held. Now " .. TAP:lower() .. " the green part (" .. (if to then to.Name else "its body") .. ").",
			function(q) return a.heldSet[q] == true end, TAP .. " the yellow piece again.", yellow) then return nil end
	end
	Keys.press({}, "F")
	task.wait(0.4)
	if not Flow.live() then return nil end
	local sel = Auto.selection()
	local right = false
	if sel then
		local piece, part, other = false, false, false
		for inst in pairs(sel) do
			if inst == to then
				part = true
			elseif inst == g.piece or inst:IsDescendantOf(g.piece) or table.find(g.parts, inst) then
				piece = true
			else
				other = true
			end
		end
		right = piece and part and not other
	end
	local button = Auto.findButton("weld", "break")
	local function welded()
		local after = analysis(true)
		return after ~= nil and Welds.groupOf(after, g.main) == nil
	end
	if useAuto() and right and button and Auto.press(button) then
		Flow.waitFor(welded, 3)
	else
		local check = if sel and not right then "Fork3x has other things selected too: fix it. " else "Check Fork3x has the yellow piece and the green part. "
		if Flow.ask(check .. "Then Weld in its weld tool, then Done.", { "Done" }) ~= "Done" then return nil end
	end
	if not Flow.live() then return nil end
	return welded()
end
-- Fix All (or one piece): each group that would fall, welded to the body part it belongs to
function Flows.weld(thing, nested)
	if not nested then S.undo = 0 end
	holdFork()
	if not haveMorph() then return end
	local skipped, count = {}, 0
	while Flow.live() do
		local a = analysis(true)
		local g = nil
		if thing then
			g = Welds.groupOf(a, thing)
		else
			for _, cand in ipairs(a.loose) do
				if not skipped[cand.main] then
					g = cand
					break
				end
			end
		end
		if not g then
			Auto.restore()
			if thing and not thing:IsDescendantOf(S.target) then
				Flow.ask("Put it inside your morph first.", { "OK" })
			elseif thing then
				Flow.ask(S.assetName .. " is in your morph and welded " .. GOOD, { "OK" })
			elseif #a.loose == 0 then
				Flow.ask((if count > 0 then string.format("Welded %d. ", count) else "") .. "Nothing will fall " .. GOOD, { "OK" })
			else
				Flow.ask(string.format("Welded %d. %d skipped: they will still fall.", count, #a.loose), { "OK" })
			end
			return
		end
		local ok = weldGroup(g, a)
		if ok == nil then return end
		if ok then
			count += 1
			S.undo += 1
		else
			Auto.restore()
			local r = Flow.ask(g.piece.Name .. " is not welded yet " .. BAD, if thing then { "Retry" } else { "Retry", "Skip" })
			if r == "Skip" then
				skipped[g.main] = true
			elseif r ~= "Retry" then
				return
			end
		end
	end
end

-- Test Morph: onto its pad (your body becomes it), thawed; Back to where you were
function Flows.test()
	if not haveMorph() then return end
	local name = Find.nameOf(S.target)
	local pad = S.target.Parent and S.target.Parent:FindFirstChild("Pad")
	if S.targetIsMe or not (pad and pad:IsA("BasePart")) then
		Flow.ask(name .. " has no pad to step on.", { "OK" })
		return
	end
	if not U.privateOwner() then
		Flow.ask("Test Morph works in your private server.", { "OK" })
		return
	end
	local character, root = U.character(), U.root()
	if not (character and root) then return end
	S.back = root.CFrame
	Flow.say("Going onto " .. name .. "'s pad…")
	local count = #character:GetDescendants()
	pcall(function() character:PivotTo(pad.CFrame + Vector3.new(0, 3.5, 0)) end)
	Flow.waitFor(function()
		local now = U.character()
		return now ~= character or (now ~= nil and math.abs(#now:GetDescendants() - count) > 5)
	end, 6)
	task.wait(1)
	if not Flow.live() then return end
	U.chat(";thaw me")
	if Flow.ask("Testing " .. name .. " (thawed). Try it, then Back.", { "Back" }) == "Back" then goBack() end
end
-- Undo Guide: Fork3x's steps of the last guide, undone
function Flows.undo()
	if S.undo <= 0 then
		Flow.ask("Nothing to undo.", { "OK" })
		return
	end
	if Flow.ask(string.format("Undo the last guide (%d Fork3x steps)?", S.undo), { "Undo" }) ~= "Undo" then return end
	holdFork()
	local n = S.undo
	S.undo = 0
	for i = 1, n do
		if not Flow.live() then return end
		Flow.say(string.format("Undoing… %d/%d", i, n))
		Keys.press({ "LeftControl" }, "Z")
		task.wait(0.3)
	end
	Flow.ask("Undone " .. GOOD, { "OK" })
end
-- Recolor: the part you tap, and all of its colour in its morph
function Flows.color()
	local part = Flow.tap(TAP .. " a part to pick its color.", function(p) return p:IsA("BasePart"), TAP .. " a part." end)
	if not part then return end
	local scope = if S.target and part:IsDescendantOf(S.target) then S.target else (Find.characterOf(part) or part)
	local key = Paint.key(part.Color)
	S.colorParts, S.colorScope = {}, scope
	for _, p in ipairs(U.partsOf(scope)) do
		if Paint.key(p.Color) == key then table.insert(S.colorParts, p) end
	end
	pcall(function() Options.UMC_NewColor:SetValueRGB(part.Color) end)
	UI.set("color", string.format("%s · %d %s on %s", U.hex(part.Color), #S.colorParts, if #S.colorParts == 1 then "part" else "parts", Find.nameOf(scope)))
	Mark.clear("color")
	for i, p in ipairs(S.colorParts) do
		if i <= 60 then Mark.box("color", p, YELLOW) end
	end
	task.delay(4, function() Mark.clear("color") end)
end
-- Go To a morph on the map (yours: your private server)
local function goTo(name)
	if not U.privateOwner() then return U.notify(TITLE, "Go To works in your private server.", 4) end
	local folder = workspace:FindFirstChild("Morphs")
	local holder = folder and name and folder:FindFirstChild(name)
	local character = U.character()
	local at = holder and U.where(holder:FindFirstChild("Character") or holder)
	if not (at and character) then return U.notify(TITLE, "Pick a morph first.", 3) end
	local look = flat(workspace.CurrentCamera.CFrame.LookVector)
	local from = at - look * 8 + Vector3.new(0, 3, 0)
	pcall(function() character:PivotTo(CFrame.lookAt(from, Vector3.new(at.X, from.Y, at.Z))) end)
end

