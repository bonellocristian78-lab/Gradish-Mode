local U = {}
function U.notify(title, text, seconds)
	pcall(function() Library:Notify({ Title = title, Description = text, Time = seconds or 4 }) end)
end
function U.copy(text)
	local set = setclipboard or toclipboard
	if set and pcall(set, text) then
		U.notify("Copied", text, 3)
		return true
	end
	U.notify("Copy this", text, 10)
	return false
end
local function byte(x) return math.clamp(math.floor(x * 255 + 0.5), 0, 255) end
function U.hex(c) return string.format("#%02X%02X%02X", byte(c.R), byte(c.G), byte(c.B)) end
function U.rgb(c) return string.format("%d, %d, %d", byte(c.R), byte(c.G), byte(c.B)) end
-- A colour's code, for Fork3x's Paint tool
function U.code(c) return U.hex(c) .. " (" .. U.rgb(c) .. ")" end
local requestFn = (syn and syn.request) or (http and http.request) or http_request or request
-- A page of the web (Roblox's catalog and toolbox): its body, or nil
function U.get(url)
	if requestFn then
		local ok, res = pcall(requestFn, { Url = url, Method = "GET" })
		if ok and type(res) == "table" and type(res.Body) == "string" and (tonumber(res.StatusCode) or 200) < 400 then return res.Body end
	end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	return if ok and type(body) == "string" then body else nil
end
function U.json(body)
	if type(body) ~= "string" or body == "" then return nil end
	local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
	return if ok then data else nil
end
