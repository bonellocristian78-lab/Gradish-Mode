end)

---====== SEEING IT: a copy of it before you, the camera round it, the map faded round it, a ruler ======---

local View = { copy = nil, spin = 0, fadedParts = {} }
-- A copy of a morph before you, facing you, turning if you like (only on your screen)
function View.mirror(model)
	if View.copy then
		View.copy:Destroy()
		View.copy = nil
	end
	if not model then return false end
	local was = model.Archivable
	model.Archivable = true
	local ok, copy = pcall(function() return model:Clone() end)
	model.Archivable = was
	if not (ok and copy) then return false end
	for _, d in ipairs(copy:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("ProximityPrompt") or d:IsA("ClickDetector") or d:IsA("Sound") or d:IsA("TouchTransmitter") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch = true, false, false, false
		elseif d:IsA("Humanoid") then
			pcall(function() d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
		end
	end
	copy.Name = "UMC_Mirror"
	copy.Parent = helpers
	View.copy = copy
	View.spin = 0
	View.place()
	return true
end
-- Before you: on the floor in front of you, facing you
function View.place()
	local copy, root = View.copy, U.root()
	if not (copy and root) then return end
	local _, size = copy:GetBoundingBox()
	local look = flat(workspace.CurrentCamera.CFrame.LookVector)
	local at = root.Position + look * (math.max(size.X, size.Z) / 2 + 6)
	View.base = CFrame.lookAt(at, at - look)
	copy:PivotTo(View.base * CFrame.Angles(0, View.spin, 0))
end
on(RunService.Heartbeat, function(dt)
	if View.copy and Toggles.UMC_MirrorSpin and Toggles.UMC_MirrorSpin.Value and View.base then
		View.spin += dt * 0.8
		View.copy:PivotTo(View.base * CFrame.Angles(0, View.spin, 0))
	end
end)
-- The camera round something (as round you: turn it with your finger or mouse), or back to you
function View.orbit(thing)
	local camera = workspace.CurrentCamera
	if not thing then
		camera.CameraSubject = U.humanoid()
		return
	end
	local part = thing
	if not thing:IsA("BasePart") then
		part = thing:FindFirstChild("HumanoidRootPart") or (thing:IsA("Model") and thing.PrimaryPart) or thing:FindFirstChildWhichIsA("BasePart", true)
	end
	if part then camera.CameraSubject = part end
end
-- The map round it faded (only for you), or back as it was: how many parts faded
function View.fade(model, on, radius)
	for _, p in ipairs(View.fadedParts) do -- (what was faded before)
		local props = C.restore[p]
		if props and props.LocalTransparencyModifier then
			pcall(function() p.LocalTransparencyModifier = props.LocalTransparencyModifier[1] end)
			props.LocalTransparencyModifier = nil
		end
	end
	View.fadedParts = {}
	if not (on and model) then return 0 end
	local center = U.where(model)
	if not center then return 0 end
	local mine = U.character()
	local parts = nil
	pcall(function() parts = workspace:GetPartBoundsInRadius(center, radius) end)
	if not parts then
		parts = {}
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("BasePart") and (d.Position - center).Magnitude < radius then table.insert(parts, d) end
		end
	end
	for _, p in ipairs(parts) do
		if not (p:IsDescendantOf(model) or p:IsDescendantOf(helpers) or (mine and p:IsDescendantOf(mine))) then
			Paint.set(p, "LocalTransparencyModifier", 0.85)
			table.insert(View.fadedParts, p)
		end
	end
	return #View.fadedParts
end
-- A ruler: from one point to another, its length
function View.ruler()
	Pick.start("il primo punto", function(_, a)
		Pick.start("il secondo punto", function(_, b)
			Mark.clear("ruler")
			local d = b - a
			Mark.add("ruler", make("Part", { Name = "UMC_Ruler", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Material = Enum.Material.Neon,
				Color = YELLOW, Size = Vector3.new(0.08, 0.08, math.max(d.Magnitude, 0.05)), CFrame = CFrame.lookAt((a + b) / 2, b) }, helpers))
			U.notify("Righello", string.format("%.2f stud (X %.2f · Y %.2f · Z %.2f)", d.Magnitude, d.X, d.Y, d.Z), 8)
		end)
	end)
end

---====== THE CATALOG AND THE TOOLBOX: found, seen, their ids for the building tools ======---

local Cat = { results = {}, loaded = nil, tried = nil }
-- Searched: "ugc" (the catalog's accessories: their meshes for the Mesh tool) or "toolbox" (models)
function Cat.search(source, keyword)
	local out = {}
	local q = HttpService:UrlEncode(keyword)
	if source == "ugc" then
		local data = U.json(U.get("https://catalog.roblox.com/v1/search/items/details?Category=11&Limit=30&Keyword=" .. q))
		for _, item in ipairs(data and data.data or {}) do
			if item.id and (item.itemType == nil or item.itemType == "Asset") then
				table.insert(out, { id = item.id, name = tostring(item.name), creator = tostring(item.creatorName or "?"), kind = "UGC" })
			end
		end
	else
		local data = U.json(U.get("https://apis.roblox.com/toolbox-service/v1/marketplace/10?num=30&keyword=" .. q))
		local ids = {}
		for _, item in ipairs(data and data.data or {}) do
			if item.id then table.insert(ids, tostring(item.id)) end
		end
		local details = if #ids > 0 then U.json(U.get("https://apis.roblox.com/toolbox-service/v1/items/details?assetIds=" .. table.concat(ids, ","))) else nil
		for _, d in ipairs(details and details.data or {}) do
			local a = d.asset or {}
			local counts = a.modelTechnicalDetails and a.modelTechnicalDetails.instanceCounts
			if a.id then
				table.insert(out, { id = a.id, name = tostring(a.name), creator = tostring(d.creator and d.creator.name or "?"), kind = "Modello",
					scripts = counts and counts.script or 0 })
			end
		end
	end
	Cat.results = out
	return out
end
function Cat.label(r)
	return string.format("%s — %s (%s)", r.name, r.creator, tostring(r.id))
end
-- Loaded here (only for you), without its scripts
function Cat.load(id)
	local ok, obj = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(id))[1] end)
	if not (ok and typeof(obj) == "Instance") then return nil end
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then d:Destroy() end
	end
	return obj
end
-- Its mesh and its texture (what the Mesh tool asks for)
function Cat.meshOf(obj)
	if not obj then return nil, nil end
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("SpecialMesh") or d:IsA("FileMesh") then return d.MeshId, d.TextureId end
		if d:IsA("MeshPart") then return d.MeshId, d.TextureID end
	end
	if obj:IsA("MeshPart") then return obj.MeshId, obj.TextureID end
	return nil, nil
end
-- What a viewport can show of it (a part or a model)
function Cat.viewable(obj)
	if not obj then return nil end
	if obj:IsA("Model") or obj:IsA("BasePart") then return obj end
	local m = Instance.new("Model")
	m.Name = obj.Name
	for _, c in ipairs(obj:GetChildren()) do c:Clone().Parent = m end
	return m
end
-- Tried on: an accessory on you, a model before you (only on your screen)
function Cat.tryOn(obj)
	Cat.takeOff()
	if not obj then return false end
	local copy = obj:Clone()
	local humanoid, root = U.humanoid(), U.root()
	if copy:IsA("Accessory") and humanoid then
		local ok = pcall(function() humanoid:AddAccessory(copy) end)
		if ok then
			Cat.tried = copy
			return true
		end
	end
	if not root then return false end
	local model = Cat.viewable(copy)
	for _, p in ipairs(U.partsOf(model)) do p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false end
	model.Parent = helpers
	local size = if model:IsA("Model") then select(2, model:GetBoundingBox()) else model.Size
	local look = flat(workspace.CurrentCamera.CFrame.LookVector)
	pcall(function() model:PivotTo(CFrame.new(root.Position + look * (math.max(size.X, size.Z) / 2 + 5))) end)
	Cat.tried = model
	return true
end
function Cat.takeOff()
	if Cat.tried then pcall(function() Cat.tried:Destroy() end) end
	Cat.tried = nil
end

