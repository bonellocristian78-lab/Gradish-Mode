	text(box, "Il pad preme le scorciatoie del Fork3x come se usassi la tastiera: utile sul cellulare, dove Shift e Ctrl non ci sono.")
	local keys = tab:AddRightGroupbox("Scorciatoie", "keyboard")
	for _, c in ipairs(Keys.COMBOS) do
		keys:AddButton({ Text = c[1] .. " (" .. (if c[2][1] == "LeftShift" then "Shift+" else "Ctrl+") .. c[3] .. ")", Func = function() Keys.tap(c[2], c[3]) end })
	end
	for i = 1, #Keys.TOOLS, 2 do
		local a, b = Keys.TOOLS[i], Keys.TOOLS[i + 1]
		local row = keys:AddButton({ Text = a[1] .. " (" .. a[2] .. ")", Func = function() Keys.tap({}, a[2]) end })
		if b then row:AddButton({ Text = b[1] .. " (" .. b[2] .. ")", Func = function() Keys.tap({}, b[2]) end }) end
	end
end

