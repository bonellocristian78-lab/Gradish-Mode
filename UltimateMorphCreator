		info:SetText("Cerco…")
		task.spawn(function()
			local source = if Options.UMC_Where.Value == "Toolbox (modelli)" then "toolbox" else "ugc"
			local results = Cat.search(source, Options.UMC_Keyword.Value ~= "" and Options.UMC_Keyword.Value or "skibidi toilet")
			local labels = {}
			for _, r in ipairs(results) do table.insert(labels, Cat.label(r)) end
			Options.UMC_Results:SetValues(labels)
			info:SetText(if #results > 0 then #results .. " risultati" else "Niente (o il tuo executor non può leggere il web).")
		end)
	end })
	box:AddDropdown("UMC_Results", { Values = {}, Text = "Risultati", Searchable = true, MaxVisibleDropdownItems = 10, Callback = function()
		local r = current()
		if not r then return end
		if Options.UMC_Thumb then Options.UMC_Thumb:SetImage("rbxthumb://type=Asset&id=" .. tostring(r.id) .. "&w=150&h=150") end
		info:SetText(string.format("%s · %s · ID %s%s", r.kind, r.creator, tostring(r.id), if (r.scripts or 0) > 0 then " · contiene script" else ""))
		Cat.loaded = nil
		task.spawn(function()
			local obj = Cat.load(r.id)
			if current() ~= r then return end
			Cat.loaded = obj
			local view = Cat.viewable(obj)
			if view and Options.UMC_View then
				pcall(function()
					Options.UMC_View:SetObject(view, true)
					Options.UMC_View:Focus()
				end)
			end
			local mesh, texture = Cat.meshOf(obj)
			if mesh then info:SetText(info.Text .. "\nMeshId " .. tostring(mesh) .. "\nTextureId " .. tostring(texture or "-")) end
		end)
