---====== AUTO: Fork3x's clicks done for you, with your mouse as you would click (the camera shows what it clicks) ======---

local Auto = { camera = nil, alive = function() return true end } -- (alive: still wanted, or cancelled meanwhile)
-- A ray that does not see your helpers or you
local function rayParams()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { helpers }
	local me = U.character()
	if me then table.insert(ignore, me) end
	params.FilterDescendantsInstances = ignore
	return params
end
local AROUND = { Vector3.new(0, 0.35, -1), Vector3.new(0, 0.35, 1), Vector3.new(1, 0.35, 0), Vector3.new(-1, 0.35, 0), Vector3.new(0.7, 0.7, -0.7),
	Vector3.new(-0.7, 0.7, 0.7), Vector3.new(0.05, 1, 0.05), Vector3.new(0.7, -0.4, 0.7), Vector3.new(-0.7, -0.4, -0.7) }
-- Where the camera sees `part` with nothing before it: the camera's place, the point, what is there (`ok(instance)`: which hits count)
function Auto.view(part, ok)
	local cam = workspace.CurrentCamera
	local center = part.Position
	local dist = math.clamp(part.Size.Magnitude * 1.5 + 6, 8, 40)
	local params = rayParams()
	local dirs = { -cam.CFrame.LookVector } -- (from where you look, first)
	for _, d in ipairs(AROUND) do table.insert(dirs, d) end
	for _, d in ipairs(dirs) do
		local from = center + d.Unit * dist
		local hit = workspace:Raycast(from, (center - from) * 1.5, params)
		if hit and ok(hit.Instance) then return from, hit.Position, hit.Instance end
	end
	return nil
end
local function mouseClick(x, y)
	local vim = Keys.vim
	vim:SendMouseMoveEvent(x, y, game)
	task.wait(0.05)
	vim:SendMouseButtonEvent(x, y, 0, true, game, 1)
	task.wait(0.06)
	vim:SendMouseButtonEvent(x, y, 0, false, game, 1)
end
-- Clicks `part` (the first of `ok`'s it sees there) as your mouse would: true if it could, and what it clicked
function Auto.click(part, ok)
	if not (Keys.vim and part and part.Parent) then return false end
	local from, point, what = Auto.view(part, ok or function(i) return i == part end)
	if not from then return false end
	local cam = workspace.CurrentCamera
	if not Auto.camera then Auto.camera = { type = cam.CameraType, cf = cam.CFrame, subject = cam.CameraSubject } end
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame.lookAt(from, point)
	Gui.quiet(true)
	task.wait(0.1)
	if not Auto.alive() then
		Gui.quiet(false)
		return false
	end
	local screenAt, visible = cam:WorldToViewportPoint(point)
	local done = visible and pcall(mouseClick, screenAt.X, screenAt.Y)
	task.wait(0.25)
	Gui.quiet(false)
	return done == true, what
end
-- The camera back as it was
function Auto.restore()
	local saved = Auto.camera
	Auto.camera = nil
	if not saved then return end
	pcall(function()
		local cam = workspace.CurrentCamera
		cam.CameraType = saved.type
		cam.CFrame = saved.cf
		cam.CameraSubject = saved.subject
	end)
end
-- What a button says (its text, its labels')
local function wordsOf(b)
	local words = if b:IsA("TextButton") then { b.Text } else {}
	for _, d in ipairs(b:GetDescendants()) do
		if d:IsA("TextLabel") then table.insert(words, d.Text) end
	end
	return table.concat(words, " "):lower()
end
local function shown(g)
	local o = g
	while o and o:IsA("GuiObject") do
		if not o.Visible then return false end
		o = o.Parent
	end
	return not (o and o:IsA("ScreenGui") and o.Enabled == false)
end
-- Fork3x's own button on your screen, found by its words (`avoid`: words it must not have); never this script's or Obsidian's
function Auto.findButton(want, avoid)
	local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not gui then return nil end
	for _, b in ipairs(gui:GetDescendants()) do
		if b:IsA("GuiButton") and not b:IsDescendantOf(Gui.screen) and not (Library.ScreenGui and b:IsDescendantOf(Library.ScreenGui)) and shown(b) then
			local words = wordsOf(b)
			if words:find(want, 1, true) and not (avoid and words:find(avoid, 1, true)) then return b end
		end
	end
	return nil
end
-- A button pressed as your mouse would
function Auto.press(button)
	if not Keys.vim then return false end
	return pcall(function()
		local screen = button:FindFirstAncestorOfClass("ScreenGui")
		local inset = if screen and screen.IgnoreGuiInset then Vector2.new(0, 0) else U.inset()
		local pos, size = button.AbsolutePosition, button.AbsoluteSize
		mouseClick(pos.X + size.X / 2 + inset.X, pos.Y + size.Y / 2 + inset.Y)
	end)
end
-- What Fork3x has selected, from its outlines on your screen (nil: none seen)
function Auto.selection()
	local found, any = {}, false
	local roots = { workspace.CurrentCamera, LocalPlayer:FindFirstChildOfClass("PlayerGui") }
	for _, root in ipairs(roots) do
		if root then
			for _, d in ipairs(root:GetDescendants()) do
				if d:IsA("SelectionBox") and d.Adornee and not d:IsDescendantOf(helpers) then
					found[d.Adornee] = true
					any = true
				end
			end
		end
	end
	return if any then found else nil
end

