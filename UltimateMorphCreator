	padButton(hold, "Ctrl (più pezzi)", 1, function()
		Keys.hold("LeftControl", not Keys.held.LeftControl)
		Pad.refresh()
	end)
	padButton(hold, "Shift", 2, function()
		Keys.hold("LeftShift", not Keys.held.LeftShift)
		Pad.refresh()
	end)
	gui.Parent = U.guiParent()
	Pad.gui = gui
	Pad.refresh()
	return gui
end
function Pad.show(visible)
