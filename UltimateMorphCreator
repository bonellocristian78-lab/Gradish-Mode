-- Its parts (itself, if it is one)
function U.partsOf(i)
	local out = {}
	if i:IsA("BasePart") then table.insert(out, i) end
	for _, d in ipairs(i:GetDescendants()) do
		if d:IsA("BasePart") then table.insert(out, d) end
	end
	return out
end
