-- The morphs on the map (Workspace.Morphs: each its Pad and its Character), by name
function Find.morphs()
	local names = {}
	local folder = workspace:FindFirstChild("Morphs")
	for _, m in ipairs(if folder then folder:GetChildren() else {}) do
		if m:FindFirstChild("Character") and not table.find(names, m.Name) then table.insert(names, m.Name) end
	end
	table.sort(names, function(a, b) return a:lower() < b:lower() end)
	return names
end
-- How far a piece is from a morph's body
local function distance(thing, model)
	local best, mine = math.huge, U.partsOf(thing)
	for _, b in ipairs(model:GetChildren()) do
		if b:IsA("BasePart") and BODY[b.Name] then
			for i, p in ipairs(mine) do
				if i > 30 then break end
				best = math.min(best, U.boxDistance(b, p.Position))
			end
		end
	end
	return best
end
