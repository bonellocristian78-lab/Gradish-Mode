     down before a single entity was registered, for background music.
     Self-hosted now, and still wrapped: a failure costs you the music only. ]]
local musicOk, CustomMusic = pcall(
	getGitSoundId,
	"https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/main/ambience.mp3",
