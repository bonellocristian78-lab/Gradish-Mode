	local room = lastroom.Value

	for _, entity in ipairs(ENTITIES) do
		if table.find(schedules[entity.key], room) then
			task.spawn(function()
				task.wait(r3:NextInteger(entity.wait[1], entity.wait[2]))
				loadstring(game:HttpGet(
					"https://raw.githubusercontent.com/bonellocristian78-lab/Gradish-Mode/main/" .. entity.file
				))()
			end)
		end
	end
end)
