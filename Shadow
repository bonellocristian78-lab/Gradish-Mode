	return
end
for _, d in ipairs(copy:GetDescendants()) do
	if d:IsA("LuaSourceContainer") or d:IsA("Humanoid") or d:IsA("Sound") or d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("ProximityPrompt")
		or d:IsA("BillboardGui") or d:IsA("Tool") or d:IsA("JointInstance") or d:IsA("Constraint") or d:IsA("ForceField") or d:IsA("Decal") then
		d:Destroy()
	end
end
copy.Name = "Shadow"
-- Each of its parts follows the one of yours of the same place in your character
local pairsOf = {}
local function pathOf(d, top)
	local names = {}
	while d and d ~= top do
		table.insert(names, 1, d.Name)
		d = d.Parent
	end
	return table.concat(names, "/")
end
local byPath = {}
for _, d in ipairs(copy:GetDescendants()) do
	if d:IsA("BasePart") then
		d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch, d.CastShadow = true, false, false, false, false
		d.Color, d.Material = Color3.new(0, 0, 0), Enum.Material.SmoothPlastic
		if d:IsA("MeshPart") then pcall(function() d.TextureID = "" end) end
		byPath[pathOf(d, copy)] = d
	end
end
for _, d in ipairs(character:GetDescendants()) do
	if d:IsA("BasePart") then
		local mine = byPath[pathOf(d, character)]
		if mine then table.insert(pairsOf, { d, mine }) end
	end
end
local shadowRoot = copy:FindFirstChild("HumanoidRootPart")
local shadowHead = copy:FindFirstChild("Head") or shadowRoot
local glow = make("Highlight", { FillColor = Color3.new(0, 0, 0), FillTransparency = 0, OutlineColor = RED, OutlineTransparency = 0.2,
	DepthMode = Enum.HighlightDepthMode.Occluded }, copy)

-- What you did: every frame, where each of your parts was
local frames, cursor = {}, 1
local shown, shownAt = false, 0
local function show(on)
	if shown == on then return end
	shown, shownAt = on, os.clock()
	copy.Parent = if on then folder else nil
	if on then FX.once(sfx("Whoosh"), shadowRoot, { Volume = VOLUME }) end
end

FX.caption("Don't stop moving.", Color3.fromRGB(220, 60, 60), 4)
FX.once(sfx("Stinger"), SoundService, { Volume = 0.7 * VOLUME })
local whisper = FX.loop(sfx("Whisper"), SoundService, { Volume = 0.3 * VOLUME })
local heart = sfx("Heartbeat")
local born, beatAt, got = os.clock(), 0, false
on(RunService.Heartbeat, function()
	local now = os.clock()
	if LocalPlayer.Character ~= character or not P.body() then -- (dead, or a new body: it is over)
		stop()
		return
	end
	if P.hiding() then -- it loses you
		table.clear(frames)
		cursor = 1
		show(false)
		return
	end
	local snap = { t = now }
	for i, pair in ipairs(pairsOf) do snap[i] = pair[1].CFrame end
	table.insert(frames, snap)
	-- Where you were `delay` seconds ago: that is where it is
	local delay = DELAY[1] + (DELAY[2] - DELAY[1]) * math.clamp((now - born) / DURATION, 0, 1)
	local wanted = now - delay
	if #frames == 0 or frames[1].t > wanted then
		show(false)
		return
	end
	while cursor < #frames and frames[cursor + 1].t <= wanted do cursor += 1 end
	if cursor > 400 then -- (what it has already done, forgotten)
		frames = table.move(frames, cursor, #frames, 1, {})
		cursor = 1
	end
	local f = frames[cursor]
	for i, pair in ipairs(pairsOf) do pair[2].CFrame = f[i] end
	show(true)
	-- Near you: your heart; on you: your death
	local d = if shadowRoot then (shadowRoot.Position - myRoot.Position).Magnitude else math.huge
	if d < 14 and now >= beatAt then
		beatAt = now + 0.3 + d / 20
		FX.once(heart, SoundService, { Volume = (1 - d / 14) * 1.6 * VOLUME })
	end
	if whisper then whisper.Volume = (0.3 + math.max(0, 1 - d / 30)) * VOLUME end
	FX.tint(RED, math.max(0, 1 - d / 25) * 0.4)
	if d < 2.2 and not got and now - shownAt > 1.2 then
		got = true
		task.spawn(FX.face, shadowHead, sfx("Shriek"), RED, function() HURT.kill("your Shadow", HINTS) end)
	end
end)

wait(DURATION)
-- It fades away
if alive then
	FX.once(sfx("Whoosh"), SoundService, { Volume = VOLUME })
	local t0 = os.clock()
	while alive and os.clock() - t0 < 1 do
		local u = os.clock() - t0
		glow.FillTransparency, glow.OutlineTransparency = u, 0.2 + u * 0.8
		for _, pair in ipairs(pairsOf) do
			if pair[2] ~= shadowRoot then pair[2].Transparency = math.max(pair[2].Transparency, u) end
		end
		RunService.Heartbeat:Wait()
	end
end
stop()
