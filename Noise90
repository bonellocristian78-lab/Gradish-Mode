---- The Stairwell's TV cart and its disc player: the discs lie in the room, one goes in ----

disc = { carried = nil, inserted = nil, entries = {}, insert = nil }

local function takeDisc(entry)
	if disc.inserted or disc.carried == entry then return end
	local old = disc.carried
	if old then -- the other one goes back where it was
		old.model:PivotTo(old.spot)
		old.prompt.Enabled = true
	end
	disc.carried = entry
	entry.prompt.Enabled = false
	oneShot(SOUNDS.click, entry.model.PrimaryPart)
	if disc.insert then disc.insert.Enabled = true end
end

-- A disc in its sleeve: the type's face and name on it, the disc showing at one side
local function makeDisc(entry)
	local m = make("Model", { Name = "Noise90Disc" }, nil)
	local case = make("Part", { Name = "Case", Size = Vector3.new(1.3, 0.12, 1.15), Color = rgb(24, 24, 30), Material = Enum.Material.SmoothPlastic,
		Anchored = true, CanCollide = false, CanTouch = false }, m)
	make("Part", { Name = "Disc", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.03, 1, 1), Color = rgb(205, 210, 220),
		Material = Enum.Material.Foil, Reflectance = 0.25, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		CFrame = CFrame.new(0.42, 0, 0) * CFrame.Angles(0, 0, math.pi / 2) }, m)
	make("PointLight", { Color = BLUE, Brightness = 0.6, Range = 5 }, case)
	local gui = make("SurfaceGui", { Face = Enum.NormalId.Top, CanvasSize = Vector2.new(260, 230), LightInfluence = 0.3 }, case)
	make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(16, 16, 22), BorderSizePixel = 0 }, gui)
	local face = image(V.face)
	if face then
		make("ImageLabel", { Size = UDim2.fromScale(0.6, 0.6), Position = UDim2.fromScale(0.2, 0.05), BackgroundTransparency = 1, Image = face,
			ImageColor3 = V.faceColor or Color3.new(1, 1, 1) }, gui)
	end
	make("TextLabel", { Size = UDim2.fromScale(0.96, 0.26), Position = UDim2.fromScale(0.02, 0.7), BackgroundTransparency = 1, Text = entry.title,
		TextScaled = true, Font = Enum.Font.Arcade, TextColor3 = BLUE }, gui)
	m.PrimaryPart = case
	entry.model = m
	entry.prompt = newPrompt(case, "Take", entry.title, 0.2, 8)
	on(entry.prompt.Triggered, function() takeDisc(entry) end)
