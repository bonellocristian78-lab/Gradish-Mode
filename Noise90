local function discTool(entry)
	local tool = make("Tool", { Name = entry.title, ToolTip = "Noise tape", CanBeDropped = false, RequiresHandle = false,
		TextureId = files.discs[entry.art .. "_Front"] or "" }, nil)
	on(tool.Equipped, function()
		if disc.busy or disc.inserted then return end
		disc.carried = entry
		entry.model.Parent = folder
		if disc.insert then disc.insert.Enabled = not disc.locked end
	end)
	on(tool.Unequipped, function()
		if disc.busy or disc.carried ~= entry then return end
		disc.carried = nil
		entry.model.Parent = nil
		if disc.insert and not disc.inserted then disc.insert.Enabled = false end
	end)
	on(tool.Activated, function()
		if disc.carried == entry then openInspect(entry) end
	end)
	return tool
end
local function backpack() return LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer.Character end

local function takeDisc(entry)
	if disc.inserted or disc.busy or entry.tool then return end
	entry.take.Enabled, entry.look.Enabled = false, false
	entry.model.Parent = nil -- in your inventory now
	entry.tool = discTool(entry)
	entry.tool.Parent = backpack()
	table.insert(owned, entry.tool)
	disc.taken = true
	oneShot(SOUNDS.click, SoundService, { Volume = CONFIG.Volume * 0.6 })
	journal.note(entry)
end

-- The case open (1) or shut (0): the lid and the cover in it swing up on the spine
local function setLid(model, rest, u)
	local tray, lid, cover = model:FindFirstChild("Tray"), model:FindFirstChild("Lid"), model:FindFirstChild("Cover")
	if not (tray and lid and cover) then return end
	local hinge = tray.CFrame * CFrame.new(-0.65, 0.075, 0) * CFrame.Angles(0, 0, u * math.rad(115)) * CFrame.new(0.65, -0.075, 0)
	lid.CFrame, cover.CFrame = hinge * rest.lid, hinge * rest.cover
end

-- A disc lying flat, its label the right way up (a cylinder's round face is its +X; its picture's top, its +Y)
local DISC_FLAT = CFrame.fromMatrix(Vector3.new(), Vector3.new(0, 1, 0), Vector3.new(0, 0, -1), Vector3.new(-1, 0, 0))
-- A disc in its case, lying flat, the cover up: tray (the back cover under it), spine, the disc on its rosette, the clear
-- lid with the front cover in it. Its art from the kit's folder; scratched, it shows
local function makeDisc(entry)
	local m = make("Model", { Name = "Noise90Disc" }, nil)
	local function piece(name, size, cf, props)
		local p = make("Part", { Name = name, Size = size, CFrame = cf, Anchored = true, CanCollide = false, CanTouch = false, CastShadow = false,
			Color = rgb(18, 18, 22), Material = Enum.Material.SmoothPlastic }, m)
		for k, v in pairs(props or {}) do p[k] = v end
		return p
	end
	local function decal(part, face, file, z)
		return make("Decal", { Name = "Art", Face = face, Texture = files.discs[file] or "", ZIndex = z or 1 }, part)
	end
	local art = entry.art
	-- A Top decal's picture has its top towards the part's back (+Z) and its right towards -X (as seen in DOORS); a Right
	-- decal's, up (+Y) and -Z. Each picture is turned so that, the spine on the left, it reads the right way up
	local tray = piece("Tray", Vector3.new(1.3, 0.05, 1.15), CFrame.new(0, 0.025, 0))
	decal(piece("Back", Vector3.new(1.3, 0.004, 1.15), CFrame.new(0, -0.002, 0) * CFrame.Angles(0, 0, math.pi)), Enum.NormalId.Top, art .. "_Back")
	decal(piece("Spine", Vector3.new(0.05, 0.12, 1.15), CFrame.new(-0.675, 0.06, 0)), Enum.NormalId.Left, art .. "_Spine")
	piece("Rosette", Vector3.new(0.02, 0.32, 0.32), CFrame.new(0, 0.055, 0) * CFrame.Angles(0, 0, math.pi / 2),
		{ Shape = Enum.PartType.Cylinder, Color = rgb(60, 60, 66) })
	local cd = piece("Disc", Vector3.new(0.012, 1.02, 1.02), CFrame.new(0, 0.062, 0) * DISC_FLAT,
		{ Shape = Enum.PartType.Cylinder, Color = rgb(205, 210, 220), Material = Enum.Material.Foil, Reflectance = 0.2 })
	decal(cd, Enum.NormalId.Right, art .. "_Label", 1)
	if entry.condition == "scratched" then decal(cd, Enum.NormalId.Right, "Scratch", 2).Name = "Wear" end
	piece("Lid", Vector3.new(1.3, 0.02, 1.15), CFrame.new(0, 0.11, 0), { Material = Enum.Material.Glass, Color = rgb(225, 230, 240), Transparency = 0.6 })
	decal(piece("Cover", Vector3.new(1.24, 0.008, 1.1), CFrame.new(0, 0.096, 0) * CFrame.Angles(0, math.pi, 0)), Enum.NormalId.Top, art .. "_Front")
	make("PointLight", { Name = "Glint", Color = BLUE, Brightness = 0.5, Range = 4 }, tray)
	m.PrimaryPart = tray
	entry.model = m
	entry.parts = { tray = tray, disc = cd }
	entry.rest = { lid = tray.CFrame:ToObjectSpace(m.Lid.CFrame), cover = tray.CFrame:ToObjectSpace(m.Cover.CFrame), disc = tray.CFrame:ToObjectSpace(cd.CFrame) }
	entry.take = newPrompt(tray, "Take", entry.title, 0.2, 8)
	entry.look = newPrompt(tray, "Inspect", entry.title, 0, 8)
	entry.look.KeyboardKeyCode, entry.look.GamepadKeyCode, entry.look.UIOffset = Enum.KeyCode.R, Enum.KeyCode.ButtonY, Vector2.new(0, 70)
	on(entry.take.Triggered, function() takeDisc(entry) end)
	return m
end

