function PHASES.colors(noise)
	state = "phase"
	noise.rig:play(noise.anims.Walk, 0)
	for round = 1, rounds() do
		if not hold(1.5) then return end
		local target = rainbow[math.random(#rainbow)]
		local others = {}
		for _, e in ipairs(rainbow) do
			if e ~= target then table.insert(others, e) end
		end
		local ink = others[math.random(#others)].color
		local seconds = V.time[math.min(round, #V.time)]
		local chosen = nil
		local picks = {}
		for _, e in ipairs(rainbow) do
			e.prompt.Enabled = true
			table.insert(picks, e.prompt.Triggered:Connect(function() chosen = chosen or e end))
		end
		oneShot(A90.spawn, SoundService, { Volume = CONFIG.Volume * 0.6, PlaybackSpeed = 0.8 })
		showColor(target.name, ink, seconds)
		local t0 = os.clock()
		while alive and state == "phase" and not chosen and os.clock() - t0 < seconds do RunService.Heartbeat:Wait() end
		for _, c in ipairs(picks) do c:Disconnect() end
		for _, e in ipairs(rainbow) do e.prompt.Enabled = false end
		if colorGui then colorGui.Enabled = false end
		if not (alive and state == "phase") then return end
		local safe = chosen == target or (V.hard and not chosen and hiding() ~= nil)
		if safe then
			oneShot(SOUNDS.click, (chosen or target).main)
			local record = (chosen or target).record
			record.picture.ImageColor3 = Color3.new(1, 1, 1)
			task.delay(0.3, function() record.picture.ImageColor3 = record.tint end)
		elseif V.hard then
			faceCheck({ force = true, window = 0.3, frenzy = true, damage = math.huge }) -- no way out
			return
		else
			fool()
			return
		end
	end
	if alive and state == "phase" then
		fizzle(noise)
		screensOff()
		state = "done"
	end
end

-- X-60: a warning (it screams, the screen shakes), then it rushes the room twice: hide
function PHASES.rush(noise)
	state = "phase"
	scream(noise)
	shake(6)
	pcall(function()
		local events = require(game:GetService("ReplicatedStorage").ModulesClient.Module_Events)
		events.flicker(roomModel(), 2.5)
	end)
	local base = noise.root.CFrame
	local t0 = os.clock()
	while alive and state == "phase" and os.clock() - t0 < 2.6 do -- it shakes where it stands
		noise.root.CFrame = base * CFrame.new(rnd(0.25), rnd(0.1), rnd(0.25))
		RunService.Heartbeat:Wait()
	end
	setLevel(noise, true)
	local a, b = noise.position, acrossRoom(noise)
	local function check(n)
		local _, _, root = body()
		if not root then return true end
		if (root.Position - n.position).Magnitude < 14 and not hiding() then return hurt(math.huge) end
		return false
	end
	for _ = 1, 2 do
		if not dash(noise, a, b, 90, check) or not dash(noise, b, a, 90, check) then break end
	end
	if alive and state == "phase" then
		climbBack(noise)
		state = "done"
	end
end

---====== RUN ======---

local function run()
	if CONFIG.Time > 0 then task.wait(CONFIG.Time) end
	local t0 = os.clock()
	while not filesReady and os.clock() - t0 < 20 do task.wait(0.1) end
	if V.crucify then giveCrucifix() end
	local setup = (SETUPS[chooseSetup()] or SETUPS.Ceiling)()
	if setup.hammer and CONFIG.Hammer then
		hammer = makeHammer()
		hammer.Name = "NoiseHammer"
		hammerPrompt = newPrompt(hammer, "Throw at the TV", "Hammer", 0.25, 9)
		hammerPrompt.Name = "ThrowPrompt"
		on(hammerPrompt.Triggered, function() task.spawn(throwHammer) end)
	end
	while alive and not setup.place() do task.wait(1) end
	if hammer then placeHammer() end
	hum = sound(files.static, { Looped = true, Volume = 0.15 * CONFIG.Volume, RollOffMaxDistance = 50 }, screen)
	if hum then
		table.insert(owned, hum)
		if not setup.ready then hum:Play() end -- the pedestal's: once the TV stands on it
	end

	-- Waiting: static on its screens. What sets it off: you stare at it, come close, open a drawer, put a disc in
	local trigger = setup.trigger or V.trigger
	local dontLook = V.name == "B-90" and tostring(CONFIG.Disc):lower():find("dont") ~= nil
	if dontLook and trigger == "look" then trigger = "dontlook" end
	local seen, room, frame = 0, latestRoom(), 0
	drawers = 0
	while alive and state == "waiting" do
		local dt = RunService.RenderStepped:Wait()
		if CONFIG.FollowDoors and latestRoom() ~= room then -- a new room: the TV is there now (until you have touched it)
			room = latestRoom()
			if setup.place() and hammer then placeHammer() end
			seen = 0
		end
		if not setup.ready or setup.ready() then
			if files.sheets[1] then -- the tape's first second, static, over and over
				frame = (frame + dt * TAPE.fps) % 20
				for _, record in ipairs(screens) do
					if record.gui.Enabled then sheetFrame(record.picture, math.floor(frame)) end
				end
			end
			local _, _, root = body()
			local near = if root then (root.Position - screen.Position).Magnitude else math.huge
			local seenNear = false
			if root and near <= CONFIG.NearDistance then
				local hit = cast(root.Position, screen.Position - root.Position)
				seenNear = not hit or (hit.Position - root.Position).Magnitude > near - 2
			end
			local p = 0
			if trigger == "look" then
				seen = if lookingAtAny() then seen + dt else math.max(seen - dt * 0.5, 0)
				p = math.clamp(seen / CONFIG.LookTime, 0, 1)
				if seen >= CONFIG.LookTime then break end
			elseif trigger == "near" or trigger == "dontlook" then
				p = math.clamp(1 - (near - CONFIG.NearDistance) / 30, 0, 1) * 0.5
				if seenNear then break end
			elseif trigger == "away" then
				if near <= CONFIG.NearDistance * 1.6 then break end
			elseif trigger == "drawer" then
				if drawers > 0 then break end
			elseif trigger == "disc" then
				if disc.inserted then break end
			end
			if hum then hum.Volume = (0.15 + p * 0.85) * CONFIG.Volume end
			tintTo(p * 0.6)
		end
	end
	if not alive or state ~= "waiting" then return end
	tint.TintColor = Color3.new(1, 1, 1)
	if trigger == "disc" then -- the disc decides (B-90's two); the rest play it their own way
		task.wait(0.9)
		dontLook = V.name == "B-90" and tostring(CONFIG.Disc):lower():find("dont") ~= nil
		trigger = if dontLook then "dontlook" elseif V.trigger == "away" then "away" else "look"
	end
	if setup.name ~= "Screens" then joinWorldScreens() end -- the Archives: every screen plays it

	-- The tape; then out it comes, and does its thing
	if not playTape(trigger) or not alive then
		if alive and state == "tape" then -- you never looked: the TV goes dark
			screensOff()
			state = "done"
		end
		return
	end
	local noise
	if V.phase == "g90" and g90Mode == "Paper" then
		noise = fromPaper()
	elseif #screens >= 2 then
		noise = emergePieces()
	else
		noise = emerge()
	end
	if noise and alive and state == "emerging" then (PHASES[V.phase] or PHASES.chase)(noise) end
end

local cleanup = function()
	alive = false
	pcall(function() RunService:UnbindFromRenderStep("NoiseCutscene") end)
	for _, c in ipairs(connections) do c:Disconnect() end
	if restoreCutscene then pcall(restoreCutscene) end
	for _, i in ipairs({ folder, overlay, tint, blur, faceGui }) do i:Destroy() end
	for _, i in ipairs(owned) do pcall(function() i:Destroy() end) end
	if colorGui then colorGui:Destroy() end
	local bars = hud:FindFirstChild("NoiseCutscene")
	if bars then bars:Destroy() end
end
if getgenv then getgenv().__NoiseCleanup = cleanup end

task.spawn(run)
