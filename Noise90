-- Its feet on the floor under `p` (a point as high as your root), looking along `look`
local function setAt(noise, p, look)
	if noise.crucified then return end -- the crucifix has it now
	local floor = floorUnder(p)
	local floorY = if floor then floor.Y else p.Y - 3
	noise.position = Vector3.new(p.X, floorY + 3, p.Z)
	if look then noise.look = look end
	local at = Vector3.new(p.X, floorY + noise.hip, p.Z)
	noise.root.CFrame = CFrame.lookAt(at, at + (noise.look or Vector3.new(0, 0, -1)))
end

-- Straight to `target` at `speed` studs a second (backwards: looking the way it looks). True when it got there
local function walkTo(noise, target, speed, maxTime, backwards)
	local t0 = os.clock()
	noise.rig:play(noise.anims.Walk, if backwards then -speed / 10 else speed / 10)
	while alive and not noise.gone and not noise.crucified and os.clock() - t0 < (maxTime or 10) do
		local dt = RunService.Heartbeat:Wait()
		if frozen() then
			t0 += dt
			continue
		end
		local to = (target - noise.position) * Vector3.new(1, 0, 1)
		if to.Magnitude < 0.6 then return true end
		local dir = to.Unit
		setAt(noise, noise.position + dir * math.min(speed * dt, to.Magnitude), if backwards then nil else dir)
	end
	return false
end

-- Hidden for a while (it pretends it is gone), or back
local function vanish(noise, hidden)
	if hidden and noise.crucified then return end
	for _, d in ipairs(noise.model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = if hidden then 1 else 0
		elseif d:IsA("ParticleEmitter") then
			if hidden then
				d:SetAttribute("WasOn", d.Enabled)
				d.Enabled = false
			elseif d:GetAttribute("WasOn") then
				d.Enabled = true
			end
		end
	end
	noise.glow.Enabled, noise.light.Enabled = not hidden, not hidden
	for _, name in ipairs({ "Idle", "EnragedIdle" }) do
		local s = noise:sound(name)
		if s then if hidden then s:Stop() elseif name == "Idle" then s:Play() end end
	end
end

-- It is about to get you, and you hold a crucifix: it is crucified instead (any of them, wherever it is: out of its TV, out
-- of hiding). True when it is, or already was
