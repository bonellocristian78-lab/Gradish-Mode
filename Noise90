function PHASES.colors(noise)
	state = "phase"
	local count = V.colors or 3
	local pick = COLORS[math.random(count)]
	-- Dark room, its TV (and every screen) glowing that colour, and it glows that colour too
	roomLights(false)
	for _, record in ipairs(screens) do
		record.face.Visible = false
		record.picture.Image, record.picture.BackgroundColor3 = "", pick.color
		for _, light in ipairs(record.part:GetDescendants()) do
			if light:IsA("Light") then light.Enabled, light.Color, light.Brightness, light.Range = true, pick.color, 4, 30 end
		end
	end
	noise.glow.FillColor, noise.glow.OutlineColor, noise.glow.FillTransparency = pick.color, pick.color, 0.3
	noise.light.Color, noise.light.Brightness = pick.color, 4
	noise.rig:play(noise.anims.Walk, 0)
	if not hold(1.2) then return end
	-- It splits into three that circle you: one is its colour
	local others = {}
	for i = 1, count do
		if COLORS[i] ~= pick then table.insert(others, COLORS[i]) end
	end
	local ring = { pick, table.remove(others, math.random(#others)), table.remove(others, math.random(#others)) }
	local clones = {}
	for i, c in ipairs(ring) do
		local core = make("Part", { Name = "S90Clone", Size = Vector3.new(1, 1, 1), Transparency = 1, Anchored = true, CanCollide = false,
			CanQuery = false, CanTouch = false }, folder)
		local board = make("BillboardGui", { Size = UDim2.new(4.5, 0, 4.5, 0), LightInfluence = 0, MaxDistance = 300 }, core)
		make("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = image(V.face) or "", ImageColor3 = c.color }, board)
		make("PointLight", { Color = c.color, Brightness = 3, Range = 12 }, core)
		clones[i] = { part = core, angle = i * math.pi * 2 / 3 }
	end
	vanish(noise, true)
	noise:burst("FlashParticle", 30)
	oneShot(SOUNDS.glitch, noise.root, { Volume = CONFIG.Volume })
	local circling = on(RunService.Heartbeat, function(dt)
		local _, _, root = body()
		if not root then return end
		for _, clone in ipairs(clones) do
			clone.angle += dt * 1.4
			clone.part.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(clone.angle) * 7, 1.5 + math.sin(clone.angle * 3) * 0.4, math.sin(clone.angle) * 7))
		end
	end)
	local chosen = askColor(count, V.time or 7)
	circling:Disconnect()
	for _, clone in ipairs(clones) do clone.part:Destroy() end
	if not (alive and state == "phase") then return end
	local safe = chosen == pick or (V.hard and not chosen and hiding() ~= nil)
	roomLights(true)
	if safe then
		oneShot(SOUNDS.click, SoundService)
		vanish(noise, false)
		fizzle(noise)
		screensOff()
		state = "done"
	elseif not crucified(noise) then -- (a crucifix in your hand: crucified instead)
		fool()
	end
end

--[[ X-60 (the wiki): it goes off the way you came, then rushes back to your room, faster and faster, loud static and quiet
     screams; in the room it stops for 9 seconds, slowly going down, and goes. Hide in any hiding place (it sees you if you
     do not, while it rushes and while it stays) ]]
function PHASES.rush(noise)
	state = "phase"
	local static = sound(files.static, { Looped = true, Volume = CONFIG.Volume * 1.8, RollOffMinDistance = 25, RollOffMaxDistance = 400 }, noise.root)
	if static then static:Play() end
	scream(noise)
	pcall(function()
		local events = require(game:GetService("ReplicatedStorage").ModulesClient.Module_Events)
		events.flicker(roomModel(), 2.5)
	end)
	-- Off down the way you came, out of sight
	vanish(noise, true)
	if not hold(2.6) then return end
	local route = {}
	for i = math.max(1, #trail - 90), #trail do table.insert(route, trail[i]) end
	local finish = acrossRoom(noise)
	local exit = roomModel() and roomModel():FindFirstChild("RoomExit")
	if exit then finish = exit.Position end
	table.insert(route, finish)
	if #route < 2 then table.insert(route, 1, finish + (noise.look or Vector3.new(0, 0, 1)) * 60) end
	vanish(noise, false)
	setLevel(noise, true)
	noise.rig:play(noise.anims.HijackWalk or noise.anims.Walk, 3)
	local streak = addTrail(noise, 0.5)
	streak.Enabled = true
	local function seen(range)
		local _, _, root = body()
		if not root or hiding() then return false end
		local to = root.Position - noise.position
		if to.Magnitude > range then return false end
		local hit = cast(noise.position, to)
		return not hit or (hit.Position - noise.position).Magnitude > to.Magnitude - 1.5
	end
	local screamAt = os.clock() + 1.5
	setAt(noise, route[1])
	local i, t0 = 2, os.clock()
	while alive and state == "phase" and route[i] do
		local dt = RunService.Heartbeat:Wait()
		if not frozen() then
			local speed = 60 + 100 * math.min((os.clock() - t0) / 4, 1) -- faster and faster
			local budget = speed * dt
			while budget > 0 and route[i] do
				local to = (route[i] - noise.position) * Vector3.new(1, 0, 1)
				if to.Magnitude <= budget then
					budget -= to.Magnitude
					setAt(noise, route[i], if to.Magnitude > 0.05 then to.Unit else nil)
					i += 1
				else
					setAt(noise, noise.position + to.Unit * budget, to.Unit)
					budget = 0
				end
			end
		end
		if os.clock() >= screamAt then
			screamAt = os.clock() + 1.5 + math.random() * 2
			oneShot(files.scream, noise.root, { Volume = CONFIG.Volume * 0.25, PlaybackSpeed = 0.7 + math.random() * 0.6 })
		end
		if seen(14) and hurt(math.huge) then return end
	end
	streak.Enabled = false
	-- In your room: 9 seconds, slowly going down
	local base = noise.root.CFrame
	t0 = os.clock()
	while alive and state == "phase" and os.clock() - t0 < 9 do
		RunService.Heartbeat:Wait()
		noise.root.CFrame = base - Vector3.new(0, (os.clock() - t0) / 9 * 3, 0)
		if seen(30) and hurt(math.huge) then return end
	end
	if static then static:Destroy() end
	if alive and state == "phase" then
		fizzle(noise)
		state = "done"
	end
end

--[[ A-404 (Interminable Rooms' wiki). Docile: its light blue, it stands between you and the way on, in your way, its mouth
     moving: "This is a glitched server, please join a new one." 20 to 40 seconds, and it is gone. Try to get past it (or open
     the next door) and it is angered: red, godspeed, its head and its face come apart on your screen, swap, and it kicks you
     (ERROR CODE 404), hiding or not ]]
local GLITCHED = "This is a glitched server, please join a new one."
-- Its jumpscare: on its static, its head and its face apart, all over your screen, glitching; they swap again and again; the kick
local function kicked404()
	local gui = make("ScreenGui", { Name = "Noise90Error", IgnoreGuiInset = true, DisplayOrder = 100005, ResetOnSpawn = false }, hud)
	table.insert(owned, gui)
	make("ImageLabel", { Name = "Static", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0,
		Image = image(V.static) or "", ImageColor3 = V.color, ScaleType = Enum.ScaleType.Tile, TileSize = UDim2.fromOffset(160, 160) }, gui)
	local function layer(name, file, size)
		local l = make("ImageLabel", { Name = name, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(size, size),
			BackgroundTransparency = 1, Image = image(file) or "" }, gui)
		make("UIAspectRatioConstraint", { AspectRatio = 1 }, l)
		return l
	end
	local head, face = layer("Head", V.heads[1], 0.7), layer("Face", V.mouth, 0.45)
	oneShot(files.scream, SoundService, { Volume = CONFIG.Volume * 1.6, PlaybackSpeed = 0.8 })
	oneShot(SOUNDS.glitch, SoundService, { Volume = CONFIG.Volume * 1.2 })
	local t0 = os.clock()
	while alive and os.clock() - t0 < 1.6 do -- apart, all over, glitching
		head.Image = image(V.heads[math.random(#V.heads)]) or head.Image
		head.Position = UDim2.fromScale(0.25 + math.random() * 0.5, 0.25 + math.random() * 0.5)
		face.Position, face.Rotation = UDim2.fromScale(0.25 + math.random() * 0.5, 0.25 + math.random() * 0.5), rnd(20)
		shake(4)
		task.wait(0.06)
	end
	for _ = 1, 8 do -- they swap
		head.Position, face.Position = face.Position, head.Position
		head.Size, face.Size = face.Size, head.Size
		task.wait(0.09)
	end
	if not alive then return end
	if CONFIG.Kick then
		LocalPlayer:Kick("ERROR CODE 404")
	else
		hurt(math.huge)
		task.delay(1, function() gui:Destroy() end)
	end
end
function PHASES.glitch(noise)
	state = "phase"
	local _, _, root = body()
	if not root then return end
	local room = roomModel()
	local exit = room and room:FindFirstChild("RoomExit")
	local along = (exit and flat(exit.Position - root.Position)) or flat(root.CFrame.LookVector) or Vector3.new(0, 0, -1)
	local spot = if exit then root.Position:Lerp(exit.Position, 0.5) else root.Position + along * 12 -- between you and the way on
	local static = make("ParticleEmitter", { Name = "A404Static", Texture = image(V.static) or "", Rate = 14, Lifetime = NumberRange.new(0.12, 0.25),
		Speed = NumberRange.new(0), Size = NumberSequence.new(5.5), Rotation = NumberRange.new(0, 360), LockedToPart = true, LightEmission = 0.4,
		ZOffset = -1 }, noise.model:FindFirstChild("Head") or noise.root)
	static:SetAttribute("KeepColor", true)
	local function lit(color) -- all of it in that colour: its light, its glow, its static (and white), its body
		noise.glow.FillColor, noise.glow.OutlineColor, noise.light.Color = color, color, color
		static.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
		for _, d in ipairs(noise.model:GetDescendants()) do
			if d:IsA("ParticleEmitter") and not d:GetAttribute("KeepColor") then
				d.Color = ColorSequence.new(color)
			elseif d:IsA("Texture") then
				d.Color3 = color:Lerp(Color3.new(0, 0, 0), 0.5)
			elseif d:IsA("BasePart") then
				local _, saturation = d.Color:ToHSV()
				if saturation >= 0.15 then d.Color = color:Lerp(Color3.new(0, 0, 0), 0.25) end
			end
		end
	end
	lit(V.docile)
	walkTo(noise, spot + Vector3.new(0, 3, 0), 14, 6)
	if not (alive and state == "phase") then return end
	noise.rig:play(noise.anims.Walk, 0)
	-- In your way: a wall across the room where it stands
	local mid, side = noise.position, along:Cross(Vector3.new(0, 1, 0))
	local function reachTo(dir) local hit = cast(mid, dir * 30) return if hit then (hit.Position - mid).Magnitude else 15 end
	local right, left = reachTo(side), reachTo(-side)
	local wall = make("Part", { Name = "A404Wall", Size = Vector3.new(right + left, 14, 1), Anchored = true, CanCollide = true, CanQuery = false,
		CanTouch = false, Transparency = 1, CFrame = CFrame.lookAt(mid + side * (right - left) / 2, mid + side * (right - left) / 2 + along) }, folder)
	-- What it says, at the bottom of your screen
	local said = make("ScreenGui", { Name = "Noise90Caption", ResetOnSpawn = false, DisplayOrder = 99990 }, hud)
	table.insert(owned, said)
	local words = UI.label({ Name = "Caption", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.84), Size = UDim2.fromScale(0.6, 0.05),
		Text = "" }, said, true)
	local stay, t0, room0, angered = 20 + math.random() * 20, os.clock(), latestRoom(), false
	while alive and state == "phase" and os.clock() - t0 < stay do
		RunService.Heartbeat:Wait()
		local _, _, r = body()
		if not r then break end
		local talking = (os.clock() - t0) % 7 < 3.2 -- it says it, and again
		words.Text = if talking then GLITCHED else ""
		if noise.face then
			noise.face.Image = (if talking then image(V.talk[math.floor(os.clock() * 7) % #V.talk + 1]) else image(V.face)) or noise.face.Image
		end
		setAt(noise, noise.position, flat(r.Position - noise.position))
		local near = ((r.Position - noise.position) * Vector3.new(1, 0, 1)).Magnitude < 5
		if near or (r.Position - mid):Dot(along) > 1.5 or latestRoom() ~= room0 then -- you tried to get past it
			angered = true
			break
		end
	end
	wall:Destroy()
	said:Destroy()
	if not (alive and state == "phase") then return end
	if not angered then -- its time is up: gone
		static.Enabled = false
		fizzle(noise)
		state = "done"
		return
	end
	-- Angered: red, its D8 face, godspeed: in front of you at once
	setLevel(noise, true)
	lit(V.color)
	if noise.face then noise.face.Image = image(V.angry) or noise.face.Image end
	blueFlash(0.9)
	shake(8)
	local _, _, r = body()
	if r then
		local facing = flat(r.CFrame.LookVector) or along
		setAt(noise, r.Position + facing * 3, -facing)
	end
	if crucified(noise) then return end -- a crucifix in your hand: no kick, it is crucified
	kicked404()
	state = "done"
end

---====== RUN ======---

local function run()
	if CONFIG.Time > 0 then task.wait(CONFIG.Time) end
	local t0 = os.clock()
	while not filesReady and os.clock() - t0 < 20 do task.wait(0.1) end
	giveCrucifix()
	local setup = (SETUPS[chooseSetup()] or SETUPS.Ceiling)()
	if setup.hammer and CONFIG.Hammer then
		hammer = makeHammer()
		hammer.Name = "NoiseHammer"
		hammerPrompt = newPrompt(hammer, "Throw at the TV", "Hammer", 0.25, 9)
		hammerPrompt.Name = "ThrowPrompt"
		on(hammerPrompt.Triggered, function() task.spawn(throwHammer) end)
	end
	while alive and not setup.place() do task.wait(1) end
	if hammer then placeHammer() end
	hum = sound(files.static, { Looped = true, Volume = 0.15 * CONFIG.Volume, RollOffMaxDistance = 50 }, screen)
	if hum then table.insert(owned, hum) end
	-- On (with RandomPos, once its battery is in); it can start once it is on, tuned and (the pedestal) standing there
	local function powered() return not setup.power or setup.power.on end
	local function ready()
		return powered() and (not setup.antenna or setup.antenna.tuned) and (not setup.ready or setup.ready())
	end
	local wasOn = nil
	local function power()
		local on = powered()
		if on == wasOn then return end
		wasOn = on
		for _, record in ipairs(screens) do
			if record.own then
				record.gui.Enabled = on
				if on and wasOn ~= nil then crt(record, true) end -- it switches on
			end
		end
		setLed(on)
		for _, label in ipairs(setup.antenna and setup.antenna.labels or {}) do label.Visible = on and not setup.antenna.tuned end
		if hum then if on then hum:Play() else hum:Stop() end end
	end
	power()

	-- Waiting: static on its screens. What sets it off: you stare at it, come close, open a drawer, put a disc in
	local trigger = setup.trigger or V.trigger
	local dontLook = V.name == "B-90" and tostring(CONFIG.Disc):lower():find("dont") ~= nil
	if dontLook and trigger == "look" then trigger = "dontlook" end
	local seen, room, frame = 0, latestRoom(), 0
	drawers = 0
	if CONFIG.Now then -- at once: its discs in the Journal, no waiting, no tape
		for _, d in ipairs(V.discs or { { art = V.art } }) do journal.note({ art = d.art or V.art }) end
	end
	while alive and state == "waiting" and not CONFIG.Now do
		local dt = RunService.RenderStepped:Wait()
		if CONFIG.FollowDoors and latestRoom() ~= room then -- a new room: the TV is there now (until you have touched it)
			room = latestRoom()
			if setup.place() and hammer then placeHammer() end
			seen = 0
		end
		power()
		if powered() and files.sheets[1] and not ready() then -- static only, rolling: no signal yet
			frame = (frame + dt * TAPE.fps) % 20
			for _, record in ipairs(screens) do
				if record.gui.Enabled then
					sheetFrame(record.picture, 2 + math.floor(frame))
					record.picture.ImageRectOffset += Vector2.new(0, (os.clock() * 300) % TAPE.height - TAPE.height / 2)
				end
			end
		end
		if ready() then
			if files.sheets[1] then -- the tape's first second, static, over and over
				frame = (frame + dt * TAPE.fps) % 20
				for _, record in ipairs(screens) do
					if record.gui.Enabled then sheetFrame(record.picture, math.floor(frame)) end
				end
			end
			local _, _, root = body()
			local near = if root then (root.Position - screen.Position).Magnitude else math.huge
			local seenNear = false
			if root and near <= CONFIG.NearDistance then
				local hit = cast(root.Position, screen.Position - root.Position)
				seenNear = not hit or (hit.Position - root.Position).Magnitude > near - 2
			end
			local p = 0
			if trigger == "look" then
				seen = if lookingAtAny() then seen + dt else math.max(seen - dt * 0.5, 0)
				p = math.clamp(seen / CONFIG.LookTime, 0, 1)
				if seen >= CONFIG.LookTime then break end
			elseif trigger == "near" or trigger == "dontlook" then
				p = math.clamp(1 - (near - CONFIG.NearDistance) / 30, 0, 1) * 0.5
				if seenNear then break end
			elseif trigger == "away" then
				if near <= CONFIG.NearDistance * 1.6 then break end
			elseif trigger == "drawer" then
				if drawers > 0 then break end
			elseif trigger == "disc" then
				if disc.inserted then break end
			end
			if hum then hum.Volume = (0.15 + p * 0.85) * CONFIG.Volume end
			tintTo(p * 0.6)
		end
	end
	if not alive or state ~= "waiting" then return end
	tint.TintColor = Color3.new(1, 1, 1)
	if trigger == "disc" then -- the disc decides (B-90's two); the rest play it their own way
		task.wait(0.9)
		dontLook = V.name == "B-90" and tostring(CONFIG.Disc):lower():find("dont") ~= nil
		trigger = if dontLook then "dontlook" elseif V.trigger == "away" then "away" else "look"
	end
	if setup.name ~= "Screens" then joinWorldScreens() end -- the Archives: every screen plays it

	-- The tape; then out it comes, and does its thing
	if not (CONFIG.Now or playTape(trigger)) or not alive then
		if alive and state == "tape" then -- you never looked: the TV goes dark
			screensOff()
			state = "done"
		end
		return
	end
	local noise
	if V.phase == "g90" and g90Mode == "Paper" then
		noise = fromPaper()
	elseif #screens >= 2 then
		noise = emergePieces()
	else
		noise = emerge()
	end
	if noise and alive and state == "emerging" then (PHASES[V.phase] or PHASES.chase)(noise) end
end

table.insert(SESSION.runs, function() -- (its stop)
	alive = false
	for _, c in ipairs(connections) do c:Disconnect() end
