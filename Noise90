---- A pedestal by the far wall and the TV on the floor: you put it there. The pedestal may give way ----

local function makePedestal()
	local m = make("Model", { Name = "Noise90Pedestal" }, nil)
	local metal, dark = rgb(70, 72, 83), rgb(35, 37, 54)
	local base = make("Part", { Name = "Base", Size = Vector3.new(2.6, 0.3, 2.2), Color = dark, Material = Enum.Material.Metal,
		CFrame = CFrame.new(0, 0.15, 0) }, m)
	make("Part", { Name = "Column", Size = Vector3.new(0.9, 2.9, 0.9), Color = metal, Material = Enum.Material.Metal, CFrame = CFrame.new(0, 1.75, 0) }, m)
	make("Part", { Name = "Collar", Size = Vector3.new(1.3, 0.3, 1.3), Color = dark, Material = Enum.Material.Metal, CFrame = CFrame.new(0, 3.05, 0) }, m)
	local top = make("Part", { Name = "Top", Size = Vector3.new(3.2, 0.25, 2.3), Color = dark, Material = Enum.Material.Metal,
		CFrame = CFrame.new(0, 3.32, 0) }, m)
	m.PrimaryPart = base
	clean(m)
	for _, p in ipairs(m:GetChildren()) do p.CanCollide = true end
	return m, top
