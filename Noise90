local CollectionService = game:GetService("CollectionService")
local SCREEN_HOLDERS = { "Monitor", "TV", "Terminal", "Computer", "Teller", "ScreenFrame" }
local function findScreens()
	local list, seen = {}, {}
	local _, _, root = body()
	local rooms = workspace:FindFirstChild("CurrentRooms")
	if not (root and rooms) then return list end
	local here = root.Position
	local function consider(part)
		if seen[part] or not part:IsA("BasePart") or part:IsDescendantOf(folder) or not part:IsDescendantOf(rooms) then return end
		seen[part] = true
		if (part.Position - here).Magnitude <= 80 then table.insert(list, part) end
	end
	pcall(function()
		for _, part in ipairs(CollectionService:GetTagged("RansomScreen")) do consider(part) end
	end)
	local room = roomModel()
	for _, d in ipairs(room and room:GetDescendants() or {}) do
		if d:IsA("BasePart") and (d.Name == "Screen" or d.Name == "TVScreen") then
			local holder = d:FindFirstAncestorWhichIsA("Model")
			local name = (holder and holder.Name or "") .. "/" .. (d.Parent and d.Parent.Name or "")
			for _, word in ipairs(SCREEN_HOLDERS) do
				if name:find(word) then
					consider(d)
					break
				end
			end
		end
	end
	table.sort(list, function(a, b) return (a.Position - here).Magnitude < (b.Position - here).Magnitude end)
	while #list > 8 do table.remove(list) end
	return list
end
-- The world's screens join the TV's (ours go over theirs from the tape on)
