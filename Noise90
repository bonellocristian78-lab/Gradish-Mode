-- Which piece of it a part is: head, body, left arm, right arm, left leg, right leg
local function pieceOf(name)
	if name:find("Head") or name:find("Neck") then return 1 end
	if name:find("Torso") then return 2 end
	local arm = name:find("Arm") or name:find("Hand") or name:find("Finger") or name:find("Thumb")
	if name:find("^Left") then return if arm then 3 else 5 end
	if name:find("^Right") then return if arm then 4 else 6 end
	return 2
end

-- One piece: a copy of its parts flies out of a screen along a curve, turning and growing, to where it goes on the body
local function flyPiece(parts, from, delay, landed)
	task.wait(delay)
	if not alive then return end
	local center = Vector3.new()
	for _, part in ipairs(parts) do center += part.Position end
	center /= #parts
	local copies = {}
	for _, part in ipairs(parts) do
		local copy = part:Clone()
		for _, d in ipairs(copy:GetDescendants()) do
			if not (d:IsA("Texture") or d:IsA("Decal") or d:IsA("SpecialMesh")) then d:Destroy() end -- the shape and its static only
		end
		copy.Anchored, copy.LocalTransparencyModifier = true, 0
		copy.Parent = folder
		table.insert(copies, { part = copy, rel = CFrame.new(center):ToObjectSpace(part.CFrame), size = part.Size })
	end
	local start = from.Position + outwardOf(from) * 0.6
	local mid = start:Lerp(center, 0.5) + Vector3.new(0, 2.5 + math.random() * 2, 0)
	local spin = CFrame.Angles(rnd(3), rnd(3), rnd(3))
	oneShot(SOUNDS.whir, from, { Volume = CONFIG.Volume * 0.4, PlaybackSpeed = 1.6 })
	local t0, length = os.clock(), 1.3
	while alive do
		local u = math.min((os.clock() - t0) / length, 1)
		local e = smoother(u)
		local v = 1 - e
		local p = start * (v * v) + mid * (2 * v * e) + center * (e * e)
		local turn = spin:Lerp(CFrame.new(), e)
		local k = 0.25 + 0.75 * e
		for _, c in ipairs(copies) do
			c.part.Size = c.size * k
			c.part.CFrame = CFrame.new(p) * turn * CFrame.new(c.rel.Position * k) * c.rel.Rotation
			c.part.LocalTransparencyModifier = if u < 1 and math.random() < 0.12 then 0.7 else 0
		end
		if u >= 1 then break end
		RunService.Heartbeat:Wait()
	end
	for _, c in ipairs(copies) do c.part:Destroy() end
	for _, part in ipairs(parts) do part.LocalTransparencyModifier = 0 end
	oneShot(SOUNDS.click, from, { Volume = CONFIG.Volume * 0.5 })
	landed()
