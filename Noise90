				Size = NumberSequence.new(3), Color = ColorSequence.new(Color3.new(0, 0, 0)), Speed = NumberRange.new(0.5) }, holderAt)
			make("ParticleEmitter", { Name = "FaceAngry", Texture = "rbxassetid://11924266902", Rate = 30, Lifetime = NumberRange.new(0.2), LockedToPart = true,
				Size = NumberSequence.new(5), Color = ColorSequence.new(Color3.fromRGB(35, 138, 255)), Speed = NumberRange.new(0.5), ZOffset = 2 }, holderAt)
			make("ParticleEmitter", { Name = "StopIcon", Texture = "rbxassetid://12246141362", Enabled = false, Rate = 30, Lifetime = NumberRange.new(0.2),
				LockedToPart = true, Size = NumberSequence.new(3), Color = ColorSequence.new(Color3.fromRGB(0, 0, 255)), ZOffset = 1 }, holderAt)
			clean(model)
		end
		local core = model:FindFirstChild("A90New") or model:FindFirstChildWhichIsA("BasePart")
		model.PrimaryPart = core
		local rel = {}
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then rel[p] = core.CFrame:ToObjectSpace(p.CFrame) end
		end
		local b90 = { model = model, core = core, grow = sizer(model) }
		function b90.place(position)
			for p, r in pairs(rel) do p.CFrame = CFrame.new(position) * r end
		end
		function b90.emitter(name, on, burst)
			for _, e in ipairs(model:GetDescendants()) do
				if e:IsA("ParticleEmitter") and e.Name == name then
					if on ~= nil then e.Enabled = on end
					if burst then e:Emit(burst) end
				end
			end
		end
		model.Name = "B90"
		return b90
	end

	-- The crucifix in the air: a copy of the one in your hand (yours is used up), glowing
	local function floating(tool, hand)
		local model = make("Model", { Name = "NoiseCrucifix" }, nil)
		pcall(function()
			tool.Archivable = true
			for _, d in ipairs(tool:GetDescendants()) do pcall(function() d.Archivable = true end) end
			local copy = tool:Clone()
			for _, child in ipairs(copy:GetChildren()) do child.Parent = model end
			copy:Destroy()
		end)
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("Sound") or d:IsA("TouchTransmitter") then d:Destroy() end
		end
		clean(model)
		local core = model:FindFirstChild("Handle") or model:FindFirstChildWhichIsA("BasePart", true)
		if not core then
			core = make("Part", { Name = "Handle", Size = Vector3.new(0.22, 1.7, 0.22), Color = Color3.fromRGB(92, 64, 42), Material = Enum.Material.Wood,
				CFrame = hand.CFrame, Anchored = true, CanCollide = false, CanQuery = false }, model)
			make("Part", { Name = "Crossbar", Size = Vector3.new(0.95, 0.22, 0.22), Color = Color3.fromRGB(92, 64, 42), Material = Enum.Material.Wood,
				CFrame = hand.CFrame * CFrame.new(0, 0.42, 0), Anchored = true, CanCollide = false, CanQuery = false }, model)
		end
		model.PrimaryPart = core
		make("PointLight", { Color = LIGHT, Brightness = 3, Range = 14 }, core)
		make("Highlight", { FillColor = LIGHT, OutlineColor = Color3.new(1, 1, 1), FillTransparency = 0.4, OutlineTransparency = 0.2 }, model)
		make("ParticleEmitter", { Name = "Shine", Rate = 25, Lifetime = NumberRange.new(0.4, 0.9), Speed = NumberRange.new(0.5, 2), LightEmission = 1,
			Size = NumberSequence.new(0.35, 0), Color = ColorSequence.new(LIGHT), SpreadAngle = Vector2.new(180, 180) }, core)
		local box = model:GetBoundingBox()
		local chainFrom = make("Attachment", { Name = "ChainFrom", Position = core.CFrame:PointToObjectSpace(box.Position) }, core) -- its middle
		model.Parent = folder
		if tool:GetAttribute("GradishCrucifix") then tool:Destroy() end -- ours is used up; the game's own stays the game's
		return model, core, chainFrom
	end

	-- It caught you, but you hold a crucifix. No film: you watch it with your own eyes. A chain from the crucifix catches it
	-- and it rewinds back, its walk played backwards; your crucifix flies up above it, the circle opens, it rises arms wide;
	-- B-90 is pulled out of its head along one smooth curve while the circle divides in two, the body it wore turning white;
	-- three pulls, both at once, and both go down into their circles
	function crucify(noise, tool)
		local character, _, root = body()
		if not character or noise.gone then
			state = "done"
			return
		end
		state = "crucified"
		shimmer(0)
		for _, name in ipairs({ "Idle", "EnragedIdle", "FastForward", "Footstep", "EnragedFootstep" }) do
			local s = noise:sound(name)
			if s then s:Stop() end
		end
		noise.rig.speed = 0 -- paused, like a tape
		noise:emitter("FFIcon", false)
		noise:emitter("HijackGlitch", false)
		noise:emitter("PauseIcon", true)
		local pause = noise:sound("Pause")
		if pause then pause:Play() end
		oneShot(CRUCIFIX, root, { Volume = CONFIG.Volume * 1.5 })
		blueFlash(0.4)
		shake(4)

		-- Where things go: it rewinds away from you, its circle there, B-90's to the side with the most room
		local me = root.Position
		local start = noise.root.Position
		local floor0 = floorUnder(start + up) or (start - Vector3.new(0, noise.hip, 0))
		local h = start.Y - floor0.Y
		local away = flatDir(me, start)
		local wall = cast(floor0 + up * 2, away * 9)
		local C1 = floor0 + away * math.min(if wall then math.max((wall.Position - (floor0 + up * 2)).Magnitude - 2.5, 0) else 6, 6)
		C1 = Vector3.new(C1.X, (floorUnder(C1 + up * 3) or C1).Y, C1.Z)
		local function room(dir)
			local hit = cast(C1 + up * 2, dir * 10)
			return if hit then (hit.Position - (C1 + up * 2)).Magnitude else 10
		end
		local sideDir = away:Cross(up)
		local splitDir = if room(sideDir) >= room(-sideDir) then sideDir else -sideDir
		if room(splitDir) < 4.5 then splitDir = away end -- no room beside it: behind it
		local C2 = C1 + splitDir * math.clamp(room(splitDir) - 1.5, 4, 7)
		C2 = Vector3.new(C2.X, (floorUnder(C2 + up * 3) or C2).Y, C2.Z)
		local mid = (C1 + C2) * 0.5
		local ceiling = cast(mid + up * 2, up * 16)
		local high = if ceiling then math.min(8, ceiling.Position.Y - mid.Y - 1.2) else 8
		local lift = 1.5
		local face = -away -- it faces you all along

		-- The pieces
		local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm") or root
		local handle = tool:FindFirstChild("Handle")
		local grip = if handle and handle:IsA("BasePart") then hand.CFrame:ToObjectSpace(handle.CFrame) else CFrame.new(0, -0.4, -0.5)
		local cross, crossCore, chainFrom = floating(tool, hand)
		-- Upright and facing you whatever its model's axes: its longest side up (the way you held it), its thinnest toward you
		local _, crossSize = cross:GetBoundingBox()
		local axes = { { v = Vector3.new(1, 0, 0), s = crossSize.X }, { v = Vector3.new(0, 1, 0), s = crossSize.Y }, { v = Vector3.new(0, 0, 1), s = crossSize.Z } }
		table.sort(axes, function(a, b) return a.s > b.s end)
		local long, thin = axes[1].v, axes[3].v
		if crossCore.CFrame:VectorToWorldSpace(long).Y < 0 then long = -long end
		local shape = CFrame.fromMatrix(Vector3.new(), long, thin, long:Cross(thin)):Inverse()
		local function upright(at)
			local toward = flatDir(at, root.Position)
			return CFrame.fromMatrix(at, up, toward, up:Cross(toward)) * shape
		end
		-- What it turns into when B-90 leaves: the kit's Noise without B-90, white, part by part (one body, no second one over it)
		local whiteSource = piece("NoiseModel(WithoutB-90)")
		local paints = {}
		for _, p in ipairs(noise.model:GetDescendants()) do
			if p:IsA("BasePart") and p ~= noise.root then
				local twin = whiteSource and whiteSource:FindFirstChild(p.Name, true)
				table.insert(paints, { part = p, from = p.Color, to = if twin and twin:IsA("BasePart") then twin.Color else Color3.fromRGB(205, 205, 205) })
			end
		end
		local glowFill, glowOutline = noise.glow.FillTransparency, noise.glow.OutlineColor
		local b90 = newB90()
		b90.grow(0.08)
		local circles = { newCircle(), nil }
		circles[1].place(C1, 0, 0, nil)
		local chest = holder("NoiseChest", start + up)
		local b90Point = holder("B90Point", start + up * 2)
		local tip = holder("ChainTip", crossCore.Position)
		local toNoise = chain(chainFrom, make("Attachment", { Name = "Tip" }, tip), 0.9)
		toNoise.Enabled = false
		local toB90 = chain(chainFrom, make("Attachment", { Name = "Hit" }, b90Point), 0.9)
		toB90.Enabled = false
		local rewind = noise:sound("Rewind")

		local t0, last = os.clock(), os.clock()
		local done = {}
		local function once(name) if done[name] then return false end done[name] = true return true end
		local from = nil -- its joints when it stops rewinding
		local stopUntil, showingStop = 0, false
		local B90top = C2 + up * (h + lift + 1.6)
		while alive do
			local now = os.clock()
			local t, dt = now - t0, now - last
			last = now
			if t >= END_AT then break end

			-- Where the body is: rewound back, lifted, pulled three times, pulled down
			local back = smoother(span(t, 0.45, 1.85))
			local pull = 0
			for _, pullAt in ipairs(PULLS) do pull = math.max(pull, 0.6 * hit(t, pullAt)) end
			local sink = span(t, SLAM_AT, SLAM_AT + 0.5) ^ 2 * 7
			local at = start:Lerp(C1 + up * h, back) + up * (lift * smoother(span(t, 2.0, 3.0)) - pull - sink)
			noise.root.CFrame = CFrame.lookAt(at, at + face)
			local chestAt = at + up * 1.2
			chest.CFrame = CFrame.new(chestAt)

			-- Rewinding: its own walk, backwards, and the tape's rewind
			if t >= 0.45 and once("rewind") then
				noise:emitter("PauseIcon", false)
				if noise.anims.Walk then noise.rig:play(noise.anims.Walk, -1.6) end
				if rewind then rewind:Play() end
			end
			if t >= 1.85 and once("rest") then
				noise.rig.anim = nil
				if rewind then rewind:Stop() end
				from = {}
				for name, motor in pairs(noise.rig.motors) do from[name] = motor.Transform end
			end
			if from then apply(noise, from, smoother(span(t, 1.85, 2.8)), crossPose(t)) end -- from its rewind into its animation

			-- The crucifix: in your hand, then up above it, then above both
			local crossAt
			if t < 1.85 then
				crossAt = hand.CFrame * grip
			else
				local f = smoother(span(t, 1.85, 2.75))
				local hold = hand.CFrame * grip
				local above = C1:Lerp(mid, smoother(span(t, 3.0, 6.0))) + up * (high + math.sin((t - 1.85) * 2) * 0.12 * f)
				local p = bezier(hold.Position, hold.Position + up * 2, above + up * 1, above, f)
				crossAt = CFrame.new(p) * hold.Rotation:Lerp(upright(above).Rotation, f)
			end
			cross:PivotTo(crossAt)
			-- Its chain flies out and holds it
			local fly = smoother(span(t, 0.1, 0.35))
			if fly > 0 then toNoise.Enabled = true end
			tip.CFrame = CFrame.new(crossCore.Position:Lerp(chestAt, fly))
			if fly >= 1 and once("caught") then oneShot(SLAM, noise.root, { Volume = CONFIG.Volume * 0.35, PlaybackSpeed = 1.5 }) end

			-- The circle opens under it; at the split a second one divides from it and slides under B-90
			local open = EASE.out(span(t, 2.0, 2.9)) * (1 - smoother(span(t, SLAM_AT + 0.05, SLAM_AT + 0.6)))
			if t >= 2.0 and once("open") then oneShot(RUMBLE, root, { Volume = CONFIG.Volume * 0.8 }) end
			local spin = 1 + 3 * span(t, 6, SLAM_AT) + 6 * span(t, SLAM_AT, SLAM_AT + 0.4)
			circles[1].speed = spin
			circles[1].place(C1, open, dt, chestAt)

			-- The split
			local u = smoother(span(t, 3.0, 6.0))
			local headAt = at + up * 2.4
			local b90At
			if t < 3.0 then
				b90At = headAt
			elseif t < 6.0 then
				b90At = bezier(headAt, headAt + up * 1.2 + splitDir, B90top + up * 0.6, B90top, u)
			else
				-- B-90 on its chains: it thrashes, lunges at you and is yanked back
				local wake = smoother(span(t, 6.0, 6.8))
				local thrash = Vector3.new(math.noise(t * 2.2, 1, 0), math.noise(t * 2.2, 2, 0) * 0.6, math.noise(t * 2.2, 3, 0)) * 0.8 * wake
				local lunge = 0
				for _, lungeAt in ipairs(LUNGES) do
					lunge = math.max(lunge, smoother(span(t, lungeAt, lungeAt + 0.18)) * (1 - smoother(span(t, lungeAt + 0.18, lungeAt + 0.65))))
				end
				b90At = B90top + thrash + flatDir(B90top, root.Position) * 2.4 * lunge - up * (pull + sink)
				if t < SLAM_AT then b90.grow(1 + 0.12 * math.sin((t - 6) * 6) * wake + 0.35 * lunge) end -- it breathes, and swells as it lunges
			end
			if t >= 3.0 then
				if once("split") then
					b90.model.Parent = folder
					circles[2] = newCircle()
					toB90.Enabled = true
					oneShot(GLITCH, b90.core, { Volume = CONFIG.Volume })
					oneShot(files.scream, b90.core, { Volume = CONFIG.Volume * 1.3, RollOffMinDistance = 60 })
					for _, name in ipairs({ "Rays_Thin", "Rays_Thick", "Core", "Wave", "HijackFace", "HijackFaceGlitch" }) do noise:emitter(name, false) end
				end
				if t < 6.0 then b90.grow(lerpNum(0.08, 1, smoother(span(t, 3.0, 5.0)))) end
				local change = smoother(span(t, 3.2, 5.2))
				for _, item in ipairs(paints) do item.part.Color = item.from:Lerp(item.to, change) end
				noise.glow.FillTransparency = lerpNum(glowFill, 1, change) -- a white body with the kit's black outline
				noise.glow.OutlineColor = glowOutline:Lerp(Color3.new(0, 0, 0), change)
				circles[2].speed = spin
				circles[2].place(C1:Lerp(C2, u), open, dt, b90At)
			end
			b90.place(b90At)
			b90Point.CFrame = CFrame.new(b90At)

			-- Three pulls, both at once; at each one B-90 shows its STOP
			for i, pullAt in ipairs(PULLS) do
				if t >= pullAt and once("pull" .. i) then
					oneShot(SLAM, root, { Volume = CONFIG.Volume * 0.45, PlaybackSpeed = 0.9 + i * 0.1 })
					blueFlash(0.15)
					for _, circle in ipairs(circles) do circle.burst(3) end
					stopUntil = t + 0.35
				end
			end
			for i, lungeAt in ipairs(LUNGES) do
				if t >= lungeAt and once("lunge" .. i) then
					b90.emitter("FaceAngry", nil, 10)
					oneShot(GLITCH, b90.core, { Volume = CONFIG.Volume * 0.6, PlaybackSpeed = 1.3 })
					shake(2)
				end
			end
			if t >= 3.0 then
				local stopping = t < stopUntil
				if stopping ~= showingStop then
					showingStop = stopping
					b90.emitter("StopIcon", stopping)
					b90.emitter("Face", not stopping)
					b90.emitter("FaceAngry", not stopping)
				end
			end
			-- Down into their circles: a flash, the circles close, the TV goes dark
			if t >= SLAM_AT then
				if once("slam") then
					oneShot(SLAM, root, { Volume = CONFIG.Volume * 1.3 })
					blueFlash(0.8)
					shake(8)
					for _, circle in ipairs(circles) do circle.burst(15) end
					toNoise.Enabled, toB90.Enabled = false, false
					for _, d in ipairs(cross:GetDescendants()) do
						if d:IsA("BasePart") then TweenService:Create(d, TweenInfo.new(0.6), { Transparency = 1 }):Play() end
					end
					if picture then picture.Visible = true picture.Image = "" end
					for _, light in ipairs(screen and screen:GetDescendants() or {}) do
						if light:IsA("Light") then light.Enabled = false end
					end
					if hum then hum:Stop() end
				end
				fade(noise.model, noise.root, span(t, SLAM_AT, SLAM_AT + 0.5))
				b90.grow(math.max(0.01, 1 - span(t, SLAM_AT, SLAM_AT + 0.5)))
			end
			RunService.Heartbeat:Wait()
		end

		-- Gone, both
		noise.gone = true
		for _, thing in ipairs({ noise.model, b90.model, cross, chest, b90Point, tip }) do thing:Destroy() end
		for _, circle in ipairs(circles) do circle.model:Destroy() end
		if current == noise then current = nil end
		state = "done"
	end
end

---====== OUT OF MANY SCREENS: a leg from one, an arm from another, and it comes together ======---

-- Which piece of it a part is: head, body, left arm, right arm, left leg, right leg
local function pieceOf(name)
	if name:find("Head") or name:find("Neck") then return 1 end
	if name:find("Torso") then return 2 end
	local arm = name:find("Arm") or name:find("Hand") or name:find("Finger") or name:find("Thumb")
	if name:find("^Left") then return if arm then 3 else 5 end
	if name:find("^Right") then return if arm then 4 else 6 end
	return 2
end

-- One piece: a copy of its parts flies out of a screen along a curve, turning and growing, to where it goes on the body
local function flyPiece(parts, from, delay, landed)
	task.wait(delay)
	if not alive then return end
	local center = Vector3.new()
	for _, part in ipairs(parts) do center += part.Position end
	center /= #parts
	local copies = {}
	for _, part in ipairs(parts) do
		local copy = part:Clone()
		for _, d in ipairs(copy:GetDescendants()) do
			if not (d:IsA("Texture") or d:IsA("Decal") or d:IsA("SpecialMesh")) then d:Destroy() end -- the shape and its static only
		end
		copy.Anchored, copy.LocalTransparencyModifier = true, 0
		copy.Parent = folder
		table.insert(copies, { part = copy, rel = CFrame.new(center):ToObjectSpace(part.CFrame), size = part.Size })
	end
	local start = from.Position + outwardOf(from) * 0.6
	local mid = start:Lerp(center, 0.5) + Vector3.new(0, 2.5 + math.random() * 2, 0)
	local spin = CFrame.Angles(rnd(3), rnd(3), rnd(3))
	oneShot(SOUNDS.whir, from, { Volume = CONFIG.Volume * 0.4, PlaybackSpeed = 1.6 })
	local t0, length = os.clock(), 1.3
	while alive do
		local u = math.min((os.clock() - t0) / length, 1)
		local e = smoother(u)
		local v = 1 - e
		local p = start * (v * v) + mid * (2 * v * e) + center * (e * e)
		local turn = spin:Lerp(CFrame.new(), e)
		local k = 0.25 + 0.75 * e
		for _, c in ipairs(copies) do
			c.part.Size = c.size * k
			c.part.CFrame = CFrame.new(p) * turn * CFrame.new(c.rel.Position * k) * c.rel.Rotation
			c.part.LocalTransparencyModifier = if u < 1 and math.random() < 0.12 then 0.7 else 0
		end
		if u >= 1 then break end
		RunService.Heartbeat:Wait()
	end
	for _, c in ipairs(copies) do c.part:Destroy() end
	for _, part in ipairs(parts) do part.LocalTransparencyModifier = 0 end
	oneShot(SOUNDS.click, from, { Volume = CONFIG.Volume * 0.5 })
	landed()
end

-- -> Noise, whole, standing between the screens and you
local function emergePieces()
	state = "emerging"
	local noise = makeNoise()
	current = noise
	local main = screens[1].part
	local _, _, root = body()
	local out = flat(outwardOf(main)) or Vector3.new(0, 0, -1)
	local toward = root and flat(root.Position - main.Position) or out
	local spot = main.Position + toward * 6
	local floorY = (floorUnder(spot) or spot - Vector3.new(0, 9, 0)).Y
	noise.look = if root then flat(root.Position - spot) or toward else toward
	local at = Vector3.new(spot.X, floorY + noise.hip, spot.Z)
	noise.root.CFrame = CFrame.lookAt(at, at + noise.look)
	noise.position = Vector3.new(spot.X, floorY + 3, spot.Z)
	noise.home = { ahead = noise.position, standing = at.Y, startY = at.Y, top = 0, low = 0, torso = nil, look = noise.look }
	-- Hidden, standing, its static off: the pieces come
	local groups, emitters = { {}, {}, {}, {}, {}, {} }, {}
	for _, d in ipairs(noise.model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= noise.root then
			d.LocalTransparencyModifier = 1
			table.insert(groups[pieceOf(d.Name)], d)
		elseif d:IsA("ParticleEmitter") and d.Enabled then
			d.Enabled = false
			table.insert(emitters, d)
		end
	end
	noise.glow.Enabled = false
	noise.model.Parent = folder
	noise.rig:play(noise.anims.Walk, 0)
	RunService.Heartbeat:Wait() -- its pose in place
	RunService.Heartbeat:Wait()
	local flying, order = 0, 0
	for g, parts in ipairs(groups) do
		if #parts > 0 then
			flying += 1
			local from = screens[(g - 1) % #screens + 1].part
			task.spawn(flyPiece, parts, from, order * 0.28, function() flying -= 1 end)
			order += 1
		end
	end
	local t0 = os.clock()
	while alive and state == "emerging" and flying > 0 and os.clock() - t0 < 8 do RunService.Heartbeat:Wait() end
	for _, parts in ipairs(groups) do
		for _, part in ipairs(parts) do part.LocalTransparencyModifier = 0 end
	end
	for _, e in ipairs(emitters) do e.Enabled = true end
	noise.glow.Enabled = true
	if not (alive and state == "emerging") then return nil end
	-- Together: a flash, its cry
	noise:burst("FlashParticle", 40)
	local sfx = noise:sound("Emerge")
	if sfx then sfx:Play() end
	blueFlash(0.6)
	shake(5)
	return noise
end

