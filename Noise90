local AROUND = { Vector3.new(1.4, 0, 0), Vector3.new(-1.4, 0, 0), Vector3.new(0, 0, 1.4), Vector3.new(0, 0, -1.4) }
-- The floor at a point where the hammer can lie and be picked up: seen from `from` (no wall between), a floor under it,
-- nothing low above it (no table, no bed), no wall right next to it. Nil otherwise
local function hammerFloor(from, point)
	if (point - from).Magnitude > 0.1 and cast(from, point - from) then return nil end
	local floor = cast(point, Vector3.new(0, -9, 0))
	if not floor or floor.Normal.Y < 0.8 then return nil end
	local at = floor.Position
	if cast(at + Vector3.new(0, 0.2, 0), Vector3.new(0, 4, 0)) then return nil end
	for _, side in ipairs(AROUND) do
		if cast(at + Vector3.new(0, 0.6, 0), side) then return nil end
	end
	return at
end

-- On the floor of the TV's room, lying flat, somewhere along the way through it
local function placeHammer()
	if not CONFIG.Hammer or not hammer then return end
	local room = roomModel()
	local entrance = room and room:FindFirstChild("RoomEntrance")
	local exit = room and room:FindFirstChild("RoomExit")
	local from, points = nil, {}
	if entrance and exit then
		from = entrance.Position -- about 3 studs above the floor, in the doorway
		for _, f in ipairs({ 0.35, 0.5, 0.25, 0.65 }) do table.insert(points, from:Lerp(exit.Position, f)) end
		local nodes = room:FindFirstChild("PathfindNodes") -- DOORS' path through the room, when it is still there
		if nodes then
			for _, node in ipairs(nodes:GetChildren()) do
				if node:IsA("BasePart") then table.insert(points, node.Position + Vector3.new(0, 2, 0)) end
			end
		end
		local inward = entrance.CFrame.LookVector
		if (exit.Position - from):Dot(inward) < 0 then inward = -inward end
		for _, d in ipairs({ 6, 4 }) do table.insert(points, from + inward * d) end
	else
		local _, _, root = body()
		if not root then return end
		from = root.Position
		table.insert(points, (root.CFrame * CFrame.new(3, 0, -5)).Position)
		table.insert(points, (root.CFrame * CFrame.new(0, 0, -3)).Position)
	end
	local spot = nil
	for _, point in ipairs(points) do
		local side = (point - from):Cross(Vector3.new(0, 1, 0))
		side = if side.Magnitude > 0.01 then side.Unit else Vector3.new(1, 0, 0)
		for _, offset in ipairs({ rnd(2.5), 0 }) do
			spot = hammerFloor(from, point + side * offset)
			if spot then break end
		end
		if spot then break end
	end
	spot = spot or floorUnder(from) or (from - Vector3.new(0, 3, 0))
	setHammer(CFrame.new(spot + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0) * CFrame.Angles(-math.pi / 2, 0, 0))
	hammer.Parent = folder
end

