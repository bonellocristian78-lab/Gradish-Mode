		fallen = math.min(fallen, value)
		local at = Vector3.new(home.ahead.X, home.standing + (home.startY - home.standing) * (1 - fallen), home.ahead.Z)
		noise.root.CFrame = CFrame.lookAt(at, at + home.look)
		RunService.Heartbeat:Wait()
	end
	noise:burst("FlashParticle", 30)
	blueFlash(0.3)
	noise.gone = true
	noise.model:Destroy()
end

-- Along your steps from where it is, a little faster than you, for `maxTime` seconds. True: it reached you; "dead": that killed you
local function hunt(noise, maxTime)
	local t0 = os.clock()
	noise.rig:play(noise.anims.Walk, 1.3)
	local cursor, best = #trail, math.huge
	for i, p in ipairs(trail) do -- the step nearest to it
		local d = (p - noise.position).Magnitude
		if d < best then cursor, best = i, d end
	end
	while alive and state == "phase" and os.clock() - t0 < maxTime do
		local dt = RunService.Heartbeat:Wait()
		local _, humanoid, root = body()
		if not root then return "dead" end
		if frozen() then
			t0 += dt
			continue
		end
		local budget = (humanoid.WalkSpeed + 2) * dt
		local facing = nil
		while budget > 0 do
			local target = trail[cursor] or root.Position
			local step = (target - noise.position) * Vector3.new(1, 0, 1)
			if step.Magnitude <= budget then
				setAt(noise, Vector3.new(target.X, target.Y, target.Z))
				budget -= step.Magnitude
				if not trail[cursor] then break end
				cursor += 1
			else
				setAt(noise, noise.position + step.Unit * budget)
				budget = 0
			end
			if step.Magnitude > 0.05 then facing = step.Unit end
		end
		if facing then setAt(noise, noise.position, facing) end
		if (root.Position - noise.position).Magnitude < CONFIG.KillDistance then
			noise.rig:play(noise.anims.Jumpscare, 2)
			local kill = noise:sound("KillPlayer")
			if kill then kill:Play() end
			return if hurt(90) then "dead" else true
		end
	end
	return false
end

-- One run across the room. `check(noise, u)` is asked as it goes: true when that hit killed you. -> false when it is over
local function dash(noise, from, to, speed, check)
	local length = math.max((to - from).Magnitude, 1)
	local dir = flat(to - from) or noise.look
	noise.rig:play(noise.anims.HijackWalk or noise.anims.Walk, 3)
	local ff = noise:sound("FastForward")
	if ff then ff:Play() end
	local t0 = os.clock()
	while alive and state == "phase" do
		local dt = RunService.Heartbeat:Wait()
		if frozen() then
			t0 += dt
			continue
		end
		local u = math.min((os.clock() - t0) * speed / length, 1)
		setAt(noise, from:Lerp(to, u), dir)
		if check(noise, u) then
			if ff then ff:Stop() end
			return false
		end
		if u >= 1 then break end
	end
	if ff then ff:Stop() end
	return alive and state == "phase"
end

-- The far side of the room from its TV (the way in), at your root's height
local function acrossRoom(noise)
	local room = roomModel()
	local entrance = room and room:FindFirstChild("RoomEntrance")
	if entrance then return entrance.Position end
	return noise.position + (noise.look or Vector3.new(0, 0, -1)) * 40
end

local function hold(seconds)
	local t0 = os.clock()
	while alive and state == "phase" and os.clock() - t0 < seconds do RunService.Heartbeat:Wait() end
	return alive and state == "phase"
end

-- The rounds: CONFIG.Rounds, or the type's own
local function rounds() return if CONFIG.Rounds > 0 then CONFIG.Rounds else (V.rounds or 3) end

local PHASES = {}

-- B-90, C-90, Pix-90: it walks your steps
function PHASES.chase(noise)
	chase(noise)
end

-- The room's lights, off or on (DOORS' own way)
local function roomLights(on)
	pcall(function()
		local events = require(game:GetService("ReplicatedStorage").ModulesClient.Module_Events)
		events.toggle(roomModel(), on)
	end)
end
-- A streak of its colour behind it
local function addTrail(noise, lifetime)
	local a0 = make("Attachment", { Name = "TrailTop", Position = Vector3.new(0, 1.8, 0) }, noise.root)
	local a1 = make("Attachment", { Name = "TrailBottom", Position = Vector3.new(0, -1.8, 0) }, noise.root)
	return make("Trail", { Name = "Streak", Attachment0 = a0, Attachment1 = a1, Lifetime = lifetime, FaceCamera = true, LightEmission = 1,
		Color = ColorSequence.new(BLUE), Transparency = NumberSequence.new(0.1, 1), Enabled = false }, noise.root)
end
-- Every screen shows its face (between two rebounds it is in there)
local function faceOnScreens(on)
	for _, record in ipairs(screens) do
		record.face.Visible = on
		if on then
			record.face.Position, record.face.Size, record.face.ImageTransparency = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.8, 0.8), 0
			record.picture.ImageColor3 = record.tint
		end
	end
end

--[[ A-90, X-90 (the wiki): rebounds that check the lockers (X-90: and the tables). The room goes dark; between two rebounds it
     is in its TV, its face on the screen. Each time: its face on your screen (freeze), then out of the TV across the room to the
     way in and back, faster than you can follow, a streak of its colour behind it; every locker of the room it passes is
     thrown about, and if you are in one, it has you. X-90 does it four at a time ]]
local function sweep(noise, from, to, places)
	local dir = to - from
	local length2 = math.max(dir:Dot(dir), 1)
	local marks = {}
	for _, place in ipairs(places) do
		local u = math.clamp((place:GetPivot().Position - from):Dot(dir) / length2, 0, 1)
		table.insert(marks, { place = place, u = u })
	end
	local passed = false
	return dash(noise, from, to, V.dash, function(n, u)
		for _, mark in ipairs(marks) do
			if not mark.done and u >= mark.u then
				mark.done = true
				bang(mark.place)
				local kind, inside = hiding()
				if inside == mark.place and V.checks[kind] and hurt(90) then return true end
			end
		end
		local _, humanoid, root = body()
		if not root then return true end
		if not passed and (root.Position - n.position).Magnitude < 6 and humanoid.MoveDirection.Magnitude > 0.4 then
			passed = true -- you moved as it went by
			if hurt(90) then return true end
		end
		return false
	end)
end

function PHASES.rebound(noise)
	state = "phase"
	setLevel(noise, true)
	roomLights(false)
	local a, b = noise.position, acrossRoom(noise)
	local places = {}
	for kind in pairs(V.checks) do
		for _, place in ipairs(hidingPlaces(kind, a)) do table.insert(places, place) end
	end
	local streak = addTrail(noise, V.trail or 0.4)
	local total, done, volley = rounds(), 0, V.volley or 1
	local gap = V.gap[1] + math.random() * (V.gap[2] - V.gap[1])
	while alive and state == "phase" and done < total do
		-- In its TV
		vanish(noise, true)
		setAt(noise, a)
		faceOnScreens(true)
		if not hold(gap) then break end
		oneShot(A90.spawn, screen, { Volume = CONFIG.Volume, PlaybackSpeed = if volley > 1 then 1.6 else 1.2, RollOffMaxDistance = 200 })
		if faceCheck({ rule = "still" }) == "dead" or state ~= "phase" then break end
		faceOnScreens(false)
		local alright = true
		for _ = 1, volley do
			if done >= total or not alright then break end
			done += 1
			vanish(noise, false)
			noise:burst("FlashParticle", 30)
			streak.Enabled = true
			blueFlash(if volley > 1 then 0.5 else 0.3)
			shake(if volley > 1 then 6 else 3)
			alright = sweep(noise, a, b, places) and sweep(noise, b, a, places)
			streak.Enabled = false
		end
		if not alright then break end
		gap = math.max(gap * (if disc and disc.scratched then 0.7 else 0.85), 0.8) -- sooner and sooner (a scratched disc: much sooner)
	end
	faceOnScreens(false)
	roomLights(true)
	if alive and state == "phase" then
		vanish(noise, false)
		climbBack(noise)
		state = "done"
	end
end

--[[ Pix-90 (the wiki's three frames: a smile, an open mouth, a wide one). It creeps closer in pixel jumps. Now and then its face
     pops up on your screen: move while it is there and its mouth opens wider (it jumps closer); the third time it jumps at you ]]
local pixelGui = make("ScreenGui", { Name = "Noise90Pixel", IgnoreGuiInset = true, DisplayOrder = 100000, ResetOnSpawn = false, Enabled = false }, hud)
local pixelFace = make("ImageLabel", { Name = "Face", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
	ResampleMode = Enum.ResamplerMode.Pixelated }, pixelGui)
make("UIAspectRatioConstraint", { AspectRatio = 1 }, pixelFace)
-- -> true when you moved (or turned) while it watched
local function pixelWatch(stage)
	local camera = workspace.CurrentCamera
	pixelFace.Image = image(V.faces[stage]) or ""
	local size = 0.18 + stage * 0.08
	pixelFace.Size = UDim2.fromScale(size, size)
	pixelFace.Position = UDim2.fromScale(0.2 + math.random() * 0.6, 0.25 + math.random() * 0.5)
	pixelGui.Enabled = true
	oneShot(A90.spawn, SoundService, { Volume = CONFIG.Volume * 0.6, PlaybackSpeed = 1.8 - stage * 0.25 })
	local look0, t0, moved = camera.CFrame.LookVector, os.clock(), false
	while alive and os.clock() - t0 < (V.window or 1.3) do
		task.wait(1 / 6) -- six frames a second, as it is
		pixelFace.Position += UDim2.fromScale(math.random(-1, 1) * 0.004, math.random(-1, 1) * 0.004)
		local _, humanoid = body()
		if not humanoid then break end
		if humanoid.MoveDirection.Magnitude > 0.4 or (look0 - camera.CFrame.LookVector).Magnitude > 0.4 then moved = true end
	end
	pixelGui.Enabled = false
	return moved
end

function PHASES.pixel(noise)
	state = "phase"
	noise.stage = 1
	for _ = 1, rounds() do
		-- Creeping: a jump of a few pixels at a time
		local creep, t0 = 4 + math.random() * 4, os.clock()
		while alive and state == "phase" and os.clock() - t0 < creep do
			if not hold(0.35) then return end
			local _, _, root = body()
			if not root then return end
			local to = (root.Position - noise.position) * Vector3.new(1, 0, 1)
			if to.Magnitude > 7 then
				setAt(noise, noise.position + to.Unit * math.min(1.5, to.Magnitude - 7), to.Unit)
				noise:burst("PauseBlack", 6)
			end
		end
		if not (alive and state == "phase") then return end
		if pixelWatch(noise.stage) then
			noise.stage += 1
			oneShot(SOUNDS.glitch, noise.root, { Volume = CONFIG.Volume })
			local _, _, root = body()
			if root then
				local to = (root.Position - noise.position) * Vector3.new(1, 0, 1)
				if noise.stage > #V.faces then -- the third time: on you
					setAt(noise, root.Position - (if to.Magnitude > 0.1 then to.Unit else Vector3.new(0, 0, 1)) * 2.5, to.Magnitude > 0.1 and to.Unit or nil)
					noise.rig:play(noise.anims.Jumpscare, 2)
					blueFlash(0.9)
					if hurt(90) then return end
					noise.stage = 1
				elseif to.Magnitude > 4 then -- half the way, at once
					setAt(noise, noise.position + to * 0.5, to.Unit)
				end
			end
			noise:burst("FlashParticle", 20)
		end
	end
	if alive and state == "phase" then
		fizzle(noise)
		state = "done"
	end
end

-- Ransom//90: back in its TV between two drawers. A drawer: it climbs out and comes for you; it hits you and walks back in
local drawers = 0
local DRAWER_WORDS = { "Drawer", "Rolltop", "Dresser", "Desk", "Chest", "Cabinet", "Container", "Toolbox" }
local function isDrawer(p)
	if p:IsDescendantOf(folder) then return false end
	local node = p.Parent
	for _ = 1, 6 do
		if not node or node == workspace then break end
		for _, word in ipairs(DRAWER_WORDS) do
			if node.Name:find(word) then return true end
		end
		node = node.Parent
	end
	return false
end
pcall(function()
	on(game:GetService("ProximityPromptService").PromptTriggered, function(p, player)
		if player == LocalPlayer and isDrawer(p) then drawers += 1 end
	end)
end)

-- Every screen: Ransom's warning, for a moment
local function ransomNote()
	for _, record in ipairs(screens) do
		record.note = record.note or make("TextLabel", { Name = "Note", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.2,
			Size = UDim2.fromScale(1, 0.3), Position = UDim2.fromScale(0, 0.7), ZIndex = 5, Font = Enum.Font.Code, TextScaled = true,
			TextColor3 = BLUE, Text = "IF YOU DO NOT PAY THIS RANSOM BEFORE THE TIMER ENDS, YOUR ITEMS WILL BE UNRECOVERABLE", Visible = false }, record.gui)
		record.note.Visible = true
	end
	task.delay(3, function()
		for _, record in ipairs(screens) do
			if record.note then record.note.Visible = false end
		end
	end)
end

function PHASES.drawers(noise)
	local started, startRoom = os.clock(), latestRoom()
	local function over()
		local room = latestRoom()
		return os.clock() - started > CONFIG.ChaseTime * 2 or (room and startRoom and room >= startRoom + CONFIG.ChaseRooms)
	end
	local out = noise
	drawers = 0
	while alive and not over() do
		if not out then
			-- In its TV: Ransom on every screen, waiting for a drawer
			state = "phase"
			local t = 0
			while alive and state == "phase" and drawers == 0 and not over() do
				t += RunService.Heartbeat:Wait()
				for _, record in ipairs(screens) do
					sheetFrame(record.picture, math.floor(t * TAPE.fps) % 20)
					record.face.Visible = true
					record.face.Position, record.face.Size = UDim2.fromScale(0.5, 0.45), UDim2.fromScale(0.6, 0.6)
					record.face.ImageTransparency = 0.1 + 0.2 * math.abs(math.sin(t * 2))
				end
			end
			for _, record in ipairs(screens) do record.face.Visible = false end
			if not alive or state ~= "phase" or over() then break end
			drawers = 0
			out = emerge(CONFIG.EmergeSpeed * 2.5)
			if not out then break end
		end
		state = "phase"
		local caught = hunt(out, 9)
		if caught == "dead" or not alive or state ~= "phase" then break end
		if caught then ransomNote() end
		climbBack(out)
		out = nil
		drawers = 0
	end
	if out and not out.gone then fizzle(out) end
	if state == "phase" then state = "done" end
end

-- Trollface-90, XTrollface-90: it stands in your way, and its face comes onto your screen
function PHASES.screen(noise)
	state = "phase"
	local x = V.name == "XTrollface-90"
	local yellow = Color3.fromRGB(255, 230, 0)
	for _ = 1, rounds() do
		local pause = V.gap[1] + math.random() * (V.gap[2] - V.gap[1])
		local t0 = os.clock()
		while alive and state == "phase" and os.clock() - t0 < pause do -- it watches you
			RunService.Heartbeat:Wait()
			local _, _, root = body()
			if root then setAt(noise, noise.position, flat(root.Position - noise.position)) end
		end
		if not (alive and state == "phase") then return end
		if V.giggle then -- a giggle gives it away
			oneShot(if CONFIG.Laugh ~= "" then CONFIG.Laugh else A90.spawn, SoundService, { Volume = CONFIG.Volume * 0.5, PlaybackSpeed = 2.4 })
			if not hold(1.1) then return end
		end
		-- In front of you, all of a sudden
		local _, _, root = body()
		if root then
			local look = flat(root.CFrame.LookVector) or Vector3.new(0, 0, -1)
			local hit = cast(root.Position, look * 9)
			local p = if hit then hit.Position - look * 1.5 else root.Position + look * 9
			setAt(noise, p, -look)
			noise:burst("FlashParticle", 20)
		end
		local result = faceCheck({ rule = V.rule, frenzy = true, flash = if x then yellow else Color3.new(1, 0, 0),
			laugh = if CONFIG.Laugh ~= "" then CONFIG.Laugh else A90.spawn, laughSpeed = if CONFIG.Laugh ~= "" then 1 else 1.6 })
		if result == "dead" or state ~= "phase" then return end
		if result == "hit" and V.noRegen and not noise.noHealing then -- the wiki: once it has hit you, you do not heal any more
			local _, humanoid = body()
			if humanoid then
				noise.noHealing = true
				local lowest = humanoid.Health
				on(humanoid:GetPropertyChangedSignal("Health"), function()
					if humanoid.Health > lowest then humanoid.Health = lowest else lowest = humanoid.Health end
				end)
			end
		end
	end
	if alive and state == "phase" then
		fizzle(noise)
		state = "done"
	end
end

-- G-90: out of a paper on the floor (it rises out of it), or out of a computer
local function fromPaper()
	state = "emerging"
	local _, _, root = body()
	if not root then return nil end
	local look = flat(root.CFrame.LookVector) or Vector3.new(0, 0, -1)
	local hit = cast(root.Position, look * 8)
	local p = if hit then hit.Position - look * 2 else root.Position + look * 8
	local spot = floorUnder(p) or (p - Vector3.new(0, 3, 0))
	local paper = make("Part", { Name = "G90Paper", Size = Vector3.new(1.4, 0.03, 1.9), Color = rgb(235, 232, 220), Material = Enum.Material.SmoothPlastic,
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		CFrame = CFrame.new(spot + Vector3.new(0, 0.03, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0) }, folder)
	local gui = make("SurfaceGui", { Face = Enum.NormalId.Top, CanvasSize = Vector2.new(280, 380), LightInfluence = 0, Brightness = 2 }, paper)
	local face = make("ImageLabel", { Size = UDim2.fromScale(0.8, 0.6), Position = UDim2.fromScale(0.1, 0.2), BackgroundTransparency = 1,
		Image = image(V.face) or "", ImageTransparency = 1 }, gui)
	local light = make("PointLight", { Color = BLUE, Brightness = 0, Range = 12 }, paper)
	oneShot(SOUNDS.click, paper)
	local t0 = os.clock()
	while alive and os.clock() - t0 < 1.4 do -- its face shows through the paper
		local u = (os.clock() - t0) / 1.4
		face.ImageTransparency = 1 - u + (if math.random() < 0.2 then 0.4 else 0)
		light.Brightness = u * 3
		RunService.Heartbeat:Wait()
	end
	local noise = makeNoise()
	current = noise
	noise.look = flat(root.Position - spot) or -look
	noise.model.Parent = folder
	setLevel(noise, false)
	noise.rig:play(noise.anims.Walk, 0)
	noise.paper = paper
	local sfx = noise:sound("Emerge")
	if sfx then sfx:Play() end
	blueFlash(0.4)
	t0 = os.clock()
	while alive and os.clock() - t0 < 1.4 do -- up out of it
		local e = smoother(math.min((os.clock() - t0) / 1.4, 1))
		local at = Vector3.new(spot.X, spot.Y + noise.hip - (1 - e) * (noise.hip + 6), spot.Z)
		noise.root.CFrame = CFrame.lookAt(at, at + noise.look)
		RunService.Heartbeat:Wait()
	end
	setAt(noise, spot + Vector3.new(0, 3, 0))
	return noise
end
-- Down into its paper, and the paper burns away
local function intoPaper(noise)
	local paper = noise.paper
	if not (paper and paper.Parent) or noise.gone then fizzle(noise) return end
	walkTo(noise, paper.Position + Vector3.new(0, 3, 0), 14, 6)
	local start = noise.root.CFrame
	local t0 = os.clock()
	while alive and os.clock() - t0 < 1.1 do
		local e = smoother(math.min((os.clock() - t0) / 1.1, 1))
		noise.root.CFrame = start - Vector3.new(0, e * (noise.hip + 6), 0)
		RunService.Heartbeat:Wait()
	end
	noise.gone = true
	noise.model:Destroy()
	t0 = os.clock()
	local size = paper.Size
	while alive and os.clock() - t0 < 0.8 do
		local u = (os.clock() - t0) / 0.8
		paper.Size = Vector3.new(size.X * (1 - u), size.Y, size.Z * (1 - u))
		paper.Color = rgb(235, 232, 220):Lerp(Color3.new(0.1, 0.05, 0), u)
		RunService.Heartbeat:Wait()
	end
	paper:Destroy()
end
-- It looks in the hiding places of a kind, one after another (the nearest to you first)
local function checkPlaces(noise, kind)
	local _, _, root = body()
	if not root then return true end
	local places = hidingPlaces(kind, root.Position)
	for i = 1, math.min(#places, 3) do
		local place = places[i]
		local p = place:GetPivot().Position
		local toward = flat(p - noise.position)
		if toward then walkTo(noise, p - toward * 3 + Vector3.new(0, 3, 0), 28, 3) end
		if not (alive and state == "phase") then return true end
		noise.rig:play(noise.anims.Walk, 0)
		bang(place)
		local hiddenKind, inside = hiding()
		if hiddenKind == kind and inside == place then
			if hurt(90) then return true end
		end
		if not hold(0.5) then return true end
	end
	if #places == 0 then -- nowhere to look: it looks at you
		local hiddenKind = hiding()
		if hiddenKind == kind and hurt(90) then return true end
	end
	return false
end

function PHASES.g90(noise)
	state = "phase"
	if faceCheck({ rule = "still" }) == "dead" or state ~= "phase" then return end
	if checkPlaces(noise, "table") then return end
	if g90Mode == "Computer" then
		-- Gone... for five seconds
		local wind = noise:sound("WindDown")
		if wind then wind:Play() end
		vanish(noise, true)
		if not hold(5) then return end
		-- ...behind you, and now the lockers
		local _, _, root = body()
		if root then
			local back = -(flat(root.CFrame.LookVector) or Vector3.new(0, 0, -1))
			local hit = cast(root.Position, back * 7)
			setAt(noise, if hit then hit.Position - back * 1.5 else root.Position + back * 7, -back)
		end
		vanish(noise, false)
		scream(noise)
		if checkPlaces(noise, "locker") then return end
	end
	if alive and state == "phase" then
		if noise.paper then intoPaper(noise) else climbBack(noise) end
		state = "done"
	end
end

--[[ S-90, XS-90 (INTERMINABLE FEVER): the room goes dark and its TV glows a colour. Its face comes up with its buttons, as
     misspelt as on the wiki (redn, geen, bule; XS-90 also yell, magnet, cyn): click its colour in time. Meanwhile it splits
     into three that circle you, one of them its colour (Interminable Rooms' S-90). Wrong, or too late:
     "LEARN THE COLORS OF THE RAINBOW. FOOL." and you are kicked. XS-90: much less time, but hiding saves you ]]
local COLORS = { { name = "redn", color = rgb(255, 0, 0) }, { name = "geen", color = rgb(0, 255, 0) }, { name = "bule", color = rgb(0, 0, 255) },
	{ name = "yell", color = rgb(255, 255, 0) }, { name = "magnet", color = rgb(255, 0, 255) }, { name = "cyn", color = rgb(0, 255, 255) } }
local colorGui = nil
-- Its face and its buttons; -> the colour you clicked, or nil when the time is up
local function askColor(count, seconds)
	if colorGui then colorGui:Destroy() end
	colorGui = make("ScreenGui", { Name = "Noise90Colors", IgnoreGuiInset = true, DisplayOrder = 100001, ResetOnSpawn = false }, hud)
