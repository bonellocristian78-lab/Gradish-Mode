	noise.gone = true
	noise.rig.anim = nil -- frozen where it is
	for _, name in ipairs({ "Idle", "EnragedIdle", "FastForward", "Footstep", "EnragedFootstep", "Pause" }) do
		local s = noise:sound(name)
		if s then s:Stop() end
	end
	for _, name in ipairs({ "Rewind", "Fizzle" }) do
		local s = noise:sound(name)
		if s then s:Play() end
	end
	for _, name in ipairs({ "PlayIcon", "PauseIcon", "FFIcon" }) do noise:emitter(name, false) end
	noise:emitter("HijackGlitch", true)
	noise:emitter("FizzleParticle", true)
	noise.glow.OutlineTransparency = 0
	shimmer(0)
	task.spawn(function()
		local model, root = noise.model, noise.root
		local base = root.CFrame
		local parts, motors, rest = {}, {}, {}
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and d ~= root then table.insert(parts, d) end
			if d:IsA("Motor6D") then
				table.insert(motors, d)
				rest[d] = d.Transform
			end
		end
		-- Two ghosts, as when the tape slips: see-through copies of it, frozen in its pose
		local ghosts = {}
		for i = 1, 2 do
			local ghost = model:Clone()
			local pieces = {}
			for _, d in ipairs(ghost:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored, d.Material, d.Color, d.Transparency = true, Enum.Material.Neon, if i == 1 then BLUE else PALE, 1
					table.insert(pieces, d)
				elseif not d:IsA("Attachment") and not d:IsA("Model") then
					d:Destroy()
				end
			end
			ghost.Name = "NoiseGhost"
			ghost.Parent = folder
			ghosts[i] = { model = ghost, parts = pieces }
		end
		task.wait(0.15)
		local t0 = os.clock()
		while alive and model.Parent and os.clock() - t0 < 1.3 do
			local k = (os.clock() - t0) / 1.3 -- worse and worse
			for _, m in ipairs(motors) do
				m.Transform = if math.random() < 0.3 + k * 0.5 then rest[m] * CFrame.Angles(rnd(0.3 + k), rnd(0.3 + k), rnd(0.3 + k)) else rest[m]
			end
			local jump = if math.random() < 0.15 + k * 0.2 then base.RightVector * rnd(1) * (1.5 + math.random() * 2) else Vector3.new()
			root.CFrame = base + jump + Vector3.new(rnd(0.3), rnd(0.15), rnd(0.3))
			for _, p in ipairs(parts) do p.LocalTransparencyModifier = if math.random() < 0.15 + k * 0.45 then 1 else 0 end
			noise.glow.FillColor = ({ BLUE, PALE, DEEP })[math.random(3)]
			noise.glow.FillTransparency = math.random() * 0.6
			for i, ghost in ipairs(ghosts) do
				local shown = math.random() < 0.5
				for _, p in ipairs(ghost.parts) do p.Transparency = if shown then 0.5 + math.random() * 0.35 else 1 end
				if shown then ghost.model:PivotTo(base * CFrame.new((if i == 1 then -1 else 1) * (0.5 + math.random() * 1.2), rnd(0.2), 0)) end
			end
			if math.random() < 0.3 then noise:burst("PauseBlack", 4) end
			task.wait(1 / 20)
		end
		for _, ghost in ipairs(ghosts) do ghost.model:Destroy() end
		if not (alive and model.Parent) then return end
		-- Off: the picture squashes into a bright line, the line into a dot, the dot goes out
		for _, p in ipairs(parts) do p.LocalTransparencyModifier = 1 end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("ParticleEmitter") then d.Enabled = false end
		end
		noise.glow.FillTransparency, noise.glow.OutlineTransparency = 1, 1
		local wind = noise:sound("WindDown")
		if wind then wind:Play() end
		local center = base.Position + Vector3.new(0, 0.6, 0)
		local line = make("Part", { Name = "NoiseOff", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
			Material = Enum.Material.Neon, Color = PALE, Size = Vector3.new(2.6, 5, 0.05) }, folder)
		make("PointLight", { Color = BLUE, Brightness = 5, Range = 14 }, line)
		local s0 = os.clock()
		while alive and os.clock() - s0 < 0.55 do
			local u = os.clock() - s0
			local w, h
			if u < 0.1 then -- the picture squashes
				w, h = 2.6, 5 - 4.9 * (u / 0.1)
			elseif u < 0.32 then -- the line flares and shrinks to a dot
				local v = (u - 0.1) / 0.22
				w, h = 2.6 * (1 + 0.6 * math.sin(v * math.pi)) * (1 - v) + 0.18 * v, 0.1
			else -- the dot goes out
				w = 0.18 * (1 - (u - 0.32) / 0.23)
				h = w
			end
			line.Size = Vector3.new(math.max(w, 0.01), math.max(h, 0.01), 0.05)
			line.CFrame = CFrame.lookAt(center, workspace.CurrentCamera.CFrame.Position)
			RunService.Heartbeat:Wait()
		end
		line:Destroy()
		task.wait(0.4) -- its last sounds
		model:Destroy()
	end)
end

-- Its animations, and the static on its body, move every frame (after Roblox's animations, before physics)
local staticAt, pixelClock = 0, 0
on(RunService.PreSimulation or RunService.Stepped, function(a, b)
	local dt = if type(b) == "number" then b else a
	local noise = current
	if not (noise and noise.model.Parent) or frozen() then return end
	local now = os.clock()
	for i, label in ipairs(noise.orbiters) do -- X-60: two faces orbit the one in the middle, changing face as they go
		local a = now * 2.4 + i * math.pi
		label.Parent.StudsOffset = Vector3.new(math.cos(a) * 3.2, 0.6 + math.sin(a * 2) * 0.4, math.sin(a) * 3.2)
		label.Image = image(V.orbit[(math.floor(now * 2.5) + i * 2) % #V.orbit + 1]) or label.Image
	end
	if V.pixel then -- Pix-90 moves 6 times a second
		pixelClock += dt
		if pixelClock < 1 / 6 then return end
		dt, pixelClock = pixelClock, 0
	end
	-- Its walk goes only as far as it goes: standing still, it holds its step instead of walking on the spot
	local anim, at = noise.rig.anim, noise.root.Position
	if anim and (anim == noise.anims.Walk or anim == noise.anims.HijackWalk) then
		local pace = if noise.lastAt then ((at - noise.lastAt) * Vector3.new(1, 0, 1)).Magnitude / math.max(dt, 1e-3) else 0
		noise.pace = (noise.pace or pace) + (pace - (noise.pace or pace)) * math.min(dt * 12, 1)
		if noise.pace < 1 then dt = 0 end
	end
	noise.lastAt = at
	noise.rig:step(dt)
	if now >= staticAt then
		staticAt = now + 0.05
		for _, t in ipairs(noise.textures) do
			t.OffsetStudsU, t.OffsetStudsV = math.random() * 2, math.random() * 2
		end
		if noise.face then -- its face jitters like a bad tape (Pix-90: the frame its mouth is at)
			noise.face.Position = UDim2.fromScale(rnd(0.03), rnd(0.03))
			noise.face.ImageTransparency = if math.random() < 0.08 then 0.7 else 0
			if V.faces then noise.face.Image = image(V.faces[math.clamp(noise.stage, 1, #V.faces)]) or noise.face.Image end
		end
	end
end)

