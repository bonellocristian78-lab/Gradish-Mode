end
local FOOL = "LEARN THE COLORS OF THE RAINBOW. FOOL."
local function fool()
	local gui = make("ScreenGui", { Name = "Noise90Fool", IgnoreGuiInset = true, DisplayOrder = 100002, ResetOnSpawn = false }, hud)
	make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, gui)
