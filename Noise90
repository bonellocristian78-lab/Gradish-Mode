-- Its arm reaches the ceiling: the bar stretches under a high one; under a low one the TV comes down
local function hangFromCeiling()
	local base, bar = armRest.Base, armRest.Bar
	if not (base and bar) then return end
	base.part.CFrame, base.part.Size = tvMain.CFrame * base.cf, base.size -- the kit's shape again first
	bar.part.CFrame, bar.part.Size = tvMain.CFrame * bar.cf, bar.size
	local cf, size = base.part.CFrame, base.part.Size
	local top = cf.Y + 0.5 * (math.abs(cf.RightVector.Y) * size.X + math.abs(cf.UpVector.Y) * size.Y + math.abs(cf.LookVector.Y) * size.Z)
	local ceiling = cast(cf.Position, Vector3.new(0, 40, 0))
	if not ceiling then return end
	local gap = ceiling.Position.Y - top
	if gap < 0 then
		tv:PivotTo(tv:GetPivot() + Vector3.new(0, gap, 0))
		return
	end
	local low = bar.part.CFrame:PointToWorldSpace(Vector3.new(0, -bar.size.Y / 2, 0))
	local high = bar.part.CFrame:PointToWorldSpace(Vector3.new(0, bar.size.Y / 2, 0)) + Vector3.new(0, gap, 0)
	base.part.CFrame = cf + Vector3.new(0, gap, 0)
	local up = (high - low).Unit
	local right = bar.part.CFrame.RightVector
	right = (right - up * right:Dot(up)).Unit
	bar.part.Size = Vector3.new(bar.size.X, (high - low).Magnitude, bar.size.Z)
	bar.part.CFrame = CFrame.fromMatrix((high + low) * 0.5, right, up)
end

-- In front of the way out of your room, above the door, hanging from the ceiling and facing into the room; elsewhere in front of you
local function placeTV()
	local room = roomModel()
	local exit = room and (room:FindFirstChild("RoomExit") or (room:FindFirstChild("Door") and room.Door:FindFirstChild("Door")))
	local spot
	if exit and exit:IsA("BasePart") then
		local inward = exit.CFrame.LookVector
		local entrance = room:FindFirstChild("RoomEntrance")
		local inside = if entrance then entrance.Position else room:GetPivot().Position
		if (inside - exit.Position):Dot(inward) < 0 then inward = -inward end
		local box, size = tv:GetBoundingBox()
		local back = tvMain.CFrame:PointToObjectSpace(box.Position).Z + size.Z / 2 -- its arm, behind it
		local position = exit.Position + Vector3.new(0, exit.Size.Y / 2 + 1.9, 0) + inward * (back + 1.1) -- the arm clear of the wall
		spot = CFrame.lookAt(position, position + inward)
	else
		local _, _, root = body()
		if not root then return false end
		local position = (root.CFrame * CFrame.new(0, 3, -12)).Position
		spot = CFrame.lookAt(position, Vector3.new(root.Position.X, position.Y, root.Position.Z))
	end
	tv:PivotTo(spot)
	hangFromCeiling()
	tv.Parent = folder
	return true
end

