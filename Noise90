---- The Noise Journal: every disc you have found, kept in the executor's folder from one run to the next ----

local JOURNAL_FILE = CONFIG.Folder .. "/Journal.txt"
journal = { found = {}, runs = 0 } -- found[art] = { times, first (os.time) }
-- As the file has it now (the other runs going on write in it too)
function journal.load()
	pcall(function()
		if not (isfile and isfile(JOURNAL_FILE)) then return end
		for line in readfile(JOURNAL_FILE):gmatch("[^\n]+") do
			local art, times, first = line:match("^(%w+) (%d+) (%d+)$")
			if art then
				journal.found[art] = { times = tonumber(times), first = tonumber(first) }
			elseif line:match("^runs %d+$") then
				journal.runs = tonumber(line:match("%d+"))
			end
		end
	end)
end
journal.load()
function journal.save()
	local lines = { "runs " .. journal.runs }
	for art, f in pairs(journal.found) do table.insert(lines, ("%s %d %d"):format(art, f.times, f.first)) end
	pcall(function()
		if isfolder and makefolder and not isfolder(CONFIG.Folder) then makefolder(CONFIG.Folder) end
		writefile(JOURNAL_FILE, table.concat(lines, "\n"))
	end)
end
function journal.note(entry)
	journal.load()
	local f = journal.found[entry.art] or { times = 0, first = os.time() }
	f.times += 1
	journal.found[entry.art] = f
	journal.save()
	if journal.refresh then journal.refresh() end
end
journal.runs += 1
