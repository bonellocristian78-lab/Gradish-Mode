end
function newPrompt(parent, action, object, hold, distance)
	return customPrompt(make("ProximityPrompt", { Name = "Noise90Prompt", ActionText = action, ObjectText = object, HoldDuration = hold or 0,
		MaxActivationDistance = distance or 8, RequiresLineOfSight = false }, parent))
