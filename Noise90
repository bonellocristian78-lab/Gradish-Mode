	elseif inspect.entry and (kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch) then
		local p, at, size = input.Position, viewport.AbsolutePosition, viewport.AbsoluteSize
		if p and at and size and p.X >= at.X and p.X <= at.X + size.X and p.Y >= at.Y and p.Y <= at.Y + size.Y then inspect.dragging = true end
	end
end)
on(UserInputService.InputEnded, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		inspect.dragging = false
	end
end)
on(UserInputService.InputChanged, function(input)
	if not inspect.entry then return end
	local kind = input.UserInputType
	if (kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch) and inspect.dragging and input.Delta then
		inspect.yaw += input.Delta.X * 0.012
		inspect.pitch = math.clamp(inspect.pitch + input.Delta.Y * 0.012, -1.5, 1.5)
	elseif kind == Enum.UserInputType.MouseWheel and input.Position then
		inspect.dist = math.clamp(inspect.dist - input.Position.Z * 0.25, 1.2, 4)
	end
end)
