-- Its screen on: the kit's GUI on, the video loading, our picture over it, its lights in its colour
local function dressScreen()
	local gui = screen:FindFirstChildWhichIsA("SurfaceGui")
	if gui then gui.Enabled = true end -- off in the kit: the game turns it on
	video = gui and gui:FindFirstChildWhichIsA("VideoFrame")
