-- Where you hide: nil (you do not), "table" (a bed, a table, a desk) or "locker" (anything else), and the place itself
local TABLES = { "Bed", "Table", "Desk", "Cot", "Bench" }
local HIDES = { "Wardrobe", "Locker", "Closet", "Cabinet", "HidingSpot", "Toolshed", "Bed", "Table", "Desk", "Cot", "Bench" }
local function kindOf(name)
	for _, word in ipairs(TABLES) do
		if name:find(word) then return "table" end
	end
	return "locker"
end
local function isHidingPlace(model)
	if not model:IsA("Model") or model:IsDescendantOf(folder) then return false end
	for _, word in ipairs(HIDES) do
		if model.Name:find(word) then return true end
	end
	return false
end
-- The hiding places of the room of a kind ("table", "locker"), nearest to `from` first
function hidingPlaces(kind, from)
	local list = {}
	local room = roomModel()
	for _, d in ipairs(room and room:GetDescendants() or {}) do
		if isHidingPlace(d) and kindOf(d.Name) == kind and not (d.Parent and d.Parent:IsA("Model") and isHidingPlace(d.Parent)) then
			table.insert(list, d)
		end
	end
	table.sort(list, function(a, b) return (a:GetPivot().Position - from).Magnitude < (b:GetPivot().Position - from).Magnitude end)
	return list
end
function hiding()
	local character, _, root = body()
	if not character or character:GetAttribute("Hiding") ~= true then return nil, nil end
	local best, bestDistance = nil, 12
	local room = roomModel()
	for _, d in ipairs(room and room:GetDescendants() or {}) do
		if isHidingPlace(d) then
			local distance = (d:GetPivot().Position - root.Position).Magnitude
			if distance < bestDistance then best, bestDistance = d, distance end
		end
	end
	return if best then kindOf(best.Name) else "locker", best
end
