function SETUPS.Cart()
	local source = prop("TV_Stand")
	local deck = source and source:FindFirstChild("PlayerMain")
	if not (deck and deck:FindFirstChild("PlayerMain")) then return SETUPS.Table() end
	local cart = clean(source:Clone())
	cart.Name = "NoiseTV"
	for _, d in ipairs(cart:GetDescendants()) do -- for the game's physics only
		if d:IsA("BasePart") and d.Name == "DebrisCollider" then d:Destroy() end
	end
	local collider = cart:FindFirstChild("Collider")
	if collider then collider.CanCollide = true end -- you bump into it
	tv, tvMain = cart, cart:FindFirstChild("TVMain")
	screen = tvMain:FindFirstChild("TVScreen")
	dressScreen()
	measureTV()

	local player = cart.PlayerMain.PlayerMain
	local drive, light = player:FindFirstChild("Drive"), player:FindFirstChild("Light")
	disc.insert = newPrompt(player, "Put the disc in", "Media", 0.3, 8)
	disc.insert.Enabled = false
	for _, d in ipairs(V.discs or { { title = V.name } }) do
		local entry = { title = d.title, disc = d.disc }
		makeDisc(entry)
		table.insert(disc.entries, entry)
	end
	-- In your hand while you carry it
	on(RunService.Heartbeat, function()
		local entry = disc.carried
		local character = LocalPlayer.Character
		local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
		if entry and hand then
			entry.model:PivotTo(hand.CFrame * CFrame.new(0, -hand.Size.Y / 2 - 0.15, -0.3) * CFrame.Angles(0, 0, math.pi / 2))
		end
	end)
	-- Into the drive: the sleeve flat, sliding in; the player's light comes on
	on(disc.insert.Triggered, function()
		local entry = disc.carried
		if not entry or disc.inserted then return end
		disc.inserted, disc.carried = entry, nil
		disc.insert.Enabled = false
		for _, other in ipairs(disc.entries) do other.prompt.Enabled = false end
		if entry.disc then CONFIG.Disc = entry.disc end
		local from = entry.model:GetPivot()
		local slot = CFrame.new((drive or player).Position) * player.CFrame.Rotation
		task.spawn(function()
			local t0 = os.clock()
			while alive and os.clock() - t0 < 0.6 do
				local u = (os.clock() - t0) / 0.6
				entry.model:PivotTo(from:Lerp(slot, u * u * (3 - 2 * u)))
				RunService.Heartbeat:Wait()
			end
			entry.model:Destroy()
			oneShot(SOUNDS.click, player)
			oneShot(SOUNDS.whir, player, { Volume = CONFIG.Volume * 0.6 })
			if light then light.Material, light.Color = Enum.Material.Neon, BLUE end
		end)
	end)

	local setup = { name = "Cart", trigger = "disc" }
	function setup.place()
		if disc.carried or disc.inserted then return true end -- it stays once you have a disc
		local at, inward = wallSpot(2.8)
		if not at then return false end
		standAt(cart, flat(outwardOf(screen)), at, inward)
		cart.Parent = folder
		local spots = floorSpots(#disc.entries, { at })
		for i, entry in ipairs(disc.entries) do
			entry.spot = CFrame.new(spots[i] + Vector3.new(0, 0.07, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0)
			entry.model:PivotTo(entry.spot)
			entry.model.Parent = folder
		end
		return true
	end
	return setup
end

