--[[ Its face in the tape: instead of the light in the middle while it loads (frames 33-62), all over the screen in the
     glitch (63-67), and big instead of the shape in the room at the end (101-142) ]]
local function faceAt(record, frame, t)
	local face = record.face
	if face.Image == "" then
		face.Visible = false
	elseif frame >= 33 and frame <= 62 then
		face.Visible = true
		face.Position, face.Size = UDim2.fromScale(0.48, 0.3), UDim2.fromScale(0.22, 0.22)
		face.ImageTransparency = 0.15 + 0.25 * math.abs(math.sin(t * 6))
	elseif frame >= 63 and frame <= 67 then
		face.Visible = math.random() < 0.6
		face.Position, face.Size = UDim2.fromScale(math.random(), math.random()), UDim2.fromScale(0.3, 0.3)
		face.ImageTransparency = 0.2
	elseif frame >= 101 and frame <= 142 then
		local u = math.clamp((frame - 101) / 12, 0, 1)
		face.Visible = math.random() < 0.85
		face.Position = UDim2.fromScale(0.5 + rnd(0.01), 0.5 + rnd(0.01))
		face.Size = UDim2.fromScale(0.45 + 0.4 * u, 0.45 + 0.4 * u)
		face.ImageTransparency = 1 - u * 0.9
	else
		face.Visible = false
	end
end

-- X-60's own tape (shorter than the others): yellow static, its name, then the wiki's faces: one in the middle coming
-- closer, two orbiting it and changing face as they go; a flash
local X60_LENGTH = 7.4
local function x60Frame(record, t)
	local picture, face = record.picture, record.face
	local frame = if t < 1.6 then 2 + math.floor(t * 15) % 22 elseif t < 3.2 then 28 + math.floor(t * 15) % 5
		elseif t < 6 then 143 + math.floor(t * 15) % 10 else 2 + math.floor(t * 30) % 22
	sheetFrame(picture, frame)
	record.title = record.title or UI.label({ Name = "Title", Size = UDim2.fromScale(1, 0.24), FontFace = UI.title, TextColor3 = BLUE, Text = "X-60",
		ZIndex = 4, Visible = false }, record.gui, true)
	record.title.Visible = t > 1.4 and t < 3.4 and math.random() < 0.8
	record.title.Position = UDim2.fromScale(rnd(0.02), 0.06 + rnd(0.02))
	if not record.orbit then
		record.orbit = {}
		for i = 1, 2 do
			record.orbit[i] = make("ImageLabel", { Name = "Orbit", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3,
				Size = UDim2.fromScale(0.22, 0.22), Visible = false }, record.gui)
			make("UIAspectRatioConstraint", { AspectRatio = 1 }, record.orbit[i])
		end
	end
	local showing = t > 2.4 and t < 6.2
	local u = math.clamp((t - 2.4) / 3.4, 0, 1)
	face.Visible = showing and math.random() < 0.92
	face.Size = UDim2.fromScale(0.22 + 0.5 * u * u, 0.22 + 0.5 * u * u)
	face.Position = UDim2.fromScale(0.5 + rnd(0.02 * u), 0.52 + rnd(0.02 * u))
	face.ImageTransparency = 0.05
	for i, label in ipairs(record.orbit) do
		local a = t * 3 + i * math.pi
		local r = 0.18 + 0.2 * u
		label.Visible = showing and math.random() < 0.9
		label.Position = UDim2.fromScale(0.5 + math.cos(a) * r, 0.52 + math.sin(a) * r * 0.75)
		label.Image = image(V.orbit and V.orbit[(math.floor(t * 2.5) + i * 2) % #V.orbit + 1]) or face.Image
	end
	local flashing = t > 6 and t < 6.3
	picture.ImageTransparency = if flashing then 1 else 0
	picture.BackgroundColor3 = if flashing then BLUE else Color3.new(0, 0, 0)
end

--[[ On every screen that plays it, at once: on the TV's own VideoFrame when the executor can feed it the video (B-90's,
     one screen), frame by frame otherwise, tinted in its colour with its face in it. `trigger`: "away" plays it only
     while you look away from it; "dontlook" stops it as soon as you have looked at it for a while.
     -> true: it comes out. false: the TV was broken meanwhile, or (dontlook) you never looked ]]
local function playTape(trigger)
	state = "tape"
	if hum then hum:Stop() end
	local x60 = V.tape == "X-60"
	local speed = if x60 then (TAPE.frames / TAPE.fps) / X60_LENGTH else 1
	local length = if x60 then X60_LENGTH else TAPE.frames / TAPE.fps
	for _, record in ipairs(screens) do
		record.gui.Enabled = true
		record.picture.ImageColor3 = record.tint
	end
	local playingVideo = false
	if V.name == "B-90" and #screens == 1 and trigger ~= "away" and video and files.webm then
		pcall(function()
			if video.IsLoaded then
				video.Visible, picture.Visible = true, false
				video.Looped = false
				video:Play()
				playingVideo = true
			end
		end)
	end
	local audio = nil
	if not playingVideo then
		local pictures = {}
		for _, record in ipairs(screens) do table.insert(pictures, record.picture) end
		pcall(function() game:GetService("ContentProvider"):PreloadAsync(pictures) end)
		audio = sound(files.tape, { Volume = CONFIG.Volume * 1.6, RollOffMinDistance = 18, RollOffMaxDistance = 160, PlaybackSpeed = speed }, screen)
		if audio then
			audio:Play()
			table.insert(owned, audio)
		end
	end
	local lights = {}
	for _, record in ipairs(screens) do
		for _, light in ipairs(record.part:GetDescendants()) do
			if light:IsA("Light") then table.insert(lights, light) end
		end
	end
	local clock, screamed, faced, watched, angry, paused = 0, false, false, 0, false, false
	local skipAt, stutterUntil = os.clock() + 1.5, 0 -- a scratched disc skips
	tapeStartedAt = os.clock()
	while alive and state == "tape" and clock < length do
		local dt = RunService.RenderStepped:Wait()
		local seeing = (trigger == "away" or trigger == "dontlook") and lookingAtAny()
		local stop = (trigger == "away" and seeing) or frozen() -- C-90 waits while you look at it; Pause holds any tape
		if stop ~= paused then
			paused = stop
			if audio then if paused then audio:Pause() else audio:Resume() end end
			if playingVideo then pcall(function() if paused then video:Pause() else video:Play() end end) end
		end
		if disc and disc.scratched and not paused and os.clock() >= skipAt then -- it skips: a jump, a stutter
			skipAt = os.clock() + 1.2 + math.random() * 1.4
			clock = math.clamp(clock + (if math.random() < 0.5 then -1 else 1) * (0.3 + math.random() * 0.7), 0, length - 0.1)
			if audio then audio.TimePosition = clock * speed end
			if playingVideo then pcall(function() video.TimePosition = clock end) end
			stutterUntil = os.clock() + 0.25
			oneShot(SOUNDS.glitch, screen, { Volume = CONFIG.Volume * 0.4, PlaybackSpeed = 1.6 })
		end
		if not paused and os.clock() >= stutterUntil then clock += dt end
		if trigger == "dontlook" and seeing then
			watched += dt
			if watched > 1.2 then -- you looked
				angry = true
				break
			end
		end
		local t = clock * speed -- where the old tape is
		local frame = math.floor(t * TAPE.fps)
		if V.pixel then frame = math.floor(math.floor(t * 6) / 6 * TAPE.fps) end -- choppy
		for _, record in ipairs(screens) do
			if x60 then
				x60Frame(record, clock)
			elseif not playingVideo then
				sheetFrame(record.picture, frame)
				faceAt(record, frame, clock)
			end
			if paused then record.picture.ImageTransparency = if math.random() < 0.2 then 0.6 else 0 end
		end
		local glow = 0.5 + math.random() * 0.6
		for _, light in ipairs(lights) do light.Color, light.Brightness = BLUE, glow end
		tintTo(clock / length * 0.55)
		if not faced and image(V.face) and (frame >= 101 or (x60 and clock > 2.4)) then -- its face fills the screen
			faced = true
			oneShot(A90.spawn, screen, { Volume = CONFIG.Volume * 0.5, PlaybackSpeed = if x60 then 0.7 else 1.15 })
		end
		if not screamed and (if x60 then clock > 6 else t > 7.4) then -- the scream: the room's lights flicker, the camera shakes
			screamed = true
			shake(4)
			pcall(function()
				local events = require(game:GetService("ReplicatedStorage").ModulesClient.Module_Events)
				events.flicker(roomModel(), 1.5)
			end)
		end
	end
	if audio then audio:Destroy() end
	if video then pcall(function() video:Pause() end) end
	for _, record in ipairs(screens) do
		record.face.Visible = false
		record.picture.ImageTransparency = 0
		if record.title then record.title.Visible = false end
		for _, label in ipairs(record.orbit or {}) do label.Visible = false end
	end
	tint.TintColor = Color3.new(1, 1, 1)
	if state ~= "tape" then return false end -- the TV was broken meanwhile
	if trigger == "dontlook" then return angry end
	return true
end

-- The screens go dark: the tape is over and nothing came out
function screensOff()
	setLed(false)
	for _, record in ipairs(screens) do
		crt(record, false)
		record.picture.Image = ""
		record.picture.BackgroundColor3 = Color3.new(0, 0, 0)
		record.face.Visible = false
		for _, light in ipairs(record.part:GetDescendants()) do
			if light:IsA("Light") then light.Enabled = false end
		end
	end
	if video then video.Visible = false end
	if picture then picture.Visible = true end
end

