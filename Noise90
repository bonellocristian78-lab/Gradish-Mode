-- It wobbles, gives way and falls into the room; the TV falls off, cracks, and its picture goes on
local function topple(setup)
	local ped, at, inward = setup.ped, setup.at, setup.inward
	local hinge = CFrame.new(at + inward * 1.1)
	local pedRel, tvRel = hinge:ToObjectSpace(ped:GetPivot()), hinge:ToObjectSpace(tv:GetPivot())
	local axis = Vector3.new(0, 1, 0):Cross(inward)
	oneShot(SOUNDS.crack, ped.PrimaryPart, { Volume = CONFIG.Volume * 0.6, PlaybackSpeed = 0.5 })
	-- where the TV ends: on its back on the floor, in front of the pedestal
	local landing = floorUnder(at + inward * 3.6 + Vector3.new(0, 3, 0)) or (at + inward * 3.6)
	local before = tv:GetPivot()
	lieTV(landing, inward)
	local lying = tv:GetPivot()
	tv:PivotTo(before)
	local t0, offAt, tvFrom = os.clock(), nil, nil
	local landed = false
	while alive and not landed do
		local s = os.clock() - t0
		local angle
		if s < 0.9 then -- it wobbles, more and more
			angle = 0.07 * math.sin(s * 18) * (s / 0.9)
		else
			local u = math.min((s - 0.9) / 0.7, 1)
			angle = (math.pi / 2 - 0.12) * u * u
		end
		local turn = hinge * CFrame.fromAxisAngle(axis, angle)
		ped:PivotTo(turn * pedRel)
		if not offAt then
			tv:PivotTo(turn * tvRel)
			if angle > 0.45 then offAt, tvFrom = os.clock(), tv:GetPivot() end
		else
			local u = math.min((os.clock() - offAt) / 0.42, 1)
			local p = tvFrom.Position:Lerp(lying.Position, u) + Vector3.new(0, math.sin(u * math.pi) * 0.8, 0)
			tv:PivotTo(CFrame.new(p) * tvFrom.Rotation:Lerp(lying.Rotation, u))
			if u >= 1 then landed = true end
		end
		RunService.Heartbeat:Wait()
	end
	if not alive then return end
	tv:PivotTo(lying)
	emergeLook = inward
	for _, id in ipairs({ SOUNDS.glass, SOUNDS.crack }) do oneShot(id, tvMain, { Volume = CONFIG.Volume * 1.2, PlaybackSpeed = 0.9 }) end
	local glass = tvMain:FindFirstChild("BrokenScreen")
	local crack = glass and glass:FindFirstChildOfClass("Decal")
	if crack then -- cracked, over the picture that goes on
		glass.Transparency, crack.Transparency = 1, 0.35
	end
	local burst = make("ParticleEmitter", { Name = "Sparks", Enabled = false, Rate = 0, Lifetime = NumberRange.new(0.3, 0.7),
		Speed = NumberRange.new(6, 14), SpreadAngle = Vector2.new(70, 70), Acceleration = Vector3.new(0, -40, 0),
		Size = NumberSequence.new(0.12, 0), Color = ColorSequence.new(PALE), LightEmission = 1 }, screen)
	burst:Emit(30)
	shake(3)
	oneShot(SOUNDS.crack, ped.PrimaryPart, { Volume = CONFIG.Volume, PlaybackSpeed = 0.7 })
end

function SETUPS.Pedestal()
	footTV()
	local ped, top = makePedestal()
	local setup = { name = "Pedestal", ped = ped, onIt = false, carrying = false }
	local pick = newPrompt(tvMain, "Pick up", "TV", 0.4, 9)
	local put = newPrompt(top, "Put the TV here", "Pedestal", 0.2, 10)
	put.Enabled = false
	for _, record in ipairs(screens) do record.gui.Enabled = false end -- off until it stands there
	on(pick.Triggered, function()
		if setup.onIt or setup.carrying then return end
		setup.carrying, pick.Enabled, put.Enabled = true, false, true
		oneShot(SOUNDS.click, tvMain)
	end)
	on(RunService.Heartbeat, function()
		if not setup.carrying then return end
		local _, _, root = body()
		if not root then return end
		local look = flat(root.CFrame.LookVector) or Vector3.new(0, 0, -1)
		poseTV(root.Position + look * 2.6 + Vector3.new(0, 0.5, 0), look, Vector3.new(0, 1, 0))
	end)
	on(put.Triggered, function()
		if not setup.carrying then return end
		setup.carrying, put.Enabled = false, false
		local from = tv:GetPivot()
		local _, height = spanY(ped)
		poseTV(from.Position, setup.inward, Vector3.new(0, 1, 0))
		standAt(tv, nil, Vector3.new(setup.at.X, height, setup.at.Z), nil)
		local goal = tv:GetPivot()
		tv:PivotTo(from)
		task.spawn(function()
			local t0 = os.clock()
			while alive and os.clock() - t0 < 0.45 do
				local u = (os.clock() - t0) / 0.45
				tv:PivotTo(from:Lerp(goal, u * u * (3 - 2 * u)))
				RunService.Heartbeat:Wait()
			end
			tv:PivotTo(goal)
			setup.onIt = true
			oneShot(SOUNDS.click, tvMain)
			for _, record in ipairs(screens) do record.gui.Enabled = true end
			if hum then hum:Play() end
			if math.random() < CONFIG.PedestalFall then -- one day it gives way
				task.delay(3 + math.random() * 9, function()
					if alive and (state == "waiting" or state == "tape") then topple(setup) end
				end)
			end
		end)
	end)
	function setup.place()
		if setup.onIt or setup.carrying then return true end -- it stays once you have it
		local at, inward = wallSpot(2.2)
		if not at then return false end
		setup.at, setup.inward = at, inward
		standAt(ped, flat(ped.PrimaryPart.CFrame.LookVector), at, inward)
		ped.Parent = folder
		local spot = floorSpots(1, { at })[1]
		lieTV(spot, flat(spot - at) or inward)
		tv.Parent = folder
		return true
	end
	function setup.ready() return setup.onIt end
	return setup
end

