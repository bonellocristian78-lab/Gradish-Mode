	while alive and os.clock() - t0 < window do
		local dt = task.wait(1 / 30)
		if os.clock() - t0 > 0.4 then faceStop.Visible, faceWord.Visible = false, false end
		for _, s in ipairs(faceStatic) do
			s.Position = UDim2.fromScale(math.random(), math.random())
			s.Rotation = math.random(0, 1) * 180
		end
		faceImage.Position = UDim2.new(0.5, 0, 0.49, math.random(-1, 1))
		local _, hum = body()
		if not hum then break end
		local excused = LocalPlayer:GetAttribute("Stunned") == true or LocalPlayer:GetAttribute("InCutscene") == true
			or LocalPlayer:GetAttribute("Invincibility") == true
		local moving = hum.MoveDirection.Magnitude > 0.4
		if opts.rule == "move" then
			if not moving and not excused then stillFor += dt end
		elseif not excused and (moving or (look0 - camera.CFrame.LookVector).Magnitude > 0.4) then
			broke = true
		end
	end
	if opts.rule == "move" then broke = stillFor > window * 0.5 end
	if opts.force then broke = true end -- no way out
	-- Black, red, gone
	faceBack.BackgroundTransparency = 0
	faceStatic[1].ImageTransparency, faceStatic[2].ImageTransparency = 0, 0.5
	task.wait(1 / 30)
	faceImage.ImageColor3 = Color3.new(1, 0, 0)
	task.wait(1 / 30)
	local result = "pass"
	if broke and alive and crucified() then -- you hold a crucifix: no angry face, it is crucified
		result = "spared"
	elseif broke and alive then
		-- Caught: its angry face, close
		oneShot(A90.hit, SoundService, { Volume = CONFIG.Volume * 0.6 })
		faceImage.ImageColor3 = Color3.new(1, 1, 1)
		task.wait(0.07)
		faceAngry.ImageColor3, faceAngry.Visible = flashColor, true
		task.wait(0.07)
		faceAngry.ImageColor3, faceImage.Visible = Color3.new(1, 1, 1), false
		faceAngry.Size = UDim2.fromScale(0.8, 0.8)
		if opts.frenzy then -- all over the screen, flashing, screaming
			oneShot(files.scream, SoundService, { Volume = CONFIG.Volume * 1.5, PlaybackSpeed = 1.15 })
			for i = 1, 16 do
				local even = i % 2 == 0
				faceAngry.Position = UDim2.fromScale(math.random(15, 85) / 100, math.random(15, 85) / 100)
				local size = 0.35 + math.random() * 0.35
				faceAngry.Size = UDim2.fromScale(size, size)
				faceAngry.ImageColor3 = if even then flashColor else Color3.new(1, 1, 1)
				faceBack.BackgroundColor3 = if even then flashColor:Lerp(Color3.new(0, 0, 0), 0.5) else Color3.new(0, 0, 0)
				shake(3)
				task.wait(0.05)
			end
		else
			task.wait(0.75)
		end
		local damage = opts.damage or V.damage or 90
		if type(damage) == "table" then damage = math.random(damage[1], damage[2]) end
		result = if hurt(damage) then "dead" else "hit"
		faceAngry.Visible = false
		for _, c in ipairs({ Color3.new(1, 1, 1), Color3.new(1, 0, 0), Color3.new(0, 0, 0) }) do
			faceBack.BackgroundColor3 = c
			task.wait(1 / 15)
		end
	else
		-- It turns red, then white, and goes
		faceBack.BackgroundTransparency = 1
		faceStatic[1].ImageTransparency, faceStatic[2].ImageTransparency = 1, 1
		task.wait(0.08)
		faceImage.ImageColor3 = Color3.new(1, 1, 1)
		task.wait(0.08)
		if opts.laugh then oneShot(opts.laugh, SoundService, { Volume = CONFIG.Volume, PlaybackSpeed = opts.laughSpeed or 1 }) end
	end
	faceGui.Enabled = false
	checking = false
	return result
end
end

