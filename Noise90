-- The face of a part that looks most along `dir`
local function faceToward(part, dir)
	local best, bestDot = Enum.NormalId.Front, -2
	for _, n in ipairs(Enum.NormalId:GetEnumItems()) do
		local d = part.CFrame:VectorToWorldSpace(Vector3.FromNormalId(n)):Dot(dir)
		if d > bestDot then best, bestDot = n, d end
	end
	return best
end
-- Which way a screen looks: the face its picture is on
local function outwardOf(part)
	local gui = part:FindFirstChildWhichIsA("SurfaceGui")
	return part.CFrame:VectorToWorldSpace(Vector3.FromNormalId(if gui then gui.Face else Enum.NormalId.Front))
end

-- A screen for the tape: its own SurfaceGui (the kit's TVs), or one of ours on the face that looks along `facing`
-- (the world's monitors: ours goes over theirs, and away at the end). The picture is tinted in its colour
local function addScreen(part, gui, facing, tintColor)
	if not gui then
		local face = Enum.NormalId.Front
		local theirs = part:FindFirstChildWhichIsA("SurfaceGui")
		if theirs then face = theirs.Face elseif facing then face = faceToward(part, facing) end
		gui = make("SurfaceGui", { Name = "Noise90Tape", Face = face, CanvasSize = Vector2.new(800, 600), LightInfluence = 0, Brightness = 1.5,
			ZOffset = 10, Enabled = false }, part)
		table.insert(owned, gui)
	end
	local tinted = tintColor or (if V.name == "B-90" then Color3.new(1, 1, 1) else BLUE)
	local record = { part = part, gui = gui, tint = tinted }
	record.picture = make("ImageLabel", { Name = "Picture", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0,
		ImageRectSize = Vector2.new(TAPE.width, TAPE.height), ImageColor3 = tinted, ZIndex = 1 }, gui)
	record.face = make("ImageLabel", { Name = "Face", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Visible = false, ZIndex = 3,
		Image = image(V.face) or "", ImageColor3 = V.faceColor or Color3.new(1, 1, 1), Size = UDim2.fromScale(0.25, 0.25) }, gui)
	make("UIAspectRatioConstraint", { AspectRatio = 1 }, record.face)
	if V.pixel then
		record.picture.ResampleMode, record.face.ResampleMode = Enum.ResamplerMode.Pixelated, Enum.ResamplerMode.Pixelated
	end
	table.insert(screens, record)
	return record
end

local function sheetFrame(label, frame)
	local index = math.clamp(frame, 0, TAPE.frames - 1)
	local perSheet = TAPE.columns * TAPE.rows
	local sheet = files.sheets[index // perSheet + 1]
	local inSheet = index % perSheet
	if sheet then label.Image = sheet end
	label.ImageRectOffset = Vector2.new((inSheet % TAPE.columns) * TAPE.width, (inSheet // TAPE.columns) * TAPE.height)
end

-- Bigger or smaller than the kit's (B-90's stays as it is)
local function scaleTV(model)
	local k = if CONFIG.TVScale > 0 then CONFIG.TVScale elseif V.name == "B-90" then 1 else 0.8 + math.random() * 0.55
	if math.abs(k - 1) > 0.01 then pcall(function() model:ScaleTo(k) end) end
	return k
