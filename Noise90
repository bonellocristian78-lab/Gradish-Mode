-- The lowest and the highest point of a model
local function spanY(model)
	local cf, size = model:GetBoundingBox()
	local e = extentY(cf, size)
	return cf.Y - e, cf.Y + e
end
-- A model standing on the floor at `at`, turned about the vertical so that `front` (a way it looks now) looks along `facing`
local function standAt(model, front, at, facing)
	local function yaw(v) return math.atan2(-v.X, -v.Z) end
	if front and facing then
		local pivot = model:GetPivot()
		model:PivotTo(CFrame.new(pivot.Position) * CFrame.Angles(0, yaw(facing) - yaw(front), 0) * pivot.Rotation)
	end
	local cf = model:GetBoundingBox()
	local bottom = spanY(model)
	model:PivotTo(model:GetPivot() + Vector3.new(at.X - cf.X, at.Y - bottom, at.Z - cf.Z))
end

-- The far wall of the room (where the exit is) and the way into the room from it; ahead of you anywhere else
local function farWall()
	local room = roomModel()
	local exit = room and (room:FindFirstChild("RoomExit") or (room:FindFirstChild("Door") and room.Door:FindFirstChild("Door")))
	if exit and exit:IsA("BasePart") then
		local inward = exit.CFrame.LookVector
		local entrance = room:FindFirstChild("RoomEntrance")
		local inside = if entrance then entrance.Position else room:GetPivot().Position
		if (inside - exit.Position):Dot(inward) < 0 then inward = -inward end
		return exit.Position, flat(inward) or Vector3.new(0, 0, 1)
	end
	local _, _, root = body()
	if not root then return nil, nil end
	local look = flat(root.CFrame.LookVector) or Vector3.new(0, 0, -1)
	return root.Position + look * 16, -look
end
local function clearAround(at, r)
	local mid = at + Vector3.new(0, 1.3, 0)
	for _, dir in ipairs({ Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) }) do
		if cast(mid, dir * r) then return false end
	end
	return true
end
-- Spots on the floor by the far wall, beside the door (not in front of it), with `r` studs of room around them, the best first;
-- last, for a narrow room, as far to one side as it goes
local function wallSpots(r)
	local list = {}
	local door, inward = farWall()
	if not door then return list end
	local right = inward:Cross(Vector3.new(0, 1, 0))
	local start = door + inward * 1.5
	local sides = if math.random() < 0.5 then { 6, -6, 8, -8, 4.5, -4.5, 10, -10 } else { -6, 6, -8, 8, -4.5, 4.5, -10, 10 }
	for _, d in ipairs({ r + 1, r + 2.5, r + 4.5 }) do
		for _, side in ipairs(sides) do
			local p = door + inward * d + right * side
			if not cast(start, p - start) then
				local floor = cast(p, Vector3.new(0, -10, 0))
				if floor and floor.Normal.Y > 0.8 and clearAround(floor.Position, r) then table.insert(list, { at = floor.Position, inward = inward }) end
			end
		end
	end
	for _, d in ipairs({ r + 3, r + 6 }) do
		local p = door + inward * d
		local aside = 0
		for _, sign in ipairs({ 1, -1 }) do
			local hit = cast(p, right * sign * 12)
			local room = (if hit then (hit.Position - p).Magnitude else 12) - r - 0.3
			if room > math.abs(aside) then aside = room * sign end
		end
		p += right * aside
		table.insert(list, { at = floorUnder(p) or (p - Vector3.new(0, 3, 0)), inward = inward })
	end
	return list
end
-- RandomPos: spots anywhere in the room, `r` studs clear around them, out of the way of its doors, looking at the way through.
-- In the room for sure: seen from its way through (its path's nodes; or the line between its doors) and on its own floor
local function randomSpots(r)
	local room = roomModel()
	local entrance, exit = room and room:FindFirstChild("RoomEntrance"), room and room:FindFirstChild("RoomExit")
	if not (entrance and exit) then return wallSpots(r) end
	local a, b = entrance.Position, exit.Position
	local way = flat(a - b) or Vector3.new(0, 0, 1) -- towards the way in
	local anchors = {}
	local nodes = room:FindFirstChild("PathfindNodes")
	for _, n in ipairs(nodes and nodes:GetChildren() or {}) do
		if n:IsA("BasePart") then table.insert(anchors, n.Position + Vector3.new(0, 2, 0)) end
	end
	if #anchors == 0 then
		for i = 2, 8 do table.insert(anchors, a:Lerp(b, i / 10) + Vector3.new(0, 1, 0)) end
	end
	local rooms = workspace:FindFirstChild("CurrentRooms")
	local function ok(floor) -- this room's floor (not the next room's, not outside), away from its doors
		local own = not (floor.Instance and rooms and floor.Instance:IsDescendantOf(rooms)) or floor.Instance:IsDescendantOf(room)
		return floor.Normal.Y > 0.8 and own and (floor.Position - a).Magnitude > r + 5 and (floor.Position - b).Magnitude > r + 5
	end
	local list = {}
	for _ = 1, 40 do
		local mid = anchors[math.random(#anchors)]
		local dir = flat(Vector3.new(rnd(1), 0, rnd(1))) or way
		local reach = 2 + math.random() * 14
		local wall = cast(mid, dir * reach) -- not through a wall: as far as the room goes
		if wall then reach = math.max((wall.Position - mid).Magnitude - r - 0.5, 0) end
		local floor = cast(mid + dir * reach, Vector3.new(0, -12, 0))
		if floor and ok(floor) and clearAround(floor.Position, r) then
			table.insert(list, { at = floor.Position, inward = if reach > 1.5 then flat(mid - floor.Position) or way else way })
		end
	end
	local side = way:Cross(Vector3.new(0, 1, 0))
	for _, mid in ipairs(anchors) do -- a narrow room: halfway between its walls, looking at the way in
		local one, other = cast(mid, side * 20), cast(mid, -side * 20)
		local floor = cast(if one and other then (one.Position + other.Position) / 2 else mid, Vector3.new(0, -12, 0))
		if floor and ok(floor) then table.insert(list, { at = floor.Position, inward = way }) end
	end
	for _, spot in ipairs(wallSpots(r)) do table.insert(list, spot) end
	return list
end
-- In no wall and no furniture where it stands now (it may touch them): nothing solid of the world inside its box
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Exclude
local function fits(model)
	overlap.FilterDescendantsInstances = { folder, model, LocalPlayer.Character }
	local cf, size = model:GetBoundingBox()
	local ok, parts = pcall(function()
		return workspace:GetPartBoundsInBox(cf + Vector3.new(0, 0.2, 0), size - Vector3.new(0.4, 0.4, 0.4), overlap)
	end)
	if not ok or type(parts) ~= "table" then return true end -- no way to tell
	for _, p in ipairs(parts) do
		if p.CanCollide then return false end
	end
	return true
end
-- Where it stands: by the far wall, or (RandomPos) anywhere in the room; the first spot where `put(at, inward)` (it stands
-- `models` there) leaves it in no wall. Nil when it fits nowhere here: they stay where they were, for a room where it fits
local function settle(r, models, put)
	local was = {}
	for i, m in ipairs(models) do was[i] = m:GetPivot() end
	for _, spot in ipairs(if CONFIG.RandomPos then randomSpots(r) else wallSpots(r)) do
		if put(spot.at, spot.inward) then return spot.at, spot.inward end
	end
	for i, m in ipairs(models) do m:PivotTo(was[i]) end
	return nil, nil
end
-- A table at `at` and what stands on it (looking along `inward`): its long side along the wall, or (a narrow room) along the room
local function onTable(desk, thing, front, at, inward)
	for turn = 1, 2 do
		local cf, size = desk:GetBoundingBox()
		local short = if size.X < size.Z then cf.RightVector else cf.LookVector -- its front
		standAt(desk, flat(if turn == 1 then short else short:Cross(Vector3.new(0, 1, 0))), at, inward)
		local _, top = spanY(desk)
		standAt(thing, front(), Vector3.new(at.X, top, at.Z) - inward * 0.3, inward)
		if fits(desk) and fits(thing) then return true end
	end
	return false
end
-- Spots on the floor of the room along the way through it, clear of walls and furniture, apart from each other and from `avoid`
local function floorSpots(count, avoid)
	local room = roomModel()
	local entrance = room and room:FindFirstChild("RoomEntrance")
	local exit = room and room:FindFirstChild("RoomExit")
	local _, _, root = body()
	local from, points = nil, {}
	if entrance and exit then
		from = entrance.Position
		for _, f in ipairs({ 0.3, 0.5, 0.7, 0.4, 0.6, 0.2, 0.8 }) do table.insert(points, from:Lerp(exit.Position, f)) end
		local nodes = room:FindFirstChild("PathfindNodes")
		for _, node in ipairs(nodes and nodes:GetChildren() or {}) do
			if node:IsA("BasePart") then table.insert(points, node.Position + Vector3.new(0, 2, 0)) end
		end
	elseif root then
		from = root.Position
		for _, off in ipairs({ CFrame.new(3, 0, -6), CFrame.new(-3, 0, -8), CFrame.new(0, 0, -4), CFrame.new(4, 0, -3) }) do
			table.insert(points, (root.CFrame * off).Position)
		end
	else
		return {}
	end
	local found = {}
	local function apart(p)
		for _, list in ipairs({ found, avoid or {} }) do
			for _, q in ipairs(list) do
				if (p - q).Magnitude < 4 then return false end
			end
		end
		return true
	end
	for _, point in ipairs(points) do
		if #found >= count then break end
		local side = (point - from):Cross(Vector3.new(0, 1, 0))
		side = if side.Magnitude > 0.01 then side.Unit else Vector3.new(1, 0, 0)
		for _, offset in ipairs({ rnd(3), -rnd(3), 0 }) do
			local spot = hammerFloor(from, point + side * offset)
			if spot and apart(spot) then
				table.insert(found, spot)
				break
			end
		end
	end
	while #found < count do -- nowhere better: by the way in
		local p = floorUnder(from) or (from - Vector3.new(0, 3, 0))
		table.insert(found, p + Vector3.new(rnd(2), 0, rnd(2)))
	end
	return found
end

-- The TV turned any way (lying on its back, carried): which way its screen looks and which way is its top, in its body
local tvAxes = nil
local function measureTV()
	local out = flat(outwardOf(screen)) or flat(screen.Position - tvMain.Position) or Vector3.new(0, 0, -1)
	tvAxes = { f = tvMain.CFrame:VectorToObjectSpace(out), u = tvMain.CFrame:VectorToObjectSpace(Vector3.new(0, 1, 0)) }
end
local function poseTV(at, facing, up)
	local f, u = tvAxes.f, tvAxes.u
	local inBody = CFrame.fromMatrix(Vector3.new(), f, u, f:Cross(u))
	local inWorld = CFrame.fromMatrix(Vector3.new(), facing, up, facing:Cross(up))
	local mainCF = CFrame.new(at) * inWorld * inBody:Inverse()
	tv:PivotTo(mainCF * tvMain.CFrame:ToObjectSpace(tv:GetPivot()))
end
-- The TV lying on its back on the floor at `at`, its top towards `top`
local function lieTV(at, top)
	poseTV(at + Vector3.new(0, 3, 0), Vector3.new(0, 1, 0), top)
	local bottom = spanY(tv)
	tv:PivotTo(tv:GetPivot() + Vector3.new(0, at.Y - bottom, 0))
end

-- A TV on its feet (the Stairwell's): for a table, a pedestal, the floor
local function footTV()
	local source = prop("TV_Stand")
	local main = source and source:FindFirstChild("TVMain")
	local model
	if main and main:FindFirstChild("TVScreen") then
