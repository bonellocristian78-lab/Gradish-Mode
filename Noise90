---- More to do with a TV: its battery (RandomPos), its antenna ----

-- How far a box reaches along a direction of its own space
local function reach(size, dir)
	return 0.5 * (math.abs(dir.X) * size.X + math.abs(dir.Y) * size.Y + math.abs(dir.Z) * size.Z)
end

-- RandomPos: no wall socket near it. A 6 V lantern battery lies somewhere in the room: take it, put it in the box on the TV's
-- side; its lid shuts and the TV comes on
local function addBattery()
	local power = { on = false, carried = false }
	local cell = make("Model", { Name = "Noise90Battery" }, nil)
	local function block(parent, name, size, cf, color, material, extra)
		local p = make("Part", { Name = name, Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic,
			Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false }, parent)
		for k, v in pairs(extra or {}) do p[k] = v end
		return p
	end
	local round = { Shape = Enum.PartType.Cylinder }
	local upright = CFrame.Angles(0, 0, math.pi / 2) -- a cylinder standing up
	local body = block(cell, "Body", Vector3.new(0.62, 0.78, 0.62), CFrame.new(0, 0.39, 0), rgb(24, 24, 28))
	local band = block(cell, "Band", Vector3.new(0.635, 0.4, 0.635), CFrame.new(0, 0.42, 0), rgb(245, 190, 30))
	block(cell, "Top", Vector3.new(0.6, 0.04, 0.6), CFrame.new(0, 0.8, 0), rgb(70, 70, 76), Enum.Material.Metal)
	for i, x in ipairs({ -0.15, 0.15 }) do -- its two spring terminals, + in red
		block(cell, "Spring", Vector3.new(0.14, 0.1, 0.1), CFrame.new(x, 0.89, 0) * upright, rgb(200, 200, 205), Enum.Material.Metal, round)
		block(cell, "Terminal", Vector3.new(0.03, 0.14, 0.14), CFrame.new(x, 0.975, 0) * upright, if i == 2 then rgb(200, 40, 40) else rgb(30, 30, 30),
			Enum.Material.SmoothPlastic, round)
	end
	local tag = make("SurfaceGui", { Name = "Tag", Face = Enum.NormalId.Front, CanvasSize = Vector2.new(200, 130) }, band)
	UI.label({ Name = "Volts", Text = "6V", Size = UDim2.fromScale(1, 0.62), FontFace = UI.title, TextColor3 = rgb(20, 20, 20) }, tag)
	UI.label({ Name = "Brand", Text = "NOISE CELL", Position = UDim2.fromScale(0, 0.62), Size = UDim2.fromScale(1, 0.3), TextColor3 = rgb(20, 20, 20) }, tag)
	cell.PrimaryPart = body
	power.prompt = newPrompt(body, "Take", "Battery", 0.2, 8)

	-- Its box on the TV's side (along the TV: x its front, y its top, z away from it), the lid standing open
	local f, u = tvAxes.f, tvAxes.u
	local side = f:Cross(u)
	local inTV = CFrame.fromMatrix(side * (reach(tvMain.Size, side) + 0.4) + u * (0.7 - reach(tvMain.Size, u)), f, u, side)
	local function boxCF() return tvMain.CFrame * inTV end
	local box = make("Model", { Name = "Noise90BatteryBox" }, tv)
	local dark = rgb(34, 34, 38)
	for _, w in ipairs({ { "Bottom", Vector3.new(0.8, 0.06, 0.8), CFrame.new(0, -0.47, 0) }, { "Front", Vector3.new(0.06, 1, 0.8), CFrame.new(0.37, 0, 0) },
		{ "Back", Vector3.new(0.06, 1, 0.8), CFrame.new(-0.37, 0, 0) }, { "Outside", Vector3.new(0.8, 1, 0.06), CFrame.new(0, 0, 0.37) },
		{ "Inside", Vector3.new(0.8, 1, 0.06), CFrame.new(0, 0, -0.37) } }) do
		block(box, w[1], w[2], boxCF() * w[3], dark)
	end
	for _, x in ipairs({ -0.15, 0.15 }) do block(box, "Contact", Vector3.new(0.16, 0.02, 0.16), boxCF() * CFrame.new(x, -0.43, 0), rgb(196, 120, 60), Enum.Material.Metal) end
	local sticker = make("SurfaceGui", { Name = "Sticker", Face = Enum.NormalId.Back, CanvasSize = Vector2.new(160, 200) }, box.Outside)
	UI.label({ Name = "Volts", Text = "6V +", Size = UDim2.fromScale(1, 0.4), Position = UDim2.fromScale(0, 0.3), FontFace = UI.title, TextColor3 = UI.cream }, sticker)
	local function lidAt(angle) return boxCF() * CFrame.new(0, 0.5, 0.4) * CFrame.Angles(angle, 0, 0) * CFrame.new(0, 0.025, -0.4) end
	local lid = block(box, "Lid", Vector3.new(0.8, 0.05, 0.8), lidAt(math.rad(110)), dark)
	power.slot = newPrompt(box.Outside, "Put the battery in", "TV", 0.3, 9)
	power.slot.Enabled = false

	function power.place()
		if power.on or power.carried then return end
		local spot = floorSpots(1, { tvMain.Position })[1]
		if not spot then return end
		cell:PivotTo(CFrame.new(spot) * CFrame.Angles(0, math.random() * math.pi * 2, 0) * CFrame.new(0, 0.39, 0))
		cell.Parent = folder
	end
	on(power.prompt.Triggered, function()
		if power.on or power.carried then return end
		power.carried, power.prompt.Enabled, power.slot.Enabled = true, false, true
		oneShot(SOUNDS.click, body)
	end)
	on(RunService.Heartbeat, function() -- in your hand
		if not power.carried then return end
		local character = LocalPlayer.Character
		local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
		if hand then cell:PivotTo(hand.CFrame * CFrame.new(0, -hand.Size.Y / 2 - 0.42, -0.15)) end
	end)
	on(power.slot.Triggered, function()
		if power.on or not power.carried then return end
		power.carried, power.slot.Enabled = false, false
		task.spawn(function()
			local function move(goal, seconds)
				local t0, start = os.clock(), body.CFrame
				while alive and os.clock() - t0 < seconds do
					local k = (os.clock() - t0) / seconds
					cell:PivotTo(start:Lerp(goal(), k * k * (3 - 2 * k)))
					RunService.Heartbeat:Wait()
				end
				cell:PivotTo(goal())
			end
			move(function() return boxCF() * CFrame.new(0, 1.2, 0) end, 0.3)
			move(function() return boxCF() * CFrame.new(0, -0.11, 0) end, 0.25) -- its springs just under the lid
			cell.Parent = tv -- it goes where the TV goes now
			local t0 = os.clock()
			while alive and os.clock() - t0 < 0.2 do -- the lid shuts
				lid.CFrame = lidAt(math.rad(110) * (1 - (os.clock() - t0) / 0.2))
				RunService.Heartbeat:Wait()
			end
			lid.CFrame = lidAt(0)
			oneShot(SOUNDS.click, lid)
			oneShot(SOUNDS.bulb, lid, { Volume = CONFIG.Volume * 0.4, PlaybackSpeed = 1.5 })
			local zap = make("ParticleEmitter", { Rate = 0, Lifetime = NumberRange.new(0.15, 0.35), Speed = NumberRange.new(4, 9), SpreadAngle = Vector2.new(60, 60),
				Size = NumberSequence.new(0.08, 0), Color = ColorSequence.new(PALE), LightEmission = 1 }, lid)
			zap:Emit(14)
			power.on = true
		end)
	end)
	return power
end

-- The TV is on as it is; with RandomPos (anywhere in the room) it needs its battery
local function addPower()
	if CONFIG.RandomPos and not CONFIG.Now then return addBattery() end
	return nil
end

-- Rabbit ears on top of it: turn them (hold) or there is no picture to see, only NO SIGNAL
local function addAntenna()
	if CONFIG.Now then return nil end -- it comes out at once
	local antenna = { tuned = false }
	local up = tvAxes.u
	local top = tvMain.CFrame * CFrame.new(up * reach(tvMain.Size, up))
	local base = make("Part", { Name = "AntennaBase", Size = Vector3.new(0.7, 0.22, 0.5), Color = rgb(35, 35, 40), Material = Enum.Material.SmoothPlastic,
		Anchored = true, CanCollide = false, CanTouch = false, CFrame = top * CFrame.new(0, 0.11, 0) }, tv)
	local rods = {}
	for i, side in ipairs({ -1, 1 }) do
		rods[i] = make("Part", { Name = "AntennaRod", Size = Vector3.new(0.05, 1.9, 0.05), Color = rgb(200, 200, 208), Material = Enum.Material.Metal,
			Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
			CFrame = base.CFrame * CFrame.Angles(0, 0, side * math.rad(30)) * CFrame.new(0, 0.95, 0) }, tv)
	end
	antenna.prompt = newPrompt(base, "Tune", "Antenna", 1.5, 8)
	antenna.labels = {}
	for _, record in ipairs(screens) do
		if record.own then
			table.insert(antenna.labels, UI.label({ Name = "NoSignal", Size = UDim2.fromScale(1, 0.25), Position = UDim2.fromScale(0, 0.375), ZIndex = 6,
				FontFace = UI.title, Text = "NO SIGNAL", Visible = false }, record.gui, true))
		end
	end
	on(antenna.prompt.Triggered, function()
		if antenna.tuned then return end
		antenna.tuned, antenna.prompt.Enabled = true, false
		for _, label in ipairs(antenna.labels) do label.Visible = false end
		oneShot(SOUNDS.click, base)
		task.spawn(function() -- the ears swing round to the signal
			local turn = math.rad(70)
			local t0 = os.clock()
			while alive and os.clock() - t0 < 0.5 do
				local u = (os.clock() - t0) / 0.5
				for i, rod in ipairs(rods) do
					local side = if i == 1 then -1 else 1
					rod.CFrame = base.CFrame * CFrame.Angles(0, turn * u * u * (3 - 2 * u), side * math.rad(30)) * CFrame.new(0, 0.95, 0)
				end
				RunService.Heartbeat:Wait()
			end
		end)
	end)
	return antenna
end

