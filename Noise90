-- The arm that holds it from the ceiling, as in the kit: a bracket on its back, a bar leaning back, a plate on the ceiling
local function addArm(tv, main)
	local arm = make("Model", { Name = "ArchivesCeilingMonitor" }, tv)
	local monitor = make("Model", { Name = "Monitor" }, arm)
	local tilt = CFrame.Angles(math.rad(15), 0, 0)
	for _, p in ipairs({ { "Bar", Vector3.new(1.26, 1.26, 0.88), CFrame.new(-0.08, -0.1, 1.83), Color3.fromRGB(70, 72, 83), monitor },
		{ "Wire", Vector3.new(0.35, 1.48, 0.38), CFrame.new(-0.06, -0.88, 1.69), Color3.fromRGB(36, 35, 36), monitor },
		{ "Bar", Vector3.new(0.45, 2.2, 0.52), CFrame.new(-0.09, 0.61, 2.4) * tilt, Color3.fromRGB(70, 72, 83), arm },
		{ "Base", Vector3.new(1.47, 0.59, 1.19), CFrame.new(-0.09, 1.53, 2.64) * tilt, Color3.fromRGB(35, 37, 54), arm } }) do
		make("Part", { Name = p[1], Size = p[2], CFrame = main.CFrame * p[3], Color = p[4], Anchored = true, CanCollide = false,
			CanQuery = false, CanTouch = false }, p[5])
	end
end

-- The TV alone (no feet, no cart) on its ceiling arm: its screen with the VideoGui, the broken glass hidden
local function makeTV()
	local stand = piece("TV_Stand")
	if stand then
		local tv = clean(stand:Clone())
		local main = tv:FindFirstChild("TVMain")
		local feet = main and main:FindFirstChild("TVFeet")
		if feet then feet:Destroy() end
		if main and main:FindFirstChild("TVScreen") then
			tv.PrimaryPart = main
			if not tv:FindFirstChild("ArchivesCeilingMonitor") then addArm(tv, main) end
			return tv, main, main.TVScreen
		end
	end
	-- Built: a dark box with a screen
