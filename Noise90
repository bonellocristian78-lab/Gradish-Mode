-- It walks your steps: every stud you move is a crumb, and it goes from crumb to crumb
local function chase(noise)
	local _, _, root = body()
	if not root then return end
	state = "chase"
	local crumbs, cursor = { root.Position }, 1
	local started, startRoom = os.clock(), latestRoom()
	local rushing, lastScream, shimmerAt, still = false, -math.huge, 0, false
	local pixelWait, nextFace = 0, os.clock() + 6 -- Pix-90: its picture changes 6 times a second; its face, now and then
	setLevel(noise, false)
	noise.rig:play(noise.anims.Walk, 1)

	local function pathLength(target)
		local total, last = 0, noise.position
		for i = cursor, #crumbs do
			total += (crumbs[i] - last).Magnitude
			last = crumbs[i]
		end
		return total + (target - last).Magnitude
	end

	while alive and state == "chase" and not noise.gone do
		local dt = RunService.Heartbeat:Wait()
		local _, humanoid, liveRoot = body()
		local room = latestRoom()
		if not liveRoot or liveRoot ~= root or os.clock() - started > CONFIG.ChaseTime
			or (room and startRoom and room >= startRoom + CONFIG.ChaseRooms) then
			fizzle(noise) -- you died, or got away
			break
		end
		local here = root.Position
		if (here - crumbs[#crumbs]).Magnitude > 1 then table.insert(crumbs, here) end
		if cursor > 200 then -- forget the steps it has already walked
			crumbs = table.move(crumbs, cursor, #crumbs, 1, {})
			cursor = 1
		end

		local distance = pathLength(here)
		if not rushing and distance > CONFIG.FarDistance and os.clock() - lastScream > CONFIG.ScreamCooldown then
			rushing, lastScream = true, os.clock()
			scream(noise)
			noise.rig:play(noise.anims.HijackWalk or noise.anims.Walk, 1.6)
		elseif rushing and distance < CONFIG.CloseDistance then
			rushing = false
			noise.rig:play(noise.anims.Walk, 1)
		end
		setLevel(noise, rushing)

		-- As fast as you, a hair slower; slower still while you stand still; faster when it rushes
		local yours = humanoid.WalkSpeed
		local moving = humanoid.MoveDirection.Magnitude > 0.1 or (root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude > 1
		local halted = if V.contrary then moving else not moving -- C-90 stops when you move, and walks when you stand still
		if halted ~= still then -- its pause icon says so
			still = halted
			noise:emitter("PauseIcon", still)
			local pause = noise:sound("Pause")
			if still and pause then pause:Play() end
		end
		local speed = if V.contrary and moving then 0
			elseif rushing then yours + CONFIG.Rush
			elseif moving or V.contrary then yours + CONFIG.SpeedOffset
			else yours + CONFIG.SpeedOffset - CONFIG.StillSlowdown
		if speed <= 0 then
			noise.rig.speed = 0
		elseif not rushing then
			noise.rig.speed = math.clamp(speed / 14, 0.5, 1.6)
		end
		if V.pixel and os.clock() >= nextFace then -- its pixel face: freeze
			nextFace = os.clock() + 9 + math.random() * 6
			task.spawn(faceCheck, { rule = "still" })
		end
		local budget = if speed <= 0 then 0 else math.max(speed, 1) * dt
		local facing = nil
		while budget > 0 do
			local target = crumbs[cursor] or here
			local step = target - noise.position
			if step.Magnitude <= budget then
				noise.position = target
				budget -= step.Magnitude
				if not crumbs[cursor] then break end
				cursor += 1
			else
				noise.position += step.Unit * budget
				budget = 0
			end
			if step.Magnitude > 0.05 then facing = step end
		end
		-- Its feet on the floor where yours were: your root's height minus your legs, plus its own
		local flat = facing and facing * Vector3.new(1, 0, 1)
		if flat and flat.Magnitude > 0.05 then noise.look = flat.Unit end
		local legs = if humanoid.RigType == Enum.HumanoidRigType.R6 then 2 else (humanoid.HipHeight or 2)
		local at = Vector3.new(noise.position.X, noise.position.Y - root.Size.Y / 2 - legs + noise.hip, noise.position.Z)
		if V.pixel then -- in steps, on a grid, turning by eighths
			pixelWait -= dt
			if pixelWait <= 0 then
				pixelWait = 1 / 6
				local look = noise.look or Vector3.new(0, 0, -1)
				local yaw = math.round(math.atan2(look.X, look.Z) / (math.pi / 4)) * (math.pi / 4)
				local snapped = Vector3.new(math.round(at.X / 1.2) * 1.2, at.Y, math.round(at.Z / 1.2) * 1.2)
				noise.root.CFrame = CFrame.lookAt(snapped, snapped + Vector3.new(math.sin(yaw), 0, math.cos(yaw)))
			end
		else
			noise.root.CFrame = CFrame.lookAt(at, at + (noise.look or Vector3.new(0, 0, -1)))
		end

		if (here - noise.position).Magnitude < CONFIG.KillDistance then
			local cross = V.crucify and heldCrucifix() -- only B-90 can be crucified
			if cross then -- it caught you, but you hold a crucifix
				state = "crucified"
				task.spawn(crucify, noise, cross)
				break
			end
			-- Caught: it turns to you, the jumpscare, and you are gone
			state = "done"
			noise.rig:play(noise.anims.Jumpscare, 2)
			local kill = noise:sound("KillPlayer")
			if kill then kill:Play() end
			if os.clock() - lastScream > 1 then scream(noise) end
			blueFlash(0.9)
			shake(8)
			task.delay(0.6, function()
				deathHints()
				humanoid.Health = 0
			end)
			task.delay(2.2, fizzle, noise)
			break
		end
		if os.clock() >= shimmerAt then -- 20 times a second is plenty for static
			shimmerAt = os.clock() + 0.05
			shimmer(math.clamp(1 - distance / 40, 0, 1) * 0.8)
		end
	end
	if state == "chase" then state = "done" end
end

-- Out of the TV. Its Emerge starts with the body lying in the screen, high above its root, and drops it to the floor in front.
-- The kit's TV stands on the floor: this one may hang above the door, so the root starts higher and comes down with the body.
-- `speed`: how fast (CONFIG.EmergeSpeed). -> Noise, standing in front of the screen (nil: stopped meanwhile)
local function emerge(speed)
	state = "emerging"
	local noise = makeNoise()
	current = noise
	noise.look = emergeLook or flat(outwardOf(screen)) or Vector3.new(0, 0, -1)
	local ahead = screen.Position + noise.look * 4 -- the kit puts its root 4 studs in front of the screen
	local floorY = (floorUnder(ahead) or ahead - Vector3.new(0, 9, 0)).Y
	local standing = floorY + noise.hip
	local anim = noise.anims.Emerge
	local torso = anim and anim.joints.LowerTorso
	local motor = noise.rig.motors.LowerTorso
	local top, low, startY = 0, 0, math.max(screen.Position.Y - 1, standing)
	if torso and motor then
		top, low = torso[1].cf.Y, torso[1].cf.Y
		for _, k in ipairs(torso) do low = math.min(low, k.cf.Y) end
		local lying = motor.C0 * torso[1].cf * motor.C1:Inverse() -- its body at the start, seen from its root
		startY = math.max(screen.Position.Y - lying.Y, standing)
	end
	-- How to go back in (climbBack): the same way, backwards
	noise.home = { ahead = ahead, standing = standing, startY = startY, top = top, low = low, torso = torso, look = noise.look }
	local function place(y)
		local at = Vector3.new(ahead.X, y, ahead.Z)
		noise.root.CFrame = CFrame.lookAt(at, at + noise.look)
	end
	place(startY)
	noise.position = Vector3.new(ahead.X, floorY + 3, ahead.Z) -- where your root would be, there
	noise.model.Parent = folder
	setLevel(noise, false)
	noise:burst("FlashParticle", 40)
	local sfx = noise:sound("Emerge")
	if sfx then sfx:Play() end
	blueFlash(0.5)
	shake(5)
	local t0 = os.clock()
	if anim then
		noise.rig:play(anim, speed or CONFIG.EmergeSpeed)
		local fallen = 0
		while alive and state == "emerging" and not noise.rig.done and os.clock() - t0 < 12 do
			-- How far its body has fallen out of the screen, from its own animation: the root comes down as much
			fallen = if top > low then math.max(fallen, math.clamp((top - poseOf(torso, noise.rig.time).Y) / (top - low), 0, 1)) else 1
			place(standing + (startY - standing) * (1 - fallen))
			RunService.Heartbeat:Wait()
		end
	else -- the plain one drops out of the screen
		while alive and state == "emerging" and os.clock() - t0 < 0.45 do
			local u = (os.clock() - t0) / 0.45
			place(startY + (standing - startY) * u * u)
			RunService.Heartbeat:Wait()
		end
		task.wait(0.5)
	end
	if alive and state == "emerging" then
		place(standing)
		return noise
	end
	return nil
end

---====== A FILM: black bars, your camera and your body for a cutscene, all given back at the end ======---

local restoreCutscene = nil -- while a film runs: gives you back your camera and your body
local cutShake = 0 -- the film camera's shake, dying down
local function kick(amount) cutShake = math.max(cutShake, amount) end

local JOINTS = { root = { "Root", "RootJoint" }, waist = { "Waist" }, neck = { "Neck" }, rS = { "RightShoulder", "Right Shoulder" },
	rE = { "RightElbow" }, rW = { "RightWrist" }, lS = { "LeftShoulder", "Left Shoulder" }, lE = { "LeftElbow" },
	rH = { "RightHip", "Right Hip" }, rK = { "RightKnee" }, lH = { "LeftHip", "Left Hip" }, lK = { "LeftKnee" } }
local ZERO = { 0, 0, 0 }
local function ease(u) return u * u * (3 - 2 * u) end
local function smoother(u) return u * u * u * (u * (u * 6 - 15) + 10) end -- no jolt at either end
local EASE = { smooth = ease, out = function(u) return 1 - (1 - u) ^ 3 end, ["in"] = function(u) return u ^ 3 end }
local function lerpNum(a, b, u) return a + (b - a) * u end
local function flatDir(from, to)
	local d = (to - from) * Vector3.new(1, 0, 1)
	return if d.Magnitude > 0.01 then d.Unit else Vector3.new(0, 0, -1)
end
-- The camera stays on this side of any wall
local function safe(from, eye)
	if (eye - from).Magnitude < 0.05 then return eye end
	local hit = cast(from, eye - from)
	return if hit then hit.Position + (from - eye).Unit * 0.6 else eye
end
-- A pose between two of a list of poses { t, ease, pose = { joint = { pitch, yaw, roll } } }
local function poseAt(list, t)
	local a, b = list[#list], list[#list]
	for i = 2, #list do
		if list[i].t > t then
			a, b = list[i - 1], list[i]
			break
		end
	end
	local u = if b.t > a.t then (EASE[b.ease] or ease)(math.clamp((t - a.t) / (b.t - a.t), 0, 1)) else 1
	local out = {}
	for name in pairs(JOINTS) do
		local p, q = a.pose[name] or ZERO, b.pose[name] or ZERO
		out[name] = { lerpNum(p[1], q[1], u), lerpNum(p[2], q[2], u), lerpNum(p[3], q[3], u) }
	end
	return out
end

--[[ film.shot(now) -> camera CFrame, FOV. film.bodyAt(now) -> your pose (degrees in each joint's parent, { pitch, yaw, roll }:
     pitch > 0 lifts an arm or a leg forward, < 0 bows the waist or bends a knee; yaw > 0 turns left; roll > 0 opens the right
     arm), where you stand, where you face. film.every(now): anything else, each frame. Your feet stay on the floor (R15) ]]
local function newFilm(character, root)
	local camera = workspace.CurrentCamera
	local film = { shot = nil, bodyAt = nil, every = nil, done = false, startPos = root.Position,
		saved = { type = camera.CameraType, fov = camera.FieldOfView, cframe = camera.CFrame, anchored = root.Anchored,
			stopcam = mainGame and mainGame.stopcam } }
	if mainGame then mainGame.stopcam = true end
	root.Anchored = true
	camera.CameraType = Enum.CameraType.Scriptable

	local bars = make("ScreenGui", { Name = "NoiseCutscene", IgnoreGuiInset = true, DisplayOrder = 99998, ResetOnSpawn = false }, hud)
	local top = make("Frame", { Size = UDim2.fromScale(1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, bars)
	local bottom = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, bars)
	local function barsTo(height, seconds)
		for _, bar in ipairs({ top, bottom }) do TweenService:Create(bar, TweenInfo.new(seconds), { Size = UDim2.fromScale(1, height) }):Play() end
	end
	barsTo(0.11, 0.35)

	local joints = {}
	for name, names in pairs(JOINTS) do
		for _, n in ipairs(names) do
			local m = character:FindFirstChild(n, true)
			if m and m:IsA("Motor6D") then
				local q = m.C0.Rotation
				joints[name] = { motor = m, q = q, qi = q:Inverse() }
				break
			end
		end
	end
	local legs = nil -- thigh and shin: how much lower you are when you bend
	if joints.rH and joints.rK then
		local ankle = character:FindFirstChild("RightAnkle", true)
		local a = (joints.rK.motor.C0.Position - joints.rH.motor.C1.Position).Magnitude
		local b = if ankle and ankle:IsA("Motor6D") then (ankle.C0.Position - joints.rK.motor.C1.Position).Magnitude else a
		legs = function(hip, knee) return a * math.cos(math.rad(hip)) + b * math.cos(math.rad(hip + knee)) - (a + b) end
	end
	film.hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm") or root
	film.joints = joints

	-- The body, after Roblox's animations, before physics
	local writer = on(RunService.PreSimulation or RunService.Stepped, function()
		if not film.bodyAt then return end
		local pose, at, face = film.bodyAt(os.clock())
		local dy = if legs and pose.lH and pose.rH then math.max(legs(pose.lH[1], pose.lK[1]), legs(pose.rH[1], pose.rK[1])) else 0
		for name, j in pairs(joints) do
			local a = pose[name] or ZERO
			local r = CFrame.fromEulerAnglesYXZ(math.rad(a[1]), math.rad(a[2]), math.rad(a[3]))
			if name == "root" then r = CFrame.new(0, dy, 0) * r end
			j.motor.Transform = j.qi * r * j.q
		end
		root.CFrame = CFrame.lookAt(at, at + face)
	end)
	-- The picture
	RunService:BindToRenderStep("NoiseCutscene", Enum.RenderPriority.Last.Value + 2, function(dt)
		local now = os.clock()
		for _, d in ipairs(character:GetDescendants()) do -- seen from outside, even in first person
			if d:IsA("BasePart") or d:IsA("Decal") then d.LocalTransparencyModifier = 0 end
		end
		if film.every then film.every(now) end
		if film.shot then
			local cf, fov = film.shot(now)
			cutShake *= math.exp(-6 * (dt or 1 / 60))
			if cutShake > 0.001 then cf = cf * CFrame.Angles(rnd(cutShake), rnd(cutShake), rnd(cutShake * 0.5)) end
			camera.CFrame, camera.FieldOfView = cf, fov
		end
	end)

	function film.finish()
		if film.done then return end
		film.done = true
		restoreCutscene = nil
		RunService:UnbindFromRenderStep("NoiseCutscene")
		writer:Disconnect()
		for _, j in pairs(joints) do j.motor.Transform = CFrame.new() end
		camera.CameraType = film.saved.type
		camera.FieldOfView = film.saved.fov
		if mainGame then mainGame.stopcam = film.saved.stopcam end
		if root.Parent then root.Anchored = film.saved.anchored end
		bars:Destroy()
		tint.Saturation, tint.Contrast, tint.TintColor = 0, 0, Color3.new(1, 1, 1)
		blur.Size = 0
	end
	function film.hold(seconds) -- false: the event was stopped meanwhile
		task.wait(seconds)
		return alive and not film.done
	end
	-- Back to you, wherever you are now, and the bars go
	function film.home(at, seconds)
		local leaving, fov, from = camera.CFrame, camera.FieldOfView, os.clock()
		local home = film.saved.cframe + (at - film.startPos)
		film.shot = function(now)
			local u = ease(math.clamp((now - from) / seconds, 0, 1))
			return leaving:Lerp(home, u), lerpNum(fov, film.saved.fov, u)
		end
		barsTo(0, seconds * 0.85)
		TweenService:Create(tint, TweenInfo.new(seconds), { Saturation = 0, Contrast = 0, TintColor = Color3.new(1, 1, 1) }):Play()
		if film.hold(seconds + 0.05) then film.finish() end
	end
	restoreCutscene = film.finish
	return film
end

---====== THE HAMMER: a film; the TV breaks, swings on its arm, and falls with it ======---

local sparks = nil -- the broken TV's

local function breakTV()
	local glass = tvMain:FindFirstChild("BrokenScreen")
	if glass then
		glass.Transparency = 0
		local decal = glass:FindFirstChildOfClass("Decal")
		if decal then decal.Transparency = 0 end
	end
	if picture then picture.Visible = false end
	if video then pcall(function() video:Pause() end) video.Visible = false end
	screen.Transparency = 1
	for _, light in ipairs(screen:GetDescendants()) do
		if light:IsA("Light") then light.Enabled = false end
	end
	if hum then hum:Stop() end
	sparks = make("ParticleEmitter", { Name = "Sparks", Enabled = false, Rate = 0, Lifetime = NumberRange.new(0.3, 0.8),
		Speed = NumberRange.new(8, 18), SpreadAngle = Vector2.new(70, 70), Acceleration = Vector3.new(0, -40, 0),
		Size = NumberSequence.new(0.15, 0), Color = ColorSequence.new(PALE), LightEmission = 1 }, screen)
	sparks:Emit(45)
	for _, id in ipairs({ SOUNDS.glass, SOUNDS.crack, SOUNDS.bulb }) do oneShot(id, tvMain, { Volume = CONFIG.Volume * 1.4 }) end
	tint.TintColor = Color3.new(1, 1, 1)
end

-- Bits of glass that fly and bounce, and go after a few seconds
local function shards(at, out, count)
	for _ = 1, count do
		local shard = make("Part", { Name = "Shard", Size = Vector3.new(0.06 + math.random() * 0.22, 0.04, 0.06 + math.random() * 0.22),
			Material = Enum.Material.Glass, Color = PALE, Transparency = 0.3, CanQuery = false, CanTouch = false, CastShadow = false,
			CFrame = CFrame.new(at + Vector3.new(rnd(0.9), rnd(0.6), rnd(0.9))) * CFrame.Angles(rnd(3), rnd(3), rnd(3)) }, folder)
		shard.AssemblyLinearVelocity = out * (5 + math.random() * 12) + Vector3.new(rnd(7), 3 + math.random() * 9, rnd(7))
		shard.AssemblyAngularVelocity = Vector3.new(rnd(25), rnd(25), rnd(25))
		task.delay(5 + math.random() * 3, function() shard:Destroy() end)
	end
end

-- A piece comes off and falls on its own (Roblox's physics)
local function loose(part, velocity)
	if not part then return end
	for _, j in ipairs(tv:GetDescendants()) do
		if (j:IsA("JointInstance") or j:IsA("WeldConstraint")) and (j.Part0 == part or j.Part1 == part) then j:Destroy() end
	end
	part.Parent = folder
	part.Anchored, part.CanCollide = false, true
	part.AssemblyLinearVelocity = velocity
	part.AssemblyAngularVelocity = Vector3.new(rnd(8), rnd(8), rnd(8))
end

local SMOKE = "rbxasset://textures/particles/smoke_main.dds" -- Roblox's own
-- On the floor: glass everywhere, a cloud of dust, its back and buttons come off, a last blue spark, thin smoke for a while
local function crash(at, inward)
