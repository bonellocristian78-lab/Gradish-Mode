function openInspect(entry)
	if inspect.entry then closeInspect() end
	local view = entry.model:Clone()
	for _, d in ipairs(view:GetDescendants()) do
		if d:IsA("ProximityPrompt") or d:IsA("Light") then d:Destroy() end
	end
	local cd = view:FindFirstChild("Disc")
	if cd and disc.inserted == entry then
		cd:Destroy() -- the disc is in the player: the case is empty
	elseif cd then
		cd.Transparency = 0
		for _, d in ipairs(cd:GetChildren()) do
			if d:IsA("Decal") and d.Name == "Art" then d.Transparency = 0 end
		end
	end
	view.Parent = viewport
	inspect.entry, inspect.view = entry, view
	inspect.yaw, inspect.pitch, inspect.dist, inspect.lid, inspect.lidGoal = 0.4, 0.5, 2.4, 0, 0
	inspect.freed = mainGame and mainGame.freemouse
	if mainGame then mainGame.freemouse = true end
	bDone.Modal = true -- the mouse free to click (only while it is open: Roblox frees it even for a disabled ScreenGui)
