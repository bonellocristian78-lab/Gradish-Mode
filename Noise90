-- Scripts, the game's remotes and props' leftovers out; everything still and see-through to clicks
local function clean(model, keepPhysics)
	local all = model:GetDescendants()
	table.insert(all, model)
	for _, d in ipairs(all) do
		if d:IsA("LuaSourceContainer") or d:IsA("RemoteEvent") or d:IsA("BindableEvent") or d:IsA("PathfindingModifier")
			or d:IsA("ProximityPrompt") then
			d:Destroy()
		elseif d:IsA("BasePart") and not keepPhysics then
			d.Anchored, d.CanCollide, d.CanTouch, d.CanQuery = true, false, false, false
		end
	end
	return model
end

-- A piece of the kit: at its top, or in its "Noise (B-90)" model (the TV, the hammer)
local function piece(name)
	local inner = kit and kit:FindFirstChild("Noise (B-90)")
	return kit and (kit:FindFirstChild(name) or (inner and inner:FindFirstChild(name))) or nil
end

-- A prop of the world kit (the Stairwell's, the Archives'), or nil
