				end
				b90.place(b90At)
				b90Point.CFrame = CFrame.new(b90At)
			end

			-- Three pulls, both at once; at each one B-90 shows its STOP
			for i, pullAt in ipairs(PULLS) do
				if t >= pullAt and once("pull" .. i) then
					oneShot(SLAM, root, { Volume = CONFIG.Volume * 0.45, PlaybackSpeed = 0.9 + i * 0.1 })
					blueFlash(0.15)
					for _, circle in ipairs(circles) do circle.burst(3) end
