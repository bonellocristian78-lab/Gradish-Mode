-- A 70s TV console: a walnut cabinet on four legs, the speaker's cloth behind slats on the left, two doors on the right with
-- the player behind them (open them before a disc goes in), a lace doily under the TV, brass knobs
function SETUPS.Console()
	local cart = make("Model", { Name = "NoiseTV" }, nil)
	local walnut, dark, brass, wood = rgb(92, 58, 34), rgb(52, 32, 20), rgb(196, 158, 76), Enum.Material.Wood
	local W, D, H, lift = 4.6, 2.1, 2.2, 0.45
	local y0, y1 = lift, lift + H
	local bottom = build.part(cart, "Bottom", Vector3.new(W, 0.12, D), CFrame.new(0, y0 + 0.06, 0), walnut, wood)
	for _, x in ipairs({ -W / 2 + 0.06, W / 2 - 0.06 }) do build.part(cart, "Side", Vector3.new(0.12, H, D), CFrame.new(x, y0 + H / 2, 0), walnut, wood) end
	build.part(cart, "Back", Vector3.new(W, H, 0.08), CFrame.new(0, y0 + H / 2, D / 2 - 0.04), dark, wood)
	build.part(cart, "Top", Vector3.new(W + 0.2, 0.14, D + 0.16), CFrame.new(0, y1 + 0.07, 0), walnut, wood)
	build.part(cart, "Plinth", Vector3.new(W - 0.1, 0.16, 0.06), CFrame.new(0, y0 + 0.08, -D / 2 - 0.02), dark, wood)
	for _, x in ipairs({ -W / 2 + 0.3, W / 2 - 0.3 }) do -- splayed legs, brass feet
		for _, z in ipairs({ -D / 2 + 0.3, D / 2 - 0.3 }) do
			local foot = Vector3.new(x + math.sign(x) * 0.08, 0.04, z + math.sign(z) * 0.06)
			build.rod(cart, "Leg", foot, Vector3.new(x, y0, z), 0.16, walnut, wood)
			build.part(cart, "Ferrule", Vector3.new(0.1, 0.17, 0.17), CFrame.new(foot + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.pi / 2),
				brass, Enum.Material.Metal, { Shape = Enum.PartType.Cylinder })
		end
	end
	local xd = -0.35 -- the divider: the speaker on its left, the doors on its right
	build.part(cart, "Divider", Vector3.new(0.1, H - 0.12, D - 0.1), CFrame.new(xd, y0 + H / 2 + 0.06, -0.02), walnut, wood)
	local left, right = -W / 2 + 0.12, W / 2 - 0.12
	local sx, sw = (left + xd) / 2, xd - left
	local face = -D / 2
	build.part(cart, "Speaker", Vector3.new(sw, H - 0.3, 0.05), CFrame.new(sx, y0 + H / 2 + 0.06, face + 0.06), rgb(78, 58, 44), Enum.Material.Fabric)
	for i = 1, 9 do -- the slats over its cloth
		build.part(cart, "Slat", Vector3.new(0.06, H - 0.3, 0.05), CFrame.new(left + i * sw / 10, y0 + H / 2 + 0.06, face + 0.01), dark, wood)
	end
	for _, y in ipairs({ y0 + 0.17, y1 - 0.05 }) do build.part(cart, "Rail", Vector3.new(W - 0.24, 0.1, 0.08), CFrame.new(0, y, face + 0.01), walnut, wood) end
	local badge = build.part(cart, "Badge", Vector3.new(0.7, 0.16, 0.02), CFrame.new(sx, y0 + 0.42, face - 0.03), brass, Enum.Material.Metal)
	build.words(badge, Enum.NormalId.Front, "NOISE", { FontFace = UI.title, TextColor3 = dark })
	-- behind the doors: a shelf with discs standing on it, the player under it
	local cx, cw = (xd + right) / 2, right - xd
	build.part(cart, "Shelf", Vector3.new(cw - 0.05, 0.08, D - 0.2), CFrame.new(cx, y0 + 1.3, 0.04), walnut, wood)
	for i = 1, 5 do
		build.part(cart, "Records", Vector3.new(0.09, 0.82, 0.95), CFrame.new(cx - 0.9 + i * 0.13, y0 + 1.75, 0.15) * CFrame.Angles(0, 0, rnd(0.06)),
			if i % 2 == 0 then rgb(30, 30, 36) else rgb(150, 30, 30))
	end
	local body, drive, light = build.deck(cart, CFrame.new(cx, y0 + 0.12 + 0.26, -0.15),
		{ size = Vector3.new(cw - 0.55, 0.5, 1.45), body = rgb(196, 196, 202), trim = rgb(50, 50, 55), material = Enum.Material.Metal })
	-- the doors, shut: each hinged on its outer edge, its knob by the middle
	local doors = {}
	for _, side in ipairs({ -1, 1 }) do -- -1: hinged on the divider; 1: on the side
		local hingeX = if side < 0 then xd + 0.04 else right
		local toward = -side -- where its free edge is
		local hinge = CFrame.new(hingeX, y0 + H / 2 + 0.06, face - 0.03)
		local parts = {}
		local function door(name, size, at, color, material, extra)
			local p = build.part(cart, name, size, hinge * CFrame.new(at), color, material, extra)
			table.insert(parts, p)
			return p
		end
		local half = cw / 2 - 0.02
		door("Door", Vector3.new(half, H - 0.3, 0.06), Vector3.new(toward * half / 2, 0, 0), walnut, wood)
		for _, t in ipairs({ { Vector3.new(half - 0.2, 0.05, 0.03), Vector3.new(0, H / 2 - 0.28, -0.04) }, { Vector3.new(half - 0.2, 0.05, 0.03), Vector3.new(0, -H / 2 + 0.28, -0.04) },
			{ Vector3.new(0.05, H - 0.6, 0.03), Vector3.new(-(half / 2 - 0.12), 0, -0.04) }, { Vector3.new(0.05, H - 0.6, 0.03), Vector3.new(half / 2 - 0.12, 0, -0.04) } }) do
			door("Trim", t[1], Vector3.new(toward * half / 2, 0, 0) + t[2], dark, wood)
		end
		door("DoorKnob", Vector3.new(0.13, 0.13, 0.13), Vector3.new(toward * (half - 0.12), 0, -0.08), brass, Enum.Material.Metal, { Shape = Enum.PartType.Ball })
		table.insert(doors, { parts = parts, hinge = hinge, toward = toward })
	end
	-- the doily, the TV on it
	build.part(cart, "Doily", Vector3.new(0.02, 2.2, 2.2), CFrame.new(0, y1 + 0.15, 0) * CFrame.Angles(0, 0, math.pi / 2), rgb(240, 236, 224),
		Enum.Material.Fabric, { Shape = Enum.PartType.Cylinder })
	if not build.tv(cart, Vector3.new(0, y1 + 0.16, 0)) then return SETUPS.Table() end
	cart.PrimaryPart = bottom
	for _, d in ipairs(doors) do -- the doors move with the cabinet: their hinges, in its space
		d.hinge = bottom.CFrame:ToObjectSpace(d.hinge)
		for i, p in ipairs(d.parts) do d.parts[i] = { part = p, rel = (bottom.CFrame * d.hinge):ToObjectSpace(p.CFrame) } end
	end
	build.finish(cart, Vector3.new(W, y1, D), CFrame.new(0, y1 / 2, 0))
	disc.locked = true
	local open = newPrompt(doors[2].parts[1].part, "Open", "Cabinet", 0.3, 8)
	on(open.Triggered, function()
		if not disc.locked then return end
		disc.locked, open.Enabled = false, false
		oneShot(SOUNDS.crack, bottom, { Volume = CONFIG.Volume * 0.3, PlaybackSpeed = 1.6 })
		task.spawn(function()
			local t0 = os.clock()
			while alive do
				local u = math.min((os.clock() - t0) / 0.6, 1)
				local angle = math.rad(105) * (1 - (1 - u) ^ 3)
				for _, d in ipairs(doors) do
					local hinge = bottom.CFrame * d.hinge * CFrame.Angles(0, d.toward * angle, 0) -- the free edge comes out towards you
					for _, p in ipairs(d.parts) do p.part.CFrame = hinge * p.rel end
				end
				if u >= 1 then break end
				RunService.Heartbeat:Wait()
			end
		end)
		if disc.carried and disc.insert then disc.insert.Enabled = true end
	end)
	return discCart("Console", cart, body, drive, light)
end

