J.close = UI.button({ Name = "Close", Text = "Close", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.875),
	Size = UDim2.fromScale(0.12, 0.06) }, J.gui)

-- One disc's page: its picture (the photo with its face, or its cover), what it is, how to survive, when you found it
function J.show(item)
	J.shown = item
	local found = item and journal.found[item.art]
	J.photo.Visible = found ~= nil
	if not found then
		J.name.Text, J.seen.Text, J.survive.Text = "", "", ""
		J.about.Text = if item then "<b>???</b> You have not found this tape yet." else "Pick one of your tapes on the left."
		return
	end
	local text = DISC_TEXT[item.art] or { "", "" }
	J.name.Text, J.about.Text, J.survive.Text = item.title, text[1], "How to survive: <b>" .. text[2] .. "</b>"
	J.seen.Text = ("Found %d time%s, first on %s"):format(found.times, if found.times == 1 then "" else "s", os.date("%d/%m/%Y", found.first))
	local face = item.type.face
	local file = if type(face) == "string" and not face:find("^rbxasset") then "_Photo" else "_Front" -- its face is in the photo, or its cover
	J.print.Image = files.discs[item.art .. file] or ""
	if not files.discs[item.art .. file] then
		task.spawn(function()
			local id = asset("Disc_" .. item.art .. file .. (if file == "_Photo" then ".png" else ".jpg"))
			files.discs[item.art .. file] = id
			if J.shown == item then J.print.Image = id or "" end
		end)
	end
end
-- The list: every disc, the ones found by their name, the others ??? and a black bar
function journal.refresh()
	for _, c in ipairs(J.list:GetChildren()) do c:Destroy() end
	make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, J.list)
	local count = 0
	for i, item in ipairs(J.pages) do
		local found = journal.found[item.art] ~= nil
		if found then count += 1 end
		local row = make("TextButton", { Name = item.art, LayoutOrder = i, Size = UDim2.new(1, -8, 0, 32), BackgroundTransparency = 1,
			AutoButtonColor = false, FontFace = UI.writing, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.ink,
			Text = if found then ("%d. %s"):format(i, item.title) else ("%d. ???"):format(i) }, J.list)
		make("UITextSizeConstraint", { MaxTextSize = 26 }, row)
		if not found then
			make("Frame", { Name = "Redacted", Position = UDim2.fromScale(0.22, 0.3), Size = UDim2.fromScale(0.5, 0.4), BackgroundColor3 = UI.ink,
				BorderSizePixel = 0 }, row)
		end
		on(row.MouseButton1Click, function()
			oneShot(SOUNDS.click, SoundService, { Volume = CONFIG.Volume * 0.4, PlaybackSpeed = 1.4 })
			J.show(item)
		end)
	end
	J.count.Text = ("Found: %d of %d"):format(count, #J.pages)
	J.show(J.shown)
end
function J.shut()
	if not J.gui.Enabled then return end
	J.gui.Enabled, J.close.Modal = false, false
	if mainGame and J.freed ~= nil then mainGame.freemouse = J.freed end
end
function J.open()
	if J.gui.Enabled then
		J.shut()
		return
	end
	journal.load()
	journal.refresh()
	J.gui.Enabled, J.close.Modal = true, true -- the mouse free to click (only while it is open)
	J.freed = mainGame and mainGame.freemouse
	if mainGame then mainGame.freemouse = true end
	oneShot(SOUNDS.click, SoundService, { Volume = CONFIG.Volume * 0.5, PlaybackSpeed = 0.8 })
end
on(J.close.MouseButton1Click, J.shut)
on(UserInputService.InputBegan, function(input)
	if J.gui.Enabled and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace) then J.shut() end
end)
-- The journal itself: an item with its icon, in your inventory every run (and again after you respawn); one only, with
-- other runs going on
function J.give()
	if not alive or (journal.tool and journal.tool.Parent) then return end
	for _, holder in ipairs({ backpack(), LocalPlayer.Character }) do
		if holder and holder:FindFirstChild("Noise Journal") then return end
	end
	local tool = make("Tool", { Name = "Noise Journal", ToolTip = "Your Noise tapes", CanBeDropped = false, RequiresHandle = false,
		TextureId = files.journal or "" }, nil)
	on(tool.Activated, J.open)
	tool.Parent = backpack()
	table.insert(owned, tool)
	journal.tool = tool
end
task.spawn(function()
	while alive and not filesReady do task.wait(0.2) end
	J.give()
end)
on(LocalPlayer.CharacterAdded, function()
	task.wait(1)
	J.give()
end)
end

-- The disc player's cart, whatever it is built of: `cart` (its TV in it, tv/tvMain/screen set), the player's body, the drive
-- its tray comes out of, its light. Until `disc.locked` is let go (the Console's doors), no disc goes in
local function discCart(name, cart, player, drive, light)
	local function front() return flat(outwardOf(screen)) or flat(player.CFrame.LookVector) or Vector3.new(0, 0, -1) end
	-- Its display: what it is doing
	local display = make("SurfaceGui", { Name = "Noise90Display", Face = faceToward(player, front()), CanvasSize = Vector2.new(440, 132),
		LightInfluence = 0, Brightness = 2 }, player)
	local readout = make("TextLabel", { Name = "Readout", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(0.95, 0.5),
		Size = UDim2.fromScale(0.42, 0.42), BackgroundColor3 = Color3.fromRGB(5, 12, 8), BorderSizePixel = 0, Font = Enum.Font.Code,
		TextScaled = true, TextColor3 = Color3.fromRGB(90, 255, 150), Text = "NO DISC" }, display)
	local message, messageUntil = nil, 0
	local function say(text, seconds) message, messageUntil = text, os.clock() + (seconds or 1.5) end
	on(RunService.Heartbeat, function()
		local text
		if os.clock() < messageUntil then
			text = message
		elseif not disc.inserted then
			text = if math.floor(os.clock() * 2) % 2 == 0 then "NO DISC" else ""
		elseif disc.ejected then
			text = "EJECT"
		elseif state == "tape" then
			local t = math.max(os.clock() - tapeStartedAt, 0)
			text = if frozen() then "PAUSE" elseif disc.scratched and math.random() < 0.06 then "SKIP" else ("PLAY %02d:%02d"):format(math.floor(t / 60), t % 60)
		elseif state == "waiting" then
			text = "READ"
		elseif state == "chase" or state == "phase" or state == "emerging" then
			text = if math.random() < 0.1 then "ERR" else "PLAY --:--"
		else
			text = "STOP"
		end
		readout.Text = text
	end)
	-- Its tray: out of the drive, towards you, and back in
	local tray = make("Part", { Name = "Tray", Size = Vector3.new(1.05, 0.05, 1.05), Color = rgb(22, 22, 26), Material = Enum.Material.SmoothPlastic,
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false }, cart)
	local function trayAt(u)
		local inside = (drive or player).Position
		local at = inside + front() * (u * 1.05)
		tray.CFrame = CFrame.lookAt(at, at + front())
	end
	trayAt(0)
	local function slide(from, to, carry)
		oneShot(SOUNDS.whir, player, { Volume = CONFIG.Volume * 0.5, PlaybackSpeed = 2 })
		local t0 = os.clock()
		while alive do
			local u = math.min((os.clock() - t0) / 0.35, 1)
			trayAt(from + (to - from) * (u * u * (3 - 2 * u)))
			if carry then carry.CFrame = tray.CFrame * CFrame.new(0, 0.04, 0) * DISC_FLAT end
			if u >= 1 then break end
			RunService.Heartbeat:Wait()
		end
	end
	local function hideDisc(part, hidden)
		part.Transparency = if hidden then 1 else 0
		for _, d in ipairs(part:GetChildren()) do
			if d:IsA("Decal") then d.Transparency = if hidden then 1 else 0 end
		end
	end

	disc.insert = newPrompt(player, "Put the disc in", "Player", 0.3, 8)
	disc.insert.Enabled = false
	disc.pause = newPrompt(player, "Pause", "Player", 0, 8)
	disc.pause.KeyboardKeyCode, disc.pause.UIOffset, disc.pause.Enabled = Enum.KeyCode.F, Vector2.new(0, 70), false
	local discs = V.discs or { { title = V.name, art = V.art } }
	for _, d in ipairs(discs) do
		local roll, wear = math.random(), tostring(CONFIG.DiscWear):lower()
		local entry = { title = d.title, disc = d.disc, art = d.art or V.art,
			condition = if CONDITION[wear] then wear elseif not CONFIG.DiscWear or roll < 0.8 then "clean" else "scratched" }
		makeDisc(entry)
		on(entry.look.Triggered, function() openInspect(entry) end)
		table.insert(disc.entries, entry)
	end
	-- In your hand while you carry it
	on(RunService.Heartbeat, function()
		local entry = disc.carried
		local character = LocalPlayer.Character
		local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
		if entry and hand and not disc.busy then
			entry.model:PivotTo(hand.CFrame * CFrame.new(0, -hand.Size.Y / 2 - 0.15, -0.3) * CFrame.Angles(0, 0, math.pi / 2))
		end
	end)
	-- Pause, while the tape plays: it holds for 2.5 s (then the player needs 10 s)
	local pauseReady = 0
	on(RunService.Heartbeat, function()
		disc.pause.Enabled = disc.inserted ~= nil and not disc.ejected and state == "tape" and os.clock() >= pauseReady
	end)
	on(disc.pause.Triggered, function()
		if state ~= "tape" or os.clock() < pauseReady then return end
		pauseReady = os.clock() + 10
		pausedUntil = math.max(pausedUntil, os.clock() + 2.5)
		oneShot(SOUNDS.click, player)
	end)
	-- Eject, once it is out: the tray comes out, the disc jumps out, the tape stops, and it is pulled back into its TV
	local function eject()
		local noise = current
		if disc.ejected or not (noise and not noise.gone and (state == "chase" or state == "phase")) then return end
		disc.ejected, disc.insert.Enabled = true, false
		state = "done"
		screensOff()
		task.spawn(climbBack, noise)
		local entry = disc.inserted
		local part = entry.parts.disc
		oneShot(SOUNDS.click, player)
		if light then light.Material, light.Color = Enum.Material.SmoothPlastic, Color3.new(0.15, 0.15, 0.15) end
		task.spawn(function()
			hideDisc(part, false)
			slide(0, 1, part)
			part.Parent = folder
			part.Anchored, part.CanCollide = false, true
			part.AssemblyLinearVelocity = front() * 9 + Vector3.new(0, 7, 0)
			part.AssemblyAngularVelocity = Vector3.new(rnd(6), rnd(6), rnd(6))
			task.wait(0.5)
			slide(1, 0)
		end)
	end
	on(RunService.Heartbeat, function()
		if disc.inserted and not disc.ejected and not disc.busy then
			local noise = current
			disc.insert.Enabled = noise ~= nil and not noise.gone and (state == "chase" or state == "phase")
		end
	end)
	-- In: the tray comes out, the case goes down on the player and opens, the disc onto the tray, the tray in. The player
	-- reads it and plays it
	on(disc.insert.Triggered, function()
		if disc.inserted then
			eject()
			return
		end
		local entry = disc.carried
		if not entry or disc.busy or disc.locked then return end
		disc.busy, disc.insert.Enabled = true, false
		entry.tool.Parent = nil -- out of your inventory, into the player
		closeInspect()
		task.spawn(function()
			say("OPEN", 1)
			slide(0, 1)
			local top = player.Position + Vector3.new(0, player.Size.Y / 2, 0) - front() * 0.2
			entry.model:PivotTo(CFrame.new(top + Vector3.new(0, 0.01, 0)) * CFrame.Angles(0, math.atan2(-front().X, -front().Z) + math.pi / 2, 0))
			local t0 = os.clock()
			while alive and os.clock() - t0 < 0.3 do
				setLid(entry.model, entry.rest, (os.clock() - t0) / 0.3)
				RunService.Heartbeat:Wait()
			end
			setLid(entry.model, entry.rest, 1)
			local part = entry.parts.disc
			local from = part.CFrame
			local goal = tray.CFrame * CFrame.new(0, 0.04, 0) * DISC_FLAT
			t0 = os.clock()
			while alive and os.clock() - t0 < 0.4 do
				local u = (os.clock() - t0) / 0.4
				part.CFrame = from:Lerp(goal, u) + Vector3.new(0, math.sin(u * math.pi) * 0.5, 0)
				RunService.Heartbeat:Wait()
			end
			slide(1, 0, part)
			hideDisc(part, true)
			say("READ", 1.3)
			oneShot(SOUNDS.whir, player, { Volume = CONFIG.Volume * 0.4, PlaybackSpeed = 0.7 })
			task.wait(1.3)
			disc.inserted, disc.carried = entry, nil
			entry.tool:Destroy()
			entry.tool = nil
			for _, other in ipairs(disc.entries) do other.take.Enabled, other.look.Enabled = false, false end
			entry.look.Enabled = true -- the empty case on the player: you can still read it
			if entry.disc then CONFIG.Disc = entry.disc end
			disc.scratched = entry.condition == "scratched"
			oneShot(SOUNDS.click, player)
			if light then light.Material, light.Color = Enum.Material.Neon, BLUE end
			disc.insert.ActionText, disc.insert.HoldDuration, disc.insert.Enabled = "Eject", 2.5, false
			disc.busy = false
		end)
	end)

	local setup = { name = name, trigger = "disc", power = addPower() }
	function setup.place()
		if disc.taken or disc.inserted or disc.busy or (setup.power and setup.power.on) then return true end -- it stays once you have touched it
		local at, inward = settle(2.8, { cart }, function(at, inward)
			standAt(cart, flat(outwardOf(screen)), at, inward)
			return fits(cart)
		end)
		if not at then return false end
		cart.Parent = folder
		trayAt(0)
		if setup.power then setup.power.place(inward) end
		local spots = floorSpots(#disc.entries, { at })
		for i, entry in ipairs(disc.entries) do
			entry.spot = CFrame.new(spots[i] + Vector3.new(0, 0.01, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0)
			entry.model:PivotTo(entry.spot)
			entry.model.Parent = folder
		end
		return true
	end
	return setup
end

-- The Stairwell's TV cart, from the kit
function SETUPS.Cart()
	local source = prop("TV_Stand")
	local deck = source and source:FindFirstChild("PlayerMain")
	if not (deck and deck:FindFirstChild("PlayerMain")) then return SETUPS.Table() end
	local cart = clean(source:Clone())
	cart.Name = "NoiseTV"
	for _, d in ipairs(cart:GetDescendants()) do -- for the game's physics only
		if d:IsA("BasePart") and d.Name == "DebrisCollider" then d:Destroy() end
	end
	local collider = cart:FindFirstChild("Collider")
	if collider then collider.CanCollide = true end -- you bump into it
	tv, tvMain = cart, cart:FindFirstChild("TVMain")
	screen = tvMain:FindFirstChild("TVScreen")
	dressScreen()
	measureTV()
	local player = cart.PlayerMain.PlayerMain
	return discCart("Cart", cart, player, player:FindFirstChild("Drive"), player:FindFirstChild("Light"))
end

---- Three more carts for the disc player, built here: a school AV cart, a 70s TV console, the hotel's luggage cart ----

local build = {}
-- A part of a built cart (clean() anchors it and keeps it out of the way of clicks)
function build.part(parent, name, size, cf, color, material, extra)
	local p = make("Part", { Name = name, Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic,
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth }, parent)
	for k, v in pairs(extra or {}) do p[k] = v end
	return p
end
-- A turn whose X looks along `dir` (a cylinder lies along its X)
function build.along(at, dir)
	local x = dir.Unit
	local z = x:Cross(if math.abs(x.Y) < 0.9 then Vector3.new(0, 1, 0) else Vector3.new(0, 0, 1)).Unit
	return CFrame.fromMatrix(at, x, z:Cross(x), z)
end
-- A rod from `a` to `b`
function build.rod(parent, name, a, b, thick, color, material)
	return build.part(parent, name, Vector3.new((b - a).Magnitude, thick, thick), build.along((a + b) / 2, b - a), color, material,
		{ Shape = Enum.PartType.Cylinder })
end
function build.ball(parent, name, d, at, color, material)
	return build.part(parent, name, Vector3.new(d, d, d), CFrame.new(at), color, material, { Shape = Enum.PartType.Ball })
end
-- A wheel at `at` turning about `axle`: its tyre, its hub
function build.wheel(parent, at, d, width, axle, hub)
	local cf = build.along(at, axle)
	build.part(parent, "Wheel", Vector3.new(width, d, d), cf, rgb(22, 22, 24), Enum.Material.Rubber, { Shape = Enum.PartType.Cylinder })
	build.part(parent, "Hub", Vector3.new(width + 0.04, d * 0.45, d * 0.45), cf, hub or rgb(170, 172, 178), Enum.Material.Metal, { Shape = Enum.PartType.Cylinder })
end
-- Words on a face of a part
function build.words(part, face, text, props)
	local gui = make("SurfaceGui", { Name = "Words", Face = face, CanvasSize = Vector2.new(400, 100) }, part)
	local base = { Name = "Text", Text = text, Size = UDim2.fromScale(1, 1), TextColor3 = rgb(20, 20, 20) }
	for k, v in pairs(props or {}) do base[k] = v end
	return UI.label(base, gui)
end
-- The kit's TV (the Stairwell's, on its little feet) into `cart`, its feet at `at`, its screen towards -Z: tv, tvMain, screen.
-- False without the kit
function build.tv(cart, at)
	local source = prop("TV_Stand")
	local main = source and source:FindFirstChild("TVMain")
	if not (main and main:FindFirstChild("TVScreen")) then return false end
	local set = make("Model", { Name = "TV" }, cart)
	main:Clone().Parent = set
	set.PrimaryPart = set:FindFirstChild("TVMain")
	tv, tvMain = set, set.PrimaryPart
	screen = tvMain:FindFirstChild("TVScreen")
	measureTV()
	poseTV(at + Vector3.new(0, 3, 0), Vector3.new(0, 0, -1), Vector3.new(0, 1, 0))
	local box = set:GetBoundingBox()
	set:PivotTo(set:GetPivot() + Vector3.new(at.X - box.X, at.Y - spanY(set), at.Z - box.Z))
	tv = cart
	return true
end
-- A disc player of our own at `cf`, its front towards -Z: the left of its front has the slot of its tray, its light and its
-- buttons, the right its display. look: size, body, trim. -> its body, its drive, its light
function build.deck(cart, cf, look)
	local w, h, d = look.size.X, look.size.Y, look.size.Z
	local trim = look.trim or rgb(150, 150, 156)
	local body = build.part(cart, "PlayerMain", look.size, cf, look.body, look.material)
	local front = -d / 2 - 0.012
	local drive = build.part(body, "Drive", Vector3.new(w * 0.4, 0.05, d * 0.85), cf * CFrame.new(-w * 0.22, h * 0.2, 0), rgb(10, 10, 12))
	build.part(body, "Slot", Vector3.new(w * 0.42, math.min(0.07, h * 0.2), 0.02), cf * CFrame.new(-w * 0.22, h * 0.2, front), rgb(8, 8, 10))
	local light = build.part(body, "Light", Vector3.new(w * 0.3, math.min(0.035, h * 0.12), 0.02), cf * CFrame.new(-w * 0.22, -h * 0.04, front), rgb(38, 38, 38))
	for i = 1, 4 do
		build.part(body, "Button", Vector3.new(w * 0.06, h * 0.14, 0.03), cf * CFrame.new(-w * 0.42 + i * w * 0.08, -h * 0.3, front), trim, Enum.Material.Metal)
	end
	build.part(body, "Knob", Vector3.new(0.05, h * 0.36, h * 0.36), cf * CFrame.new(-w * 0.02, -h * 0.18, front - 0.02) * CFrame.Angles(0, math.pi / 2, 0),
		trim, Enum.Material.Metal, { Shape = Enum.PartType.Cylinder })
	for _, x in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -1, 1 }) do
			build.part(body, "Foot", Vector3.new(0.04, 0.12, 0.12), cf * CFrame.new(x * (w / 2 - 0.15), -h / 2 - 0.02, z * (d / 2 - 0.15)) * CFrame.Angles(0, 0, math.pi / 2),
				rgb(20, 20, 20), Enum.Material.Rubber, { Shape = Enum.PartType.Cylinder })
		end
	end
	return body, drive, light
end
-- An invisible box you bump into; clean() it, then dress its TV
function build.finish(cart, size, cf)
	local collider = build.part(cart, "Collider", size, cf, Color3.new(), nil, { Transparency = 1 })
	clean(cart)
	collider.CanCollide = true
	dressScreen()
	measureTV()
end

-- A school AV cart: grey steel, three shelves with a lip, four casters, a push handle at the back. The TV strapped on top,
-- the player on the middle shelf, a stack of tapes underneath, a power strip on a leg, PROPERTY OF THE HOTEL
function SETUPS.AVCart()
	local cart = make("Model", { Name = "NoiseTV" }, nil)
	local steel, dark, W, D = rgb(150, 154, 162), rgb(60, 62, 68), 3.6, 2.4
	local shelves = { 0.95, 2.35, 3.75 }
	for _, y in ipairs(shelves) do
		build.part(cart, "Shelf", Vector3.new(W, 0.08, D), CFrame.new(0, y, 0), steel, Enum.Material.Metal)
		for _, lip in ipairs({ { Vector3.new(W, 0.2, 0.05), Vector3.new(0, 0.1, -D / 2) }, { Vector3.new(W, 0.2, 0.05), Vector3.new(0, 0.1, D / 2) },
			{ Vector3.new(0.05, 0.2, D), Vector3.new(-W / 2, 0.1, 0) }, { Vector3.new(0.05, 0.2, D), Vector3.new(W / 2, 0.1, 0) } }) do
			build.part(cart, "Lip", lip[1], CFrame.new(lip[2] + Vector3.new(0, y, 0)), steel, Enum.Material.Metal)
		end
	end
	for _, x in ipairs({ -W / 2 + 0.1, W / 2 - 0.1 }) do
		for _, z in ipairs({ -D / 2 + 0.1, D / 2 - 0.1 }) do
			build.part(cart, "Leg", Vector3.new(0.16, 3.3, 0.16), CFrame.new(x, 2.2, z), steel, Enum.Material.Metal)
			build.part(cart, "Fork", Vector3.new(0.24, 0.3, 0.3), CFrame.new(x, 0.47, z), dark, Enum.Material.Metal)
			build.wheel(cart, Vector3.new(x, 0.22, z + 0.06), 0.44, 0.16, Vector3.new(1, 0, 0))
		end
	end
	for _, x in ipairs({ -1.2, 1.2 }) do
		build.rod(cart, "Bracket", Vector3.new(x, 3.25, D / 2), Vector3.new(x, 3.25, D / 2 + 0.38), 0.1, steel, Enum.Material.Metal)
	end
	build.rod(cart, "Handle", Vector3.new(-1.4, 3.25, D / 2 + 0.38), Vector3.new(1.4, 3.25, D / 2 + 0.38), 0.14, rgb(25, 25, 28), Enum.Material.Rubber)
	for i = 1, 3 do -- the tapes underneath, the discs' brand on their spines
