			d:Destroy()
		end
	end
	paint(model, 0)
	model.Parent = subject
	local cam = make("Camera", { Name = "Camera", FieldOfView = 30 }, subject)
	subject.CurrentCamera = cam
	local cf, size = model:GetBoundingBox()
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
	local front = flat(if root then root.CFrame.LookVector else cf.LookVector) or Vector3.new(0, 0, -1)
