	inspect.lid += (inspect.lidGoal - inspect.lid) * math.min(dt * 8, 1)
	inspect.turn = (inspect.turn or 0) + ((inspect.flip or 0) - (inspect.turn or 0)) * math.min(dt * 6, 1)
	view:PivotTo(CFrame.Angles(0, inspect.yaw, 0) * CFrame.Angles(inspect.pitch * 0.4 + inspect.turn, 0, 0))
	setLid(view, entry.rest, inspect.lid)
	viewCam.CFrame = CFrame.lookAt(Vector3.new(0, inspect.dist * 0.82, inspect.dist * 0.58), Vector3.new(0, 0.05, 0))
end)

