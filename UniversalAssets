-- A box plus a > button that cycles through the model's own names
local function cycler(name, y, listOf)
	label(name, 10, y, 50)
	local b = box(name, "name, ID or stop", 60, y, 254)
	button(name .. "Next", ">", 320, y, 30, function()
		local list = current() and listOf(current()) or {}
		if #list == 0 then return end
		b.Text = list[(table.find(list, b.Text) or 0) % #list + 1]
	end)
	return b
end
local animBox = cycler("Anim", 192, function(o) return o.anims end)
local soundBox = cycler("Sound", 222, function(o) return o.soundNames end)

local function fromFields(k)
	local obj = current()
	k.t = math.max(tonumber(timeBox.Text) or 0, 0)
	k.cf = obj.model:GetPivot()
	k.ease = CONFIG.Eases[ease]
	k.anim = if animBox.Text ~= "" then animBox.Text else nil
	k.sound = if soundBox.Text ~= "" then soundBox.Text else nil
	table.sort(obj.keys, function(a, b) return a.t < b.t end)
	refresh()
end

button("AddKey", "+ Key", 10, 254, 80, function()
	local obj = current()
	if not obj then return end
	local t = math.max(tonumber(timeBox.Text) or 0, 0)
	local k
	for _, other in ipairs(obj.keys) do
		if math.abs(other.t - t) < 1e-3 then k = other end -- same time: replaced
	end
	if not k then
		k = {}
		table.insert(obj.keys, k)
	end
	selectedKey = k
	fromFields(k)
	timeBox.Text = tostring(t + 1)
end)
