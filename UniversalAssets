---====== LOADING ======---

local function fetch(src)
	local id = tonumber(src)
	if id then
		local ok, r = pcall(function() return game:GetObjects("rbxassetid://" .. id)[1] end)
		return ok and r or nil
	end
	if src:match("^https?://") then -- a .rbxm from the internet, like Vynixu's LoadCustomInstance
		local ok, r = pcall(function()
			if not isfolder(CONFIG.Folder) then makefolder(CONFIG.Folder) end
			local file = CONFIG.Folder .. "/download.rbxm"
			writefile(file, game:HttpGet(src))
			return game:GetObjects(getcustomasset(file))[1]
		end)
		return ok and r or nil
	end
	local name = src:match("^Room:(.+)")
	if name then -- the room you are in first, then the others
		local rooms = workspace:FindFirstChild("CurrentRooms")
		if not rooms then return nil end
		local list = rooms:GetChildren()
		local here = rooms:FindFirstChild(tostring(LocalPlayer:GetAttribute("CurrentRoom") or ""))
		if here then table.insert(list, 1, here) end
		for _, room in ipairs(list) do
			local found = room:FindFirstChild(name, true)
			if found and found:IsA("Model") then return found end
		end
		return nil
	end
	local current = game
	for part in src:gmatch("[^%.]+") do current = current and current:FindFirstChild(part) end
	return current
end

local function inFront()
	local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	local base = root and root.CFrame or workspace.CurrentCamera.CFrame
	return base * CFrame.new(0, 0, -8) * CFrame.Angles(0, math.pi, 0)
end

-- Names of what can be played in the model, for the ▶ buttons
local function namesOf(model, test)
	local names, seen = {}, {}
	for _, d in ipairs(model:GetDescendants()) do
		if test(d) and not seen[d.Name] then
			seen[d.Name] = true
			table.insert(names, d.Name)
		end
	end
	return names
end
local function isAnim(d) return d:IsA("Animation") or d:IsA("KeyframeSequence") end
local function isSound(d) return d:IsA("Sound") end

---====== ANIMATIONS ======---

-- true: this game's owner (or Roblox) uploaded it, so it plays. false: it will not. nil: unknown
local owners = {}
local function ownedHere(id)
	if owners[id] == nil then
		local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, id)
		local creator = ok and info ~= nil and type(info) == "table" and info.Creator
		owners[id] = if creator
			then creator.CreatorTargetId == 1
				or (creator.CreatorTargetId == game.CreatorId and tostring(game.CreatorType):find(creator.CreatorType or "?") ~= nil)
			else "unknown"
	end
	return if owners[id] == "unknown" then nil else owners[id]
end

local function nativeTrack(animator, animation, timeout)
	local ok, track = pcall(animator.LoadAnimation, animator, animation)
	if not ok then return nil end
	local deadline = os.clock() + timeout
	while track.Length == 0 and os.clock() < deadline do task.wait(0.1) end
	if track.Length == 0 then
		track:Destroy()
		return nil
	end
	return track
end

local function sequenceOf(source)
	if source:IsA("KeyframeSequence") then return source end
	local id = tonumber(source.AnimationId:match("%d+") or "")
	if not id then return nil end
	for _, get in ipairs({
		function() return game:GetObjects("rbxassetid://" .. id)[1] end,
		function() return KFSProvider:GetKeyframeSequenceAsync("rbxassetid://" .. id) end,
	}) do
		local ok, kfs = pcall(get)
		if ok and kfs ~= nil and typeof(kfs) == "Instance" and kfs:IsA("KeyframeSequence") then return kfs end
	end
	return nil
end

--[[ Plays a KeyframeSequence by moving the joints itself, like an AnimationTrack.
     The easing of a pose shapes the way to the next one; the old Cubic, Elastic
     and Bounce styles have In and Out swapped, as in Roblox. ]]
local STYLE = { Linear = "Linear", Cubic = "Cubic", CubicV2 = "Cubic", Elastic = "Elastic", Bounce = "Bounce" }
local function sequencePlayer(model, kfs)
	local motors, joints, length = {}, {}, 0
	for _, m in ipairs(model:GetDescendants()) do
		if m:IsA("Motor6D") and m.Part1 then motors[m.Part1.Name] = m end
	end
	local frames = kfs:GetKeyframes()
	table.sort(frames, function(a, b) return a.Time < b.Time end)
	for _, frame in ipairs(frames) do
		length = math.max(length, frame.Time)
		for _, pose in ipairs(frame:GetDescendants()) do
			if pose:IsA("Pose") and pose.Weight > 0 and motors[pose.Name] then
				joints[pose.Name] = joints[pose.Name] or {}
				table.insert(joints[pose.Name], { t = frame.Time, cf = pose.CFrame, style = pose.EasingStyle.Name, dir = pose.EasingDirection.Name })
			end
		end
	end
	local player = { Length = length, Looped = kfs.Loop, IsPlaying = false, time = 0 }
	function player:Play()
		self.time, self.IsPlaying = 0, true
		active[self] = true
	end
	function player:Stop()
		self.IsPlaying, active[self] = false, nil
		for name in pairs(joints) do motors[name].Transform = CFrame.identity end
	end
	player.Destroy = player.Stop
	function player:step(dt)
		self.time += dt
		if self.time >= length then
			if not self.Looped or length <= 0 then self:Stop() return end
			self.time %= length
		end
		for name, list in pairs(joints) do
			local a, b = list[1], nil
			for i = 2, #list do
				if list[i].t <= self.time then a = list[i] else b = list[i] break end
			end
			local cf = a.cf
			if b and a.style ~= "Constant" and self.time > a.t then
				local dir = a.dir
				if a.style ~= "CubicV2" and a.style ~= "Linear" then
					dir = if dir == "In" then "Out" elseif dir == "Out" then "In" else dir
				end
				local alpha = TweenService:GetValue((self.time - a.t) / (b.t - a.t),
					Enum.EasingStyle[STYLE[a.style] or "Linear"], Enum.EasingDirection[dir])
				cf = a.cf:Lerp(b.cf, alpha)
			end
			motors[name].Transform = cf
		end
	end
	return player
end

-- A track for `text` (a name in the model or an ID), converted if this game cannot play it
local function loadTrack(obj, text)
	if obj.cache[text] then return obj.cache[text] end
	local source = obj.model:FindFirstChild(text, true)
	if source and not isAnim(source) then source = nil end
	local id = tonumber(text:match("%d+") or "")
	if not source and id then
		source = Instance.new("Animation")
		source.AnimationId = "rbxassetid://" .. id
	end
	if not source then return nil end
	local track
	if source:IsA("Animation") then
		id = tonumber(source.AnimationId:match("%d+") or "")
		if not id or ownedHere(id) ~= false then track = nativeTrack(obj.animator, source, 4) end
	end
	if not track then
		status("Converting " .. text .. ": not owned by this game")
		local kfs = sequenceOf(source)
		if not kfs then
			status(text .. " cannot be converted (private?)")
			return nil
		end
		local ok, temp = pcall(KFSProvider.RegisterKeyframeSequence, KFSProvider, kfs)
		if ok and type(temp) == "string" then
			local animation = Instance.new("Animation")
			animation.AnimationId = temp
			track = nativeTrack(obj.animator, animation, 1.5)
		end
		track = track or sequencePlayer(obj.model, kfs)
	end
	obj.cache[text] = track
	return track
end

local function stopAnim(obj)
	obj.token = nil
	if obj.track then obj.track:Stop(0.2) end
	obj.track = nil
end

local function playAnim(obj, text)
	stopAnim(obj)
	if text:lower() == "stop" then return end
	local token = {}
	obj.token = token
	task.spawn(function()
		local track = loadTrack(obj, text)
		if track and obj.token == token then
			obj.track = track
			track:Play(0.2)
		end
	end)
end

local function playSound(obj, text)
	if obj.sound then obj.sound:Stop() end
	obj.sound = nil
	if text:lower() == "stop" then return end
	local sound = obj.model:FindFirstChild(text, true)
	if not (sound and sound:IsA("Sound")) then
		local id = tonumber(text:match("%d+") or "")
		if not id then return end
		sound = obj.sounds[id] or Instance.new("Sound")
		sound.SoundId = "rbxassetid://" .. id
		sound.Parent = obj.root
		obj.sounds[id] = sound
	end
	sound.TimePosition = 0
	sound:Play()
	obj.sound = sound
end

---====== OBJECTS ======---

local function current() return objects[selected] end

local function insert(label, src, keys)
	status("Loading " .. label .. "...")
	local source = fetch(src)
	if not source then status("Not found: " .. label) return end
	local was = source.Archivable
	source.Archivable = true
	local model = source:Clone()
	source.Archivable = was
	if not model then status("Cannot copy " .. label) return end
	if not model:IsA("Model") then
		local holder = Instance.new("Model")
		model.Parent = holder
		model = holder
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then d:Destroy() end -- a puppet, not the real thing
	end
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart", true)
		or model:FindFirstChild("RootPart", true) or model:FindFirstChildWhichIsA("BasePart", true)
	if not root then
		model:Destroy()
		status(label .. " has no parts")
		return
	end
	model.PrimaryPart = root
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = p == root, false, false, false
		end
	end
	local animator = model:FindFirstChildWhichIsA("Animator", true)
	if not animator then
		local holder = model:FindFirstChildWhichIsA("Humanoid", true) or model:FindFirstChildWhichIsA("AnimationController", true)
		if not holder then
			holder = Instance.new("AnimationController")
			holder.Parent = model
		end
		animator = Instance.new("Animator")
		animator.Parent = holder
	end
	model:PivotTo(keys and keys[1] and keys[1].cf or inFront())
	model.Name = "UCA_" .. label
	model.Parent = workspace
	RunService.Heartbeat:Wait()
	for _, p in ipairs(model:GetDescendants()) do -- not held by any joint: it would fall
		if p:IsA("BasePart") and not p.Anchored and not p:IsGrounded() then p.Anchored = true end
	end
	local obj = { label = label, src = src, model = model, root = root, animator = animator,
		keys = keys or {}, cache = {}, sounds = {}, anims = namesOf(model, isAnim), soundNames = namesOf(model, isSound) }
	table.insert(objects, obj)
	selected, selectedKey = #objects, nil
	refresh()
	-- Ready every animation now, so Play does not wait: the conversions take a while
	for i, name in ipairs(obj.anims) do
		status(("%s: preparing animations %d/%d"):format(label, i, #obj.anims))
		loadTrack(obj, name)
	end
	status(label .. " ready")
end

local function remove(obj)
	stopAnim(obj)
	for _, track in pairs(obj.cache) do active[track] = nil end
	obj.model:Destroy()
	table.remove(objects, table.find(objects, obj))
	selected, selectedKey = math.min(selected, #objects), nil
	refresh()
end

---====== PLAYBACK ======---

local function poseAt(keys, t)
	if t <= keys[1].t then return keys[1].cf end
	for i = 1, #keys - 1 do
		local a, b = keys[i], keys[i + 1]
		if t < b.t then
			if b.ease == "Constant" then return a.cf end
			local alpha = TweenService:GetValue((t - a.t) / (b.t - a.t), Enum.EasingStyle[b.ease], Enum.EasingDirection.InOut)
			return a.cf:Lerp(b.cf, alpha)
		end
	end
	return keys[#keys].cf
end

local function stop()
	playing = nil
	for _, obj in ipairs(objects) do
		stopAnim(obj)
		if obj.sound then obj.sound:Stop() end
	end
end

local function play()
	stop()
	playing = { start = os.clock(), last = -1 }
	status("Playing")
end

local function stepPlayback()
	if not playing then return end
	local t, total = os.clock() - playing.start, 0
	for _, obj in ipairs(objects) do
		local keys = obj.keys
		if #keys > 0 then
			total = math.max(total, keys[#keys].t)
			for _, k in ipairs(keys) do
				if k.t > playing.last and k.t <= t then
					if k.anim then playAnim(obj, k.anim) end
					if k.sound then playSound(obj, k.sound) end
				end
			end
			obj.model:PivotTo(poseAt(keys, t))
		end
	end
	playing.last = t
	if t >= total then
		if loop and total > 0 then
			playing = { start = os.clock(), last = -1 }
		else
			playing = nil
			status("Done")
		end
	end
end

---====== SAVE / LOAD (a Lua table in the executor's folder) ======---

local function serialize(v)
	if type(v) == "number" then return string.format("%.17g", v) end
	if type(v) == "string" then return string.format("%q", v) end
	if type(v) ~= "table" then return tostring(v) end
	local parts = {}
	for k, x in pairs(v) do table.insert(parts, "[" .. serialize(k) .. "]=" .. serialize(x)) end
	return "{" .. table.concat(parts, ",") .. "}"
end

local function saveProject(name)
	local project = { loop = loop, objects = {} }
	for _, obj in ipairs(objects) do
		local keys = {}
		for _, k in ipairs(obj.keys) do
			table.insert(keys, { t = k.t, cf = { k.cf:GetComponents() }, ease = k.ease, anim = k.anim, sound = k.sound })
		end
		table.insert(project.objects, { label = obj.label, src = obj.src, keys = keys })
	end
	local ok = pcall(function()
		if not isfolder(CONFIG.Folder) then makefolder(CONFIG.Folder) end
		writefile(CONFIG.Folder .. "/" .. name .. ".lua", "return " .. serialize(project))
	end)
	status(if ok then "Saved " .. name else "Cannot save: your executor has no writefile")
end

local function loadProject(name)
	local ok, project = pcall(function() return loadstring(readfile(CONFIG.Folder .. "/" .. name .. ".lua"))() end)
	if not ok or type(project) ~= "table" then status("Cannot read " .. name) return end
	stop()
	while #objects > 0 do remove(objects[1]) end
	loop = project.loop == true
	for _, saved in ipairs(project.objects) do
		local keys = {}
		for _, k in ipairs(saved.keys) do
			table.insert(keys, { t = k.t, cf = CFrame.new(table.unpack(k.cf)), ease = k.ease, anim = k.anim, sound = k.sound })
		end
		insert(saved.label, saved.src, keys)
	end
	status("Loaded " .. name)
end

---====== PLACING WITH THE MOUSE ======---

local placing = nil
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function stepPlacing()
	if not placing then return end
	local camera = workspace.CurrentCamera
	local mouse = UIS:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	rayParams.FilterDescendantsInstances = { placing.obj.model, LocalPlayer.Character }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 300, rayParams)
	local spot = if hit then hit.Position else ray.Origin + ray.Direction * 20
	placing.obj.model:PivotTo(CFrame.new(spot + Vector3.new(0, placing.base + placing.lift, 0)) * CFrame.Angles(0, placing.yaw, 0))
end

local function startPlacing()
	local obj = current()
	if not obj then return end
	local box, size = obj.model:GetBoundingBox()
	local pivot = obj.model:GetPivot()
	local _, yaw = pivot:ToOrientation()
	placing = { obj = obj, from = pivot, yaw = yaw, lift = 0, base = pivot.Y - (box.Y - size.Y / 2) }
	status("Click to drop. Q/E turn, R/F up/down, Esc cancel")
end

