local function setup(model, label, src, keys, at)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then d:Destroy() end -- a puppet, not the real thing
	end
	local movers = findMovers(model)
	local moving = {}
	for _, m in ipairs(movers) do moving[m.part] = m end
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart", true)
		or model:FindFirstChild("RootPart", true) or model:FindFirstChildWhichIsA("BasePart", true)
	if root and moving[root] then root = moving[root].static end -- DOORS' door: its root is the panel
	if not root then
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") and not moving[p] then root = p break end
		end
	end
	if not root then
		model:Destroy()
		status(label .. " has no parts")
		return nil
	end
	model.PrimaryPart = root
	-- What is joined to the root moves with it and plays animations; the rest is anchored
	local links = jointLinks(model, movers)
	local body = groupOf(root, links)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = p == root or not body[p], false, false, false
		end
	end
	local animator = model:FindFirstChildWhichIsA("Animator", true)
	if not animator then
		local holder = model:FindFirstChildWhichIsA("Humanoid", true) or model:FindFirstChildWhichIsA("AnimationController", true)
		if not holder then
			holder = Instance.new("AnimationController")
			holder.Parent = model
		end
		animator = Instance.new("Animator")
		animator.Parent = holder
	end
	model:PivotTo(keys and keys[1] and keys[1].cf or at or inFront())
	model.Name = "UCA_" .. label
	model.Parent = workspace

	local pivot = model:GetPivot()
	local valid = {}
	for _, m in ipairs(movers) do
		if not body[m.part] then
			m.rel = {}
			for part in pairs(groupOf(m.part, links, body)) do m.rel[part] = pivot:ToObjectSpace(part.CFrame) end
			m.point = pivot:PointToObjectSpace(m.att.WorldPosition)
			m.axis = pivot:VectorToObjectSpace(m.att.WorldAxis)
			table.insert(valid, m)
		end
	end
	-- The wardrobe's own open / close animations live on its prompt (Anim_EnterModel...)
	local promptAnims, anims = {}, namesOf(model, isAnim)
	for _, prompt in ipairs(model:GetDescendants()) do
		if prompt:IsA("ProximityPrompt") then
			for name, value in pairs(prompt:GetAttributes()) do
				if type(value) == "string" and value:match("^rbxassetid://%d+$") and not promptAnims[name] then
					promptAnims[name] = value
					table.insert(anims, name)
				end
			end
		end
	end
	local lights, emitters = {}, {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Light") then table.insert(lights, d) end
		if d:IsA("ParticleEmitter") then table.insert(emitters, d) end
	end
	local actions = { "hide", "show" }
	if #valid > 0 then
		for i, a in ipairs({ "open", "close", "open reverse" }) do table.insert(actions, i, a) end
	end
	if #lights > 0 then for _, a in ipairs({ "lights off", "lights on", "flicker" }) do table.insert(actions, a) end end
	if #emitters > 0 then for _, a in ipairs({ "particles on", "particles off", "burst" }) do table.insert(actions, a) end end
	for _, a in ipairs(EFFECTS) do table.insert(actions, a) end

	local obj = { label = label, src = src, model = model, root = root, animator = animator, keys = keys or {},
		cache = {}, sounds = {}, anims = anims, promptAnims = promptAnims, soundNames = namesOf(model, isSound),
		movers = valid, lights = lights, emitters = emitters, actions = actions, baseScale = model:GetScale() }
	for _, k in ipairs(obj.keys) do k.scale = k.scale or obj.baseScale end
	table.insert(objects, obj)
	selected, selectedKey = #objects, nil
	refresh()
	for i, name in ipairs(anims) do -- ready now, so Play does not wait: conversions take a while
		status(("%s: preparing animations %d/%d"):format(label, i, #anims))
		loadTrack(obj, name)
	end
	status(label .. " ready")
	return obj
end

local function insert(label, src, keys)
	status("Loading " .. label .. "...")
	local source = fetch(src)
	if not source then
		status("Not found: " .. label)
		return
	end
	local was = source.Archivable
	source.Archivable = true
	local model = source:Clone()
	source.Archivable = was
	if not model then
		status("Cannot copy " .. label)
		return
	end
	if not model:IsA("Model") then
		local holder = Instance.new("Model")
		model.Parent = holder
		model = holder
	end
	setup(model, label, src, keys)
end

local function duplicate(obj)
	for _, m in ipairs(obj.movers) do -- copied closed, then put back
		m.saved, m.open = m.open, 0
		applyMover(obj, m)
	end
	local copy = obj.model:Clone()
	for _, m in ipairs(obj.movers) do
		m.open = m.saved
		applyMover(obj, m)
	end
	task.spawn(setup, copy, obj.label .. "+", obj.src, {}, obj.model:GetPivot() * CFrame.new(4, 0, 0))
end

local function remove(obj)
	if morph and morph.obj == obj then setMorph(nil) end
	stopAnim(obj)
	for _, track in pairs(obj.cache) do
		if track then active[track] = nil end
	end
	obj.model:Destroy()
	table.remove(objects, table.find(objects, obj))
	selected, selectedKey = math.min(selected, #objects), nil
	refresh()
end

---====== PLAYBACK ======---

local function catmull(p0, p1, p2, p3, u)
	return 0.5 * ((2 * p1) + (p2 - p0) * u + (2 * p0 - 5 * p1 + 4 * p2 - p3) * (u * u) + (3 * p1 - p0 - 3 * p2 + p3) * (u * u * u))
end

local function poseAt(keys, t)
	local first, last = keys[1], keys[#keys]
	if t <= first.t then return first.cf, first.scale end
	for i = 1, #keys - 1 do
		local a, b = keys[i], keys[i + 1]
		if t < b.t then
			local u = (t - a.t) / (b.t - a.t)
			if b.ease == "Constant" then return a.cf, a.scale end
			if b.ease == "Smooth" then -- a curve through the keys before and after
				local s = u * u * (3 - 2 * u)
				local position = catmull((keys[i - 1] or a).cf.Position, a.cf.Position, b.cf.Position, (keys[i + 2] or b).cf.Position, u)
				return CFrame.new(position) * a.cf.Rotation:Lerp(b.cf.Rotation, s), a.scale + (b.scale - a.scale) * s
			end
			local alpha = TweenService:GetValue(u, Enum.EasingStyle[b.ease], Enum.EasingDirection[b.dir or "InOut"])
			return a.cf:Lerp(b.cf, alpha), a.scale + (b.scale - a.scale) * alpha
		end
	end
	return last.cf, last.scale
end

local function pose(obj, t)
	if #obj.keys == 0 then return end
	local cf, scale = poseAt(obj.keys, t)
	obj.model:PivotTo(cf)
	if math.abs(obj.model:GetScale() - scale) > 1e-3 then obj.model:ScaleTo(scale) end
end

local function length()
	local total = 0
	for _, tr in ipairs(objects) do
		if #tr.keys > 0 then total = math.max(total, tr.keys[#tr.keys].t) end
	end
	if #cameraTrack.keys > 0 then total = math.max(total, cameraTrack.keys[#cameraTrack.keys].t) end
	return total
end

local RATES = { 1, 0.5, 0.25, 2 }
local rate = 1
local function playTime() return playing.from + (os.clock() - playing.start) * rate end

local function shakeOffset()
	if os.clock() >= shakeUntil then return CFrame.identity end
	return CFrame.Angles((math.random() - 0.5) * 0.03, (math.random() - 0.5) * 0.03, 0)
end

-- While the camera track plays the camera is the script's, as in a DOORS cutscene
local cinema = nil
local function stepCinema()
	if not (cinema and playing) then return end
	local camera = workspace.CurrentCamera
	local cf, fov = poseAt(cameraTrack.keys, playTime())
	camera.CFrame = cf * shakeOffset()
	camera.FieldOfView = fov
end

local function takeCamera()
	if cinema or #cameraTrack.keys == 0 then return end
	local camera = workspace.CurrentCamera
	cinema = { cameraType = camera.CameraType, fov = camera.FieldOfView, stopcam = mainGame and mainGame.stopcam }
	if mainGame then mainGame.stopcam = true end
	camera.CameraType = Enum.CameraType.Scriptable
	RunService:BindToRenderStep("UniversalAssetsCinema", Enum.RenderPriority.Last.Value + 1, stepCinema)
end

local function releaseCamera()
	if not cinema then return end
	RunService:UnbindFromRenderStep("UniversalAssetsCinema")
	local camera = workspace.CurrentCamera
	camera.FieldOfView = cinema.fov
	if not freecam then
		camera.CameraType = cinema.cameraType
		if mainGame then mainGame.stopcam = cinema.stopcam end
	end
	cinema = nil
end

local function stop()
	playing = nil
	releaseCamera()
	for _, obj in ipairs(objects) do
		stopAnim(obj)
		if obj.sound then obj.sound:Stop() end
	end
end

local function fire(tr, k)
	if k.anim and tr.model then playAnim(tr, k.anim, (k.speed or 1) * rate) end
	if k.sound and tr.model then playSound(tr, k.sound) end
	if k.action then doAction(tr, k.action) end
end

-- From the timeline's red line (from the start once it is at the end)
local function play()
	local from = if preview > 0.01 and preview < length() - 0.01 then preview else 0
	stop()
	playing = { start = os.clock(), from = from, last = from - 1e-6 }
	if from > 0 then -- the animation each model had at that moment
		for _, obj in ipairs(objects) do
			local latest = nil
			for _, k in ipairs(obj.keys) do
				if k.anim and k.t <= from then latest = k end
			end
			if latest then playAnim(obj, latest.anim, (latest.speed or 1) * rate) end
		end
	end
	takeCamera()
	status(("Playing from %.2fs at %gx"):format(from, rate))
end

local function stepPlayback()
	if not playing then return end
	local t = playTime()
	for _, tr in ipairs(objects) do
		for _, k in ipairs(tr.keys) do
			if k.t > playing.last and k.t <= t then fire(tr, k) end
		end
		if not (morph and morph.obj == tr) then pose(tr, t) end
	end
	for _, k in ipairs(cameraTrack.keys) do
		if k.t > playing.last and k.t <= t then fire(cameraTrack, k) end
	end
	playing.last, preview = t, t
	drawTimeline()
	if t >= length() then
		if loop and length() > 0 then
			playing = { start = os.clock(), from = 0, last = -1e-6 }
		else
			playing = nil
			releaseCamera()
			status("Done")
		end
	end
end

local function stepMovers(dt)
	for _, obj in ipairs(objects) do
		for _, m in ipairs(obj.movers) do
			if m.open ~= m.target then
				local stepSize = dt / math.max(CONFIG.OpenTime, 0.01)
				m.open = if m.target > m.open then math.min(m.open + stepSize, m.target) else math.max(m.open - stepSize, m.target)
				applyMover(obj, m)
			end
		end
	end
end

---====== UNDO / REDO ======---

local undoStack, redoStack = {}, {}

local function snapshot(tr)
	local keys = {}
	for _, k in ipairs(tr.keys) do table.insert(keys, table.clone(k)) end
	local shot = { track = tr, keys = keys }
	if tr.model then shot.pivot, shot.scale = tr.model:GetPivot(), tr.model:GetScale() end
	return shot
end

-- Before every change: moving, scaling, keys added, changed or deleted
local function remember(tr)
	if not tr then return end
	table.insert(undoStack, snapshot(tr))
	if #undoStack > 80 then table.remove(undoStack, 1) end
	table.clear(redoStack)
end

local function undoRedo(from, to, word)
	local shot = table.remove(from)
	if not shot then
		status("Nothing to " .. word)
		return
	end
	table.insert(to, snapshot(shot.track))
	shot.track.keys = shot.keys
	if shot.pivot and shot.track.model.Parent then
		shot.track.model:PivotTo(shot.pivot)
		shot.track.model:ScaleTo(shot.scale)
	end
	selectedKey = nil
	refresh()
	status(if word == "undo" then "Undone" else "Redone")
end

---====== SAVE / LOAD / COPY (a Lua table in the executor's folder) ======---

local function serialize(v)
	if type(v) == "number" then return string.format("%.17g", v) end
	if type(v) == "string" then return string.format("%q", v) end
	if type(v) ~= "table" then return tostring(v) end
	local parts = {}
	for k, x in pairs(v) do table.insert(parts, "[" .. serialize(k) .. "]=" .. serialize(x)) end
	return "{" .. table.concat(parts, ",") .. "}"
end

local KEY_FIELDS = { "t", "scale", "ease", "dir", "anim", "speed", "sound", "action" }

local function keysOut(keys)
	local out = {}
	for _, k in ipairs(keys) do
		local saved = { cf = { k.cf:GetComponents() } }
		for _, f in ipairs(KEY_FIELDS) do saved[f] = k[f] end
		table.insert(out, saved)
	end
	return out
end

local function keysIn(saved)
	local keys = {}
	for _, k in ipairs(saved or {}) do
		local key = { cf = CFrame.new(table.unpack(k.cf)) }
		for _, f in ipairs(KEY_FIELDS) do key[f] = k[f] end
		table.insert(keys, key)
	end
	return keys
end

local function projectData()
	local project = { loop = loop, objects = {}, camera = keysOut(cameraTrack.keys) }
	for _, obj in ipairs(objects) do
		table.insert(project.objects, { label = obj.label, src = obj.src, keys = keysOut(obj.keys) })
	end
	return project
end

local function writeFile(name, text)
	return pcall(function()
		if not isfolder(CONFIG.Folder) then makefolder(CONFIG.Folder) end
		writefile(CONFIG.Folder .. "/" .. name, text)
	end)
end

local function saveProject(name)
	local ok = writeFile(name .. ".lua", "return " .. serialize(projectData()))
	status(if ok then "Saved " .. name else "Cannot save: your executor has no writefile")
end

local function loadProjectData(project)
	stop()
	if morph then setMorph(nil) end
	while #objects > 0 do remove(objects[1]) end
	loop = project.loop == true
	cameraTrack.keys = keysIn(project.camera)
	for _, saved in ipairs(project.objects or {}) do insert(saved.label, saved.src, keysIn(saved.keys)) end
	refresh()
end

local function loadProject(name)
	local ok, project = pcall(function() return loadstring(readfile(CONFIG.Folder .. "/" .. name .. ".lua"))() end)
	if not ok or type(project) ~= "table" then
		status("Cannot read " .. name)
		return
	end
	loadProjectData(project)
	status("Loaded " .. name)
end

-- A loadstring with the whole scene inside: it builds it again and plays it
local function copyProject(name)
	local text = "_G.UniversalAssets = { Project = " .. serialize(projectData()) .. ", AutoPlay = true }\n"
		.. "loadstring(game:HttpGet(" .. string.format("%q", CONFIG.SelfUrl) .. "))()\n"
	if setclipboard then
		setclipboard(text)
		status("Copied: paste it in the executor and it plays")
	else
		local ok = writeFile(name .. "_play.lua", text)
		status(if ok then "No clipboard: saved " .. name .. "_play.lua" else "Your executor cannot copy or write files")
	end
end

