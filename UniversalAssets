local placing = nil
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local pointer = nil -- on a phone: where the finger last touched
local function mouseRay()
	if pointer then return workspace.CurrentCamera:ScreenPointToRay(pointer.X, pointer.Y) end
	local mouse = UIS:GetMouseLocation()
	return workspace.CurrentCamera:ViewportPointToRay(mouse.X, mouse.Y)
end

local function stepPlacing()
	if not placing then return end
	local ray = mouseRay()
	rayParams.FilterDescendantsInstances = { placing.obj.model, LocalPlayer.Character }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 300, rayParams)
	local spot = if hit then hit.Position else ray.Origin + ray.Direction * 20
	placing.obj.model:PivotTo(CFrame.new(spot + Vector3.new(0, placing.base, 0)) * CFrame.Angles(0, placing.yaw, 0))
end

local function startPlacing()
	local obj = current()
	if not obj then return end
	remember(obj)
	local box, size = obj.model:GetBoundingBox()
	local pivot = obj.model:GetPivot()
	local _, yaw = pivot:ToOrientation()
	placing = { obj = obj, from = pivot, yaw = yaw, base = pivot.Y - (box.Y - size.Y / 2) }
	status(if touchOnly then "Tocca dove va" else "Clicca dove va. R la gira, Esc annulla")
end

