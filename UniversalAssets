local EFFECTS = { "shake", "flash", "say ...", "room flicker", "room lights off", "room lights on", "room shatter" }

local function caption(text)
	local shown = mainGame ~= nil and pcall(mainGame.caption, text, true)
	if not shown then
		pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = "", Text = text, Duration = 4 }) end)
	end
end

-- DOORS' Module_Events (flicker, toggle, shatter) and the room you are in
local function roomEvents()
	local ok, events = pcall(function() return require(game:GetService("ReplicatedStorage").ModulesClient.Module_Events) end)
	local rooms = workspace:FindFirstChild("CurrentRooms")
	local room = rooms and rooms:FindFirstChild(tostring(LocalPlayer:GetAttribute("CurrentRoom") or ""))
	if ok and events and room then return events, room end
	return nil, nil
end

-- true when `action` is one of the effects
local function effect(action)
	local lower = action:lower()
	if lower:sub(1, 4) == "say " then
		caption(action:sub(5))
		return true
	elseif lower == "shake" then
		shakeUntil = os.clock() + 1 -- the free cam and the camera track shake too
		if mainGame and mainGame.camShaker then pcall(function() mainGame.camShaker:ShakeOnce(6, 12, 0, 1.2) end) end
		return true
	elseif lower == "flash" then
		flashFrame.BackgroundTransparency = 0.15
		TweenService:Create(flashFrame, TweenInfo.new(0.7), { BackgroundTransparency = 1 }):Play()
		return true
	end
	local what = lower:match("^room (.+)")
	if not what then return false end
	local events, room = roomEvents()
	if events then
		pcall(function()
			if what == "flicker" then events.flicker(room, 1)
			elseif what == "lights off" then events.toggle(room, false)
			elseif what == "lights on" then events.toggle(room, true, room:GetAttribute("Ambient"))
			elseif what == "shatter" then events.shatter(room) end
		end)
	end
	return true
end

local function doAction(obj, action)
	if effect(action) or not obj.model then return end
	action = action:lower()
	if action == "open" or action == "close" or action == "open reverse" then
		for _, m in ipairs(obj.movers) do
			m.target = if action == "close" then 0 elseif action == "open reverse" and m.hinge then -1 else 1
		end
	elseif action == "lights off" or action == "lights on" then
		for _, light in ipairs(obj.lights) do light.Enabled = action == "lights on" end
	elseif action == "flicker" then
		task.spawn(function()
			for i = 1, 9 do
				for _, light in ipairs(obj.lights) do light.Enabled = i % 2 == 0 end
				task.wait(0.04 + math.random() * 0.1)
			end
		end)
	elseif action == "hide" or action == "show" then
		for _, d in ipairs(obj.model:GetDescendants()) do
			if d:IsA("BasePart") or d:IsA("Decal") then d.LocalTransparencyModifier = if action == "hide" then 1 else 0 end
		end
	elseif action == "particles on" or action == "particles off" then
		for _, e in ipairs(obj.emitters) do e.Enabled = action == "particles on" end
	elseif action == "burst" then
		for _, e in ipairs(obj.emitters) do e:Emit(20) end
	end
end

