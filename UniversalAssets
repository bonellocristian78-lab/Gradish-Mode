local proxy = make("Part", { Name = "UniversalAssetsGizmo", Anchored = true, CanCollide = false, CanTouch = false,
	CanQuery = false, Transparency = 1, Size = Vector3.new(1, 1, 1) }, workspace.CurrentCamera)
local moveHandles = make("Handles", { Style = Enum.HandlesStyle.Movement, Adornee = proxy, Color3 = Color3.fromRGB(255, 160, 60), Visible = false }, hud)
local scaleHandles = make("Handles", { Style = Enum.HandlesStyle.Resize, Adornee = proxy, Color3 = Color3.fromRGB(120, 200, 255), Visible = false }, hud)
local rotateHandles = make("ArcHandles", { Adornee = proxy, Visible = false }, hud)
local drag = nil

local function snap(value, step)
	return if snapOn and step > 0 then math.round(value / step) * step else value
end

local function stepGizmo()
	local obj = current()
	local show = gui.Enabled and obj ~= nil and not placing
	if obj then
		local boxCFrame, size = obj.model:GetBoundingBox()
		proxy.Size = Vector3.new(math.max(size.X, 0.5), math.max(size.Y, 0.5), math.max(size.Z, 0.5))
		proxy.CFrame = if worldSpace then CFrame.new(boxCFrame.Position) else boxCFrame
	end
	moveHandles.Visible = show and tool == "Move"
	scaleHandles.Visible = show and tool == "Scale"
	rotateHandles.Visible = show and tool == "Rotate"
end

local function beginDrag()
	local obj = current()
	if obj then remember(obj) end
	if obj then drag = { obj = obj, pivot = obj.model:GetPivot(), box = proxy.CFrame, size = proxy.Size, scale = obj.model:GetScale() } end
end
local function endDrag() drag = nil end
for _, h in ipairs({ moveHandles, scaleHandles, rotateHandles }) do
	h.MouseButton1Down:Connect(beginDrag)
	h.MouseButton1Up:Connect(endDrag)
end
moveHandles.MouseDrag:Connect(function(face, distance)
	if not drag then return end
	local direction = drag.box:VectorToWorldSpace(Vector3.FromNormalId(face))
	drag.obj.model:PivotTo(drag.pivot + direction * snap(distance, CONFIG.MoveSnap))
end)
rotateHandles.MouseDrag:Connect(function(axis, angle)
	if not drag then return end
	local worldAxis = drag.box:VectorToWorldSpace(Vector3.FromAxis(axis))
	local center = drag.box.Position
	local turn = math.rad(snap(math.deg(angle), CONFIG.RotateSnap))
	drag.obj.model:PivotTo(CFrame.new(center) * CFrame.fromAxisAngle(worldAxis, turn) * CFrame.new(-center) * drag.pivot)
end)
scaleHandles.MouseDrag:Connect(function(face, distance)
	if not drag then return end
	local n = Vector3.FromNormalId(face)
	local along = math.abs(n.X) * drag.size.X + math.abs(n.Y) * drag.size.Y + math.abs(n.Z) * drag.size.Z
	local scale = snap(drag.scale * (along + distance) / along, CONFIG.ScaleSnap)
	drag.obj.model:ScaleTo(math.max(scale, 0.05))
end)

-- Click on a model to select it, as in Studio (not when the click was on a handle)
local function clickSelect()
	task.delay(0.05, function()
		if drag or placing then return end
		local models = {}
		for _, obj in ipairs(objects) do table.insert(models, obj.model) end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = models
		local ray = mouseRay()
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
		if not hit then return end
		for i, obj in ipairs(objects) do
			if hit.Instance:IsDescendantOf(obj.model) and i ~= selected then pick(i) end
		end
	end)
end

