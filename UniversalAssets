local mainGame = nil
pcall(function() mainGame = require(LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game) end)
local mouseWas = nil

local function toggle()
	gui.Enabled = not gui.Enabled
	if mainGame then -- DOORS keeps the mouse locked unless this is on, as in its cutscenes
		if gui.Enabled then mouseWas = mainGame.freemouse end
		mainGame.freemouse = if gui.Enabled then true else mouseWas
	end
	if not gui.Enabled then placing = nil end
end
closeButton.MouseButton1Click:Connect(toggle)

local comboStep, comboAt = 1, 0
on(UIS.InputBegan, function(input, processed)
	local key = input.KeyCode
	if placing then
		if input.UserInputType == Enum.UserInputType.MouseButton1 and not processed then
			placing = nil
			status("Placed. Set a time and press + Key")
		elseif key == Enum.KeyCode.Escape then
			placing.obj.model:PivotTo(placing.from)
			placing = nil
		elseif key == Enum.KeyCode.Q or key == Enum.KeyCode.E then
			placing.yaw += math.rad(if key == Enum.KeyCode.Q then 15 else -15)
		elseif key == Enum.KeyCode.R or key == Enum.KeyCode.F then
			placing.lift += if key == Enum.KeyCode.R then 0.5 else -0.5
		end
	end
	if processed or key == Enum.KeyCode.LeftControl or key == Enum.KeyCode.RightControl or key == Enum.KeyCode.Unknown then return end
	local ctrl = UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)
	if ctrl and key == Enum.KeyCode[CONFIG.PlayKey] then
		if playing then
			stop()
			status("Stopped")
		else
			play()
		end
		comboStep = 1
		return
	end
	if not ctrl or os.clock() - comboAt > CONFIG.ComboTime then comboStep = 1 end
	if ctrl and key == Enum.KeyCode[CONFIG.Combo[comboStep]] then
		comboStep, comboAt = comboStep + 1, os.clock()
		if comboStep > #CONFIG.Combo then
			comboStep = 1
			toggle()
		end
	else
		comboStep = if ctrl and key == Enum.KeyCode[CONFIG.Combo[1]] then 2 else 1
		comboAt = os.clock()
	end
end)

