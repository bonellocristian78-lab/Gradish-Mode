freeCamOn = function() return freecam ~= nil end

local function stepFreeCam(dt)
	local camera = workspace.CurrentCamera
	local look = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
	if not touchOnly then
		UIS.MouseBehavior = if look then Enum.MouseBehavior.LockCurrentPosition else Enum.MouseBehavior.Default
		title.Modal = not look
	end
	if look then
		local delta = UIS:GetMouseDelta()
		freecam.yaw -= math.rad(delta.X * CONFIG.LookSpeed)
		freecam.pitch = math.clamp(freecam.pitch - math.rad(delta.Y * CONFIG.LookSpeed), -1.5, 1.5)
	end
	local rotation = CFrame.fromOrientation(freecam.pitch, freecam.yaw, 0)
	if not UIS:GetFocusedTextBox() then
		local function held(key) return if UIS:IsKeyDown(Enum.KeyCode[key]) or padHeld[key] then 1 else 0 end
		local move = Vector3.new(held("D") - held("A"), held("E") - held("Q"), held("S") - held("W"))
		local speed = CONFIG.FreeCamSpeed * (if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then 0.25 else 1)
		freecam.position += rotation:VectorToWorldSpace(move) * speed * dt
		local zoom = held("X") - held("Z")
		if zoom ~= 0 then camera.FieldOfView = math.clamp(camera.FieldOfView + zoom * 40 * dt, 5, 120) end
	end
	camera.CFrame = CFrame.new(freecam.position) * rotation * shakeOffset()
end

function setFreeCam(on)
	local camera = workspace.CurrentCamera
	if on and not freecam then
		local character = LocalPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local pitch, yaw = camera.CFrame:ToOrientation()
		freecam = { position = camera.CFrame.Position, pitch = pitch, yaw = yaw, cameraType = camera.CameraType,
			root = root, anchored = root and root.Anchored }
		if root then root.Anchored = true end -- WASD flies the camera, not you
		if mainGame then
			freecam.stopcam = mainGame.stopcam
			mainGame.stopcam = true -- DOORS stops drawing its camera, as in its cutscenes
		end
		camera.CameraType = Enum.CameraType.Scriptable
		RunService:BindToRenderStep("UniversalAssetsFreeCam", Enum.RenderPriority.Last.Value, stepFreeCam)
		status("Free cam: WASD, E/Q up/down, Z/X zoom, Shift slow, right mouse")
	elseif not on and freecam then
		RunService:UnbindFromRenderStep("UniversalAssetsFreeCam")
		camera.CameraType = freecam.cameraType
		if freecam.root then freecam.root.Anchored = freecam.anchored == true end
		if mainGame then mainGame.stopcam = freecam.stopcam end
		UIS.MouseBehavior = Enum.MouseBehavior.Default
		title.Modal = true
		freecam = nil
		status("Free cam off")
	end
	refresh()
end

