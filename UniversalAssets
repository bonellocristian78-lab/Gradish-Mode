---====== LOADING ======---

local function fetch(src)
	local id = tonumber(src)
	if id then
		local ok, r = pcall(function() return game:GetObjects("rbxassetid://" .. id)[1] end)
		return ok and r or nil
	end
	if src:match("^https?://") then -- a .rbxm from the internet, like Vynixu's LoadCustomInstance
		local ok, r = pcall(function()
			if not isfolder(CONFIG.Folder) then makefolder(CONFIG.Folder) end
			local file = CONFIG.Folder .. "/download.rbxm"
			writefile(file, game:HttpGet(src))
			return game:GetObjects(getcustomasset(file))[1]
		end)
		return ok and r or nil
	end
	local name = src:match("^Room:(.+)")
	if name then -- the room you are in first, then the others
		local rooms = workspace:FindFirstChild("CurrentRooms")
		if not rooms then return nil end
		local list = rooms:GetChildren()
		local here = rooms:FindFirstChild(tostring(LocalPlayer:GetAttribute("CurrentRoom") or ""))
		if here then table.insert(list, 1, here) end
		for _, room in ipairs(list) do
			local found = room:FindFirstChild(name, true)
			if found and found:IsA("Model") then return found end
		end
		return nil
	end
	local current = game
	for part in src:gmatch("[^%.]+") do current = current and current:FindFirstChild(part) end
	return current
end

local function inFront()
	local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	local base = root and root.CFrame or workspace.CurrentCamera.CFrame
	return base * CFrame.new(0, 0, -8) * CFrame.Angles(0, math.pi, 0)
end

local function namesOf(model, test)
	local names, seen = {}, {}
	for _, d in ipairs(model:GetDescendants()) do
		if test(d) and not seen[d.Name] then
			seen[d.Name] = true
			table.insert(names, d.Name)
		end
	end
	return names
end
local function isAnim(d) return d:IsA("Animation") or d:IsA("KeyframeSequence") end
local function isSound(d) return d:IsA("Sound") end

---====== JOINTS, HINGES AND RAILS ======---

-- Parts held together inside the model: welds, motors, and constraints that do not
-- open anything (the door's knob turns on its own hinge, but goes with the door)
local function jointLinks(model, movers)
	local skip = {}
	for _, m in ipairs(movers) do skip[m.constraint] = true end
	local links = {}
	for _, j in ipairs(model:GetDescendants()) do
		local a, b
		if j:IsA("JointInstance") or j:IsA("WeldConstraint") then
			a, b = j.Part0, j.Part1
		elseif j:IsA("Constraint") and not skip[j] and j.Attachment0 and j.Attachment1 then
			a, b = j.Attachment0.Parent, j.Attachment1.Parent
		end
		if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
			if a:IsDescendantOf(model) and b:IsDescendantOf(model) then
				links[a] = links[a] or {}
				links[b] = links[b] or {}
				table.insert(links[a], b)
				table.insert(links[b], a)
			end
		end
	end
	return links
end

local function groupOf(start, links, avoid)
	local group, queue, i = { [start] = true }, { start }, 1
	while queue[i] do
		for _, other in ipairs(links[queue[i]] or {}) do
			if not group[other] and not (avoid and avoid[other]) then
				group[other] = true
				table.insert(queue, other)
			end
		end
		i += 1
	end
	return group
end

--[[ What opens: a HingeConstraint (DOORS' doors) or a PrismaticConstraint (its drawers).
     The bigger of the two parts moves: the panel, not the hinge; the drawer, not the
     rail. As far as the constraint's limits allow, the way Roblox measures them. ]]
local function findMovers(model)
	local movers = {}
	for _, c in ipairs(model:GetDescendants()) do
		local hinge = c:IsA("HingeConstraint")
		if (hinge or c:IsA("PrismaticConstraint")) and not c.Name:find("Knob") then
			local a0, a1 = c.Attachment0, c.Attachment1
			local p0 = a0 and a0:IsDescendantOf(model) and a0.Parent:IsA("BasePart") and a0.Parent or nil
			local p1 = a1 and a1:IsDescendantOf(model) and a1.Parent:IsA("BasePart") and a1.Parent or nil
			local first = p0 and (not p1 or p0.Size.Magnitude >= p1.Size.Magnitude)
			local moving = if first then p0 else p1
			if moving then
				local amount
				if hinge then
					amount = if not c.LimitsEnabled then 90
						elseif math.abs(c.UpperAngle) >= math.abs(c.LowerAngle) then c.UpperAngle else c.LowerAngle
				else
					amount = if not c.LimitsEnabled then moving.Size.Z * 0.7
						elseif math.abs(c.UpperLimit) >= math.abs(c.LowerLimit) then c.UpperLimit else c.LowerLimit
				end
				table.insert(movers, { constraint = c, hinge = hinge, part = moving, static = if first then p1 else p0,
					att = if p0 then a0 else a1, amount = if first then -amount else amount, open = 0, target = 0 })
			end
		end
	end
	return movers
end

local function applyMover(obj, m)
	local pivot = obj.model:GetPivot()
	local k = obj.model:GetScale() / obj.baseScale
	local eased = math.sign(m.open) * (1 - math.cos(math.pi * math.abs(m.open))) / 2
	local offset
	if m.hinge then
		local point = m.point * k
		offset = CFrame.new(point) * CFrame.fromAxisAngle(m.axis, math.rad(m.amount) * eased) * CFrame.new(-point)
	else
		offset = CFrame.new(m.axis * (m.amount * k * eased))
	end
	for part, rel in pairs(m.rel) do
		part.CFrame = pivot * offset * (CFrame.new(rel.Position * k) * rel.Rotation)
	end
end

---====== ANIMATIONS ======---

local owners = {}
local function ownedHere(id) -- true / false / nil when unknown
	if owners[id] == nil then
		local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, id)
		local creator = ok and info ~= nil and type(info) == "table" and info.Creator
		owners[id] = if creator
			then creator.CreatorTargetId == 1
				or (creator.CreatorTargetId == game.CreatorId and tostring(game.CreatorType):find(creator.CreatorType or "?") ~= nil)
			else "unknown"
	end
	return if owners[id] == "unknown" then nil else owners[id]
end

local function nativeTrack(animator, animation, timeout)
	local ok, track = pcall(animator.LoadAnimation, animator, animation)
	if not ok then return nil end
	local deadline = os.clock() + timeout
	while track.Length == 0 and os.clock() < deadline do task.wait(0.1) end
	if track.Length == 0 then
		track:Destroy()
		return nil
	end
	return track
end

local function sequenceOf(source)
	if source:IsA("KeyframeSequence") then return source end
	local id = tonumber(source.AnimationId:match("%d+") or "")
	if not id then return nil end
	for _, get in ipairs({
		function() return game:GetObjects("rbxassetid://" .. id)[1] end,
		function() return KFSProvider:GetKeyframeSequenceAsync("rbxassetid://" .. id) end,
	}) do
		local ok, kfs = pcall(get)
		if ok and kfs ~= nil and typeof(kfs) == "Instance" and kfs:IsA("KeyframeSequence") then return kfs end
	end
	return nil
end

--[[ Plays a KeyframeSequence by moving the joints itself, like an AnimationTrack.
     The easing of a pose shapes the way to the next one; the old Cubic, Elastic
     and Bounce styles have In and Out swapped, as in Roblox. ]]
local STYLE = { Linear = "Linear", Cubic = "Cubic", CubicV2 = "Cubic", Elastic = "Elastic", Bounce = "Bounce" }
local function sequencePlayer(model, kfs)
	local motors, joints, length = {}, {}, 0
	for _, m in ipairs(model:GetDescendants()) do
		if m:IsA("Motor6D") and m.Part1 then motors[m.Part1.Name] = m end
	end
	local frames = kfs:GetKeyframes()
	table.sort(frames, function(a, b) return a.Time < b.Time end)
	for _, frame in ipairs(frames) do
		length = math.max(length, frame.Time)
		for _, pose in ipairs(frame:GetDescendants()) do
			if pose:IsA("Pose") and pose.Weight > 0 and motors[pose.Name] then
				joints[pose.Name] = joints[pose.Name] or {}
				table.insert(joints[pose.Name], { t = frame.Time, cf = pose.CFrame, style = pose.EasingStyle.Name, dir = pose.EasingDirection.Name })
			end
		end
	end
	local player = { Length = length, Looped = kfs.Loop, IsPlaying = false, time = 0, speed = 1 }
	function player:Play()
		self.time, self.IsPlaying = 0, true
		active[self] = true
	end
	function player:Stop()
		self.IsPlaying, active[self] = false, nil
		for name in pairs(joints) do motors[name].Transform = CFrame.identity end
	end
	function player:AdjustSpeed(speed) self.speed = speed end
	player.Destroy = player.Stop
	function player:step(dt)
		self.time += dt * self.speed
		if self.time >= length then
			if not self.Looped or length <= 0 then
				self:Stop()
				return
			end
			self.time %= length
		end
		for name, list in pairs(joints) do
			local a, b = list[1], nil
			for i = 2, #list do
				if list[i].t <= self.time then a = list[i] else b = list[i] break end
			end
			local cf = a.cf
			if b and a.style ~= "Constant" and self.time > a.t then
				local dir = a.dir
				if a.style ~= "CubicV2" and a.style ~= "Linear" then
					dir = if dir == "In" then "Out" elseif dir == "Out" then "In" else dir
				end
				local alpha = TweenService:GetValue((self.time - a.t) / (b.t - a.t),
					Enum.EasingStyle[STYLE[a.style] or "Linear"], Enum.EasingDirection[dir])
				cf = a.cf:Lerp(b.cf, alpha)
			end
			motors[name].Transform = cf
		end
	end
	return player
end

-- A track for `text`: a name in the model, an Anim_ attribute of a prompt, or an ID
local function loadTrack(obj, text)
	if obj.cache[text] then return obj.cache[text] end
	local source = obj.model:FindFirstChild(text, true)
	if source and not isAnim(source) then source = nil end
	local id = tonumber((obj.promptAnims[text] or text):match("%d+") or "")
	if not source and id then
		source = Instance.new("Animation")
		source.AnimationId = "rbxassetid://" .. id
	end
	if not source then return nil end
	local track
	if source:IsA("Animation") then
		id = tonumber(source.AnimationId:match("%d+") or "")
		if not id or ownedHere(id) ~= false then track = nativeTrack(obj.animator, source, 4) end
	end
	if not track then
		status("Converting " .. text .. ": not owned by this game")
		local kfs = sequenceOf(source)
		if not kfs then
			status(text .. " cannot be converted (private?)")
			return nil
		end
		local ok, temp = pcall(KFSProvider.RegisterKeyframeSequence, KFSProvider, kfs)
		if ok and type(temp) == "string" then
			local animation = Instance.new("Animation")
			animation.AnimationId = temp
			track = nativeTrack(obj.animator, animation, 1.5)
		end
		track = track or sequencePlayer(obj.model, kfs)
	end
	obj.cache[text] = track
	return track
end

local function stopAnim(obj)
	obj.token, obj.animName = nil, nil
	if obj.track then obj.track:Stop(0.2) end
	obj.track = nil
end

-- The same animation as now, still playing: it carries on (only its speed changes)
local function playAnim(obj, text, speed)
	if text:lower() == "stop" then
		stopAnim(obj)
		return
	end
	if obj.animName == text and obj.track and obj.track.IsPlaying then
		obj.track:AdjustSpeed(speed)
		return
	end
	stopAnim(obj)
	local token = {}
	obj.token, obj.animName = token, text
	task.spawn(function()
		local track = loadTrack(obj, text)
		if track and obj.token == token then
			obj.track = track
			track:Play(0.2)
			track:AdjustSpeed(speed)
		end
	end)
end

local function playSound(obj, text)
	if obj.sound then obj.sound:Stop() end
	obj.sound = nil
	if text:lower() == "stop" then return end
	local sound = obj.model:FindFirstChild(text, true)
	if not (sound and sound:IsA("Sound")) then
		local id = tonumber(text:match("%d+") or "")
		if not id then return end
		sound = obj.sounds[id] or Instance.new("Sound")
		sound.SoundId = "rbxassetid://" .. id
		sound.Parent = obj.root
		obj.sounds[id] = sound
	end
	sound.TimePosition = 0
	sound:Play()
	obj.sound = sound
end

local function doAction(obj, action)
	action = action:lower()
	if action == "open" or action == "close" or action == "open reverse" then
		for _, m in ipairs(obj.movers) do
			m.target = if action == "close" then 0 elseif action == "open reverse" and m.hinge then -1 else 1
		end
	elseif action == "lights off" or action == "lights on" then
		for _, light in ipairs(obj.lights) do light.Enabled = action == "lights on" end
	elseif action == "flicker" then
		task.spawn(function()
			for i = 1, 9 do
				for _, light in ipairs(obj.lights) do light.Enabled = i % 2 == 0 end
				task.wait(0.04 + math.random() * 0.1)
			end
		end)
	elseif action == "hide" or action == "show" then
		for _, d in ipairs(obj.model:GetDescendants()) do
			if d:IsA("BasePart") or d:IsA("Decal") then d.LocalTransparencyModifier = if action == "hide" then 1 else 0 end
		end
	end
end

---====== OBJECTS ======---

local function current() return objects[selected] end

local function setup(model, label, src, keys, at)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then d:Destroy() end -- a puppet, not the real thing
	end
	local movers = findMovers(model)
	local moving = {}
	for _, m in ipairs(movers) do moving[m.part] = m end
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart", true)
		or model:FindFirstChild("RootPart", true) or model:FindFirstChildWhichIsA("BasePart", true)
	if root and moving[root] then root = moving[root].static end -- DOORS' door: its root is the panel
	if not root then
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") and not moving[p] then root = p break end
		end
	end
	if not root then
		model:Destroy()
		status(label .. " has no parts")
		return nil
	end
	model.PrimaryPart = root
	-- What is joined to the root moves with it and plays animations; the rest is anchored
	local links = jointLinks(model, movers)
	local body = groupOf(root, links)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = p == root or not body[p], false, false, false
		end
	end
	local animator = model:FindFirstChildWhichIsA("Animator", true)
	if not animator then
		local holder = model:FindFirstChildWhichIsA("Humanoid", true) or model:FindFirstChildWhichIsA("AnimationController", true)
		if not holder then
			holder = Instance.new("AnimationController")
			holder.Parent = model
		end
		animator = Instance.new("Animator")
		animator.Parent = holder
	end
	model:PivotTo(keys and keys[1] and keys[1].cf or at or inFront())
	model.Name = "UCA_" .. label
	model.Parent = workspace

	local pivot = model:GetPivot()
	local valid = {}
	for _, m in ipairs(movers) do
		if not body[m.part] then
			m.rel = {}
			for part in pairs(groupOf(m.part, links, body)) do m.rel[part] = pivot:ToObjectSpace(part.CFrame) end
			m.point = pivot:PointToObjectSpace(m.att.WorldPosition)
			m.axis = pivot:VectorToObjectSpace(m.att.WorldAxis)
			table.insert(valid, m)
		end
	end
	-- The wardrobe's own open / close animations live on its prompt (Anim_EnterModel...)
	local promptAnims, anims = {}, namesOf(model, isAnim)
	for _, prompt in ipairs(model:GetDescendants()) do
		if prompt:IsA("ProximityPrompt") then
			for name, value in pairs(prompt:GetAttributes()) do
				if type(value) == "string" and value:match("^rbxassetid://%d+$") and not promptAnims[name] then
					promptAnims[name] = value
					table.insert(anims, name)
				end
			end
		end
	end
	local lights = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Light") then table.insert(lights, d) end
	end
	local actions = { "hide", "show" }
	if #valid > 0 then
		for i, a in ipairs({ "open", "close", "open reverse" }) do table.insert(actions, i, a) end
	end
	if #lights > 0 then for _, a in ipairs({ "lights off", "lights on", "flicker" }) do table.insert(actions, a) end end

	local obj = { label = label, src = src, model = model, root = root, animator = animator, keys = keys or {},
		cache = {}, sounds = {}, anims = anims, promptAnims = promptAnims, soundNames = namesOf(model, isSound),
		movers = valid, lights = lights, actions = actions, baseScale = model:GetScale() }
	for _, k in ipairs(obj.keys) do k.scale = k.scale or obj.baseScale end
	table.insert(objects, obj)
	selected, selectedKey = #objects, nil
	refresh()
	for i, name in ipairs(anims) do -- ready now, so Play does not wait: conversions take a while
		status(("%s: preparing animations %d/%d"):format(label, i, #anims))
		loadTrack(obj, name)
	end
	status(label .. " ready")
	return obj
end

local function insert(label, src, keys)
	status("Loading " .. label .. "...")
	local source = fetch(src)
	if not source then
		status("Not found: " .. label)
		return
	end
	local was = source.Archivable
	source.Archivable = true
	local model = source:Clone()
	source.Archivable = was
	if not model then
		status("Cannot copy " .. label)
		return
	end
	if not model:IsA("Model") then
		local holder = Instance.new("Model")
		model.Parent = holder
		model = holder
	end
	setup(model, label, src, keys)
end

local function duplicate(obj)
	for _, m in ipairs(obj.movers) do -- copied closed, then put back
		m.saved, m.open = m.open, 0
		applyMover(obj, m)
	end
	local copy = obj.model:Clone()
	for _, m in ipairs(obj.movers) do
		m.open = m.saved
		applyMover(obj, m)
	end
	task.spawn(setup, copy, obj.label .. "+", obj.src, {}, obj.model:GetPivot() * CFrame.new(4, 0, 0))
end

local function remove(obj)
	stopAnim(obj)
	for _, track in pairs(obj.cache) do active[track] = nil end
	obj.model:Destroy()
	table.remove(objects, table.find(objects, obj))
	selected, selectedKey = math.min(selected, #objects), nil
	refresh()
end

---====== PLAYBACK ======---

local function catmull(p0, p1, p2, p3, u)
	return 0.5 * ((2 * p1) + (p2 - p0) * u + (2 * p0 - 5 * p1 + 4 * p2 - p3) * (u * u) + (3 * p1 - p0 - 3 * p2 + p3) * (u * u * u))
end

local function poseAt(keys, t)
	local first, last = keys[1], keys[#keys]
	if t <= first.t then return first.cf, first.scale end
	for i = 1, #keys - 1 do
		local a, b = keys[i], keys[i + 1]
		if t < b.t then
			local u = (t - a.t) / (b.t - a.t)
			if b.ease == "Constant" then return a.cf, a.scale end
			if b.ease == "Smooth" then -- a curve through the keys before and after
				local s = u * u * (3 - 2 * u)
				local position = catmull((keys[i - 1] or a).cf.Position, a.cf.Position, b.cf.Position, (keys[i + 2] or b).cf.Position, u)
				return CFrame.new(position) * a.cf.Rotation:Lerp(b.cf.Rotation, s), a.scale + (b.scale - a.scale) * s
			end
			local alpha = TweenService:GetValue(u, Enum.EasingStyle[b.ease], Enum.EasingDirection[b.dir or "InOut"])
			return a.cf:Lerp(b.cf, alpha), a.scale + (b.scale - a.scale) * alpha
		end
	end
	return last.cf, last.scale
end

local function pose(obj, t)
	if #obj.keys == 0 then return end
	local cf, scale = poseAt(obj.keys, t)
	obj.model:PivotTo(cf)
	if math.abs(obj.model:GetScale() - scale) > 1e-3 then obj.model:ScaleTo(scale) end
end

local function length()
	local total = 0
	for _, obj in ipairs(objects) do
		local keys = obj.keys
		if #keys > 0 then total = math.max(total, keys[#keys].t) end
	end
	return total
end

local function stop()
	playing = nil
	for _, obj in ipairs(objects) do
		stopAnim(obj)
		if obj.sound then obj.sound:Stop() end
	end
end

local function play()
	stop()
	playing = { start = os.clock(), last = -1 }
	status("Playing")
end

local function stepPlayback()
	if not playing then return end
	local t = os.clock() - playing.start
	for _, obj in ipairs(objects) do
		for _, k in ipairs(obj.keys) do
			if k.t > playing.last and k.t <= t then
				if k.anim then playAnim(obj, k.anim, k.speed or 1) end
				if k.sound then playSound(obj, k.sound) end
				if k.action then doAction(obj, k.action) end
			end
		end
		pose(obj, t)
	end
	playing.last, preview = t, t
	drawTimeline()
	if t >= length() then
		if loop and length() > 0 then
			playing = { start = os.clock(), last = -1 }
		else
			playing = nil
			status("Done")
		end
	end
end

local function stepMovers(dt)
	for _, obj in ipairs(objects) do
		for _, m in ipairs(obj.movers) do
			if m.open ~= m.target then
				local stepSize = dt / math.max(CONFIG.OpenTime, 0.01)
				m.open = if m.target > m.open then math.min(m.open + stepSize, m.target) else math.max(m.open - stepSize, m.target)
				applyMover(obj, m)
			end
		end
	end
end

---====== SAVE / LOAD (a Lua table in the executor's folder) ======---

local function serialize(v)
	if type(v) == "number" then return string.format("%.17g", v) end
	if type(v) == "string" then return string.format("%q", v) end
	if type(v) ~= "table" then return tostring(v) end
	local parts = {}
	for k, x in pairs(v) do table.insert(parts, "[" .. serialize(k) .. "]=" .. serialize(x)) end
	return "{" .. table.concat(parts, ",") .. "}"
end

local KEY_FIELDS = { "t", "scale", "ease", "dir", "anim", "speed", "sound", "action" }

local function saveProject(name)
	local project = { loop = loop, objects = {} }
	for _, obj in ipairs(objects) do
		local keys = {}
		for _, k in ipairs(obj.keys) do
			local saved = { cf = { k.cf:GetComponents() } }
			for _, f in ipairs(KEY_FIELDS) do saved[f] = k[f] end
			table.insert(keys, saved)
		end
		table.insert(project.objects, { label = obj.label, src = obj.src, keys = keys })
	end
	local ok = pcall(function()
		if not isfolder(CONFIG.Folder) then makefolder(CONFIG.Folder) end
		writefile(CONFIG.Folder .. "/" .. name .. ".lua", "return " .. serialize(project))
	end)
	status(if ok then "Saved " .. name else "Cannot save: your executor has no writefile")
end

local function loadProject(name)
	local ok, project = pcall(function() return loadstring(readfile(CONFIG.Folder .. "/" .. name .. ".lua"))() end)
	if not ok or type(project) ~= "table" then
		status("Cannot read " .. name)
		return
	end
	stop()
	while #objects > 0 do remove(objects[1]) end
	loop = project.loop == true
	for _, saved in ipairs(project.objects) do
		local keys = {}
		for _, k in ipairs(saved.keys) do
			local key = { cf = CFrame.new(table.unpack(k.cf)) }
			for _, f in ipairs(KEY_FIELDS) do key[f] = k[f] end
			table.insert(keys, key)
		end
		insert(saved.label, saved.src, keys)
	end
	status("Loaded " .. name)
end

