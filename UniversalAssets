---====== MORPH: the selected model becomes your body ======---

local function showBody(visible)
	local character = LocalPlayer.Character
	if not character then return end
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then d.LocalTransparencyModifier = if visible then 0 else 1 end
	end
end

function setMorph(obj)
	if morph then
		stopAnim(morph.obj)
		morph = nil
		showBody(true)
	end
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if obj and root and humanoid then
		local box, size = obj.model:GetBoundingBox()
		local body, bodySize = character:GetBoundingBox()
		morph = { obj = obj, root = root, humanoid = humanoid, character = character,
			lift = (obj.model:GetPivot().Y - (box.Y - size.Y / 2)) - (root.Position.Y - (body.Y - bodySize.Y / 2)),
			idle = animNamed(obj, IDLE_WORDS), walk = animNamed(obj, WALK_WORDS) }
		status("Ora sei " .. obj.label .. ". Diventa lui di nuovo per tornare te")
	end
	refresh()
end

local function stepMorph()
	local m = morph
	if not m then return end
	if not (m.obj.model.Parent and m.root.Parent) then
		setMorph(nil)
		return
	end
	local look = m.root.CFrame.LookVector * Vector3.new(1, 0, 1)
	if look.Magnitude < 1e-3 then look = Vector3.new(0, 0, -1) end
	m.obj.model:PivotTo(CFrame.lookAt(m.root.Position, m.root.Position + look) + Vector3.new(0, m.lift, 0))
	showBody(false) -- every frame: the game may show the body again
	local anim = if m.humanoid.MoveDirection.Magnitude > 0.1 then m.walk or m.idle else m.idle
	if anim then playAnim(m.obj, anim, 1) end
end

