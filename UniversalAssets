moveHandles.MouseDrag:Connect(function(face, distance)
	if not drag then return end
	local direction = drag.box:VectorToWorldSpace(Vector3.FromNormalId(face))
	drag.obj.model:PivotTo(drag.pivot + direction * snap(distance, CONFIG.MoveSnap))
end)
rotateHandles.MouseDrag:Connect(function(axis, angle)
	if not drag then return end
	local worldAxis = drag.box:VectorToWorldSpace(Vector3.FromAxis(axis))
	local center = drag.box.Position
	local turn = math.rad(snap(math.deg(angle), CONFIG.RotateSnap))
	drag.obj.model:PivotTo(CFrame.new(center) * CFrame.fromAxisAngle(worldAxis, turn) * CFrame.new(-center) * drag.pivot)
end)
scaleHandles.MouseDrag:Connect(function(face, distance)
	if not drag then return end
	local n = Vector3.FromNormalId(face)
	local along = math.abs(n.X) * drag.size.X + math.abs(n.Y) * drag.size.Y + math.abs(n.Z) * drag.size.Z
	local scale = snap(drag.scale * (along + distance) / along, CONFIG.ScaleSnap)
	drag.obj.model:ScaleTo(math.max(scale, 0.05))
end)

