local function clickSelect()
	task.delay(0.05, function()
		if drag or placing then return end
		local models = {}
		for _, obj in ipairs(objects) do table.insert(models, obj.model) end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = models
		local ray = mouseRay()
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
		if not hit then return end
		for i, obj in ipairs(objects) do
			if hit.Instance:IsDescendantOf(obj.model) and i ~= selected then pick(i) end
		end
	end)
end

