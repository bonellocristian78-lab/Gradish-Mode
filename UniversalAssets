---====== LOADING ======---

local function fetch(src)
	local id = tonumber(src)
	if id then
		local ok, r = pcall(function() return game:GetObjects("rbxassetid://" .. id)[1] end)
		return ok and r or nil
	end
	if src:match("^https?://") then -- a .rbxm from the internet, like Vynixu's LoadCustomInstance
		local ok, r = pcall(function()
			if not isfolder(CONFIG.Folder) then makefolder(CONFIG.Folder) end
			local file = CONFIG.Folder .. "/download.rbxm"
			writefile(file, game:HttpGet(src))
			return game:GetObjects(getcustomasset(file))[1]
		end)
		return ok and r or nil
	end
	local name = src:match("^Room:(.+)")
	if name then -- the room you are in first, then the others
		local rooms = workspace:FindFirstChild("CurrentRooms")
		if not rooms then return nil end
		local list = rooms:GetChildren()
		local here = rooms:FindFirstChild(tostring(LocalPlayer:GetAttribute("CurrentRoom") or ""))
		if here then table.insert(list, 1, here) end
		for _, room in ipairs(list) do
			local found = room:FindFirstChild(name, true)
			if found and found:IsA("Model") then return found end
		end
		return nil
	end
	local current = game
	for part in src:gmatch("[^%.]+") do current = current and current:FindFirstChild(part) end
	return current
end

local function inFront()
	local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	local base = root and root.CFrame or workspace.CurrentCamera.CFrame
	return base * CFrame.new(0, 0, -8) * CFrame.Angles(0, math.pi, 0)
end

local function namesOf(model, test)
	local names, seen = {}, {}
	for _, d in ipairs(model:GetDescendants()) do
		if test(d) and not seen[d.Name] then
			seen[d.Name] = true
			table.insert(names, d.Name)
		end
	end
	return names
end
local function isAnim(d) return d:IsA("Animation") or d:IsA("KeyframeSequence") end
local function isSound(d) return d:IsA("Sound") end

---====== JOINTS, HINGES AND RAILS ======---

-- Parts held together inside the model: welds, motors, and constraints that do not
-- open anything (the door's knob turns on its own hinge, but goes with the door)
local function jointLinks(model, movers)
	local skip = {}
	for _, m in ipairs(movers) do skip[m.constraint] = true end
	local links = {}
	for _, j in ipairs(model:GetDescendants()) do
		local a, b
		if j:IsA("JointInstance") or j:IsA("WeldConstraint") then
			a, b = j.Part0, j.Part1
		elseif j:IsA("Constraint") and not skip[j] and j.Attachment0 and j.Attachment1 then
			a, b = j.Attachment0.Parent, j.Attachment1.Parent
		end
		if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
			if a:IsDescendantOf(model) and b:IsDescendantOf(model) then
				links[a] = links[a] or {}
				links[b] = links[b] or {}
				table.insert(links[a], b)
				table.insert(links[b], a)
			end
		end
	end
	return links
end

local function groupOf(start, links, avoid)
	local group, queue, i = { [start] = true }, { start }, 1
	while queue[i] do
		for _, other in ipairs(links[queue[i]] or {}) do
			if not group[other] and not (avoid and avoid[other]) then
				group[other] = true
				table.insert(queue, other)
			end
		end
		i += 1
	end
	return group
end

--[[ What opens: a HingeConstraint (DOORS' doors) or a PrismaticConstraint (its drawers).
     The bigger of the two parts moves: the panel, not the hinge; the drawer, not the
     rail. As far as the constraint's limits allow, the way Roblox measures them. ]]
local function findMovers(model)
	local movers = {}
	for _, c in ipairs(model:GetDescendants()) do
		local hinge = c:IsA("HingeConstraint")
		if (hinge or c:IsA("PrismaticConstraint")) and not c.Name:find("Knob") then
			local a0, a1 = c.Attachment0, c.Attachment1
			local p0 = a0 and a0:IsDescendantOf(model) and a0.Parent:IsA("BasePart") and a0.Parent or nil
			local p1 = a1 and a1:IsDescendantOf(model) and a1.Parent:IsA("BasePart") and a1.Parent or nil
			local first = p0 and (not p1 or p0.Size.Magnitude >= p1.Size.Magnitude)
			local moving = if first then p0 else p1
			if moving then
				local amount
				if hinge then
					amount = if not c.LimitsEnabled then 90
						elseif math.abs(c.UpperAngle) >= math.abs(c.LowerAngle) then c.UpperAngle else c.LowerAngle
				else
					amount = if not c.LimitsEnabled then moving.Size.Z * 0.7
						elseif math.abs(c.UpperLimit) >= math.abs(c.LowerLimit) then c.UpperLimit else c.LowerLimit
				end
				table.insert(movers, { constraint = c, hinge = hinge, part = moving, static = if first then p1 else p0,
					att = if p0 then a0 else a1, amount = if first then -amount else amount, open = 0, target = 0 })
			end
		end
	end
	return movers
end

local function applyMover(obj, m)
	local pivot = obj.model:GetPivot()
	local k = obj.model:GetScale() / obj.baseScale
	local eased = math.sign(m.open) * (1 - math.cos(math.pi * math.abs(m.open))) / 2
	local offset
	if m.hinge then
		local point = m.point * k
		offset = CFrame.new(point) * CFrame.fromAxisAngle(m.axis, math.rad(m.amount) * eased) * CFrame.new(-point)
	else
		offset = CFrame.new(m.axis * (m.amount * k * eased))
	end
	for part, rel in pairs(m.rel) do
		part.CFrame = pivot * offset * (CFrame.new(rel.Position * k) * rel.Rotation)
	end
end

---====== ANIMATIONS ======---

local loadTrack
do
	local owners = {}
	local function ownedHere(id) -- true / false / nil when unknown
		if owners[id] == nil then
			local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, id)
			local creator = ok and info ~= nil and type(info) == "table" and info.Creator
			owners[id] = if creator
				then creator.CreatorTargetId == 1
					or (creator.CreatorTargetId == game.CreatorId and tostring(game.CreatorType):find(creator.CreatorType or "?") ~= nil)
				else "unknown"
		end
		return if owners[id] == "unknown" then nil else owners[id]
	end

	local function nativeTrack(animator, animation, timeout)
		local ok, track = pcall(animator.LoadAnimation, animator, animation)
		if not ok then return nil end
		local deadline = os.clock() + timeout
		while track.Length == 0 and os.clock() < deadline do task.wait(0.1) end
		if track.Length == 0 then
			track:Destroy()
			return nil
		end
		return track
	end

	local function sequenceOf(source)
		if source:IsA("KeyframeSequence") then return source end
		local id = tonumber(source.AnimationId:match("%d+") or "")
		if not id then return nil end
		for _, get in ipairs({
			function() return game:GetObjects("rbxassetid://" .. id)[1] end,
			function() return KFSProvider:GetKeyframeSequenceAsync("rbxassetid://" .. id) end,
		}) do
			local ok, kfs = pcall(get)
			if ok and kfs ~= nil and typeof(kfs) == "Instance" and kfs:IsA("KeyframeSequence") then return kfs end
		end
		return nil
	end

	--[[ Plays a KeyframeSequence by moving the joints itself, like an AnimationTrack.
	     The easing of a pose shapes the way to the next one; the old Cubic, Elastic
	     and Bounce styles have In and Out swapped, as in Roblox. ]]
	local STYLE = { Linear = "Linear", Cubic = "Cubic", CubicV2 = "Cubic", Elastic = "Elastic", Bounce = "Bounce" }
	local function sequencePlayer(model, kfs)
		local motors, joints, length = {}, {}, 0
		for _, m in ipairs(model:GetDescendants()) do
			if m:IsA("Motor6D") and m.Part1 then motors[m.Part1.Name] = m end
		end
		local frames = kfs:GetKeyframes()
		table.sort(frames, function(a, b) return a.Time < b.Time end)
		for _, frame in ipairs(frames) do
			length = math.max(length, frame.Time)
			for _, pose in ipairs(frame:GetDescendants()) do
				if pose:IsA("Pose") and pose.Weight > 0 and motors[pose.Name] then
					joints[pose.Name] = joints[pose.Name] or {}
					table.insert(joints[pose.Name], { t = frame.Time, cf = pose.CFrame, style = pose.EasingStyle.Name, dir = pose.EasingDirection.Name })
				end
			end
		end
		local player = { Length = length, Looped = kfs.Loop, IsPlaying = false, time = 0, speed = 1 }
		function player:Play()
			self.time, self.IsPlaying = 0, true
			active[self] = true
		end
		function player:Stop()
			self.IsPlaying, active[self] = false, nil
			for name in pairs(joints) do motors[name].Transform = CFrame.identity end
		end
		function player:AdjustSpeed(speed) self.speed = speed end
		player.Destroy = player.Stop
		function player:step(dt)
			self.time += dt * self.speed
			if self.time >= length then
				if not self.Looped or length <= 0 then
					self:Stop()
					return
				end
				self.time %= length
			end
			for name, list in pairs(joints) do
				local a, b = list[1], nil
				for i = 2, #list do
					if list[i].t <= self.time then a = list[i] else b = list[i] break end
				end
				local cf = a.cf
				if b and a.style ~= "Constant" and self.time > a.t then
					local dir = a.dir
					if a.style ~= "CubicV2" and a.style ~= "Linear" then
						dir = if dir == "In" then "Out" elseif dir == "Out" then "In" else dir
					end
					local alpha = TweenService:GetValue((self.time - a.t) / (b.t - a.t),
						Enum.EasingStyle[STYLE[a.style] or "Linear"], Enum.EasingDirection[dir])
					cf = a.cf:Lerp(b.cf, alpha)
				end
				motors[name].Transform = cf
			end
		end
		return player
	end

	-- A track for `text`: a name in the model, an Anim_ attribute of a prompt, or an ID
	function loadTrack(obj, text)
		if obj.cache[text] ~= nil then return obj.cache[text] or nil end -- false: it failed once, not again
		local source = obj.model:FindFirstChild(text, true)
		if source and not isAnim(source) then source = nil end
		local id = tonumber((obj.promptAnims[text] or text):match("%d+") or "")
		if not source and id then
			source = Instance.new("Animation")
			source.AnimationId = "rbxassetid://" .. id
		end
		if not source then
			obj.cache[text] = false
			return nil
		end
		local track
		if source:IsA("Animation") then
			id = tonumber(source.AnimationId:match("%d+") or "")
			if not id or ownedHere(id) ~= false then track = nativeTrack(obj.animator, source, 4) end
		end
		if not track then
			status("Converto " .. text .. ": non è di questo gioco")
			local kfs = sequenceOf(source)
			if not kfs then
				status(text .. ": non si può convertire (privata?)")
				obj.cache[text] = false
				return nil
			end
			local ok, temp = pcall(KFSProvider.RegisterKeyframeSequence, KFSProvider, kfs)
			if ok and type(temp) == "string" then
				local animation = Instance.new("Animation")
				animation.AnimationId = temp
				track = nativeTrack(obj.animator, animation, 1.5)
			end
			track = track or sequencePlayer(obj.model, kfs)
		end
		obj.cache[text] = track
		return track
	end
end

-- The first of the model's animations whose name has one of these words
local function animNamed(obj, words)
	for _, name in ipairs(obj.anims) do
		for _, w in ipairs(words) do
			if name:lower():find(w) then return name end
		end
	end
	return nil
end
local WALK_WORDS, IDLE_WORDS = { "run", "walk", "move", "chase" }, { "idle" }

local function stopAnim(obj)
	obj.token, obj.animName = nil, nil
	if obj.track then obj.track:Stop(0.2) end
	obj.track = nil
end

-- The same animation as now, still playing: it carries on (only its speed changes)
local function playAnim(obj, text, speed)
	if text:lower() == "stop" then
		stopAnim(obj)
		return
	end
	if obj.animName == text and obj.track and obj.track.IsPlaying then
		obj.track:AdjustSpeed(speed)
		return
	end
	stopAnim(obj)
	local token = {}
	obj.token, obj.animName = token, text
	task.spawn(function()
		local track = loadTrack(obj, text)
		if track and obj.token == token then
			obj.track = track
			track:Play(0.2)
			track:AdjustSpeed(speed)
		end
	end)
end

local function playSound(obj, text)
	if obj.sound then obj.sound:Stop() end
	obj.sound = nil
	if text:lower() == "stop" then return end
	local sound = obj.model:FindFirstChild(text, true)
	if not (sound and sound:IsA("Sound")) then
		local id = tonumber(text:match("%d+") or "")
		if not id then return end
		sound = obj.sounds[id] or Instance.new("Sound")
		sound.SoundId = "rbxassetid://" .. id
		sound.Parent = obj.root
		obj.sounds[id] = sound
	end
	sound.TimePosition = 0
	sound:Play()
	obj.sound = sound
end

