---====== KEYS AND MOUSE ======---

local function toggle()
	gui.Enabled = not gui.Enabled
	if mainGame then -- DOORS keeps the mouse locked unless this is on, as in its cutscenes
		if gui.Enabled then mouseWas = mainGame.freemouse end
		mainGame.freemouse = if gui.Enabled then true else mouseWas
	end
	if not gui.Enabled then placing, drag = nil, nil end
end
closeButton.MouseButton1Click:Connect(toggle)

local comboStep, comboAt = 1, 0
on(UIS.InputBegan, function(input, processed)
	local key, kind = input.KeyCode, input.UserInputType
	if placing then
		if kind == Enum.UserInputType.MouseButton1 and not processed then
			placing = nil
			status("Placed. Set a time and press + Key")
			return
		elseif key == Enum.KeyCode.Escape then
			placing.obj.model:PivotTo(placing.from)
			placing = nil
		elseif key == Enum.KeyCode.R then
			placing.yaw += math.rad(15)
		end
	end
	if gui.Enabled and not processed then
		if kind == Enum.UserInputType.MouseButton1 then clickSelect() end
		-- Right mouse: DOORS takes the mouse back while it is held, so the camera turns
		if kind == Enum.UserInputType.MouseButton2 and not freecam then
			title.Modal = false
			if mainGame then mainGame.freemouse = mouseWas end
		end
	end
	if processed or key == Enum.KeyCode.LeftControl or key == Enum.KeyCode.RightControl or key == Enum.KeyCode.Unknown then return end
	local ctrl = UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)
	if ctrl and key == Enum.KeyCode[CONFIG.PlayKey] then
		if playing then
			stop()
			status("Stopped")
		else
			play()
		end
		comboStep = 1
		return
	end
	if ctrl and key == Enum.KeyCode[CONFIG.FreeCamKey] then
		setFreeCam(not freecam)
		comboStep = 1
		return
	end
	if ctrl and gui.Enabled then
		for i, name in ipairs(TOOLS) do
			if key == Enum.KeyCode[({ "One", "Two", "Three", "Four" })[i]] then
				tool = name
				refresh()
				return
			end
		end
	end
	if not ctrl or os.clock() - comboAt > CONFIG.ComboTime then comboStep = 1 end
	if ctrl and key == Enum.KeyCode[CONFIG.Combo[comboStep]] then
		comboStep, comboAt = comboStep + 1, os.clock()
		if comboStep > #CONFIG.Combo then
			comboStep = 1
			toggle()
		end
	else
		comboStep = if ctrl and key == Enum.KeyCode[CONFIG.Combo[1]] then 2 else 1
		comboAt = os.clock()
	end
end)
on(UIS.InputChanged, function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		if dragging then
			local d = input.Position - dragging.from
			panel.Position = dragging.start + UDim2.fromOffset(d.X, d.Y)
		end
		if scrubbing then scrub(input.Position.X) end
	elseif input.UserInputType == Enum.UserInputType.MouseWheel and freecam and not UIS:GetFocusedTextBox() then
		local rotation = CFrame.fromOrientation(freecam.pitch, freecam.yaw, 0)
		freecam.position += rotation.LookVector * (input.Position.Z * 4)
	end
end)
on(UIS.InputEnded, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging, scrubbing = nil, false
		endDrag()
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 and not freecam then
		title.Modal = true
		if mainGame and gui.Enabled then mainGame.freemouse = true end
	end
end)

on(RunService.RenderStepped, function(dt)
	stepPlacing()
	stepPlayback()
	stepMovers(dt)
	stepGizmo()
end)
-- Our own players write the joints after Roblox's animations, before physics
on(RunService.PreSimulation or RunService.Stepped, function(a, b)
	local dt = if type(b) == "number" then b else a
	for player in pairs(active) do player:step(dt) end
end)

if getgenv then
	getgenv().__UniversalAssetsCleanup = function()
		stop()
		setFreeCam(false)
		for _, c in ipairs(connections) do c:Disconnect() end
		for _, obj in ipairs(objects) do obj.model:Destroy() end
		if mainGame and gui.Enabled then mainGame.freemouse = mouseWas end
		for _, i in ipairs({ gui, proxy, moveHandles, scaleHandles, rotateHandles }) do i:Destroy() end
	end
end
