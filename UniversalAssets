	hint("Metti la cosa dove parte e premi 1. Spostala dove arriva e premi 2: ci va in quei secondi. Ancora 2 = un altro tratto.", 4, 40)
	header("MOVIMENTO FACILE", 46)
	label("in", 320, 68, 18)
	local quickBox = box("QuickTime", "s", 338, 68, 44)
	quickBox.Text = "3"
	label("s", 388, 68, 20)

	-- A Linear key where the thing (or the camera) is now
	local function quickKey(tr, t)
		local camera = workspace.CurrentCamera
		local k = { t = t, ease = "Linear", dir = "InOut", speed = 1 }
		if tr.isCamera then
			k.cf, k.scale = camera.CFrame, camera.FieldOfView
		else
			k.cf, k.scale = tr.model:GetPivot(), tr.model:GetScale()
		end
		return k
	end
	primary(button("QuickStart", "1. Parte da qui", 10, 68, 150, function()
		local tr = editing()
		if tr.isCamera and not freecam then setFreeCam(true) end
		remember(tr)
		selectedKey, preview = quickKey(tr, 0), 0
		tr.keys = { selectedKey } -- it starts again from here (Annulla gives the old keys back)
		refresh()
		status(if tr.isCamera then "Partenza messa. Muovi la telecamera dove arriva e premi 2"
			else "Partenza messa. Ora trascina le frecce fin dove arriva e premi 2")
	end))
	primary(button("QuickEnd", "2. Arriva qui", 164, 68, 150, function()
		local tr = editing()
		local last = tr.keys[#tr.keys]
		if not last then
			status("Prima la partenza: mettila dove parte e premi 1")
			return
		end
		remember(tr)
		local k = quickKey(tr, last.t + math.max(tonumber(quickBox.Text) or 3, 0.1))
		-- A creature looks where it goes and runs with its own animation (Corsa auto)
		local way = (k.cf.Position - last.cf.Position) * Vector3.new(1, 0, 1)
		local runs = not tr.isCamera and animNamed(tr, WALK_WORDS) ~= nil and way.Magnitude > 0.5
		if runs then
			local function facing(cf) return CFrame.lookAt(cf.Position, cf.Position + way) end
			k.cf = facing(k.cf)
			if #tr.keys == 1 then last.cf = facing(last.cf) end
			tr.model:PivotTo(k.cf)
			tr.auto = true
		end
		table.insert(tr.keys, k)
		selectedKey, preview = k, k.t
		refresh()
		status(("Arriva a %g s%s. Play per vederla, o spostala ancora e premi 2"):format(k.t, if runs then " correndo" else ""))
	end))
	local autoButton = button("Auto", "", 10, 100, 198, function()
		local obj = current()
		if not obj then return end
		obj.auto = not obj.auto
		stopAnim(obj)
		local walk, idle = animNamed(obj, WALK_WORDS), animNamed(obj, IDLE_WORDS)
		status(if not obj.auto then "Corsa auto spenta: valgono le animazioni delle chiavi"
			elseif walk then "Corsa auto: " .. walk .. " mentre si muove" .. (if idle then ", " .. idle .. " da fermo" else "")
			else "Corsa auto: questo modello non ha animazioni run / walk")
		refresh()
	end)
	local pathOn = true
	local pathButton = button("Path", "", 212, 100, 198, function() pathOn = not pathOn; refresh() end)

	header("CHIAVI: CONTROLLO COMPLETO", 136)
	-- A box plus a > button that cycles through what the model has
	local function cycler(name, text, y, w, listOf)
		label(text, 10, y, 56).TextSize = 16
		local b = box(name, "nome, ID o stop", 66, y, w)
		button(name .. "Next", ">", 70 + w, y, 30, function()
			local list = listOf(editing())
			if #list == 0 then return end
			b.Text = list[(table.find(list, b.Text) or 0) % #list + 1]
		end)
		return b
	end
	label("Tempo", 10, 158, 50).TextSize = 16
	timeBox = box("Time", "s", 60, 158, 56)
	timeBox.Text = "0"
	local ease, dir = 1, 1
	local easeButton, dirButton
	easeButton = button("Ease", CONFIG.Eases[ease], 120, 158, 146, function()
		ease = ease % #CONFIG.Eases + 1
		easeButton.Text = CONFIG.Eases[ease]
	end)
	dirButton = button("Dir", CONFIG.Directions[dir], 270, 158, 140, function()
		dir = dir % #CONFIG.Directions + 1
		dirButton.Text = CONFIG.Directions[dir]
	end)
	local animBox = cycler("Anim", "Anim", 190, 220, function(o) return o.anims end)
	label("vel.", 324, 190, 36).TextSize = 16
	local speedBox = box("Speed", "1", 360, 190, 50)
	speedBox.Text = "1"
	local soundBox = cycler("Sound", "Suono", 222, 310, function(o) return o.soundNames end)
	local actionBox = cycler("Action", "Azione", 254, 310, function(o) return o.actions end)
	actionBox.PlaceholderText = "open, close, lights off, hide, shake..."

	local function fromFields(k)
		local obj = editing()
		k.t = math.max(tonumber(timeBox.Text) or 0, 0)
		if obj.isCamera then -- where the camera is, and its zoom
			k.cf, k.scale = workspace.CurrentCamera.CFrame, workspace.CurrentCamera.FieldOfView
		else
			k.cf, k.scale = obj.model:GetPivot(), obj.model:GetScale()
		end
		k.ease, k.dir = CONFIG.Eases[ease], CONFIG.Directions[dir]
		k.anim = if animBox.Text ~= "" then animBox.Text else nil
		k.speed = tonumber(speedBox.Text) or 1
		k.sound = if soundBox.Text ~= "" then soundBox.Text else nil
		k.action = if actionBox.Text ~= "" then actionBox.Text else nil
		table.sort(obj.keys, function(a, b) return a.t < b.t end)
		refresh()
	end

	local function goTo(tr, k)
		if tr.isCamera then
			setFreeCam(true)
			local pitch, yaw = k.cf:ToOrientation()
			freecam.position, freecam.pitch, freecam.yaw = k.cf.Position, pitch, yaw
			workspace.CurrentCamera.FieldOfView = k.scale
		else
			tr.model:PivotTo(k.cf)
			tr.model:ScaleTo(k.scale)
		end
	end

	button("AddKey", "+ Chiave", 10, 286, 97, function()
		local obj = editing()
		remember(obj)
		local t = math.max(tonumber(timeBox.Text) or 0, 0)
		local k
		for _, other in ipairs(obj.keys) do
			if math.abs(other.t - t) < 1e-3 then k = other end -- same time: replaced
		end
		if not k then
			k = {}
			table.insert(obj.keys, k)
		end
		selectedKey = k
		fromFields(k)
		timeBox.Text = tostring(t + 1)
	end)
	button("Update", "Aggiorna", 111, 286, 97, function()
		if selectedKey then
			remember(editing())
			fromFields(selectedKey)
		end
	end)
	button("Delete", "Elimina", 212, 286, 97, function()
		local obj = editing()
		if selectedKey and table.find(obj.keys, selectedKey) then
			remember(obj)
			table.remove(obj.keys, table.find(obj.keys, selectedKey))
			selectedKey = nil
			refresh()
		end
	end)
	button("Go", "Vai", 313, 286, 97, function()
		if selectedKey then
			remember(editing())
			goTo(editing(), selectedKey)
		end
	end)

	local list = make("ScrollingFrame", { Name = "Keys", Position = UDim2.fromOffset(10, 318), Size = UDim2.fromOffset(400, 124),
		BackgroundColor3 = FIELD, BorderSizePixel = 0, ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new() }, into)
	make("UIListLayout", { Padding = UDim.new(0, 2) }, list)

	local function keyText(k, isCamera)
		local parts = { ("%5.2fs  %s %s"):format(k.t, k.ease, k.dir or "InOut") }
		if k.anim then table.insert(parts, "anim " .. k.anim .. (if (k.speed or 1) ~= 1 then " x" .. k.speed else "")) end
		if k.sound then table.insert(parts, "suono " .. k.sound) end
		if k.action then table.insert(parts, k.action) end
		if isCamera then
			table.insert(parts, ("zoom %d"):format(math.floor(k.scale + 0.5)))
		elseif math.abs((k.scale or 1) - 1) > 1e-3 then
			table.insert(parts, ("scala %.2f"):format(k.scale))
		end
		return table.concat(parts, "  ")
	end

	-- The selected thing's way in the world, with the panel open: red dots, a numbered one on each key
	local function dot(position, size, color)
		return make("Part", { Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), CFrame = CFrame.new(position),
			Material = Enum.Material.Neon, Color = color, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
			CastShadow = false }, pathFolder)
	end
	local function drawPath(tr)
		pathFolder:ClearAllChildren()
		local keys = tr.keys
		pathFolder.Parent = if pathOn and gui.Enabled and #keys > 0 then workspace.CurrentCamera else nil
		if not pathFolder.Parent then return end
		local from, to = keys[1].t, keys[#keys].t
		local stepSize = math.max((to - from) / 120, 0.05)
		for t = from + stepSize, to - stepSize / 2, stepSize do
			dot((poseAt(keys, t)).Position, 0.3, RED)
		end
		for i, k in ipairs(keys) do
			local tag = make("BillboardGui", { Name = "Tag", Size = UDim2.fromOffset(90, 24), StudsOffset = Vector3.new(0, 1.3, 0),
				AlwaysOnTop = true }, dot(k.cf.Position, 0.8, if k == selectedKey then GOLD else CREAM))
			local text = label(("%d · %gs"):format(i, math.floor(k.t * 100 + 0.5) / 100), 0, 0, 90, tag)
			text.Size, text.TextXAlignment, text.TextStrokeTransparency = UDim2.fromOffset(90, 24), Enum.TextXAlignment.Center, 0.2
		end
	end

	table.insert(refreshers, function(obj)
		local auto = current() ~= nil and current().auto == true
		autoButton.Text = if auto then "Corsa auto: sì" else "Corsa auto: no"
		autoButton.BackgroundColor3 = if auto then RED else BROWN
		pathButton.Text = if pathOn then "Percorso: sì" else "Percorso: no"
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		for i, k in ipairs(obj.keys) do
			local r = button("Key" .. i, keyText(k, obj.isCamera), 0, 0, 390, function()
				remember(obj)
				selectedKey = k
				timeBox.Text, animBox.Text, soundBox.Text, actionBox.Text = tostring(k.t), k.anim or "", k.sound or "", k.action or ""
				speedBox.Text = tostring(k.speed or 1)
				ease, dir = table.find(CONFIG.Eases, k.ease) or 1, table.find(CONFIG.Directions, k.dir or "InOut") or 1
				easeButton.Text, dirButton.Text = CONFIG.Eases[ease], CONFIG.Directions[dir]
				goTo(obj, k)
				preview = k.t
				refresh()
			end, list)
			r.Size, r.LayoutOrder = UDim2.new(1, -6, 0, 24), i
			r.TextXAlignment = Enum.TextXAlignment.Left
			r.BackgroundColor3 = if k == selectedKey then RED else BROWN
		end
		drawPath(obj)
	end)
	pages[3].Size = UDim2.fromOffset(W, 448)
end

