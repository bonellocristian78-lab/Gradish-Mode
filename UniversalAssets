	local height = math.clamp((view.Y - 60) / scale, TOP + BOTTOM + 64, 664)
	panel.Size = UDim2.fromOffset(W, if body.Visible then height else 30)
	content.Size = UDim2.fromOffset(W, height - TOP - BOTTOM)
	bottom.Position = UDim2.fromOffset(0, height - BOTTOM)
	for _, resize in ipairs(overlays) do resize(height - 34 - BOTTOM) end
	-- Never left outside the screen
	local x = math.clamp(panel.Position.X.Offset, 0, math.max(view.X - W * scale, 0))
	local y = math.clamp(panel.Position.Y.Offset, 0, math.max(view.Y - 60 - 30 * scale, 0))
