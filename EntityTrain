	{ name = "A-60", color = { 235, 30, 30 }, img = { "i_ccb36d5868.png" }, amb = "s_b6ad8690eb.mp3", jump = "s_91a359bf99.mp3" },
	{ name = "A-15", color = { 235, 235, 235 }, img = { "i_a945ff22d7.png" }, jump = "s_c288f2266d.mp3" },
	{ name = "A-35", color = { 40, 220, 60 }, img = { "i_2316ee0829.png" }, amb = "s_b110c78ffa.mp3", jump = "s_b340b21907.mp3" },
	{ name = "A-100", color = { 235, 40, 200 }, img = { "i_36f63f81de.png" }, jump = "s_37a53122bf.mp3" },
	{ name = "A-200", color = { 240, 240, 240 }, img = { "g_7fe673aca8.png", 5, 3, 256, 256, 10 }, jump = "s_91a359bf99.mp3" },
	{ name = "E-22", color = { 250, 140, 30 }, img = { "i_6ec83c6a4d.png" }, amb = "s_dde25a3a25.mp3", jump = "s_2eb48d7d15.mp3" },
}
local HINTS = { "You died to the Entity Train.", "Six of them, one right behind the other: stay hidden until the last has gone." }
local function ir(name) return file("InterminableRooms", "assets/ir/", name) end

-- Their files, all at once
local left = 0
for _, e in ipairs(TRAIN) do
	for _, f in ipairs({ e.img[1], e.jump, e.amb or e.jump }) do
		left += 1
		task.spawn(function()
			ir(f)
			left -= 1
		end)
	end
end
local t0 = os.clock()
while alive and left > 0 and os.clock() - t0 < 25 do task.wait(0.05) end
ir("s_b8edd4761e.mp3") -- (A-60's spawn)

-- Each: its face on a billboard, its light, its sounds
for _, e in ipairs(TRAIN) do
	e.color = Color3.fromRGB(e.color[1], e.color[2], e.color[3])
	e.part = make("Part", { Name = e.name, Size = Vector3.new(0.5, 0.5, 0.5), Transparency = 1, Anchored = true, CanCollide = false, CanQuery = false,
		CanTouch = false }, folder)
	local gui = make("BillboardGui", { Size = UDim2.fromScale(7, 7), LightInfluence = 0, MaxDistance = 400, Enabled = false }, e.part)
	e.gui = gui
	e.label = make("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = ir(e.img[1]) or "" }, gui)
	if #e.img == 6 then e.label.ImageRectSize = Vector2.new(e.img[4], e.img[5]) end
	make("PointLight", { Color = e.color, Range = 24, Brightness = 3, Shadows = false }, e.part)
	if e.amb then FX.loop(ir(e.amb), e.part, { Volume = 1.3 * VOLUME, RollOffMinDistance = 15, RollOffMaxDistance = 240 }) end
end

-- Along the way: a point at a distance from its start
local pts = W.runway()
local marks, total = { 0 }, 0
for i = 2, #pts do
	total += (pts[i] - pts[i - 1]).Magnitude
	marks[i] = total
end
local function along(s)
	s = math.clamp(s, 0, total)
	for i = 2, #pts do
		if marks[i] >= s then
			local span = marks[i] - marks[i - 1]
			return pts[i - 1]:Lerp(pts[i], if span > 0 then (s - marks[i - 1]) / span else 1), (pts[i] - pts[i - 1])
		end
	end
	return pts[#pts], pts[#pts] - (pts[#pts - 1] or pts[#pts])
end

local map = W.map()
FX.once(ir("s_b8edd4761e.mp3"), SoundService, { Volume = 1.2 * VOLUME })
FX.flicker(W.room(W.here()), 2.5)
wait(2.5)
local lead, got, lastRoom = 0, false, nil
while alive and lead - GAP * (#TRAIN - 1) < total do
	local dt = RunService.Heartbeat:Wait()
	lead += SPEED * dt
	for i, e in ipairs(TRAIN) do
		local s = lead - GAP * (i - 1)
		e.gui.Enabled = s > 0 and s < total
		local at = along(s)
		e.part.CFrame = CFrame.new(at + Vector3.new(0, 3.8 + math.sin(os.clock() * 9 + i) * 0.4, 0))
		if #e.img == 6 then -- (A-200's face moving)
			local frame = math.floor(os.clock() * e.img[6]) % e.img[2]
			e.label.ImageRectOffset = Vector2.new((frame % e.img[3]) * e.img[4], math.floor(frame / e.img[3]) * e.img[5])
		end
		e.label.Position = UDim2.fromScale(rnd(0.03), rnd(0.03))
		if e.gui.Enabled and not got and exposed(e.part.Position, REACH) then
			got = true
			task.spawn(FX.face, e.part, ir(e.jump), e.color, function() HURT.kill(e.name, HINTS) end)
		end
	end
	local head = along(lead)
	FX.near(head, 110, 7)
	local n = W.at(map, head)
	if n ~= lastRoom then
		lastRoom = n
		FX.flicker(W.room(n), 1.5)
	end
end
stop()
