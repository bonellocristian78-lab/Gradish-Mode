local _, _, root = P.body()
local room = W.room(W.here())
local origins = if room then W.points(room) else { W.floor(if root then root.Position else workspace.CurrentCamera.CFrame.Position) }
local spots = {}
for _ = 1, COUNT * 6 do
	if #spots >= COUNT then break end
	local from = pick(origins) + Vector3.new(0, 2.5 + math.random() * 6, 0)
	local a = math.random() * math.pi * 2
	local hit = W.cast(from, Vector3.new(math.cos(a), rnd(0.2), math.sin(a)) * 50)
	if hit and hit.Normal and math.abs(hit.Normal.Y) < 0.5 then
		local far = true
		for _, s in ipairs(spots) do
			if (s.at - hit.Position).Magnitude < 4 then far = false end
		end
		if far then table.insert(spots, { at = hit.Position + hit.Normal * 0.3, normal = hit.Normal }) end
	end
end

-- The eyes open, one after another
local eyes = {}
local ref = kitEye:FindFirstChild("Black") or kitEye:FindFirstChildWhichIsA("BasePart")
for _, s in ipairs(spots) do
	local copy = clean(kitEye:Clone())
	for _, d in ipairs(copy:GetDescendants()) do
		if d:IsA("Sound") and d.Looped then d:Destroy() end
	end
	local place = rigid(copy, ref.CFrame)
	local cf = CFrame.lookAt(s.at, s.at + s.normal)
	place(cf)
	local eye = copy:FindFirstChild("Eye")
	table.insert(eyes, { model = copy, eye = eye, middle = eye and eye.Position, at = s.at, normal = s.normal,
		blink = copy:FindFirstChild("Blink", true), splat = copy:FindFirstChild("Splat", true) })
end
FX.flicker(room, 1.5)
for _, e in ipairs(eyes) do
	e.model.Parent = folder
	if e.splat then e.splat:Play() end
	if not wait(0.15) then return end
end

-- The bar: how long they have seen you look at them
local bar = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.06), Size = UDim2.fromScale(0.3, 0.022),
	BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.3, BorderSizePixel = 0 }, screen)
make("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
make("UIStroke", { Color = Color3.fromRGB(150, 150, 160), Thickness = 2 }, bar)
local fill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(200, 30, 30), BorderSizePixel = 0 }, bar)
make("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
make("TextLabel", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -4), Size = UDim2.new(1, 0, 1.4, 0), BackgroundTransparency = 1,
	Text = "DON'T LOOK AT THEM", TextScaled = true, Font = Enum.Font.Oswald, TextColor3 = Color3.fromRGB(230, 230, 230), TextStrokeTransparency = 0.4 }, bar)
local whisper = FX.loop(sfx("Whisper"), SoundService, { Volume = 0 })
local heart = sfx("Heartbeat")

-- Seek's hands out of the floor around you: up, a grab, down
local function hands()
	local _, _, me = P.body()
	if not me then return end
	local base = kitArm:FindFirstChild("Base") or kitArm:FindFirstChildWhichIsA("BasePart")
	local palm = kitArm:FindFirstChild("Palm") or base
	local along = palm.Position - base.Position
	local length = math.max(along.Magnitude + 6, 8)
	along = if along.Magnitude > 0.1 then along.Unit else Vector3.new(0, 1, 0)
	local side = if math.abs(along.Y) < 0.9 then along:Cross(Vector3.new(0, 1, 0)).Unit else Vector3.new(1, 0, 0)
	local armRef = CFrame.fromMatrix(base.Position, side, along) -- (its way from the shoulder to the fingers: up)
	local floor = W.floor(me.Position)
	local arms = {}
	for i = 1, 3 do
		local a = i * math.pi * 2 / 3 + rnd(0.4)
		local copy = clean(kitArm:Clone())
		local place = rigid(copy, armRef)
		copy.Parent = folder
		table.insert(arms, { place = place, at = floor + Vector3.new(math.cos(a), 0, math.sin(a)) * 3.5, yaw = a })
	end
	FX.once(sfx("Shriek"), SoundService, { Volume = 1.2 * VOLUME, PlaybackSpeed = 0.7 })
	local t0 = os.clock()
	while alive and os.clock() - t0 < 1.6 do
		local t = os.clock() - t0
		local up = if t < 0.35 then t / 0.35 elseif t < 1.1 then 1 else 1 - (t - 1.1) / 0.5
		for _, arm in ipairs(arms) do
			local lean = CFrame.Angles(0, -arm.yaw, 0) * CFrame.Angles(0, 0, 0.35 * up) -- (leaning over you)
			arm.place(CFrame.new(arm.at - Vector3.new(0, length * (1 - 0.6 * math.max(up, 0)), 0)) * lean)
		end
		RunService.Heartbeat:Wait()
	end
end

-- Watching you
local meter, beatAt, grabbing = 0, 0, false
on(RunService.Heartbeat, function(dt)
	local camera = workspace.CurrentCamera
	local hidden = P.hiding()
	local seen = false
	for _, e in ipairs(eyes) do
		if e.eye then
			e.eye.LocalTransparencyModifier = if hidden then 1 else 0 -- (closed)
			local to = camera.CFrame.Position - e.at
			if to.Magnitude > 0.1 and not hidden then -- (it turns to you, as far as its socket lets it)
				local look = e.normal:Lerp(to.Unit, 0.45)
				e.eye.CFrame = CFrame.lookAt(e.middle, e.middle + look)
			end
			if not hidden and (camera.CFrame.Position - e.at).Magnitude < 80 and P.looks(e.at) > 0.93 then seen = true end
		end
	end
	meter = math.clamp(meter + (if seen then dt / 2.5 elseif hidden then -dt * 0.75 else -dt * 0.25), 0, 1)
	fill.Size = UDim2.fromScale(meter, 1)
	if whisper then whisper.Volume = (0.15 + meter * 1.6) * VOLUME end
	if meter > 0.45 and os.clock() >= beatAt then
		beatAt = os.clock() + 1.1 - meter * 0.6
		FX.once(heart, SoundService, { Volume = meter * 1.5 * VOLUME })
	end
	FX.static(meter * 0.25)
	if meter >= 1 and not grabbing then
		grabbing = true
		task.spawn(function()
			hands()
			if alive then HURT.damage(DAMAGE, "Seek's eyes", HINTS, DARK, nil, nil) end
			meter = 0
			grabbing = false
		end)
	end
end)

wait(DURATION)
-- They close, one by one
for _, e in ipairs(eyes) do
	if not alive then break end
	if e.blink then e.blink:Play() end
	e.model:Destroy()
	wait(0.12)
end
FX.static(0)
stop()
